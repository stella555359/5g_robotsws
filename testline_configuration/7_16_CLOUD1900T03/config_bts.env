parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: c02603
  availability_zone: nova
  cluster_id: 1
  dns_forwarders: [ "2a00:8a00:6000:6f07::2" ]
  flavors:
    db: c02603_db
    sn: c02603_sn
    uvm: c02603_uvm
    oam: c02603_oam
    cpcl: c02603_cpcl
    cpif: c02603_cpif
    cpnrt: c02603_cpnrt
    cpnb: c02603_cpnb
    cpue: c02603_cpue
    upue: c02603_upue
  ntp_servers: "2a00:8a00:6000:6001::4"
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin:
    _nokfsoperator:
    root:
  timezone: Europe/Warsaw
  uvm_image: 
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.12.0/24, 192.168.12.2, 192.168.12.165 ]
  external_networks:
    oam:
      uuid: cloud026-oam_ipv6_net-v6
      fixed_ips: [ip_address: "2A00:8A00:6000:607c::1:4A64" ]
    f1m:
      uuid: cloud026-f1m_ipv6_net-v6
      fixed_ips: [ip_address: "2A00:8A00:6000:607c::1:4B64"]
    f1c:
      uuid: cloud026-f1c_ipv6_net-v6
      fixed_ips: [ip_address: "2A00:8A00:6000:607c::1:4C64"]
    x2c:
      uuid: cloud026-x2c_ipv6_net-v6
      fixed_ips: [ip_address: "2A00:8A00:6000:607c::1:4D64"]
    s1c:
      uuid: cloud026-x2c_ipv6_net-v6
      fixed_ips: [ip_address: "2A00:8A00:6000:607c::1:4D65"]
    f1u:
      uuid: cloud026-f1u_ipv6_net-v6
      fixed_ips: []
    s1u:
      uuid: cloud026-s1u_ipv6_net-v6
      fixed_ips: []
    x2u:
      uuid: cloud026-x2u_ipv6_net-v6
      fixed_ips: []
    tracing:
      uuid: c026t03-tracing_net-v4

  internal_provider_networks: c026_fh
  internal_e1_provider_networks: c026_fh
  vnf_layout: basic
  config_external_ip: enabled

  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
