parameters:
  image: 5G_0.1051.547_5G
  ssh_public_key: "ssh-rsa  Generated-by-Nova"
  vnf_name: cransg06-tl4
  cluster_id: '1'
  vnfc_type_name_case: upper
  flavors:
    oam: cransg06-tl4_oam
    cpcl: cransg06-tl4_cpcl
    cpif: cransg06-tl4_cpif
    cpnb: cransg06-tl4_cpnb
    cpnrt: cransg06-tl4_cpnrt
    cpue: cransg06-tl4_cpue
    upue: cransg06-tl4_upue
    uvm: cransg06-tl4_uvm
    db: cransg06-tl4_db
  timezone: Asia/Shanghai
  oam_network: f7dc5c96-7f1c-4ee2-9a99-b8b92fa5a43e
  oam_ip_logical: 10.107.168.147
  oam_ip_0: 10.107.168.145
  oam_ip_1: 10.107.168.146
  oam_default_gw: 10.107.168.129
  ntp_servers: 10.56.126.22
  dns_forwarders: [ 10.56.126.31 ]
  internal_network: CBTS4-internal-net
  internal_srv_network: CBTS4-intsrv-net
  internal_e1_network: CBTS4-e1-net
  internal_networks:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
    internal_e1: [ 192.168.5.0/24, 192.168.5.2, 192.168.5.165 ]
  external_networks:
    extnet_a: sriov_a
    extnet_b: sriov_b
  ext_port:
    f1om_sid: 1803
    fronthaul_cpif_sid: 1805
    fronthaul_upue_sid: 1805
    backhaul_cpif_sid: 1801
    backhaul_upue_sid: 1801
    round_check_sid: 10
    f1om_role_cpcl_0: Tracing
    f1om_ip_cpcl_0: [ '10.107.50.40/24' ]
    f1om_role_cpcl_1: Tracing
    f1om_ip_cpcl_1: [ '10.107.50.41/24' ]
    f1om_role_cpnb_0: Tracing
    f1om_ip_cpnb_0: [ '10.107.50.42/24' ]
    f1om_role_cpnb_1: Tracing
    f1om_ip_cpnb_1: [ '10.107.50.43/24' ]
    f1om_role_cpif_0: Tracing
    f1om_ip_cpif_0: [ '10.107.50.44/24' ]
    f1om_role_cpif_1: Tracing
    f1om_ip_cpif_1: [ '10.107.50.45/24' ]
    f1om_role_upue: Tracing
    f1om_ip_upue: [ '10.107.50.46/24' ]
    f1om_role_cpue: Tracing
    f1om_ip_cpue: [ '10.107.50.47/24' ]
    f1om_role_cpnrt: Tracing
    f1om_ip_cpnrt: [ '10.107.50.48/24' ]
    f1om_role_oam_0: Tracing
    f1om_ip_oam_0: [ '10.107.50.49/24' ]
    f1om_role_oam_1: Tracing
    f1om_ip_oam_1: [ '10.107.50.50/24' ]
    f1om_role_oam: 'F1-M'
    f1om_ip_oam: [ '10.107.50.51/24' ]
    fronthaul_role_cpif: 'F1-C'
    fronthaul_ip_cpif: [ '10.107.54.138/26' ]
    backhaul_role_cpif: 'X2-C'
    backhaul_ip_cpif: [ '10.107.54.10/26' ]
    fronthaul_role_upue: 'F1-U'
    fronthaul_ip_upue: [ '10.107.54.139/26' ]
    backhaul_role_upue: 'S1-U,X2-U'
    backhaul_ip_upue: [ '10.107.54.11/26' ]
  enable_sriov: true
  oam_port_type: virtio
  int_port_type: virtio
  ext_port_type: sriov
  oam_port_mtu: 1496
  int_port_mtu: 1400
  ext_port_mtu: 1496
  oam_pmtu: 1496
  int_pmtu: 1400
  ext_pmtu: 1496
  availability_zones:
    default: nova
    oam_0:
    oam_1:
    cpcl_0:
    cpcl_1:
    cpnb_0:
    cpnb_1:
    cpif_0:
    cpif_1:
    cpnrt_0:
    db_0:
    db_1:
    db_2:
    uvm:
    cpues:
      default: nova
      availability_zone_list:
    upues:
      default: nova
      availability_zone_list:
  oam_security_group:
  number_of_upue_nodes: 1
  number_of_cpue_nodes: 1
  number_of_uvm_nodes: 0
  cloudplatform: osp
  vnf_layout: basic
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
