parameters:
  dual_stack: disabled
  network_opts:
    vnf_name: tl25-5gbts
    dns_forwarders: 192.168.125.1
    networks:
      - name: oam
        cidr: 192.168.125.0/24
        gateway: 192.168.125.1
        start: 192.168.125.20
        end: 192.168.125.49
        net_type: vlan
        sid: 2525
        ip_ver: 4
        provider: providerExternal

      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        ip_ver: 4
        cidr_v6: fc00::192:168:2:0/112
        gateway_v6: fc00::192:168:2:1
        start_v6:  ffc00::192:168:2:100
        end_v6:  ffc00::192:168:2:200
        ip_v6_ver: 6
        net_type: vlan
        sid: 2225
        ip_ver: 4
        provider: providerExternal

      - name: backhaul
        cidr: 10.0.1.0/24
        gateway: 10.0.1.1
        start: 10.0.1.100
        end: 10.0.1.200
        ip_ver: 4
        cidr_v6: fc00::10:0:1:0/112
        gateway_v6: fc00::10:0:1:1
        start_v6: fc00::10:0:1:100
        end_v6: fc00::10:0:1:200
        ip_v6_ver: 6
        net_type: vlan
        sid: 1425
        ip_ver: 4
        provider: providerExternal

      - name: tracing
        cidr: 192.168.5.0/24
        gateway: 192.168.5.1
        start: 192.168.5.100
        end: 192.168.5.200
        net_type: vlan
        sid: 1525
        ip_ver: 4
        provider: providerExternal
