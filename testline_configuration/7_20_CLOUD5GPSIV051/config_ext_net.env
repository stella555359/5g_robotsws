parameters:
  network_opts:
    vnf_name: 5gbts-cv51
    dns_forwarders: 192.168.255.126
    number_of_networks: 4

    # all external networks
    networks:

    - name: cv51_fronthaul
      cidr: 192.168.2.0/24
      gateway: 192.168.2.254
      start: 192.168.2.110
      end: 192.168.2.120
      net_type: vlan
      sid: 1100
      ip_ver: 4
      provider: physnet3

    - name: cv51_backhaul
      cidr: 10.192.4.128/24
      gateway: 10.192.4.254
      start: 10.192.4.109
      end: 10.192.4.111
      net_type: vlan
      sid: 3000
      ip_ver: 4
      provider: physnet1

    - name: cv51_tracing
      cidr: 10.192.5.0/24
      gateway: 10.192.5.254
      start: 10.192.5.1
      end: 10.192.5.25
      net_type: vlan
      sid: 2307
      ip_ver: 4
      provider: physnet1

    - name: cv51_oam
      cidr: 10.14.48.0/23
      gateway: 10.14.49.254
      start: 10.14.48.151
      end: 10.14.48.151
      net_type: vlan
      sid: 1000
      ip_ver: 4
      provider: physnet1

