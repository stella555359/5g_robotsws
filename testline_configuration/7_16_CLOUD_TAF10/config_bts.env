parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: c02610
  availability_zone: nova
  cluster_id: 1
  dns_forwarders: [ 10.44.45.2 ]
  flavors:
    db: TAF_10_S6_db
    sn: TAF_10_S6_sn
    uvm: TAF_10_S6_uvm
    oam: TAF_10_S6_oam
    cpcl: TAF_10_S6_cpcl
    cpif: TAF_10_S6_cpif
    cpnrt: TAF_10_S6_cpnrt
    cpnb: TAF_10_S6_cpnb
    cpue: TAF_10_S6_cpue
    upue: TAF_10_S6_upue
  ntp_servers: 10.44.138.23
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin: <hashed password for _nokadmin>
    _nokfsoperator: <hashed password for _nokfsoperator>
    root: <hashed password for root>
  timezone: Europe/Warsaw
  uvm_image:
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.12.0/24, 192.168.12.2, 192.168.12.165 ]
  external_networks:
    oam:
      uuid: cloud026-oam_net-v4
      fixed_ips: [ip_address: 10.44.73.78]
    f1m:
      uuid: TAF_10_S6-TAF_10_S6_fronthaul_net-v4
      fixed_ips: [ip_address: 192.168.4.191]
    f1c:
      uuid: TAF_10_S6-TAF_10_S6_fronthaul_net-v4
      fixed_ips: [ip_address: 192.168.4.194]
      fixed_ips_0: [ ip_address: 192.168.4.195 ]
      fixed_ips_1: [ ip_address: 192.168.4.196 ]
    x2c:
      uuid: TAF_10_S6-TAF_10_S6_backhaul_net-v4
      fixed_ips: [ ip_address: 192.168.2.191 ]
      fixed_ips_0: [ ip_address: 192.168.2.192 ]
      fixed_ips_1: [ ip_address: 192.168.2.193 ]
    s1c:
      uuid: TAF_10_S6-TAF_10_S6_fronthaul_net-v4
      fixed_ips: [ip_address: 192.168.4.198]
    f1u:
      uuid: TAF_10_S6-TAF_10_S6_fronthaul_net-v4
      fixed_ips: [ ip_address: 192.168.4.197 ]
    x2u:
      uuid: TAF_10_S6-TAF_10_S6_backhaul_net-v4
      fixed_ips: [ ip_address: 192.168.2.195 ]
    s1u:
      uuid: TAF_10_S6-TAF_10_S6_backhaul_net-v4
      fixed_ips: [ ip_address: 192.168.2.194 ]
    tracing:
      uuid: TAF_10_S6-TAF_10_S6_tracing_net-v4

  internal_provider_networks: c026_fh
  internal_e1_provider_networks: c026_fh
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
