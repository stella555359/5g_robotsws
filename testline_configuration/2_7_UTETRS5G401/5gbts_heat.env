parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: tl401
  cluster_id: "666"
  dns_forwarders: [ 10.43.41.238 ]
  network-interface-enable: true
  flavors:
    db: tl401_db
    uvm: tl401_uvm
    oam: tl401_oam
    cpcl: tl401_cpcl
    cpif: tl401_cpif
    cpnrt: tl401_cpnrt
    cpnb: tl401_cpnb
    cpue: tl401_cpue
    upue: tl401_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    cpnrt_001: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokfsoperator: '!'
    root: '!'
    wsuser: '$6$rounds=10000$eG4lsC1E5KqcMjYS$E6Zq45tZLtxSRXzT9lpqJjQcyhoQpyHR1bLTGRpYxCbPIs4WDW7PrGhV4uVY0hptxsTZU753MpbgxKArio2hh/'
  timezone: Asia/Shanghai
  uvm_image:
  internal_segment_ids:
    internal: 311
    internal_srv: 312
    internal_e1: 313
  internal_subnets:
    internal: [ 192.168.11.0/24, 192.168.11.2, 192.168.11.165 ]
    internal_srv: [ 192.168.12.0/24, 192.168.12.2, 192.168.12.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.13.0/24, 192.168.13.2, 192.168.13.165 ]
  external_networks:
    oam:
      uuid: Network-Scanned-Cloud-oam_net-v6
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:a000:11b8::a3f:6842"]
    f1c:
      uuid: Network-Scanned-Cloud-fronthaul_net-v6
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:a000:11b8::a3f:6862"]
    x2c:
      uuid: Network-Scanned-Cloud-backhaul_net-v6
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:a000:11b8::a3f:6882"]
    f1u:
      uuid: Network-Scanned-Cloud-fronthaul_net-v6
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:a000:11b8::a3f:6863"]
    x2u:
      uuid: Network-Scanned-Cloud-backhaul_net-v6
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:a000:11b8::a3f:6883"]
    s1u:
      uuid: Network-Scanned-Cloud-backhaul_net-v6
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:a000:11b8::a3f:6884"]
    tracing:
      uuid: Network-Scanned-Cloud-tracing_net-v4

  internal_provider_networks: providerFronthaul
  internal_e1_provider_networks: providerFronthaul
  vnf_layout: basic
  config_external_ip: enabled
  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permission: '0644'
    - content: |
        { "nonRootFullBashEnabled": true }
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'
