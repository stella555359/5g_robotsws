parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: tl332
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  flavors:
    db: tl332_db
    uvm: tl332_uvm
    oam: tl332_oam
    cpcl: tl332_cpcl
    cpif: tl332_cpif
    cpnrt: tl332_cpnrt
    cpnb: tl332_cpnb
    cpue: tl332_cpue
    upue: tl332_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  timezone: Europe/Warsaw
  uvm_image: AirFrameVirtualized-10.1100.112
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
     oam:
      uuid: c002-oam_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3444']
    f1m:
      uuid: c002-f1m_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3544']
    f1c:
      uuid: c002-f1c_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3644']
    x2c:
      uuid: c002-x2c_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3744']
    s1c:
      uuid: c002-x2c_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3744']
    f1u:
      uuid: c002-f1u_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3844']
    x2u:
      uuid: c002-x2u_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3944']
    s1u:
      uuid: c002-s1u_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3A44']
    tracing:
      uuid: tl332-tracing_net-v6
  internal_provider_networks: c002_net2
  internal_e1_provider_networks: c002_net2
  vnf_layout: basic
  config_external_ip: enabled
  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
