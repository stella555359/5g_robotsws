resource_registry:
  5GBTS::Node::Oam: modules/5gbts_oam_node.yaml
  5GBTS::Node::Oam::In::Redundant: modules/5gbts_oam_node_in_redundant.yaml
  5GBTS::Node::Common: modules/5gbts_common_node.yaml
  5GBTS::Node::Common::Nplus: modules/5gbts_common_node_nplus.yaml
  5GBTS::Node::Common::Redundant: modules/5gbts_common_node_redundant.yaml
  5GBTS::Node::CPIF::Redundant: modules/5gbts_cpif_node_redundant.yaml
  5GBTS::Node::DB::In::Redundant: modules/5gbts_db_node_redundant.yaml
  5GBTS::Network::Setup: modules/5gbts_networks_setup.yaml
  5GBTS::Network::IntInterface: modules/5gbts_int_interface.yaml
  5GBTS::Network::ExtInterface: modules/5gbts_ext_interface.yaml
  5GBTS::Network::ExtInterface::Nplus: modules/5gbts_ext_interface_nplus.yaml
  5GBTS::Network::ExtInterface::Redundant: modules/5gbts_ext_interface_redundant.yaml
  5GBTS::Network::FixedIPInterface: modules/5gbts_fixed_ip_interface.yaml
  5GBTS::Networks::Common: modules/5gbts_common_interfaces.yaml
  5GBTS::Networks::Common::Nplus: modules/5gbts_common_interfaces_nplus.yaml
  5GBTS::Networks::Common::Redundant: modules/5gbts_common_interfaces_redundant.yaml
  5GBTS::Networks::OAM: modules/5gbts_oam_interfaces.yaml
  5GBTS::Networks::OAM::In::Redundant: modules/5gbts_oam_interfaces_in_redundant.yaml
  5GBTS::Network::lrvlInform::Nplus: modules/5gbts_lrvl_information_nplus.yaml
  5GBTS::Network::lrvlInform: modules/5gbts_lrvl_information.yaml
  5GBTS::Network::lrvlInform::Redundant: modules/5gbts_lrvl_information_redundant.yaml
  5GBTS::Network::lrvlInform::OAM: modules/5gbts_lrvl_information_oam.yaml
  5GBTS::Network::lrvlInform::OAM::Redundant: modules/5gbts_lrvl_information_oam_redundant.yaml
  5GBTS::Common::Parameters: modules/5gbts_common_params.yaml
  5GBTS::Common::AvailableZones: modules/5gbts_common_available_zones.yaml
  5GBTS::Common::SingleAvailableZone: modules/5gbts_common_single_available_zone.yaml
  RCP::Volume::Cinder: modules/5gbts_volume_cinder.yaml
  RCP::Volume::LVMLocal: modules/5gbts_volume_lvm_local.yaml
  RCP::Volume::LVMNFS: modules/5gbts_volume_lvm_nfs.yaml
  RCP::Volume::LVMGFS: modules/5gbts_volume_lvm_gfs.yaml
  RCP::VolumeGroup::LVMLocal: modules/5gbts_volume_group_lvm_local.yaml
  RCP::VolumeGroup::LVMNFS: modules/5gbts_volume_group_lvm_nfs.yaml
  RCP::VolumeGroup::LVMGFS: modules/5gbts_volume_group_lvm_gfs.yaml
parameters:
  image:
  ssh_public_key: "ssh-rsa  Generated-by-Nova"
  vnf_name: c19b-5gbts
  cluster_id: '01'
  vnfc_type_name_case: lower
  flavors:
    oam: 5gbts_oam
    cpcn: 5gbts_cpcn
    cpcl: 5gbts_cpcl
    cpif: 5gbts_cpif
    cpnb: 5gbts_cpnb
    cpnrt: 5gbts_cpnrt
    cpue: 5gbts_cpue
    upue: 5gbts_upue
    uvm: 5gbts_uvm
    db: 5gbts_db
  timezone: Europe/Warsaw
  oam_network: C19B-5gbts-oam_net-v6
  oam_ip_logical: 2A00:8A00:6000:607c::FD05
  oam_ip_0: 2A00:8A00:6000:607c::FD06
  oam_ip_1: 2A00:8A00:6000:607c::FD07
  oam_default_gw: 2A00:8A00:6000:607c::FD01
  ntp_servers: [ '2a00:8a00:6000:6103::182' ]
  dns_forwarders: [ '2a00:8a00:6000:6f07::2' ]
  internal_network: C19B-5gbts-internal_net-v4
  internal_srv_network: C19B-5gbts-internal_srv_net-v4
  internal_e1_network: C19B-5gbts-internal_e1_net-v4
  internal_networks:
    internal: [ 192.168.31.0/24, 192.168.31.2, 192.168.31.165 ]
    internal_srv: [ 192.168.33.0/24, 192.168.33.2, 192.168.33.165 ]
    internal_e1: [ 192.168.35.0/24, 192.168.35.2, 192.168.35.165 ]
  external_networks:
    extnet_a: C19B-5gbts-extnet-a_net-v6
    extnet_b: C19B-5gbts-extnet-b_net-v6
  ext_port:
    f1om_sid: 623
    fronthaul_cpif_sid: 624
    fronthaul_upue_sid: 624
    backhaul_cpif_sid: 625
    backhaul_upue_sid: 625
    round_check_sid: 626
    f1om_role_cpcl_0: Tracing
    f1om_ip_cpcl_0: [ '2A00:8A00:6000:607c::FE05/120' ]
    f1om_role_cpcl_1: Tracing
    f1om_ip_cpcl_1: [ '2A00:8A00:6000:607c::FE06/120' ]
    f1om_role_cpnb_0: Tracing
    f1om_ip_cpnb_0: [ '2A00:8A00:6000:607c::FE07/120' ]
    f1om_role_cpnb_1: Tracing
    f1om_ip_cpnb_1: [ '2A00:8A00:6000:607c::FE08/120' ]
    f1om_role_cpif_0: Tracing
    f1om_ip_cpif_0: [ '2A00:8A00:6000:607c::FE09/120' ]
    f1om_role_cpif_1: Tracing
    f1om_ip_cpif_1: [ '2A00:8A00:6000:607c::FE10/128' ]
    f1om_role_upue: Tracing
    f1om_ip_upue: [[ '2A00:8A00:6000:607c::FE11/120' ], [ '2A00:8A00:6000:607c::FE14/120' ], [ '2A00:8A00:6000:607c::FE15/120' ], [ '2A00:8A00:6000:607c::FE16/120' ], [ '2A00:8A00:6000:607c::FE17/120' ]]
    f1om_role_cpue: Tracing
    f1om_ip_cpue: [[ '2A00:8A00:6000:607c::FE12/120' ], [ '2A00:8A00:6000:607c::FE18/120' ]]
    f1om_role_cpnrt: Tracing
    f1om_ip_cpnrt: [ '2A00:8A00:6000:607c::FE13/120' ]
    f1om_role_oam_0: Tracing
    f1om_ip_oam_0: [ '2A00:8A00:6000:607c::FE19/120' ]
    f1om_role_oam_1: Tracing
    f1om_ip_oam_1: [ '2A00:8A00:6000:607c::FE20/120' ]
    f1om_role_oam: 'F1-M'
    f1om_ip_oam: [ '2A00:8A00:6000:607c::FE04/120' ]
    fronthaul_role_cpif: 'F1-C'
    fronthaul_ip_cpif: [ '2A00:8A00:6000:607c::FF04/120' ]
    backhaul_role_cpif: 'X2-C'
    backhaul_ip_cpif: [ '2A00:8A00:6000:607c::1:04/120' ]
    fronthaul_role_upue: 'F1-U'
    fronthaul_ip_upue: [[ '2A00:8A00:6000:607c::FF05/120' ], [ '2A00:8A00:6000:607c::FF06/120' ], [ '2A00:8A00:6000:607c::FF07/120' ], [ '2A00:8A00:6000:607c::FF08/120' ], [ '2A00:8A00:6000:607c::FF09/120' ]]
    backhaul_role_upue: 'S1-U,X2-U'
    backhaul_ip_upue: [['2A00:8A00:6000:607c::1:05/120' ], [ '2A00:8A00:6000:607c::1:06/120' ], [ '2A00:8A00:6000:607c::1:07/120' ], [ '2A00:8A00:6000:607c::1:08/120' ], [ '2A00:8A00:6000:607c::1:09/120' ]]

  enable_sriov: true
  oam_port_type: virtio
  int_port_type: virtio
  ext_port_type: sriov
  oam_port_mtu: 1500
  int_port_mtu: 1500
  ext_port_mtu: 1500
  oam_pmtu: 1500
  int_pmtu: 1500
  ext_pmtu: 1500
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  oam_security_group: c19b-5gbts-oam-security-group
  number_of_upue_nodes: 5
  number_of_cpue_nodes: 2
  number_of_uvm_nodes: 0
  cloudplatform: osp
  vnf_layout: redundant

  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
