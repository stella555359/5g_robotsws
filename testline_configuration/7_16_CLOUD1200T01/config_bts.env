parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: c1200t01
  availability_zone: nova
  cluster_id: 1
  dns_forwarders: [ 10.56.126.31 ]
  flavors:
    db: C1200T01_db
    sn: C1200T01_sn
    uvm: C1200T01_uvm
    oam: C1200T01_oam
    cpcl: C1200T01_cpcl
    cpif: C1200T01_cpif
    cpnrt: C1200T01_cpnrt
    cpnb: C1200T01_cpnb
    cpue: C1200T01_cpue
    upue: C1200T01_upue
  ntp_servers: 10.44.45.2
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin:         #password for _nokadmin
    _nokfsoperator:    #password for _nokfsoperator
    root:              #password for root
  timezone: Europe/Warsaw
  uvm_image:
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.12.0/24, 192.168.12.2, 192.168.12.165 ]
  external_networks:
    oam:
      uuid: C1200T01-oam_net_T01_net-v4
      fixed_ips: [ ip_address: 10.44.181.2 ]
    f1m:
      uuid: C1200T01-fronthaul_net_T01_net-v4
      fixed_ips: [ ip_address: 192.168.2.111 ]
    f1c:
      uuid: C1200T01-fronthaul_net_T01_net-v4
      fixed_ips: [ ip_address: 192.168.2.112 ]
    x2c:
      uuid: C1200T01-backhaul_net_T01_net-v4
      fixed_ips: [ ip_address: 10.1.1.21 ]
    s1c:
      uuid: C1200T01-backhaul_net_T01_net-v4
      fixed_ips: [ ip_address: 10.1.1.21 ]
    f1u:
      uuid: C1200T01-fronthaul_net_T01_net-v4
    x2u:
      uuid: C1200T01-backhaul_net_T01_net-v4
    s1u:
      uuid: C1200T01-backhaul_net_T01_net-v4
    tracing:
      uuid: C1200T01-tracing_net_T01_net-v4
  internal_provider_networks: t01_fronthaul
  internal_e1_provider_networks: t01_fronthaul
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
