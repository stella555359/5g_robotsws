parameters:
  network_opts:
    vnf_name: C1200T01
    dns_forwarders: 10.44.45.2

    networks:
      - name: oam_net_T01
        cidr: 10.44.181.0/25
        gateway: 10.44.181.1
        start: 10.44.181.2
        end: 10.44.181.3
        net_type: vlan
        sid: 51
        ip_ver: 4
        provider: t01_fronthaul

      - name: fronthaul_net_T01
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        net_type: vlan
        sid: 1203
        ip_ver: 4
        provider: t01_fronthaul

      - name: backhaul_net_T01
        cidr: 10.1.1.0/24
        gateway: 10.1.1.1
        start: 10.1.1.21
        end: 10.1.1.22
        net_type: vlan
        sid: 1202
        ip_ver: 4
        provider: t01_backhaul

      - name: tracing_net_T01
        cidr: 172.16.4.0/24
        gateway: 172.16.4.1
        start: 172.16.4.100
        end: 172.16.4.200
        net_type: vlan
        sid: 1207
        ip_ver: 4
        provider: t01_fronthaul
