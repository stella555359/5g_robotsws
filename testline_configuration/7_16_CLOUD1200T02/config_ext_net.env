parameters:
  network_opts:
    vnf_name: C1200T02
    dns_forwarders: 10.44.45.2

    networks:
      - name: oam_net_T02
        cidr: 10.44.181.0/25
        gateway: 10.44.181.1
        start: 10.44.181.4
        end: 10.44.181.5
        net_type: vlan
        sid: 51
        ip_ver: 4
        provider: t02_fronthaul

      - name: fronthaul_net_T02
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        net_type: vlan
        sid: 1213
        ip_ver: 4
        provider: t02_fronthaul

      - name: backhaul_net_T02
        cidr: 10.1.1.0/24
        gateway: 10.1.1.1
        start: 10.1.1.2
        end: 10.1.1.3
        net_type: vlan
        sid: 1212
        ip_ver: 4
        provider: t02_backhaul

      - name: tracing_net_T02
        cidr: 172.16.4.0/24
        gateway: 172.16.4.1
        start: 172.16.4.100
        end: 172.16.4.200
        net_type: vlan
        sid: 1217
        ip_ver: 4
        provider: t02_fronthaul
