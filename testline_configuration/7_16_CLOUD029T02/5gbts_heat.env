      fixed_ips: [ip_address: 10.44.78.84]
    s1c:
      uuid: cloud-029-t02-backhaul_net-v4
      fixed_ips: [ip_address: 10.44.78.84]
    f1u:
      uuid: cloud-029-t02-fronthaul_net-v4
      fixed_ips:
    x2u:
      uuid: cloud-029-t02-backhaul_net-v4
      fixed_ips:
    s1u:
