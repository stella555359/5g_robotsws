    cpnrt: cloud-029-t02_cpnrt
    cpnb: cloud-029-t02_cpnb
    cpue: cloud-029-t02_cpue
    upue: cloud-029-t02_upue
  ntp_servers: 10.44.45.2
  timezone: Europe/Warsaw
  uvm_image:
  internal_segment_ids:
    internal: 4006
    internal_srv: 4007
    internal_e1: 4008
  external_networks:
    oam:
      uuid: cloud-029-t02-oam_net-v4
      fixed_ips: [ip_address: 10.44.78.20]
    f1m:
      uuid: cloud-029-t02-fronthaul_net-v4
      fixed_ips: [ip_address: 10.44.78.52]
    f1c:
      uuid: cloud-029-t02-fronthaul_net-v4
      fixed_ips: [ip_address: 10.44.78.53]
    x2c:
