  internal_provider_networks: c029_T02_fh
  internal_e1_provider_networks: c029_T02_fh

  user_info:
   system_info:
     default_user:
       name: robot
   users:
   - default
   - name: robot
     gecos: Robot user for test automation purposes
     primary-group: root
     lock_passwd: false
     plain_text_passwd: 'rastre1'
     home: /home/robot
     shell: /bin/bash
     sudo:
     - ALL=(ALL) NOPASSWD:ALL
   write_files:
   - content: |
       robot
     path: /etc/opt/nokia/setupsshkey.d/testusers
     permissions: '0644'
