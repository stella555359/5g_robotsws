parameters:
  image: AirFrameVirtualized-0.190.3833
  ssh_public_key: "ssh-rsa "
  vnf_name: mmw-npv-coam-tl105
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  network-interface-enable: true
  flavors:
    db: mmw-npv-tl105-coam_db
    uvm: mmw-npv-tl105-coam_uvm
    oam: mmw-npv-tl105-coam_oam
    cpcl: mmw-npv-tl105-coam_cpcl
    cpif: mmw-npv-tl105-coam_cpif
    cpnrt: mmw-npv-tl105-coam_cpnrt
    cpnb: mmw-npv-tl105-coam_cpnb
    cpue: mmw-npv-tl105-coam_cpue
    upue: mmw-npv-tl105-coam_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    cpnrt_001: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  cleartextpassword:
    georesiliency: 'VpOn9JSX6r%G#T'
    wsuser: 'A0zY~rP#8Mx@'
  password:
    _nokfsoperator: '!'
    root: '!'
    georesiliency: '$5$rounds=10000$YLkADD9q$/7cX20b5eNgcjvnN1kteCmZR4siF6oQfW1/9hzh4YZ7'
    wsuser: '$5$rounds=10000$6Kj3xARF$6D8XNkLOFxc8yswG4hhvCXyCdHau5WY6yxH/ZxRrle8'
  timezone: Asia/Shanghai
  uvm_image: AirFrameVirtualized-0.190.3833
  internal_segment_ids:
    internal: 200
    internal_srv: 201
    internal_e1: 202
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.6.0/24, 192.168.6.2, 192.168.6.165 ]
  external_networks:
    oam:
      uuid: CIT-CU1-OAM-VLAN-800
      fixed_ips: [ip_address: "2a00:8a00:2000:4901:0000:0000:0000:4"]
    f1c:
      uuid: CIT-CU1-FH-VLAN-801
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:2000:4901:0000:0000:0000:45"]
    x2c:
      uuid: CIT-CU1-X2-VLAN-803
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:2000:4901:0000:0000:0000:c6"]
    f1u:
      uuid: CIT-CU1-FH-VLAN-801
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:2000:4901:0000:0000:0000:44"]
    x2u:
      uuid: CIT-CU1-X2-VLAN-803
      fixed_ips: []
      fixed_v6_ips: [ip_address: "2a00:8a00:2000:4901:0000:0000:0000:c7"]
    s1u:
      uuid: CIT-CU1-BH-VLAN-802
      fixed_ips: []
      fixed_v6_ips: []
    tracing:
      uuid: CIT-CU1-BH-VLAN-802

  internal_provider_networks: providerInternal
  internal_e1_provider_networks: providerInternal
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
    - content: '{ "nonRootFullBashEnabled": true }'
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'