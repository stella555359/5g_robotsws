parameters:
  dual_stack: disabled
  network_opts:
    vnf_name: tl29-5gbts
    dns_forwarders: 192.168.125.1
    networks:
      - name: oam
        cidr: 192.168.125.0/24
        gateway: 192.168.125.1
        start: 192.168.125.10
        end: 192.168.125.49
        net_type: vlan
        sid: 2529
        ip_ver: 4
        provider: providerExternal
      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
       
        net_type: vlan
        sid: 2229
        ip_ver: 4
        provider: providerExternal

      - name: backhaul
        cidr: 192.168.4.0/24
        gateway: 192.168.4.1
        start: 192.168.4.100
        end: 192.168.4.200
        net_type: vlan
        sid: 1429
        ip_ver: 4
        provider: providerExternal

      - name: tracing
        cidr: 192.168.5.0/24
        gateway: 192.168.5.1
        start: 192.168.5.100
        end: 192.168.5.200
        net_type: vlan
        sid: 1529
        ip_ver: 4
        provider: providerExternal

