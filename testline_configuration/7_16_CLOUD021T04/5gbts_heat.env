# this is env file for 5G19A branch only
resource_registry:
  5GBTS::Node::Oam: modules/5gbts_oam_node.yaml
  5GBTS::Node::Oam::In::Redundant: modules/5gbts_oam_node_in_redundant.yaml
  5GBTS::Node::Common: modules/5gbts_common_node.yaml
  5GBTS::Node::Common::Nplus: modules/5gbts_common_node_nplus.yaml
  5GBTS::Node::Common::Redundant: modules/5gbts_common_node_redundant.yaml
  5GBTS::Node::CPIF::Redundant: modules/5gbts_cpif_node_redundant.yaml
  5GBTS::Node::DB::Redundant: modules/5gbts_db_node_redundant.yaml
  5GBTS::Network::Setup: modules/5gbts_networks_setup.yaml
  5GBTS::Network::IntInterface: modules/5gbts_int_interface.yaml
  5GBTS::Network::ExtInterface: modules/5gbts_ext_interface.yaml
  5GBTS::Network::ExtInterface::Nplus: modules/5gbts_ext_interface_nplus.yaml
  5GBTS::Network::ExtInterface::Redundant: modules/5gbts_ext_interface_redundant.yaml
  5GBTS::Network::FixedIPInterface: modules/5gbts_fixed_ip_interface.yaml
  5GBTS::Networks::Common: modules/5gbts_common_interfaces.yaml
  5GBTS::Networks::Common::Nplus: modules/5gbts_common_interfaces_nplus.yaml
  5GBTS::Networks::Common::Redundant: modules/5gbts_common_interfaces_redundant.yaml
  5GBTS::Networks::OAM: modules/5gbts_oam_interfaces.yaml
  5GBTS::Networks::OAM::In::Redundant: modules/5gbts_oam_interfaces_in_redundant.yaml
  5GBTS::Network::loInform: modules/5gbts_lo_information.yaml
  5GBTS::Network::loInform::Nplus: modules/5gbts_lo_information_nplus.yaml
  5GBTS::Network::loInform::Redundant: modules/5gbts_lo_information_redundant.yaml
  5GBTS::Common::AvailableZones: modules/5gbts_common_available_zones.yaml
  5GBTS::Common::SingleAvailableZone: modules/5gbts_common_single_available_zone.yaml
  RCP::Volume::Cinder: modules/5gbts_volume_cinder.yaml
  RCP::Volume::LVMLocal: modules/5gbts_volume_lvm_local.yaml
  RCP::Volume::LVMNFS: modules/5gbts_volume_lvm_nfs.yaml
  RCP::VolumeGroup::LVMLocal: modules/5gbts_volume_group_lvm_local.yaml
  RCP::VolumeGroup::LVMNFS: modules/5gbts_volume_group_lvm_nfs.yaml
parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: cloud-021-t04
  cluster_id: '04'
  vnfc_type_name_case: lower
  flavors:
    oam: cloud-021-t04_oam
    cpcn: cloud-021-t04_cpcn
    cpcl: cloud-021-t04_cpcl
    cpif: cloud-021-t04_cpif
    cpnb: cloud-021-t04_cpnb
    cpnrt: cloud-021-t04_cpnrt
    cpue: cloud-021-t04_cpue
    upue: cloud-021-t04_upue
    uvm: cloud-021-t04_uvm
    db: cloud-021-t04_db
  timezone: Europe/Warsaw
  oam_network: cloud-021-t04-oam_net-v6
  oam_ip: 2A00:8A00:6000:607c::2305
  oam_default_gw: 2A00:8A00:6000:607c::2301
  ntp_servers: [ '2a00:8a00:6000:607c::21fd' ]
  dns_forwarders: [ '2a00:8a00:6000:6f07::2' ]
  internal_network: cloud-021-t04-internal_net-v4
  internal_srv_network: cloud-021-t04-internal_srv_net-v4
  internal_e1_network: cloud-021-t04-internal_e1_net-v4
  internal_networks:
    internal: [ 192.168.100.0/24, 192.168.100.2, 192.168.100.165 ]
    internal_srv: [ 192.168.39.0/24, 192.168.39.2, 192.168.39.165 ]
    internal_e1: [ 192.168.59.0/24, 192.168.59.2, 192.168.59.165 ]
  external_networks:
    extnet_a: cloud-021-t04-extnet-a_net-v6
    extnet_b: cloud-021-t04-extnet-b_net-v6
  ext_port:
    f1om_sid_a: 443
    fronthaul_cpif_sid_a: 445
    fronthaul_upue_sid_a: 445
    backhaul_cpif_sid_a: 446
    backhaul_upue_sid_a: 446
    f1om_sid_b: 444
    fronthaul_cpif_sid_b:  447
    fronthaul_upue_sid_b:  447
    backhaul_cpif_sid_b: 448
    backhaul_upue_sid_b: 448

    f1om_role_cpcl_0: Tracing
    f1om_ip_cpcl_0: [ '2A00:8A00:6000:607c::5417/128' ]
    f1om_role_cpcl_1: Tracing
    f1om_ip_cpcl_1: [ '2A00:8A00:6000:607c::5418/128' ]
    f1om_role_cpnb_0: Tracing
    f1om_ip_cpnb_0: [ '2A00:8A00:6000:607c::5419/128' ]
    f1om_role_cpnb_1: Tracing
    f1om_ip_cpnb_1: [ '2A00:8A00:6000:607c::5422/128' ]
    f1om_role_cpif_0: Tracing
    f1om_ip_cpif_0: [ '2A00:8A00:6000:607c::5423/128' ]
    f1om_role_cpif_1: Tracing
    f1om_ip_cpif_1: [ '2A00:8A00:6000:607c::5424/128' ]
    f1om_role_upue: Tracing
    f1om_ip_upue: [[ '2A00:8A00:6000:607c::5425/128' ], [ '2A00:8A00:6000:607c::5469/128' ], [ '2A00:8A00:6000:607c::5470/128' ], [ '2A00:8A00:6000:607c::5471/128' ], [ '2A00:8A00:6000:607c::5472/128' ]]
    f1om_role_cpue: Tracing
    f1om_ip_cpue: [[ '2A00:8A00:6000:607c::5426/128' ], [ '2A00:8A00:6000:607c::5460/128' ]]
    f1om_role_cpnrt: Tracing
    f1om_ip_cpnrt: [ '2A00:8A00:6000:607c::5427/128' ]
    f1om_role_oam: 'F1-M'
    f1om_ip_oam: [ '2A00:8A00:6000:607c::5416/128' ]
    fronthaul_role_cpif: 'F1-C'
    fronthaul_ip_cpif: [ '2A00:8A00:6000:607c::5412/128' ]
    fronthaul_role_upue: 'F1-U'
    fronthaul_ip_upue: [[ '2A00:8A00:6000:607c::5414/128' ], [ '2A00:8A00:6000:607c::5461/128' ], [ '2A00:8A00:6000:607c::5462/128' ], [ '2A00:8A00:6000:607c::5463/128' ], [ '2A00:8A00:6000:607c::5464/128' ]]
    backhaul_role_cpif: 'S1-C,X2-C'
    backhaul_ip_cpif: [ '2A00:8A00:6000:607c::5413/128' ]
    backhaul_role_upue: 'S1-U,X2-U'
    backhaul_ip_upue: [[ '2A00:8A00:6000:607c::5415/128' ], [ '2A00:8A00:6000:607c::5465/128' ], [ '2A00:8A00:6000:607c::5466/128' ], [ '2A00:8A00:6000:607c::5467/128' ], [ '2A00:8A00:6000:607c::5468/128' ]]

    f1om_ip_oam_a: [ '2A00:8A00:6000:607c::4A09/120' ]
    f1om_ip_cpcl_a_0: [ '2A00:8A00:6000:607c::4A04/120' ]
    f1om_ip_cpcl_a_1: [ '2A00:8A00:6000:607c::4A17/120' ]
    f1om_ip_cpnb_a_0: [ '2A00:8A00:6000:607c::4A05/120' ]
    f1om_ip_cpnb_a_1: [ '2A00:8A00:6000:607c::4A15/120' ]
    f1om_ip_cpif_a_0: [ '2A00:8A00:6000:607c::4A06/120' ]
    f1om_ip_cpif_a_1: [ '2A00:8A00:6000:607c::4A16/120' ]
    f1om_ip_upue_a: [[ '2A00:8A00:6000:607c::4A07/120' ], [ '2A00:8A00:6000:607c::4A11/120' ], [ '2A00:8A00:6000:607c::4A12/120' ], [ '2A00:8A00:6000:607c::4A13/120' ], [ '2A00:8A00:6000:607c::4A14/120' ]]
    f1om_ip_cpue_a: [[ '2A00:8A00:6000:607c::4A08/120' ], [ '2A00:8A00:6000:607c::4A18/120' ]]
    f1om_ip_cpnrt_a: [ '2A00:8A00:6000:607c::4A10/120' ]
    fronthaul_ip_cpif_a: [ '2A00:8A00:6000:607c::4C04/120' ]
    fronthaul_ip_upue_a: [[ '2A00:8A00:6000:607c::4C05/120' ], [ '2A00:8A00:6000:607c::4C06/120' ], [ '2A00:8A00:6000:607c::4C07/120' ], [ '2A00:8A00:6000:607c::4C08/120' ], [ '2A00:8A00:6000:607c::4C09/120' ]]
    backhaul_ip_cpif_a: [ '2A00:8A00:6000:607c::4D04/120' ]
    backhaul_ip_upue_a: [[ '2A00:8A00:6000:607c::4D05/120' ], [ '2A00:8A00:6000:607c::4D06/120' ], [ '2A00:8A00:6000:607c::4D07/120' ], [ '2A00:8A00:6000:607c::4D08/120' ], [ '2A00:8A00:6000:607c::4D09/120' ]]

    f1om_ip_oam_b: [ '2A00:8A00:6000:607c::4B09/120' ]
    f1om_ip_cpcl_b_0: [ '2A00:8A00:6000:607c::4B04/120' ]
    f1om_ip_cpcl_b_1: [ '2A00:8A00:6000:607c::4B17/120' ]
    f1om_ip_cpnb_b_0: [ '2A00:8A00:6000:607c::4B05/120' ]
    f1om_ip_cpnb_b_1: [ '2A00:8A00:6000:607c::4B15/120' ]
    f1om_ip_cpif_b_0: [ '2A00:8A00:6000:607c::4B06/120' ]
    f1om_ip_cpif_b_1: [ '2A00:8A00:6000:607c::4B16/120' ]
    f1om_ip_upue_b: [[ '2A00:8A00:6000:607c::4B07/120' ], [ '2A00:8A00:6000:607c::4B11/120' ], [ '2A00:8A00:6000:607c::4B12/120' ], [ '2A00:8A00:6000:607c::4B13/120' ], [ '2A00:8A00:6000:607c::4B14/120' ]]
    f1om_ip_cpue_b: [[ '2A00:8A00:6000:607c::4B08/120' ], [ '2A00:8A00:6000:607c::4B18/120' ]]
    f1om_ip_cpnrt_b: [ '2A00:8A00:6000:607c::4B10/120' ]
    fronthaul_ip_cpif_b: [ '2A00:8A00:6000:607c::4E04/120' ]
    fronthaul_ip_upue_b: [[ '2A00:8A00:6000:607c::4E05/120' ], [ '2A00:8A00:6000:607c::4E06/120' ], [ '2A00:8A00:6000:607c::4E07/120' ], [ '2A00:8A00:6000:607c::4E08/120' ], [ '2A00:8A00:6000:607c::4E09/120' ]]
    backhaul_ip_cpif_b: [ '2A00:8A00:6000:607c::4F04/120' ]
    backhaul_ip_upue_b: [[ '2A00:8A00:6000:607c::4F05/120' ], [ '2A00:8A00:6000:607c::4F06/120' ], [ '2A00:8A00:6000:607c::4F07/120' ], [ '2A00:8A00:6000:607c::4F08/120' ], [ '2A00:8A00:6000:607c::4F09/120' ]]
  enable_sriov: true
  oam_port_type: virtio
  int_port_type: virtio
  ext_port_type: sriov
  oam_port_mtu: 1500
  int_port_mtu: 1500
  ext_port_mtu: 1500
  oam_pmtu: 1500
  int_pmtu: 1500
  ext_pmtu: 1500
  availability_zones:
    default: nova
    oam_0: nova
    cpcl_0: nova
    cpcl_1:
    cpnb_0: nova
    cpnb_1:
    cpif_0: nova
    cpif_1: nova
    cpnrt_0:
    db_0:
    uvm:
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
        - nova
        - nova
  oam_security_group: default
  number_of_upue_nodes: 1
  number_of_cpue_nodes: 1
  number_of_uvm_nodes: 0
  cloudplatform: osp
  vnf_layout: basic

  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
