parameters:
  network_opts:
    vnf_name: 5gbts-vcp-2
    number_of_networks: 2

    # external networks based on flat provider network (sriov)
    networks:

      - name: extnet-a
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.2
        end: 192.168.2.165
        net_type: flat
        ip_ver: 4
        provider: sriov-a
        tenant_id: f2df0232cc1b412e9c425fb5f2e6ddc6

      - name: extnet-b
        cidr: 192.168.12.0/24
        gateway: 192.168.12.1
        start: 192.168.12.2
        end: 192.168.12.165
        net_type: flat
        ip_ver: 4
        provider: sriov-b
        tenant_id: f2df0232cc1b412e9c425fb5f2e6ddc6
        