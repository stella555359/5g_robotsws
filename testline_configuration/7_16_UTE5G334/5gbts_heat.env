parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: tl334
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  network-interface-enable: true
  flavors:
    db: tl334_db
    uvm: tl334_uvm
    oam: tl334_oam
    cpcl: tl334_cpcl
    cpif: tl334_cpif
    cpnrt: tl334_cpnrt
    cpnb: tl334_cpnb
    cpue: tl334_cpue
    upue: tl334_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    cpnrt_001: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokfsoperator: '!'
    root: '!'
    wsuser: '$6$rounds=10000$eG4lsC1E5KqcMjYS$E6Zq45tZLtxSRXzT9lpqJjQcyhoQpyHR1bLTGRpYxCbPIs4WDW7PrGhV4uVY0hptxsTZU753MpbgxKArio2hh/'
  timezone: Europe/Warsaw
  uvm_image:
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: c003-oam_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: 2A00:8A00:6000:607c::1:6AA6]
    f1m:
      uuid: c003-f1m_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2A00:8A00:6000:607c::64A6']
    f1c:
      uuid: c003-f1c_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2A00:8A00:6000:607c::65A6']
    x2c:
      uuid: c003-x2c_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2A00:8A00:6000:607c::66A6']
    s1c:
      uuid: c003-x2c_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2A00:8A00:6000:607c::66A6']
    f1u:
      uuid: c003-f1u_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2A00:8A00:6000:607c::67A6']
    x2u:
      uuid: c003-x2u_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2A00:8A00:6000:607c::68A6']
    s1u:
      uuid: c003-s1u_net-v46
      fixed_ips: []
      fixed_v6_ips: [ip_address: '2A00:8A00:6000:607c::69A6']
    tracing:
      uuid: tl334-tracing_net-v6
  internal_provider_networks: c003_net2
  internal_e1_provider_networks: c003_net2
  vnf_layout: basic
  config_external_ip: enabled
  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
    - content: '{ "nonRootFullBashEnabled": true }'
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'

