parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: c002tl71
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  flavors:
    db: c002tl71_db
    uvm: c002tl71_uvm
    oam: c002tl71_oam
    cpcl: c002tl71_cpcl
    cpif: c002tl71_cpif
    cpnrt: c002tl71_cpnrt
    cpnb: c002tl71_cpnb
    cpue: c002tl71_cpue
    upue: c002tl71_upue
  ntp_servers: 10.56.126.22
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  timezone: Europe/Warsaw
  uvm_image:
  internal_segment_ids:
    internal: 216
    internal_srv: 217
    internal_e1: 218
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: c002-oam_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3414']
    f1m:
      uuid: c002-f1m_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3514']
    f1c:
      uuid: c002-f1c_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3614']
    x2c:
      uuid: c002-x2c_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3714']
    s1c:
      uuid: c002-x2c_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3714']
    f1u:
      uuid: c002-f1u_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3814']
    x2u:
      uuid: c002-x2u_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3914']
    s1u:
      uuid: c002-s1u_net-v46
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3A14']
    tracing:
      uuid: c002tl71-tracing_net-v6

  internal_provider_networks: c002_net2
  internal_e1_provider_networks: c002_net2
  vnf_layout: basic
  config_external_ip: enabled
  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
