set DAEMON_IP="127.0.0.1"
set DAEMON_PORT=22222

set ENB1_S1_ADDR="10.35.166.81"
set ENB1_X2_ADDR="10.42.53.58"

set ENB2_S1_ADDR="10.35.166.82"
set ENB2_X2_ADDR="10.44.76.96"

set ENB3_S1_ADDR="10.35.166.83"
set ENB3_X2_ADDR="10.44.76.111"

set GNB_X2_ADDR="10.44.76.110"

set MME1_S1_ADDR="10.35.166.112"

set SGW_S1U_ADDR="10.35.166.63"
set SGW_S11_ADDR="10.35.166.116"

set PGW_ADDR="4.7.254.207"

# Set LTE_ID=40093 with pci=11
set_enb id=1 plmn=555:10 s1=$ENB1_S1_ADDR enb_id_macro=0x09c9d daemon=$DAEMON_IP:$DAEMON_PORT x2=$ENB1_X2_ADDR type=simulated x2_peers=none
set_cell id=1 enb=1 eci=0x09c9d01 pci=3:2 tac=7150 earfcn=2000:20000 mapped_earfcn=4200:22200

# Set LTE_ID=40094 with pci=11
set_enb id=2 plmn=555:10 s1=$ENB2_S1_ADDR enb_id_macro=0x09c9e daemon=$DAEMON_IP:$DAEMON_PORT x2=$ENB2_X2_ADDR type=simulated x2_peers=none
set_cell id=1 enb=2 eci=0x09c9e01 pci=3:2 tac=7150 earfcn=2000:20000 mapped_earfcn=4200:22200

# Set LTE_ID=40095 with pci=11
set_enb id=3 plmn=555:10 s1=$ENB3_S1_ADDR enb_id_macro=0x09c9f daemon=$DAEMON_IP:$DAEMON_PORT x2=$ENB3_X2_ADDR type=simulated x2_peers=none
set_cell id=1 enb=3 eci=0x09c9f01 pci=3:2 tac=7150 earfcn=2000:20000 mapped_earfcn=4200:22200

# Set GNB_ID=50090 with pci=50 and pci=51
set_gnb id=4 type=external plmn=555:10 s1u=$GNB_X2_ADDR x2=$GNB_X2_ADDR:36422 x2_peers=none
set_cell id=4 gnb=4 eci=0x0C3AA01 pci=16:2 tac=4 nrci=0x3FFF tdd_cell=on
set_cell id=5 gnb=4 eci=0x0C3AA02 pci=17:0 tac=4 nrci=0x3FFF tdd_cell=on

mme_pool_area id=1 mmegi=1 plmn=555:10 eq_plmn=555:10 tac_list=777,111,222,444,333,7150

set_mme id=1 ip=$DAEMON_IP:$DAEMON_PORT s1=$MME1_S1_ADDR:36412 supported_rat=lte,nblte pool=1:1

set_sgw id=1 ip=$DAEMON_IP:$DAEMON_PORT s1u=$SGW_S1U_ADDR s11=$SGW_S11_ADDR:2153

set_pgw id=1 type=simulated ip=$DAEMON_IP:$DAEMON_PORT addr=$PGW_ADDR/16 apn=lteapn1.com.mnc69.mcc450.gprs devtype=tun devname=tunLTEA13


# ---------------------------------------------------------------------------------------------------
# debug_log command configures the logging info level for each simulated component
# 0 – debug all information,1 – Information,2 – Warnings,3 – Errors,4 – Fatal errors (only fatal errors), 5 – turn debug off
# set_log enables dump of console information into the file
# ---------------------------------------------------------------------------------------------------
debug_log level=0


set_log log_to_file=true max_file_num=1

cfg_end

start version_check=off
