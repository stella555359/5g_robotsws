resource_registry:
  5GBTS::Node::Oam: modules/5gbts_oam_node.yaml
  5GBTS::Node::Oam::In::Redundant: modules/5gbts_oam_node_in_redundant.yaml
  5GBTS::Node::Common: modules/5gbts_common_node.yaml
  5GBTS::Node::Common::Nplus: modules/5gbts_common_node_nplus.yaml
  5GBTS::Node::Common::Redundant: modules/5gbts_common_node_redundant.yaml
  5GBTS::Node::CPIF::Redundant: modules/5gbts_cpif_node_redundant.yaml
  5GBTS::Node::DB::In::Redundant: modules/5gbts_db_node_redundant.yaml
