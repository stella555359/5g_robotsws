  RCP::VolumeGroup::LVMGFS: modules/5gbts_volume_group_lvm_gfs.yaml
parameters:
  image: AirFrameVirtualized-7.1106.568
  ssh_public_key: 'ssh-rsa  Generated-by-Nova'
  vnf_name: c18b-5gbts
  cluster_id: '01'
  vnfc_type_name_case: lower
  flavors:
    oam: 5gbts_oam
    cpcl: 5gbts_cpcl
    cpif: 5gbts_cpif
    cpnb: 5gbts_cpnb
    cpnrt: 5gbts_cpnrt
    cpue: 5gbts_cpue
    upue: 5gbts_upue
    uvm: 5gbts_uvm
    db: 5gbts_db
  timezone: Europe/Warsaw
  oam_network: c18b-5gbts-oam_net-v6
  oam_ip_logical: 2A00:8A00:6000:607c::FD18
  oam_ip_0: 2A00:8A00:6000:607c::FD17
  oam_ip_1: 2A00:8A00:6000:607c::FD19
  oam_default_gw: 2A00:8A00:6000:607c::FD01
  ntp_servers: [ '2a00:8a00:6000:607c::21fd' ]
  dns_forwarders: [ '2a00:8a00:6000:6f07::2' ]
  internal_network: c18b-5gbts-internal_net-v4
  internal_srv_network: c18b-5gbts-internal_srv_net-v4
  internal_e1_network: c18b-5gbts-internal_e1_net-v4
  internal_networks:
    internal: [ 192.168.41.0/24, 192.168.41.2, 192.168.41.165 ]
    internal_srv: [ 192.168.43.0/24, 192.168.43.2, 192.168.43.165 ]
    internal_e1: [ 192.168.45.0/24, 192.168.45.2, 192.168.45.165 ]
  external_networks:
    extnet_a: c18b-5gbts-extnet-a_net-v6
    extnet_b: c18b-5gbts-extnet-b_net-v6
  ext_port:
    f1om_sid: 623
    fronthaul_cpif_sid: 624
    fronthaul_upue_sid: 624
    backhaul_cpif_sid: 625
    backhaul_upue_sid: 625
    round_check_sid: 626

    f1om_role_cpcl_0: Tracing
    f1om_ip_cpcl_0: [ '2A00:8A00:6000:607c::FE40/120' ]
    f1om_role_cpcl_1: Tracing
    f1om_ip_cpcl_1: [ '2A00:8A00:6000:607c::FE41/120' ]
    f1om_role_cpnb_0: Tracing
    f1om_ip_cpnb_0: [ '2A00:8A00:6000:607c::FE42/120' ]
    f1om_role_cpnb_1: Tracing
    f1om_ip_cpnb_1: [ '2A00:8A00:6000:607c::FE43/120' ]
    f1om_role_cpif_0: Tracing
    f1om_ip_cpif_0: [ '2A00:8A00:6000:607c::FE44/120' ]
    f1om_role_cpif_1: Tracing
    f1om_ip_cpif_1: [ '2A00:8A00:6000:607c::FE45/120' ]
    f1om_role_upue: Tracing
    f1om_ip_upue: [[ '2A00:8A00:6000:607c::FE46/120' ], [ '2A00:8A00:6000:607c::FE47/120' ], [ '2A00:8A00:6000:607c::FE48/120' ], [ '2A00:8A00:6000:607c::FE49/120' ], [ '2A00:8A00:6000:607c::FE50/120' ]]
    f1om_role_cpue: Tracing
    f1om_ip_cpue: [[ '2A00:8A00:6000:607c::FE51/120' ], [ '2A00:8A00:6000:607c::FE52/120' ]]
    f1om_role_cpnrt: Tracing
    f1om_ip_cpnrt: [ '2A00:8A00:6000:607c::FE53/120' ]
    f1om_role_oam_0: Tracing
    f1om_ip_oam_0: [ '2A00:8A00:6000:607c::FE54/120' ]
    f1om_role_oam_1: Tracing
    f1om_ip_oam_1: [ '2A00:8A00:6000:607c::FE55/120' ]
    f1om_role_oam: 'F1-M'
    f1om_ip_oam: [ '2A00:8A00:6000:607c::FE56/120' ]
    fronthaul_role_cpif: 'F1-C'
    fronthaul_ip_cpif: [ '2A00:8A00:6000:607c::FF30/120' ]
    backhaul_role_cpif: 'X2-C'
    backhaul_ip_cpif: [ '2A00:8A00:6000:607c::1:30/120' ]
    fronthaul_role_upue: 'F1-U'
    fronthaul_ip_upue: [[ '2A00:8A00:6000:607c::FF31/120' ], [ '2A00:8A00:6000:607c::FF32/120' ], [ '2A00:8A00:6000:607c::FF33/120' ], [ '2A00:8A00:6000:607c::FF34/120' ], [ '2A00:8A00:6000:607c::FF35/120' ]]
    backhaul_role_upue: 'S1-U,X2-U'
    backhaul_ip_upue: [[ '2A00:8A00:6000:607c::1:31/120' ], [ '2A00:8A00:6000:607c::1:32/120' ], [ '2A00:8A00:6000:607c::1:33/120' ], [ '2A00:8A00:6000:607c::1:34/120' ], [ '2A00:8A00:6000:607c::1:35/120' ]]

  enable_sriov: true
  oam_port_type: virtio
  int_port_type: virtio
  ext_port_type: sriov
  oam_port_mtu: 1500
  int_port_mtu: 1500
  ext_port_mtu: 1500
  oam_pmtu: 1500
  int_pmtu: 1500
  ext_pmtu: 1500
  availability_zones:
    default: nova
    oam_000:
    oam_001:
    cpcl_000:
    cpcl_001:
    cpnb_000:
    cpnb_001:
    cpif_000:
    cpif_001:
    cpnrt_000:
    db_000:
    db_001:
    db_002:
    uvm:
    cpues:
      default: nova
      availability_zone_list:
        -
    upues:
      default: nova
      availability_zone_list:
        - nova
  oam_security_group: c18b-5gbts-oam-security-group
  number_of_upue_nodes: 5
  number_of_cpue_nodes: 2
  number_of_uvm_nodes: 0
  cloudplatform: osp
  vnf_layout: basic
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
