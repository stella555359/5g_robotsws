  enable_sriov: true
  oam_port_type: virtio
  int_port_type: virtio
  ext_port_type: sriov
  oam_port_mtu: 1500
  int_port_mtu: 1500
  ext_port_mtu: 1500
  oam_pmtu: 1500
  int_pmtu: 1500
  ext_pmtu: 1500
  availability_zones:
    default: nova
    oam_0:
    cpcl_0:
    cpcl_1:
    cpnb_0:
    cpnb_1:
    cpif_0:
    cpif_1:
    cpnrt_0:
    db_0:
    uvm:
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  oam_security_group: c18c-5gbts-oam-security-group
  number_of_upue_nodes: 5
  number_of_cpue_nodes: 2
  number_of_uvm_nodes: 0
  cloudplatform: osp
  vnf_layout: basic
  extra_cloud_config_data:
      system_info:
        default_user:
          name: robot
      users:
      - default
      - name: robot
        gecos: Robot user for test automation purposes
        primary-group: root
        lock_passwd: false
        plain_text_passwd: 'rastre1'
        home: /home/robot
        shell: /bin/bash
        sudo:
        - ALL=(ALL) NOPASSWD:ALL
      write_files:
      - content: |
          robot
        path: /etc/opt/nokia/setupsshkey.d/testusers
        permissions: '0644'

