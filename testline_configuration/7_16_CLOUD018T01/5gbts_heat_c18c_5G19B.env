parameters:
  image: AirFrameVirtualized-7.1106.568
  ssh_public_key: "ssh-rsa  Generated-by-Nova"
  vnf_name: c18c-5gbts
  cluster_id: '01'
  vnfc_type_name_case: lower
  flavors:
    oam: 5gbts_oam
    cpcl: 5gbts_cpcl
    cpif: 5gbts_cpif
    cpnb: 5gbts_cpnb
    cpnrt: 5gbts_cpnrt
    cpue: 5gbts_cpue
    upue: 5gbts_upue
    uvm: 5gbts_uvm
    db: 5gbts_db
  timezone: Europe/Warsaw
  oam_network: c18c-5gbts-oam_net-v6
  oam_ip_logical: 2A00:8A00:6000:607c::1:818
  oam_ip_0: 2A00:8A00:6000:607c::1:817
  oam_ip_1: 2A00:8A00:6000:607c::1:819
  oam_default_gw: 2A00:8A00:6000:607c::1:801
  ntp_servers: [ '2a00:8a00:6000:607c::21fd' ]
  dns_forwarders: [ '2a00:8a00:6000:6f07::2' ]
  internal_network: c18c-5gbts-internal_net-v4
  internal_srv_network: c18c-5gbts-internal_srv_net-v4
  internal_e1_network: c18c-5gbts-internal_e1_net-v4
  internal_networks:
    internal: [ 192.168.61.0/24, 192.168.61.2, 192.168.61.165 ]
    internal_srv: [ 192.168.63.0/24, 192.168.63.2, 192.168.63.165 ]
    internal_e1: [ 192.168.65.0/24, 192.168.65.2, 192.168.65.165 ]
  external_networks:
    extnet_a: c18c-5gbts-extnet-a_net-v6
    extnet_b: c18c-5gbts-extnet-b_net-v6
  ext_port:
    f1om_sid: 634
    fronthaul_cpif_sid: 635
    fronthaul_upue_sid: 635
    backhaul_cpif_sid: 636
    backhaul_upue_sid: 636
    round_check_sid: 637
    f1om_role_cpcl_0: Tracing
    f1om_ip_cpcl_0: [ '2A00:8A00:6000:607c::1:944/120' ]
    f1om_role_cpcl_1: Tracing
    f1om_ip_cpcl_1: [ '2A00:8A00:6000:607c::1:945/120' ]
    f1om_role_cpnb_0: Tracing
    f1om_ip_cpnb_0: [ '2A00:8A00:6000:607c::1:946/120' ]
    f1om_role_cpnb_1: Tracing
    f1om_ip_cpnb_1: [ '2A00:8A00:6000:607c::1:947/120' ]
    f1om_role_cpif_0: Tracing
    f1om_ip_cpif_0: [ '2A00:8A00:6000:607c::1:948/120' ]
    f1om_role_cpif_1: Tracing
    f1om_ip_cpif_1: [ '2A00:8A00:6000:607c::1:949/120' ]
    f1om_role_upue: Tracing
    f1om_ip_upue: [[ '2A00:8A00:6000:607c::1:950/120' ], [ '2A00:8A00:6000:607c::1:951/120' ], [ '2A00:8A00:6000:607c::1:952/120' ], [ '2A00:8A00:6000:607c::1:953/120' ], [ '2A00:8A00:6000:607c::1:954/120' ]]
    f1om_role_cpue: Tracing
    f1om_ip_cpue: [[ '2A00:8A00:6000:607c::1:955/120' ], [ '2A00:8A00:6000:607c::1:956/120' ]]
    f1om_role_cpnrt: Tracing
    f1om_ip_cpnrt: [ '2A00:8A00:6000:607c::1:957/120' ]
    f1om_role_oam_0: Tracing
    f1om_ip_oam_0: [ '2A00:8A00:6000:607c::1:958/120' ]
    f1om_role_oam_1: Tracing
    f1om_ip_oam_1: [ '2A00:8A00:6000:607c::1:959/120' ]
    f1om_role_oam: 'F1-M'
    f1om_ip_oam: [ '2A00:8A00:6000:607c::1:960/120' ]
    fronthaul_role_cpif: 'F1-C'
    fronthaul_ip_cpif: [ '2A00:8A00:6000:607c::1:A44/120' ]
    backhaul_role_cpif: 'X2-C'
    backhaul_ip_cpif: [ '2A00:8A00:6000:607c::1:B34/120' ]
    fronthaul_role_upue: 'F1-U'
    fronthaul_ip_upue: [[ '2A00:8A00:6000:607c::1:A45/120' ], [ '2A00:8A00:6000:607c::1:A46/120' ], [ '2A00:8A00:6000:607c::1:A47/120' ], [ '2A00:8A00:6000:607c::1:A48/120' ], [ '2A00:8A00:6000:607c::1:A49/120' ]]
    backhaul_role_upue: 'S1-U,X2-U'
    backhaul_ip_upue: [['2A00:8A00:6000:607c::1:B35/120' ], [ '2A00:8A00:6000:607c::1:B36/120' ], [ '2A00:8A00:6000:607c::1:B37/120' ], [ '2A00:8A00:6000:607c::1:B38/120' ], [ '2A00:8A00:6000:607c::1:B39/120' ]]
  enable_sriov: true
  oam_port_type: virtio
  int_port_type: virtio
  ext_port_type: sriov
  oam_port_mtu: 1500
  int_port_mtu: 1500
  ext_port_mtu: 1500
  oam_pmtu: 1500
  int_pmtu: 1500
  ext_pmtu: 1500
  availability_zones:
    default: nova
    oam_000:
    oam_001:
    cpcl_000:
    cpcl_001:
    cpnb_000:
    cpnb_001:
    cpif_000:
    cpif_001:
    cpnrt_000:
    db_000:
    db_001:
    db_002:
    uvm:
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  oam_security_group: c18c-5gbts-oam-security-group
  number_of_upue_nodes: 5
  number_of_cpue_nodes: 2
  number_of_uvm_nodes: 0
  cloudplatform: osp
  vnf_layout: basic
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
