parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: tl62
  availability_zone: nova
  cluster_id: 1
  dns_forwarders: [ '2a00:8a00:8000:101::2' ]
  flavors:
    db: tl62_db
    sn: tl62_sn
    uvm: tl62_uvm
    oam: tl62_oam
    cpcl: tl62_cpcl
    cpif: tl62_cpif
    cpnrt: tl62_cpnrt
    cpnb: tl62_cpnb
    cpue: tl62_cpue
    upue: tl62_upue
  ntp_servers: 10.56.126.22
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin:
    _nokfsoperator:
    root:
  timezone: Europe/Warsaw
  uvm_image:
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: tl62-oam_net-v6
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3414']
    f1m:
      uuid: tl62-f1m_net-v6
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3514']
    f1c:
      uuid: tl62-f1m_net-v6
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3515']
    x2c:
      uuid: tl62-x2c_net-v6
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3714']
    s1c:
      uuid: tl62-x2c_net-v6
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3714']
    f1u:
      uuid: tl62-f1m_net-v6
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3516']
    s1u:
      uuid: tl62-x2c_net-v6
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3715']
    x2u:
      uuid: tl62-x2c_net-v6
      fixed_ips: [ip_address: '2A00:8A00:6000:607c::3715']
    tracing:
      uuid: tl62-tracing_net-v6

  internal_provider_networks: c02t002_fronthaul
  internal_e1_provider_networks: c02t002_fronthaul
  vnf_layout: basic
  config_external_ip: enabled

  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
