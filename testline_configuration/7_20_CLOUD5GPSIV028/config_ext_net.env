parameters:
  network_opts:
    vnf_name: cv28-5gbts
    dns_forwarders: 10.10.10.10
    number_of_networks: 4 

    # all external networks
    networks:


      - name: oam
        cidr: 10.14.48.0/23
        gateway: 10.14.49.254
        start: 10.14.48.28
        end: 10.14.48.28
        net_type: vlan
        sid: 1000
        ip_ver: 4
        provider: physnet1

      - name: f1m
        cidr: 192.168.2.48/28
        gateway: 192.168.2.62
        start: 192.168.2.49
        end: 192.168.2.54
        net_type: vlan
        sid: 1111
        ip_ver: 4
        provider: physnet3

      - name: f1c
        cidr: 192.168.2.64/28
        gateway: 192.168.2.78
        start: 192.168.2.65
        end: 192.168.2.70
        net_type: vlan
        sid: 1112
        ip_ver: 4
        provider: physnet3

      - name: f1u
        cidr: 192.168.2.80/28
        gateway: 192.168.2.94
        start: 192.168.2.81
        end: 192.168.2.81
        net_type: vlan
        sid: 1113
        ip_ver: 4
        provider: physnet3

      - name: backhaul
        cidr: 10.200.0.0/23
        gateway: 10.200.0.1
        start: 10.200.0.125
        end: 10.200.0.138
        net_type: vlan
        sid: 3199
