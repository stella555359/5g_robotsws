      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        net_type: vlan
        sid: 1262
        ip_ver: 4
        provider: physnet32-3

      - name: backhaul
        cidr: 192.168.4.0/24
        gateway: 192.168.4.1
        start: 192.168.4.100
        end: 192.168.4.200
        net_type: vlan
        sid: 1250
        ip_ver: 4
        provider: physnet32-1

      - name: tracing
        cidr: 192.168.5.0/24
