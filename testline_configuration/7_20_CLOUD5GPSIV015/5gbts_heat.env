parameters:
  image: 5.3135.558
  ssh_public_key: "ssh-rsa  Generated-by-Nova"
  vnf_name: 5gbts-realcore
  cluster_id: '01'
  vnfc_type_name_case: upper
  flavors:
    oam: 5gbts_oam
    cpcn: 5gbts_cpcn
    cpcl: 5gbts_cpcl
    cpif: 5gbts_cpif
    cpnb: 5gbts_cpnb
    cpnrt: 5gbts_cpnrt
    cpue: 5gbts_cpue
    upue: 5gbts_upue
    uvm: 5gbts_uvm
    db: 5gbts_db
  timezone: Europe/Paris
  oam_network: 5gbts-realcore-oam_net-v4
  oam_ip: 10.14.49.14
  oam_default_gw: 10.14.49.254
  ntp_servers: 10.14.35.110
  dns_forwarders: [ 10.14.35.110 ] 
  internal_network: 5gbts-realcore-internal_net-v4
  internal_srv_network: 5gbts-realcore-internal_srv_net-v4
  internal_e1_network: 5gbts-realcore-internal_e1_net-v4
  internal_networks:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
    internal_e1: [ 192.168.5.0/24, 192.168.5.2, 192.168.5.165 ]
  external_networks:
    extnet_a: 5gbts-realcore-extnet-a_net-v4
    extnet_b: 5gbts-realcore-extnet-b_net-v4
  ext_port:
    f1om_sid_a: 105
    fronthaul_cpif_sid_a: 115
    fronthaul_upue_sid_a: 115
    backhaul_cpif_sid_a: 415
    backhaul_upue_sid_a: 415
    f1om_sid_b: 1204
    fronthaul_cpif_sid_b:  116
    fronthaul_upue_sid_b:  116
    backhaul_cpif_sid_b: 416
    backhaul_upue_sid_b: 416

    f1om_role_cpcl_0: Tracing
    f1om_ip_cpcl_0: [ '192.128.46.40/32' ]
    f1om_role_cpcl_1: Tracing
    f1om_ip_cpcl_1: [ '192.128.46.140/32' ]
    f1om_role_cpnb_0: Tracing
    f1om_ip_cpnb_0: [ '192.128.48.39/32' ]
    f1om_role_cpnb_1: Tracing
    f1om_ip_cpnb_1: [ '192.128.48.139/32' ]
    f1om_role_cpif_0: Tracing
    f1om_ip_cpif_0: [ '192.128.18.18/32' ]
    f1om_role_cpif_1: Tracing
    f1om_ip_cpif_1: [ '192.128.18.118/32' ]
    f1om_role_upue: Tracing
    f1om_ip_upue: [ '192.128.38.38/32' ]
    f1om_role_cpue: Tracing
    f1om_ip_cpue: [ '192.128.46.41/32' ]
    f1om_role_cpnrt: Tracing
    f1om_ip_cpnrt: [ '192.128.13.13/32' ]
    f1om_role_oam: 'F1-M'
    f1om_ip_oam: [ '192.128.36.37/32' ]
    fronthaul_role_cpif: 'F1-C'
    fronthaul_ip_cpif: [ '192.128.16.16/32' ]
    fronthaul_role_upue: 'F1-U'
    fronthaul_ip_upue: [ '192.128.36.36/32' ]
    backhaul_role_cpif: 'S1-C,X2-C'
    backhaul_ip_cpif: [ '10.28.15.97/29' ]
    backhaul_role_upue: 'S1-U,X2-U'
    backhaul_ip_upue: [ '10.28.15.98/29' ]

    f1om_ip_oam_a: [ '192.128.6.6/24' ]
    f1om_ip_cpcl_a_0: [ '192.128.6.8/24' ]
    f1om_ip_cpcl_a_1: [ '192.128.6.18/24' ]
    f1om_ip_cpnb_a_0: [ '192.128.6.7/24' ]
    f1om_ip_cpnb_a_1: [ '192.128.6.17/24' ]
    f1om_ip_cpif_a_0: [ '192.128.6.4/24' ]
    f1om_ip_cpif_a_1: [ '192.128.6.14/24' ]
    f1om_ip_upue_a: [ '192.128.6.5/24' ]
    f1om_ip_cpue_a: [ '192.128.6.9/24' ]
    f1om_ip_cpnrt_a: [ '192.128.6.13/24' ]
    fronthaul_ip_cpif_a: [ '192.128.2.4/24' ]
    fronthaul_ip_upue_a: [ '192.128.2.5/24' ]
    backhaul_ip_cpif_a: [ '192.128.4.4/24' ]
    backhaul_ip_upue_a: [ '192.128.4.5/24' ]

    f1om_ip_oam_b: [ '192.128.9.6/24' ]
    f1om_ip_cpcl_b_0: [ '192.128.9.8/24' ]
    f1om_ip_cpcl_b_1: [ '192.128.9.18/24' ]
    f1om_ip_cpnb_b_0: [ '192.128.9.7/24' ]
    f1om_ip_cpnb_b_1: [ '192.128.9.17/24' ]
    f1om_ip_cpif_b_0: [ '192.128.9.4/24' ]
    f1om_ip_cpif_b_1: [ '192.128.9.14/24' ]
    f1om_ip_upue_b: [ '192.128.9.5/24' ]
    f1om_ip_cpue_b: [ '192.128.9.9/24' ]
    f1om_ip_cpnrt_b: [ '192.128.9.13/24' ]
    fronthaul_ip_cpif_b: [ '192.128.7.4/24' ]
    fronthaul_ip_upue_b: [ '192.128.7.5/24' ]
    backhaul_ip_cpif_b: [ '192.128.8.4/24' ]
    backhaul_ip_upue_b: [ '192.128.8.5/24' ]
  enable_sriov: true
  oam_port_type: virtio
  int_port_type: virtio
  ext_port_type: sriov
  oam_port_mtu: 1500
  int_port_mtu: 1400
  ext_port_mtu: 9000
  oam_pmtu: 1500
  int_pmtu: 1400
  ext_pmtu: 9000
  availability_zone: cpu.pin_isolate
  number_of_upue_nodes: 1
  number_of_cpue_nodes: 1
  number_of_uvm_nodes: 0
  cloudplatform: osp
  vnf_layout: basic
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
