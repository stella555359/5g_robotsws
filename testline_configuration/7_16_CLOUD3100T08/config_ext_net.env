parameters:
  network_opts:
    vnf_name: c3100t08
    dns_forwarders: 10.10.10.10
    networks:
      - name: oam
        cidr: 10.44.200.0/24
        gateway: 10.44.200.1
        start: 10.44.200.96
        end: 10.44.200.97
        net_type: vlan
        sid: 300
        ip_ver: 4
        provider: c3100_backhaul

      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        net_type: vlan
        sid: 3173
        ip_ver: 4
        provider: c3100_fronthaul

      - name: backhaul
        cidr: 10.1.1.0/24
        gateway: 10.1.1.1
        start: 10.1.1.2
        end: 10.1.1.252
        net_type: vlan
        sid: 3172
        ip_ver: 4
        provider: c3100_backhaul

      - name: tracing
        cidr: 192.168.4.0/24
        gateway: 192.168.4.1
        start: 192.168.4.100
        end: 192.168.4.200
        net_type: vlan
        sid: 3174
        ip_ver: 4
        provider: c3100_fronthaul

