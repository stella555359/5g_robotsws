parameters:
  image: 
  ssh_public_key: "ssh-rsa "
  vnf_name: c3100t08
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  flavors:
    db: c3100t08_db
    uvm: c3100t08_uvm
    oam: c3100t08_oam
    cpcl: c3100t08_cpcl
    cpif: c3100t08_cpif
    cpnrt: c3100t08_cpnrt
    cpnb: c3100t08_cpnb
    cpue: c3100t08_cpue
    upue: c3100t08_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  timezone: Europe/Warsaw
  uvm_image: 
  internal_segment_ids:
    internal: 3175
    internal_srv: 3176
    internal_e1: 3178
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.12.0/24, 192.168.12.2, 192.168.12.165 ]
  external_networks:
    oam:
      uuid: c3100t08-oam_net-v4
      fixed_ips: [ip_address: 10.44.200.96]
    f1m:
      uuid: c3100t08-fronthaul_net-v4
      fixed_ips: [ip_address: 192.168.2.111]
      fixed_v6_ips: []
    f1c:
      uuid: c3100t08-fronthaul_net-v4
      fixed_ips: [ip_address: 192.168.2.112]
      fixed_v6_ips: []
    x2c:
      uuid: c3100t08-backhaul_net-v4
      fixed_ips: [ip_address: 10.1.1.8]
      fixed_v6_ips: []
    s1c:
      uuid: c3100t08-backhaul_net-v4
      fixed_ips: [ip_address: 10.1.1.8]
      fixed_v6_ips: []
    f1u:
      uuid: c3100t08-fronthaul_net-v4
      fixed_ips: []
      fixed_v6_ips: []
    x2u:
      uuid: c3100t08-backhaul_net-v4
      fixed_ips: []
      fixed_v6_ips: []
    s1u:
      uuid: c3100t08-backhaul_net-v4
      fixed_ips: []
      fixed_v6_ips: []
    tracing:
      uuid: c3100t08-tracing_net-v4

  internal_provider_networks: c3100_fronthaul
  internal_e1_provider_networks: c3100_fronthaul
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
   system_info:
     default_user:
       name: robot
   users:
   - default
   - name: robot
     gecos: Robot user for test automation purposes
     primary-group: root
     lock_passwd: false
     plain_text_passwd: 'rastre1'
     home: /home/robot
     shell: /bin/bash
     sudo:
     - ALL=(ALL) NOPASSWD:ALL
   write_files:
   - content: |
       robot
     path: /etc/opt/nokia/setupsshkey.d/testusers
     permissions: '0644'