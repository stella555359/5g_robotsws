        end: 10.14.48.43
        net_type: vlan
        sid: 1000
        ip_ver: 4
        provider: physnet1
      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.110
        end: 192.168.2.120
        ip_ver: 4
        #cidr_v6: fc00::172:16:5:0/112
        #gateway_v6: fc00::172:16:5:1
        #start_v6:  fc00::172:16:5:100
        #end_v6:  fc00::172:16:5:200
        #ip_v6_ver: 6
        net_type: vlan
        sid: 1100
        provider: physnet3
      - name: backhaul
        cidr: 10.28.6.208/29
        gateway: 10.28.6.214
        start: 10.28.6.209
        end: 10.28.6.210
        ip_ver: 4
        #cidr_v6: fc00::172:16:2:0/112
        #gateway_v6: fc00::172:16:2:1
        #start_v6: fc00::172:16:2:100
        #end_v6: fc00::172:16:2:200
        #ip_v6_ver: 6
