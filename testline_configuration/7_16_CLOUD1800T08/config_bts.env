parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: c1800-t08
  availability_zone: nova
  cluster_id: 1
  dns_forwarders: [ 10.44.45.2 ]
  flavors:
    db: c1800-t08_db
    sn: c1800-t08_sn
    uvm: c1800-t08_uvm
    oam: c1800-t08_oam
    cpcl: c1800-t08_cpcl
    cpif: c1800-t08_cpif
    cpnrt: c1800-t08_cpnrt
    cpnb: c1800-t08_cpnb
    cpue: c1800-t08_cpue
    upue: c1800-t08_upue
  ntp_servers: 10.44.138.23
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin: <hashed password for _nokadmin>
    _nokfsoperator: <hashed password for _nokfsoperator>
    root: <hashed password for root>
  timezone: Europe/Warsaw
  uvm_image:
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.12.0/24, 192.168.12.2, 192.168.12.165 ]
  external_networks:
    oam:
      uuid: c1800-t08-oam_T07_net-v4
      fixed_ips: [ip_address: 10.42.55.138]
    f1m:
      uuid: c1800-t08-fronthaul_T07_net-v4
      fixed_ips: [ip_address: 192.168.2.171]
    f1c:
      uuid: c1800-t08-fronthaul_T07_net-v4
      fixed_ips: [ip_address: 192.168.2.172]
    x2c:
      uuid: c1800-t08-backhaul_T07_net-v4
      fixed_ips: [ip_address: 10.1.1.3]
    s1c:
      uuid: c1800-t08-backhaul_T07_net-v4
      fixed_ips: [ip_address: 10.1.1.3]
    f1u:
      uuid: c1800-t08-fronthaul_T07_net-v4
      fixed_ips: [ip_address: 192.168.2.173]
    x2u:
      uuid: c1800-t08-backhaul_T07_net-v4
      fixed_ips: [ip_address: 10.1.1.4]
    s1u:
      uuid: c1800-t08-backhaul_T07_net-v4
      fixed_ips: [ ip_address: 10.1.1.4 ]
    tracing:
      uuid: c1800-t08-tracing_T07_net-v4

  internal_provider_networks: cluster03_fronthaul
  internal_e1_provider_networks: cluster03_fronthaul
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
