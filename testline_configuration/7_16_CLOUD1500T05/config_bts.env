parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: c1500t05
  availability_zone: nova
  cluster_id: 1
  dns_forwarders: [ 10.44.45.2 ]
  flavors:
    db: cloud028t05_db
    sn: cloud028t05_sn
    uvm: cloud028t05_uvm
    oam: cloud028t05_oam
    cpcl: cloud028t05_cpcl
    cpif: cloud028t05_cpif
    cpnrt: cloud028t05_cpnrt
    cpnb: cloud028t05_cpnb
    cpue: cloud028t05_cpue
    upue: cloud028t05_upue
  ntp_servers: 10.44.138.23
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokadmin:
    _nokfsoperator:
    root:
  timezone: Europe/Warsaw
  uvm_image:
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.12.0/24, 192.168.12.2, 192.168.12.165 ]
  external_networks:
    oam:
      uuid: cloud028-oam_net-v4
      fixed_ips: [ip_address: 10.44.77.72]
    f1m:
      uuid: cloud028-f1m_net-v4
      fixed_ips: [ip_address: 10.44.77.88]
    f1c:
      uuid: cloud028-f1c_net-v4
      fixed_ips: [ip_address: 10.44.77.104]
    x2c:
      uuid: cloud028-x2c_net-v4
      fixed_ips: [ip_address: 10.44.77.112]
    s1c:
      uuid: cloud028-x2c_net-v4
      fixed_ips: [ip_address: 10.44.77.120]
    f1u:
      uuid: cloud028-f1u_net-v4
      fixed_ips: [ip_address: 10.44.77.136]
    s1u:
      uuid: cloud028-x2u_net-v4
      fixed_ips: [ip_address: 10.44.77.152]
    x2u:
      uuid: cloud028-s1u_net-v4
      fixed_ips: [ip_address: 10.44.77.168]
    tracing:
      uuid: cloud028t05-tracing_net-v4

  internal_provider_networks: c028_bh
  internal_e1_provider_networks: c028_bh
  vnf_layout: basic
  config_external_ip: enabled

  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
