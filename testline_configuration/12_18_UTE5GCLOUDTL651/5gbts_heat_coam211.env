#                                                                                          #
#    Placeholder for 5gbts_heat.env. It will be overwritten by file from Heat Templates    #
#                                                                                          #
parameters:
  image: 
  ssh_public_key: "ssh-rsa "
  vnf_name: eit307
  cluster_id: "1"
  dns_forwarders: [ 10.5.16.69 ]
  dual_stack: disabled
  flavors:
    db: eit307_db
    uvm: eit307_uvm
    oam: eit307_oam
    cpcl: eit307_cpcl
    cpif: eit307_cpif
    cpnrt: eit307_cpnrt
    cpnb: eit307_cpnb
    cpue: eit307_cpue
    upue: eit307_upue
  ntp_servers: 10.5.16.69
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokfsoperator: '!'
    root: '!'
  timezone: Asia/Shanghai
  uvm_image: 
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: ext_net_5G19B-oam_net-v4
      fixed_ips: [ip_address: 10.15.253.207]
    f1c:
      uuid: ext_net_5G19B-fronthaul_net-v4
      fixed_ips: [ip_address: 10.15.253.166]
      fixed_v6_ips: []
    x2c:
      uuid: ext_net_5G19B-backhaul_net-v4
      fixed_ips: [ip_address: 10.15.253.8]
      fixed_v6_ips: []
    f1u:
      uuid: ext_net_5G19B-fronthaul_net-v4
      fixed_ips: []
      fixed_v6_ips: []
    x2u:
      uuid: ext_net_5G19B-backhaul_net-v4
      fixed_ips: []
      fixed_v6_ips: []
    s1u:
      uuid: ext_net_5G19B-backhaul_net-v4
      fixed_ips: []
      fixed_v6_ips: []
    tracing:
      uuid: ext_net_5G19B-tracingInternal_net-v4



  internal_provider_networks: providerInternal
  internal_e1_provider_networks: providerInternal
  vnf_layout: basic
  config_external_ip: enabled
  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
    - { "content": 
      "{ \"nonRootFullBashEnabled\":true }",   
      "path": "/usr/lib/umconfig.d/zzz.json",
      "permissions": "0644" }
