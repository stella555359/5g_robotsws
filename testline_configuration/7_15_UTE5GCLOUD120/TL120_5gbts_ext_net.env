        provider: backplane-1
      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        ip_ver: 4
        net_type: vlan
        sid: 2219
        provider: backplane-3
      - name: backhaul
        cidr: 10.47.200.128/27
        gateway: 10.47.200.158 
        start: 10.47.200.129
        end: 10.47.200.157
        net_type: vlan
        sid: 1400
        ip_ver: 4
