parameters:
  network_opts:
    vnf_name: 5gbts-cv55
    dns_forwarders: 2a00:8a00:2000:1290::3:0001
    number_of_networks: 3

    # all external networks
    networks:

    - name: cv55_fronthaul
      cidr: 2a00:8a00:2000:1290::2:0000/112
      gateway: 2a00:8a00:2000:1290::2:fe
      start: 2a00:8a00:2000:1290::2:0001
      end: 2a00:8a00:2000:1290::2:0011
      net_type: vlan
      sid: 1101
      ip_ver: 6
      provider: physnet3CV55

    - name: cv55_backhaul
      cidr: 2a00:8a00:2000:1290::4:0000/112
      gateway: 2a00:8a00:2000:1290::4:fe
      start: 2a00:8a00:2000:1290::4:0001
      end: 2a00:8a00:2000:1290::4:0002
      net_type: vlan
      sid: 3001
      ip_ver: 6
      provider: physnet1CV55

    - name: cv55_tracing
      cidr: 2a00:8a00:2000:1290::5:0000/112
      gateway: 2a00:8a00:2000:1290::5:fe
      start: 2a00:8a00:2000:1290::5:006e
      end: 2a00:8a00:2000:1290::5:0078
      net_type: vlan
      sid: 1255
      ip_ver: 6
      provider: physnet3CV55

