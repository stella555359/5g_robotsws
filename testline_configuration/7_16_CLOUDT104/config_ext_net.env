        gateway: 10.44.181.1
        start: 10.44.181.82
        end: 10.44.181.83
        net_type: vlan
        sid: 300
        ip_ver: 4
        provider: t01_fronthaul

      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.100
        end: 192.168.2.200
        net_type: vlan
        sid: 3233
        ip_ver: 4
        provider: t01_fronthaul

      - name: backhaul
        cidr: 192.168.4.0/24
        gateway: 192.168.4.1
        start: 192.168.4.100
        end: 192.168.4.200
        net_type: vlan
        sid: 3232
        ip_ver: 4
        provider: t01_backhaul

      - name: tracing
        cidr: 192.168.5.0/24
