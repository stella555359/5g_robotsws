parameters:
  network_opts:
    vnf_name: example-5gbts
    dns_forwarders: 135.117.48.1
    number_of_networks: 3

    # all external networks
    networks:

      - name: oam
        cidr: 10.14.48.0/23
        gateway: 10.14.49.254
        start: 10.14.48.11
        end: 10.14.48.11
        net_type: vlan
        sid: 1000
        ip_ver: 4
        provider: physnet1

      - name: fronthaul
        cidr: 192.168.2.0/24
        gateway: 192.168.2.1
        start: 192.168.2.110
        end: 192.168.2.120
        net_type: vlan
        sid: 1101
        ip_ver: 4
        provider: physnet3

      - name: backhaul
        cidr: 10.200.2.0/23
        gateway: 10.200.2.1
        start: 10.200.2.29
        end: 10.200.2.30
        net_type: vlan
        sid: 3200
        ip_ver: 4
        provider: physnet1

