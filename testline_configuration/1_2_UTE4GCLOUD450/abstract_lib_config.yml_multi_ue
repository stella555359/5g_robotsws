APP_SERVER: &APP_SERVER
    ssh:
        host: '10.63.25.107'
        user: 'ftpuser'
        password: 'ftpuser'
    lte_network_ip: '10.63.25.107'

UE_PC_PORT_DICT: &UE_PC_PORT_DICT
    heartbeat: 6005
    server_command_input: 6007
    server_qxdm_messages: 6008
    server_command_output: 6009
    message_stream_port: 6010

UE_PC36_UE1: &UE_PC36_UE1
    CLASS: QualcommUe
    CONSTRUCTOR_PARAMETERS:
        serial_number: 'd1231ec'
        configuration:
            ue_pc_host: '10.53.164.245'
            # ue_pc_host: 'wmp-ue36-pc.lab0.krk-lab.nsn-rdnet.net'
            port_dict: *UE_PC_PORT_DICT
            login: 'inbabtslabuser'
            password: 'BT5l@bus3rl0g1n'
            qxdm_version: 4
            #com_port: 14
            com_port: 64
            voice_call_technology_timeout: '65'
            #ue_type: 'LINUX'
            ue_type: 'ANDROID'
            # licence_type: '4G'
            iperf_adb_dir: 'su 0 /data/data/com.magicandroidapps.iperf/bin/iperf'
            data_transfer: *APP_SERVER

UE_PC36_UE2: &UE_PC36_UE2
    CLASS: QualcommUe
    CONSTRUCTOR_PARAMETERS:
        serial_number: '795b5970'
        configuration:
            ue_pc_host: '10.53.164.245'
            # ue_pc_host: 'wmp-ue36-pc.lab0.krk-lab.nsn-rdnet.net'
            port_dict: *UE_PC_PORT_DICT
            login: 'inbabtslabuser'
            password: 'BT5l@bus3rl0g1n'
            qxdm_version: 4
            #com_port: 14
            com_port: 38
            voice_call_technology_timeout: '65'
            #ue_type: 'LINUX'
            ue_type: 'ANDROID'
            # licence_type: '4G'
            iperf_adb_dir: 'su 0 /data/data/com.magicandroidapps.iperf/bin/iperf'
            data_transfer: *APP_SERVER


UE_POOLS:
    QualcommUePool:
        inline_config:
            UE_PC_36_UE_CELL_1:                                         # UE name
                <<: *UE_PC36_UE1
                CAPABILITIES:                             # Capabilities that UE has. (as a list)
                    - REAL_UE
                    - REAL_QUALCOMM_UE
                    - CELL_1
                    - PHONE_1
                    - ENB_1_CELL_1
             #   STARTING_CELL: 0x4942F01              # I don't use (care) this line in Android Tests. You can type in this line anythink you want.
            UE_PC_36_UE_CELL_2:                                         # UE name
                <<: *UE_PC36_UE2
                CAPABILITIES:                             # Capabilities that UE has. (as a list)
                    - REAL_UE2
                    - REAL_QUALCOMM_UE
                    - CELL_2
                    - PHONE_1
                    - ENB_1_CELL_1
             #   STARTING_CELL: 0x4942F01              # I don't use (care) this line in Android Tests. You can type in this line anythink you want.


WIFI_ROUTER:
  DEVICES:
    AsusRouter:
      class: RouterWifi
      CONSTRUCTOR_PARAMETERS:
        software: DdWrt  # OpenWrt, Tomato, Linux, Windows
        manufacturer: Broadcomm  # chipset
        model: WRT54-GL  # or whatever else. This is just information
        brand: Asus  # or whatever else. This is just information
        power_offset: 2db
        vlan_2: 172.27.2.1
        console:
          host: 172.27.2.1 # as fallback for lack of ip address
          address: 172.27.2.1 # if address is specified host is purely informational and superfluous
          port: 22
          user: root
          password: rootroot
        cards:
          1:
            nvname: wl0
            name: eth1
            #channels: [1, 2, 3]  # all supported channels is a lot of numbers
            bands: [ISM24GHz]  # band(s) may be specified instead as ISM24GHz UNII1 UNII2a UNII2c UNII3 or ISM165
            standards: [b, g, n]  # assures minimum requirements for channel aggregation and operating bands
            max_channel_aggregation: 40MHz  # hardware limitation on channel aggregation
            ip_address: 192.168.0.1  # IP address assigned to this network interface
            ip_netmasklen: 24  # network mask length in bits
            ssid: dd_wrt
          2:
            nvname: wl1
            name: eth2
            bands: [UNII1, UNII2a]
            standards: [ac]
            max_channel_aggregation: 80MHz
            ip_address: 192.168.0.1
            ip_netmasklen: 24
            ssid: dd_wrt
          3:
            nvname: wl2
            name: eth3
            bands: [UNII2c, UNII3, ISM165]
            standards: [ac]
            max_channel_aggregation: 80MHz
            ip_address: 192.168.0.1
            ip_netmasklen: 24
            ssid: dd_wrt
    PC_1:
      class: PcWifi
      CONSTRUCTOR_PARAMETERS:
        software: Windows
        power_offset: 2db 
        console:
          address: 10.83.205.254 # or ip address
          user: ute
          password: ute
        cards:
          1:
            name: Wireless Network Connection
            bands: [ISM24GHz, UNII1, UNII2a, UNII2c, UNII3]
            standards: [b, g, n, ac]
            max_channel_aggregation: 80MHz
            ip_address: 192.168.0.109
            ip_netmasklen: 24
            ssid: dd_wrt
    PC_2:  # This is class for PCs that don't have WiFi interface and are transmitting via router !!!_NEW_!!!
      class: NetworkPc
      CONSTRUCTOR_PARAMETERS:
        software: Linux
        console:
          address: 127.0.0.1 # or ip address
          port: 22
          user: ute
          password: ute
        cards:
          1:
            name: eth2  # network card used to initiate transfer
            ip_address: 172.27.2.22
            ip_netmasklen: 24

IPSL_POOLS:
    CygwinIpslPool:
        inline_config:
            IPSL_UE_PC_36:                                               # IPSL name
                CAPABILITIES:                                              # Capabilities that IPSL has. (as a list)
                    - PLMN_A                                                # 24408
                CLASS: CygwinSshIpsl                                 # IPSL type.
                CONSTRUCTOR_PARAMETERS:                   # Parameters that will be passed to constructor when Ipsl instance is created.
                    configuration:
                        host: '10.53.164.245'
                        user: 'inbabtslabuser'
                        password: 'BT5l@bus3rl0g1n'
                        install_path: '/cygdrive/c/IpslTools/'
                        source_path: 'c:/IpslTools/automation'
                        protocols_path: '/DIA08IGX'
                        ssh_timeout: 10                                  # optional
                        ssh_port: 22                                        # optional
                        telnet_port: 3900                                # optional

