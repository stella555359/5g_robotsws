resource_registry:
  5GBTS::Common::Parameters: modules/5gbts_common_params.yaml
  5GBTS::Network::Interface: modules/5gbts_network_interface.yaml
  5GBTS::Network::Pool: modules/5gbts_network_pool.yaml
  5GBTS::Network::Pool::Nplus: modules/5gbts_network_pool_nplus.yaml
  5GBTS::Networks::Redundant: modules/5gbts_network_setup_redundant.yaml
  5GBTS::Networks::Basic: modules/5gbts_network_setup_basic.yaml
  5GBTS::Networks::Layout: modules/5gbts_network_layout.yaml
  5GBTS::Networks::LogicalIP: modules/5gbts_ext_network_logical_ip.yaml
  5GBTS::Networks::LogicalIPInterface: modules/5gbts_ext_network_logical_ip_interface.yaml
  5GBTS::Node::Common::Basic: modules/5gbts_common_node.yaml
  5GBTS::Node::Common::Basic::UVM: modules/5gbts_common_node_uvm.yaml
  5GBTS::Node::Common::Redundant: modules/5gbts_common_node_redundant.yaml
  5GBTS::Node::Common::Npuls: modules/5gbts_common_node_nplus.yaml
  5GBTS::Node::CPIF::Redundant: modules/5gbts_cpif_node_redundant.yaml
  5GBTS::Node::OAM::Basic: modules/5gbts_oam_node.yaml
  5GBTS::Node::OAM::Redundant: modules/5gbts_oam_node_redundant.yaml
  5GBTS::Node::DB::Redundant: modules/5gbts_db_nodes_redundant.yaml
  5GBTS::Node::DB::Basic: modules/5gbts_db_node.yaml
  5GBTS::Volume::Attachment: modules/5gbts_volume_attachment.yaml
  5GBTS::Networks::Transformation: modules/5gbts_ext_network_transformation.yaml
  5GBTS::Common::AvailableZones: modules/5gbts_common_available_zones.yaml
  5GBTS::Common::SingleAvailableZone: modules/5gbts_common_single_available_zone.yaml
  5GBTS::Volume::Cinder: modules/5gbts_volume_cinder.yaml
  5GBTS::Volume::LVMLocal: modules/5gbts_volume_lvm_local.yaml
  5GBTS::Volume::LVMNFS: modules/5gbts_volume_lvm_nfs.yaml
  5GBTS::Volume::LVMGFS: modules/5gbts_volume_lvm_gfs.yaml
  5GBTS::VolumeGroup::LVMLocal: modules/5gbts_volume_group_lvm_local.yaml
  5GBTS::VolumeGroup::LVMNFS: modules/5gbts_volume_group_lvm_nfs.yaml
  5GBTS::VolumeGroup::LVMGFS: modules/5gbts_volume_group_lvm_gfs.yaml
parameters:
  image: <image name of 5gbts>
  ssh_public_key: "ssh-rsa "
  vnf_name: cu-tl005
  cluster_id: "1"
  dns_forwarders: [ 10.56.126.31 ]
  dual_stack: disabled
  network-interface-enable: true
  flavors:
    db: cu-tl005-flavor_db
    uvm: cu-tl005-flavor_uvm
    oam: cu-tl005-flavor_oam
    cpcl: cu-tl005-flavor_cpcl
    cpif: cu-tl005-flavor_cpif
    cpnrt: cu-tl005-flavor_cpnrt
    cpnb: cu-tl005-flavor_cpnb
    cpue: cu-tl005-flavor_cpue
    upue: cu-tl005-flavor_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    cpnrt_001: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  cleartextpassword:
    georesiliency: 'VpOn9JSX6r%G#T'
    wsuser: 'A0zY~rP#8Mx@'
  password:
    _nokfsoperator: '!'
    root: '!'
    georesiliency: '$5$rounds=10000$YLkADD9q$/7cX20b5eNgcjvnN1kteCmZR4siF6oQfW1/9hzh4YZ7'
    wsuser: '$5$rounds=10000$6Kj3xARF$6D8XNkLOFxc8yswG4hhvCXyCdHau5WY6yxH/ZxRrle8'
  timezone: Asia/Shanghai
  uvm_image: <image name of upgrade> 
  internal_segment_ids:
    internal: 0
    internal_srv: 0
    internal_e1: 0
  internal_subnets:
    internal: [ 192.168.1.0/24, 192.168.1.2, 192.168.1.165 ]
    internal_srv: [ 192.168.3.0/24, 192.168.3.2, 192.168.3.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.2.0/24, 192.168.2.2, 192.168.2.165 ]
  external_networks:
    oam:
      uuid: df91c999-e0d2-4dc2-9c98-c68686b86b85
      fixed_ips: [ip_address: 10.108.201.195]
    f1c:
      uuid: c16f7232-f411-4ae1-b097-fe590b8dbbd4
      fixed_ips: [ip_address: 10.108.201.2]
      fixed_v6_ips: []
    x2c:
      uuid: 6b9d8c06-c246-4ad3-83da-256336eae931
      fixed_ips: [ip_address: 10.108.201.73]
      fixed_v6_ips: []
    f1u:
      uuid: c16f7232-f411-4ae1-b097-fe590b8dbbd4
      fixed_ips: []
      fixed_v6_ips: []
    x2u:
      uuid: c01f14c6-e04a-4030-998b-089e135670ba
      fixed_ips: []
      fixed_v6_ips: []
    s1u:
      uuid: c01f14c6-e04a-4030-998b-089e135670ba
      fixed_ips: []
      fixed_v6_ips: []
    tracing:
      uuid: c16f7232-f411-4ae1-b097-fe590b8dbbd4

  internal_provider_networks: provider0
  internal_e1_provider_networks: provider0
  vnf_layout: basic
  config_external_ip: enabled
  extra_cloud_config_data:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permissions: '0644'
    - content: |
        { "nonRootFullBashEnabled": true }
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'

