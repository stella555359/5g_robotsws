parameters:
  network_opts:
    vnf_name: c2000t01
    dns_forwarders: 2001:db8:1:1::2
    number_of_networks: 4

    # all external networks
    networks:

      - name: oam
        cidr: 2A00:8A00:6000:607c::d00/120
        gateway: 2A00:8A00:6000:607c::d01
        start: 2A00:8A00:6000:607c::d07
        end: 2A00:8A00:6000:607c::d07
        net_type: vlan
        sid: 352
        ip_ver: 6
        provider: physnet2

      - name: fronthaul
        cidr: fc00::192:168:2:0/112
        gateway: fc00::192:168:2:1
        start: fc00::192:168:2:2
        end: fc00::192:168:2:ffff
        net_type: vlan
        sid: 1320
        ip_ver: 6
        provider: physnet3

      - name: backhaul
        cidr: fc00::192:168:3:0/112
        gateway: fc00::192:168:3:1
        start: fc00::192:168:3:2
        end: fc00::192:168:3:ffff
        net_type: vlan
        sid: 1330
        ip_ver: 6
        provider: physnet2

      - name: tracing
        cidr: fc00::192:168:4:0/112
        gateway: fc00::192:168:4:1
        start: fc00::192:168:4:2
        end: fc00::192:168:4:ffff
        net_type: vlan
        sid: 1340
        ip_ver: 6
        provider: physnet2


