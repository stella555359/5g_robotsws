parameters:
  image:
  ssh_public_key: "ssh-rsa "
  vnf_name: tl104
  cluster_id: "1"
  dns_forwarders: [ 10.43.41.238 ]
  network-interface-enable: true
  flavors:
    db: tl104_db
    uvm: tl104_uvm
    oam: tl104_oam
    cpcl: tl104_cpcl
    cpif: tl104_cpif
    cpnrt: tl104_cpnrt
    cpnb: tl104_cpnb
    cpue: tl104_cpue
    upue: tl104_upue
  ntp_servers: 10.56.126.22
  availability_zones:
    default: nova
    oam_000: nova
    oam_001: nova
    cpcl_000: nova
    cpcl_001: nova
    cpnb_000: nova
    cpnb_001: nova
    cpif_000: nova
    cpif_001: nova
    cpnrt_000: nova
    cpnrt_001: nova
    db_000: nova
    db_001: nova
    db_002: nova
    uvm: nova
    cpues:
      default: nova
      availability_zone_list:
        - nova
    upues:
      default: nova
      availability_zone_list:
        - nova
  number_of_cpue_nodes: 1
  number_of_upue_nodes: 1
  number_of_uvm_nodes: 0
  password:
    _nokfsoperator: '!'
    root: '!'
    wsuser: '$6$rounds=10000$eG4lsC1E5KqcMjYS$E6Zq45tZLtxSRXzT9lpqJjQcyhoQpyHR1bLTGRpYxCbPIs4WDW7PrGhV4uVY0hptxsTZU753MpbgxKArio2hh/'
  timezone: Asia/Shanghai
  uvm_image:
  internal_segment_ids:
    internal: 314
    internal_srv: 315
    internal_e1: 316
  internal_subnets:
    internal: [ 192.168.14.0/24, 192.168.14.2, 192.168.14.165 ]
    internal_srv: [ 192.168.15.0/24, 192.168.15.2, 192.168.15.165 ]
  internal_e1_networks:
    internal_e1: [ 192.168.16.0/24, 192.168.16.2, 192.168.16.165 ]
  external_networks:
    oam:
      uuid: network-scan-cloud-oam_net-v4
      fixed_ips: [ip_address: "10.41.5.68"]
    f1c:
      uuid: network-scan-cloud-fronthaul_net-v4
      fixed_ips: [ip_address: "10.41.5.98"]
      #fixed_v6_ips: []
    x2c:
      uuid: network-scan-cloud-backhaul_net-v4
      fixed_ips: [ip_address: "10.41.5.130"]
      #fixed_v6_ips: []
    f1u:
      uuid: network-scan-cloud-fronthaul_net-v4
      fixed_ips: [ip_address: "10.41.5.99"]
      #fixed_v6_ips: []
    x2u:
      uuid: network-scan-cloud-backhaul_net-v4
      fixed_ips: [ip_address: "10.41.5.131"]
      #fixed_v6_ips: []
    s1u:
      uuid: network-scan-cloud-backhaul_net-v4
      fixed_ips: [ip_address: "10.41.5.132"]
      #fixed_v6_ips: []
    tracing:
      uuid: network-scan-cloud-tracing_net-v4

  internal_provider_networks: providerFronthaul
  internal_e1_provider_networks: providerFronthaul
  vnf_layout: basic
  config_external_ip: enabled
  user_info:
    system_info:
      default_user:
        name: robot
    users:
    - default
    - name: robot
      gecos: Robot user for test automation purposes
      primary-group: root
      lock_passwd: false
      plain_text_passwd: 'rastre1'
      home: /home/robot
      shell: /bin/bash
      sudo:
      - ALL=(ALL) NOPASSWD:ALL
    write_files:
    - content: |
        robot
      path: /etc/opt/nokia/setupsshkey.d/testusers
      permission: '0644'
    - content: |
        { "nonRootFullBashEnabled": true }
      path: /usr/lib/umconfig.d/zzz.json
      permissions: '0644'
