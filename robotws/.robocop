--format {source_rel} | {line}:{col} | {severity}{rule_id} {desc}
## Warnings
--include 0203,0509,0805,0919,1001
# Errors
--include 0314,0315,0320,0801,0802,0803,0813
--configure 0315:severity:E
--configure 0320:pattern:[\.|\,]
--configure 0320:severity:E
--configure 0813:severity:E
# Info
--include 0316
