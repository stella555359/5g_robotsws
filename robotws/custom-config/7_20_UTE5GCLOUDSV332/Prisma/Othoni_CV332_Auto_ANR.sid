            <bit index="0" show="Time bindump SYNC processing after an unexpected loss of sync" />
          </bitfield>
          <bitfield name="EventDumpUL" show="Event triggered dump" writable="true" exportable="false" null="false" index="false" default="0000000000000000" cformat="uint64" format="%016x" bits="9">
            Event triggered verbosity
            <bit index="8" show="Time bindump on 1st SR" />
            <bit index="7" show="Time bindump on 1st PUSCH tx with No Data" />
            <bit index="6" show="Time bindump on 1st PUSCH tx" />
            <bit index="5" show="Time bindump after 2000th attached UE" />
            <bit index="4" show="Time bindump after 500th attached UE" />
            <bit index="3" show="Time bindump after 100th attached UE" />
            <bit index="2" show="Time bindump on 1st RRC Setup" />
            <bit index="1" show="Time bindump on 1st MSG3" />
            <bit index="0" show="Time bindump on 1st RACH" />
          </bitfield>
        </subgroup>
      </group>
    </format>
