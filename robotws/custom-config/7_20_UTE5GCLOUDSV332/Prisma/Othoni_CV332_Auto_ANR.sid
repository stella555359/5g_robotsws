    <format name="l2Cfg" show="L2 Debug facilities" version="1.0">
      <group name="l2Cfg" show="L2 Debug facilities" priority="250">
        <subgroup name="l2Cfg" show="L2 Debug facilities" priority="250">
          <integer name="Version" show="Version" writable="false" exportable="false" null="false" index="false" default="3" min="1" max="2147483647" step="0">Xml version</integer>
          <bitfield name="L2_nr5g_RlcMac_Verbosity" show="NR RLC/MAC verbosity" writable="true" exportable="false" null="false" index="false" default="00000000" format="%08x" bits="32">
            L2_nr5g RlcMac Verbosity
            <bit index="31" show="Bit 32 (Reserved)" />
            <bit index="30" show="Bit 31 (Reserved)" />
            <bit index="29" show="Bit 30 (Reserved)" />
            <bit index="28" show="Bit 29 (Reserved)" />
            <bit index="27" show="Bit 28 (Reserved)" />
            <bit index="26" show="Bit 27 (Reserved)" />
            <bit index="25" show="Bit 26 (Reserved)" />
            <bit index="24" show="Bit 25 (Reserved)" />
            <bit index="23" show="Bit 24" />
            <bit index="22" show="Bit 23" />
            <bit index="21" show="Bit 22" />
            <bit index="20" show="Configured Uplink Grant" />
            <bit index="19" show="CAPS Low verbosity" />
            <bit index="18" show="High verbosity" />
            <bit index="17" show="MAC PDU" />
            <bit index="16" show="DRX" />
            <bit index="15" show="skipUplink" />
            <bit index="14" show="PHR (Power Headroom Report)" />
            <bit index="13" show="DCI at L2" />
            <bit index="12" show="RLC STATUS" />
            <bit index="11" show="Uplink Scheduler" />
            <bit index="10" show="L2-L1 Interface" />
            <bit index="9" show="AMM Verbose" />
            <bit index="8" show="AMM Basic" />
            <bit index="7" show="Secondary Cells" />
            <bit index="6" show="RLC Basic" />
            <bit index="5" show="Uplink HARQ" />
            <bit index="4" show="Uplink SPS" />
            <bit index="3" show="Timing Advance" />
            <bit index="2" show="BSR (Buffer Status Report)" />
            <bit index="1" show="SR (Scheduling Request)" />
            <bit index="0" show="MAC Configuration" />
          </bitfield>
          <bitfield name="L2_nr5g_pdcp_Verbosity" show="NR PDCP verbosity" writable="true" exportable="false" null="false" index="false" default="00000000" format="%08x" bits="32">
            L2_nr5g Pdcp Verbosity
            <bit index="31" show="Bit 32" />
            <bit index="30" show="Bit 31" />
            <bit index="29" show="Bit 30" />
            <bit index="28" show="Bit 29" />
            <bit index="27" show="Bit 28" />
            <bit index="26" show="Bit 27" />
            <bit index="25" show="Bit 26" />
            <bit index="24" show="Bit 25" />
            <bit index="23" show="Bit 24" />
            <bit index="22" show="Bit 23" />
            <bit index="21" show="Bit 22" />
            <bit index="20" show="Bit 21" />
            <bit index="19" show="Bit 20" />
            <bit index="18" show="Bit 19" />
            <bit index="17" show="Bit 18" />
            <bit index="16" show="Bit 17" />
            <bit index="15" show="Bit 16" />
            <bit index="14" show="Bit 15" />
            <bit index="13" show="Bit 14" />
            <bit index="12" show="Bit 13" />
            <bit index="11" show="Bit 12" />
            <bit index="10" show="Bit 11" />
            <bit index="9" show="Bit 10" />
            <bit index="8" show="Bit 9" />
            <bit index="7" show="Bit 8" />
            <bit index="6" show="Bit 7" />
            <bit index="5" show="Bit 6" />
            <bit index="4" show="Bit 5" />
            <bit index="3" show="Bit 4" />
            <bit index="2" show="ROHC" />
            <bit index="1" show="PDCP Reordering" />
            <bit index="0" show="PDCP PDU" />
          </bitfield>
        </subgroup>
      </group>
    </format>
    <db name="l2Cfg" formatname="l2Cfg" version="1.0">
      <record name="Entry" modifiable="true">
        <Integer name="Version" value="3" />
        <bitfield name="L2_nr5g_RlcMac_Verbosity" value="00000000" />
        <bitfield name="L2_nr5g_pdcp_Verbosity" value="00000000" />
      </record>
    </db>
    <format name="bbCfg" show="BB Debug facilities" version="1.0">
      <group name="bbCfg" show="BB Debug facilities" priority="250">
        <subgroup name="bbCfg" show="BB Debug facilities" priority="250">
          <integer name="Version" show="Version" writable="false" exportable="false" null="false" index="false" default="8" cformat="uint32" min="1" max="2147483647" step="0">Xml version</integer>
          <integer name="NumVerbUe" show="Number of verbose UEs" writable="true" exportable="false" null="false" index="false" default="0" cformat="int32" min="0" max="300" step="1">After the specified number of UEs have been attached, the L1 verbosity is decreased for avoiding traces flood. Default 0 means that an optimal value is selected by the software.</integer>
          <bitfield name="GenVerbosity" show="General verbosity" writable="true" exportable="false" null="false" index="false" default="0000000000000000" cformat="uint64" format="%016x" bits="2">
            BB General verbosity
            <bit index="0" show="Reduced verbosity" />
            <bit index="1" show="Developer only verbosity" />
          </bitfield>
          <bitfield name="DlBaseVerbosity" show="Downlink verbosity" writable="true" exportable="false" null="false" index="false" default="0000000000000000" cformat="uint64" format="%016x" bits="17">
            BB Downlink basic verbosity
            <bit index="16" show="create PDSCH FFT dumps (shmem) on CRC errors" />
            <bit index="15" show="LDPC accelerator" />
            <bit index="14" show="DL CELL configuration" />
            <bit index="13" show="DL RNTI parser configuration" />
            <bit index="12" show="DL RNTI measure set configuration" />
            <bit index="11" show="DL RNTI configuration" />
            <bit index="10" show="DL HARQ" />
            <bit index="9" show="LDPC decoder" />
            <bit index="8" show="PDSCH" />
            <bit index="7" show="CSI reference signal" />
            <bit index="6" show="Equalizer" />
            <bit index="5" show="DCI" />
            <bit index="4" show="Polar decoder" />
            <bit index="3" show="PDCCH" />
            <bit index="2" show="SSB (PSS-SSS-PBCH)" />
            <bit index="1" show="BB-AP driver interface" />
            <bit index="0" show="BB-L2 messages" />
          </bitfield>
          <bitfield name="UlBaseVerbosity" show="Uplink verbosity" writable="true" exportable="false" null="false" index="false" default="0000000000000000" cformat="uint64" format="%016x" bits="12">
            BB Uplink basic verbosity
            <bit index="11" show="UL CELL configuration" />
            <bit index="10" show="UL RNTI parser configuration" />
            <bit index="9" show="UL RNTI measure set configuration" />
            <bit index="8" show="UL RNTI configuration" />
            <bit index="7" show="DL_HARQ feedback" />
            <bit index="6" show="CSI reporting" />
            <bit index="5" show="Power control" />
            <bit index="4" show="SR" />
            <bit index="3" show="SRS" />
            <bit index="2" show="PUCCH" />
            <bit index="1" show="PUSCH" />
            <bit index="0" show="L2-BB messages" />
          </bitfield>
          <bitfield name="EventVerbosity" show="Event triggered verbosity" writable="true" exportable="false" null="false" index="false" default="0000000000000000" cformat="uint64" format="%016x" bits="4">
            Event triggered verbosity
            <bit index="3" show="Reserved 3" />
            <bit index="2" show="Reserved 2" />
            <bit index="1" show="Reserved 1" />
            <bit index="0" show="Reserved 0" />
          </bitfield>
        </subgroup>
      </group>
    </format>
    <db name="bbCfg" formatname="bbCfg" version="1.0">
      <record name="1_0" modifiable="true">
        <Integer name="Version" value="8" />
        <Integer name="NumVerbUe" value="0" />
        <bitfield name="GenVerbosity" value="0000000000000000" />
        <bitfield name="DlBaseVerbosity" value="0000000000000000" />
        <bitfield name="UlBaseVerbosity" value="0000000000000000" />
        <bitfield name="EventVerbosity" value="0000000000000000" />
      </record>
      <record name="2_0" modifiable="true">
        <Integer name="Version" value="8" />
        <Integer name="NumVerbUe" value="0" />
        <bitfield name="GenVerbosity" value="0000000000000000" />
        <bitfield name="DlBaseVerbosity" value="0000000000000000" />
        <bitfield name="UlBaseVerbosity" value="0000000000000000" />
        <bitfield name="EventVerbosity" value="0000000000000000" />
      </record>
    </db>
    <format name="bbLteCfg" show="BB Debug facilities" version="1.0">
      <group name="bbLteCfg" show="BB Debug facilities" priority="250">
        <subgroup name="bbLteCfg" show="BB Debug facilities" priority="250">
          <integer name="Version" show="Version" writable="false" exportable="false" null="false" index="false" default="3" min="1" max="2147483647" step="0">Xml version</integer>
          <bitfield name="GenVerbosity" show="General verbosity" writable="true" exportable="false" null="false" index="false" default="0000000000000000" format="%016x" bits="3">
            BB General verbosity
            <bit index="2" show="IOT" />
            <bit index="1" show="No Cfg" />
            <bit index="0" show="Mute All" />
          </bitfield>
          <bitfield name="DlBaseVerbosity" show="Downlink verbosity" writable="true" exportable="false" null="false" index="false" default="0000000000000000" format="%016x" bits="3">
            BB Downlink basic verbosity
            <bit index="2" show="TURBO DECODER" />
            <bit index="1" show="PDSCH" />
            <bit index="0" show="PDCCH" />
          </bitfield>
          <bitfield name="UlBaseVerbosity" show="Uplink verbosity" writable="true" exportable="false" null="false" index="false" default="0000000000000000" format="%016x" bits="5">
            BB Uplink basic verbosity
            <bit index="4" show="Power control" />
            <bit index="3" show="SRS" />
            <bit index="2" show="PUSCH" />
            <bit index="1" show="PUCCH" />
            <bit index="0" show="PRACH" />
          </bitfield>
        </subgroup>
      </group>
    </format>
    <db name="bbLteCfg" formatname="bbLteCfg" version="1.0">
      <record name="10" modifiable="true">
        <Integer name="Version" value="3" />
        <bitfield name="GenVerbosity" value="0000000000000000" />
        <bitfield name="DlBaseVerbosity" value="0000000000000000" />
        <bitfield name="UlBaseVerbosity" value="0000000000000000" />
      </record>
      <record name="20" modifiable="true">
        <Integer name="Version" value="3" />
        <bitfield name="GenVerbosity" value="0000000000000000" />
        <bitfield name="DlBaseVerbosity" value="0000000000000000" />
        <bitfield name="UlBaseVerbosity" value="0000000000000000" />
      </record>
    </db>
    <format name="bbDumpCfg" show="BB Dump facilities" version="1.0">
      <group name="bbDumpCfg" show="BB Dump facilities" priority="250">
        <subgroup name="bbDumpCfg" show="BB Dump facilities" priority="250">
          <integer name="Version" show="Version" writable="false" exportable="false" null="false" index="false" default="6" cformat="uint32" min="1" max="2147483647" step="0">Xml version</integer>
          <bitfield name="EventDumpDL" show="Event triggered dump" writable="true" exportable="false" null="false" index="false" default="0000000000000000" cformat="uint64" format="%016x" bits="17">
            Event triggered verbosity
            <bit index="16" show="Time bindump on DL throughput exceed 100 Mbps" />
            <bit index="15" show="Time bindump PDCCH Blind Detection real time issue" />
            <bit index="14" show="Time bindump on 1st SR" />
            <bit index="13" show="Time bindump on 1st PUSCH tx with No Data" />
            <bit index="12" show="Time bindump on 1st PUSCH tx" />
            <bit index="11" show="Time bindump when CRC errors &gt; 100 per second" />
            <bit index="10" show="Time bindump when CRC errors &gt; 5 per second" />
            <bit index="9" show="Time bindump when CRC errors &gt; 1 per second" />
            <bit index="8" show="Time bindump after 2000th attached UE" />
            <bit index="7" show="Time bindump after 500th attached UE" />
            <bit index="6" show="Time bindump after 100th attached UE" />
            <bit index="5" show="Time bindump after 1st DL Retransmission" />
            <bit index="4" show="Time bindump after 1st RRC Setup" />
