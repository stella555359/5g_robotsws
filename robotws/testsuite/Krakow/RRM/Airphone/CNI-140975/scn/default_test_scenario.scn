transfer ue_traffic_dl
    type udp
    packetSize 200
    dir downlink
    packetRate 1

transfer ue_traffic_ul
    type udp
    packetSize 200
    dir uplink
    packetRate 1

application app_ue_traffic [ DEFAULT ]
    startTransfer ue_traffic_dl on DEFAULT as ue_traffic_dl_alias
    startTransfer ue_traffic_ul on DEFAULT as ue_traffic_ul_alias
    wait 1000
    stopTransfer ue_traffic_dl_alias
    stopTransfer ue_traffic_ul_alias

mobileSession ue_traffic
    connectBearer DEFAULT as DEFAULT_alias
    startApplication app_ue_traffic [ DEFAULT_alias ] as app_ue_traffic_alias &
    wait allApplicationsFinish
    releaseBearer DEFAULT_alias

testScenario
    ue_traffic
        cells [ 111 112 113 114 115 116 117 118 119 120 121 122 ]
        rate 1.0/s
        number 12
