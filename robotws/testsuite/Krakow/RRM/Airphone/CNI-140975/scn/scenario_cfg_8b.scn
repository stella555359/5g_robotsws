#!/bin/bash

transfer transferDL
    type udp
    packetSize 1400
    dir downlink
    packetRate 4500

transfer transferUL
    type udp
    packetSize 1400
    dir uplink
    packetRate 2000

application App [ bearer ]
    startTransfer transferDL on bearer as transferDL
	startTransfer transferUL on bearer as transferUL
    wait 2400
    stopTransfer transferDL
	stopTransfer transferUL

mobileSession testSession
    connectBearer DEFAULT as stream
    startApplication App [ stream ] as myApp
    wait applicationsFinish [ myApp ]
    releaseBearer stream

testScenario
    testSession
    rate 10/s
    number 9
    cells [ 111-113 ]
    ueCapabilities  "release=15 category=12 supported_bands=3:false ca_supported_bands=3:a:a category_dl=17 category_ul=19 ul_64QAM_supported=on dl_256QAM_supported=on supported_ul256qam=all freq_gaps=true"


