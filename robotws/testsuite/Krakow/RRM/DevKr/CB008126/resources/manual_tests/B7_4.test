# https://logs.ute.nsn-rdnet.net/cloud/execution/69f9da87-8906-4ee6-8f8a-2a71e069241d/execution_for_preparation_886897de-0e28-46e5-9403-0cd8800b2071/test_results/
# ; value after semicolon means sleep after acton command
# ; parameter 'o' after semicolon means, that output of the command is required

# CB008126-A-B7 Successful 5QI modification from CA-eligible to CA-eligible QoS flow followed by scell release and addition
# Test verifies that
# - when drb is modified from eligible -> eligible, scell is not released and re-added (blind addition) - stays configured
# - when drb1(eligible) and drb2(incompatible) are modified so that eligible -> incompatible  and incompatible->eligible, scell should not be added
# - when drb is modified from eligible -> eligible, scell is not released  even when A1-based addition is used

# use lua SANSA_TDD_2c_FDD_2c_1eNBsim_1gNBsim.lua
# configure HO on gnb first
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/GBR_5QI_1_2_3_4_71_72_76_128_170_212_254.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/vonr_gbr_activation.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/gNBSim.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/disable_ciphering.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/inter_gnb_ho.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/fdd_tdd_ca.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/cov_based_ca_addition.yaml
$ testsuite/Krakow/RRM/DevKr/CB008126/config/yaml_config/cov_based_nrrel_3_1.yaml
$ testsuite/Krakow/RRM/DevKr/CB008126/config/yaml_config/CB009059/CB009059_cellagglevel_eligible.yaml
$ testsuite/Krakow/RRM/DevKr/CB008126/config/yaml_config/CB008126_enable.yaml
# wait for cell onair again
pause
% [{'MOC': 'NRREL', 'ID': '3-1', 'sCellAdditionMethod': 'blind'}]



# capability must be in file
ue_param id=1 ue_nr_capabilities=b71_n20_b78_n100 capability_file=/home/ute/MN/UTE/robotws/testsuite/Krakow/RRM/DevKr/CB008126/config/capabilities.cfg


# attach UE1, testing eligible -> eligible
ue_change_location id=1 enb=2 cell=3
ue_register id=1;2
set_pdu_param ue=1 pdu=1 trf_type=internal
# default is 5QI-5, qosflow=11
ue_pdu_session_setup pdu=1 ue=1 gw=1 nwslice=1;2
#  scell should be added
pause
trf_data_start ue=1 pdu=1 qfi=1 dir=dl mbps=30 trf_id=1;1
trf_data_start ue=1 pdu=1 qfi=1 dir=ul mbps=10 trf_id=1;5
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
ue_stats_nr id=1 scell=1;o
pause
# change caggrlevel for 5QI-9 (NRDRB-14)
% [{'MOC': 'NRDRB', 'ID': '14', 'cellAggrLevel': '0'}]
pause
# modify 5QI-5 to 5QI-9 -
# paste command here
pause
# verify that scell was not relesed and traffic is present on the same qfi
ue_stats_nr id=1 scell=1;o
pause
ue_kill id=1;5


# attach UE1, testing eligible + incompatible -> incompatible + eligible
% [{'MOC': 'NRDRB', 'ID': '11', 'cellAggrLevel': '2'}]
% [{'MOC': 'NRDRB', 'ID': '13', 'cellAggrLevel': '2'}]
pause
ue_change_location id=1 enb=2 cell=3
ue_register id=1;2
set_pdu_param ue=1 pdu=1 trf_type=internal
# default is 5QI-5, qosflow=11
ue_pdu_session_setup pdu=1 ue=1 gw=1 nwslice=1;2
trf_data_start ue=1 pdu=1 qfi=1 dir=dl mbps=30 trf_id=1;1
trf_data_start ue=1 pdu=1 qfi=1 dir=ul mbps=10 trf_id=1;5
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
#  scell should be added
ue_pdu_session_modify qosflows_to_add=12;2
# scell should be released
pause
# modify 5QI-5 to 5QI-7 and 5QI-6 to 5QI-8  (eligible -> incompatible and incopatible -> eligible_
# paste command here
pause
# verify that scell was not added
ue_kill id=1;5


$ testsuite/Krakow/RRM/DevKr/CB008126/config/yaml_config/CB009059/CB009059_cellagglevel_eligible.yaml
# test the same but with cov based
% [{'MOC': 'NRREL', 'ID': '3-1', 'sCellAdditionMethod': 'covBasedA1'}]
pause


# attache UE1, testing  eligible with coveBasedA1
ue_register id=1;2
set_pdu_param ue=1 pdu=1 trf_type=internal
# change default
qosflow id=11 default=off
qosflow id=12 default=on
# default is 5QI-6, qosflow=12
ue_pdu_session_setup pdu=1 ue=1 gw=1 nwslice=1;2
ue_measurement_send_nr id=1 meas_id=1 event=A1 srsrp_nr=120

#  scell should be added
trf_data_start ue=1 pdu=1 qfi=1 dir=dl mbps=30 trf_id=1;1
trf_data_start ue=1 pdu=1 qfi=1 dir=ul mbps=10 trf_id=1;5
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
ue_stats_nr id=1 scell=1;o
pause
# change caggrlevel for 5QI-8 (NRDRB-13)
% [{'MOC': 'NRDRB', 'ID': '13', 'cellAggrLevel': '0'}]
pause
# modify 5QI-6 to 5QI-8 -
# paste command here
pause
# verify that scell was not released
ue_stats_nr id=1 scell=1;o
#ue_measurement_send_nr id=1 meas_id=1 event=A1 srsrp_nr=120
pause
ue_kill id=1;5



ue_kill id=1;5
exit















