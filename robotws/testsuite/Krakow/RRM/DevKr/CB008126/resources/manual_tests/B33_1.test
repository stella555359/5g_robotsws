# https://logs.ute.nsn-rdnet.net/cloud/execution/69f9da87-8906-4ee6-8f8a-2a71e069241d/execution_for_preparation_886897de-0e28-46e5-9403-0cd8800b2071/test_results/
# ; value after semicolon means sleep after acton command
# ; parameter 'o' after semicolon means, that output of the command is required
# CB008126-A-B33 Admission control fail during nonGBR modification without PDU session release

# Test should verify that after the qosflow modification is rejected on DU (admission control reason)
# the flow that was subject of modification is released on gNB side and AMF is informed about this by
# PDUSessionNotification message

# use lua SA_TDD_2c_1gNBSim.lua
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/GBR_5QI_1_2_3_4_71_72_76_128_170_212_254.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/vonr_gbr_activation.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/disable_ciphering.yaml
$ testsuite/Krakow/RRM/DevKr/CB008126/config/yaml_config/CB008126_enable.yaml
pause

# attach UE1
qosflow_modify qos_flow=15 ue=all default=true
ue_change_location id=1 enb=2 cell=1
ue_register id=1;2
set_pdu_param ue=1 pdu=1 trf_type=internal
# established qfi 1 5QI-9, cmmid=15
ue_pdu_session_setup pdu=1 ue=1 gw=1 nwslice=1;2
+clear;
pause
# establish qfi 2 5QI-7 cmmid=13
ue_pdu_session_modify pdu=1 qosflows_to_add=13
+parse
pause
trf_data_start ue=1 pdu=1 qfi=1 dir=dl mbps=30 trf_id=1;1
trf_data_start ue=1 pdu=1 qfi=1 dir=ul mbps=10 trf_id=1;1
trf_data_start ue=1 pdu=1 qfi=2 dir=dl mbps=30 trf_id=1;1
trf_data_start ue=1 pdu=1 qfi=2 dir=ul mbps=10 trf_id=1;5
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
pause
bearer_stats ue=1 pdu=1 qfi=2 dir=dl;1;o
pause;
# prepare modification of 5QI-7 (cmid=13) -> 5QI-6
qosflow_modify qos_flow=13 5qi=6 qosflow_type=non-gbr
# apply r&d param
!ute_python du_admission_control.py 1
pause
# send modification message
+clear
ue_pdu_session_modify pdu=1 qosflows_to_modify=13
+parse



exit


# ue_pdu_session_modify ue=1 pdu=1 switch_ul_tunnel_endpoint=ip_teid pdu=2 switch_ul_tunnel_endpoint=ip_teid;2
# pause
# ue_pdu_session_modify ue=2 pdu=1 switch_ul_tunnel_endpoint=teid_only pdu=2 switch_ul_tunnel_endpoint=teid_only;2
# pause
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;1;o
bearer_stats ue=1 pdu=2 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=2 qfi=1 dir=dl;1;o
pause
bearer_stats ue=2 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=2 pdu=1 qfi=1 dir=ul;1;o
bearer_stats ue=2 pdu=2 qfi=1 dir=dl;1;o
bearer_stats ue=2 pdu=2 qfi=1 dir=dl;1;o

ue_kill id=1-2;5
gnb_param id=1 sa_ho=xn_based
% [{'MOC': 'NRREL', 'ID': '1-1', 'handoverAllowedSA': 'allowed'}]
exit















