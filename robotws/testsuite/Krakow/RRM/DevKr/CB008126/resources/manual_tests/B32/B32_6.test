# ; value after semicolon means sleep after acton command
# ; parameter 'o' after semicolon means, that output of the command is required

# CB008126-A-B32-6 Rejected 5QI and TNL and ARP modification due to act5qiAndUlNguTnlQosFlowModification for single flow
# USCB008126-SR-A#B7 Feature flag (NRBTS.act5qiAndUlNguTnlQosFlowMod) off reject QoS modification request
# USCB008126-SR-A#EC5: Successfully handling PDU Session resource modify request (release/establishment/modification),
# but fail to perform 5QI Modification for an existing non-GBR QoS Flow
# Test verifies that:
# - it is possible, for existing qosflow, to reject 5QI modification (due to disabled act5qiAndUlNguTnlQosFlowModification) with simultaneous
#   modification of GFBR of another qosflow within the same NGAP:PDUSessionResourceModify procedure
# Test steps:
# 1. Setup single PDU session with non-GBR (default) with 5QI-9 and second qosflow (GBR) with 5QI-3
# 2. Disable act5qiAndUlNguTnlQosFlowModification
# 3. Try to modify 5QI9 to 5QI8 and in the same message try to update UL-TNL for current PDU session and also change ARP value for default qosflow.
#    Modification should fail with cause CauseRadioNetwork:unspecified
# 4. Make outgoing HO to verify that both none of the modifications were applied.

# use lua SA_TDD_2c_1gNBSim.lua
# configure HO on gnb first
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/GBR_5QI_1_2_3_4_71_72_76_128_170_212_254.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/vonr_gbr_activation.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/gNBSim.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/disable_ciphering.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/inter_gnb_ho.yaml
$ testsuite/Krakow/RRM/DevKr/CB008126/config/yaml_config/CB008126_enable.yaml
$ testsuite/Krakow/RRM/DevKr/CB008126/config/yaml_config/NRPMQAP_counter_profiles.yaml

# Set UE history information for HO
ue_history_information_list_add_ngran id=1 gnb_id=3 cell_type=medium nrcgi=311:489|0x01 time_ue_stayed_in_cell=100
ue_history_information_list_add_ngran id=1 gnb_id=2 cell_type=medium nrcgi=311:489|0x01 time_ue_stayed_in_cell=100
ue_history_information_list id=1 action=commit
ue_enb_param id=1 ue_history_list=1

# Attach UE1 - setup single PDU session with nongbr (default) with 5QI-9 during ICS
ue_register id=1;2
set_pdu_param ue=1 pdu=1 trf_type=internal
ue_pdu_session_setup pdu=1 ue=1 gw=1 nwslice=1;2

trf_data_start ue=1 pdu=1 qfi=1 dir=dl mbps=30 trf_id=1;1
trf_data_start ue=1 pdu=1 qfi=1 dir=ul mbps=10 trf_id=1;1
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;1;o
pause

% [{'MOC': 'NRBTS', 'act5qiAndUlNguTnlQosFlowMod': 'false'}]
# Disable act5qiAndUlNguTnlQosFlowModification flag
pause

# Try to modify 5QI9 to 5QI8 and in the same message try to update UL-TNL for current PDU session and also change ARP value for default qosflow.
# Modification should fail with cause CauseRadioNetwork:unspecified
# To wait for AP implementation
# qos_flow-15 (5QI-9) -> (5QI-8)
# qosflow_modify qos_flow=14 5qi=255;1
# qosflow_modify qos_flow=15 5qi=8;1
# qosflow_modify qos_flow=14 5qi=9;1
# Change ARP value for default qosflow
qosflow_modify qos_flow=15 priority=7
ue_pdu_session_modify ue=1 pdu=1 qosflows_to_modify=15 by=amf;2

# To wait for AP implementation
# ue_pdu_session_modify ue=1 pdu=1 qosflows_to_modify=15 switch_ul_tunnel_endpoint=ip_teid by=amf;2
# Verify that NGAP:PDUSessionResourceModifyRequest contains request for one PDU session to modify the 5QI value of the existing non-GBR QoS Flow
# from 5QI-9 to 5QI-8.
# Verify that NGAP:PDUSessionResourceModifyResponse contains PDU Session Resource Fail To Modify Response List filled with PDU Session IDs
# corresponding to the QoS Flows that were not modified, and with Cause = CauseRadioNetwork: unspecified

bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;1;o
# Verify that traffic remains unchanged: 30MB for DL, 10MB for UL
pause

# Perform outgoing inter-gNB XN-based HO towards cell-1 (pci-52) on sim-gNB
meas_cfg_ue_disp id=1;1;o
ue_measurement_send_nr id=1 meas_id=2 event=A5 srsrp_nr=19 srsrq_nr=10 phycell_id=52 nrsrp_nr=85 nrsrq_nr=31;2
pause
# Perform incoming inter-gNB XN-based HO from sim-gNB towards cell-1 (pci-50) on real-gNB
meas_cfg_ue_disp id=1;1;o
ue_measurement_send_nr id=1 meas_id=5 event=A5 srsrp_nr=18 phycell_id=50 nrsrp_nr=85;2
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;1;o
# Verify that traffic remains unchanged: 30MB for DL, 10MB for UL
# Verify in HO's messages that none of the modifications (both UL-TNL and ARP) were applied
pause

# Teardown: Restore act5qiAndUlNguTnlQosFlowMod flag
% [{'MOC': 'NRBTS', 'act5qiAndUlNguTnlQosFlowMod': 'true'}]
# Enable act5qiAndUlNguTnlQosFlowModification flag
pause
# Restore initial 5QI values
# qos_flow-15 (5QI-8) -> (5QI-9)
# qosflow_modify qos_flow=14 5qi=255;1
# qosflow_modify qos_flow=15 5qi=9;1
# qosflow_modify qos_flow=14 5qi=8;1
ue_kill id=1;2
exit















