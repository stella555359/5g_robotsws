# ; first value after semicolon means sleep after action command
# ; parameter 'o' after semicolon means, that output of the command is required

# CB008126-A-B34 Successful 5QI modification of default QoS flow to different RLC mode
# Test verifies that:
# Modification of QoSFlow 5QI requested in NGAP:PDUSessionResourceModifyRequest is successful,
# when new 5QI has different RLC mode (RLC_UM -> RLC_AM)
# use lua SA_TDD_2c_1gNBSim.lua

$ testsuite/Krakow/RRM/DevKr/CB008126/config/yaml_config/5QI_1_2_3_4_71_72_76_128_170_212_254.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/vonr_gbr_activation.yaml
$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/disable_ciphering.yaml
$ testsuite/Krakow/RRM/DevKr/CB008126/config/yaml_config/CB008126_enable.yaml
pause
# set 5QI9 to RLC_UM
# 5QI7 is already set to RLC_AM (NRDRB-12)
% [{'MOC': 'NRDRB', 'ID': '14', 'nrDrbRlcUmDN': 'MRBTS-1/NRBTS-1/NRDRB_RLC_UM-1', 'rlcMode': 'RLC_UM'}]
pause
!python /home/ute/MN/UTE/robotws/testsuite/Krakow/RRM/resources/Python/pdu_session_qosflow_modification.py save
pause

# attach UE1 with 5QI9
qosflow_modify qos_flow=15 ue=all default=true;1
ue_change_location id=1 enb=2 cell=1;1
ue_register id=1;2
set_pdu_param ue=1 pdu=1 trf_type=internal;1
ue_pdu_session_setup pdu=1 ue=1 gw=1 nwslice=1;2
# Verify in RRCConnectionReconfiguration that RLC-UM config is setup for DRB
trf_data_start ue=1 pdu=1 qfi=1 dir=dl mbps=30 trf_id=1
trf_data_start ue=1 pdu=1 qfi=1 dir=ul mbps=10 trf_id=1;10
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;o
pause

#Modify 5QI9->5QI7
!python /home/ute/MN/UTE/robotws/testsuite/Krakow/RRM/resources/Python/pdu_session_qosflow_modification.py m "15(5QI9->5QI7)"
ue_pdu_session_modify ue=1 pdu=1 qosflows_to_modify=15 by=amf;1
# Verify in RRCConnectionReconfiguration that RLC-AM config is setup for DRB
# Verify, that gNB sent PDUSessionResourceModifyResponse with PDUSessionResourceModifyListModRes to AMF
pause
# Verify there is no traffic drop
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;o
pause

#cleanup after test
!python /home/ute/MN/UTE/robotws/testsuite/Krakow/RRM/resources/Python/pdu_session_qosflow_modification.py restore
pause
% [{'MOC': 'NRDRB', 'ID': '14', 'rlcMode': 'RLC_AM'}]
pause
ue_kill id=1;5
exit
