# ; first value after semicolon means sleep after action command
# ; parameter 'o' after semicolon means, that output of the command is required

# CB008126-A-B22 Failed TNL modification due to dL-NGU-UP-TNLInformation not matching
# Test verifies that:
# it is not possible to modify dL-NGU-UP-TNL address for PDU session in NGAP:PDUSessionResourceModifyRequest

# use lua SA_TDD_2c_1gNBSim.lua

#$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/GBR_5QI_1_2_3_4_71_72_76_128_170_212_254.yaml
#$ testsuite/Krakow/RRM/DevKr/resources/yaml_config/vonr_gbr_activation.yaml
#$ testsuite/Krakow/RRM/DevKr/CB008126/config/yaml_config/CB008126_enable.yaml

# attach UE1 with PDU=1
ue_change_location id=1 enb=2 cell=1
ue_register id=1;2
set_pdu_param ue=1 pdu=1 trf_type=internal
ue_pdu_session_setup pdu=1 ue=1 gw=1 nwslice=1;2
trf_data_start ue=1 pdu=1 qfi=1 dir=dl mbps=30 trf_id=1
trf_data_start ue=1 pdu=1 qfi=1 dir=ul mbps=10 trf_id=1;10

# Try to modify uL-NGU-UP-TNL with changed dL-NGU-UP-TNL
ue_pdu_session_modify ue=1 pdu=1 switch_ul_tunnel_endpoint=ip_teid dl_tunnel_endpoint=2.3.4.5
# Verify NGAP:PDUSessionResourceModifyResponse with PDUSessionResourceFailedToModifyListModRes
pause

bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;1;o
pause

ue_pdu_session_modify ue=1 pdu=1 switch_ul_tunnel_endpoint=ip_teid
# Verify NGAP:PDUSessionResourceModifyResponse with PDUSessionResourceModifyListModRes
pause

# add PDU=2 to UE1
set_pdu_param ue=1 pdu=2 trf_type=internal
ue_pdu_session_setup pdu=2 ue=1 gw=2 nwslice=1;2
trf_data_start ue=1 pdu=2 qfi=1 dir=dl mbps=30 trf_id=1
trf_data_start ue=1 pdu=2 qfi=1 dir=ul mbps=10 trf_id=1

# Create hex message to send UL TNL modification from AMF for PDU=1 with dL-NGU-UP-TNLInformation matching dl identifier of PDU=2
# use below hex as example, adapt fields: AMF_UE_NGAP_ID, RAN_UE_NGAP_ID, UL-NGU-UP-TNLModifyList
# hex_message=XXXX
# use command: send_hex source=amf:1 target=gnb:2 hex=<hex_message>
# Verify NGAP:PDUSessionResourceModifyResponse with PDUSessionResourceFailedToModifyListModRes
pause

bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;1;o
bearer_stats ue=1 pdu=2 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=2 qfi=1 dir=ul;1;o
pause

# Create hex message to end UL TNL modification from AMF for PDU=2 with dL-NGU-UP-TNL Information matching DL identifier of PDU=2
# and UL endpoint modified to the same as for PDU=1
#TO CHECK - modification should be rejected
# use below hex as example, adapt fields: AMF_UE_NGAP_ID, RAN_UE_NGAP_ID, UL-NGU-UP-TNLModifyList
# hex_message=XXXX
# use command: send_hex source=amf:1 target=gnb:2 hex=<hex_message>
# Verify NGAP:PDUSessionResourceModifyResponse with PDUSessionResourceFailedToModifyListModRes
pause

bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;1;o
bearer_stats ue=1 pdu=2 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=2 qfi=1 dir=ul;1;o
pause

ue_pdu_session_modify ue=1 pdu=2 switch_ul_tunnel_endpoint=ip_teid
# Verify NGAP:PDUSessionResourceModifyResponse with PDUSessionResourceModifyListModRes
pause

bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;1;o
bearer_stats ue=1 pdu=2 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=2 qfi=1 dir=ul;1;o
pause

ue_kill id=1;5
exit















