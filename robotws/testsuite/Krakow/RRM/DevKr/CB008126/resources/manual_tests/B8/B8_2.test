# ; value after semicolon means sleep after acton command
# ; parameter 'o' after semicolon means, that output of the command is required

# CB008126-SR-A-B8 QoS Flow Modification - Interaction with CB008717
# 5QI modification for NRDC
# USCB008126-SR-A#B5 Alternate scenario:
# NR-DC is enabled and established with FR2 PSCell as per US CB008717-I#B1, 5QI modidifcation shall [CB008126-A-UPD001] trigger NR-DC bearer takeback
# procedure in PDU Session Modify handling and after modify successfully performed, A4 measure measurement report trigger PSCell addition procedure
# according to CB008717-I#B1, Modified 5QI value shall [End CB008126-A-UPD001] apply to both MN and SN.
# Test verifies that:
# - when NR-DC split bearer is setup and 5QI modification is performed, then the gNB should trigger takeback procedure and after that A4 measurements
#   should be installed and after another PSCell addition, new 5QI value should be used for MN and SN.
# Test steps:
# 1. Setup single PDU session with 2 non-GBR (default with 5QI-170) and 5QI-9 and setup NR-DC.
# 2. Setup NRDC split bearer (mrdc-SecondaryCellGroupConfig setup in NR-RRC message)
# 3. Modify current non-GBR qosflow 5QI-9 to 5QI-6
# 4. It should trigger takeback procedure (mrdc-SecondaryCellGroupConfig release should be visible in NR-RRC message in which 5QI modification
#    is done). After the modification, A4 measurements should be installed.
# 5. Send A4 measurement to setup NR-DC. New 5QI value should be used and traffic should behave as before modification (on both MN and SN side)

# configure CB008717 (NR-DC) first on TL: CLOUD_5G_I_BOO_AP_LOO, VARIANT_SANSA_FS_ECPRI_CMWV_FDD+TDD by running robot file:
#   robotws/testsuite/Krakow/RRM/DevKr/CB008126/CB008126_interaction_with_CB8717_setup.robot containing:
#     lua: robotws/testsuite/Krakow/RRM/DevKr/CB008717/config/M/6c_FDD_n66_n5_FR2_n260_n261_NRDC.lua
#     scfc: robotws/custom-config/Krakow/CB008717/DE/SCFC_FS_6C_n5_n66_n260_n261.xml
#     iphy: robotws/custom-config/Krakow/CB008717/DE/iphy_FS_6c_n5_n66_n260_n261.xml
#
$ testsuite/Krakow/RRM/DevKr/CB008126/config/yaml_config/CB008126_enable.yaml

% [{'MOC': 'NRCELL', 'a4Fr2SupervisionTimer': '10000'}]

# Attach FWA UE1 to NRCELL-1 - setup single PDU session with nongbr (default) with 5QI-170 and second qosflow (non-GBR) with 5QI-9 during ICS
ue_change_location id=1 enb=2 cell=1
amf_ue_ics_param id=1 ue=1 indexToRFSP=87;1
ue_register id=1;2
set_pdu_param ue=1 pdu=1 trf_type=internal
smf_param id=1 additional_qosflows_to_activate=3;1
ue_pdu_session_setup pdu=1 ue=1 gw=1 nwslice=1;2
smf_param id=1 reset;1

trf_data_start ue=1 pdu=1 qfi=1 dir=dl mbps=30 trf_id=1;1
trf_data_start ue=1 pdu=1 qfi=1 dir=ul mbps=10 trf_id=1;1
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;1;o

# Send A4 measurement for UE1 for NR-DC PSCell addition with NRCELL-3 (PCI-52)
ue_measurement_send_nr id=1 meas_id=1 event=A4 srsrp_nr=19 srsrq_nr=10 phycell_id=52 nrsrp_nr=85 nrsrq_nr=31 index=0 nrs_result=30:30:0;2
# Verify that for UE1 NR-DC was successfully configured with NRCELL-3
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;1;o

# To wait for AP implementation
# qos_flow-3 (5QI-9) -> (5QI-6)
# qosflow_modify qos_flow=3 5qi=6;1

ue_pdu_session_modify ue=1 pdu=1 qosflows_to_modify=3 by=amf;10
# Need to sleep longer time, because A4 measurements will be installed after a4RetryTimer

# Send A4 measurement for UE1 for NR-DC PSCell addition with NRCELL-3 (PCI-52)
ue_measurement_send_nr id=1 meas_id=3 event=A4 srsrp_nr=19 srsrq_nr=10 phycell_id=52 nrsrp_nr=85 nrsrq_nr=31 index=0 nrs_result=30:30:0;2
# Check that 5QI value modification triggered NR-DC bearer takeback procedure in PDUSessionModify, and after modify successfully performed,
# A4 measurement report triggered another PSCell addition and modified 5QI value has been applied to MN and SN
bearer_stats ue=1 pdu=1 qfi=1 dir=dl;1;o
bearer_stats ue=1 pdu=1 qfi=1 dir=ul;1;o
# Verify that traffic remains unchanged: 30MB for DL, 10MB for UL
pause

# Teardown - restore initial 5QI values
# qos_flow-3 (5QI-6) -> (5QI-9)
# qosflow_modify qos_flow=3 5qi=9;1
ue_kill id=1;2
exit















