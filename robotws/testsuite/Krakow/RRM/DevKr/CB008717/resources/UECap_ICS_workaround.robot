*** Keywords ***
Exclude UECaps from ICS for UE${ue_id:\d+}
    Execute egate command
    ...    cmd=amf_ue_ics_param ue=${ue_id} id=1 include_ue_capabilities=no

Exclude UECaps from ICS for UE${ue_id:\d+} and include indexToRFSP eq ${index:\d+}
    Execute egate command
    ...    cmd=amf_ue_ics_param ue=${ue_id} id=1 include_ue_capabilities=no indexToRFSP=${index}

Set insufficient UECaps with wrong appliedFreqBandListFilter for UE${ue_id:\d+}
    Execute egate command
    ...    cmd=amf_ue_ics_param ue=${ue_id} id=1 include_ue_capabilities=yes ue_capabilities=${insufficient_n78_n257_n260_wrong_band}

     Run Keyword If    ${ue_id} == 4
     ...   Execute egate command
     ...   cmd=amf_ue_ics_param ue=${ue_id} id=1 include_ue_capabilities=yes ue_capabilities=${insufficient_n78_n257_wrong_bands}

Set insufficient UECaps during XN Handover procedure for UE${ue_id:\d+}
    Execute egate command
    ...    cmd=ue_gnb_param id=${ue_id} ue_nr_capabilities=${insufficient_n66_n5_n260_wrong_band_comb}

Set ${caps} UECaps for UE${ue_id:\d+}
    Execute egate command
    ...    cmd=amf_ue_ics_param ue=${ue_id} id=1 include_ue_capabilities=yes ue_capabilities=${caps}
