<?xml version="1.1"?>
<!DOCTYPE format PUBLIC "-//prisma//DTD Format 2.0//EN" "http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/dtd/xmlFormat-2.dtd">
<?xml-stylesheet type="text/xsl" href="http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/xsl/htmlFormat.xsl"?>

<format name="NrPusch" show="NR PUSCH Test" version="1.0">
    <group name="NrPusch" show="NR PUSCH Info" priority="250">
        <integer name="Version" show="Version" writable="false" default="8" cformat="uint32"> </integer>
        <integer name="TestType" show="Test Type" writable="false" default="257" cformat="uint32"> </integer>
        <integer name="cellId" show="Physical cell id" writable="true" default="0" min="0" max="1007" step="0" cformat="uint32"> </integer>
        <integer name="rnti" show="RNTI" writable="true" default="200" min="1" max="65535" step="0" cformat="uint32"> </integer>
    </group>
    <group name="AllocInfo" show="Allocation Info" priority="250">
        <integer name="nDmrsAddPos" show="UL-DMRS-add-pos" writable="true" default="0" min="0" max="3" step="0" cformat="uint32"> </integer>
        <integer name="startRB" show="Starting resource block" writable="true" default="0" min="0" max="272" step="0" cformat="uint32"> </integer>
        <integer name="nRB" show="Number of allocated resource blocks" writable="true" default="1" min="1" max="273" step="0" cformat="uint32"> </integer>
        <enum name="MCSTable" show="MCS table to use" default="0" cformat="uint32">
            <option value="0">0 (64 QAM)</option>
            <option value="1">1 (256 QAM)</option>
        </enum>
        <integer name="mcs" show="Modulation and coding scheme" writable="true" default="0" min="0" max="28" step="0" cformat="uint32"> </integer>
        <integer name="nLayers" show="Number of layers" writable="true" default="1" min="1" max="2" step="0" cformat="uint32"> </integer>
        <bitfield name="antPorts" show="Antenna ports" format="%08x" bits="4" default="00000001" writable="true" exportable="false" null="false" index="false" cformat="uint32">
            Configured antenna ports
            <bit index="3" show="p=3"/>
            <bit index="2" show="p=2"/>
            <bit index="1" show="p=1"/>
            <bit index="0" show="p=0"/>
        </bitfield>
        <integer name="pmi" show="PMI" writable="true" default="0" min="0" max="1" step="0" cformat="uint32"> </integer>
        <enum name="rv" show="redundancy version" cformat="uint32">
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
        </enum>
        <enum name="ptrsOn" show="PTRS" cformat="uint32">
            <option value="0">Off</option>
            <option value="1">On</option>
        </enum>
    </group>
    <group name="FrameStructure" show="Frame Structure" priority="250">
        <integer name="startSym_0" show="First symbol index (slot type 0)" writable="true" default="2" min="0" max="13" step="0" cformat="uint32"> </integer>
        <integer name="numSym_0" show="Number of symbols (slot type 0)" writable="true" default="10" min="1" max="14" step="0" cformat="uint32"> </integer>
        <integer name="dmrsSym_0" show="First DMRS symbol (slot type 0)" writable="true" default="2" min="0" max="13" step="0" cformat="uint32"> </integer>
        <bitfield name="slotsMap1_0" show="Tx slots (type 0) (0..63)" format="%016x" bits="64" default="0000000000000001" writable="true" exportable="false" null="false" index="false" cformat="uint64">
            Slots for transmitting PUSCH (slot type 0)
            <bit index="63" show="slot 63"/>
            <bit index="62" show="slot 62"/>
            <bit index="61" show="slot 61"/>
            <bit index="60" show="slot 60"/>
            <bit index="59" show="slot 59"/>
            <bit index="58" show="slot 58"/>
            <bit index="57" show="slot 57"/>
            <bit index="56" show="slot 56"/>
            <bit index="55" show="slot 55"/>
            <bit index="54" show="slot 54"/>
            <bit index="53" show="slot 53"/>
            <bit index="52" show="slot 52"/>
            <bit index="51" show="slot 51"/>
            <bit index="50" show="slot 50"/>
            <bit index="49" show="slot 49"/>
            <bit index="48" show="slot 48"/>
            <bit index="47" show="slot 47"/>
            <bit index="46" show="slot 46"/>
            <bit index="45" show="slot 45"/>
            <bit index="44" show="slot 44"/>
            <bit index="43" show="slot 43"/>
            <bit index="42" show="slot 42"/>
            <bit index="41" show="slot 41"/>
            <bit index="40" show="slot 40"/>
            <bit index="39" show="slot 39"/>
            <bit index="38" show="slot 38"/>
            <bit index="37" show="slot 37"/>
            <bit index="36" show="slot 36"/>
            <bit index="35" show="slot 35"/>
            <bit index="34" show="slot 34"/>
            <bit index="33" show="slot 33"/>
            <bit index="32" show="slot 32"/>
            <bit index="31" show="slot 31"/>
            <bit index="30" show="slot 30"/>
            <bit index="29" show="slot 29"/>
            <bit index="28" show="slot 28"/>
            <bit index="27" show="slot 27"/>
            <bit index="26" show="slot 26"/>
            <bit index="25" show="slot 25"/>
            <bit index="24" show="slot 24"/>
            <bit index="23" show="slot 23"/>
            <bit index="22" show="slot 22"/>
            <bit index="21" show="slot 21"/>
            <bit index="20" show="slot 20"/>
            <bit index="19" show="slot 19"/>
            <bit index="18" show="slot 18"/>
            <bit index="17" show="slot 17"/>
            <bit index="16" show="slot 16"/>
            <bit index="15" show="slot 15"/>
            <bit index="14" show="slot 14"/>
            <bit index="13" show="slot 13"/>
            <bit index="12" show="slot 12"/>
            <bit index="11" show="slot 11"/>
            <bit index="10" show="slot 10"/>
            <bit index="9" show="slot 9"/>
            <bit index="8" show="slot 8"/>
            <bit index="7" show="slot 7"/>
            <bit index="6" show="slot 6"/>
            <bit index="5" show="slot 5"/>
            <bit index="4" show="slot 4"/>
            <bit index="3" show="slot 3"/>
            <bit index="2" show="slot 2"/>
            <bit index="1" show="slot 1"/>
            <bit index="0" show="slot 0"/>
        </bitfield>
        <bitfield name="slotsMap2_0" show="Tx slots (type 0) (64..79)" format="%016x" bits="16" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
            Slots for transmitting PUSCH (slot type 0)
            <bit index="15" show="slot 79"/>
            <bit index="14" show="slot 78"/>
            <bit index="13" show="slot 77"/>
            <bit index="12" show="slot 76"/>
            <bit index="11" show="slot 75"/>
            <bit index="10" show="slot 74"/>
            <bit index="9" show="slot 73"/>
            <bit index="8" show="slot 72"/>
            <bit index="7" show="slot 71"/>
            <bit index="6" show="slot 70"/>
            <bit index="5" show="slot 69"/>
            <bit index="4" show="slot 68"/>
            <bit index="3" show="slot 67"/>
            <bit index="2" show="slot 66"/>
            <bit index="1" show="slot 65"/>
            <bit index="0" show="slot 64"/>
        </bitfield>
        <integer name="startSym_1" show="First symbol index (slot type 1)" writable="true" default="2" min="0" max="13" step="0" cformat="uint32"> </integer>
        <integer name="numSym_1" show="Number of symbols (slot type 1)" writable="true" default="10" min="1" max="14" step="0" cformat="uint32"> </integer>
        <integer name="dmrsSym_1" show="First DMRS symbol (slot type 1)" writable="true" default="2" min="0" max="13" step="0" cformat="uint32"> </integer>
        <bitfield name="slotsMap1_1" show="Tx slots (type 1) (0..63)" format="%016x" bits="64" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
            Slots for transmitting PUSCH (slot type 1)
            <bit index="63" show="slot 63"/>
            <bit index="62" show="slot 62"/>
            <bit index="61" show="slot 61"/>
            <bit index="60" show="slot 60"/>
            <bit index="59" show="slot 59"/>
            <bit index="58" show="slot 58"/>
            <bit index="57" show="slot 57"/>
            <bit index="56" show="slot 56"/>
            <bit index="55" show="slot 55"/>
            <bit index="54" show="slot 54"/>
            <bit index="53" show="slot 53"/>
            <bit index="52" show="slot 52"/>
            <bit index="51" show="slot 51"/>
            <bit index="50" show="slot 50"/>
            <bit index="49" show="slot 49"/>
            <bit index="48" show="slot 48"/>
            <bit index="47" show="slot 47"/>
            <bit index="46" show="slot 46"/>
            <bit index="45" show="slot 45"/>
            <bit index="44" show="slot 44"/>
            <bit index="43" show="slot 43"/>
            <bit index="42" show="slot 42"/>
            <bit index="41" show="slot 41"/>
            <bit index="40" show="slot 40"/>
            <bit index="39" show="slot 39"/>
            <bit index="38" show="slot 38"/>
            <bit index="37" show="slot 37"/>
            <bit index="36" show="slot 36"/>
            <bit index="35" show="slot 35"/>
            <bit index="34" show="slot 34"/>
            <bit index="33" show="slot 33"/>
            <bit index="32" show="slot 32"/>
            <bit index="31" show="slot 31"/>
            <bit index="30" show="slot 30"/>
            <bit index="29" show="slot 29"/>
            <bit index="28" show="slot 28"/>
            <bit index="27" show="slot 27"/>
            <bit index="26" show="slot 26"/>
            <bit index="25" show="slot 25"/>
            <bit index="24" show="slot 24"/>
            <bit index="23" show="slot 23"/>
            <bit index="22" show="slot 22"/>
            <bit index="21" show="slot 21"/>
            <bit index="20" show="slot 20"/>
            <bit index="19" show="slot 19"/>
            <bit index="18" show="slot 18"/>
            <bit index="17" show="slot 17"/>
            <bit index="16" show="slot 16"/>
            <bit index="15" show="slot 15"/>
            <bit index="14" show="slot 14"/>
            <bit index="13" show="slot 13"/>
            <bit index="12" show="slot 12"/>
            <bit index="11" show="slot 11"/>
            <bit index="10" show="slot 10"/>
            <bit index="9" show="slot 9"/>
            <bit index="8" show="slot 8"/>
            <bit index="7" show="slot 7"/>
            <bit index="6" show="slot 6"/>
            <bit index="5" show="slot 5"/>
            <bit index="4" show="slot 4"/>
            <bit index="3" show="slot 3"/>
            <bit index="2" show="slot 2"/>
            <bit index="1" show="slot 1"/>
            <bit index="0" show="slot 0"/>
        </bitfield>
        <bitfield name="slotsMap2_1" show="Tx slots (type 1) (64..79)" format="%016x" bits="16" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
            Slots for transmitting PUSCH (slot type 1)
            <bit index="15" show="slot 79"/>
            <bit index="14" show="slot 78"/>
            <bit index="13" show="slot 77"/>
            <bit index="12" show="slot 76"/>
            <bit index="11" show="slot 75"/>
            <bit index="10" show="slot 74"/>
            <bit index="9" show="slot 73"/>
            <bit index="8" show="slot 72"/>
            <bit index="7" show="slot 71"/>
            <bit index="6" show="slot 70"/>
            <bit index="5" show="slot 69"/>
            <bit index="4" show="slot 68"/>
            <bit index="3" show="slot 67"/>
            <bit index="2" show="slot 66"/>
            <bit index="1" show="slot 65"/>
            <bit index="0" show="slot 64"/>
        </bitfield>
    </group>
    <group name="OtherInfo" show="Other" priority="250">
        <integer name="Ta" show="time advance" writable="true" default="0" min="0" max="120" step="0" cformat="uint32"> 
        Time advance value in Ts
        </integer>
        <integer name="Attenuation" show="attenuation" writable="true" default="0" min="0" max="40" step="0" cformat="uint32"> 
        Attenuation value in dB (0 dB .. 40 dB)
        </integer>
        <integer name="DciAdvance" show="DCI-PUSCH timing offset" writable="true" default="4" min="0" max="16" step="0" cformat="uint32"> 
        DCI-PUSCH timing offset in number of slots
        </integer>
        <enum name="realDci" show="Use real DCIs" cformat="uint32">
            <option value="0">Off</option>
            <option value="1">On</option>
        </enum>
    </group>
    <group name="uciRep" show="UCI reporting" priority="250">
        <enum name="uciRepCfg" show="UCI reporting on PUSCH" cformat="uint32">
            <option value="0">Off</option>
            <option value="1">On</option>
        </enum>
        <bitfield name="ackNackBitmap" show="Ack/Nack bitmap" format="%016x" bits="16" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
            Ack/Nack bit values
            <bit index="10" show="bit 10"/>
            <bit index="9" show="bit 9"/>
            <bit index="8" show="bit 8"/>
            <bit index="7" show="bit 7"/>
            <bit index="6" show="bit 6"/>
            <bit index="5" show="bit 5"/>
            <bit index="4" show="bit 4"/>
            <bit index="3" show="bit 3"/>
            <bit index="2" show="bit 2"/>
            <bit index="1" show="bit 1"/>
            <bit index="0" show="bit 0"/>
        </bitfield>
        <integer name="ackNackLen" show="Number of ack/nack bits to report" writable="true" default="0" min="0" max="11" step="0" cformat="uint32"> </integer>
        <integer name="betaHarq" show="Beta offset HARQ-ACK" writable="true" default="0" min="0" max="15" step="0" cformat="uint32"> </integer>
        <enum name="alphaHarq" show="Scaling (alpha)" cformat="uint32">
            <option value="0">0.5</option>
            <option value="1">0.65</option>
            <option value="2">0.8</option>
            <option value="3">1.0</option>
        </enum>
    </group>
</format>
