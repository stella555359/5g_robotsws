{
  "name": "Default TrunkEng Oul1 syslog faults",
  "domain": "Syslog",
  "algorithm": "syslog-filter-analyzer",
  "tags": [
    {
      "name": "4G",
      "type": "RAT"
    }
  ],
  "rule": {
    "result_label": "Faults",
    "filters": [
      {
        "name": "SET1",
        "description": "Fail on any alarm",
        "regex_pattern": "Detector .* active",
        "ignore_regex_pattern": "(4592||61524|61649|61652|4655|4654|4681|6351|4334|4268|6150|7312|7313|7304|10000.*|6316|4247|3)",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      }
    ]
  }
}