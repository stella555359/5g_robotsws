{
    "name": "invalid negative counter values",
    "description": "Fail on negative Counter values unless counter or unit is defined in exclude lists, EDA MNRCA-60316",
    "tags": [],
    "domain": "Counter",
    "algorithm": "negative-kpi-counter-detector",
    "trigger": "test_case_collection_ended",
    "rule": {
      "counter": {
        "exclude_counter": ["M8010C67"],
        "exclude_counter_unit": [
          "dBm",
          "dB",
          "1.0E-1 dBm",
          "1.0E-1 dB",
          "0.001 CQI"
        ]
      }
    }
  }
