# ue_attach_script.exs

# Turn CLI off
#cli_off()

# Trigger RRC Connection ReestablishmentReject and start UL traffic
{:ok, _subscriber} =
  UEx.GenSub.Server.start_link(
    nil,
    {
      UE.whereis(1),
      UE.Pub.RRC,
      {:info, :rrcConnectionReestablishmentReject},
      UEx.GenSub.FlowStep.action(fn _ ->
        UExGate.trf_data_start([
          ue: 1,
          dir: :ul,
          protocol: :udp,
          Mbps: 20.0,
          stats: true
        ])
      end)
    }
  )

# Turn CLI back on
#cli_on()

