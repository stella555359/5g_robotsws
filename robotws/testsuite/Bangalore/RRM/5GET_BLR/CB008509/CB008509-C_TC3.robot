[1]CB008509-C_TC3_Generating_Dummy_Load_on_PDCCH_and_PDSCH_on_SSB_Slots_without_PRB_pooling_FDD_non_BF
    set test variable      ${LOG_PATH}
    ${crnti}     Create list    65535

    ${pdschheader}     Create list    type    3gpp.subcellid    3gpp.sfn    3gpp.slot     3gpp.rnti    DlData_PdschGrant.numOfPrb
    ...    DlData_PdschGrant.rat0Bitmap    DlData_PdschGrant.mcs    DlData_PdschGrant.mcsTable    DlData_PdschGrant.patternId_item

    ${pdcchheader}     Create list    type    3gpp.subcellid    3gpp.sfn    3gpp.slot     3gpp.rnti
    ...    DlData_DciInfo.startSymbolNumber    DlData_DciInfo.numOfSymbols    DlData_DciInfo.startCce
    ...    DlData_DciInfo.aggregationLevel    DlData_DciInfo.coresetFreqDomain    DlData_DciInfo.interleaverRows
    ...    DlData_DciInfo.regBundleSize    DlData_DciInfo.coresetFreqDomainRbShift    DlData_DciInfo.patternId_item

    ${pdccharg}     Create list    3gpp.subcellid    3gpp.sfn    3gpp.slot     3gpp.rnti
    ...    DlData_DciInfo.numOfSymbols    DlData_DciInfo.aggregationLevel

    ${usablepdschonssb}    get_pdsch_on_ssb    ${log_path_1}[btslog]/gnb_syslog.log

#Step-1: Capture TTI-trace and verify that Artificial Load is getting generated by dummy RNTIs with mcs defined by
#        mcsIndexForArtificialLoad parameter and numofPrb=targetTotalLoadSectorBeam(X-PRBs)
    Start Log    btslog    biptaf
    sleep    1s
    ${scen1}     Stop Log     biptaf    btslog    test_scenario=cell_idle
    ${CsvPathpdsch1}     Convert PCAP to CSV    ${scen1}[biptaf]   dldata_pdschsendreq    dldata_pdschsendreq    @{pdschheader}
    ${CsvPathpdcch1}     Convert PCAP to CSV    ${scen1}[biptaf]   dldata_pdcchsendreq    dldata_pdcchsendreq    @{pdcchheader}
    # tti verification code need to be added
    ${res_pdsch}    validation_of_pdsch    ${CsvPathpdsch1}    dldata_pdschsendreq    2    ${pdschheader}[1:]
    ...    ${crnti}    ${79}    ${1}    ${80}    ${28}    ${0}    ${usablepdschonssb}
    ...    maxpdschinslot=${6}    nbrOfBlankedPRBsHighEdgeDL=${0}    nbrOfBlankedPRBsLowEdgeDL=${0}    beam=${1}
    Should contain    ${res_pdsch}    Pass    ignore_case=True
    ${res_pdcch}    validation_of_pdcch    ${CsvPathpdcch1}   dldata_pdcchsendreq    2    ${crnti}    ${79}    ${80}    ${pdccharg}
    Should contain    ${res_pdcch}    Pass    ignore_case=True

#Step-2: attach 3 UEs, UE-1, UE-2 and UE-3
    ${crnti_list_1}=      MultiUE Register should be Successful   51   53    pdu_id=1     nw_id=1
    ${crnti}    Combine Lists    ${crnti_list_1}    ${crnti}
#Step-3: start data transfer from UE-1 and UE-2 so that no of PRBs used by
#  those 2 UEs for PDCSH(e.g. Total Y-PRBS) is less than PRB defined by
#  targetTotalLoadSectorBeam (X-PRBs).No of CCEs allocated is X2 for UE-1 and UE-2

    MultiUE Trigger DL Traffic for SA    51  51    Traffic_rate=mbps     dl_rate=2     pdu_id=1    trf_id=1       qfi_id=1
    MultiUE Trigger UL Traffic for SA    51  51    Traffic_rate=mbps     ul_rate=2     pdu_id=1    trf_id=1       qfi_id=1
    MultiUE Trigger DL Traffic for SA    52  52    Traffic_rate=mbps     dl_rate=2     pdu_id=1    trf_id=1       qfi_id=1
    MultiUE Trigger UL Traffic for SA    52  52    Traffic_rate=mbps     ul_rate=2     pdu_id=1    trf_id=1       qfi_id=1
    sleep    60s
    Validate DL Traffic For MultiUE for SA    51  51     dl_rate=2     pdu_id=1    qfi_id=1
    Validate UL Traffic For MultiUE for SA    51  51     ul_rate=2     pdu_id=1    qfi_id=1
    Validate DL Traffic For MultiUE for SA    52  52     dl_rate=2     pdu_id=1    qfi_id=1
    Validate UL Traffic For MultiUE for SA    52  52     ul_rate=2     pdu_id=1    qfi_id=1

#Step-4: Capture TTI-trace and verify that Artificial Load and UE-1 data are scheduled in same slot and Artificial Load
#        will use remaining (X-Y) PRBs with mcs defined by mcsIndexForArtificialLoad
    Start Log    btslog    biptaf
    sleep    1s
    ${scen2}     Stop Log     biptaf    btslog    test_scenario=with_2_real_ue
    ${CsvPathpdsch2}     Convert PCAP to CSV    ${scen2}[biptaf]   dldata_pdschsendreq    dldata_pdschsendreq    @{pdschheader}
    ${CsvPathpdcch2}     Convert PCAP to CSV    ${scen2}[biptaf]   dldata_pdcchsendreq    dldata_pdcchsendreq    @{pdcchheader}
    # tti verification code need to be added
    ${res_pdsch}    validation_of_pdsch    ${CsvPathpdsch2}    dldata_pdschsendreq    2    ${pdschheader}[1:]
    ...    ${crnti}    ${79}    ${1}    ${80}    ${28}    ${0}    ${usablepdschonssb}
    ...    maxpdschinslot=${6}    nbrOfBlankedPRBsHighEdgeDL=${0}    nbrOfBlankedPRBsLowEdgeDL=${0}    beam=${1}
    Should contain    ${res_pdsch}    Pass    ignore_case=True
    ${res_pdcch}    validation_of_pdcch    ${CsvPathpdcch2}   dldata_pdcchsendreq    2    ${crnti}    ${79}    ${80}    ${pdccharg}
    Should contain    ${res_pdcch}    Pass    ignore_case=True

#Step-5: start data transfer from UE-2 so that no of PRBs used by UE-2 is greater than or equals to PRB defined by
#        targetTotalLoadSectorBeam
    MultiUE Trigger DL Traffic for SA    53  53    Traffic_rate=mbps     dl_rate=50    pdu_id=1    trf_id=1       qfi_id=1
    MultiUE Trigger UL Traffic for SA    53  53    Traffic_rate=mbps     ul_rate=70    pdu_id=1    trf_id=1       qfi_id=1
    sleep    60s
    Validate DL Traffic For MultiUE for SA    53  53     dl_rate=50     pdu_id=1    qfi_id=1
    Validate UL Traffic For MultiUE for SA    53  53     ul_rate=70     pdu_id=1    qfi_id=1
#Step-6: Capture TTI-trace and verify that the slots were UE-1 & UE-2 or UE-2 alone are scheduled on that slots no
#        Artificial Loads are generated.Artificial Loads are only observed when UE-1 and dummy RNTIs are scheduled together.
    Start Log    btslog    biptaf
    sleep    1s
    ${scen3}     Stop Log     biptaf    btslog    test_scenario=with_3_real_ue
    ${CsvPathpdsch3}     Convert PCAP to CSV    ${scen3}[biptaf]   dldata_pdschsendreq    dldata_pdschsendreq    @{pdschheader}
    ${CsvPathpdcch3}     Convert PCAP to CSV    ${scen3}[biptaf]   dldata_pdcchsendreq    dldata_pdcchsendreq    @{pdcchheader}

    # tti verification code need to be added
    ${res_pdsch}    validation_of_pdsch    ${CsvPathpdsch3}    dldata_pdschsendreq    2    ${pdschheader}[1:]
    ...    ${crnti}    ${79}    ${1}    ${80}    ${28}    ${0}    ${usablepdschonssb}
    ...    maxpdschinslot=${6}    nbrOfBlankedPRBsHighEdgeDL=${0}    nbrOfBlankedPRBsLowEdgeDL=${0}    beam=${1}
    Should contain    ${res_pdsch}    Pass    ignore_case=True
    ${res_pdcch}    validation_of_pdcch    ${CsvPathpdcch3}   dldata_pdcchsendreq    2    ${crnti}    ${79}    ${80}    ${pdccharg}
    Should contain    ${res_pdcch}    Pass    ignore_case=True

    #Step-7: Set the value of NRCELL.actConfDlInterferenceGen as 0 (disabled)
    Validate DL Traffic For MultiUE for SA    51  51     dl_rate=2     pdu_id=1    qfi_id=1
    Validate UL Traffic For MultiUE for SA    51  51     ul_rate=2     pdu_id=1    qfi_id=1
    Validate DL Traffic For MultiUE for SA    52  52     dl_rate=2     pdu_id=1    qfi_id=1
    Validate UL Traffic For MultiUE for SA    52  52     ul_rate=2     pdu_id=1    qfi_id=1
    Validate DL Traffic For MultiUE for SA    53  53     dl_rate=50     pdu_id=1    qfi_id=1
    Validate UL Traffic For MultiUE for SA    53  53     ul_rate=70     pdu_id=1    qfi_id=1

#Common Step Stop Data and UE Deregister
    Stop MultiUE Data Traffic for SA     51  53
    MultiUE Deregister should be Successful   51  53







