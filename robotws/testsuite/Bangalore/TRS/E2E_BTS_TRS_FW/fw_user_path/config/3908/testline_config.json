                    "no shutdown",
                    "show config",
                    "exit",
                    "exit"
                  ],
				"shutdown_port": [
					"configure",
					"interface ${bh_interface}",
					"shutdown",
					"exit",
					"exit"
				],
				"shutdown_vlan": [
					"configure",
					"interface ${bh_interface}",
					"switchport allowed vlan remove ${vlan}",
					"no switchport tagging ${vlan}",
					"switchport mode access",
					"switchport access vlan ${vlan}",
					"exit",
					"exit"
				],
				"bringup_894_conf": [
					"configure",
					"interface 0/13",
					"no switchport mode access",
					"no switchport access vlan",
					"switchport allowed vlan add 3611",
					"switchport tagging 3611",
					"exit",
					"exit"
				],
				"bringup_vlan": [
					"configure",
					"interface ${bh_interface}",
					"no switchport mode access",
					"no switchport access vlan",
					"switchport allowed vlan add ${vlan}",
					"switchport tagging ${vlan}",
					"exit",
					"exit"
				],
				"change_native_vlan": [
					"configure",
					"interface vlan ${vlan}",
					"untagged ${bh_interface}"
				],
				"remove_untagged_vlan": [
					"config t",
					"interface vlan ${vlan}",
					"no untagged ${bh_interface}"
				]
			}
		}
