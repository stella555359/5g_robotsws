{
	"traffic_analysis": {
		"verify_dhcp_discover_swn": {
			"filter": "(dhcp.hw.mac_addr == ${RU1_MAC} && dhcp.option.dhcp == 1 && dhcp.client_id.iaid == ${RU1_Client_MAC})",
			"eval": "count",
   			"expected_result": "1",
	        "tolerance": 50	
			
		},
		"verify_dhcp_offer_swn": {
			"filter": "(dhcp.option.dhcp == 2 && ip.dst == ${RU1_dst} && !gre && dhcp.ip.your == ${RU1_src})",
			"eval": "count",
			"expected_result": "1",
			"tolerance": 50

		},
		"verify_dhcp_request_swn": {
			"filter": "(dhcp.option.dhcp == 3 && dhcp.hw.mac_addr == ${RU1_MAC})",
			"eval": "count",
			"expected_result": "4",
			"tolerance": 50
			
		},
		"verify_dhcp_ack_swn": {
			"filter": "(dhcp.option.dhcp == 5 && !gre && ip.dst == ${RU1_dst} && dhcp.ip.your == ${RU1_src} && dhcp.ip.client == ${RU1_src})",
			"eval": "count",
			"expected_result": "4",
			"tolerance": 50
			
		},
        "verify_dhcp_discover_RU2": {
            "filter": "(dhcp.option.dhcp == 1 && dhcp.ip.relay == ${RU2_dhcp_relay}  && dhcp.hw.mac_addr == ${RU2_MAC} && !gre && dhcp.flags.bc == 0)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0

        },
        "verify_dhcp_offer_RU2": {
            "filter": "(dhcp.option.dhcp == 2 && ip.dst == ${RU2_dst} && !gre && dhcp.ip.your == ${RU2_src})",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0

        },
        "verify_dhcp_request_RU2": {
            "filter": "(dhcp.option.dhcp == 3 && dhcp.hw.mac_addr == ${RU2_MAC} && !gre && dhcp.ip.relay == ${RU2_dhcp_relay})",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0

        },
        "verify_dhcp_ack_RU2": {
            "filter": "(dhcp.option.dhcp == 5 && !gre && ip.dst == ${RU2_dst}  && dhcp.ip.your == ${RU2_src})",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0

        },
        "verify_dhcp_offer_pcp": {
            "filter": "(dhcp.option.dhcp == 2 && dhcp.ip.your == ${dhcp_offer} && vlan.priority == 5 && dhcp.flags.bc == 0)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0

        },
        "verify_changed_dhcp_offer_pcp":{
            "filter": "(dhcp.option.dhcp == 2 && dhcp.ip.your == ${dhcp_offer} && vlan.priority == 6 && dhcp.flags.bc == 0)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0
        },
        
        "verify_dhcp_ack_pcp": {
            "filter": "(dhcp.option.dhcp == 5 && dhcp.ip.your == ${dhcp_ack} && vlan.priority == 5)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0
        },

        "verify_changed_dhcp_ack_pcp": {
            "filter": "(dhcp.option.dhcp == 5 && dhcp.ip.your == ${dhcp_ack} && vlan.priority == 6 && dhcp.ip.client == 0.0.0.0)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0
        },

        "verify_icmp_RU2_pcp": {
            "filter": "(icmp && ip.src == ${RU2_pcp_src} && ip.dst == ${RU2_pcp_dst} && vlan.priority == 5 && vlan.priority == 5 && icmp.seq == 1)",
            "eval": "count",
            "expected_result": "2",
            "tolerance": 10

        },

        "verify_icmp_RU2_dscp": {
            "filter": "(icmp && ip.src == ${RU2_pcp_src} && ip.dst == ${RU2_pcp_dst} && vlan.priority == 5 && vlan.priority == 5 && icmp.seq == 1 && ip.dsfield.dscp == 18)",
            "eval": "count",
            "expected_result": "2",
            "tolerance": 10

        }

    }
}




