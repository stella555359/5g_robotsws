#!/usr/bin/expect -f

set hostname [lindex $argv 0]

spawn netopeer2-cli

set timeout 5
expect ">";
send "connect --tls --host $hostname --key /home/ute/netconf/server-key.pem --cert /home/ute/netconf/server-cert.pem --trusted /home/ute/netconf/ca-cert.pem\r";
sleep 5;
expect ">";
send "status\r";
expect ">";
send "exit\r";