#!/usr/bin/expect -f

set hostname [lindex $argv 0]
set getfile [lindex $argv 1]
set getconfigfile [lindex $argv 2]

spawn netopeer2-cli

set timeout 5
expect ">";
send "connect --tls --host $hostname --key /home/ute/netconf/server-key.pem --cert /home/ute/netconf/server-cert.pem --trusted /home/ute/netconf/ca-cert.pem\r";
sleep 10;
expect ">";
send "status\r";
expect ">";
sleep 5;
send "get --out $getfile\r";
expect ">";
sleep 5;
send "get-config --source running --out $getconfigfile\r";
expect ">";
send "exit\r";