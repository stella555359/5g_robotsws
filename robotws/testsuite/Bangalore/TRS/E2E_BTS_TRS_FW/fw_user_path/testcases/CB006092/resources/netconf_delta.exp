#!/usr/bin/expect -f

set hostname [lindex $argv 0]
set getconfigfile [lindex $argv 1]
set operation [lindex $argv 2]

spawn netopeer2-cli

set timeout 5
expect ">";
send "connect --tls --host $hostname --key /home/ute/netconf/server-key.pem --cert /home/ute/netconf/server-cert.pem --trusted /home/ute/netconf/ca-cert.pem\r";
sleep 10;
expect ">";
send "status\r";
expect ">";
sleep 5;
send "edit-config --target running --config=$getconfigfile --test $operation --rpc-timeout=120\r";
sleep 30;
expect "OK";
send "exit\r";