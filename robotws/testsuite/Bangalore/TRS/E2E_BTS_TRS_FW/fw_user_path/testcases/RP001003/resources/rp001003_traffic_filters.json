{
	"traffic_analysis":{
			"lte_attach_request": {
				  "filter": "(ip.src=={lte_cplane1} && ip.dst=={mme} && (nas_eps.nas_msg_emm_type == 0x41))",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"lte_attach_accept": {
				  "filter": "(ip.src=={mme} && ip.dst=={lte_cplane1} && (nas_eps.nas_msg_emm_type == 0x42))",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"lte_attach_complete": {
				  "filter": "(ip.src=={lte_cplane1} && ip.dst=={mme} && (nas_eps.nas_msg_emm_type == 0x43))",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"gsm_call_proceeding": {
				  "filter": "(ip.src=={bsc} && ip.dst=={gsm_uplane})",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"gsm_connect_ack": {
				  "filter": "(ip.src=={gsm_uplane} && ip.dst=={bsc})",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"capture_filter1":{
	  			"filter": "vlan"
	  		},
			"analysis":{
	  			"filter": "ip.addr == 10.63.72.222 && icmp",
	  			"eval": "count",
	  			"expected_result": "10000-*",
	  			"tolerance": 0
			},
			"verify_initial_mplane_dscp":{
	  			"filter": "(ip.addr==${mplane_ip}) and (ip.dsfield.dscp==${mplane_initial_dscp}) and tcp",
	  			"eval": "count",
	  			"expected_result": "1-*",
	  			"tolerance": 0
			},
			"verify_modified_mplane_dscp":{
	  			"filter": "(ip.addr==${mplane_new_ip}) and (ip.dsfield.dscp==${mplane_modified_dscp}) and tcp",
	  			"eval": "count",
	  			"expected_result": "1-*",
	  			"tolerance": 0
			},
			"analysis_test":{
	 			"filter": "ip.addr == 10.63.72.222 && icmp",
	  			"eval": "count",
	  			"expected_result": "360000-*",
	  			"tolerance": 0,
				"exp_time_interval": 10,
				"exp_time_interval_tolerance" : 0
	  		}

  }
}