{
	"traffic_analysis":{
			"nr_registration_accept": {
				  "filter": "(ip.src==${amf} && ip.dst==${ng_cplane} && nas-5gs.mm.message_type==0x42)",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"nr_registration_complete": {
				  "filter": "(ip.src==${ng_cplane} && ip.dst==${amf} && nas-5gs.mm.message_type==0x43)",
				  "eval": "count",
				  "expected_result": "1",
				  "tolerance": 0
			},
			"slice1": {
				  "filter": "(ngap.sD==d143a5)",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
            "slice2": {
                  "filter": "(ngap.sD==d143a6)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },

			"capture_filter1":{
	  			"filter": "vlan"
	  		},
			"analysis":{
	  			"filter": "ip.addr == 10.63.72.222 && icmp",
	  			"eval": "count",
	  			"expected_result": "10000-*",
	  			"tolerance": 0
			},
             "udp_packets":{
             "filter": "ip.src==10.0.1.2 && ip.dst==10.0.1.1 && udp",
                  "eval": "count",
                  "expected_result": "20-*",
                  "tolerance": 0
            },
             "ping_request":{
             "filter": "ip.src==10.0.1.131 && ip.dst==10.0.1.2 && icmp.type==8",
                  "eval": "count",
                  "expected_result": "20-*",
                  "tolerance": 0
            },
            "ping_reply":{
             "filter": "ip.src==10.0.1.2 && ip.dst==10.0.1.131 && icmp.type==0",
                  "eval": "count",
                  "expected_result": "20-*",
                  "tolerance": 0
            },
            "dns_ltep":{
             "filter": "dns.qry.name == www7.marvels.nsn.com && ipv6.src==2a00:8a00:a000:1104::3963",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            }
  }
}
