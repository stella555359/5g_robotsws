{
    "traffic_analysis":{
        "qci67_invalid_qos":{
            "filter" : "(s1ap) && (s1ap.radioNetwork == 37)",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
        },
        "erab_setup_req":{
            "filter":"s1ap.procedureCode == 5 && ip.src==${mme_ip} && ip.dst==${cplane_ip} && s1ap.qCI==${ded_qci}",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "erab_setup_resp":{
            "filter":"s1ap.procedureCode == 5 && ip.dst==${mme_ip} && ip.src==${cplane_ip}",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "mult_erab_setup_resp":{
            "filter":"s1ap.procedureCode == 5 && ip.dst==${mme_ip} && ip.src==${cplane_ip}",
            "eval" : "count",
            "expected_result": "2",
            "tolerance" : 0
},
        "ul_data_verification":{
            "filter":"ip.src==${ue_ip}&& ip.src==${uplane_ip} && udp && ip.dsfield.dscp==${dscp}",
            "eval" : "count",
            "expected_result": "1-*",
            "tolerance" : 0
}, 
        "init_setup_req_with_bearer":{
            "filter":"s1ap.procedureCode == 9 && ip.src==${mme_ip} && ip.dst==${cplane_ip} && s1ap.qCI==${ded_qci} && s1ap.qCI==${def_qci}",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "init_setup_req_with_multi_bearer":{
            "filter":"s1ap.procedureCode == 9 && ip.src==${mme_ip} && ip.dst==${cplane_ip} && s1ap.qCI==${ded_qci} && s1ap.qCI==${def_qci} && s1ap.qCI==${second_ded_qci}",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "init_setup_resp":{
            "filter":"s1ap.procedureCode == 9 && ip.dst==${mme_ip} && ip.src==${cplane_ip}",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "mbms_sess_start":{
            "filter":"m3ap.M3AP_PDU == 0 && m3ap.procedureCode == 0  && ip.src==${mme_ip} && ip.dst==${cplane_ip} && m3ap.qCI == ${qci} && (sctp.srcport == 36444) && (sctp.dstport == 36444)",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "mbms_sess_resp":{
            "filter":"m3ap.M3AP_PDU == 1 && m3ap.procedureCode == 0  && ip.dst==${mme_ip} && ip.src==${cplane_ip} && (sctp.srcport == 36444) && (sctp.dstport == 36444)",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "mbms_2sess_resp":{
            "filter":"m3ap.M3AP_PDU == 1 && m3ap.procedureCode == 0  && ip.dst==${mme_ip} && ip.src==${cplane_ip} && (sctp.srcport == 36444) && (sctp.dstport == 36444)",
            "eval" : "count",
            "expected_result": "2",
            "tolerance" : 0
},
        "igmp_message":{
            "filter":"igmp.version == 3  && igmp.saddr == ${mbms_gw} && igmp.maddr == ${mcast_addr} && (igmp.record_type == 5 or igmp.record_type == 3)",
            "eval" : "count",
            "expected_result": "2",
            "tolerance" : 0
},
        "sync_message":{
            "filter":"sync.type == 0 && ip.src == ${mbms_gw} && ip.dst == ${mcast_addr}",
            "eval" : "count",
            "expected_result": "100-*",
            "tolerance" : 0
},
        "m3_setup_req":{
            "filter":"m3ap.procedureCode == 7 && ip.src==${cplane_ip} && ip.dst==${mme_ip}",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "modify_request":{
            "filter" : "s1ap.procedureCode == 6  && ip.src==${mme_ip} && ip.dst==${cplane_ip}",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
       "modify_response":{
            "filter" : "(s1ap.procedureCode == 6 && ip.src==${cplane_ip} && ip.dst==${mme_ip}) && (s1ap.id == 37)",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "m3_setup_resp":{
            "filter":"m3ap.procedureCode == 7 && ip.dst==${cplane_ip} && ip.src==${mme_ip}",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "Attach_fail":{
            "filter":"((s1ap.transport == 0) && (s1ap.S1AP_PDU == 2))",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "Attach_pass":{
            "filter":"(s1ap.S1AP_PDU == 1)",
            "eval" : "count",
            "expected_result": "1",
            "tolerance" : 0
},
        "Max_preemption":{
            "filter":"(((((s1ap.transport == 0))) && (s1ap.procedureCode == 8)) && (s1ap.E_RABList == ${No_of_bearer}))",
            "eval" : "count",
            "expected_result": "1-*",
            "tolerance" : 0
}
}
}

