{
    "traffic_analysis": {
		"verify_garp_req_analysis": {
			"filter": "((arp.isgratuitous == 1) && (arp.opcode == 1) && (arp.src.hw_mac == ${ethlmp_mac}))",
			"eval": "count",
			"expected_result": "10",
			"tolerance": 1
			
		},
		"verify_garp_res_analysis": {
			"filter": "((arp.isgratuitous == 1) && (arp.opcode == 2) && (arp.dst.hw_mac == ${ethlmp_mac}))",
			"eval": "count",
			"expected_result": "0",
			"tolerance": 0
			
		},
		"verify_parp_req_analysis": {
			"filter": "(!(arp.isgratuitous == 0) && (arp.opcode == 1) && (arp.src.hw_mac == ${ethlmp_mac}))",
			"eval": "count",
			"expected_result": "10",
			"tolerance": 0
			
		},
		"verify_parp_res_analysis": {
			"filter": "((arp.isgratuitous == 0) && (arp.opcode == 2) && (arp.dst.hw_mac == ${ethlmp_mac}))",
			"eval": "count",
			"expected_result": "0",
			"tolerance": 0
			
		}
	}
}	
