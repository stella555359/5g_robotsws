{
    "traffic_analysis":
    {
        "Verify_IKE_DSCP":
        {
            "filter": "isakmp && ${IP_type}.src == ${Local_IP} && ${IP_type}.dst == ${Remote_IP} && ip.dsfield.dscp == ${dscp_value}",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "Verify_MPLANE_DSCP":
        {
            "filter": "ip.dsfield.dscp == ${dscp_value}",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        }
    }
}
