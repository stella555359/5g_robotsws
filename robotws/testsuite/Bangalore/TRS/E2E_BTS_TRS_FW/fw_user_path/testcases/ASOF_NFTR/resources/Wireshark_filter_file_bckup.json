{
    "traffic_analysis":{
            "GTP_Echo_request": {
                  "filter": "(gtp.message == 0x01) && (ip.src == ${Uplane_addr}) && (ip.dst == ${Sgw_ip_addr})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "GTP_Echo_response": {
                  "filter": "(gtp.message == 0x02) && (ip.dst == ${Uplane_addr}) && (ip.src == ${Sgw_ip_addr})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "GTP_Echo_request_IPv6": {
                  "filter": "(gtp.message == 0x01) && (ipv6.src == ${Uplane_addr}) && (ipv6.dst == ${Sgw_ip_addr})",
                  "eval": "count",
                  "expected_result": "2-*",
                  "tolerance": 0
            },
            "GTP_Echo_response_IPv6": {
                  "filter": "(gtp.message == 0x02) && (ipv6.dst == ${Uplane_addr}) && (ipv6.src == ${Sgw_ip_addr})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "call_drop_ipv4": {
                  "filter": "((s1ap.transport == 0) && (ip.src == ${Cplane_addr})) && (ip.dst == ${MME})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
			"Traffic_check":{
				  "filter": "((gtp) && (ip.src == ${uplane_addr})) && (ip.src == ${PDN_IP})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "Traffic_check_IPV6":{
                  "filter": "((gtp) && (ipv6.src == ${uplane_addr})) && (ip.src == ${PDN_IP})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
			"No_Traffic":{
				  "filter": "((gtp) && (ip.src == ${uplane_addr})) && (ip.src == ${PDN_IP})",
                  "eval": "count",
                  "expected_result": "0",
                  "tolerance": 0
            },
            "qos_packets":{
                  "filter": "(ip.src==10.0.1.2)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            }
            
}            
}


