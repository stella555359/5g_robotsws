#!/usr/bin/expect -f

set ip_version [lindex $argv 0]
set dst_ip [lindex $argv 1]
set count [lindex $argv 2]

spawn "scapy";

set timeout 5
expect ">>>"
send "iter = 0\r";
expect ">>>";
if {"$ip_version" == "IPv4"} {
        send "while iter < $count:send(IP(dst='$dst_ip')/ESP());iter = iter + 1\r";
    } else {
        send "while iter < $count:send(IPv6(dst='$dst_ip')/ESP());iter = iter + 1\r";
    }
expect "...";
send "\r";
expect ">>>";
send "exit()\r";
