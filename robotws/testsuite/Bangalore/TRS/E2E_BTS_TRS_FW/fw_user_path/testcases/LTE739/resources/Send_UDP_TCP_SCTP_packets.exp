#!/usr/bin/expect -f

set ip_version [lindex $argv 0]
set mplane_ip [lindex $argv 1]
set cplane_ip [lindex $argv 2]
set uplane_ip [lindex $argv 3]
set count [lindex $argv 4]

spawn "scapy";

set timeout 2
expect ">>>"

send "iter = 0\r";
expect ">>>";

if {"$ip_version" == "IPv4"} {
        send "while iter < $count:send(IP(src='10.0.1.1',dst='$mplane_ip')/TCP());iter = iter + 1\r";
    } else {
        send "while iter < $count:send(IPv6(src='fc00::1',dst='$mplane_ip')/TCP());iter = iter + 1\r";
    }

expect "...";
send "\r";

send "iter = 0\r";
expect ">>>";

if {"$ip_version" == "IPv4"} {
        send "while iter < $count:send(IP(src='10.0.1.1',dst='$cplane_ip')/SCTP());iter = iter + 1\r";
    } else {
        send "while iter < $count:send(IPv6(src='fc00::1',dst='$cplane_ip')/SCTP());iter = iter + 1\r";
    }

expect "...";
send "\r";

send "iter = 0\r";
expect ">>>";

if {"$ip_version" == "IPv4"} {
        send "while iter < $count:send(IP(src='10.0.1.1',dst='$uplane_ip')/UDP());iter = iter + 1\r";
    } else {
        send "while iter < $count:send(IPv6(src='fc00::1',dst='$uplane_ip')/UDP());iter = iter + 1\r";
    }

expect "...";
send "\r";
expect ">>>";
send "exit()\r";

