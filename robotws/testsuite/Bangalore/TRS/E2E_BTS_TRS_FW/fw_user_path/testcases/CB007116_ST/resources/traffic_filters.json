{
    "traffic_analysis":
    {
        "sctp_e2ap_success":
        {
            "filter": "((sctp.srcport == ${e2SctpPort} || sctp.dstport == ${e2SctpPort}) && sctp.chunk_type == 5)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "sctp_e2ap_Mod_DSCP":
        {
            "filter": "(sctp && ip.dst == ${RIC_IPv4} && ip.dsfield.dscp != ${modified_cplane_DSCP})",
            "eval": "count",
            "expected_result": "0",
            "tolerance": 0
        }
    }
 }

