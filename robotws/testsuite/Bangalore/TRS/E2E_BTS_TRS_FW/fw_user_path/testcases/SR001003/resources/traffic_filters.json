{
	"traffic_analysis": {
		"s1ap_attach_request_ipV4":{
			"filter":"s1ap && ip.src==${cplaneIp} && ip.dst==${mme_ip} && s1ap.procedureCode == 12",
			"eval":"count",
            "expected_result": "1",
            "tolerance": 0
		},
        "verify_mplane_dscp":{
            "filter": "(ip.src == 10.0.3.210 && ip.dsfield.dscp == 25 && tcp)",
