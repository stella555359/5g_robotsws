            "tolerance": 0
		},
		"lte_call_ul_ipV4":{
			"filter":"gtp && ip.src==${uplaneIp} && ip.dst==${sgw_ip}",
			"eval":"count",
            "expected_result": "1-*",
            "tolerance": 0
		},
		"GBR_UL":{
			"filter":"s1ap.e_RAB_MaximumBitrateUL == 50000",
			"eval":"count",
            "expected_result": "1",
            "tolerance": 0
		},
		"GBR_DL":{
			"filter":"s1ap.e_RAB_MaximumBitrateDL == 50000",
