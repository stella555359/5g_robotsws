{
    "traffic_analysis": {

        "verify_discover_message_rp1": {
            "filter": "(dhcp.option.dhcp == 1) && (dhcp.option.vendor.value == ${rf_ipsec_flag}) && (ip.src == 172.21.0.6)",
            "eval": "count",
            "expected_result": "0-*",
            "tolerance": 0

        },

        "verify_discover_message_rp1b": {
            "filter": "(dhcp.option.dhcp == 1) && (dhcp.option.vendor.value == ${rf_ipsec_flag_branch}) && (ip.src == ${soaprp1gwb})",
            "eval": "count",
            "expected_result": "0-*",
            "tolerance": 0

        },

        "verify_discover_message_oran": {
            "filter": "(dhcp.option.dhcp == 1) && !(dhcp.option.vendor.value == ${rf_ipsec_flag}) && (ip.src == 172.21.0.4)",
            "eval": "count",
            "expected_result": "0-10",
            "tolerance": 0

        },

        "verify_discover_message_oranb": {
            "filter": "(dhcp.option.dhcp == 1) && !(dhcp.option.vendor.value == ${rf_ipsec_flag_branch}) && (ip.src == ${orangwb})",
            "eval": "count",
            "expected_result": "0-10",
            "tolerance": 0

        },

       "verify_offer_message_rp1": {
            "filter": "(dhcp.option.dhcp == 2) && (dhcp.ip.your == ${soaprp1})",
            "eval": "count",
            "expected_result": "0-*",
            "tolerance": 0

        },

        "verify_offer_message_oran": {
            "filter": "(dhcp.option.dhcp == 2) && (dhcp.ip.your == ${oran})",
            "eval": "count",
            "expected_result": "0-*",
            "tolerance": 0

        },

        "verify_request_message_rp1": {
            "filter": "(dhcp.option.dhcp == 3) && (ip.src == 172.21.0.6) && (dhcp.option.vendor.value == ${rf_ipsec_flag})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_request_message_rp1b": {
            "filter": "(dhcp.option.dhcp == 3) && (ip.src == ${soaprp1gwb}) && (dhcp.option.vendor.value == ${rf_ipsec_flag_branch})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },


        "verify_request_message_oran": {
            "filter": "(dhcp.option.dhcp == 3) && (ip.src == 172.21.0.4) && !(dhcp.option.vendor.value == ${rf_ipsec_flag})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_request_message_oranb": {
            "filter": "(dhcp.option.dhcp == 3) && (ip.src == ${orangwb}) && !(dhcp.option.vendor.value == ${rf_ipsec_flag_branch})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },


        "verify_ack_message_rp1": {
            "filter": "(dhcp.option.dhcp == 5) && (dhcp.ip.your == ${soaprp1})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_ack_message_oran": {
            "filter": "(dhcp.option.dhcp == 5) && (dhcp.ip.your == ${oran})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_ike_init_isakmp_rp1": {
            "filter": "(isakmp) && (ip.src == ${soaprp1}) && (isakmp.exchangetype == 34)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0

        },

        "verify_ike_isakmp_oran": {
            "filter": "(ip.src == ${oran}) && (isakmp)",
            "eval": "count",
            "expected_result": "0",
            "tolerance": 0

        },

        "verify_esp_rp1": {
            "filter": "(esp)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_no_isakmp": {
            "filter": "(isakmp.flag_r == 1)",
            "eval": "count",
            "expected_result": "0",
            "tolerance": 0

        }

    }
}
