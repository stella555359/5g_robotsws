{
    "traffic_analysis":{
            "twamp_port_sender": {
                  "filter": "(ip.dst == 10.0.1.1) && (udp.srcport == ${src_port}) && (udp.dstport == 5018)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
           "twamp_port_ref": {
                  "filter": "(udp.dstport == ${dst_port}) && (udp.srcport == 5018)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
             "twamp_unlock": {
                  "filter": "(ip.dst == 10.0.1.1) && (udp.srcport == ${src_port}) && (udp.dstport == 5018)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "twamp_unlock_sessions":{
