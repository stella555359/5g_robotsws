{
	"traffic_analysis":{
			"mplane": {
				  "filter": "(ip.proto == 6) && (tcp.srcport == 443) && (ip.src == ${gwv4}) && (ip.dst == ${mplanev4})",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},

             "cplane": {
                  "filter": "(ip.proto == 17) && (udp.srcport == 38412) && (ip.src == ${gwv4}) && (ip.dst == ${cplanev4})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            
            "uplane": {
                  "filter": "(ip.proto == 17) && (udp.srcport == 2150) && (ip.src == ${gwv4}) && (ip.dst == ${uplanev4})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "uplane_valid": {
                  "filter": "(ip.proto == 17) && (udp.srcport == 2152) && (ip.src == ${gwv4}) && (ip.dst == ${uplanev4})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "mplane_v6": {
                  "filter": "(ipv6.nxt == 6) && (ipv6.src == ${gwv6}) && (ipv6.dst == ${mplanev6}) && (tcp.srcport == 443) && (tcp.dstport == 443)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },

             "cplane_v6": {
                  "filter": "(ipv6.nxt == 17) && (ipv6.src == ${gwv6}) && (ipv6.dst == ${cplanev6}) && (udp.srcport == 38412) && (udp.dstport == 38412)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },

            "uplane_v6": {
                  "filter": "(ipv6.nxt == 17) && (ipv6.src == ${gwv6}) && (ipv6.dst == ${uplanev6}) && (udp.srcport == 2150) && (udp.dstport == 2150)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            }        
  }
}
