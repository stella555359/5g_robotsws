{
    "traffic_analysis": {
        "verify_cmp_ir": {
            "filter": "(cmp && ip.src==${cmp1_SourceIP} && ip.dst==${Primary_cmp} && cmp.body==0)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0

        },
        "verify_tcp": {
            "filter": "(tcp && ip.src==${du_oam_ip} && ip.dst==${vm_ip} && ip.dsfield.dscp == 40)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },
        "verify_sctp": {
            "filter": "(sctp && ip.src==${du_cplane_ip} && ip.dst==${cu_cplane_ip} && ip.dsfield.dscp == 46)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },
        "verify_tcp_vcu": {
            "filter": "(tcp && ip.src==${cu_oam_ip} && ip.dst==${cu_vm_ip} && ip.dsfield.dscp == 45)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        }

        }
}
