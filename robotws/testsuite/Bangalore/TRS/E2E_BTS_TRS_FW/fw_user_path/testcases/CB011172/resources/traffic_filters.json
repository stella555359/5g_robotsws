{
	"traffic_analysis": {
		"verify_dhcp_discover_swn": {
			"filter": "(dhcp.option.dhcp_max_message_size == 576 && dhcp.option.dhcp == 1 && dhcp.option.type == 53)",
			"eval": "count",
   			"expected_result": "1",
	        "tolerance": 0
		},
		"verify_dhcp_offer_swn": {
			"filter": "(dhcp.option.dhcp == 2 && ip.dst == 192.168.254.48 && ip.src == 192.168.254.33)",
			"eval": "count",
			"expected_result": "1",
			"tolerance": 0
		},
		"verify_dhcp_request_swn": {
			"filter": "(dhcp.option.dhcp == 3 && ip.dst == 192.168.254.33 && ip.src == 192.168.254.48)",
			"eval": "count",
			"expected_result": "1",
			"tolerance": 0
		},
		"verify_dhcp_ack_swn": {
			"filter": "(dhcp.option.dhcp == 5 && ip.dst == 192.168.254.48 && ip.src == 192.168.254.33)",
			"eval": "count",
			"expected_result": "2",
			"tolerance": 0
		},
        "verify_changed_dhcp_offer_pcp": {
            "filter": "(dhcp.option.dhcp == 2 && vlan.priority == 5)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0
        },
        "verify_changed_dhcp_ack_pcp": {
            "filter": "(dhcp.option.dhcp == 5 && vlan.priority == 5 && ip.src == 192.168.254.33 && ip.dst == 192.168.254.48)",
            "eval": "count",
            "expected_result": "2",
            "tolerance": 0
        }
    }
}
