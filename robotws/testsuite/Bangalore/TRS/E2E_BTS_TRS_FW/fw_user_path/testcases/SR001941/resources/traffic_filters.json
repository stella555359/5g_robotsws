{
	"traffic_analysis":{
			"lte_attach_request": {
				  "filter": "(ipv6.src==${lte_cplane1} && ipv6.dst==${mme} && (nas_eps.nas_msg_emm_type == 0x41))",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"lte_attach_accept": {
				  "filter": "(ipv6.src==${mme} && ipv6.dst==${lte_cplane1} && (nas_eps.nas_msg_emm_type == 0x42))",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"lte_attach_complete": {
				  "filter": "(ipv6.src==${lte_cplane1} && ipv6.dst==${mme} && (nas_eps.nas_msg_emm_type == 0x43))",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"capture_filter1":{
	  			"filter": "vlan"
	  		},
			"analysis":{
	  			"filter": "ip.addr == 10.63.72.222 && icmp",
	  			"eval": "count",
	  			"expected_result": "10000-*",
	  			"tolerance": 0
			},
             "dns":{
             "filter": "dns.qry.name == dyn7.marvels.dyn.com",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
			"default_lte_uplane_dscp":{
	  			"filter": "(udp and ip.addr==${lte_uplane1} and ip.dsfield.dscp == 0x0)",
	  			"eval": "count",
	  			"expected_result": "1-*",
	  			"tolerance": 0
			},
			"modified_lte_uplane_dscp":{
