#!/usr/bin/expect -f

set dst_ip [lindex $argv 0]
set ip_version [lindex $argv 1]

spawn scapy

set timeout 5
expect ">>>"
expect ">>>";
if {"$ip_version" == "IPv4"} {
        send "send(IP(dst='$dst_ip')/ESP())";
    } else {
        send "send(IPv6(dst='$dst_ip')/ESP())";
    }
expect "...";
send "\r";
expect ">>>";
send "exit()\r";
