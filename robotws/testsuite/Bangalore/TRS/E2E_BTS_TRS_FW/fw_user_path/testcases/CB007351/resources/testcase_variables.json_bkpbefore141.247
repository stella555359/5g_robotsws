    "BTS__fingerprint_Active" : "openssl x509 -fingerprint -noout -in /ffs/run/trs_data/active/keystorage/certs/cert.pem",
    "BTS_EC_fingerprint_Active" : "openssl x509 -fingerprint -noout -in /ffs/run/trs_data/active/keystorage/certs/ec_cert.pem",
    "Mount_command": "encfs --public --crakey '/etc/keys.d/private/sok.crk&enc.crk' /ffs/stb/trs_data/active/.keystorage /ffs/stb/trs_data/active/keystorage -o nonempty,allow_other",
    "BTS_cert_count_passive" :  "cd /ffs/stb/trs_data/active/keystorage/certs;find . -type f -name 'cert.pem' | wc -l",
    "BTS_cert_passive" : "openssl x509 -in /ffs/stb/trs_data/active/keystorage/certs/cert.pem -text | head -5 | tail -1",
    "BTS__fingerprint_passive" : "openssl x509 -fingerprint -noout -in /ffs/stb/trs_data/active/keystorage/certs/cert.pem",
    "crlpem_active_passive": "diff /ffs/run/trs_data/active/keystorage/certs/crl_*_*.pem /ffs/stb/trs_data/active/keystorage/certs/crl_*_*.pem",
    "crlinfo_active_passive": "diff /ffs/run/trs_data/active/keystorage/cmpdb/crl_info_list.txt /ffs/stb/trs_data/active/keystorage/cmpdb/crl_info_list.txt",
    "Pskinfo_active_passive": "diff /ffs/run/trs_data/active/keystorage/pskRef.txt /ffs/stb/trs_data/active/keystorage/pskRef.txt",
    "Additional_cert_count_active" : "cd /ffs/run/trs_data/active/keystorage/cmpdb/additionalcertchain;find . -type f -name 'cmp_ta_cert*' | wc -l",
    "Additional_cert_count_passive" : "cd /ffs/stb/trs_data/active/keystorage/cmpdb/additionalcertchain;find . -type f -name 'cmp_ta_cert*' | wc -l",
    "RSA_ta_cert" : "openssl x509 -in /ffs/run/trs_data/active/keystorage/certs/root_cert_*_*.pem -text | head -4 | tail -1 | awk '{ print $3 }''{ print $4 }'",
    "EC_ta_cert" : "openssl x509 -in /ffs/run/trs_data/active/keystorage/certs/ec_root_cert_*_*.pem -text | head -4 | tail -1 | awk '{ print $3 }''{ print $4 }'",
    "RSA_ta_fingerprint": "openssl x509 -fingerprint -noout -in /ffs/run/trs_data/active/keystorage/certs/root_cert_*_*.pem",
    "EC_ta_fingerprint" : "openssl x509 -fingerprint -noout -in /ffs/run/trs_data/active/keystorage/certs/ec_root_cert_*_*.pem",
