    "BTS_cert_count" :  "cd /ffs/run/trs_data/active/keystorage/certs;find . -type f -name 'cert.pem' | wc -l",
    "BTS_EC_cert_Count" : "cd /ffs/run/trs_data/active/keystorage/certs;find . -type f -name 'ec_cert.pem' | wc -l",
    "BTS_cert_Active" : "openssl x509 -in /ffs/run/trs_data/active/keystorage/certs/cert.pem -text | head -5 | tail -1",
