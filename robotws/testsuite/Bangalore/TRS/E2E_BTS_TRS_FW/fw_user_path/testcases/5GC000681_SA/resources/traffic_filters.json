{
	"traffic_analysis":{
			"lte_attach_request": {
				  "filter": "(ip.src=={lte_cplane1} && ip.dst=={mme} && (nas_eps.nas_msg_emm_type == 0x41))",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"lte_attach_accept": {
				  "filter": "(ip.src=={mme} && ip.dst=={lte_cplane1} && (nas_eps.nas_msg_emm_type == 0x42))",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"lte_attach_complete": {
				  "filter": "(ip.src=={lte_cplane1} && ip.dst=={mme} && (nas_eps.nas_msg_emm_type == 0x43))",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
            "wcdma_attach_request": {
                    "filter": "(ip.dst == {wcdma_cplane})",
                    "eval": "count",
                    "expected_result": "1-*",
                    "tolerance": 0,
                    "decode_as": "sctp.ppi==0,nbap"
            },
            "wcdma_attach_response": {
                    "filter": "(ip.src == {wcdma_cplane})",
                    "eval": "count",
                    "expected_result": "1-*",
                    "tolerance": 0,
                    "decode_as": "sctp.ppi==0,nbap"
            },
			"gsm_call_proceeding": {
