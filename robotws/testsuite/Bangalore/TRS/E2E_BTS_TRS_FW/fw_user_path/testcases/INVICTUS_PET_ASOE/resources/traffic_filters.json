{
    "traffic_analysis": {
        "verify_LBM_LBR_message": {
            "filter": "((cfm.opcode == 3) || (cfm.opcode == 2))",
            "eval": "count",
            "expected_result": "5-*",
            "tolerance": 0
        },
        "verify_MDlevel": {
            "filter": "((cfm.md_level == 7) && (cfm.md_level == 7))",
            "eval": "count",
            "expected_result": "5-*",
            "tolerance": 0
        },      
        "Verify_SA_Calls": {
           "filter": "gtp",
            "eval": "count", 
            "expected_result": "1-*",
            "tolerance": 0
        },

        "verify_discover_message_rp1": {
            "filter": "(dhcp.option.dhcp == 1) && (dhcp.option.vendor.value == ${rf_ipsec_flag}) && (ip.src == ${soaprp1gw})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_discover_message_oran": {
            "filter": "(dhcp.option.dhcp == 1) && !(dhcp.option.vendor.value == ${rf_ipsec_flag}) && (ip.src == ${orangw})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

       "verify_offer_message_rp1": {
            "filter": "(dhcp.option.dhcp == 2) && (dhcp.ip.your == ${soaprp1})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_offer_message_oran": {
            "filter": "(dhcp.option.dhcp == 2) && (dhcp.ip.your == ${oran})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_request_message_rp1": {
            "filter": "(dhcp.option.dhcp == 3) && (ip.src == ${soaprp1gw}) && (dhcp.option.vendor.value == ${rf_ipsec_flag})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_request_message_oran": {
            "filter": "(dhcp.option.dhcp == 3) && (ip.src == ${orangw}) && !(dhcp.option.vendor.value == ${rf_ipsec_flag})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_ack_message_rp1": {
            "filter": "(dhcp.option.dhcp == 5) && (dhcp.ip.your == ${soaprp1})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_ack_message_oran": {
            "filter": "(dhcp.option.dhcp == 5) && (dhcp.ip.your == ${oran})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

        "verify_ike_init_isakmp_rp1": {
            "filter": "(isakmp) && (ip.src == ${soaprp1}) && (isakmp.exchangetype == 34)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0

        },

        "verify_ike_isakmp_oran": {
            "filter": "(ip.src == ${oran}) && (isakmp)",
            "eval": "count",
            "expected_result": "0",
            "tolerance": 0

