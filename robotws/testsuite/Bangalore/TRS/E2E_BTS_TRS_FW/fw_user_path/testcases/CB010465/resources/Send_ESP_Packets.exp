#!/usr/bin/expect -f


spawn "scapy"


expect ">>>"
send "from time import sleep\r"
expect ">>>"
send "s = socket.socket(socket.AF_PACKET, socket.SOCK_RAW)\r"
expect ">>>"
send "s.bind(('eth7', 0))\r"
expect ">>>"
send "pe=Ether()/IP(dst='10.0.11.210')/ESP()\r"
expect ">>>"
send "data = pe.build()\r"
expect ">>>"
send "iter = 0\r"
expect ">>>"
send "while iter < 1000:\r"
expect "...";
send "    l=s.send(data);iter=iter+1;sleep(0.000125)\r"
send "\r";
expect ">>>";
send "exit()\r";
