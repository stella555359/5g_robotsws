{
 "traffic_analysis":{
    "LTE_392_IPSEC_pcap_analysis":{
    "filter":"ESP",
    "eval":"getValue",
    "display_fields":"distName",
    "output_type":"fields"

     },
    "verify_ipv4_dscp": {
            "filter": "((ip.dsfield.dscp == ${ping_dscp}) && (ip.src == ${uplane_ip}))",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },
    "verify_secgw_dscp": {
            "filter": "((ipv6.tclass.dscp == ${Ipsec_DSCP}) && (ipv6.src == ${local_tunnel_ip}))",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

    "verify_secgw_dscp_new": {
            "filter": "((ipv6.tclass.dscp == ${Ipsec_DSCP}) && (ipv6.src == ${local_tunnel_ip}))",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },

    "uplane_isakmp": {
            "filter": "((isakmp.version == 0x20) && (ip.src == ${lte_uplane1}))",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        }


 }
}

