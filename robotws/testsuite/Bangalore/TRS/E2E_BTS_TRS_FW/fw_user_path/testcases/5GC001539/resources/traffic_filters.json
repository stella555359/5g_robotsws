{
	"traffic_analysis": {
		"verify_start_message": {
			"filter": "(eth.src == ${interface_mac} && eapol.type == 1)",
			"eval": "count",
			"expected_result": "1-*",
			"tolerance": 0
			
		},
		"verify_success_message": {
			"filter": "(eap.code == 3)",
			"eval": "count",
			"expected_result": "1-*",
			"tolerance": 0
        },
        "verify_request_message": {
            "filter": "(frame.len == 60 && eap.code == 1 && eap.type == 1 && eap.len == 5)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_response_message": {
            "filter": "(eap.code == 2 && eap.type == 1)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_client_hello_message": {
            "filter": "((eap.code == 2) && (eap.type == 13) && (eap.id == 2))",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_server_hello_message": {
            "filter": "((eap.code == 1) && (eap.id == 5))",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_eap_request_message": {
            "filter": "(eap.code == 1 && eap.type == 13 && frame.len == 60)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_eap_response_message": {
            "filter": "((eap.code == 2) && (eap.len == 6) && (eap.type == 13))",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        }
        
	}
}
