{
    "traffic_analysis":{
            "isakmp_check_IPV4":{
                  "filter": "((isakmp) && (ip.src == ${local_tunnel_ip})) && (ip.dst == ${remote_tunnel_ip})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "no_isakmp_check_IPV4":{
                  "filter": "((isakmp) && (ip.src == ${local_tunnel_ip})) && (ip.dst == ${remote_tunnel_ip})",
                  "eval": "count",
                  "expected_result": "0",
                  "tolerance": 0
            },
			"Traffic_check_IPV6":{
                  "filter": "((ipv6.src == ${uplane_addr})) && (ip.src == ${PDN_IP})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
			"isakmp_check_IPV6":{
                  "filter": "((isakmp) && (ipv6.src == ${local_tunnel_ip})) && (ipv6.dst == ${remote_tunnel_ip})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "no_isakmp_check_IPV6":{
                  "filter": "((isakmp) && (ipv6.src == ${local_tunnel_ip})) && (ipv6.dst == ${remote_tunnel_ip})",
                  "eval": "count",
                  "expected_result": "0",
                  "tolerance": 0
            },
			"DNS_query":{
                  "filter": "(((dns.qry.name == \"${DNS_query_name}\") && (dns.qry.type == 28)) && (ipv6.src == ${src_ip})) && (ipv6.dst == ${dns_ip})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
			"DNS_response":{
                  "filter": "((dns.resp.name == \"${DNS_query_name}\") && (dns.aaaa == ${first_ip})) && (dns.aaaa == ${second_ip}) && (ipv6.dst == ${src_ip}) && (ipv6.src == ${dns_ip})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
			"no_DNS_response":{
                  "filter": "((dns.resp.name == \"${DNS_query_name}\") && (dns.aaaa == ${first_ip})) && (dns.aaaa == ${second_ip}) && (ipv6.dst == ${src_ip}) && (ipv6.src == ${dns_ip})",
                  "eval": "count",
                  "expected_result": "0",
                  "tolerance": 0
            },
			"invalid_fqdn_response":{
                  "filter": "(dns.resp.type == 6) && (ipv6.dst == ${src_ip}) && (ipv6.src == ${dns_ip})",
                  "eval": "count",
                  "expected_result": "1",
                  "tolerance": 0
            }
}
}

