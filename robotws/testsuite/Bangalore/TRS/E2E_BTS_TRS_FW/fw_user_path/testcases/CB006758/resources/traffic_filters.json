{
	"traffic_analysis": {
        "verify_sctp_init": {
            "filter": "(ip.src==${lte_cplane}) && (ip.dst==${5g_x2c}) && (sctp.chunk_type==1)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "TLS_hello_client": {
                        "filter": "(tls and ip.addr == 10.58.141.70 and tls.handshake.type == 1)",
                        "eval": "count",
                        "expected_result": "1-*",
                        "tolerance": 0
           },
         "TLS_hello_server": {
                        "filter": "((tls and ip.addr == 10.58.141.70 and tls.handshake.type == 2) ) && (tls.handshake.ciphersuite == 0xc030)",
                        "eval": "count",
                        "expected_result": "1-*",
                        "tolerance": 0
            },
            "TLS_hello_server_reply": {
                        "filter": "(tls and ip.addr == 10.58.141.70 and tls.handshake.type == 2)",
                        "eval": "count",
                        "expected_result": "1-*",
                        "tolerance": 0
           },
            "verify_sctp_init_ack": {
            "filter": "(ip.dst==${lte_cplane}) && (ip.src==${5g_x2c}) && (sctp.chunk_type==2)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0

        },
        "certificate":   {
                        "filter": "(tls and ip.addr == 10.58.141.70 and tls.handshake.type == 1 && tls.handshake.extensions_ec_point_format==0)",
                        "eval": "count",
                        "expected_result": "1-*",
                        "tolerance": 0
            },
	    "verify_sctp_cookie_echo": {
            "filter": "(ip.src==${lte_cplane}) && (ip.dst==${5g_x2c}) && (sctp.chunk_type==10)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_sctp_cookie_ack": {
            "filter": "(ip.dst==${lte_cplane}) && (ip.src==${5g_x2c}) && (sctp.chunk_type==11)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_sctp_selective_ack": {
            "filter": "(ip.addr==${lte_cplane}) &&(ip.addr==${5g_x2c}) && (sctp.chunk_type==3)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_sctp_heartbeat": {
            "filter": "(ip.src==${lte_cplane}) && (ip.dst==${5g_x2c}) && (sctp.chunk_type==4)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_sctp_heartbeat_ack": {
            "filter": "(ip.dst==${lte_cplane}) && (ip.src==${5g_x2c}) && (sctp.chunk_type==5)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
		"verify_sctp_dscp": {
            "filter": "(ip.dst==${lte_cplane}) && (ip.src==${5g_x2c}) && (ip.dsfield.dscp == ${modified_dscp})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_sctp_shutdown": {
            "filter": "(ip.addr==${cplane_ip}) && (sctp.chunk_type==7)",
            "eval": "count",
            "expected_result": "0",
            "tolerance": 0
        },
        "verify_sctp_shutdown_ack": {
            "filter": "(ip.addr==${cplane_ip}) && (sctp.chunk_type==8)",
            "eval": "count",
            "expected_result": "0",
            "tolerance": 0
        },
        "verify_sctp_shutdown_complete": {
            "filter": "(ip.addr==${cplane_ip}) && (sctp.chunk_type==14)",
            "eval": "count",
            "expected_result": "0",
            "tolerance": 0
        },
        "verify_sctp_abort": {
            "filter": "(ip.addr==${cplane_ip}) && (sctp.chunk_type==6)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_sctp_v6_init": {
            "filter": "(ipv6.addr==${cplane_ipv6}) && (sctp.chunk_type==1)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_sctp_v6_init_ack": {
            "filter": "(ipv6.addr==${cplane_ipv6}) && (sctp.chunk_type==2)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0
        },
        "verify_sctp_v6_selective_ack": {
            "filter": "(ipv6.addr==${cplane_ipv6}) && (sctp.chunk_type==3)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0,
            "decode_as": "sctp.ppi==0,nbap"
        },
        "verify_sctp_v6_cookie_echo": {
            "filter": "(ipv6.addr==${cplane_ipv6}) && (sctp.chunk_type==10)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0
        },
        "verify_sctp_v6_cookie_ack": {
            "filter": "(ipv6.addr==${cplane_ipv6}) && (sctp.chunk_type==11)",
            "eval": "count",
            "expected_result":"1",
            "tolerance": 0
        },
        "verify_sctp_v6_heartbeat": {
            "filter": "(ipv6.addr==${cplane_ipv6}) && (sctp.chunk_type==4)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "verify_sctp_v6_shutdown": {
            "filter": "(ipv6.addr==${cplane_ipv6}) && (sctp.chunk_type==7)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0
        },
        "verify_sctp_v6_shutdown_ack": {
            "filter": "(ipv6.addr==${cplane_ipv6}) && (sctp.chunk_type==8)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0
        },
        "verify_sctp_v6_shutdown_complete": {
            "filter": "(ipv6.addr==${cplane_ipv6}) && (sctp.chunk_type==14)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0
        },
        "verify_sctp_v6_abort": {
            "filter": "(ipv6.addr==${cplane_ipv6}) && (sctp.chunk_type==6)",
            "eval": "count",
            "expected_result": "1",
            "tolerance": 0
        },
        "verify_sctp_v6_heartbeat_ack": {
            "filter": "(ipv6.addr==${cplane_ipv6}) && (sctp.chunk_type==5)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "gtpu_echo": {
            "filter": "(ip.dst==${uplane_ip}) && (gtp.message==0x01)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "gtpu_reply": {
            "filter": "(ip.src==${uplane_ip}) && (gtp.message==0x02) && (ip.dsfield.dscp == 0x2e)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "gtpu_v6_echo": {
            "filter": "(ipv6.dst.addr==${uplane_ipv6}) && (gtp.message==0x01) ",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
        "gtpu_v6_reply": {
            "filter": "(ipv6.src.addr==${uplane_ipv6}) && (gtp.message==0x02) && (ipv6.class == 0x184)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        }
    }    
}
