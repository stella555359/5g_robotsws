{
	"traffic_analysis": {
		"verify_dhcp_discover": {
			"filter": "(dhcp.hw.mac_addr == ${RU1_MAC} && dhcp.option.dhcp == 1 && dhcp.client_id.iaid == ${RU1_Client_MAC} && dhcp.ip.relay == ${dhcp_relay} && !gre)",
			"eval": "count",
   			"expected_result": "1..*",
	        "tolerance": 0	
			
		},
		"verify_dhcp_offer": {
			"filter": "(dhcp.option.dhcp == 2 && ip.dst == ${RU1_dst} && !gre)",
			"eval": "count",
			"expected_result": "1..*",
			"tolerance": 0

		},
		"verify_dhcp_request": {
			"filter": "(dhcp.option.dhcp == 3 && dhcp.hw.mac_addr == ${RU1_MAC} && !gre && dhcp.ip.relay == ${dhcp_relay})",
			"eval": "count",
			"expected_result": "1..*",
			"tolerance": 0
			
		},
		"verify_dhcp_ack": {
			"filter": "(dhcp.option.dhcp == 5 && !gre && ip.dst == ${RU1_dst})",
			"eval": "count",
			"expected_result": "1..*",
			"tolerance": 0
			
		},
        "verify_dhcp_discover_RU2": {
            "filter": "(dhcp.option.dhcp == 1 && dhcp.ip.relay == ${RU2_dhcp_relay}  && dhcp.hw.mac_addr == ${RU2_MAC} && !gre && dhcp.flags.bc == 0)",
            "eval": "count",
            "expected_result": "1..*",
            "tolerance": 0

        },
        "verify_dhcp_offer_RU2": {
            "filter": "(dhcp.option.dhcp == 2 && ip.dst == ${RU2_dst} && !gre)",
            "eval": "count",
            "expected_result": "1..*",
            "tolerance": 0

        },
        "verify_dhcp_request_RU2": {
            "filter": "(dhcp.option.dhcp == 3 && dhcp.hw.mac_addr == ${RU2_MAC} && !gre && dhcp.ip.relay == ${RU2_dhcp_relay})",
            "eval": "count",
            "expected_result": "1..*",
            "tolerance": 0

        },
        "verify_dhcp_ack_RU2": {
            "filter": "(dhcp.option.dhcp == 5 && !gre && ip.dst == ${RU2_dst})",
            "eval": "count",
            "expected_result": "1..*",
            "tolerance": 0

        },
        "verify_dhcp_offer_pcp": {
            "filter": "(dhcp.option.dhcp == 2 &&  dhcp.ip.relay == ${dhcp_offer} && vlan.priority == 5 && dhcp.flags.bc == 0)",
            "eval": "count",
            "expected_result": "1..*",
            "tolerance": 0

        },
        
        "verify_dhcp_ack_pcp": {
            "filter": "(dhcp.option.dhcp == 5 && dhcp.ip.relay == ${dhcp_ack} && vlan.priority == 5)",
            "eval": "count",
            "expected_result": "1..*",
            "tolerance": 0

        },
        "verify_dhcp_offer_pcp2": {
            "filter": "(dhcp.option.dhcp == 2 &&  dhcp.ip.relay == ${dhcp_offer_1} && vlan.priority == 5 && dhcp.flags.bc == 0)",
            "eval": "count",
            "expected_result": "1..*",
            "tolerance": 0

        },

        "verify_dhcp_ack_pcp2": {
            "filter": "(dhcp.option.dhcp == 5 && dhcp.ip.relay == ${dhcp_ack_1} && vlan.priority == 5)",
            "eval": "count",
            "expected_result": "1..*",
            "tolerance": 10

        }

    }
}




