{
    "traffic_analysis":{
            "Twamp_sender": {
                  "filter": "((((udp) && (udp.srcport == ${Source_port})) && (udp.dstport == ${Destination_port})) && (ip.dsfield.dscp == ${DSCP})) && (ip.len == ${message_size})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "Twamp_reflector": {
                  "filter": "((((udp) && (udp.dstport == ${Source_port})) && (udp.srcport == ${Destination_port})) && (ip.dsfield.dscp == ${DSCP})) && (ip.len == ${message_size})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "Twamp_multi_session_reflector": {
                  "filter": "((ip.src ==${Twamp_reflector_ip_1}) && (ip.dst ==${Twamp_Src_IP})) && (twamp.seqnum.reflector == 0)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "Twamp_sender_v6": {
                  "filter": "((((udp) && (udp.srcport == ${Source_port})) && (udp.dstport == ${Destination_port})) && (ipv6.tclass.dscp == ${DSCP}))",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "Twamp_reflector_v6": {
                  "filter": "(((udp) && (udp.dstport == ${Source_port})) && (udp.srcport == ${Destination_port}))",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            }

}
}
