{
    "traffic_analysis": {
    "get_packets_dscp_values": {
        "filter": "(esp and (${display_filter_ikeIpAddresses_ips}))",
        "eval": "getValue",
        "display_fields": "ip.dsfield.dscp",
        "output_type": "fields",
        "tolerance": 0
    },
    "verify_5g_uplane_dscp": {
        "filter": "(ipv6.dst==${5g_nsa_uplane_ip} and gtp) and (data.len == 1222) and ip.dsfield.dscp == ${modified_dscp_value}",
        "eval": "count",
        "expected_result": "0",
        "tolerance": 0
    },
    "get_5g_teid": {
        "filter": "(ipv6.dst==${5g_nsa_uplane_ip} and gtp) and (sic.length==56026)",
        "eval": "getValue",
        "display_fields": "gtp.teid",
        "output_type": "fields",
        "tolerance": 0
    },
    "get_5g_teid_bkp": {
        "filter": "(ipv6.dst==${5g_nsa_uplane_ip} and gtp) and (data.len == 972)",
        "eval": "getValue",
        "display_fields": "gtp.teid",
        "output_type": "fields",
        "tolerance": 0
    },
    "verify_lte_teid": {
        "filter": "(s1ap) && (s1ap.gTP_TEID == 00:00:00:00)",
        "eval": "count",
        "expected_result": "2-*",
        "tolerance": 0
    },
    "verify_5g_cplane_dscp": {
        "filter_bkp": "ip.src==${5g_nsa_x2_cplane_ipv4} and ip.dsfield.dscp == ${modified_dscp_value}",
        "filter": "ip.addr == ${5g_x2c} && ip.dsfield.dscp == ${modified_dscp_value}",
        "eval": "count",
        "expected_result": "1-*",
        "tolerance": 0
    },
    "verify_5g_second_opt_uplane_dscp_org": {
        "filter_bkp": "(ipv6.src==${second_opt_uplane} and gtp) and ipv6.tclass.dscp == ${qci9_dscp}",
        "filter": "(ipv6.addr==${second_opt_uplane} and gtp)",
        "eval": "count",
        "expected_result": "1-*",
        "tolerance": 0
    },
    "verify_5g_second_opt_uplane_dscp": {
        "filter_bkp": "(ipv6.src==${second_opt_uplane} and gtp) and ipv6.tclass.dscp == ${qci9_dscp}",
        "filter": "(ipv6.addr==fc00::140 and gtp)",
        "eval": "count",
        "expected_result": "0",
        "tolerance": 0
    },
   "verify_uplink_traffic":{
        "filter": "ip.src==4.7.254.2 && gtp",
        "eval": "count",
        "expected_result": "1-*",
        "tolerance": 0
       },
    "verify_5g_nwslice_uplane_dscp_org": {
        "filter_bkp": "(ipv6.src==${qci129_nwslice_uplane1} and gtp) and ipv6.tclass.dscp == ${qci129_dscp}",
        "filter": "(ipv6.addr==${qci129_nwslice_uplane1} and gtp)",
        "eval": "count",
        "expected_result": "1-*",
        "tolerance": 0
    },
     "verify_call_setup_failure":{
        "filter": "ip.src==4.7.254.2 && gtp",
        "eval": "count",
        "expected_result": "0",
        "tolerance": 0
    },
     "verify_5g_multiple_nwslice_uplane_dscp": {
        "filter_bkp": "(ipv6.src==${qci_nwslice_uplane1} and gtp) and ipv6.tclass.dscp == ${qci_dscp}",
        "filter": "(gtp and ipv6.addr==${qci_nwslice_uplane1})",
        "eval": "count",
        "expected_result": "1-*",
        "tolerance": 0
    },
    "verify_5g_nwslice_uplane_dscp": {
        "filter_bkp": "(ipv6.src==${qci129_nwslice_uplane1} and gtp) and ipv6.tclass.dscp == ${qci129_dscp}",
        "filter": "(ipv6.addr==fc00::140 and gtp)",
        "eval": "count",
        "expected_result": "0",
        "tolerance": 0
    }

}
}