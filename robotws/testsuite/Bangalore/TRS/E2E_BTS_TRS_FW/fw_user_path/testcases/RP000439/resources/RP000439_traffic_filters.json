{
	"traffic_analysis":{
			"icmp_echo_request_dummy_server": {
				  "filter": "(ip.dst==100.100.100.100 && ip.src==${mplane_ip})",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
		"icmp_noecho_request_dummy_server": {
				  "filter": "(ip.dst==100.100.100.100 && ip.src==${mplane_ip})",
				  "eval": "count",
				  "expected_result": "0*",
				  "tolerance": 0
			},
		"icmp_noecho_response_dummy_server": {
				  "filter": "(ip.src==100.100.100.100 && ip.dst==${mplane_ip})",
				  "eval": "count",
				  "expected_result": "0",
				  "tolerance": 0
			},
			"no_icmp_echo_request_dummy_server": {
				  "filter": "(ip.src==100.100.100.100 && ip.dst==${mplane_ip})",
				  "eval": "count",
				  "expected_result": "0",
				  "tolerance": 0
			},
			"icmp_echo_response_dummy_server": {
				  "filter": "(icmp.type == 0 && ip.addr == 100.100.100.100)",
				  "eval": "count",
				  "expected_result": "0",
				  "tolerance": 0
			},
			"icmp_echo_request": {
				  "filter": "(ip.dst==${icmpServer} && ip.src==${mplane_ip})",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"icmp_echo_response": {
				  "filter": "(ip.src==${icmpServer} && ip.dst==${mplane_ip})",
				  "eval": "count",
				  "expected_result": "1-*",
				  "tolerance": 0
			},
			"verify_time_interval": {
				"filter": "(ip.dst==${dummyIp} && ip.src==${mplane_ip})",
				"eval": "getValue",
				"display_fields": "frame.time"
			}
			
  }
}
