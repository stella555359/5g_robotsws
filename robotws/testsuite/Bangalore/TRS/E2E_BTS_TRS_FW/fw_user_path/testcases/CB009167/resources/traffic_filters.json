{
    "traffic_analysis":
    {
	"sctp_e2ap_success":
        {
            "filter": "((sctp.srcport == ${e2SctpPort} || sctp.dstport == ${e2SctpPort}) && sctp.chunk_type == 0)",
            "eval": "count",
            "expected_result": "2-*",
            "tolerance": 0
        },
	"sctp_ipv6_e2ap_success":
        {
            "filter": "((sctp.srcport == ${e2SctpPort} || sctp.dstport == ${e2SctpPort}) && sctp.chunk_type == 0)",
            "eval": "count",
            "expected_result": "2-*",
            "tolerance": 0
        },
        "sctp_e2ap_success_ipsec":
        {
            "filter": "((sctp.srcport == ${e2SctpPort} || sctp.dstport == ${e2SctpPort}) && sctp.chunk_type == 0)",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        },
	"e2ap_esp":
        {
            "filter": "(ip.src == ${RIC_IPv4} && esp)",
            "eval": "count",
            "expected_result": "5-*",
            "tolerance": 0
        },
	"e2ap_noesp":
        {
            "filter": "(ip.src == ${RIC_IPv4} && esp)",
            "eval": "count",
            "expected_result": "0*",
            "tolerance": 0
        },
        "sctp_e2ap_Mod_DSCP":
        {
            "filter": "(sctp && ipv6.dst == ${RIC_IPv6} && ipv6.tclass.dscp == ${modified_cplane_DSCP})",
            "eval": "count",
            "expected_result": "1-*",
            "tolerance": 0
        }

    }
 }

