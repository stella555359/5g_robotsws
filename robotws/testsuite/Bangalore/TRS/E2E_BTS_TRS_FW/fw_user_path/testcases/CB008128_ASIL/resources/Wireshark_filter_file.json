{
    "traffic_analysis":{
		"isakmp_check_IPV4":{
                  "filter": "((isakmp) && (ip.src == ${local_tunnel_ip})) && (ip.dst == ${remote_tunnel_ip})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "no_isakmp_check_IPV4":{
                  "filter": "((isakmp) && (ip.src == ${local_tunnel_ip})) && (ip.dst == ${remote_tunnel_ip})",
                  "eval": "count",
                  "expected_result": "0",
                  "tolerance": 0
            },
			"Traffic_check_IPV6":{
                  "filter": "((ipv6.src == ${uplane_addr})) && (ip.src == ${PDN_IP})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
			"isakmp_check_IPV6":{
                  "filter": "((isakmp) && (ipv6.src == ${local_tunnel_ip})) && (ipv6.dst == ${remote_tunnel_ip})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "no_isakmp_check_IPV6":{
                  "filter": "((isakmp) && (ipv6.src == ${local_tunnel_ip})) && (ipv6.dst == ${remote_tunnel_ip})",
                  "eval": "count",
                  "expected_result": "0",
                  "tolerance": 0
            },
			"DNS_query":{
                  "filter": "(((dns.qry.name == \"${DNS_query_name}\") && (dns.qry.type == 28)) && (ipv6.src == ${src_ip})) && (ipv6.dst == ${dns_ip})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
			"DNS_response":{
                  "filter": "((dns.resp.name == \"${DNS_query_name}\") && (dns.aaaa == ${first_ip})) && (dns.aaaa == ${second_ip}) && (ipv6.dst == ${src_ip}) && (ipv6.src == ${dns_ip})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
			"no_DNS_response":{
                  "filter": "((dns.resp.name == \"${DNS_query_name}\") && (dns.aaaa == ${first_ip})) && (dns.aaaa == ${second_ip}) && (ipv6.dst == ${src_ip}) && (ipv6.src == ${dns_ip})",
                  "eval": "count",
                  "expected_result": "0",
                  "tolerance": 0
            },
			"invalid_fqdn_response":{
                  "filter": "(dns.resp.type == 6) && (ipv6.dst == ${src_ip}) && (ipv6.src == ${dns_ip})",
                  "eval": "count",
                  "expected_result": "1",
                  "tolerance": 0
            },
            "NGSetupRequest": {
                  "filter": "(ngap) && (ip.src == 10.0.1.2) && (ip.dst == 10.0.1.1)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "NGSetupResponse": {
                  "filter": "((ngap) && (ip.src == 10.0.1.1)) && (ip.dst == 10.0.1.2)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "GTP_Echo_request_IPv6": {
                  "filter": "(gtp.message == 0x01) && (ipv6.src == ${Uplane_addr}) && (ipv6.dst == ${Sgw_ip_addr})",
                  "eval": "count",
                  "expected_result": "2-*",
                  "tolerance": 0
            },
            "GTP_Echo_response_IPv6": {
                  "filter": "(gtp.message == 0x02) && (ipv6.dst == ${Uplane_addr}) && (ipv6.src == ${Sgw_ip_addr})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "call_drop_ipv4": {
                  "filter": "((s1ap.transport == 0) && (ip.src == ${Cplane_addr})) && (ip.dst == ${MME})",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
			"UL_Traffic_check":{
				  "filter": "((gtp) && (ip.src == 10.0.1.2) && (ip.dst == 10.0.1.133))",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "UL_Traffic_check1":{
                  "filter": "((gtp) && (ip.src == 10.0.1.2) && (ip.dst == 10.0.1.1))",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "Fragmented_UL_Traffic_check":{
                  "filter": "((ip.flags == 0x1) && (ip.src == 10.0.1.2) && (ip.dst == 10.0.1.133))",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "DL_Traffic_check":{
                  "filter": "((gtp) && (ip.src == 10.0.1.133) && (ip.dst == 10.0.1.2))",
                  "eval": "count",
                  "expected_result": "1-*", 
                  "tolerance": 0
            },
            "DL_Traffic_check1":{
                  "filter": "((gtp) && (ip.src == 10.0.1.1) && (ip.dst == 10.0.1.2))",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "Fragmented_DL_Traffic_check":{
                  "filter": "((ip.flags == 0x1) && (ip.src == 10.0.1.133) && (ip.dst == 10.0.1.2))",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "ESP":{
                  "filter": "(esp)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
			"No_Traffic":{
				  "filter": "((gtp) && (ip.src == ${uplane_addr})) && (ip.src == ${PDN_IP})",
                  "eval": "count",
                  "expected_result": "0",
                  "tolerance": 0
            }
}            
}

