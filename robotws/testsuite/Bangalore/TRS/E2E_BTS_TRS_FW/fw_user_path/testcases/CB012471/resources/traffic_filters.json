                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
         "verify_s1ap_MME_Configuration_Transfer": {
                  "filter": "((s1ap.transportLayerAddressIPv4 == ${lte_v4_cplane_ip_neigh}) && (s1ap.transportLayerAddressIPv6 == ${lte_v6_cplane_ip_neigh}))",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
