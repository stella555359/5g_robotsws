{
    "traffic_analysis":{
            "M3_Setup_Request": {
                  "filter": "(m3ap.M3AP_PDU == 0) && (m3ap.procedureCode == 7) && (ipv6.src == 2c00::2) && (ipv6.dst == 2c00::1)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "M3_Setup_Response": {
                  "filter": "(m3ap.M3AP_PDU == 1) && (m3ap.procedureCode == 7) && (ipv6.dst == 2c00::2) && (ipv6.src == 2c00::1)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "MBMS_Session_Start_Request": {
                  "filter": "(m3ap.M3AP_PDU == 0) && (m3ap.procedureCode == 0) && (ipv6.src == 2c00::1) && (ipv6.dst == 2c00::2)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "MBMS_Session_Start_Response": {
                  "filter": "(m3ap.M3AP_PDU == 1) && (m3ap.procedureCode == 0) && (ipv6.dst == 2c00::1) && (ipv6.src == 2c00::2)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0
            },
            "Multicast_Listener_Report_Message_v2": {
                  "filter": "(icmpv6.mldr.mar.multicast_address == ff3b::8000:1) && (icmpv6.mldr.mar.source_address == 2c00::5) && (icmpv6.mldr.mar.record_type == 3) or (icmpv6.mldr.mar.record_type == 5)",
                  "eval": "count",
                  "expected_result": "2-*",
                  "tolerance": 0
            },
	    "MBMS_synchronisation_protocol": {
                  "filter": "(gtp) && (ipv6.src==2c00::5) && (ipv6.dst==ff3b::8000:1) && (sync)",
                  "eval": "count",
                  "expected_result": "1-*",
                  "tolerance": 0

            }
    }            
