;
; BIND data file for local loopback interface
;
$TTL    604800
@       IN      SOA     deb-dns.olympians3.nsn.com.  root.olympians3.nsn.com. (
                              2         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
;@      IN      NS      localhost.
;@      IN      A       127.0.0.1
;@      IN      AAAA    ::1

;Name Server Information
@       IN      NS      deb-dns.olympians3.nsn.com.
;IP address of Name Server
deb-dns.olympians3.nsn.com.     IN      A       10.45.138.159

;A - Record HostName To Ip Address

www      IN       A     10.0.3.1
Www      IN       A     10.0.3.209
www2	IN	A	172.16.109.25
www3	IN	A	172.16.200.3
www1	IN	A	172.16.109.49
www     IN      A       10.10.10.10
mail     IN       A     10.10.10.10
mail	 IN	  A     172.16.248.1
gmail    IN       A     172.16.225.86
www    IN     AAAA    fc00::1
;www    IN      AAAA    fc00::2
;www    IN      AAAA    fc00::03

