import sys
from datetime import datetime
import csv
from tabulate import tabulate
import os
import fnmatch
import glob

def addTimeCount(matchKey, stringMatched, timeString):
    global startTime
    global counterIndex
    global startedTimeDone
    try:
        datetime.strptime(timeString, "%H:%M:%S")
    except Exception as e:
        return

    if not startedTimeDone:
        if (stringMatched):
            initialLogCount[matchKey] += 1
    else:
        if startTime == "":
            startTime = timeString
            counterTime.append(startTime)
        currentTime = timeString
        timeDelta = ((datetime.strptime(currentTime, "%H:%M:%S")) - (datetime.strptime(startTime, "%H:%M:%S"))).total_seconds()
        if timeDelta <0:
            timeDelta += 86400
        if (timeDelta >= counterInterval):
            counterIndex += 1
            startTime = timeString
            counterTime.append(startTime)
            for val in finalOut.values():
                val.append(0)
        if (stringMatched):
            finalOut[matchKey][counterIndex] = finalOut[matchKey][counterIndex] + 1


def findMatch(inputline):
    for matchString in matchList:
        if inputline.__contains__(matchString):
            addTimeCount(matchString, True, inputline.split(".")[0])
            return

    addTimeCount("", False, inputline.split(".")[0])


def printUsage():
    print ("Error: Usage: " + sys.argv[0] + " -u (yes/no) -c (sa/nsa) -p  <absolutePathOflogFile> \n" \
                                           "where -u option yes for egate_console.log file in default path /opt/wts/latest and no for egate_console.log in non-default path. -c option is sa or nsa. -p mandatory only for egate_console.log in non-default path ")
    exit(1)

############## Main starts here ###########
if (len(sys.argv) < 4):
    printUsage()

inputfilename = ""
ute = ""
counterInterval = 0
for i in range(1, len(sys.argv)):
    arg = sys.argv[i]
    if arg.lower() == "-u":
        ute = sys.argv[i + 1]
    elif arg.lower() == "-t":
        counterInterval = int(sys.argv[i + 1])
    elif arg.lower() == "-c":
        callType = sys.argv[i+1]
    elif arg.lower() == "-p":
        inputfilename = sys.argv[i + 1]
    i = i+2

if (ute == "" or callType == ""):
    printUsage()

if ute.lower() == "yes":
    inputfilename = "/opt/wts/latest/egate_console.log"
elif ute.lower() == "no":
    if inputfilename == "":
        print ('Require log path for non-UTE')
        printUsage()
else:
    print ('Wrong UTE parameter')
    printUsage()
print("Log path: " + inputfilename + ", time interval(s):" +  str(counterInterval))
print('Getting the summary. Please wait..')

###Initialization
startTime = ""
counterIndex = 0
counterTime = []
matchList_nsa = ["Sending RRC Connection Reconfiguration", "Sending SgNB Addition Request", "Successfully reconfigured dual connectivity", "Proxy (eNB 2 cell 1) reported successful RA", "Proxy (eNB 2 cell 2) reported successful RA", "Proxy (eNB 2 cell 3) reported successful RA", "Sending SgNB Modification Confirm", "RA_UNSPECIFIED", "RRC Transaction Timeout", "Received unsupported 'ErrorIndication'", "Intra-eNB handover", "scellidx:1", "scellidx:2", "scellidx:3", "scellidx:4", "scellidx:5", "scellidx:6"]
matchList_sa = ["Starting SUCI based Registration", "Sending RRC Connection Reconfiguration", "UE now in NG RM Registered state", "Registration complete", "Initial Context Setup Successful", "PDU SESSION ID-1 setup/reestablishment complete", "PDU Session Modification Request with PDU Session ID 1 handled successfully", "scellidx:1", "scellidx:2", "scellidx:3", "scellidx:4", "scellidx:5", "scellidx:6", "scellidx:7", "scellidx:8", "scellidx:9", "scellidx:10", "scellidx:11", "scellidx:12", "Adding QosFlow with QFI:2", "Adding QosFlow with QFI:3", "Deleting QosFlow with QFI:2", "Deleting QosFlow with QFI:3", "RA_UNSPECIFIED", "No message available for resend", "RRC Reject was received", "FAILURE SystemInfoConfigurationReq", "Wait Timer expired, retrying RRC CONNECTION", "T300 expiration: No response to RRCSetupRequest", "RAR Timer has expired", "CR Timer has expired", "RRC Transaction Timeout", "Received unsupported 'ErrorIndication'", "Unexpected proxy message 157", "Unexpected Registration Request", "Unexpected Registration Accept", "UE CONTEXT RELEASE REQUEST from GNB", "Can not start DL traffic - No Active PDU Session exist", "Pattern NOT Found", "IS IDLE", "Cannot create SM Context for PDU Session FSM", "Initial Context Setup Failure for UE", "exhausted attempts to delete UE", "SdapCtx did not exist for PDU session", "No response from proxy for CTRL_ADD_UE_NR", "No response from proxy for CTRL_CG_CONFIG", "No response from proxy for CTRL_ADD_MOD_RB", "No response from proxy for CTRL_ADD_MOB_RB", "PERFORM COMMAND ATTACH_UE_CAP in sequence", "PERFORM COMMAND UE_CMD_PDU_SETUP in sequence", "PERFORM COMMAND DATA_START_FIVEG in sequence", "PERFORM COMMAND DETACH in sequence", "Reauthentication procedure is complete", "Received optional Pdu Session Reactivation Status in Service Accept Message", "greedy global script hanged", "UE performed IM exit", "silent IM entry", "Authentication Procedure is failed", "NGKSI is already in use", "Unexpected Security Mode Command", "OnReceiveUeContextReleaseRequest", "OnReceiveErrorIndication", "Failure (code 10) while applying RRCReconfiguration message", "T3510 timer expired", "CONNECTING - 'data_start' command ignored", "CONNECTING::VOnCmdsCommand - command ignored", "Received RRC Release while in FIVE-GS-MM-REGISTERED state", "Received RRC Release while in FIVE-GS-MM-REGISTERED-INITIATED state", "amf_paging_start id=1 ue=", "establishmentCause mt-Access", "Received Service Request Message in UE with RAN UE NGAP ID", "PDU Session Reestablishment Request with PDU Session ID 1 recieved"]
startString = "attach_detach_complete_call_without_timer"
startString_2 = "attach_detach_with_state_transition_without_timer"
finalOut = {}
initialLogCount = {}

if callType.lower() == "sa":
    matchList = matchList_sa
elif callType.lower() == "nsa":
    matchList = matchList_nsa
elif callType.lower() == "":
    print ('Require call type. sa or nsa')
    printUsage()
else:
    print ('Wrong call type')
    printUsage()

##
for i in matchList:
    finalOut[i] = [0]
    initialLogCount[i] = 0

### Core Logic
for filename in glob.glob(inputfilename):
    inputfile = open(filename, "r")
    startedTimeDone = False
    while True:
        logline = inputfile.readline()
        if not logline:
            break
        elif not startedTimeDone and (logline.__contains__(startString) or logline.__contains__(startString_2)):
            startedTimeDone = True
            findMatch(logline)
        else:
            findMatch(logline)
    inputfile.close()

### Write output
outFileName = sys.argv[0] + "_" + callType.upper() + "_" + datetime.now().strftime("%Y%m%d_%H_%M_%S") + ".csv"
outFile = open(outFileName, "w")

## Print Output in table format
head=["Message Name", "Count"]
mydata = []
for message in finalOut.keys():
    mydata.append([message, initialLogCount[message] + sum(finalOut[message])])
print(tabulate(mydata, headers=head, tablefmt="grid"))

# Summary output
csv.writer(outFile).writerow(["Message Name", "Count"])
for message in finalOut.keys():
    csv.writer(outFile).writerow([message, initialLogCount[message] + sum(finalOut[message])])

csv.writer(outFile).writerow([])
csv.writer(outFile).writerow([])

# Detailed output
if startedTimeDone:
	csv.writer(outFile).writerow(["Start time"] + matchList)
	for i in range(0, len(counterTime)):
		temp = []
		for k in matchList:
			temp += [finalOut[k][i]]
		csv.writer(outFile).writerow([counterTime[i]] + temp)

outFile.close()
print('Successfully completed. Output can be checked in: ' + outFileName)

