<?xml version="1.1"?>
<!DOCTYPE format PUBLIC "-//prisma//DTD Format 2.0//EN" "http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/dtd/xmlFormat-2.dtd">
<?xml-stylesheet type="text/xsl" href="http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/xsl/htmlFormat.xsl"?>

<format name="NrPucch" show="NR PUCCH Test" version="1.0">
    <group name="NrPucch" show="NR PUCCH Info" priority="250">
        <integer name="Version" show="Version" writable="false" default="1" cformat="uint32"> </integer>
        <integer name="TestType" show="Test Type" writable="false" default="259" cformat="uint32"> </integer>
        <integer name="rnti" show="RNTI" writable="true" default="200" min="1" max="65535" step="0" cformat="uint32"> </integer>
        <enum name="pucchFormat" show="Pucch Format" default="0" cformat="uint32">
            <option value="0">Format 0</option>
            <option value="1">Format 1</option>
            <option value="2">Format 2</option>
            <option value="3">Format 3</option>
        </enum>
        <integer name="startRB" show="Start RB (1st hop)" writable="true" default="0" min="0" max="272" step="0" cformat="uint32"> </integer>
        <integer name="startRB2ndHop" show="Start RB (2nd hop)" writable="true" default="0" min="0" max="272" step="0" cformat="uint32"> </integer>
        <integer name="nRB" show="Number of RB" writable="true" default="1" min="1" max="16" step="0" cformat="uint32"> </integer>
        <integer name="ncid" show="Hopping Id" writable="true" default="0" min="0" max="65535" step="0" cformat="uint32"> </integer>
        <integer name="m0" show="PUCCH-F0-F1-initial-cyclic-shift" writable="true" default="0" min="0" max="11" step="0" cformat="uint32"> </integer>
        <enum name="grpHop" show="Group hopping" default="0" cformat="uint32">
            <option value="0">Neither</option>
            <option value="1">Enabled</option>
            <option value="2">Disabled</option>
        </enum>
        <integer name="nSymb" show="Number of symbols" writable="true" default="1" min="1" max="14" step="0" cformat="uint32"> </integer>
        <integer name="startSymb" show="Starting symbol" writable="true" default="0" min="0" max="13" step="0" cformat="uint32"> </integer>
        <integer name="occIdxF1" show="PUCCH-F1-time-domain-OCC" writable="true" default="0" min="0" max="6" step="0" cformat="uint32"> </integer>
        <enum name="intraHopEn" show="Intra-slot hopping" default="0" cformat="uint32">
            <option value="0">Disabled</option>
            <option value="1">Enabled</option>
        </enum>
        <enum name="f3f4qm" show="Format 3/4 modulation" default="0" cformat="uint32">
            <option value="0">pi/2-BPSK</option>
            <option value="1">QPSK</option>
        </enum>
        <enum name="f3f4AddDmrs" show="Format 3/4 additional DMRS" default="0" cformat="uint32">
            <option value="0">No</option>
            <option value="1">Yes</option>
        </enum>
        <integer name="scid" show="Data scrambling id" writable="true" default="0" min="0" max="65535" step="0" cformat="uint32"> </integer>
        <bitfield name="ackNackBitmap" show="Ack/Nack bitmap" format="%016x" bits="16" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
            Ack/Nack bitmap to be sent on selected slots
            <bit index="10" show="bit 10"/>
            <bit index="9" show="bit 9"/>
            <bit index="8" show="bit 8"/>
            <bit index="7" show="bit 7"/>
            <bit index="6" show="bit 6"/>
            <bit index="5" show="bit 5"/>
            <bit index="4" show="bit 4"/>
            <bit index="3" show="bit 3"/>
            <bit index="2" show="bit 2"/>
            <bit index="1" show="bit 1"/>
            <bit index="0" show="bit 0"/>
        </bitfield>
        <integer name="ackNackLen" show="Number of ack/nack to report" writable="true" default="0" min="0" max="11" step="0" cformat="uint32"> </integer>
        <integer name="sr" show="Scheduling request" writable="true" default="0" min="0" max="1" step="0" cformat="uint32"> </integer>
        <enum name="srOnOff" show="Report scheduling request" default="0" cformat="uint32">
            <option value="0">No</option>
            <option value="1">Yes</option>
        </enum>
        <bitfield name="slotsMap1" show="Tx slots (0..63)" format="%016x" bits="64" default="0000000000000001" writable="true" exportable="false" null="false" index="false" cformat="uint64">
            Slots for transmitting PUCCH
            <bit index="63" show="slot 63"/>
            <bit index="62" show="slot 62"/>
            <bit index="61" show="slot 61"/>
            <bit index="60" show="slot 60"/>
            <bit index="59" show="slot 59"/>
            <bit index="58" show="slot 58"/>
            <bit index="57" show="slot 57"/>
            <bit index="56" show="slot 56"/>
            <bit index="55" show="slot 55"/>
            <bit index="54" show="slot 54"/>
            <bit index="53" show="slot 53"/>
            <bit index="52" show="slot 52"/>
            <bit index="51" show="slot 51"/>
            <bit index="50" show="slot 50"/>
            <bit index="49" show="slot 49"/>
            <bit index="48" show="slot 48"/>
            <bit index="47" show="slot 47"/>
            <bit index="46" show="slot 46"/>
            <bit index="45" show="slot 45"/>
            <bit index="44" show="slot 44"/>
            <bit index="43" show="slot 43"/>
            <bit index="42" show="slot 42"/>
            <bit index="41" show="slot 41"/>
            <bit index="40" show="slot 40"/>
            <bit index="39" show="slot 39"/>
            <bit index="38" show="slot 38"/>
            <bit index="37" show="slot 37"/>
            <bit index="36" show="slot 36"/>
            <bit index="35" show="slot 35"/>
            <bit index="34" show="slot 34"/>
            <bit index="33" show="slot 33"/>
            <bit index="32" show="slot 32"/>
            <bit index="31" show="slot 31"/>
            <bit index="30" show="slot 30"/>
            <bit index="29" show="slot 29"/>
            <bit index="28" show="slot 28"/>
            <bit index="27" show="slot 27"/>
            <bit index="26" show="slot 26"/>
            <bit index="25" show="slot 25"/>
            <bit index="24" show="slot 24"/>
            <bit index="23" show="slot 23"/>
            <bit index="22" show="slot 22"/>
            <bit index="21" show="slot 21"/>
            <bit index="20" show="slot 20"/>
            <bit index="19" show="slot 19"/>
            <bit index="18" show="slot 18"/>
            <bit index="17" show="slot 17"/>
            <bit index="16" show="slot 16"/>
            <bit index="15" show="slot 15"/>
            <bit index="14" show="slot 14"/>
            <bit index="13" show="slot 13"/>
            <bit index="12" show="slot 12"/>
            <bit index="11" show="slot 11"/>
            <bit index="10" show="slot 10"/>
            <bit index="9" show="slot 9"/>
            <bit index="8" show="slot 8"/>
            <bit index="7" show="slot 7"/>
            <bit index="6" show="slot 6"/>
            <bit index="5" show="slot 5"/>
            <bit index="4" show="slot 4"/>
            <bit index="3" show="slot 3"/>
            <bit index="2" show="slot 2"/>
            <bit index="1" show="slot 1"/>
            <bit index="0" show="slot 0"/>
        </bitfield>
        <bitfield name="slotsMap2" show="Tx slots (64..79)" format="%016x" bits="16" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
            Slots for transmitting PUCCH
            <bit index="15" show="slot 79"/>
            <bit index="14" show="slot 78"/>
            <bit index="13" show="slot 77"/>
            <bit index="12" show="slot 76"/>
            <bit index="11" show="slot 75"/>
            <bit index="10" show="slot 74"/>
            <bit index="9" show="slot 73"/>
            <bit index="8" show="slot 72"/>
            <bit index="7" show="slot 71"/>
            <bit index="6" show="slot 70"/>
            <bit index="5" show="slot 69"/>
            <bit index="4" show="slot 68"/>
            <bit index="3" show="slot 67"/>
            <bit index="2" show="slot 66"/>
            <bit index="1" show="slot 65"/>
            <bit index="0" show="slot 64"/>
        </bitfield>
    </group>
</format>


