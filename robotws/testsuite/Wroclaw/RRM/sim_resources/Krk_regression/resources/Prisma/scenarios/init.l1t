    <bitfield name="ssb-PositionsInBurst6GhzE" show="SSB Position in Burst" format="%016x" bits="64" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
        Time domain positions of the transmitted SS-blocks in an SS-Burst-Set
        <bit index="63" show="s=492"/>
        <bit index="62" show="s=488"/>
