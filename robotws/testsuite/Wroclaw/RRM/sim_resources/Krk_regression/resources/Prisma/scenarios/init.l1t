<?xml version="1.1"?>
<!DOCTYPE format PUBLIC "-//prisma//DTD Format 2.0//EN" "http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/dtd/xmlFormat-2.dtd">
<?xml-stylesheet type="text/xsl" href="http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/xsl/htmlFormat.xsl"?>

<format name="InitL1TestDb" version="1.0">
  <group name="InitL1TestDb" show="Init L1 Test Properties" priority="250">
	  
    <integer name="Version" show="Version" writable="false" default="10" min="1" max="2147483647" step="0" cformat="uint32">
        Test version
    </integer>

    <integer name="testType" show="Test Type" writable="false" default="1" min="1" max="2147483647" step="0" cformat="uint32">
        Test type
    </integer>
    
    <enum name="RFfrequency" show="RF frequency" cformat="uint32">
        Radio frequency (f)
        <option value="0">Below 3 Ghz</option>
        <option value="1">Below 6 Ghz</option>
        <option value="2">Above 6 Ghz</option>
        <dependence group="GBelow3Ghz" values="Below 3 Ghz" enable="true" />
        <dependence group="GBelow3Ghz" values="Below 6 Ghz,Above 6 Ghz" enable="false" />
        <dependence group="GBelow6Ghz" values="Below 6 Ghz" enable="true" />
        <dependence group="GBelow6Ghz" values="Below 3 Ghz,Above 6 Ghz" enable="false" />
        <dependence group="GAbove6Ghz" values="Above 6 Ghz" enable="true" />
        <dependence group="GAbove6Ghz" values="Below 3 Ghz,Below 6 Ghz" enable="false" />
    </enum>

    <enum name="ssb-Periodicity" show="SSB Periodicity" cformat="uint32">
        The SSB periodicity in msec for the rate matching purpose
        <option value="0">ms5</option>
        <option value="1">ms10</option>
        <option value="2">ms20</option>
        <option value="3">ms40</option>
        <option value="4">ms80</option>
        <option value="5">ms160</option>
    </enum>

    <enum name="DlSubcarrierSpacing" show="Downlink Subcarrier Spacing" cformat="uint32">
        Subcarrier spacing (numerology) for DL data and control channels
        <option value="0">kHz15</option>
        <option value="1">kHz30</option>
        <option value="2">kHz60</option>
        <option value="3">kHz120</option>
        <option value="4">kHz240</option>
    </enum>

    <enum name="UlSubcarrierSpacing" show="Uplink Subcarrier Spacing" cformat="uint32">
        Subcarrier spacing (numerology) for UL data and control channels
        <option value="0">kHz15</option>
        <option value="1">kHz30</option>
        <option value="2">kHz60</option>
        <option value="3">kHz120</option>
        <option value="4">kHz240</option>
    </enum>

    <integer name="SignalOffThreshold" show="Signal SNR Threshold in dB" writable="true" default="0" min="-5" max="50" step="0" cformat="int32">
        Signal SNR target in dB (if the SNR is lower than this threshold the cell is declared out of sync)

    </integer>
        <integer name="rootSequenceIndex" show="rootSequenceIndex" writable="true" default="1" min="0" max="138" step="0" cformat="uint32">
        Zadoff-Chu Root of the first preamble in the ordered set of PRACH preambles available per cell
    </integer>
    <integer name="prach-ConfigIndex" show="prach-ConfigIndex" writable="true" default="0" min="0" max="255" step="0" cformat="uint32"> </integer>
    <integer name="prach-FreqOffset" show="prach-FreqOffset" writable="true" default="0" min="0" max="261" step="0" cformat="uint32"> 
        Frequency offset of lowest PRACH transmission occasion in frequency domain with respect to PRB 0 of the initial active uplink bandwidth part
    </integer>
    <integer name="zeroCorrelationZoneConfig" show="ZeroCorrelationZoneConfig" writable="true" default="0" min="0" max="15" step="0" cformat="uint32">
        A map to a specified subset of Cyclic Shift Offsets
    </integer>

  </group>
   
  <group name="CSI-RS" show="CSI-RS information" priority="250">
  
    <enum name="csiRsOn" show="CSI-RS enable" cformat="uint32">
        <option value="0">OFF</option>
        <option value="1">ON (Tracking)</option>
    </enum>

    <integer name="ScramblingID" show="Scrambling ID" writable="true" min="0" max="1024" step="0" cformat="uint32"> </integer>

    <enum name="TimeConfigPeriodicy" show="Periodicity (Xp)" cformat="uint32">
        <option value="0">slots10</option>
        <option value="1">slots20</option>
        <option value="2">slots40</option>
        <option value="3">slots80</option>
    </enum>
    
    <integer name="TimeConfigOffset" show="Slot Offset" writable="true" default="0" min="0" max="79" step="0" cformat="uint32"> </integer>
    
    <bitfield name="timeAllocations" show="Symbol position in slot" format="%08x" bits="14" default="00000110" writable="true" exportable="false" null="false" index="false" cformat="uint32">
        (please choose 2 symbols according to 38.214)
        <bit index="13" show="symb 13"/>
        <bit index="12" show="symb 12"/>
        <bit index="11" show="symb 11"/>
        <bit index="10" show="symb 10"/>
        <bit index="9" show="symb 9"/>
        <bit index="8" show="symb 8"/>
        <bit index="7" show="symb 7"/>
        <bit index="6" show="symb 6"/>
        <bit index="5" show="symb 5"/>
        <bit index="4" show="symb 4"/>
        <bit index="3" show="symb 3"/>
        <bit index="2" show="symb 2"/>
        <bit index="1" show="symb 1"/>
        <bit index="0" show="symb 0"/>
    </bitfield>
    
    <integer name="startRB" show="Starting RB" writable="true" default="0" min="0" max="221" step="0" cformat="uint32"> </integer>
    <integer name="nRB" show="Allocated RB" writable="true" default="52" min="52" max="273" step="0" cformat="uint32"> </integer>    
    
    <enum name="Density" show="density p" writable="false" default="3" cformat="uint32">
        (default is 3 for TRS)
        <option value="0">0.5 even</option>
        <option value="1">0.5 odd</option>
        <option value="2">1</option>
        <option value="3">3</option>
    </enum>    
    
    <integer name="FreqOff" show="Frequency Offset (RE)" writable="true" default="3" min="0" max="12" step="0" cformat="uint32"> </integer>
  
    <enum name="cdmType" show="cdmType" writable="false" default="0" cformat="uint32">
        (only NoCDM is supported)
        <option value="0">NoCDM</option>
        <option value="1">FD-CDM2</option>
        <option value="2">CDM4</option>
        <option value="3">CDM8</option>
    </enum>    
  
    <enum name="NrofPorts" show="Number of Ports" writable="false" default="0" cformat="uint32">
        <option value="0">1</option>
        <option value="1">2</option>
        <option value="2">4</option>
        <option value="3">8</option>
        <option value="4">12</option>
        <option value="5">16</option>
        <option value="6">24</option>
        <option value="7">32</option>
    </enum>      
    
    <integer name="powerControlOffsetPdsch" show="PowerControl Offset Pc (db)" writable="true" default="0" min="-8" max="15" step="0" cformat="int32"> 
    Power Offset between NZP CSI-RS and PDSCH (-8..15)
    </integer>
    
    <integer name="powerControlOffsetSs" show="PowerControl Offset Pc_SS (db)" writable="true" default="0" min="-3" max="6" step="3" cformat="int32"> 
    Power Offset between NZP CSI-RS and SS (-3,0,3,6)
    </integer>
    
  
  </group>  
  
  <group name="TDDcfg" show="TDD UL/DL configuration" priority="250">
    <enum name="refSbcSpacing" show="Reference Subcarrier Spacing" cformat="uint32">
        Reference subcarrier spacing (numerology)
        <option value="0">kHz15</option>
        <option value="1">kHz30</option>
        <option value="2">kHz60</option>
        <option value="3">kHz120</option>
    </enum>
    <enum name="dlUlPeriod" show="DL/UL transmission periodicity" default="0" cformat="uint32">
        <option value="0">0.5 ms</option>
        <option value="1">0.625 ms</option>
        <option value="2">1.0 ms</option>
        <option value="3">1.25 ms</option>
        <option value="4">2.0 ms</option>
        <option value="5">2.5 ms</option>
        <option value="6">5.0 ms</option>
        <option value="7">10.0 ms</option>
    </enum>  
    <integer name="nDlSlots" show="Number of DL slots" writable="true" default="1" min="0" max="80" step="0" cformat="uint32"> 
        Number of consecutive full DL slots at the beginning of each DL-UL pattern
    </integer>
    <integer name="nDlSymb" show="Number of DL symbols" writable="true" default="1" min="0" max="13" step="0" cformat="uint32"> 
        Number of consecutive DL symbols in the beginning of the slot following the last full DL slot
    </integer>
    <integer name="nUlSlots" show="Number of UL slots" writable="true" default="1" min="0" max="80" step="0" cformat="uint32"> 
        Number of consecutive full UL slots at the end of each DL-UL pattern
    </integer>
    <integer name="nUlSymb" show="Number of UL symbols" writable="true" default="1" min="0" max="13" step="0" cformat="uint32"> 
        Number of consecutive UL symbols in the end of the slot preceding the first full UL slot
    </integer>
  </group> 
  <group name="TDDcfg2" show="TDD UL/DL configuration 2" priority="250">
    <enum name="isTddCfg2" show="TDD config 2" default="0" cformat="uint32">
        <option value="0">Off</option>
        <option value="1">On</option>
        <dependence property="dlUlPeriod2" values="Off" enable="false" />
        <dependence property="dlUlPeriod2" values="On" enable="true" />
        <dependence property="nDlSlots2" values="Off" enable="false" />
        <dependence property="nDlSlots2" values="On" enable="true" />
        <dependence property="nDlSymb2" values="Off" enable="false" />
        <dependence property="nDlSymb2" values="On" enable="true" />
        <dependence property="nUlSlots2" values="Off" enable="false" />
        <dependence property="nUlSlots2" values="On" enable="true" />
        <dependence property="nUlSymb2" values="Off" enable="false" />
        <dependence property="nUlSymb2" values="On" enable="true" />
    </enum>  
    <enum name="dlUlPeriod2" show="DL/UL transmission periodicity" default="0" enable="false" cformat="uint32">
        <option value="0">0.5 ms</option>
        <option value="1">0.625 ms</option>
        <option value="2">1.0 ms</option>
        <option value="3">1.25 ms</option>
        <option value="4">2.0 ms</option>
        <option value="5">2.5 ms</option>
        <option value="6">5.0 ms</option>
        <option value="7">10.0 ms</option>
    </enum>  
    <integer name="nDlSlots2" show="Number of DL slots" writable="true" default="1" min="0" max="80" step="0" enable="false" cformat="uint32"> 
        Number of consecutive full DL slots at the beginning of each DL-UL pattern
    </integer>
    <integer name="nDlSymb2" show="Number of DL symbols" writable="true" default="1" min="0" max="13" step="0" enable="false" cformat="uint32"> 
        Number of consecutive DL symbols in the beginning of the slot following the last full DL slot
    </integer>
    <integer name="nUlSlots2" show="Number of UL slots" writable="true" default="1" min="0" max="80" step="0" enable="false" cformat="uint32"> 
        Number of consecutive full UL slots at the end of each DL-UL pattern
    </integer>
    <integer name="nUlSymb2" show="Number of UL symbols" writable="true" default="1" min="0" max="13" step="0" enable="false" cformat="uint32"> 
        Number of consecutive UL symbols in the end of the slot preceding the first full UL slot
    </integer>
  </group> 
   
  <group name="GBelow3Ghz" show="Below 3 Ghz" priority="250">
    <enum name="SubcarrierSpacing-3Ghz" show="SSB subcarrier spacing" cformat="uint32">
        Subcarrier spacing of SS/PBCH blocks 
        <option value="0">Case A - 15kHz</option>
        <option value="1">Case B - 30kHz</option>
        <option value="2">Case C - 30kHz</option>
        <dependence property="ssb-PositionsInBurst-3GhzA" values="Case A - 15kHz" enable="true" />
        <dependence property="ssb-PositionsInBurst-3GhzA" values="Case B - 30kHz,Case C - 30kHz" enable="false" />
        <dependence property="ssb-PositionsInBurst-3GhzB" values="Case B - 30kHz" enable="true" />
        <dependence property="ssb-PositionsInBurst-3GhzB" values="Case A - 15kHz,Case C - 30kHz" enable="false" />
        <dependence property="ssb-PositionsInBurst-3GhzC" values="Case C - 30kHz" enable="true" />
        <dependence property="ssb-PositionsInBurst-3GhzC" values="Case A - 15kHz,Case B - 30kHz" enable="false" />
    </enum>
	  
    <bitfield name="ssb-PositionsInBurst-3GhzA" show="SSB Position in Burst" format="%016x" bits="4" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
        Time domain positions of the transmitted SS-blocks in an SS-Burst-Set
        <bit index="3" show="s=22"/>
        <bit index="2" show="s=16"/>
        <bit index="1" show="s=8"/>
        <bit index="0" show="s=2"/>
    </bitfield>
    <bitfield name="ssb-PositionsInBurst-3GhzB" show="SSB Position in Burst" format="%016x" bits="4" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
        Time domain positions of the transmitted SS-blocks in an SS-Burst-Set
        <bit index="3" show="s=20"/>
        <bit index="2" show="s=16"/>
        <bit index="1" show="s=8"/>
        <bit index="0" show="s=4"/>
    </bitfield>
    <bitfield name="ssb-PositionsInBurst-3GhzC" show="SSB Position in Burst" format="%016x" bits="4" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
        Time domain positions of the transmitted SS-blocks in an SS-Burst-Set
        <bit index="3" show="s=22"/>
        <bit index="2" show="s=16"/>
        <bit index="1" show="s=8"/>
        <bit index="0" show="s=2"/>
    </bitfield>
  </group>
  
  <group name="GBelow6Ghz" show="Below 6 Ghz" priority="250">
    <enum name="SubcarrierSpacing-6Ghz" show="SSB subcarrier spacing" cformat="uint32">
        Subcarrier spacing of SS/PBCH blocks 
        <option value="0">Case A - 15kHz</option>
        <option value="1">Case B - 30kHz</option>
        <option value="2">Case C - 30kHz</option>
        <dependence property="ssb-PositionsInBurst-6GhzA" values="Case A - 15kHz" enable="true" />
        <dependence property="ssb-PositionsInBurst-6GhzA" values="Case B - 30kHz,Case C - 30kHz" enable="false" />
        <dependence property="ssb-PositionsInBurst-6GhzB" values="Case B - 30kHz" enable="true" />
        <dependence property="ssb-PositionsInBurst-6GhzB" values="Case A - 15kHz,Case C - 30kHz" enable="false" />
        <dependence property="ssb-PositionsInBurst-6GhzC" values="Case C - 30kHz" enable="true" />
        <dependence property="ssb-PositionsInBurst-6GhzC" values="Case A - 15kHz,Case B - 30kHz" enable="false" />
    </enum>
	  
    <bitfield name="ssb-PositionsInBurst-6GhzA" show="SSB Position in Burst" format="%016x" bits="8" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
        Time domain positions of the transmitted SS-blocks in an SS-Burst-Set
        <bit index="7" show="s=50"/>
        <bit index="6" show="s=44"/>
        <bit index="5" show="s=36"/>
        <bit index="4" show="s=30"/>
        <bit index="3" show="s=22"/>
        <bit index="2" show="s=16"/>
        <bit index="1" show="s=8"/>
        <bit index="0" show="s=2"/>
    </bitfield>
    <bitfield name="ssb-PositionsInBurst-6GhzB" show="SSB Position in Burst" format="%016x" bits="8" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
        Time domain positions of the transmitted SS-blocks in an SS-Burst-Set
        <bit index="7" show="s=48"/>
        <bit index="6" show="s=44"/>
        <bit index="5" show="s=36"/>
        <bit index="4" show="s=32"/>
        <bit index="3" show="s=20"/>
        <bit index="2" show="s=16"/>
        <bit index="1" show="s=8"/>
        <bit index="0" show="s=4"/>
    </bitfield>
    <bitfield name="ssb-PositionsInBurst-6GhzC" show="SSB Position in Burst" format="%016x" bits="8" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
        Time domain positions of the transmitted SS-blocks in an SS-Burst-Set
        <bit index="7" show="s=50"/>
        <bit index="6" show="s=44"/>
        <bit index="5" show="s=36"/>
        <bit index="4" show="s=30"/>
        <bit index="3" show="s=22"/>
        <bit index="2" show="s=16"/>
        <bit index="1" show="s=8"/>
        <bit index="0" show="s=2"/>
    </bitfield>
  </group>

  <group name="GAbove6Ghz" show="Above 6 Ghz" priority="250">
    <enum name="SubcarrierSpacing6Ghz" show="SSB subcarrier spacing" cformat="uint32">
        Subcarrier spacing of SS/PBCH blocks 
        <option value="3">Case D - 120kHz</option>
        <option value="4">Case E - 240kHz</option>
        <dependence property="ssb-PositionsInBurst6GhzD" values="Case D - 120kHz" enable="true" />
        <dependence property="ssb-PositionsInBurst6GhzD" values="Case E - 240kHz" enable="false" />
        <dependence property="ssb-PositionsInBurst6GhzE" values="Case E - 240kHz" enable="true" />
        <dependence property="ssb-PositionsInBurst6GhzE" values="Case D - 120kHz" enable="false" />
    </enum>
	  
    <bitfield name="ssb-PositionsInBurst6GhzD" show="SSB Position in Burst" format="%016x" bits="64" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
        Time domain positions of the transmitted SS-blocks in an SS-Burst-Set
        <bit index="63" show="s=524"/>
        <bit index="62" show="s=520"/>
        <bit index="61" show="s=512"/>
        <bit index="60" show="s=508"/>
        <bit index="59" show="s=496"/>
