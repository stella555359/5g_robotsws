{
  "name": "5G_sysinfo_filterset",
  "description": "Syslog filter",
  "domain": "Syslog",
  "algorithm": "syslog-filter-analyzer",
  "tags": [],
  "rule": {
    "result_label": "Common",
    "filters": [
      {
        "name": "SET159",
        "description": "Runtime - Cell Availability issues",
        "regex_pattern": "192\\.168\\.255.*(Detector (6253|6256).* active|CellSetupFailed|ERR\\/RROM.*(timer expired|Received timeout)|Detector 1868 Radio.*CELL.* active|Detector 4261.*CELL.* active|operation\\: cellDeletion|CellDriver.*availability.*Online to)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET163",
        "description": "Runtime - RACH problems",
        "regex_pattern": "192\\.168\\.255.*(RAP msg3.*failed|RachReceiver.*Timer expired for preamble|handleRaFailure.*raState.*dl_awaitMsg3)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 100,
          "verdict": "warning"
        }
      }
    ]
  }
}
