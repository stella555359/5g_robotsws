namespace tempestFlat;
/* coments are 3 slashes, for doxygen, as Slawek say, doxygen see only those in fbs
 */
/// \brief Tempest configuration flatbuffer schema.
table Configuration {
    tempSensorHwInfo: [TempConfigHwInfo];      /*! Tempest configuration */
 }

root_type Configuration;


/// \brief Temperature sensor configuration
table TempConfigHwInfo {
    /// \brief sensor name i.e antenna1:trx
    sensorName:string;
    /// \brief virtual sensor name for TCS purpose only 
    virtualSensorName:[string];
    /// \brief type of hw sensor one of: lm75, file,amc7812, ucd90xxx,lmp92066
    sensorType:string;
    /// \brief group name for TCS
    sensorGroup:string;
    /// \brief offset used if needed temperature point is not direct on sensor
    tempOffset:float;
    /// \brief bus path i.e. /dev/i2c_2
    hwBusId:string;
    /// \brief device address on bus
    deviceAddress:uint;
    /// \brief TCS flag if sensor have to be taken in account
    omittedInTCS:bool = false;
    /// \brief resolution of sensor i.e. 0.125
    maxResolutions:float;
    /// \brief Maximum number performed measurements for sensor
    maxMeasurements:uint;
    /// \brief register address on chip for temperature read
    regAddressOnChip:uint;
    /// \brief time out for single measurement.
    maxSingleMeasuremntTimeOutMs:uint;
    /// \brief time how long procedure of temperature calculation take.
    measurementIntervalOffset:uint;
    /// \brief minimum range temperature.
    tMin:float;
    /// \brief maximum range temperature.
    tMax:float;
    /// \brief name of hlapi object class.
    statusHoName:string;
}


    

