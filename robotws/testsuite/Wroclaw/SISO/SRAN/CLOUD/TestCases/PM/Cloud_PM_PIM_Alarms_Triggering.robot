    vDU Wait For Expected Operational State  vdu_state_value=onAir
    Wait Until All Cells Are OnAir
    ...  cells_count=${cells_count}
    ...  timeout=${VDU_PIMC_ALARMS_CELLS_ONAIR_TIMEOUT}
    Log  ${info_prefix}All cells are OnAir  console=${log_to_console}
    ${vcu_alarms}  ${vdu_alarms}=  Get All Active Alarms  vdu_login=False
    Check Active Alarms  allowed_alarms=${VDU_ALLOWED_ALARMS}  active_alarms=${vdu_alarms}
    ...  source=vDU  log_prefix=${info_prefix}  log_to_console=False
    Check Active Alarms  allowed_alarms=${VCU_ALLOWED_ALARMS}  active_alarms=${vcu_alarms}
    ...  source=vCU  log_prefix=${info_prefix}  log_to_console=False
    Log  ${info_prefix}Active allowed alarms checked (vDU, VCU)  console=${log_to_console}
    Log  ${done_prefix_green}Step 7: Disable PIM Cancellation feature  console=${log_to_console}

