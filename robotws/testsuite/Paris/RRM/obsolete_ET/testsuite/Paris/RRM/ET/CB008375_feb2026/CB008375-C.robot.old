#vbo#debug#       >> temporarily commented out so as not to execute the corresponding debugging command
#vbo#n/a#         > code not applicable in case of ... or code not used

# Libraries

# Resources
Resource                              ./resources/robot/CB008375-C-Keywords.robot

# Tags
#vbo#n/a#Force Tags                   CA_5G_SW_FR-Villarceaux    RRM    PY39    CONFIGURED    5G_RAN    RAN_5G

# Suites
Suite Setup                           Suite Setup Common Private    keep_all_data_in_file=${True}
Suite Teardown                        Suite Teardown
Test Teardown                         Test Teardown Common Private

*** Variables ***
# tests settings
&{CB008375_basic}                     capture_duration=0            # capture duration during traffic starting phase
...                                   deviation=10                  # default deviation for throughput and double for uplink
...                                   dir=DL+UL                     # direction for supported traffic
...                                   duration=3                    # traffic duration during declaration phase
...                                   pm_waiting_period=1           # number of waiting periods added for observation
...                                   target_gnb=2                  # gnb target id
...                                   test_name=TC_CB008375_SA
...                                   total_nb_cell=4               # total number of cell used for ue's dispatching
...                                   total_nb_ue=4                 # total number of ue's to configure

# ue's settings # configuration
&{dict_settings_ue_1}                 ue_id=1                       # FIRST_SA_UE_ID TDD cell 1 or ${Dict_1st_SA_UE_Id[NRCELL-1]}
...                                   original_cell=1               # original cell for call establishment
...                                   throughput=5                  # dl throughput nonGBR
...                                   throughput_ul=2               # ul throughput nonGBR

&{dict_settings_ue_2}                 ue_id=21                      # FIRST_SA_UE_ID TDD cell 2
...                                   original_cell=2               # original cell for call establishment
...                                   throughput=5                  # dl throughput nonGBR
...                                   throughput_ul=2               # ul throughput nonGBR

&{dict_settings_ue_3}                 ue_id=51                      # FIRST_SA_UE_ID FDD cell 3
...                                   original_cell=3               # original cell for call establishment
...                                   throughput=5                  # dl throughput nonGBR
...                                   throughput_ul=2               # ul throughput nonGBR

&{dict_settings_ue_4}                 ue_id=71                      # FIRST_SA_UE_ID FDD cell 4
...                                   original_cell=4               # original cell for call establishment
...                                   throughput=5                  # dl throughput nonGBR
...                                   throughput_ul=2               # ul throughput nonGBR

@{dict_settings_basic}                ${dict_settings_ue_1}    ${dict_settings_ue_2}    ${dict_settings_ue_3}    ${dict_settings_ue_4}
# --------------------------------------------------------------------------------------------------------------------------------------------------
*** Test Cases ***
[1] CB008375-SR-C_5_DU_SA_Fault_visibility_due_to_critical_failure
    #vbo#n/a#[Tags]    CLOUD_5G_I_LO_AP_LO    VARIANT_SANSA_FS_CPRI_CMWV_FDD+ECPRI_CMWV_TDD_AEQE_GMC    SBTS00
    #vbo#n/a#[Tags]    CLOUD_5GC_dRNIC_1vDU_P_AP_LOO_DC    VARIANT_SANSA_FS_CPRI_CMWV_FDD+ECPRI_CMWV_TDD    vDUCNF00

    #vbo#n/a#Setup.Apply Custom Config      vcu_scfc=${EMPTY}
    #vbo#n/a#...                      scfc=${EMPTY}
    #vbo#n/a#...                      iphy=${EMPTY}
    #vbo#n/a#...                      cfg=${EMPTY}
    #vbo#n/a#...                      rad_params=${EMPTY}
    #vbo#n/a#...                      vendor_params=${EMPTY}
    Dated Log                         ----Test initialization-------------------------------------------------------
    GenericTest.Init Sequence         param=${CB008375_basic}
    ${branch_version}=                Set Variable    ${TLConfig.topo.getBranchName()}
    Dated Log New Line                > Test name is ${param.test_name}
    Dated Log                         ----Get and store L2RT node information---------------------------------------
    @{list_nodes_to_crash}=           Create List
    # L2RTa-0-0
    ${current_node_dico}=    Run Keyword If    '${branch_version}' == 'SBTS00'
    ...                               Get Node Information    node_name=L2RT_FDDa    card_index=0    capacity_index=0
    ...                               ELSE
    ...                               Get Node Information    node_name=L2RTa    card_index=0    capacity_index=0
    Run Keyword If    ${current_node_dico} != {}    Append To List    ${list_nodes_to_crash}    ${current_node_dico}
    # L2RTa-0-1
    ${current_node_dico}=    Run Keyword If    '${branch_version}' == 'SBTS00'
    ...                               Get Node Information    node_name=L2RT_TDDa    card_index=0    capacity_index=1
    ...                               ELSE
    ...                               Get Node Information    node_name=L2RTa    card_index=0    capacity_index=1
    Run Keyword If    ${current_node_dico} != {}    Append To List    ${list_nodes_to_crash}    ${current_node_dico}
    # UPUEa-0-0
    ${current_node_dico}=             Get Node Information    node_name=UPUEa    card_index=0    capacity_index=0
    Run Keyword If    ${current_node_dico} != {}    Append To List    ${list_nodes_to_crash}    ${current_node_dico}
    # UPUEa-0-1
    ${current_node_dico}=             Get Node Information    node_name=UPUEa    card_index=0    capacity_index=1
    Run Keyword If    ${current_node_dico} != {}    Append To List    ${list_nodes_to_crash}    ${current_node_dico}
    Dated Log                         > List of node dictionaries to crash= ${list_nodes_to_crash}
    Dated Log                         ----Get credentials for airscale unit connection------------------------------
    ${lmp_connect_du0}=    Run Keyword If    not ${isAic}    Set Variable    ${tl.gnbs[0].dus[0].airscale.common_units[0].lmp_connection}
    #vbo#debug#Dated Log              >> LMP du0 connection (address=${lmp_connect_du0.addr} usename=${lmp_connect_du0.username})

    Critical Step                     Restart.Restart TL

    # Configure the current setting for all the ue's
    ${param.total_nb_ue}=    Run Keyword If    ${CALL_ENABLED}    Get Length    ${dict_settings_basic}
    ...                                  ELSE    Set Variable    0
    Dated Log                         ----Configure the settings of all the ue's------------------------------------
    @{list_ue}=                       Create List
    @{cell_id_for_streaming}=         Create List
    FOR    ${current_id}    IN RANGE    0    ${param.total_nb_ue}
        ${current_ue_setting}=        Copy Dictionary     ${BASIC_UE_SA}
        Set To Dictionary             ${current_ue_setting}    ue    ${dict_settings_basic[${current_id}].ue_id}
        Set To Dictionary             ${current_ue_setting}    trf_id    1
        Set To Dictionary             ${current_ue_setting}    pdu    1
        Set To Dictionary             ${current_ue_setting}    target_gnb    ${param.target_gnb}
        # Dispatching the ue on the requested original cell for the call establishment
        Set To Dictionary             ${current_ue_setting}    target_cells    ${dict_settings_basic[${current_id}].original_cell}
        Append To List                ${cell_id_for_streaming}    ${current_ue_setting.target_cells}
        # Set the correct requested throughput per ue
        Set To Dictionary             ${current_ue_setting}    throughput    ${dict_settings_basic[${current_id}].throughput}
        Set To Dictionary             ${current_ue_setting}    throughput_ul    ${dict_settings_basic[${current_id}].throughput_ul}
        Append To List                ${list_ue}    ${current_ue_setting}
    END
    Dated Log                         > UE's list is ${list_ue}
    Dated Log                         > Cells list for TTI streaming is ${cell_id_for_streaming}
    ${length_list_for_streaming}=     Get Length    ${cell_id_for_streaming}

    # Start SYSLOG capture during call setup
    ${syslog}=    Run Keyword If    ${AUTO_SAVE_DEBUG_DATA} and not ${isAic}
    ...                               Syslogs.SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${param.test_name}_call_setup

    # Setup wtsemu SA for all the ue's
    Critical Step                     CallSetup.Setup Wtsemu SA     nbUe=${param.total_nb_ue}
    ...                                                             nbSaUe=${param.total_nb_ue}
    ...                                                             shouldUseLua=${False}
    ...                                                             nbCell=${param.total_nb_cell}
    ...                                                             list_of_UE_tobe_created=${list_ue}

    # WA to avoid alarm on cells
    Traced Sleep                      duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    Step                              CallSetup.WTS Set X2 Link

    Traced Sleep                      duration=10s    msg=for getting the number of initial alarms before starting the disturbances
    ${initial_number_of_alarm}=       Get Number Of Alarm

    #
    Dated Log                         ----Generate Disturbances On Nodes and check alarm Id-------------------------
    Run Keyword If    not ${isAic}    Generate Disturbances On Nodes    hardware_entity=${TGNB_DU[0]}
    ...                                                             list_nodes=${list_nodes_to_crash}
    ...                                                             connection=${lmp_connect_du0}
    ...                                                             alarm_id=7101
    #

    Traced Sleep                      duration=10s    msg=getting the number of final alarms after disturbances
    ${final_number_of_alarm}=         Get Number Of Alarm
    Dated Log                         >> Should Be True ${initial_number_of_alarm} >= ${final_number_of_alarm}
    #vbo#debug#Should Be True    ${initial_number_of_alarm} >= ${final_number_of_alarm}

    @{cell_id_list}=    Run Keyword If    not ${isAic}    Create List    ELSE    Set Variable    ${cell_id_for_streaming}
    @{cellsNr}=         Run Keyword If    not ${isAic}    Oam.OAM Get Cells Nr    oam=${GNB_DU.oam}    ELSE    Create List
    #vbo#debug#Dated Log              >> CellsNr=@{cellsNr}
    FOR    ${current_cell}    IN    @{cellsNr}
        #vbo#debug#Dated Log          >> cell NR is ${current_cell}
        #vbo#debug#Dated Log          >> internal distname ${current_cell['id']['internal']}
        ${cell_status_}=              Set variable  ${current_cell['status']}
        ${operationalState}=          Set Variable   ${cell_status_['operationalState']}
        #vbo#debug#Dated Log          >> operationalState for DN [${current_cell['id']['internal']}] is ${operationalState}
        ${globalCellId}=              Set Variable   ${current_cell['globalCellId']}
        ${is_global_cell_id}=    Is Global Cell Id Retained For Streaming    global_cell_id=${globalCellId}    cell_list=${cell_id_for_streaming}
        Run Keyword If    ${is_global_cell_id}    Append to List    ${cell_id_list}    ${current_cell['id']['internal']}
    END
    Dated Log                         > Distname list of the cells retained for TTI streaming ${cell_id_list}

    # Capture TTI traces during call setup
    Run Keyword If    ${length_list_for_streaming} > 0    Start TTI Logs Common    cell_id_list=${cell_id_list}

    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                          CallSetup.UE Register    ue=${current_elem.ue}    depends=CallSetup.Setup Wtsemu SA
        Step                          CallSetup.Launch PDU Session    ue=${current_elem.ue}    pdu=${current_elem.pdu}    gw=${current_elem.ue}
        ...                           depends=CallSetup.UE Register
    END

    Run Keyword If    ${length_list_for_streaming} > 0    Step    Stop and Get TTI Logs Common    trace_name=TTI_${param.test_name}_call_setup
    ${capture_tti_output}=            Set Variable    ${LOG_PATH}/TTITraces/TTI_${param.test_name}_call_setup.json
    Run Keyword If    ${AUTO_SAVE_DEBUG_DATA} and not ${isAic}    Step    Syslogs.SYSLOG Stop    syslog=${syslog}

    # Start SYSLOG capture during call setup
    ${syslog}=    Run Keyword If    ${AUTO_SAVE_DEBUG_DATA} and not ${isAic} and ${param.total_nb_ue} > 0
    ...                               Syslogs.SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${param.test_name}_traffic

    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput} > ${NO_THROUGHPUT}
        ...    Step                   ${param.dir} Traffic Not Stopped Common    param=${param}    current_ue_setting=${current_elem}
        ...                           depends=CallSetup.Launch PDU Session
    END

    # Capture TTI traces during traffic
    Run Keyword If    ${length_list_for_streaming} > 0    Run Keywords    Start TTI Logs Common    cell_id_list=${cell_id_list}
    ...    AND                        Traced Sleep    duration=8s    msg=call with traffic for TTI trace
    ...    AND                        Step    Stop and Get TTI Logs Common    trace_name=TTI_${param.test_name}_traffic
    ${capture_tti_output}=            Set Variable    ${LOG_PATH}/TTITraces/TTI_${param.test_name}_traffic.json

    Run Keyword If    ${param.pm_waiting_period} > 0    Wait PM availability    pmPeriodSec=300    #pmAvailDelay=60 #Sleep Until PM Availability
    Run Keyword If    ${AUTO_SAVE_DEBUG_DATA} and not ${isAic} and ${param.total_nb_ue} > 0    Step    Syslogs.SYSLOG Stop    syslog=${syslog}

    # Waiting time added for observation and allow generation of multiple count periods
    FOR    ${iteration_pm}    IN RANGE    0    ${param.pm_waiting_period}
        Wait PM availability    pmPeriodSec=300    #pmAvailDelay=60 #Sleep Until PM Availability
        ${pm_path}=    Run Keyword If    not ${isAic}    Counters.Collect PM files from BTS    ${LOG_PATH}/PM
        Run Keyword If    not ${isAic}    Step    Check Counter And KPI Constraints Common    pm_path=${pm_path}    test_name=${param.test_name}
    END

    # Deregister all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                          CallSetup.UE Deregister    id=${current_elem.ue}    ue_deregister_type=switch_off    by=ue
        ...                           depends=CallSetup.UE Register
    END

    # CB008375-D #
    Dated Log                         ----Get Snapshot and generate zip list----------------------------------------
    ${snapshot_path_tmp}=             Set Variable    /tmp/SNAPSHOT
    ${list_zip_path}=                 Set Variable    ${snapshot_path_tmp}/list_zip.txt
    OperatingSystem.Run               mkdir -p ${snapshot_path_tmp};rm -rf ${snapshot_path_tmp}/*
    ${snapshot_path}=                 Oam.OAM Get Snapshot
    ${status}   ${ret}                Run Keyword And Ignore Error    OperatingSystem.File Should Exist    ${snapshot_path}
    Run Keyword If   "${status}" == "PASS"    Run Keywords
    ...    Dated Log                  > ${snapshot_path} is created for verifications
    ...    AND                        OperatingSystem.Run    unzip -o ${snapshot_path} -d ${snapshot_path_tmp}
    ...    AND    OperatingSystem.Run    for f in ${snapshot_path_tmp}/*.zip; do echo "$f"; unzip -l $f >> ${list_zip_path}; done
    Should Be True                    "${status}" == "PASS"
    Dated Log                         ----Check generation of dump and snapshot files-------------------------------
    @{list_files}=                    Create List
    FOR    ${current_node}    IN    @{list_nodes_to_crash}
        @{words}=                     Split String    ${current_node.node_id}    x
        #vbo#debug#Dated Log          >> words after split= ${words}
        ${is_node_l2rt}=              Run Keyword And Return Status    Should Contain    ${current_node.id}    L2RT
        ${is_node_upue}=              Run Keyword And Return Status    Should Contain    ${current_node.id}    UPUE
        Should Be True                "${is_node_l2rt}" == "${True}" or "${is_node_upue}" == "${True}"
        Run Keyword If    "${is_node_l2rt}" == "${True}"    Step    Check Generation Of Dump And Snapshot File for L2RT    node=${current_node}
        ...                                                         node_id=${words[1]}    input_file=${list_zip_path}
        ...         ELSE IF    "${is_node_upue}" == "${True}"    Step    Check Generation Of Dump And Snapshot File for UPUE    node=${current_node}
        ...                                                         node_id=${words[1]}    input_file=${list_zip_path}
    END

    #[Teardown]    # Reserved to internal testing usage
# --------------------------------------------------------------------------------------------------------------------------------------------------
