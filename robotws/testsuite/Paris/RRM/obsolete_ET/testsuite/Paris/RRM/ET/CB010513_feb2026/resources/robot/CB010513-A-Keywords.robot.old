## The counter M55308C1005 (PRB available for PDSCH with L1 Basebnad pooling activated) value
##
## Semi Static frame struct, with the trs tracking period =80ms, 6 beams, beamRefinement true, ss burst period=20ms, bw=100Mhz (full DL PRB=273)
##   - 12 SSB slots   :     273-64=209 PRB for PDSCH  // or 54-20-28=6 PRB for PDSCH
##   - 12 SIB  slots   :    273 PRB
##   - 2 TRS   slots    :   273 PRB, 1 muted
##   - 30 specific slots :  273 PRB
##   - 72 full DL slots  :   counted for this counter, 9 muted
## If zab cell :  in total 128
##
## Cell 1 : zab cell, BBRM allocats 273 PRB due to inter subpool pooling
##               in every 160slots : 12*209+12*273+2*273+30*273+72*273=34176
##               in 5 mins :  34176*(600000/160)=128160000
##
## Cell 2 : non zab cell, BBRM allocates 54 PRB due to inter subpool pooling
##               in every 160slots : 10 muted slots,  12*(54-48)+12*54+32*54+72*54-14*54=5580
##               in 5mins ;   5580*(600000/160)=20925000
##
## Cell 3 : non zab cell, BBRM allocates 273 PRB due to inter sub,
##               in every 160slots :  12*209+12*273+2*273+30*273+58*273=34176
##                                    14 muted slots ==> 34176-14*273=30354
##               in 5mins :   30354*(600000/160)=113827500

&{10513_A_BB_POOL_Counter_Expected}     PM_ID=M55308C10005
...                                     CELL_1_Expected=128160000
...                                     CELL_2_Expected=20925000
...                                     CELL_3_Expected=113827500

&{7113_UL_BB_POOL_Counter_Expected}     PM_ID=M55308C10006
...                                     CELL_1_Expected=28800000
...                                     CELL_2_Expected=28800000
...                                     CELL_3_Expected=28800000

&{PRB_AVAIL_PUSCH_LEGACY_Expected}      PM_ID=M55308C10004
...                                     CELL_1_Expected=28800000
...                                     CELL_2_Expected=28800000
...                                     CELL_3_Expected=28800000

&{PRB_AVAIL_PDSCH_LEGACY_Expected}      PM_ID=M55308C10003
...                                     CELL_1_Expected=128160000
...                                     CELL_2_Expected=113827500
...                                     CELL_3_Expected=113827500

*** Keywords ***

TC 10513 Feature Activation 8DL8UL
    [Arguments]            ${param}        ${vendor_custom}
    Init Sequence          ${param}
    Step                   Set RAD Params Of 10513-A
    Critical Step          CB008940-Common-Keywords.Deploy Vendor File Config  vendor_param=${vendor_custom}  is_perform_full_commissioning=${True}
    Dated Log New Line     ${vendor_custom}
    Step                   Multi Cells Setup 10513                 argument=${param.nbCell}
    Step                   CB010513-A-Keywords.SA Call DL Traffic With UE Profile      argument=${Profile_UE_1}
    Step                   sleep    2s
    Step                   CB010513-A-Keywords.SA Call DL Traffic With UE Profile      argument=${Profile_UE_2}
    Step                   sleep    2s
    Step                   CB010513-A-Keywords.SA Call DL Traffic With UE Profile      argument=${Profile_UE_3}
    Step                   sleep    2s
    Step                   Activate Sherpa On All Cells
    Step                   sleep    10s
    Step                   Stop Sherpa Collection
    Step                   Calling Panda Extract Csv function
    Step                   CB010513-Common-Keywords.Verification of BB Pooling Mode within PRB Pooling Allocation Report
    ...                    pool_id=10
    Step                   CB010513-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report
    ...                    nr_cell_id=0x4001    subpool_id=0
    Step                   CB010513-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report
    ...                    nr_cell_id=0x4002    subpool_id=1
    Step                   CB010513-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report
    ...                    nr_cell_id=0x4003    subpool_id=0
    Step                   Check Min and MAX PRB values
    Step                   Verification of Variable Stream PRB Information within PRB Pooling Report
    Step                   CB010513-A-Keywords.SA DeRegister three UEs
    Step                   sleep    2s
    Step                   CB010513-A-Keywords.SA Call DL UL Traffic With UE Profile     argument=${Profile_UE_1_ZAB_SP0}
    Step                   sleep    2s
    Step                   CB010513-A-Keywords.SA Call DL UL Traffic With UE Profile     argument=${Profile_UE_2_ZAB_SP0}
    Step                   sleep    2s
    Step                   CB010513-A-Keywords.SA Call DL UL Traffic With UE Profile     argument=${Profile_UE_3_ZAB_SP0}
    Step                   sleep    2s
    Step                   Activate Sherpa On All Cells
    Step                   sleep    10s
    Step                   Stop Sherpa Collection
    Step                   Verify ZAB Privilege cells
    Step                   sleep    600s
    Step                   Collect Lastest PM Counters File
    Step                   CB010513-A-Keywords.Check 10513 A UL DL NEW AND LEGACY PM Counters


Suite Setup CB010513-A
    [Documentation]
    ...     Conditions:     customs configurations yamlPathname
    ...     Actions:        it performs the generic suite setup and backup the configurations files
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        suite setup is passed
    [Arguments]             ${yamlPathname}=${EMPTY}
    Setup.Suite Setup from scratch        yamlPathname=${yamlPathname}
    ...                                   listBackupFiles=${FD_ALL}
    ...                                   keepAllUeDataInCfgFile=${True}
    Backup Files
    ${scf_suite_setup_backup}         OAM Get SCF File    file=SCF_Suite_Setup_Backup.xml
    Set Suite Variable      ${scf_suite_setup_backup}
    Dated Log               SCF backup file = ${scf_suite_setup_backup}


Set RAD Params Of 10513-A
   [Documentation]     Add or Modify the RAD params of 10513 To Activate CB008941 feature
    ...                will be replaced later by NIDD params
    ...                0x580117=1 #CSI-RS Event Sherpa
    Dated Log New Line   Add RAD params of 10513-A rd-parameter and PDL rules update ......
    ${rad_param_1}=      create dictionary       field=0x580117    value=1
    ${rad_param_list}=       Create List         ${rad_param_1}
    Dated Log New Line    RAD params :  ${rad_param_list}
    SetConfig.Set Fields in swconfig DU       param_list=${rad_param_list}
    Dated Log New Line   RAD params of 10513-A update completed


SA Call DL Traffic With UE Profile
    [Arguments]                      ${ue_profile}
    [Documentation]                  1  UE SA call  based on UE profile (ue_id, pdu, gw, dl_tput, ul_tput, deviation)
    ...                              This keyword can be used to perform a UE call based on the UE profile
    ...                              how to use :
    ...                              - create a dictionary of ue profile with the following structure:
    ...                                 &{Profile_UE}
    ...                                     ue_id=1
    ...                                     pdu=1
    ...                                     gw=1
    ...                                     dl_tput=175   #(tput in mbps)
    ...                                     deviation=40  #(percentage of expected deviation of tput)
    ...                              - call the keyword with the UE profile
    ...                                     SA Call DL Traffic With UE Profile     ${Profile_UE}
    CallSetup.UE Register            ue=${ue_profile.ue_id}
    sleep                            1s
    CallSetup.Launch PDU Session     ue=${ue_profile.ue_id}     pdu=${ue_profile.pdu}       gw=${ue_profile.gw}
    sleep                            1s
    ${ueSetting}                     set variable            ${BASIC_UE_SA}
    ${ueSetting.pdu}                 set variable            ${ue_profile.ue_id}
    ${ueSetting.ue}                  set variable            ${ue_profile.ue_id}
    Traffic UE DL                    ueSetting=${BASIC_UE_SA}    throughput=${ue_profile.dl_tput}
    ...                              shouldBeStop=False          deviation=${ue_profile.deviation}
    ...                              shouldBeCheck=False


SA Call DL UL Traffic With UE Profile
    [Arguments]                      ${ue_profile}
    [Documentation]                  1  UE SA call  based on UE profile (ue_id, pdu, gw, dl_tput, ul_tput, deviation)
    ...                              This keyword can be used to perform a UE call based on the UE profile
    ...                              how to use :
    ...                              - create a dictionary of ue profile with the following structure:
    ...                                 &{Profile_UE}
    ...                                     ue_id=1
    ...                                     pdu=1
    ...                                     gw=1
    ...                                     dl_tput=175   #(tput in mbps)
    ...                                     deviation=40  #(percentage of expected deviation of tput)
    ...                              - call the keyword with the UE profile
    ...                                     SA Call DL Traffic With UE Profile     ${Profile_UE}
    CallSetup.UE Register            ue=${ue_profile.ue_id}
    sleep                            1s
    CallSetup.Launch PDU Session     ue=${ue_profile.ue_id}     pdu=${ue_profile.pdu}       gw=${ue_profile.gw}
    sleep                            1s
    ${ueSetting}                     set variable            ${BASIC_UE_SA}
    ${ueSetting.pdu}                 set variable            ${ue_profile.ue_id}
    ${ueSetting.ue}                  set variable            ${ue_profile.ue_id}
    Traffic UE DL                    ueSetting=${BASIC_UE_SA}    throughput=${ue_profile.dl_tput}
    ...                              shouldBeStop=False          deviation=${ue_profile.deviation}
    ...                              shouldBeCheck=False
    # Traffic UE UL                    ueSetting=${BASIC_UE_SA}    throughput=${ue_profile.ul_tput}
    # ...                              shouldBeStop=False          deviation=${ue_profile.deviation}
    # ...                              shouldBeCheck=False


DL Traffic With UE Profile
    [Arguments]                      ${ue_profile}
    [Documentation]                  1  UE DL Traffic  based on UE profile (ue_id, pdu, gw, dl_tput, ul_tput, deviation)
    ...                              This keyword can be used to perform ONLY DL Traffic based on the UE profile
    ...                              how to use :
    ...                              - create a dictionary of ue profile with the following structure:
    ...                                 &{Profile_UE}
    ...                                     ue_id=1
    ...                                     pdu=1
    ...                                     gw=1
    ...                                     dl_tput=175   #(tput in mbps)
    ...                                     deviation=40  #(percentage of expected deviation of tput)
    ...                              - call the keyword with the UE profile
    ...                                     DL Traffic With UE Profile     ${Profile_UE}
    ${ueSetting}                     set variable            ${BASIC_UE_SA}
    ${ueSetting.pdu}                 set variable            ${ue_profile.ue_id}
    ${ueSetting.ue}                  set variable            ${ue_profile.ue_id}
    Traffic UE DL                    ueSetting=${BASIC_UE_SA}    throughput=${ue_profile.dl_tput}
    ...                              shouldBeStop=False          deviation=${ue_profile.deviation}
    ...                              shouldBeCheck=False


Stop DL Traffic For a given UE
    [Documentation]                 Stop a traffic previously started
    [Arguments]                     ${ue_profile}
    ...                             ${dir}=dl
    ...                             ${maxThroughputPerTransfer}=175
    Dated log                       Stop ${dir} data traffic : UE=${ue_profile.ue_id}
    ${ue_throughput}                Get Variable Value                  ${ue_profile.dl_tput}
    ${trf_throughput}               Set Variable If
    ...                             '${ue_throughput}'!='None'          ${ue_throughput}
    ${nb_trf}                       Get Number Of Transfers
    ...                             throughput=${trf_throughput}
    ...                             maxThroughputPerTransfer=${maxThroughputPerTransfer}
    FOR  ${idx}    IN RANGE     ${nb_trf}
        ${trf_id}                   Evaluate                            ${trf_id_1}+${idx}
        wtsemu.Trf Data Stop        ue=${ue_profile.ue_id}
        ...                         dir=dl                             trf_id=${trf_id}
        ...                         pdu=${ue_profile.pdu}
    END


Multi Cells Setup 10513
    [Arguments]       ${nbCell}
    ${msgStr}=    Catenate  Test ${nbCell} Cells Setup
    Dated Log   ${msgStr}
    Setup Wtsemu SA
    sleep    60s
    WTS Set X2 Link
    sleep    5s
   # WTS Testmode Decode PDSCH On SSB Slot


WTS Testmode Decode PDSCH On SSB Slot
    wtsemu.ue_testmode_decode_muxphychan    decode_mux_phy_chan=decode_PDSCH
    sleep    2s


Recommissioning
    Oam.OAM Perform Full Commissioning       scf_file=${SCF_SETUP_PATH}
    WA Airscale Wait For Ready               ${GNB_DU}


