*** Variables ***
# IF auto THEN it means that the value of the counter to check is compute automatically ELSE the value set is used
# Counters settings for Peak numbers of SA RRC users in the CU and non-GBR versus GBR DRBs on NRBTS
&{dict_settings_M55140C00001}         counter=M55140C00001    obj=NRBTS     obj_id=auto    min=auto     max=auto    iteration=3
&{dict_settings_M55140C00002}         counter=M55140C00002    obj=NRBTS     obj_id=auto    min=auto     max=auto    iteration=3
&{dict_settings_M55140C00501}         counter=M55140C00501    obj=NRBTS     obj_id=auto    min=auto     max=auto    iteration=3
# Counters settings for number of scheduled UEs on PDSCH                                                            
&{dict_settings_M55308C17002}         counter=M55308C17002    obj=NRCELL    obj_id=auto    min=2        max=2       iteration=3
# Counters settings for number of PRBs                                                                              
&{dict_settings_M55308C10003}         counter=M55308C10003    obj=NRCELL    obj_id=auto    min=0        max=0       iteration=0
&{dict_settings_M55308C10005}         counter=M55308C10005    obj=NRCELL    obj_id=auto    min=0        max=0       iteration=0
&{dict_settings_M55308C10007}         counter=M55308C10007    obj=NRCELL    obj_id=auto    min=0        max=0       iteration=0
# Counters settings for PRBs on PDSCH for NSA traffic per PLMN                                                      
&{dict_settings_M55338C01000}         counter=M55338C01000    obj=NRCELL    obj_id=auto    min=0        max=0       iteration=0
&{dict_settings_M55338C01001}         counter=M55338C01001    obj=NRCELL    obj_id=auto    min=0        max=0       iteration=-1
# Counters settings for number of PRBs used for PDSCH per slice                                                     
&{dict_settings_M55359C00000}         counter=M55359C00000    obj=NRCELL    obj_id=auto    min=0        max=0       iteration=0
&{dict_settings_M55359C00001}         counter=M55359C00001    obj=NRCELL    obj_id=auto    min=0        max=85      iteration=0
# Counters for cells are added dynamically
@{dict_all_counters}                            &{dict_settings_M55140C00001}
...                                             &{dict_settings_M55140C00002}
...                                             &{dict_settings_M55140C00501}

${custom_config_file}       ${CURDIR}/../../../../../../../custom-config/POOLING/CB010513/CB010513_C/custom_config_10513_C.yaml


