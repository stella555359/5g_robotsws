#####################################################
# Configuration parameters (mainly for 1586)
#####################################################

# To enable debug to console
auto_1586_debug_scf_update = 0
auto_1586_debug_counters = 0

#  gNB snapshot will be triggered at the end of the test in case of failed TC  - \
# mandatory for CRT to have snapshot in case of failed TC
get_snapshot = 0

# To enable counter verification at the end of the test - mandatory for CRT
check_counters = 1

# wait 5g cell onait to start test suite
WAIT_5G_CELL_ONAIR = 1

# COLLECT_LOGS if TEST STATUS is FAIL and EXCLUDE_LOGS_IF_FAIL == 0
# COLLECT_LOGS if COLLECT_LOGS == 1
EXCLUDE_LOGS_IF_FAIL = 0
COLLECT_LOGS = 0

# To Stop or not the BIP / X2 / XP pcap traces after DSS Cell Setup - mandatory for CRT
TRACE_SHOULD_BE_STOP_AFTER_CELLSETUP = 1

# To Check or not the DSS Cell Setup  - mandatory for CRT
CELLSETUP_SHOULD_BE_CHECK = 1

# To Check or not DSS UL Tput  - mandatory for CRT
UL_TPUT_SHOULD_BE_CHECK = 1

# to perform full commissioning first at the beginning - mandatory for CRT
SHOULD_BE_COMMISSIONED_GNB_FIRST = 1

# to perform full commissioning at the end of the test (teardown 1586)  - mandatory for CRT
SHOULD_BE_RECOMMISSIONED_GNB = 1

# to update RAD and scf parameters for 10Mhz DSS - mandatory for CRT
SHOULD_UPDATE_SCF_AND_RAD = 1
SHOULD_UPDATE_RAD = 1

# to take XP , BIP L1L2 pcap during the attach - debug purpose only
PCAP_XP_BIP_L1L2_ATTACH = 0

# delete pdml generated  by the test at the end of the test suite (teardown)
REMOVE_PDML_FILE_END_TEST_SUITE = 1

# to force DL and UL Tput
TRAFFIC_DL_RATE = 0
TRAFFIC_UL_RATE = 0

# activate or not the DL/UL check based on aasyslog traces
UL_DL_TPUT_CHECK_BASED_AASYSLOG = 0

# activate or not the UL check based on tti traces
UL_TPUT_CHECK_BASED_TTITRACE = 0

# currently, the cfg is not uploaded to wts by default - mandatory for CRT
WITH_UPLOAD_1586_CONFIGURATION = 0

MessageName = namedtuple('MessageName', 'filter_name filter_expression message_type message_info')

UlData_PrachReceiveInd = MessageName('uldata_prachreceiveind', 'uldata_prachreceiveind', 'bip_message', '')
uldata_puschreceivereq = MessageName('uldata_puschreceivereq', 'uldata_puschreceivereq', 'bip_message', '')
dldata_pdschsendreq = MessageName('dldata_pdschsendreq', 'dldata_pdschsendreq', 'bip_message', '')
DlData_CsiRsSendReq = MessageName('dldata_csirssendreq', 'dldata_csirssendreq', 'bip_message', '')
DlData_PdcchSendReq = MessageName('dldata_pdcchsendreq', 'dldata_pdcchsendreq', 'bip_message', '')
dldata_pdschpayloadtbsendreq1 = MessageName('dldata_pdschpayloadtbsendreq',
                                            '(dldata_pdschpayloadtbsendreq)\
                                             && (DlData_PdschPayloadTbSendReq.PdschPayloadTbSendReq.rnti == 0x003d)',
                                            'bip_message', '')
dldata_pdschpayloadtbsendreq2 = MessageName('dldata_pdschpayloadtbsendreq',
                                            '(dldata_pdschpayloadtbsendreq)\
                                            && (DlData_PdschPayloadTbSendReq.PdschPayloadTbSendReq.rnti == 0x003d)',
                                            'frame_two_message', '')


def hello():
    print("This is imported from %s [%s]" % (__file__, os.path.basename(__file__)))
    module_name = os.path.basename(__file__)
    msg = module_name+" is imported from :"
    StringTool.datedConsole(StringTool.getHeaderLine(msg, __file__))
