import csv


def CheckFileIWK2534(csvPathName):
    """
    """
    iwk2534occur = 0

    ssblocktable = []
    pdsch2534table = []

    with open(csvPathName) as csvfile:
        reader = csv.DictReader(csvfile, delimiter=';')
        for row in reader:
            if row['_ws.col.info'] == "DlData_SsBlockSendReq,MIB":
                ssblocktable.append(row)
            if row['_ws.col.info'] == "DlData_PdschPayloadTbSendReq":
                pdsch2534table.append(row)
    # Count the occurrences where SsBlockSendReq is sent on the same SFN that PdschPayloadTbSendReq
    # on subcellid0 and slot1
    for pdsch in pdsch2534table:
        if pdsch['3gpp.subcellid'] == "0" and pdsch['3gpp.slot'] == "1":
            for ssb in ssblocktable:
                if ssb['3gpp.subcellid'] == "0" and ssb['3gpp.slot'] == "1":
                    if ssb['3gpp.sfn'] == pdsch['3gpp.sfn']:
                        print('ssb_sfn', ssb['3gpp.sfn'])
                        print('pdsch_sfn', pdsch['3gpp.sfn'])
                        iwk2534occur += 1

    results = {"iwk2534occur": iwk2534occur}

    return results
