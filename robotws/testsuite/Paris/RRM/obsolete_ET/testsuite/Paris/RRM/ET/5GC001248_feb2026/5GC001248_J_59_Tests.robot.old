*** Test Cases ***

[1][1.0] 5GC001248_J_59_PDCP Flow control over X2-U and F1-U interface
   [Documentation]                 Automation for 1248-J TC_59
   ...                             F1+X2 with and without BLER ("main stream" FC test case)   

   Set Flow Control Configuration  FC_protocol=3gpp
   ...                             split_mode=dlOverF1UX2U

   Restart TL

   WTS Setup

   Run Keyword If                  ${enable_sherpa}==${True}                  Activate Sherpa

   # Attach to 5G (NSA)
   SgNB Addition to ENB             ueSetting=${UE_SIMPLE}

   # Set low delay over X2
   Update DDDS Parameters          ueSetting=${UE_SIMPLE}      dbs=100000   ddr=0   success_rate=100

   # Start 27 Mbps DL traffic. It will be stopped by hand   
   # Throughput is set to almost reach congestion and BLER is added.
   # Otherwize, nothing is sent over X2 and F1 is always selected...
   ${status}   ${msg}      Run Keyword And Ignore Error      
   ...                             Traffic UE DL                   ueSetting=${UE_PROFILE_1}
   ...                             throughput=27
   ...                             shouldBeStop=False
   ...                             duration=20s

   #
   # Stop DDDS reports for a short time to trigger data sending over F1 as a first step.
   # Because (???), in case of 3GPP FC, data rate on X2 side is badly estimated because of eNB model, it seems
   # there may be unstabilities of traffic balance between F1 and X2. This step is used to
   # force to send data over F1. It should avoid to send all data over X2 and stabilise X2 (hopefully...)
   #
   Set DDDS Drop Configuration      ueSetting=${UE_SIMPLE}        ddds_transmission=off
   Traced Sleep  5 seconds   
   Set DDDS Drop Configuration      ueSetting=${UE_SIMPLE}        ddds_transmission=on

   # Target MCS will drop to 0
   Enable BLER on F1 side          ueSetting=${UE_SIMPLE}

   Traced Sleep  3 minutes

   # Disable BLER to decrease RLC delay and move back to F1
   Disable BLER on F1 side          ueSetting=${UE_SIMPLE}

   # Set congestion over X2
   Update DDDS Parameters          ueSetting=${UE_SIMPLE}      dbs=0   ddr=0   success_rate=100

   Traced Sleep  3 minutes

   # Set low delay again over X2
   Update DDDS Parameters          ueSetting=${UE_SIMPLE}      dbs=100000   ddr=0   success_rate=100
   
   # Target MCS will drop to 0
   Enable BLER on F1 side          ueSetting=${UE_SIMPLE}

   Traced Sleep  3 minutes

   # Stop traffic
   Traffic Stop                    ueSetting=${UE_PROFILE_1}  

   Disable BLER on F1 side          ueSetting=${UE_SIMPLE} 

   # Detach UE
   UE Detach Enb                   ueSetting=${UE_SIMPLE}

   # Sleep 5 mn in case of GP overlap
   Traced Sleep  ${auto_1248_gp_period} minutes       msg=GP overlap

   # Retrieve counters and compare with a reference
   # Verify Object Counter cumulative values
   ${status}             Run Keyword If        '${auto_1248_check_counters}' == 'True'       
   ...                   Verify Counter Cumulative Values With Margin     5GC001248_J_59




*** Keywords *** 

PDCP FC Bearer Configuration Checks

   [Documentation]            Generic KW used for PDCP FC bearer checks inside L2HI messages HiUserCu_BearerSetupReq
   ... 							   or HiUserDu_BearerSetupReq. Used for TCs 5GC001248_J_63, 5GC001248_J_80
   ...							   Input dictionary ${FC_Configuration} with FC_Mode and InitialDL:
   ...							   FC_Mode = 3gpp
   ...							   InitialDL = initDLoverX2U | initDLoverF1U
   
   [Arguments]                     ${FC_Configuration}
   
   ${mode}   					   Get From Dictionary     ${FC_Configuration}     FC_Mode
   ${initial_dl}				   Get From Dictionary     ${FC_Configuration}     InitialDL

   ${fc_value}                     Run Keyword If          '${mode}' == '3gpp'     Set Variable	1
   ...                             ELSE                                            Set Variable	0
   
   ${initial_dl_traffic_value}     Run Keyword If          '${initial_dl}' == 'initDLoverX2U'    Set Variable    1
   ...                             ELSE                                                          Set Variable    0

   Set Flow Control Configuration  FC_protocol=${mode}
   ...                             split_mode=dlOverF1UX2U
   ...                             initial_dl=${initial_dl}

   Restart TL

   WTS Setup

   Run Keyword If                  ${enable_sherpa}==${True}                     Activate Sherpa

   # Attach to 4G
   UE Attach Enb                   ueSetting=${UE_SIMPLE}

   # Start capture on ASIK_S etha01 to get L2HIDU configuration message : HiUserCu_BearerSetupReq
   ${CaptureCPRT}                   Capture CPRT Set Upon Config            airscale=${GNB_DU}
   Capture Init                     ${CaptureCPRT}
   Capture Start                    ${CaptureCPRT}
   Set Suite Variable               ${CaptureCPRT}

   # Start 10 Mbps DL traffic for 5 mn
   ${status}   ${msg}      Run Keyword And Ignore Error      
   ...                             Traffic UE DL                   ueSetting=${UE_PROFILE_1}
   ...                             throughput=10
   ...                             shouldBeStop=False
   ...                             duration=20s

   # Attach to 5G
   UE Attach Gnb                   ueSetting=${UE_SIMPLE}

   # Stop capture on ASIK_S etha01
   Capture Stop                     ${CaptureCPRT}

   # Stop traffic
   Traffic Stop                    ueSetting=${UE_PROFILE_1}   

   # Detach UE
   UE Detach Enb                   ueSetting=${UE_SIMPLE}

   # Look for HiUserCu_BearerSetupReq
   ${filterPcap}                   analyzer.filter_pcap            ${CaptureCPRT.path}
   ...                             filterName=syscom               filterExp=syscom
   
   ${pdmlFile}=                    analyzer.pcap_to_pdml           ${filterPcap}

   # Checks related to CU/F1 and X2 sides
   Check Bearer CU                 pdmlFile=${pdmlFile}      fc_mode=${fc_value}       initial_dl=${initial_dl_traffic_value}

   # Checks related to DU/F1 side
   Check Bearer DU                 pdmlFile=${pdmlFile}      fc_mode=${fc_value}

