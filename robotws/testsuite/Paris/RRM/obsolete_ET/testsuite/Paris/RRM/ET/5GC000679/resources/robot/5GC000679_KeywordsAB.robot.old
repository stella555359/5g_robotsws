*** Settings ***
Documentation     [PURPOSE] Set of keywords used for 5GC000679 AB feature FDD tests cases for bandwitdh 20MHz
...               Modified Date               : 24-January-2022
...               Last Modified by            : fabienne.duhamel@nokia.com
...               Last Modification           :  adding longpucch ABIN
...               Last Modification           :  ML-Leborgne and M. Hummel Adaptations for VRAN2.0
...               13-12-2022: MLLB MH Add FDD-ORAN test case

Resource                  5GC000679_Keywords.robot


*** Variables ***
${testTag}                5GC000679_AB

&{NRCELL_FDD20MHz}        chBwDl=20MHz
...                       chBwUl=20MHz
...                       nrarfcnDl=126380
...                       nrarfcnUl=135760

&{NRCELL_FDD20MHz_OR}     chBwDl=20MHz
...                       chBwUl=20MHz
...                       nrarfcnDl=428000
...                       nrarfcnUl=390000

&{scf_AB}                 actFdmScheduling=true    gscnOrSsPbchArfcn=1582    nrcellfdd=${NRCELL_FDD20MHz}
...                       reportingIntervalPm=5min

&{scf_AB_OR}              actFdmScheduling=true    gscnOrSsPbchArfcn=5350    nrcellfdd=${NRCELL_FDD20MHz_OR}
...                       reportingIntervalPm=5min

&{T_AB}                   feature679=${True}    totalUE=4    loop=1    bandwidth=20    technology=FDD    ulthroughput=5    dlthroughput=10
...                       captureDuration=10    stopTraffic=${False}    dirTraffic=dl    expectedCounter=2
...                       trafficDuration=10    deviation=90

&{Test_AB}                seq=${T_AB}    checkPucch=${True}    scfFile=${scf_AB}    filtermsg=@{ListOfMsgTrf}
...                       captureName=AB    dtxLimit=10    crcLimit=10    allowShortPucchConfig=${False}

#Specifics variables for FDD NSA VRAN 2.0##############
&{NRCELL_FDD10MHz_AIC}    chBwDl=10MHz
...                       chBwUl=10MHz
...                       nrarfcnDl=176300
...                       nrarfcnUl=167300

&{scf_AB_AIC}             actFdmScheduling=true    gscnOrSsPbchArfcn=2203    nrcellfdd=${NRCELL_FDD10MHz_AIC}
...                       reportingIntervalPm=15min

&{T_AB_AIC}               feature679=${True}    totalUE=4    loop=1    bandwidth=10    technology=FDD    ulthroughput=1    dlthroughput=1
...                       captureDuration=10    stopTraffic=${False}    dirTraffic=dl    expectedCounter=2
...                       trafficDuration=10    deviation=90

&{Test_AB_AIC}            seq=${T_AB_AIC}    checkPucch=${True}    scfFile=${scf_AB_AIC}    filtermsg=@{ListOfMsgTrf}
...                       captureName=AB    dtxLimit=10    crcLimit=10    allowShortPucchConfig=${False}


########################################################
&{Test_AB_longpucch}            seq=${T_AB}    checkPucch=${True}    scfFile=${scf_AB}    filtermsg=@{ListOfMsgTrf}
...                       captureName=AB    dtxLimit=10    crcLimit=10    allowShortPucchConfig=${False}

&{Test_AB_longpucch_OR}         seq=${T_AB}    checkPucch=${True}    scfFile=${scf_AB_OR}    filtermsg=@{ListOfMsgTrf}
...                       captureName=AB    dtxLimit=10    crcLimit=10    allowShortPucchConfig=${False}

*** Keywords ***
Run Test 679 AB
    [Arguments]                 ${testParam}
    Run Keyword If              ${isAic}
     ...                         Run Keywords
     ...                         Set Test Variable          ${testParam.scfFile.gscnOrSsPbchArfcn}
     ...     AND                 Set Context_AP IPHY ${testParam.scfFile.nrcellfdd.chBwDl}
    Set MRBTSID and NRBTSID
    Get Pucch Mode Select
    Test Setup 679 AB           ${testParam}
    Restart
    WTS Preparation AB          ${testParam}
    Run Keyword If              ${enable_sherpa}==${True}        Activate Sherpa
    Test 679 Loop AB            ${testParam}
    Run Keyword If              ${enable_sherpa}==${True}        Deactivate Sherpa and Stop Collect

Test 679 Loop AB
    [Arguments]                  ${testParam}
    Dated log                    Start Test:Name=${TEST_NAME}
    Create Ue List for Multi Ues    nb_ue=${testParam.seq.totalUE}
   FOR    ${index}    IN RANGE     1        ${testParam.seq.loop}+1
       Attach UE Multi          ${testParam}
        #${trafficPcap}           Start Traffic Multi UE with Filter    ${testParam}
       ${trafficPcap}           Start Traffic Multi UEs with Filter UL DL    ${testParam}
       Check Feature AB Counter     ${testParam}
       Run keyword if           ${testParam.seq.stopTraffic}==${False}
       ...                      Stop Traffic Multi UE                 ${testParam}
       sleep                    3s
       Detach UE Multi          ${testParam.seq.totalUE}
       Set Test Variable        ${TRAFFIC_PCAP.pcapTrf${index}}         ${trafficPcap}
       Dated Log                TRAFFIC_PCAP.pcapTrf=${TRAFFIC_PCAP.pcapTrf${index}}
       Check Traffic Quality    pcapInput=${TRAFFIC_PCAP.pcapTrf${index}}    index=${index}
       ...                      dtxLimit=${testParam.dtxLimit}
       ...                      crcLimit=${testParam.crcLimit}
       ...                      direction=${testParam.seq.dirTraffic}
       Check Feature AB         ${TRAFFIC_PDML.pdmlTrf${index}}
   END

Check Feature AB
    [Arguments]              ${pdmlFile}
    Dated Log                Check PRB allocation in ${pdmlFile}
    Check Prb Allocation with rat0bitmap    pdmlFile=${pdmlFile}

Check Feature AB Counter
    [Arguments]              ${testParam}
    Dated Log                Check test counter
    Traced Sleep             ${testParam.scfFile.reportingIntervalPm}
    ${date}                  Get Current Date
    ${date_in_dir_name}      Convert Date         ${date}     result_format=%d%m%Y_%H%M
    ${log_path_pm}           Set Variable         ${LOG_PATH}/PM_${date_in_dir_name}
    ${pm_latest}            Run Keyword If              not ${isAic}
    ...                     Collect PM files from BTS    ${log_path_pm}
    ${myexpected_val}=       Set Variable         ${MORE_OR_EQUAL_THAN_2}
    ${mycomparison}=         Set Variable         '>'
    ${foundOrNot}            Check Counter FDM
    ...                      ${log_path_pm}    ${myexpected_val}    ${mycomparison}
    ...                      &{PM_COUNTER_ID.maxNumbSchPdschPerSlot}
    Log Counter FDM          counter=&{PM_COUNTER_ID.maxNumbSchPdschPerSlot}
    ...                      expectedValue=MORE_OR_EQUAL_THAN_2    result=${foundOrNot}
    ${foundOrNot}            Check Counter FDM
    ...                      ${log_path_pm}    ${myexpected_val}    ${mycomparison}
    ...                      &{PM_COUNTER_ID.maxNumbSchPuschPerSlot}
    Log Counter FDM          counter=&{PM_COUNTER_ID.maxNumbSchPuschPerSlot}
    ...                      expectedValue=MORE_OR_EQUAL_THAN_2    result=${foundOrNot}
    ${myexpected_val}=       Set Variable         ${MORE_THAN_0}
    ${mycomparison}=         Set Variable         '>'
    ${foundOrNot}            Check Counter FDM
    ...                      ${log_path_pm}    ${myexpected_val}    ${mycomparison}
    ...                      &{PM_COUNTER_ID.accNumbSchPdschPerSlot}
    Log Counter FDM          counter=&{PM_COUNTER_ID.accNumbSchPdschPerSlot}
    ...                      expectedValue=MORE_THAN_0    result=${foundOrNot}
    ${foundOrNot}            Check Counter FDM
    ...                      ${log_path_pm}    ${myexpected_val}    ${mycomparison}
    ...                      &{PM_COUNTER_ID.accNumbSchPuschPerSlot}
    Log Counter FDM          counter=&{PM_COUNTER_ID.accNumbSchPuschPerSlot}
    ...                      expectedValue=MORE_THAN_0    result=${foundOrNot}
#Used for AIC VRAN 2.0 configured in 10Mhz with 2AHCA Radio unit
Set Context_AP IPHY 10MHz
    WtsXmlConfig.startSession           file=iphy
    WtsXmlConfig.setListEltText         //GSCN                           ${testParam.scfFile.gscnOrSsPbchArfcn}
    WtsXmlConfig.stopSession            file=iphy

WTS Preparation AB
    [Arguments]       ${testParam}
    WTS cfg Preparation AB                ${testParam}
    WTS Setup         nbUe=${testParam.seq.totalUE}               shouldUseLua=${True}

WTS cfg Preparation AB
    [Arguments]       ${testParam}
    WtsCfgConfig.startSession
    ${oldValue}          getParam           prefix=set_cell          param=nr_arfcn
    replaceValue         prefix=set_cell
    ...                  param=nr_arfcn
    ...                  oldValue=${oldValue}
    ...                  newValue=${testParam.scfFile.nrcellfdd.nrarfcnUl}:${testParam.scfFile.nrcellfdd.nrarfcnDl}
    WtsCfgConfig.stopSession         rename=modified

Test Setup 679 AB
   [Arguments]            ${testParam}
   Set SCF AB             ${testParam}

Set SCF AB Short Pucch Configuration
    Dated Log new line         pucchModeSelect is ${pucchModeSelect} then change configuration to short Pucch
    # RDH: The following line should be adapted: with New LO_LO Variant the NRCELL Id will be 3 instead of 1
    SCF Set element            dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRBTS_ID}
    ...                        element_name=pucchModeSelect
    ...                        element_value=shortPucch
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    # BWP_PROFILE dedicated PDCCH
    ${dist_name}               Get Distance Name Profile
    ...                        endClassParent=BWP_PROFILE
    ...                        endClassChild=PDCCH
    ...                        bwpTypeValue=dedicated
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=alSelection
    ...                        element_value=static
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciDedicatedAggregationLevel
    ...                        element_value=AL4
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciPagingAggregationLevel
    ...                        element_value=AL4
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciRaCompletionAggregationLevel
    ...                        element_value=AL4
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciRaMsg2AggregationLevel
    ...                        element_value=AL4
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciSiAggregationLevel
    ...                        element_value=AL4
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=downgradeAL16toAL8
    ...                        element_value=notAllowed
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    # BWP_PROFILE dedicated PDCCH_CONFIG_COMMON
    ${dist_name}               Get Distance Name Profile
    ...                        endClassParent=BWP_PROFILE
    ...                        endClassChild=PDCCH_CONFIG_COMMON
    ...                        bwpTypeValue=dedicated
    # searchSpaceCommon
    ${list_name}               Set Variable              searchSpaceCommon
    SCF Remove list            dist_name=${dist_name}    list_name=${list_name}
    ...                        aicListEntity=vdu      scope=Both
    SCF Add list               dist_name=${dist_name}    list_name=${list_name}
    ...                        aicListEntity=vdu      scope=Both
    &{searchSpaceCommon_e}     Create Dictionary         coresetId=0
    ...                                                  dciFormat=formats0-0-And-1-0
    ...                                                  duration=1
    ...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n1
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=4
    ...                                                  searchSpaceType=Type0A
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    ...                        aicListEntity=vdu      scope=Both
    &{searchSpaceCommon_e}     Create Dictionary         coresetId=0
    ...                                                  dciFormat=formats0-0-And-1-0
    ...                                                  duration=1
    ...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n0
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=5
    ...                                                  searchSpaceType=Type1
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    ...                        aicListEntity=vdu      scope=Both
    &{searchSpaceCommon_e}     Create Dictionary         coresetId=0
    ...                                                  dciFormat=formats0-0-And-1-0
    ...                                                  duration=1
    ...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n1
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=6
    ...                                                  searchSpaceType=Type2
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    ...                        aicListEntity=vdu      scope=Both
    # BWP_PROFILE dedicated PDCCH_CONFIG_DEDICATED
    ${dist_name}               Get Distance Name Profile
    ...                        endClassParent=BWP_PROFILE
    ...                        endClassChild=PDCCH_CONFIG_DEDICATED
    ...                        bwpTypeValue=dedicated
    # coresetDedicated
    ${list_name}               Set Variable              coresetDedicated
    SCF Remove list            dist_name=${dist_name}    list_name=${list_name}
    ...                        aicListEntity=vdu      scope=Both
    SCF Add list               dist_name=${dist_name}    list_name=${list_name}
    ...                        aicListEntity=vdu      scope=Both
    &{searchSpaceCommon_e}     Create Dictionary         cceToRegMapping=interleaved
    ...                                                  coresetId=4
    ...                                                  cRbStart=0
    ...                                                  duration=1
    ...                                                  interleaverSize=n3
    ...                                                  regBundleSize=n2
    ...                                                  size=24
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    ...                        aicListEntity=vdu      scope=Both
    # searchSpaceDedicated
    ${list_name}               Set Variable              searchSpaceDedicated
    SCF Remove list            dist_name=${dist_name}    list_name=${list_name}
    ...                        aicListEntity=vdu      scope=Both
    SCF Add list               dist_name=${dist_name}    list_name=${list_name}
    ...                        aicListEntity=vdu      scope=Both
    &{searchSpaceCommon_e}     Create Dictionary         coresetId=4
    ...                                                  dciFormat=formats0-0-And-1-0
    ...                                                  duration=1
    ...                                                  monitoringSymbolWithinSlot=symbol_2
    ...                                                  numOfPdcchCandidatesInAL1=n0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n0
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=7
    ...                                                  searchSpaceType=Type3
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    ...                        aicListEntity=vdu      scope=Both
    &{searchSpaceCommon_e}     Create Dictionary         coresetId=4
    ...                                                  dciFormat=formats0-1-And-1-1
    ...                                                  duration=1
    ...                                                  monitoringSymbolWithinSlot=symbol_2
    ...                                                  numOfPdcchCandidatesInAL1=n0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n0
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=8
    ...                                                  searchSpaceType=UE-Specific
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    ...                        aicListEntity=vdu      scope=Both
    &{searchSpaceCommon_e}     Create Dictionary         coresetId=0
    ...                                                  dciFormat=formats0-0-And-1-0
    ...                                                  duration=1
    ...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL1=n0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n0
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=9
    ...                                                  searchSpaceType=Type3
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    ...                        aicListEntity=vdu      scope=Both
    &{searchSpaceCommon_e}     Create Dictionary         coresetId=0
    ...                                                  dciFormat=formats0-1-And-1-1
    ...                                                  duration=1
    ...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL1=n0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n0
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=10
    ...                                                  searchSpaceType=UE-Specific
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    ...                        aicListEntity=vdu      scope=Both
    # BWP_PROFILE initial PDCCH
    ${dist_name}               Get Distance Name Profile
    ...                        endClassParent=BWP_PROFILE
    ...                        endClassChild=PDCCH
    ...                        bwpTypeValue=initial
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=alSelection
    ...                        element_value=static
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciDedicatedAggregationLevel
    ...                        element_value=AL4
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciPagingAggregationLevel
    ...                        element_value=AL4
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciRaCompletionAggregationLevel
    ...                        element_value=AL4
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciRaMsg2AggregationLevel
    ...                        element_value=AL4
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciSiAggregationLevel
    ...                        element_value=AL4
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=downgradeAL16toAL8
    ...                        element_value=notAllowed
    ...                        aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    # BWP_PROFILE initial PDCCH_CONFIG_COMMON
    ${dist_name}               Get Distance Name Profile
    ...                        endClassParent=BWP_PROFILE
    ...                        endClassChild=PDCCH_CONFIG_COMMON
    ...                        bwpTypeValue=initial
    # searchSpaceCommon
    ${list_name}               Set Variable              searchSpaceCommon
    SCF Remove list            dist_name=${dist_name}    list_name=${list_name}
    ...                        aicListEntity=vdu         scope=Both
    SCF Add list               dist_name=${dist_name}    list_name=${list_name}
    ...                        aicListEntity=vdu         scope=Both
    &{searchSpaceCommon_e}     Create Dictionary         coresetId=0
    ...                                                  dciFormat=formats0-0-And-1-0
    ...                                                  duration=1
    ...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n1
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=1
    ...                                                  searchSpaceType=Type0A
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    ...                        aicListEntity=vdu         scope=Both
    &{searchSpaceCommon_e}     Create Dictionary         coresetId=0
    ...                                                  dciFormat=formats0-0-And-1-0
    ...                                                  duration=1
    ...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n0
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=2
    ...                                                  searchSpaceType=Type1
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    ...                        aicListEntity=vdu         scope=Both
    &{searchSpaceCommon_e}     Create Dictionary         coresetId=0
    ...                                                  dciFormat=formats0-0-And-1-0
    ...                                                  duration=1
    ...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n1
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=3
    ...                                                  searchSpaceType=Type2
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    ...                        aicListEntity=vdu         scope=Both

#Introduced for VRAN 2.0 due to different MRBTS_ID between Classical and AIC
Set MRBTSID and NRBTSID
    ${dist_name_nrbts}                      Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    # RDH: The 2 following lines should be adapted: with New LO_LO Variant the NRCELL Id will be 3 instead of 1
    ${dist_name_nrcell1}                    Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ${ch_dist_name_nrcell1}                 Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1/NRCELL_FDD-1

    Set Suite Variable              ${dist_name_nrbts}
    Set Suite Variable              ${dist_name_nrcell1}
    Set Suite Variable              ${ch_dist_name_nrcell1}

    ${console_msg}                   Evaluate     "Suite Variables ${dist_name_nrbts}"
    Dated Log                        ${console_msg}
    ${console_msg}                   Evaluate     "Suite Variables ${dist_name_nrcell1}"
    Dated Log                        ${console_msg}
    ${console_msg}                   Evaluate     "Suite Variables ${ch_dist_name_nrcell1}"
    Dated Log                        ${console_msg}

Set SCF AB
    [Arguments]                     ${testParam}
    ${SCF_PATH_679_AB_DU}           OAM Get SCF File                oam=${GNB_DU.oam}          file=SCF_Setup_679_AB_DU.xml
    ${SCF_PATH_679_AB_CU}           OAM Get SCF File                file=SCF_Setup_679_AB_CU.xml
#    ${SCF_PATH_679_AB}              Run Keyword If                  not ${isAic}
#    ...                             OAM Get SCF File                file=SCF_Setup_679_AB.xml

    Set Suite Variable              ${SCF_PATH_679_AB_DU}
    Set Suite Variable              ${SCF_PATH_679_AB_CU}
    SCF StartSession                scf_file=${SCF_PATH_679_AB_DU}
    ...                             second_scf_file=${SCF_PATH_679_AB_CU}

#    Run Keyword If                  not ${isAic}
#    ...                             Run Keywords
#    ...                             Set Suite Variable              ${SCF_PATH_679_AB}
#    ...    AND                      SCF StartSession                scf_file=${SCF_PATH_679_AB}

    SCF Set element      dist_name=${ch_dist_name_nrcell1}
    ...                  element_name=chBwDl
    ...                  element_value=${testParam.scfFile.nrcellfdd.chBwDl}
    ...                aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element      dist_name=${ch_dist_name_nrcell1}
    ...                  element_name=chBwUl
    ...                  element_value=${testParam.scfFile.nrcellfdd.chBwUl}
    ...                aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element      dist_name=${ch_dist_name_nrcell1}
    ...                  element_name=nrarfcnDl
    ...                  element_value=${testParam.scfFile.nrcellfdd.nrarfcnDl}
    ...                aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element      dist_name=${ch_dist_name_nrcell1}
    ...                  element_name=nrarfcnUl
    ...                  element_value=${testParam.scfFile.nrcellfdd.nrarfcnUl}
    ...                aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element      dist_name=${dist_name_nrbts}
    ...                  element_name=actFdmScheduling
    ...                  element_value=${testParam.scfFile.actFdmScheduling}
    ...                aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/PMCADM-1
    ...                  element_name=reportingIntervalPm
    ...                  element_value=${testParam.scfFile.reportingIntervalPm}
    ...                aicListEntity=vduvcu       scope=Both       bestEffort=${True}
# GSCN Added for AIC and Classical (was comment out in classical before introducing VRAN 2.0)
    SCF Set element      dist_name=${dist_name_nrcell1}
    ...                  element_name=gscnOrSsPbchArfcn
    ...                  element_value=${testParam.scfFile.gscnOrSsPbchArfcn}
    ...                aicListEntity=vduvcu       scope=Both       bestEffort=${True}
    Run Keyword If       ${testParam.allowShortPucchConfig} == ${True} and '${pucchModeSelect}[0]' == 'longPucch'
    ...                  Set SCF AB Short Pucch Configuration

    SCF StopSession                 scf_file=${SCF_PATH_679_AB_DU}        second_scf_file=${SCF_PATH_679_AB_CU}
    Oam.OAM Perform Full Commissioning          scf_file=${SCF_PATH_679_AB_DU}


    Run Keyword If                  ${isAic}                       Oam.OAM Perform Full Commissioning
    ...                             scf_file=${SCF_PATH_679_AB_CU}           oam=${GNB_CU.oam}


    Run keyword if                  ${isAic}
    ...                             Wait Vcu And Vdu Available

    Run Keyword If                  not ${isAic}
    ...                             WA Airscale Wait For Ready                  ${GNB_DU}
