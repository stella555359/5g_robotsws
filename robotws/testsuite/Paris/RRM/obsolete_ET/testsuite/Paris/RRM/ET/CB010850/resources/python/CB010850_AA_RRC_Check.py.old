import os
import getopt
import sys


# Python function used to parse the egate console output and look for items
# located inside RRC_Sequence array.
# The console output is parsed line by line and each time an item is found the index
# moves one step forward and look for the next items.
# So, checks are done sequentially
# The output is ok is the end of the array is reached (i.e.: all items have been found in sequence)
def CB010850_AA_RRC_Check_Cell4(egate_output):

    # Array with items to look for
    RRC_Sequence = [
        "Cell Setup completed for [CELL_ID:4]",
        "locationAndBandwidth 27500",
        "pucch-ResourceCommon 11",
    ]

    check_index = 0
    file_obj = open(egate_output, 'rb')
    all_lines = file_obj.readlines()

    for current_string in all_lines:
        if (check_index < len(RRC_Sequence)):
            # print("Current String: " + str(current_string))
            # print(RRC_Sequence[check_index])
            if (RRC_Sequence[check_index] in str(current_string)):
                print("Found : " + str(current_string))
                print("Check index: %s" % (check_index))
                check_index += 1

    file_obj.close()

    return check_index == (len(RRC_Sequence))


