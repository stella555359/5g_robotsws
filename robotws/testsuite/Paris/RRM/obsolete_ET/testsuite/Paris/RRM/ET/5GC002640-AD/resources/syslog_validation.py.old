from testsuite.Paris.RRM.ET.resources_KRK.python.syslog_verify import *
from suite_specific_keywords import get_test_prefix
from ta5g_interface_tools import ta5g_interface_tools
from ute_syslog.exception import ParsingFailed
from datetime import datetime
from time import time
import os


def get_syslog_filepath():
    log_dirpath = ta5g_interface_tools().get_robot_output_dir()
    prefix = get_test_prefix()
    filename_template = "syslog_gnb_{}_127.0.0.1.log"
    syslog_filepath = os.path.join(log_dirpath, prefix, filename_template.format(prefix))
    return syslog_filepath


def get_value_of_slot_offset(pcell_id="16388"):
    # regex = r'nrCellIdentity:{}.*DrxCsiResourceHelper for sCell created with drxStartOffset: (\d+), '\
    regex = r'{}.*DrxCsiResourceHelper for sCell created with drxStartOffset: (\d+), '\
            r'drxLongCycle(\d+), drxOnDurationSlot(\d+)'.format(pcell_id)
    matches = get_regex_matches_from_syslog(regex, syslog_path=get_syslog_filepath())
    assert len(matches) > 0, "List of matches for regex [{}] in syslog returned empty".format(regex)
    logger_console("List of matches from syslog from regex[{}]: {}; taking the first value: {}".format(
        regex, matches, matches[0]))
    return matches[0]


def verify_syslog_feature_set_indexes_combinations():
    verify_syslog_for_given_number_of_msg(
        r'CA_n5A-n41A-n71A-n77A has matched featureSetIndexes: \[{1, \[\]}\] for combination: '
        r'\[n5\[A\]\[\]:\[16388\], n41\[A\]\[\]:\[16387\], n71\[A\]\[A\]:\[16385\], n77\[A\]\[\]:\[16390\]\]', 9)
