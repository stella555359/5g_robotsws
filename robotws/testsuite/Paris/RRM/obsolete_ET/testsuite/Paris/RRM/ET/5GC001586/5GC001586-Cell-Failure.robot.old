# prepare the test line
TestLine_preparation
   [Tags]    FULL_RUN    Cellsetup     10MHZ   1586C   1586B
	...       CRT
	5GC001586_Kw_TestSetup.Test Line Preparation for NSA Only    ${TestDSS10Mhz_1586_M1}
    5GC001586_Kw_TestSetup.Test Line Preparation                 ${TestDSS10Mhz_1586_M1}

TestLine_1586_Test_setup
    [Tags]    FULL_RUN    Cellsetup     10MHZ   1586C   1586B
	...       CRT
    [Documentation]     Cellsetup Dss , BW= 10MHz, DL RATIO = 70%
    [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    ...                       common_Dss_Keywords.Get testcase log directory    AND
    ...                       5GC001586_Keywords.Clean Up Env
    5GC001586_Kw_TestSetup.Test Setup 1586 M    ${TestDSS10Mhz_1586_M1}
    robot_extension.Run Keyword And Warn On Failure     btslog.Start Btslog
    5GC001586_Keywords.TC 1586-CellSetup        ${TestDSS10Mhz_1586_M1}
    [Teardown]      Run Keywords   robot_extension.Run Keyword And Warn On Failure    btslog.Stop Btslog    target_dir=${testCaseDir}
    ...               AND          set Suite Variable  ${testCaseDir}  None
    ...               AND          GenericTest.Display diagnosis

