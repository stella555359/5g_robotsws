import os
import logging
from robot.libraries.BuiltIn import BuiltIn
from testsuite.Paris.RRM.ET.CNI_87162.resources.suite_specific_keywords import (
    get_test_prefix, logger_console, logger_warning, logger_console_info
)
from testsuite.Paris.RRM.ET.resources_KRK.python.ttitraces_management import (
    create_list_from_tti_trace_csv,
    create_list_from_column,
    filter_tti_traces_by_column_and_value,
    filter_out_tti_traces_with_value,
    filter_out_tti_traces_with_different_values_than
)


def get_tti_logs_parsed_path(path_override=None):
    output_dir = BuiltIn().get_variable_value("${OUTPUT_DIR}")
    tti_trace_dir = path_override if path_override is not None else BuiltIn().get_variable_value("${TTI_TRACE_DIR}")
    return os.path.join(output_dir, get_test_prefix(), tti_trace_dir)


def verify_if_ethscaled_changed(scell_ids, path_override=None):
    tti_data = create_list_from_tti_trace_csv('dl', path_override=get_tti_logs_parsed_path(path_override))
    scell_tti_traces = filter_out_tti_traces_with_different_values_than(tti_data, column='physCellId',
                                                                        values=scell_ids)
    scell_tti_traces_no_blanks = filter_out_tti_traces_with_value(
        scell_tti_traces, column='dlFlowControlData.ethScaled', value=""
    )
    ethscaled_list = create_list_from_column(scell_tti_traces_no_blanks, column_name='dlFlowControlData.ethScaled')
    ethscaled_values_dist = set(ethscaled_list)
    logging.debug("ethScaled distinct values: {}".format(ethscaled_values_dist))
    assert len(ethscaled_values_dist) != 0, "There are none distinct ethScaled values!"
    assert len(ethscaled_list) > 1, "There was no more than 1 entries for ethScaled!"
