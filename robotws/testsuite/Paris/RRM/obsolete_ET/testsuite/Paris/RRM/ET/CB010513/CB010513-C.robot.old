*** Variables ***

# capture setting
&{CAPTURE_OFF}                                  is_capture_l1l2=${False}
...                                             is_capture_core=${False}
...                                             is_capture_cprt=${False}

&{CAPTURE_INVES}                                is_capture_l1l2=${False}
...                                             is_capture_core=${False}
...                                             is_capture_cprt=${False}
# tests settings
&{CB010513_C_1_SA}                              dir=UL+DL
...                                             total_nb_ue=0                           # total number of ue's to configure
...                                             total_nb_cell=3                         # total number of cell used for ue's dispatching
...                                             target_gnb=2                            # gnb target id
...                                             capture_duration=0                      # capture duration during traffic starting phase
...                                             duration=3                              # traffic duration during declaration phase
...                                             deviation=50                            # allowed deviation for throughput
...                                             pm_waiting_period=2                     # number of waiting periods added for observation

# ue's settings
&{dict_settings_ue_1}                           original_cell=1                         # original cell for call establishment
...                                             sa_nwslice=1
...                                             throughput=500                          # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                             throughput_gbr=${NO_THROUGHPUT}         # dl throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                             throughput_ul=2                         # ul throughput nonGBR for ue or ${NO_THROUGHPUT}

&{dict_settings_ue_2}                           original_cell=1
...                                             sa_nwslice=2
...                                             throughput=400
...                                             throughput_gbr=15
...                                             throughput_ul=2

&{dict_settings_ue_3}                           original_cell=2
...                                             sa_nwslice=1
...                                             throughput=200
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=2

&{dict_settings_ue_4}                           original_cell=2
...                                             sa_nwslice=2
...                                             throughput=100
...                                             throughput_gbr=15
...                                             throughput_ul=2

&{dict_settings_ue_5}                           original_cell=3
...                                             sa_nwslice=1
...                                             throughput=50
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=2

&{dict_settings_ue_6}                           original_cell=3
...                                             sa_nwslice=2
...                                             throughput=250
...                                             throughput_gbr=15
...                                             throughput_ul=2

&{dict_settings_ue_default}                     original_cell=1
...                                             sa_nwslice=1
...                                             throughput=200
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=2

@{dict_settings_all_ues}                        ${dict_settings_ue_1}
...                                             ${dict_settings_ue_2}
...                                             ${dict_settings_ue_3}
...                                             ${dict_settings_ue_4}
...                                             ${dict_settings_ue_5}
...                                             ${dict_settings_ue_6}

# vendor's setting
&{VENDOR_CUSTOM_1}                              bb_hw_variant=ABIO
...                                             max_num_layer_prb_l1_sp=${NUM_MAX_LAYER_PRB_L1_SP}
...                                             max_num_stream_prb_l1_sp=${NUM_MAX_STREAM_PRB_L1_SP}
...                                             max_num_wb_stream_prb_l1_sp=${NUM_MAX_WB_STREAM_PRB_L1_SP}
