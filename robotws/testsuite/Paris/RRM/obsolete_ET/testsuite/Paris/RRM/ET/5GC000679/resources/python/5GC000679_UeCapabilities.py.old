import luashark_tools as analyzer
import StringTool


def ptrsFlagCheck(flagPtrs, flagOK):
    result = int(flagOK)
    if (int(flagPtrs) == 1):
        result += 1
    return result


def ptrsTimeDensityCheck(flagPtrsTimeDensity, flagOK):
    result = int(flagOK)
    if (int(flagPtrsTimeDensity) == 1):
        result += 1
    return result


def ptrsFrequencyDensityCheck(flagPtrsFrequencyDensity, flagOK, numOfPrb, threshold):
    result = int(flagOK)
    _numOfPrb = int(numOfPrb, 16)
    if (((int(flagPtrsFrequencyDensity) == 2) and (_numOfPrb < int(threshold))) or
            ((int(flagPtrsFrequencyDensity) == 4) and (_numOfPrb > int(threshold)))):
        result += 1
    return result


def checkPercentage(totalOK, totalMessages):
    result = dict()
    okResult = (int(totalOK) / int(totalMessages))*100
    nokResult = 100-okResult
    return "{}:{}".format(okResult, nokResult)


def verifyUeCapabilities(pdmlFile, packetName=None, filter="", path=None,
                         noPathIsError=True, startPacket=1, endPacket=-1, debugFilter=False):
    listSubPacket = get_match_from_path(pdmlFile, packetName, filter, path, noPathIsError, startPacket, endPacket,
                                        debugFilter)
    StringTool.datedConsole("listSubPacket = {}".format(listSubPacket))


def extractPdml(filePdml, namePacket, listPath):
    test = analyzer.analyzer()
    return test.get_match_from_paths(pdmlFile=filePdml, packetName='uldata_pucchreceivereq',
                                     pathList='slot    sfn    rnti    pucchFormat    startPrb    nANPucch  \
                                              numOfSymbols')
