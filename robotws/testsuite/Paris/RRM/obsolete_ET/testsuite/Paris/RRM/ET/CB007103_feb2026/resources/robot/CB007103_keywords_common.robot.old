${delta_file_iso_SetBeamForming}       ${TestsJsonPath}/scf_setBF_Cell1_Cell2.json
${delta_file_iso_UnSetBeamForming}     ${TestsJsonPath}/scf_unsetBF_Cell1_Cell2.json
${UnSetBForming_nochannelpresent}     ${TestsJsonPath}/scf_unsetBF_Cell1_Cell2_light.json
${delta_file_iso_UnSetBF_C1C2_cha}     ${TestsJsonPath}/scf_unsetBF_channel_Cell1_Cell2.json
${delta_file_iso_SetUlDftsOfdm}        ${TestsJsonPath}/scf_UlDftsOfdm_activ_Cell1_Cell2.json

@{ManagedObjectList}                       #check of oject is only done on cell-1 as Cell-2 is always on same state
...    MRBTS-1/NRBTS-1/NRULCLPC_PROFILE-0
...    MRBTS-1/MNL-1/MNLENT-1/CELLMAPPING-1/LCELNR-1/CHANNELGROUP-1/CHANNEL-5
...    MRBTS-1/MNL-1/MNLENT-1/CELLMAPPING-1/LCELNR-1/CHANNELGROUP-1/CHANNEL-6
...    MRBTS-1/MNL-1/MNLENT-1/CELLMAPPING-1/LCELNR-1/CHANNELGROUP-1/CHANNEL-7
...    MRBTS-1/MNL-1/MNLENT-1/CELLMAPPING-1/LCELNR-1/CHANNELGROUP-1/CHANNEL-8

${scf_type}                           Vdu
#FTS------------------------------------------------------------------------

*** Keywords ***
#FTS------------------------------------------------------------------------

# RadParam block ------------------------------------------------------------------------------------------------------
Set_RadParameters
    [Documentation]      Add or Modify the RAD params

    Dated Log New Line   Add RAD params for CB07103

    @{listraddic}=                                   Create list

    FOR     ${idx}     IN                            @{radList}

                Run Keyword If                       '${idx.value}' != '${EMPTY}'
                ...                                  Run keywords      dated log    -----> ${idx.field}=${idx.value}
                ...  AND                             Append To List    ${listraddic}    ${idx}
    END

    kwmkt_dbg_log                                    rad_param_dic= ${listraddic}
    SetConfig.Set Fields in swconfig DU              param_list=${listraddic}

# END RadParam block --------------------------------------------------------------------------------------------------
# basic block ---------------------------------------------------------------------------------------------------------
Set_basic_context
    [Documentation]    Adds basic.cfg elements for CB07103.
    ...                Adapts basic.cfg for each engaged UE.
    ...                Sets UE on a specific cell if a target cell is defined.
    ...                Sets UE context if UE NR capabilities are defined.

    Dated Log New Line   Add basic.cfg elements for CB07103

    FOR     ${idx}     IN                            @{param.ListOfUeEngaged}
            kwmkt_dbg_log                            basic.cfg adaptation for UE=${idx.ueid}

            Run Keyword If                          '${idx.Target_cell}'!='${EMPTY}'    kwmkt_SetUExonCelly    ${idx.ueid}    ${idx.Target_cell}
            Run Keyword If                          '${idx.ue_nr_capabilities}'!='${EMPTY}'
            ...                                      kwmkt_Set_Context_basic
            ...                                      ue_id_used=${idx.ueid}
            ...                                      capa=${idx.ue_nr_capabilities}
            ...                                      release=${idx.ue_release}
            ...                                      APPdcpPacketTrunc=${True}
    END

#RDH-ticket72: Update UE Id VRAN Case
Set_basic_context_VRAN
    [Documentation]    Adds basic.cfg elements for CB07103.
    ...                Get SA ueid from basic.cfg file to update the param.ListOfUeEngaged
    ...                Adapts basic.cfg for each engaged UE.
    ...                Sets UE on a specific cell if a target cell is defined.
    ...                Sets UE context if UE NR capabilities are defined.

    Dated Log New Line   Add basic.cfg elements for CB07103

    Create Dict of 1rst SA UE Id
    Set To Dictionary                               ${UE_1_SA_TDD_UE_R16}               ueid=${Dict_1st_SA_UE_Id}[NRCELL-1]
    Set To Dictionary                               ${UE_2_SA_TDD_UE_R16}                   ueid=${Dict_1st_SA_UE_Id}[NRCELL-2]
    @{uelist}                                       create list                             ${UE_1_SA_TDD_UE_R16}    ${UE_2_SA_TDD_UE_R16}
    ${result}=                                      set to dictionary                       ${param}        ListOfUeEngaged=${uelist}
    kwmkt_dbg_log                                   ${result} is set to ${param}

    FOR     ${idx}     IN                            @{param.ListOfUeEngaged}
            kwmkt_dbg_log                            basic.cfg adaptation for UE=${idx.ueid}

            Run Keyword If                          '${idx.Target_cell}'!='${EMPTY}'    kwmkt_SetUExonCelly    ${idx.ueid}    ${idx.Target_cell}
            Run Keyword If                          '${idx.ue_nr_capabilities}'!='${EMPTY}'
            ...                                      kwmkt_Set_Context_basic
            ...                                      ue_id_used=${idx.ueid}
            ...                                      capa=${idx.ue_nr_capabilities}
            ...                                      release=${idx.ue_release}
            ...                                      APPdcpPacketTrunc=${True}
    END

# END basic block -----------------------------------------------------------------------------------------------------
# SCF NIDD block  -----------------------------------------------------------------------------------------------------

Set_SCF_ConfigMarket
    [Documentation]    Sets up the test configuration based on the SCF component.
    ...                Determines if an upgrade is needed to reach ISO level based on the board type.
    ...                Logs the need for ISO, BeamForming, power control, and UlDftSOfdm.
    ...                Retrieves the SCF file and loads it.
    ...                Checks if the managed object list is in the SCF.
    ...                Determines the JSON files to use based on the SCF setup.
    ...                Runs the appropriate keyword based on the need for ISO, BeamForming, power control, and UlDftSOfdm.
    ...                Performs the commissioning step, combining JSON files if necessary.
    ...                Waits for OAM to be available after commissioning.

    [Arguments]                                    ${scfcompo}
    Dated Log New Line                             KW:Set_SCF_ConfigMarket ${scfcompo}

    ${CommissionToDo}=                             set variable            ${True}
    Set Suite Variable                             ${CommissionToDo}

    # Upgrade the SCF to reach ISo Level depending hardware (ABIO topology is already iso)
    ${needISO}=                        Set Variable    ${False}
    kwmkt_dbg_log                    GNB_DU.sys[0].M.boardType: ${GNB_DU.sys[0].M.boardType}

	Run Keyword If                   '${GNB_DU.sys[0].M.boardType}' != 'ASOH'
    ...                              kwmkt_dbg_log                      GNB_DU.bb[0].M.boardType: ${GNB_DU.bb[0].M.boardType}

    ${needISO}=                      Set Variable If    '${GNB_DU.sys[0].M.boardType}' == 'ASOH'    ${False}    ${True}
    ${needISO}=                      Set Variable If    '${GNB_DU.sys[0].M.boardType}' == 'ASIL'    ${False}    ${True}
    ${needISO}=                      Set Variable If    '${GNB_DU.sys[0].M.boardType}' == 'ASIM'    ${True}     ${False}

    Set Global Variable                            ${needISO}


    Run Keyword If    ${needISO}                   Dated Log    ${needISO} => Configuration need to be udated to reach iso level
    ...    ELSE                                    Dated Log    ${needISO} => Configuration Base already up to date with BF Set

    Run Keyword If                     ${isAic}    Run Keywords
    ...                                            Dated Log    VRAN NOT YET AVAILABLE
    ...                                     AND    Return from keyword    FAIL

    ${needBF}=                                     Get From Dictionary    ${ScfCompo}      BeamForming
    ${needPCtrl}=                                  Get From Dictionary    ${ScfCompo}      ULCloseLoopPowerControl
    ${needUlDftSOfdm}=                             Get From Dictionary    ${ScfCompo}      UlDftSOfdm
    Set Global Variable                            ${needBF}
    Set Global Variable                            ${needPCtrl}
    Set Global Variable                            ${needUlDftSOfdm}

    Dated log    >>>> needISO ${needISO} / needBF ${needBF} / needPCtrl ${needPCtrl} / needUlDftSOfdm ${needUlDftSOfdm} <<<<

    # First : Get the SCF
    ${scf_file}                                   run keyword if      "${scf_type}" == "Vdu"
    ...                                                                                    OAM Get SCF File
    ...                                                                                    dir=${LOG_PATH}
    ...                                                                                    file=SCF_VDU.xml
    ...                                                                                    oam=${GNB_DU.oam}
    ...                                                      ELSE
    ...                                                                                    OAM Get SCF File
    ...                                                                                    dir=${LOG_PATH}
    ...                                                                                    file=SCF_VCU.xml
    ...                                                                                    oam=${GNB_CU.oam}

    # Second Step: Load the SCF file
    Dated Log                       Load the ${scf_type} SCF
    run keyword if                  "${scf_type}" == "Vdu"
    ...                                                 multiScf.load scf       scf_path=${scf_file}
    ...         ELSE                                    multiScf.load scf       second_scf_path=${scf_file}

    Dated Log New Line              Is the following dist_names list in the ${scf_type} SCF ?
    Dated Log                       ${ManagedObjectList}               #check of oject is only done on cell-1 as Cell-2 is always on same state
    ${boolean_res_list}                 multiScf.is_object_list_in_scf
    ...                                 scope=both
    ...                                 aicListEntity=${scf_type}
    ...                                 dist_name_list=${ManagedObjectList}
    Dated Log                       ==> the "is_object_list_in_scf()" response is: ${boolean_res_list}

    ${V1}=                   Check_List_Booleans    ${boolean_res_list}
    Set Global Variable      ${V1}
    Dated log                V1 ----------------------------------------------------: ${V1}

    # by default fresh json (with create instruction) are set, if Check_List_Booleans return true this higlight the scf was already set correctly
    # so following json with update instruction are used

    ${MPAPLOisoLOAPLO_WITH_BF}=             Set Variable If    '${V1}' == 'True'  #and '${GNB_DU.bb[0].M.boardType}' == 'ABIP'
    ...                                                                    ${TestsJsonPath}/scf_MPAPLOisoLOAPLO_WITH_BF_Cell1_Cell2.json
    ...                                                                    ${TestsJsonPath}/scf_MPAPLOisoLOAPLO_WITH_BF_Cell1_Cell2_fresh.json

    ${delta_file_iso_ULCL_powerCtrl}=       Set Variable If    '${V1}' == 'True'  #and '${GNB_DU.bb[0].M.boardType}' == 'ABIP'
    ...                                                                    ${TestsJsonPath}/scf_ULCL_powerCtrl_Cell1_Cell2.json
    ...                                                                    ${TestsJsonPath}/scf_ULCL_powerCtrl_Cell1_Cell2_fresh.json


    Set Suite Variable     ${MPAPLOisoLOAPLO_WITH_BF}
    Set Suite Variable     ${delta_file_iso_ULCL_powerCtrl}

    Dated log                Json file used will be ${MPAPLOisoLOAPLO_WITH_BF} & ${delta_file_iso_ULCL_powerCtrl}


    #Combinatory
    # headers             neediso            needBF            needPCtrl            needUlDftSOfdm    actionList
    Run Keyword if   not ${neediso} and not ${needBF} and not ${needPCtrl} and not ${needUlDftSOfdm}                   retrait_BF
    Run Keyword if   not ${neediso} and not ${needBF} and not ${needPCtrl} and ${needUlDftSOfdm}                       retrait_BF_Setofdm
    Run Keyword if   not ${neediso} and not ${needBF} and ${needPCtrl} and not ${needUlDftSOfdm}                       retrait_BF_SetPctrl
    Run Keyword if   not ${neediso} and not ${needBF} and ${needPCtrl} and ${needUlDftSOfdm}                           retrait_BF_SetPctrl_Setofdm
    Run Keyword if   not ${neediso} and ${needBF} and not ${needPCtrl} and not ${needUlDftSOfdm}                       nothingToDo
    Run Keyword if   not ${neediso} and ${needBF} and not ${needPCtrl} and ${needUlDftSOfdm}                           ofdm
    Run Keyword if   not ${neediso} and ${needBF} and ${needPCtrl} and not ${needUlDftSOfdm}                           SetPctrl
    Run Keyword if   not ${neediso} and ${needBF} and ${needPCtrl} and ${needUlDftSOfdm}                               SetPctrl_Setofdm
    Run Keyword if       ${neediso} and not ${needBF} and not ${needPCtrl} and not ${needUlDftSOfdm}                   Iso_retrait_BF
    Run Keyword if       ${neediso} and not ${needBF} and not ${needPCtrl} and ${needUlDftSOfdm}                       Iso_retrait_BF_Setofdm
    Run Keyword if       ${neediso} and not ${needBF} and ${needPCtrl} and not ${needUlDftSOfdm}                       Iso_retrait_BF_SetPctrl
    Run Keyword if       ${neediso} and not ${needBF} and ${needPCtrl} and ${needUlDftSOfdm}                           Iso_unsetBF_SetPctrl_Setofdm
    Run Keyword if       ${neediso} and ${needBF} and not ${needPCtrl} and not ${needUlDftSOfdm}                       Iso
    Run Keyword if       ${neediso} and ${needBF} and not ${needPCtrl} and ${needUlDftSOfdm}                           Iso_ofdm
    Run Keyword if       ${neediso} and ${needBF} and ${needPCtrl} and not ${needUlDftSOfdm}                           Iso_SetPctrl
    Run Keyword if       ${neediso} and ${needBF} and ${needPCtrl} and ${needUlDftSOfdm}                               Iso_SetPctrl_Setofdm

    # commissioning
    #                  on this step, list of json file to merge is ready in  @{jsonFilesList} list

    # Set Cases
    kwmkt_dbg_log                                                  jsonFilesList= ${jsonFilesList}
    ${lngt}=                                                       Get Length    ${jsonFilesList}
    kwmkt_dbg_log                                                  Lngt of jsonFilesList is ${lngt}

    taf_sbts_coam.connect_to                                       name=${gnb_alias}

    ${jsonAlone}       Run Keyword if                             '${lngt}' == '1'    Get From List    ${jsonFilesList}    0
    Run Keyword if    '${lngt}' == '1' and ${CommissionToDo}       sweng_coam_parameter.perform_scf_delta_commission    timeout=300
    ...                                                            delta_file=${jsonAlone}
    ...                                                            connection=${gnb_alias}
    ...                                                            skip_parameter_relation_errors=${True}

    Run Keyword if    '${lngt}' > '1' and ${CommissionToDo}        sweng_coam_parameter.combine_json_files
    ...                                                            jsonFilesList=${jsonFilesList}
    ...                                                            mergedJsonFile=${LOG_PATH}/mergedJsonFile.json
    Run Keyword if    '${lngt}' > '1' and ${CommissionToDo}        sweng_coam_parameter.perform_scf_delta_commission    timeout=300
    ...                                                            delta_file=${LOG_PATH}/mergedJsonFile.json
    ...                                                            connection=${gnb_alias}
    ...                                                            skip_parameter_relation_errors=${True}

    Run Keyword if    ${CommissionToDo}                            Run keywords
    ...                                                            Dated Log New Line  "OAM wait available ..."
    ...         AND                                                OAM wait available
    ...         AND                                                Dated Log  "OAM wait available => OK"

    Set Variable if    ${CommissionToDo}    ${True}               #For any eventual next commissioning
    Set Global Variable                   ${CommissionToDo}

Check_List_Booleans
    [documentation]       use to check if all boolean element of an boolean list are all True or all False.
    ...                   Discrimination is done on last index of the list
    ...                   MP_AP_LO first run =>  FFFFF <<<<< lead to json _fresh usage (object creation)
    ...                   MP_AP_LO next  run =>  TTTTT
    ...                   LO_AP_LO first run =>  FTTTT <<<<< lead to json _fresh usage (object creation)
    ...                   LO_AP_LO next  run =>  TTTTT

    [Arguments]           ${list}
    kwmkt_dbg_log         "--Check List Booleans--"

    # ${idx}=      Set Variable    0
    # ${first}=    Set Variable    ${list}[${idx}]       #we compare the fist elem of the list. if another one is different
    # ${idx}=      evaluate    ${idx}+1
    # FOR    ${element}    IN    @{list}
    #     Dated log    idx = ${idx}
    #     # Run Keyword If    ${element} != ${first}    FAIL  scf can't have just a part of MO set
    #     ${idx}=      evaluate    ${idx}+1
    # END

    Return From Keyword    ${list}[0]                # for discrimination only first index list value is return


nothingToDo
    [Documentation]    Logs that there is nothing to do.
    ...                Sets a global variable indicating that there is no commission to do.

    Dated log    "--nothingToDo--"
    ${CommissionToDo}=    set variable    ${False}
    Set Global Variable                   ${CommissionToDo}

retrait_BF
    [Documentation]    Sets up test with conditions for BeamForming.
    ...                Creates a list of JSON files and sets it as a global variable.
    ...                Logs the start of the setup and the usage of the JSON files list.

    Dated log    "--retrait_BF--"
    @{jsonFilesList}=    Create List    ${delta_file_iso_UnSetBeamForming}
    Set Global Variable                 ${jsonFilesList}
    Dated log       usage of jsonFilesList >${jsonFilesList}<

retrait_BF_Setofdm
    [Documentation]    Sets up test with conditions for BeamForming and OFDM.
    ...                Creates a list of JSON files and sets it as a global variable.
    ...                Logs the start of the setup and the usage of the JSON files list.

    Dated log    "--retrait_BF / ofdm--"
    @{jsonFilesList}=    Create List    ${delta_file_iso_SetUlDftsOfdm}    ${delta_file_iso_UnSetBeamForming}
    Set Global Variable                 ${jsonFilesList}
    Dated log       usage of jsonFilesList >${jsonFilesList}<

retrait_BF_SetPctrl
    [Documentation]    Sets up test with conditions for BeamForming and power control.
    ...                Depending on the need for BeamForming, different JSON files are used.
    ...                Logs the start of the setup, the need for BeamForming, and the usage of the JSON files list.

    Dated log    "--retrait_BF / pwcontrol--"
    # @{jsonFilesList}=    Create List    ${delta_file_iso_ULCL_powerCtrl}    ${delta_file_iso_UnSetBeamForming}
    # Set Global Variable                 ${jsonFilesList}
    Dated log    needBF ${needBF}
    @{jsonFilesList}=    Run Keyword If    '${needBF}' == '${True}'
    ...                                     Create List    ${delta_file_iso_ULCL_powerCtrl}    ${delta_file_iso_UnSetBeamForming}
    ...                  ELSE               Create List    ${delta_file_iso_ULCL_powerCtrl}    ${delta_file_iso_UnSetBeamForming}
    ...                                                    ${delta_file_iso_UnSetBF_C1C2_cha}
    Set Global Variable                    ${jsonFilesList}
    Dated log       usage of jsonFilesList >${jsonFilesList}<

retrait_BF_SetPctrl_Setofdm
    [Documentation]    Sets up test with conditions for BeamForming, power control, and OFDM.
    ...                Depending on the need for BeamForming and if it's the first run, different JSON files are used.
    ...                Logs the start of the setup, the need for BeamForming, the run number, and the usage of the JSON files list.

    Dated log    "--retrait_BF / pwcontrol / ofdm--"
    # reminder we need following
    # not ${neediso} and not ${needBF} and ${needPCtrl} and ${needUlDftSOfdm}

    # @{jsonFilesList}=    Create List    ${delta_file_iso_ULCL_powerCtrl}    ${delta_file_iso_SetUlDftsOfdm}    ${delta_file_iso_UnSetBeamForming}
    Dated log    needBF ${needBF}
    Dated log    V1 ${V1}
    @{jsonFilesList}=    Run Keyword If    '${needBF}' == '${True}' and '${V1}' == '${False}'    # need BF + First run
    ...                                     FAIL    Case not waited needBF:${needBF} V1:${V1} "--retrait_BF / pwcontrol / ofdm--"
    ...                  ELSE IF           '${needBF}' == '${True}' and '${V1}' == '${True}'     # need BF + not first run
    ...                                     FAIL    Case not waited needBF:${needBF} V1:${V1} "--retrait_BF / pwcontrol / ofdm--"
    ...                  ELSE IF           '${needBF}' == '${False}' and '${V1}' == '${False}'   # NO need BF + First run LO_AP_LO
    ...                                     Create List    ${delta_file_iso_ULCL_powerCtrl}      ${delta_file_iso_SetUlDftsOfdm}
    ...                                                    ${delta_file_iso_UnSetBeamForming}
    ...                  ELSE IF           '${needBF}' == '${False}' and '${V1}' == '${True}'    # NO need BF + not first run LO_AP_LOwoBF
    ...                                     Create List    ${delta_file_iso_ULCL_powerCtrl}      ${delta_file_iso_SetUlDftsOfdm}
    ...                                                    ${UnSetBForming_nochannelpresent}
    ...                  ELSE               FAIL    Case not waited needBF:${needBF} V1:${V1}

    Set Global Variable                 ${jsonFilesList}
    Dated log       usage of jsonFilesList >${jsonFilesList}<

ofdm
    [Documentation]    Sets up OFDM.
    ...                Creates a list of JSON files and sets it as a global variable.
    ...                Logs the start of the setup and the usage of the JSON files list.

    Dated log    "--ofdm--"
    @{jsonFilesList}=    Create List    ${delta_file_iso_SetUlDftsOfdm}
    Set Global Variable                 ${jsonFilesList}
    Dated log       usage of jsonFilesList >${jsonFilesList}<

SetPctrl
    [Documentation]    Sets up power control.
    ...                Creates a list of JSON files and sets it as a global variable.
    ...                Logs the start of the setup and the usage of the JSON files list.

    Dated log    "--pwcontrol--"
    @{jsonFilesList}=    Create List    ${delta_file_iso_ULCL_powerCtrl}
    Set Global Variable                 ${jsonFilesList}
    Dated log       usage of jsonFilesList >${jsonFilesList}<

SetPctrl_Setofdm
    [Documentation]    Sets up power control and OFDM.
    ...                Creates a list of JSON files and sets it as a global variable.
    ...                Logs the start of the setup and the usage of the JSON files list.

    Dated log    "--pwcontrol / ofdm--"
    @{jsonFilesList}=    Create List    ${delta_file_iso_ULCL_powerCtrl}    ${delta_file_iso_SetUlDftsOfdm}
    Set Global Variable                 ${jsonFilesList}
    Dated log       usage of jsonFilesList >${jsonFilesList}<

Iso_retrait_BF
    [Documentation]    Sets up Iso test with conditions for BeamForming.
    ...                Creates a list of JSON files and sets it as a global variable.
    ...                Logs the start of the setup and the usage of the JSON files list.

    Dated log    "--Iso_retrait_BF--"
    @{jsonFilesList}=    Create List    ${MPAPLOisoLOAPLO_WITH_BF}    ${delta_file_iso_UnSetBeamForming}
    Set Global Variable                 ${jsonFilesList}
    Dated log       usage of jsonFilesList >${jsonFilesList}<

Iso_retrait_BF_Setofdm
   [Documentation]     Sets up Iso test with conditions for BeamForming and OFDM.
    ...                Creates a list of JSON files and sets it as a global variable.
    ...                Logs the start of the setup and the usage of the JSON files list.

    Dated log    "--Iso_retrait_BF / ofdm--"
    @{jsonFilesList}=    Create List    ${MPAPLOisoLOAPLO_WITH_BF}     ${delta_file_iso_SetUlDftsOfdm}    ${delta_file_iso_UnSetBeamForming}
    Set Global Variable                 ${jsonFilesList}
    Dated log       usage of jsonFilesList >${jsonFilesList}<

Iso_retrait_BF_SetPctrl
    [Documentation]    Sets up Iso test with conditions for BeamForming and power control.
    ...                Creates a list of JSON files and sets it as a global variable.
    ...                Logs the start of the setup and the usage of the JSON files list.

    Dated log    "--Iso_retrait_BF / pwcontrol--"
    @{jsonFilesList}=    Create List    ${MPAPLOisoLOAPLO_WITH_BF}
    ...                                 ${delta_file_iso_ULCL_powerCtrl}    ${delta_file_iso_UnSetBeamForming}
    Set Global Variable                 ${jsonFilesList}
    Dated log       usage of jsonFilesList >${jsonFilesList}<

Iso_unsetBF_SetPctrl_Setofdm
    [Documentation]    Sets up Iso test with conditions for BeamForming, power control, and OFDM.
    ...                Depending on the need for BeamForming and if it's the first run, different JSON files are used.
    ...                Logs the start of the setup, the need for BeamForming, the run number, and the usage of the JSON files list.

    Dated log    "--Iso_retrait_BF / pwcontrol / ofdm--"
    # @{jsonFilesList}=    Create List    ${MPAPLOisoLOAPLO_WITH_BF}    ${delta_file_iso_ULCL_powerCtrl}    ${delta_file_iso_SetUlDftsOfdm}
    # ...                                 ${delta_file_iso_UnSetBeamForming}
    Dated log    needBF ${needBF}
    Dated log    V1 ${V1}
    @{jsonFilesList}=    Run Keyword If    '${needBF}' == '${True}' and '${V1}' == '${False}'    # need BF + First run
    ...                                     FAIL    Case not waited needBF:${needBF} V1:${V1} "--Iso_retrait_BF / pwcontrol / ofdm--"
    ...                  ELSE IF           '${needBF}' == '${True}' and '${V1}' == '${True}'     # need BF + not first run
    ...                                     FAIL    Case not waited needBF:${needBF} V1:${V1} "--Iso_retrait_BF / pwcontrol / ofdm--"
    ...                  ELSE IF           '${needBF}' == '${False}' and '${V1}' == '${False}'   # NO need BF + First run MP_AP_LO
    ...                                     Create List    ${MPAPLOisoLOAPLO_WITH_BF}         ${delta_file_iso_ULCL_powerCtrl}
    ...                                                    ${delta_file_iso_SetUlDftsOfdm}    ${delta_file_iso_UnSetBeamForming}
    ...                  ELSE IF           '${needBF}' == '${False}' and '${V1}' == '${True}'    # NO need BF + not first run MP_AP_LOwoBF
    ...                                     Create List    ${MPAPLOisoLOAPLO_WO_BF}           ${delta_file_iso_ULCL_powerCtrl}
    ...                                                    ${delta_file_iso_SetUlDftsOfdm}    ${UnSetBForming_nochannelpresent}
    ...                  ELSE              FAIL    Case not waited needBF:${needBF} V1:${V1}
    # # Attention Channel on fait / on defait
    Set Global Variable                     ${jsonFilesList}
    Dated log       usage of jsonFilesList >${jsonFilesList}<

