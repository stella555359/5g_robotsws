# basic block ---------------------------------------------------------------------------------------------------------

Set_basic_context
    [Documentation]    Adds basic.cfg elements for CB07103.
    ...                Adapts basic.cfg for each engaged UE.
    ...                Sets UE on a specific cell if a target cell is defined.
    ...                Sets UE context if UE NR capabilities are defined.

    Dated Log New Line   Add basic.cfg elements for CB07103

    FOR     ${idx}     IN                            @{param.ListOfUeEngaged}
            kwmkt_dbg_log                            basic.cfg adaptation for UE=${idx.ueid}

            Run Keyword If                          '${idx.Target_cell}'!='${EMPTY}'    kwmkt_SetUExonCelly    ${idx.ueid}    ${idx.Target_cell}
            Run Keyword If                          '${idx.ue_nr_capabilities}'!='${EMPTY}'
            ...                                      kwmkt_Set_Context_basic
            ...                                      ue_id_used=${idx.ueid}
            ...                                      capa=${idx.ue_nr_capabilities}
            ...                                      release=${idx.ue_release}
            ...                                      APPdcpPacketTrunc=${True}
    END



Set_cfg_file_dedicated_bearer
    kwmkt_dbg_log       Adding Dedicated bearer
    WtsCfgConfig.startSession
	${line}             getIndexUsingParam   prefix=set_qosflow    paramId=id    paramVal=1
	kwmkt_dbg_log       First line is ${line}
    setConfigLine       configuration=set_qosflow id=4 5qi=7  #TCP
	...                 line=${line+2}
	kwmkt_dbg_log       Added qos_flow on line=${line+2}

    ${line}             getIndexUsingParam   prefix=set_qosflow    paramId=id    paramVal=1
	kwmkt_dbg_log       Second line is ${line}
    setConfigLine       configuration=set_qosrule id=3 proto=tcp qos_flow=4
	...                 line=${line+3}
	kwmkt_dbg_log       Added qos_rules on line=${line+3}

    ${prefix}           Set variable  nwslice_set id=1
    ${oldValue}           getParam        prefix=${prefix}    param=qos_flows    ignore_comments=True
    replaceValue          prefix=${prefix}    occurrence=${-1}
    ...                   param=qos_flows
    ...                   oldValue=${oldValue}
    ...                   newValue=1,2,3,4
    ...                   ignore_comments=True

	${oldValue}           getParam        prefix=${prefix}    param=qos_rules    ignore_comments=True
    replaceValue          prefix=${prefix}    occurrence=${-1}
    ...                   param=qos_rules
    ...                   oldValue=${oldValue}
    ...                   newValue=1,2,3
    ...                   ignore_comments=True
	#deleteConfig        ${line}
    WtsCfgConfig.stopSession



