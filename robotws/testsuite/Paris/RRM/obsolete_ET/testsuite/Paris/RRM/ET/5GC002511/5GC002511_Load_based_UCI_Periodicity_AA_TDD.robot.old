*** Test Cases ***

#
# For TCs AA_1 to AA_4, number of UE used for threshold are based on the number of UE that can be attached.
# Number of UEs are retrieved from :
# https://nokia.sharepoint.com/sites/5GSystemEngineering/RRM_Telecom_TD/CP_Domain/_layouts/15/# Doc.aspx?sourcedoc=
# %7BA4DF2825-1CCF-4E68-920E-5B2EED28355E%7D&file=5G_classic_gNB_DU_Capacity_Requirements.xlsx&action=default&mobileredirect=true
#
# Number of UE are consistent with the configuration used:
# frame structure                       5GC001116_0ms
# chBw [MHz]                            100
# # cells per L1 / Loki Instance        1
# srPeriodicity [slots]                 160
# actBeamforming                        FALSE
# ssBurstSetPeriod [ms]                 20
#prachConfigurationIndex                96
# csiReportPeriodicity [slots]          40
# loadBasedCsiPerThreshold              25%
# Long PUCCH symbols                    14
#
# With this configuration:
#  - Max Nb UE slots20 = 5 => with 50 % threshold, 2,5 so 3 UEs with slots20, others with slots320
#  - Max Nb UE slots40 = 10 => with 25 %, 2,5 so 2 with slots40, others with slots320
#  - Max Nb UE slots20 = 5 => with 75 %, 3,75 so 3 with slots20, others with slots320
#

[1][1.0] 5GC002511_AA_1_FR1_TDD_actLoadCsiPeriodicity OFF

   [Documentation]                 Automation for 2511-AA TC_1
   [Tags]                          CLOUD_5G_I_LO_AP_LO_SANSA_FS_ECPRI_CMWV_TDD    CRT
   ...                             master_classicalbts_all
   ...                             SBTS00    SBTS23R1    SBTS22R4

   # Expected CSI list in the order of UE attachments (from 1 to 5)
   # In this case: 1st UE: 20 slots period
   @{expected_csi_period}          Create List           slots20    slots20    slots20    slots20    slots20


   Generic KW for CSI Periodicity         feature_activation=false
   ...                                    csi_period=slots20
   ...                                    threshold=50Percent
   ...                                    nb_ue=5
   ...                                    expected_csi_configuration=${expected_csi_period}

   # Sleep 15 mn in case of GP overlap
   Traced Sleep  ${pm_reporting_period}

   # Retrieve counters and compare with a reference
   ${status}             Run Keyword If        '${check_counters}' == 'True'       Verify PM Values With Margin     5GC002511_AA_1

   [Teardown]            Test Teardown for 2511


