*** Settings ***
Library     ta_messaging
Library     BuiltIn
Library     String
Library     Collections
Library     suite_specific_keywords.py
Library     egate_actions.py
Library     tti_trace_keywords.py
Library     ../../resources_KRK/python/utilities2.py    WITH NAME    logger

Variables   ta_messaging_filters.py
Variables   ta_messaging_filters_fftt.py

*** Keywords ***
Attach UE and establish PDU session
    [Arguments]    ${ue_id}=1
    Attach UE    ue_id=${ue_id}
    Establish PDU session    ue_id=${ue_id}    gw_id=${ue_id}
    Sleep    3s


Wait for attach to finish
    Sleep   2s


Start traffic
    [Arguments]    ${ue_id}=1    ${ul_mbps}=5    ${dl_mbps}=150
    logger.Logger Console    Start data traffic
    Start DL traffic    ue_id=${ue_id}  trf_id=2  dl_mbps=${dl_mbps}
    Start UL traffic    ue_id=${ue_id}  ul_mbps=${ul_mbps}


Start traffic on bearer 5qi 5
    [Arguments]    ${ue_id}=1    ${ul_mbps}=5    ${dl_mbps}=150
    logger.Logger Console    Start data traffic on bearer 5qi 5
    ${ue_list} =    Create List    ${ue_id}
    start_traffic_for_multiple_ues    number_of_ues=${ue_list}
    ...                                          traffic_direction=bi
    ...                                          ul_mbps=${ul_mbps}
    ...                                          dl_mbps=${dl_mbps}
    ...                                          first_trf_id=1
    ...                                          seconds=${1800}
    ...                                          size=${1358}


Start traffic on bearer 5qi 1
    [Arguments]    ${ue_id}=1
    logger.Logger Console    Start data traffic on bearer 5qi 1
    Start DL traffic on bearer 5qi 1    ue_id=${ue_id}
    Start UL traffic on bearer 5qi 1    ue_id=${ue_id}


Create aliases
    [Arguments]     ${ue_id}
    Create GNB device with alias 'gNB2' identified by ip=10.0.1.2
    Create Ue Alias  alias=UE_${ue_id}  ue_id=${ue_id}  id_type=wts_5g
    Enable internal mirroring for alias  gNB2


Create aliases for gNB
    Create GNB device with alias 'gNB2' identified by ip=10.0.1.2
    Enable internal mirroring for alias  gNB2


Create aliases multi UE for FTF
    Create Ue Alias  alias=UE_4  ue_id=4  id_type=wts_5g
    Create Ue Alias  alias=UE_5  ue_id=5  id_type=wts_5g
    Create Ue Alias  alias=UE_6  ue_id=6  id_type=wts_5g
    Create Ue Alias  alias=UE_7  ue_id=7  id_type=wts_5g
    Create Ue Alias  alias=UE_8  ue_id=8  id_type=wts_5g


Create aliases multi UE for FTT
    Create Ue Alias  alias=UE_12  ue_id=12  id_type=wts_5g
    Create Ue Alias  alias=UE_13  ue_id=13  id_type=wts_5g
    Create Ue Alias  alias=UE_14  ue_id=14  id_type=wts_5g
    Create Ue Alias  alias=UE_15  ue_id=15  id_type=wts_5g
    Create Ue Alias  alias=UE_16  ue_id=16  id_type=wts_5g


Expect PDU messages flow
    [Arguments]     ${ue_id}
    Expect message flow
    ...    gNB2:NGAP_InitialContextSetupRequest as InitialContextSetupRequest
    ...    gNB2:F1AP_UEContextModificationRequest (SCell-ToBeSetupMod-List is present) as UEContextModificationRequest
    ...    gNB2:F1AP_UEContextModificationResponse (sCellToAddModList is present) as UEContextModificationResponse
    ...    gNB2:F1AP_UEContextModificationResponse (sCellToAddModList is present) as UEContextModificationResponse_2nd
    ...    gNB2:F1AP_UEContextModificationResponse (sCellToAddModList is present) as UEContextModificationResponse_3rd
    ...    alias=Established_PDU_UE${ue_id}   overall_timeout=30


Expect PDU messages flow for multi UE
    [Arguments]     ${ue_id}
    Expect message flow
    ...    gNB2:NGAP_InitialContextSetupRequest as InitialContextSetupRequest
    ...    gNB2:F1AP_UEContextModificationRequest (SCell-ToBeSetupMod-List is present) as UEContextModificationRequest
    ...    gNB2:F1AP_UEContextModificationResponse (sCellToAddModList is present) as UEContextModificationResponse
    ...    gNB2:F1AP_UEContextModificationResponse (sCellToAddModList is present) as UEContextModificationResponse_2nd
    ...    alias=Established_PDU_UE${ue_id}   overall_timeout=60


Expect PDU messages flow for VoNR FTF Along drxProf1 grOrEq drxProf2 no fallback
    [Arguments]     ${ue_id}
    Expect message flow
    ...    gNB2:NGAP_InitialContextSetupRequest as InitialContextSetupRequest
    ...    gNB2:F1AP_UEContextModificationRequest (SCell-ToBeSetupMod-List is present) as UEContextModificationRequest
    ...    gNB2:F1AP_UEContextModificationResponse (sCellToAddModList is present) as UEContextModificationResponse
    ...    gNB2:F1AP_UEContextModificationResponse (sCellToAddModList is present) as UEContextModificationResponse_3rd
    ...    gNB2:F1AP_UEContextModificationRequest (DRXCycle is present) as UEContextModificationRequest_2nd
    ...    gNB2:F1AP_UEContextModificationFailure as UEContextModificationFailure
    ...    alias=Established_PDU_UE${ue_id}   overall_timeout=60


Expect PDU messages flow for Non GBR for VoNR
    [Arguments]     ${ue_id}
    Expect message flow
    ...    gNB2:NGAP_InitialContextSetupRequest as InitialContextSetupRequest
    ...    gNB2:F1AP_UEContextModificationRequest (SCell-ToBeSetupMod-List is present) as UEContextModificationRequest
    ...    gNB2:F1AP_UEContextModificationResponse (sCellToAddModList is present) as UEContextModificationResponse
    ...    gNB2:F1AP_UEContextModificationResponse (sCellToAddModList is present) as UEContextModificationResponse_3rd
    ...    gNB2:F1AP_UEContextModificationRequest as UEContextModificationRequest_2nd
    ...    gNB2:F1AP_UEContextModificationFailure as UEContextModificationFailure
    ...    alias=Established_PDU_UE${ue_id}   overall_timeout=30


Expect PDU session modify message flow for VoNR
    [Arguments]     ${ue_id}
    Expect message flow
    ...    gNB2:NGAP_PDUSessionResourceModifyRequest as PDUSessionResourceModifyRequest
    ...    gNB2:F1AP_UEContextModificationResponse (drx-Config is present) as UEContextModificationResponse
    ...    gNB2:F1AP_UEContextModificationResponse (drx-Config is present) as UEContextModificationResponse_2nd
    ...    alias=Modify_PDU_UE${ue_id}   overall_timeout=30


Expect PDU session modify message flow for Non GBR for VoNR after
    [Arguments]     ${ue_id}
    Expect message flow
    ...    gNB2:NGAP_PDUSessionResourceModifyResponse as NGAP_PDUSessionResourceModifyResponse
    ...    gNB2:F1AP_UEContextModificationRequest (DRXCycle is present) as UEContextModificationRequest
    ...    gNB2:F1AP_UEContextModificationFailure as UEContextModificationFailure
    ...    alias=Modify_PDU_UE${ue_id}   overall_timeout=30


Expect PDU session modify message flow for VoNR after
    [Arguments]     ${ue_id}
    Expect message flow
    ...    gNB2:NGAP_PDUSessionResourceModifyRequest as PDUSessionResourceModifyRequest
    ...    gNB2:NGAP_PDUSessionResourceModifyResponse as PDUSessionResourceModifyResponse
    ...    gNB2:F1AP_UEContextModificationRequest (DRXCycle is present) as UEContextModificationRequest_2nd
    ...    gNB2:F1AP_UEContextModificationFailure as UEContextModificationFailure
    ...    alias=Modify_PDU_UE${ue_id}   overall_timeout=30

Expect PDU session modify message flow for VoNR after drxStOffset_drxSlotOffset not found
    [Arguments]     ${ue_id}
    Expect message flow
    ...    gNB2:NGAP_PDUSessionResourceModifyRequest as PDUSessionResourceModifyRequest
    ...    gNB2:F1AP_UEContextModificationResponse (drx-Config is present) as UEContextModificationResponse
    ...    gNB2:F1AP_UEContextModificationResponse (drx-Config is present) as UEContextModificationResponse_2nd
    ...    gNB2:F1AP_UEContextModificationResponse (drx-Config is present) as UEContextModificationResponse_3rd
    ...    alias=Modify_PDU_UE${ue_id}   overall_timeout=30


Check if PDU session modify messages flow occurred
    [Arguments]     ${ue_id}
    Flow occurred as expected  alias=Modify_PDU_UE${ue_id}
    logger.Logger Console    Pcap message flow occured as excepted


Check if PDU messages flow occurred
    [Arguments]     ${ue_id}
    Flow occurred as expected  alias=Established_PDU_UE${ue_id}
    logger.Logger Console    Pcap message flow occured as excepted


Verify fiveQI QosFlowSetupRequestList after VONR for 3CC CA in INIT CON SET REQ
    [Arguments]     ${ue_id}=10
    Verify That Message Fulfills Query
    ...      ${fiveQI_one_value_on_QosFlowSetupRequestList_after_VONR_for_3CC_CA_in_INIT_CON_SET_REQ}
    ...  message_alias=InitialContextSetupRequest
    ...  flow_alias=Established_PDU_UE${ue_id}


Verify fiveQI QosFlowSetupRequestList after VONR for 3CC CA in PDU SES RSC MOD REQ
    [Arguments]     ${ue_id}=10
    Verify That Message Fulfills Query
    ...      ${fiveQI_one_value_QosFlowSetupRequestList_after_VONR_for_3CC_CA_in_PDU_SES_RSC_MOD_REQ}
    ...  message_alias=PDUSessionResourceModifyRequest
    ...  flow_alias=Modify_PDU_UE${ue_id}


Verify fiveQI QosFlowSetupRequestList along VONR for 3CC CA in INIT CON SET REQ
    [Arguments]     ${ue_id}=10
    Verify That Message Fulfills Query
    ...      ${fiveQI_two_values_on_QosFlowSetupRequestList_along_VONR_for_3CC_CA_in_INIT_CON_SET_REQ}
    ...  message_alias=InitialContextSetupRequest
    ...  flow_alias=Established_PDU_UE${ue_id}


Verify drx Config in UE_CON_MOD_RESP
    [Arguments]     ${ue_id}=10    ${inactivity_timer}=${None}    ${on_duration_timer}=${None}
    ...             ${retransmission_timer_dl}=${None}    ${retransmission_timer_ul}=${None}
    ...             ${long_cycle_start_offset}=${None}    ${slot_offset}=${None}
    ...             ${message_alias}=UEContextModificationResponse_3rd
    ...             ${flow_alias}=Established_PDU_UE
    ${query} =   Get drx config query    inactivity_timer=${inactivity_timer}    on_duration_timer=${on_duration_timer}
    ...                                  retransmission_timer_dl=${retransmission_timer_dl}    slot_offset=${slot_offset}
    ...                                  retransmission_timer_ul=${retransmission_timer_ul}    long_cycle_start_offset=${long_cycle_start_offset}
    Verify That Message Fulfills Query
    ...      ${query}
    ...  message_alias=${message_alias}
    ...  flow_alias=${flow_alias}${ue_id}


Verify drx Cycle with drxprofile2 for 3CC CA in UE CON MOD REQ
    [Arguments]     ${ue_id}=6
    ${longDRXCycleLength}  BuiltIn.Set Variable   40
    ${query} =   String.Format String   ${drx_Cycle_for_3CC_CA_in_UE_CON_MOD_REQ}   ${longDRXCycleLength}
    Verify That Message Fulfills Query
    ...      ${query}
    ...  message_alias=UEContextModificationRequest_2nd
    ...  flow_alias=Established_PDU_UE${ue_id}


Verify drx Cycle with drxprofile1 for 3CC CA in UE CON MOD REQ
    [Arguments]     ${ue_id}=10    ${longDRXCycleLength}=160    ${flow_alias}=Established_PDU_UE
    ${query} =   String.Format String   ${drx_Cycle_for_3CC_CA_in_UE_CON_MOD_REQ}   ${longDRXCycleLength}
    Verify That Message Fulfills Query
    ...      ${query}
    ...  message_alias=UEContextModificationRequest_2nd
    ...  flow_alias=${flow_alias}${ue_id}


Verify maxMIMO Layers for 3CC CA in UE CON MOD RESP
    [Arguments]     ${ue_id}=6     ${message}=UEContextModificationResponse_3rd     ${scell_variant}=${None}
    Run Keyword If      '${AP_HARDWARE}' == 'ASIL' and '${scell_variant}' == 'FTT'
    ...     Verify That Message Fulfills Query
    ...         ${maxMIMO_Layers_for_3CC_CA_in_UE_CON_MOD_RESP_FTT_LO}
    ...         message_alias=${message}
    ...         flow_alias=Established_PDU_UE${ue_id}
    ...     ELSE IF     '${AP_HARDWARE}' == 'ASIL' and '${scell_variant}' == 'FTF'
    ...     Verify That Message Fulfills Query
    ...         ${maxMIMO_Layers_for_3CC_CA_in_UE_CON_MOD_RESP_FTF_LO}
    ...         message_alias=${message}
    ...         flow_alias=Established_PDU_UE${ue_id}
    ...     ELSE
    ...     Verify That Message Fulfills Query
    ...         ${maxMIMO_Layers_for_3CC_CA_in_UE_CON_MOD_RESP}
    ...         message_alias=${message}
    ...         flow_alias=Established_PDU_UE${ue_id}


Pcap Verify maxMIMO Layers
    [Arguments]     ${ue_id}=6      ${scells_variant}=${None}
    logger.Logger Console    Verify Pcap messages for maxMimo layers
    Verify maxMIMO Layers for 3CC CA in UE CON MOD RESP     ue_id=${ue_id}  scell_variant=${scells_variant}


Verify cause-misc of failure in UE_CON_MOD_FAIL
    [Arguments]     ${ue_id}=10    ${misc}=not-enough-user-plane-processing-resources   ${flow_alias}=Modify_PDU_UE
    ${query} =   String.Format String     ${failure_cause_in_misc_in_UE_CON_MOD_FAIL}   ${misc}
    Verify That Message Fulfills Query    ${query}
    ...                                   message_alias=UEContextModificationFailure
    ...                                   flow_alias=${flow_alias}${ue_id}


