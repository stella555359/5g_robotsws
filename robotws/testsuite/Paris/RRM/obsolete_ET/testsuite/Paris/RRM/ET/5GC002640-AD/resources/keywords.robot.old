Start TTI trace collection
    ${configurations}=  tcc.Load Configurations
    ...  ${CURDIR}/tti_trace_collectors.yaml
    ${webservices}=  Set To Dictionary    ${configurations['webservices'][0]}    release=${RELEASE_NO_CONV}
    ${configurations}=  Set To Dictionary    ${configurations}    webservices=${webservices}
    tcc.Create Collectors
    ...  names=l2stream3
    ...  configurations=${configurations['collectors']}
    tcl.Set Suite Alias
    ...  alias=l2stream3
    tcc.Setup Collectors
    ...  names=l2stream3
    tcc.Start Collectors
    ...  names=l2stream3
    logger.Logger Console    ${\n}TTI traces collecting started


Stop TTI trace collection
    logger.Logger Console    Stopping TTI traces collecting
    tcc.Stop Collectors
    ...  names=l2stream3
    tcc.Collect Collectors
    ...  names=l2stream3
    tcc.Teardown Collectors
    ...  names=l2stream3


Convert TTI trace from pcap
    [Arguments]  ${format}  ${directory_name}
    ${prefix}   suite_specific_keywords.Get test prefix
    logger.Logger Console    Converting TTI traces to ${format}
    tce.Create eventDecoder Converter
    ...  name=ttitrace_converter
    ...  input_file_path=${OUTPUTDIR}/${SUITENAME}/${TESTNAME}/l2stream3/tcpdump/tcpdump.pcap
    ...  output_file_format=${format}
    ...  output_file_path=${OUTPUTDIR}/${prefix}/${directory_name}/output
    tce.Convert
    ...  name=ttitrace_converter
    Move Directory	${OUTPUTDIR}/${SUITENAME}/${TESTNAME}/l2stream3/tcpdump/  ${OUTPUTDIR}/${prefix}/${directory_name}/
    Remove Directory  ${OUTPUTDIR}/${SUITENAME}/${TESTNAME}/   recursive=True


Collect TTI Traces during
    [Arguments]     ${sec}
    Start TTI trace collection
    Sleep  ${sec}
    Stop TTI trace collection


Register UE and PDU Session and validate msg flow
    [Arguments]    ${ue_id}
    Expect PDU messages flow for multi UE    ue_id=${ue_id}
    Attach UE and establish PDU session     ue_id=${ue_id}
    Check if PDU messages flow occurred     ue_id=${ue_id}


Collect additional logs
    [Arguments]    ${prefix}
    Collect gnb snapshot        output_filepath=${OUTPUT_DIR}/${prefix}/snapshot_gNB_${prefix}.zip
    Collect sos report log      prefix=${prefix}    log_output_dir=${OUTPUT_DIR}/${prefix}
    Collect airphone snapshot   output_filepath=${OUTPUT_DIR}/${prefix}/snapshot_AP_${prefix}.zip


Collect additional logs if test failed
    [Arguments]    ${prefix}
    Run Keyword If Test Failed    Collect additional logs    ${prefix}


Collect snapshot if suite setup failed
    Run keyword If  ${SUITE_SETUP_PASSED} == ${False}    Collect gnb snapshot
    ...                                                  output_filepath=${OUTPUT_DIR}/${SUITE_NAME}/snapshot_gNB_suite.zip


Enforce gNB snapshot collection if requested
    [Arguments]    ${prefix}
    Run Keyword If  '${TEST_STATUS}' == 'PASS' and '${COLLECT_SNAPSHOT}' == 'True'   Collect gnb snapshot
    ...                             output_filepath=${OUTPUT_DIR}/${prefix}/snapshot_gNB_${prefix}.zip


Teardown collecting logs in robot
    ${prefix} =   suite_specific_keywords.Get test prefix
    Teardown collecting logs
    Run Keyword If Test Failed    Stop pcap collecting
    Compress bip logs
    Collect additional logs if test failed    ${prefix}
    Enforce gNB snapshot collection if requested    ${prefix}
    Collect admin api logs    subdir=${prefix}    dir_name=admin_api_logs
    Cleanup logs_dir at teardown


Check TTI Traces for Beam Reports and CSI-RS and CSI Measurements and DTX ratio
    [Arguments]    ${scells}   ${pcell}=16388    ${beamforming}=${True}    ${beamrefinement}=${False}

    ${pcell_id}  ${scells}  ${all_cells}  ${tdd_scells} =   suite_specific_keywords.Get cells converted to phycellid
    ...                                                         pcell_id=${pcell}  scells=${scells}

    FOR   ${cell_id}   IN    @{all_cells}
        Verify if CSI RS is present for cell    ${cell_id}
    END
    Run Keyword If    ${beamforming}==${True}    Verify that Beam Reports are sent for cells   ${tdd_scells}   ${beamrefinement}
    Run Keyword If    ${beamforming}==${False}   Verify that Beam Reports are not sent for cells    ${tdd_scells}
    Verify if CSI measurement reports are done via dedicated pucch FORMAT3    pcell=${pcell_id}   scells=${scells}    beamforming=${beamforming}
    Verify CSI reports dtx ratio   phys_cells_ids=${all_cells}   accepted_ratio=${10}


Check TTI Traces for CB008533
    @{all_cells} =   Create List    50  52  53  55
    FOR   ${cell_id}   IN    @{all_cells}
        Verify if CSI RS is present for cell    ${cell_id}
    END
    Verify Beam reports for CB008533
    Verify CSI measurements for CB008533
    Verify APERIODIC CSI for CB008533
    Verify CSI reports dtx ratio   phys_cells_ids=${all_cells}   accepted_ratio=${10}


Collect BIP and TTItrace logs
    [Arguments]    ${tti_collection_time}=3
    Stop pcap collecting
    Run Keyword If      '${AP_HARDWARE}' == 'ASIK'    Start BIP Collection
    Sleep    3s
    Collect TTI Traces during     sec=${tti_collection_time}
    Sleep    3s
    Stop pcap collecting


Start BIP Collection
    Enable port mirroring for bips
    Start remote tcpdump bip collecting
