*** Variables ***
${PHYS_CELL_ID_OFFSET}                49

# IF auto THEN it means that the value of the counter to check is compute automatically ELSE the value set is used
# Counters settings for Peak numbers of SA RRC users in the CU and non-GBR versus GBR DRBs on NRBTS
&{dict_settings_M55140C00001}         counter=M55140C00001    obj=NRBTS     objId=auto    min=auto     max=auto      iteration=2
&{dict_settings_M55140C00002}         counter=M55140C00002    obj=NRBTS     objId=auto    min=auto     max=auto      iteration=2
&{dict_settings_M55140C00501}         counter=M55140C00501    obj=NRBTS     objId=auto    min=auto     max=auto      iteration=2
# Counters settings for intra DU HO SA PLMN on NRCELL's
&{dict_settings_M55145C00301}         counter=M55145C00301    obj=NRCELL    objId=auto    min=auto     max=auto      iteration=1
&{dict_settings_M55145C00302}         counter=M55145C00302    obj=NRCELL    objId=auto    min=auto     max=auto      iteration=1
# Counters settings for number of scheduled UEs on PDSCH
&{dict_settings_M55308C17001}         counter=M55308C17001    obj=NRCELL    objId=auto    min=10000    max=500000    iteration=2
&{dict_settings_M55308C17002}         counter=M55308C17002    obj=NRCELL    objId=auto    min=1        max=4         iteration=2
# Counters settings for number of F1AP UE context
&{dict_settings_M55113C01002}         counter=M55113C01002    obj=NRCELL    objId=auto    min=2        max=4         iteration=1
@{dict_all_counters_for_ho}           &{dict_settings_M55140C00001}
...                                   &{dict_settings_M55140C00002}
...                                   &{dict_settings_M55140C00501}
