*** Keywords ***
CB008830 attach SA UEs
    [Arguments]            ${UElist}
    FOR    ${UEitem}    IN     @{UElist}
        ${RNTI}                 UE Register         ue=${UEitem.ue}
        Launch PDU Session      ue=${UEitem.ue}     pdu=${UEitem.pdu}    gw=${UEitem.ue}

        Set To Dictionary       ${UEitem}    c_rnti    ${RNTI}
    END

CB008830 attach NSA UEs
    [Arguments]            ${UElist}
    FOR    ${UEitem}    IN     @{UElist}
        SgNB Addition to ENB    ueSetting=${UEitem}
    END

CB008830 Unregister NSA UEs
    [Arguments]            ${UElist}
    FOR    ${UEitem}    IN     @{UElist}
        UE Detach Enb    ueSetting=${UEitem}
    END

CB008830 UE Deregister SA UEs
    [Arguments]            ${UElist}
    FOR    ${UEitem}    IN     @{UElist}
        UE Deregister    id=${UEitem.ue}
    END

CB008830 start traffic DL
    [Arguments]            ${UElist}
    FOR    ${UEitem}    IN     @{UElist}
        Traffic UE DL           ueSetting=${UEitem}    throughput=${UEitem.throughput}    deviation=10
        ...                                            duration=2s    shouldBeStop=${False}    shouldBeCheck=${False}
    END

CB008830 stop traffic DL
    [Arguments]            ${UElist}
    FOR    ${UEitem}    IN     @{UElist}
        Traffic Stop            ueSetting=${UEitem}    dir=dl
    END

CB008830 decrease traffic DL
    [Arguments]            ${UElist}
    FOR    ${UEitem}    IN     @{UElist}
        Traffic UE DL    ueSetting=${UEitem}    throughput=20    deviation=10    duration=5s    shouldBeStop=${False}
    END

CB008830 set rank
    [Arguments]            ${UElist}
    wtsemu.csi_override_testmode_nr    profile_id=1    cqi=15    cqi_mode=fixed    ri=0    ri_mode=fixed
    wtsemu.csi_override_testmode_nr    profile_id=2    cqi=15    cqi_mode=fixed    ri=1    ri_mode=fixed
    wtsemu.csi_override_testmode_nr    profile_id=3    cqi=15    cqi_mode=fixed    ri=2    ri_mode=fixed
    wtsemu.csi_override_testmode_nr    profile_id=4    cqi=15    cqi_mode=fixed    ri=3    ri_mode=fixed

    FOR    ${UEitem}    IN     @{UElist}
        wtsemu.ue_testmode_set_nr    id=${UEitem.ue}    testmode=csi_override    profile_id=${UEitem.rank}
        ...                          scell=0            action=activate
    END

CB008830 activate high speed
    [Arguments]            ${UElist}
    wtsemu.ue_ta_nr        profile_id=1    ue_fo_velocity=VELOCITY_APPROACHING_GNB_AT_350KMPH

    FOR    ${UEitem}    IN     @{UElist}
        wtsemu.ue_testmode_set_nr    id=${UEitem.ue}    testmode=ta    profile_id=1    action=activate
    END

CB008830 get RNTI DMRStype1
    [Arguments]            ${UElist}

    ${UEs_DMRSt1_list}     Create List

    FOR    ${UEitem}    IN     @{UElist}
        Run Keyword If       ${UEitem.DMRStype} == 1
        ...                  Append To List    ${UEs_DMRSt1_list}    ${UEitem.c_rnti}
    END

    Dated log new line     ===> UEs_DMRSt1_list: ${UEs_DMRSt1_list}
    set Suite Variable     ${UEs_DMRSt1_list}

CB008830 Test Teardown
    [Documentation]        Perform needed actions at the end of a test case
    Test Teardown
    Restore Files          listFileDesc=${FD_ALL}
    OAM Restore Files


#===== trace capture KWs =====
CB008830 Start L1L2 Capture
    ${CaptureL1L2}         Capture L1L2 Set Upon Config         airscale=${GNB_DU}
    Set Suite Variable     ${CaptureL1L2}
    Capture Init           ${CaptureL1L2}
    Capture Start          ${CaptureL1L2}

CB008830 Stop L1L2 Capture
    Capture Stop    ${CaptureL1L2}

CB008830 start TTI Capture
    [Arguments]            ${suffix}=${EMPTY}
    # TTI capture configuration
    ${TTIdir}              Get TTI Trace Path    dir_suffix=${suffix}
    set Suite Variable     ${TTIdir}

    # Start TTI capture
    Dated Log New Line     ===> start TTI traces capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2

CB008830 stop TTI Capture
    [Arguments]            ${suffix}=${EMPTY}
    # Stop TTI capture
    Dated Log New Line     ===> stop TTI traces capture
    ${TTIpcap}             Stop TTI Traces in Streaming mode    tti_trace_path=${TTIdir}    tti_trace_filename=TTI_${suffix}
    set Suite Variable     ${TTIpcap}

Cell Setup
    WTS Setup                shouldUseLua=False

#===== Configuration KWs =====
CB008830 define UEs
    [Arguments]            ${UEdefList}

    ${NSA_id}              Set Variable          ${FIRST_NSA_UE_ID}
    ${SA_Cell1_id}         Get First SA UE Id    cell=NRCELL-${TDD_Cell_list[0].nrCellId}
    ${SA_Cell2_id}         Get First SA UE Id    cell=NRCELL-${TDD_Cell_list[1].nrCellId}

    ${UEs_NSA_list}        Create List
    ${UEs_SA_list}         Create List

    FOR    ${UEitem}    IN     @{UEdefList}
        # Copy UE dictionary from SWENG according to call type
        ${UEdef}             Run Keyword If    "${UEitem.callType}" == "NSA"
        ...                  Copy Dictionary     ${NSA_UE_NO_PROFILE}
        ...    ELSE          Copy Dictionary     ${BASIC_UE_SA}

        # Set UE id according to call type and target cell
        Run Keyword If       "${UEitem.callType}" == "NSA"
        ...                  Set To Dictionary    ${UEdef}     ue    ${NSA_id}
        Run Keyword If       "${UEitem.callType}" == "SA" and ${UEitem.targetCell} == 1
        ...                  Set To Dictionary    ${UEdef}     ue    ${SA_Cell1_id}
        Run Keyword If       "${UEitem.callType}" == "SA" and ${UEitem.targetCell} == 2
        ...                  Set To Dictionary    ${UEdef}     ue    ${SA_Cell2_id}

        Set To Dictionary    ${UEdef}     target_cells    ${TDD_Cell_list[${UEitem.targetCell}-1].nrCellId}
        Set To Dictionary    ${UEdef}     throughput      ${UEitem.throughput}
        Set To Dictionary    ${UEdef}     DMRStype        ${UEitem.DMRStype}
        Set To Dictionary    ${UEdef}     rank            ${UEitem.rank}

        # Add UE in associated list
        Run Keyword If       "${UEitem.callType}" == "NSA"
        ...                  Append To List    ${UEs_NSA_list}    ${UEdef}
        ...       ELSE       Append To List    ${UEs_SA_list}     ${UEdef}

        # Modify UE capa in case of UE with DMRS type 1 only
        # ymerlin AP Default UE Capabilities phy-ParametersFRX-Diff supportedDMRS-TypeDL=type1And2

        Run Keyword If           ${UEitem.DMRStype} == 1 and "${UEitem.callType}" == "NSA"
        ...                      Run keywords
        ...                      Modify UE Data in Cfg File    sa_or_nsa=NSA    ue_id=${NSA_id}     ue_nr_capa=${ueCapa_Type1_only_NSA}
        ...                      AND    Dated Log    UE Capabilities supportedDMRS-TypeDL set to Type1   # ${UEitem.DMRStype}

        Run Keyword If           ${UEitem.DMRStype} == 1 and "${UEitem.callType}" == "SA" and ${UEitem.targetCell} == 1
        ...                      Run keywords
        ...                      Modify UE Data in Cfg File    sa_or_nsa=NSA    ue_id=${SA_Cell1_id}    ue_nr_capa=${ueCapa_Type1_only_SA}
        ...                      AND    Dated Log    UE Capabilities supportedDMRS-TypeDL set to : ${UEitem.DMRStype}

        Run Keyword If           ${UEitem.DMRStype} == 1 and "${UEitem.callType}" == "SA" and ${UEitem.targetCell} == 2
        ...                      Run keywords
        ...                      Modify UE Data in Cfg File    sa_or_nsa=NSA    ue_id=${SA_Cell2_id}     ue_nr_capa=${ueCapa_Type1_only_SA}
        ...                      AND    Dated Log    UE Capabilities supportedDMRS-TypeDL set to : ${UEitem.DMRStype}
        ...       ELSE           Dated Log    UE Capabilities supportedDMRS-TypeDL set to : ${UEitem.DMRStype}
        Dated Log new line       ==== ${UEdef} ====

        # Increment UE id used
        ${NSA_id}            Run Keyword If    "${UEitem.callType}" == "NSA"
        ...                  Evaluate        ${NSA_id}+1
        ...       ELSE       Set Variable    ${NSA_id}

        ${SA_Cell1_id}       Run Keyword If    "${UEitem.callType}" == "SA" and ${UEitem.targetCell} == 1
        ...                  Evaluate        ${SA_Cell1_id}+1
        ...       ELSE       Set Variable    ${SA_Cell1_id}

        ${SA_Cell2_id}       Run Keyword If    "${UEitem.callType}" == "SA" and ${UEitem.targetCell} == 2
        ...                  Evaluate        ${SA_Cell2_id}+1
        ...       ELSE       Set Variable    ${SA_Cell2_id}
    END

    ${UEs_list}            Combine Lists    ${UEs_NSA_list}    ${UEs_SA_list}

    Set Suite Variable     ${UEs_NSA_list}
    Set Suite Variable     ${UEs_SA_list}
    Set Suite Variable     ${UEs_list}

CB008830 json recommissioning
    [Arguments]               ${jsonFile}

    ${gnb_alias}              Set Variable    gnb_under_test
    sbts_coam.connect_to      name=${gnb_alias}

    Dated Log New Line        ===> Perform SCF delta commissioning
    coam_parameter.perform_scf_delta_commission
    ...                       delta_file=${jsonFile}
    ...                       connection=${gnb_alias}
    ...                       timeout=600

    sbts_coam.teardown        connection=${gnb_alias}

    Dated Log New Line        ===> OAM wait available
    ...                       OAM wait available

CB008830 Full Commissioning
    [Arguments]                 ${scf}
    OAM Perform Full Commissioning    scf_file=${scf}
    OAM wait available


#===== Check KWs =====
CB008830 get PM files
    CB008830 Wait PM Availability
    ${pm_path}             Set Variable                 ${LOG_PATH}/pm_files
    ${pm_latest}           Collect PM files from BTS    ${pm_path}
    Set Suite Variable     ${pm_path}
    Set Suite Variable     ${pm_latest}

CB008830 Wait PM Availability
    [Arguments]            ${pmPeriodSec}=0    ${pmAvailDelay}=60

    Dated Log              ===> Wait PM availablity
    ${startTime}           Evaluate    int(time.time())    time

    # Get reportingIntervalPm from SCF
    OAM Get SCF File       dir=/tmp    file=SCF_temp.xml
    SCF StartSession       scf_file=/tmp/SCF_temp.xml
    ${dist_name}           Set Variable    MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/PMCADM-1
    ${repIntervalPm}       SCF Get Single Value    ${dist_name}         reportingIntervalPm
    ...                                            aicListEntity=vdu    scope=Both
    SCF StopSession        scf_file=/tmp/SCF_temp.xml

    ${pmPeriodSec}                  Run Keyword If    ${pmPeriodSec} == 0
    ...                             Convert Time    ${repIntervalPm}[0]
    ...      ELSE                   Set Variable    ${pmPeriodSec}

    ${nextPeriodTime}               Evaluate    (int(${startTime} / ${pmPeriodSec}) + 1) * ${pmPeriodSec}
    ${pmAvailabilityTime}           Evaluate    ${nextPeriodTime} + ${pmAvailDelay}
    ${pmWaitDuration}               Evaluate    ${pmAvailabilityTime} - ${startTime}
    ${pmAvailabilityDate}           Convert date    ${pmAvailabilityTime}
    Dated Log                       ===> PM should be available in ${pmWaitDuration} sec, at ${pmAvailabilityDate}
    Sleep                           ${pmWaitDuration}    Wait for PM availability

CB008830 Get Reporting Interval PM
    SCF StartSession                scf_file=${SCF_SETUP_PATH}
    ${dist_name}                    Set Variable                 MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/PMCADM-1
    ${reportingIntervalPm}          SCF Get Single Value         ${dist_name}           reportingIntervalPm
    ...                                                          aicListEntity=vdu      scope=Both
    SCF StopSession                 scf_file=/tmp/SCF_temp.xml
    Dated Log new line              - ReportingIntervalPm is: ${reportingIntervalPm}
    Set Suite Variable              ${reportingIntervalPm}

CB008830 check DL BLER
    [Arguments]              ${cellID}    ${maxBLER}=10
    Dated Log new line       === Check DL BLER on cell ${cellID}

    # 1. Initial transmission
    ${num_of_initial_transmission}          Set Variable      0
    FOR    ${counter}    IN    @{counters_initial_dl_transmission}
        ${value}              Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter}    object_id=${cellID}

        ${num_of_initial_transmission}      Evaluate          ${num_of_initial_transmission} + ${value}
    END
    Dated Log new line       - Number of initial DL transmission: ${num_of_initial_transmission}

    # 2. Successful transmission
    ${num_of_successful_transmission}       Set Variable      0
    FOR    ${counter}    IN    @{counters_success_dl_transmission}
        ${value}              Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter}    object_id=${cellID}

        ${num_of_successful_transmission}     Evaluate        ${num_of_successful_transmission} + ${value}
    END
    Dated Log new line       - Number of successful DL transmission: ${num_of_successful_transmission}

    ${bler_level}            Run Keyword If  ${num_of_initial_transmission}!=0
    ...                      Evaluate    (${num_of_initial_transmission} - ${num_of_successful_transmission})*100 / ${num_of_initial_transmission}
    ...                      ELSE
    ...                      Set Variable    100

    Dated Log new line       - DL BLER: ${bler_level}% (expected max ${maxBLER}%)
    ${Status}                Set Variable If    ${bler_level} < ${maxBLER}    ${True}    ${False}
    Should Be True           ${Status}

CB008830 Verification Of DMRS behaviour for a given RNTI
    [Documentation]
    ...     Conditions:     it is based on the arguments RNTI and DMRS Profile
    ...     Actions:        it verifies the DMRS Type, antennaPort, mcs and the number of Cdm Goup Without Data in dldata_pdschsendreq msg
    ...     Checks:         it checks PDSCH IEs (dlDmrsConfigType, antPort, mcs, numOfDmrsCdmGroupWithoutData) values related to DMRS for a given Ue
    ...     Verdict:        PDSCH IEs values are as expected
    [Arguments]             ${RNTI}    ${DMRSprofile}
    ${Rnti_hex}=            Convert To Hex    ${RNTI}
    Dated log               filtering L1L2 with RNTI : ${Rnti_hex}
	${pcapFiltered}         analyzer.filter_pcap    pcapInFile=${CaptureL1L2.path}    filterName=dldata_pdschsendreq_${Rnti_hex}
    ...                     filterExp=(dldata_pdschsendreq)&&(3gpp.rnti==${RNTI})
	Dated log               Convert L1L2 pcap format to pdml file
    ${pdml}=                analyzer.pcap_to_pdml    ${pcapFiltered}
    @{ListOfPdschSendReqIEs}    Create List    dlDmrsConfigType    rnti    antPort    mcs    numOfDmrsCdmGroupWithoutData
    @{lisOfPdschSendReq}    Get Packet Match List    pdmlFile=${pdml}    packetName=dldata_pdschsendreq    pathList=@{ListOfPdschSendReqIEs}
    ...                     startPacket=${1}
    ...                     endPacket=${100}
    ${lenPdschSendReq}       get length          ${lisOfPdschSendReq}
    Dated Log New Line       Total number of PdschSendReq msgs: ${lenPdschSendReq}
    should be true           ${lenPdschSendReq}!=0
    Dated Log  =====> Start check PDSCH IEs
    FOR    ${packet}   IN        @{lisOfPdschSendReq}
           ${dlDmrsConfigType}    Get Value In Packet Match    packetMatch=${packet}    field=dlDmrsConfigType
           ${rnti}                Get Value In Packet Match    packetMatch=${packet}    field=rnti
           ${antPort}             Get Value In Packet Match    packetMatch=${packet}    field=antPort
           ${mcs}                 Get Value In Packet Match    packetMatch=${packet}    field=mcs
           ${numOfDmrsCdmGroupWithoutData}     Get Value In Packet Match    packetMatch=${packet}    field=numOfDmrsCdmGroupWithoutData
           Dated Log     dlDmrsConfigType: ${dlDmrsConfigType}
           Dated Log     antPort: ${antPort}
           Dated Log     numOfDmrsCdmGroupWithoutData: ${numOfDmrsCdmGroupWithoutData}
           Dated Log     mcs: ${mcs}
           # should be true         ${dlDmrsConfigType}==${ue_DMRSprofile.dlDmrsConfigType}
           # should be true         ${antPort}==${ue_DMRSprofile.antPort}
           # should be true         ${mcs}>=${ue_DMRSprofile.mcs}
           # should be true         ${numOfDmrsCdmGroupWithoutData}==${ue_DMRSprofile.numOfDmrsCdmGroupWithoutData}
    END

Get UE RNTIs
    [Documentation]
     [Arguments]
    # SA RNTI Method 1 :
    # ${RntiUe1}             CallSetup.Read SA CRNTI From Egate log      ueId=1
    # ${RntiUe11}            CallSetup.Read SA CRNTI From Egate log      ueId=21
    # Dated Log    SA ${SA_List_1.ue} RNTI Decimal : ${RntiUe1}
    # Dated Log    SA ${SA_List_2.ue} RNTI Decimal : ${RntiUe11}
    # Dated Log new line     SA UE List : ${UEs_SA_list}
    ${SA_List_1}           Get From List      ${UEs_SA_list}     0
    ${SA_List_2}           Get From List      ${UEs_SA_list}     1
    ${RntiUe1_int}         Convert To Integer    ${SA_List_1.c_rnti}
    ${RntiUe11_int}        Convert To Integer    ${SA_List_2.c_rnti}
    Set Test Variable      ${RntiUe1_int}
    Set Test Variable      ${RntiUe11_int}
    ${RntiUe1_hex}         Convert To Hex    ${RntiUe1_int}
    ${RntiUe11_hex}        Convert To Hex    ${RntiUe11_int}
