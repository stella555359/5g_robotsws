*** Settings ***
Documentation     [SUITE PURPOSE]   CB009158 Test suite for ABIP
...               Prerequisite : gNB configured with 6 NrCells (chBw=10/20MHz) & RU detected
...               Scope : cell setup & call setup
...               Test execution duration     : approximately 30 minutes
...               Test Case automation author : yann.merlin@nokia.com
...               Test Case automation contact: yann.merlin@nokia.com
...               Creation Date               : 09-10-2023
...               Modified Date               : 10-10-2023
...               Last Modified by            : yann.merlin@nokia.com
...               Version History   Date        Author                      Notes
...               0.1               FB2220      yann.merlin@nokia.com       Creation CB09158-ABIP (FPB-844519)
...               0.2               FB2419      richard.duthu@nokia.com     Produce Scout Data

Resource          ./resources/robot/CB009158_MP_Keywords.robot
Force Tags        CLOUD_5G_I_LO_AP_LOOO    OPTION_RELATED_ARTIFACTS_5G   VARIANT_SANSA_FS_CPRI_CMWV_FDD
...               SBTS00   CONFIGURED   5G_RAN   RAN_5G   RAN_5G_FDD   5G_RAN_FDD   CRT

Suite Setup       Setup.Suite Setup From Scratch    listBackupFiles=${FD_ALL}    keepAllUeDataInCfgFile=${True}    automaticTeardown=${True}
...               scfcPathname=${CURDIR}/config/customconfig/24R1/scf_CB09158_ABIP_FR1_FDD_6NRCELLs_mix_chBw_10MHz_20MHz.xml
...               iphyPathname=${CURDIR}/config/customconfig/24R1/FR1_FDD_CPRI_AHLOA_6CELLs_new_iphy.xml
...               basicPathname=${CURDIR}/config/customconfig/24R1/basic_setup_6CELLS.cfg
...               rad_params=@{rad_params}
...               vendor_params=@{bbL1SpPrbInitCapacity}

*** Variables ***
# List of RadParams to be set during "Suite Setup":
@{rad_params}           0x580117=1    # CSI-RS Event Sherpa
    ...                 0x580758=0    # rdAllowInterL1SpPoolingFdd  - 0 : Disabled(IntraL1SubPool) - 1 : Enabled(InterL1SubPool)
    ...                 0x580690=0    # rdAllowZeroAllocBypass      - 0 : ZAB Disabled - 1 : ZAB Enabled
# List of Vendor Params defined during "Suite Setup":
# WMP: NR_L1Pool_Thor_FDD_FR1_CPRI, ABIP
# Cell Slot Size = 48, Direction=DL
@{bbL1SpPrbInitCapacity}       NRBTS.bbL1SpPrbInitCapacity___ABIP___DL___NR_L1Pool_Thor_FDD_FR1_CPRI.maxNumLayerPrbL1Sp=640
...                            NRBTS.bbL1SpPrbInitCapacity___ABIP___DL___NR_L1Pool_Thor_FDD_FR1_CPRI.maxNumStreamPrbL1Sp=640
...                            NRBTS.bbL1SpPrbInitCapacity___ABIP___DL___NR_L1Pool_Thor_FDD_FR1_CPRI.maxNumWbStreamPrbL1Sp=430

&{TC_6_Cells}           dir=DL
...                     nbCell=6
...                     totalNbOfUe=3                 # total number of ue's to configure
...                     totalNbOfCell=3               # total number of cell used for ue's dispatching
...                     targetGnb=2                   # gnb target id
...                     totalNbOfCell=3               # total number of cell used for ue's dispatching
...                     captureDuration=0             # capture duration during traffic starting phase
...                     duration=3                    # traffic duration during declaration phase
...                     deviation=10                  # allowed deviation for throughput

@{dict_settings_6_UEs_noGBR_GBR_UL_DL}      ${dict_settings_ue1_noGBR_GBR}
...                                         ${dict_settings_ue2_noGBR_GBR}
...                                         ${dict_settings_ue3_noGBR_GBR}
...                                         ${dict_settings_ue4_noGBR_GBR}
...                                         ${dict_settings_ue5_noGBR_GBR}
...                                         ${dict_settings_ue6_noGBR_GBR}

&{dict_settings_ue1_noGBR_GBR}             originalCell=1
...                                        DL_throughput=100
...                                        DL_throughput_GBR=100
...                                        UL_throughput=0

&{dict_settings_ue2_noGBR_GBR}              originalCell=2
...                                         DL_throughput=400
...                                         DL_throughput_GBR=175
...                                         UL_throughput=0

&{dict_settings_ue3_noGBR_GBR}              originalCell=3
...                                         DL_throughput=175
...                                         DL_throughput_GBR=175
...                                         UL_throughput=0

&{dict_settings_ue4_noGBR_GBR}             originalCell=4
