TC 2574 5g SA Call
   [Documentation]                Test purpose is to test 5g DSS SA Call
   [Arguments]                    ${param}    ${alias}=default
   BuiltIn.log                    alias is ${alias}
   Init Sequence                  ${param}
   Step           common_Dss_Keywords.Start capture Bip and Xp for DSS
   Step           common_Dss_SA_NSA.DSS_5g_Call_SA           argument=${alias}
   Step           common_Dss_Keywords.Stop capture Bip and Xp for DSS       depends=common_Dss_Keywords.Start capture Bip and Xp for DSS
   [Teardown]                      GenericTest.Display diagnosis

TC 2574 NSA CellSetup
   [Documentation]                Generic test for 2574: test purpose is to setup X2, Xp and DSS CellSetup Phase3
   [Arguments]                    ${param}     ${alias}=default
   BuiltIn.log                    alias is ${alias}
   Init Sequence                  ${param}
   common_Dss_Keywords.Restart     OwnTLReset=${False}     GNBCallback=common_Dss_Keywords.Set Reset Loop Counter
   Step                           Start capture Backhaul XP for DSS                                   depends=common_Dss_Keywords.Restart
   Step                           5GC002574_keywords.Start WTS For NSA       argument=${alias}
   Step                           Check wts in active state                  argument=${alias}        depends=5GC002574_keywords.Start WTS For NSA
   Step                           Wait Xp link Up                            argument=${alias}        depends=5GC002574_keywords.Start WTS For NSA
   Step                           X2Ap link Setup                            argument=${alias}        depends=5GC002574_keywords.Start WTS For NSA
   # Step                           common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3    argument=${alias}     depends=Wait Xp link Up
   Step                           common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3    alias=${alias}    wtsObj=${wtsObj}     depends=Wait Xp link Up
   ${pdmlFile}                    Stop capture Backhaul XP for DSS
   Run Keyword if       '${CELLSETUP_SHOULD_BE_CHECK}' == '1'
   ...                    Step        Check DSS CellSetup Phase3      argument=${pdmlFile}   depends=common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3
   # Wait gNB cell 5g On air with globalCellId=1
   Critical Step                  common_Dss_CellSetup.Wait gNB cell 5g On air     globalCellId=1
   Critical Step                  common_Dss_CellSetup.Verify AP Classical Cell Setup
   [Teardown]               GenericTest.Display diagnosis

TC 2574 5g NSA Call
    [Documentation]                Test purpose is to test 5g DSS NSA Call
    [Arguments]                    ${param}     ${alias}=default
    BuiltIn.log                    alias is ${alias}
    Init Sequence                  ${param}
    Critical step                  common_Dss_SA_NSA.Test SgNB Addition PRACH
    [Teardown]               GenericTest.Display diagnosis


TC 2574 5g NSA Call with Add Scell Range To NSA
    [Documentation]                Test purpose is to test 5g DSS NSA Call to be ued with AP TestMode
    [Arguments]                    ${param}     ${alias}=default
    BuiltIn.log                    alias is ${alias}
    Init Sequence                  ${param}
    UE Attach Enb                   ueSetting=${UE_SIMPLE_CellDSS}
    common_Dss_CellSetup.Add Scell Range To NSA          alias=${alias}
    Critical Step       UE Attach Gnb                   ueSetting=${UE_SIMPLE_CellDSS}
    # ${output}=     common_Dss_SA_NSA.Read WTS Output For Pattern And Print matching Lines    ${UE_attach_pattern}    ${Timeout_NSA}
    # Critical Step            common_Dss_SA_NSA.5G Ue Attach Check      ${output}
    [Teardown]               GenericTest.Display diagnosis


TC 2574 DL Tput NSA Mode
    [Documentation]                Generic test for 2574: test purpose is to test DL Tput NSA mode
    [Arguments]                    ${param}      ${ul_rate}=15      ${dl_rate}=80      ${forced_expected_dl_ratio}=100   ${alias}=default
    BuiltIn.log                    alias is ${alias}
    BuiltIn.log                    ul_rate=${ul_rate} and dl_rate=${dl_rate}
    Init Sequence                  ${param}
    Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'     Dated log     SSH on ${GNB_DU.sys[0].M.sshId}
    ${aliasGNB_M}                 Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'    SSH Wait For Connect    ${GNB_DU.sys[0].M}
    ${tput_log_file_path_gnb}     Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'    Start tput log capture    gnb_index=0
    ...                                                                                                          asik_alias=${aliasGNB_M}
    Dated log     =========> NSA Start DL Traffic on ue_id=${UE_SIMPLE_CellDSS.ue} with ${dl_rate}M
    Step       NSA Start Generating "${dl_rate}"mbps DL Traffic for Ue "${param.Context.UeId1}" on NSA using alias "${alias}"
    Traced Sleep   5s     msg=DL Traffic to test Tput
    Run Keyword If   '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'   Run keywords
    ...             Dated log    Calculate DL and UL throughput on gnb L2Lo case ...    AND
    ...             Check Throughput from aasyslog   asik_alias=${aliasGNB_M}     tput_log_file_path_gnb_combined=${tput_log_file_path_gnb}

    ${L1L2_Pcap_File}=   5GC002574_keywords.Get L1L2 traces    time=12s   prefix=TC_2574_DL_Tput_NSA_Mode.12s.wL1L2Bip
    ${sum_prb}   ${sum_prb_5min}   ${expected_dl_ratio}=    Sum NbrOfPrb pdschsendreq from L1L2 Pcap wo Step    ${param}
    ...                                                                                                ${testCaseDir}/${L1L2_Pcap_File.name}.pcap
    ${expected_dl_ratio}=   set variable    ${forced_expected_dl_ratio}

    Step                Start capture Backhaul XP for DSS     argument=XP.BH.wDLTput
    Traced Sleep   3s     msg=DL Traffic to test DL Qos load Indication
    ${pdmlFile}         Stop capture Backhaul XP for DSS
    Dated log     =========> Check DL Qos Load Indication MeasuredNgbrNnbrLoad ...
    common_Dss_Keywords.Check DL Qos Load Indication MeasuredNgbrNnbrLoad   ${pdmlFile}    value=${expected_dl_ratio}
    Step              Check no DL Qos Load Indication MeasuredNgbrNnbrLoad upper 100    depends=Stop capture Backhaul XP for DSS
    ...                            argument=${pdmlFile}
    ${L1L2_Pcap_File}=   5GC002574_keywords.Get L1L2 traces    time=2s   prefix=TC_2574_DL_Tput_NSA_Mode.2s.wL1L2Bip
    set test variable     ${L1L2_Pcap_File}
    Dated log     =========> get throughput for ue (0x${UE_SIMPLE_CellDSS.ue})
    ${ul_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=ul  alias=${alias}
    dated log     ul throughput for ue is ${ul_throughput_for_ue1} Mbps
    ${dl_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=dl  alias=${alias}
    dated log     dl throughput for ue is ${dl_throughput_for_ue1} Mbps
    Step          common_Dss_SA_NSA.Display Ue NSA Statistics       argument=${alias}
    Run Keyword And Ignore Error    Get TTI traces
    common_Dss_SA_NSA.Stop Generating Traffic         ue=${UE_SIMPLE_CellDSS.ue}
    ...                                           bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                           alias=${alias}
    [Teardown]           GenericTest.Display diagnosis

TC 2574 DL Tput NSA Mode wo Stopping dl Tput
    [Documentation]                Generic test for 2574: test purpose is to test DL Tput NSA mode
    [Arguments]                    ${param}      ${ul_rate}=15      ${dl_rate}=80      ${alias}=default
    BuiltIn.log                    alias is ${alias}
    BuiltIn.log                    ul_rate=${ul_rate} and dl_rate=${dl_rate}
    Init Sequence                  ${param}
    Dated log     SSH on ${GNB_DU.sys[0].M.sshId}
    ${aliasGNB_M}         SSH Wait For Connect                    ${GNB_DU.sys[0].M}
    ${tput_log_file_path_gnb}      Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'    Start tput log capture    gnb_index=0
    ...                                                                                                          asik_alias=${aliasGNB_M}
    Dated log     =========> NSA Start DL Traffic on ue_id=${UE_SIMPLE_CellDSS.ue} with ${dl_rate}M
    Step       NSA Start Generating "${dl_rate}"mbps DL Traffic for Ue "${param.Context.UeId1}" on NSA using alias "${alias}"
    Traced Sleep   5s     msg=DL Traffic to test Tput
    Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'      Dated log         Calculate DL and UL throughput on gnb L2Lo case ...
    Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'   Check Throughput from aasyslog   asik_alias=${aliasGNB_M}
    ...                                                                                   tput_log_file_path_gnb_combined=${tput_log_file_path_gnb}
    Step                Start capture Backhaul XP for DSS     argument=XP.BH.wDLTput
    Traced Sleep   3s     msg=DL Traffic to test DL Qos load Indication
    ${pdmlFile}         Stop capture Backhaul XP for DSS
    Dated log     =========> Check DL Qos Load Indication MeasuredNgbrNnbrLoad ...
    Step         common_Dss_Keywords.Check DL Qos Load Indication MeasuredNgbrNnbrLoad   depends=Stop capture Backhaul XP for DSS
    ...                            argument=${pdmlFile}
    Step         Check no DL Qos Load Indication MeasuredNgbrNnbrLoad upper 100          depends=Stop capture Backhaul XP for DSS
    ...                            argument=${pdmlFile}
    ${L1L2_Pcap_File}=   5GC002574_keywords.Get L1L2 traces    time=2s   prefix=TC_2574_DL_Tput_NSA_Mode.2s.wL1L2Bip
    set test variable     ${L1L2_Pcap_File}
    Dated log     =========> get throughput for ue (0x${UE_SIMPLE_CellDSS.ue})
    ${ul_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=ul  alias=${alias}
    dated log     ul throughput for ue is ${ul_throughput_for_ue1} Mbps
    ${dl_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=dl  alias=${alias}
    dated log     dl throughput for ue is ${dl_throughput_for_ue1} Mbps
    Step          common_Dss_SA_NSA.Display Ue NSA Statistics       argument=${alias}
    # Run Keyword And Ignore Error    Get TTI traces
    [Teardown]           GenericTest.Display diagnosis

TC 2574 DL UL Tput NSA Mode
    [Documentation]                Generic test for 2574: test purpose is to test DL/UL Tput NSA mode
    [Arguments]                    ${param}      ${ul_rate}=15      ${dl_rate}=80      ${alias}=default
    BuiltIn.log                    alias is ${alias}
    BuiltIn.log                    ul_rate=${ul_rate} and dl_rate=${dl_rate}
    Init Sequence                  ${param}
    Dated log             Point AF_PATH to local luashark XP package
    Dated log     SSH on ${GNB_DU.sys[0].M.sshId}
    ${aliasGNB_M}         SSH Wait For Connect                    ${GNB_DU.sys[0].M}
    ${tput_log_file_path_gnb}      Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'    Start tput log capture    gnb_index=0
    ...                                                                                                          asik_alias=${aliasGNB_M}
    Dated log     =========> NSA Start UL/DL Traffic on ue_id=${UE_SIMPLE_CellDSS.ue} with ${ul_rate}M/${dl_rate}M
    Start Generating "${ul_rate}"mbps UL and "${dl_rate}"mbps DL Traffic for Ue="${param.Context.UeId1}" on NSA using alias "${alias}"
    Traced Sleep   5s     msg=DL/UL Traffic to test Tput
    Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'      Dated log         Calculate DL and UL throughput on gnb L2Lo case ...
    Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'   Check Throughput from aasyslog   asik_alias=${aliasGNB_M}
    ...                                                                                   tput_log_file_path_gnb_combined=${tput_log_file_path_gnb}
    Step                Start capture Backhaul XP for DSS
    Traced Sleep   3s     msg=DL/UL Traffic to test DL/UL Qos load Indication
    ${pdmlFile}         Stop capture Backhaul XP for DSS
    Dated log     =========> Check UL and DL Qos Load Indication MeasuredNgbrNnbrLoad ...
    ${status}    ${avg_ul_MeasuredNgbrNnbrLoad}=  Run Keyword and Ignore Error  common_Dss_Keywords.Check UL Qos Load Indication MeasuredNgbrNnbrLoad
    ...                                                                                              ${pdmlFile}
    ...                                                                                              value=64
    ...                                                                                              with_verdict=False
    Step         common_Dss_Keywords.Check DL Qos Load Indication MeasuredNgbrNnbrLoad   depends=Stop capture Backhaul XP for DSS
    ...                            argument=${pdmlFile}
    Step         Check no DL Qos Load Indication MeasuredNgbrNnbrLoad upper 100          depends=Stop capture Backhaul XP for DSS
    ...                            argument=${pdmlFile}
    Step              common_Dss_Keywords.Start capture Bip and Xp for DSS          argument=BIP_L1L2_BH_w_DLULTput_${alias}
    Traced Sleep   2s     msg=take BIP L1L2 and BH pcap traces with DL/UL Tput
    Step              common_Dss_Keywords.Stop capture Bip and Xp for DSS              depends=common_Dss_Keywords.Start capture Bip and Xp for DSS
    Dated log     =========> get ul/dl throughput for ue (0x${UE_SIMPLE_CellDSS.ue})
    ${ul_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=ul  alias=${alias}
    dated log     ul throughput for ue is ${ul_throughput_for_ue1} Mbps
    ${dl_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=dl  alias=${alias}
    dated log     dl throughput for ue is ${dl_throughput_for_ue1} Mbps
    Step          common_Dss_SA_NSA.Display Ue NSA Statistics       argument=${alias}
    common_Dss_SA_NSA.Stop Generating Traffic         ue=${UE_SIMPLE_CellDSS.ue}
    ...                                           bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                           alias=${alias}
    [Teardown]           GenericTest.Display diagnosis

DSS_5g_Periodic_DL_Fast_Allocation
   [Documentation]     DL Pattern list to add to CRMSim and active it
   [Arguments]         ${param}     ${alias}=default
   BuiltIn.log                    alias is ${alias}
   Init Sequence       ${param}
   Step      common_Dss_CellSetup.Periodic DL Fast Allocation With Same Pattern      argument=${alias}
   [Teardown]                      GenericTest.Display diagnosis

DSS_5g_Periodic_UL_Fast_Allocation
   [Documentation]     UL Pattern list to add to CRMSim and active it
   [Arguments]         ${param}     ${alias}=default
   BuiltIn.log                    alias is ${alias}
   Init Sequence       ${param}
   Step      common_Dss_CellSetup.Periodic UL Fast Allocation      argument=${alias}
   [Teardown]                      GenericTest.Display diagnosis

Start L1L2 traces
    [Arguments]     ${time}=1s   ${prefix}=DL_UL_Tput
    BuiltIn.log     time=${time}
    ${CaptureBIP}              Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    ${CaptureBIP.prefix}       set Variable   ${prefix}
    ${CaptureBIP.withTN}       set Variable   True
    # Capture Init   ${CaptureBIP}
    #define options of gnbMirroring.sh (BIP only)
    ${OPT_GNB_MIRRORING_DSS}                 Tools.Dictionary Get              ${OPT_GNB_MIRRORING}
    ${OPT_GNB_MIRRORING_DSS.mirroring_mode}            set Variable         'manual'
    ${OPT_GNB_MIRRORING_DSS.l2_l1_bip}                 set Variable         'true'
    ${OPT_GNB_MIRRORING_DSS.backhaul_mirroring}        set Variable         'false'
    Set Suite Variable              ${OPT_GNB_MIRRORING_DSS}
    # Execute Mirror Script with options for DSS      ${CaptureBIP.scriptDef}    ${OPT_GNB_MIRRORING_DSS}
    Capture start  ${CaptureBIP}
    Dated Log         Start L1L2 Bip Traces [${CaptureBIP.name}]...
    [Return]    ${CaptureBIP}

Stop L1L2 traces
    [Arguments]      ${CaptureBIP}
    Dated Log         Stop L1L2 Bip Traces [${CaptureBIP.name}]
    Capture stop   ${CaptureBIP}
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureBIP.path}
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${CaptureBIP.path}    ${testCaseDir}
    [Return]    ${CaptureBIP}


Check no DL Qos Load Indication MeasuredNgbrNnbrLoad upper 100
    [Arguments]    ${pdmlFile}
    Dated log           ${pdmlFile}

    ${cmd}=    Catenate     cat ${pdmlFile} | grep -i 'dssDlQosLoadMeasurement.measuredNgbrNnbrLoad' | grep 'measuredNgbrNnbrLoad (Uint8)' |
    ...                                             awk '{print $9}' | sed -e 's/value="//g' | sed -e 's/"/ /g' | awk '{print $1}'
    ${MeasuredNgbrNnbrLoad}=    OperatingSystem.Run    ${cmd}
    @{lines}    Split To Lines    ${MeasuredNgbrNnbrLoad}
    ${length}=    get length     ${lines}
    @{MeasuredNgbrNnbrLoad_List}    Evaluate    map(lambda x: int(x, 16), @{lines})
    Dated log   DL MeasuredNgbrNnbrLoad = @{MeasuredNgbrNnbrLoad_List} and length = ${length}
    ${avg_dl_MeasuredNgbrNnbrLoad}    Evaluate    round(round(sum(@{MeasuredNgbrNnbrLoad_List}), 1)/round(${length}, 1), 1)
    ${NbrElt}  ${list_dl_MeasuredNgbrNnbrLoad_upper_100}=   nps_2574_tools.check_dl_MeasuredNgbrNnbrLoad_upper_100    ${MeasuredNgbrNnbrLoad_List}
    Dated log   DL MeasuredNgbrNnbrLoad upper 100 = @{list_dl_MeasuredNgbrNnbrLoad_upper_100} and length = ${NbrElt}
    ${avg_dl_MeasuredNgbrNnbrLoad_upper_100}    run Keyword if   '${NbrElt}'!='0'
    ...              Evaluate    round(round(sum(@{list_dl_MeasuredNgbrNnbrLoad_upper_100}), 1)/round(${NbrElt}, 1), 1)
    ...  ELSE        set variable    0
    Log many          [DATA TRANSFER] DL dssDlQosLoadMeasurement MeasuredNgbrNnbrLoad average: ${avg_dl_MeasuredNgbrNnbrLoad}
    Log To Console    \t\t\tDownlink dssDlQosLoadMeasurement.MeasuredNgbrNnbrLoad Avg:\t\t ${avg_dl_MeasuredNgbrNnbrLoad} %
    Log many          [DATA TRANSFER] DL dssDlQosLoadMeasurement MeasuredNgbrNnbrLoad List upper 100 : ${avg_dl_MeasuredNgbrNnbrLoad_upper_100}
    Log To Console    \t\t\tDL dssDlQosLoadMeasurement MeasuredNgbrNnbrLoad List upper 100 Avg:\t\t ${avg_dl_MeasuredNgbrNnbrLoad_upper_100} %

Stop TcpDump if TestCase Failed
    return from Keyword if   '${TEST STATUS}' != 'FAIL'
    BuiltIn.Log      \nTest ${TEST_NAME} TestCase Failed ending   console=yes
    Run Keyword And Continue On Failure     common_Dss_Keywords.Stop Tcpdump on TestPc  interface=eth3  target_dir=${testCaseDir}




