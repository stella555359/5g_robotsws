[1]CNI-102921_Collect_Emil_R3252512
    set_oam_parameter      MRBTS-1/NRBTS-272260/NRCELL-0    administrativeState    Unlocked
    dcap_start_container
    ${trace_id}            dcap_start_cplane    duration_seconds=1200
    Step                   Step_TL_Restart
    Step                   Setup Wtsemu SA      nbCell=5
    # Next lines to have direct access to scf and snapshot from Jenkins (needed for ScfConverter)
    ${scf_file}            OAM Get SCF File     file=scf_CNI-102921_Collect_Emil_R3252512.xml
    Run                    mv ${scf_file} ${OUTPUT_DIR}
    ${snapshot_file}       OAM Get Snapshot
    Run                    mv ${snapshot_file} ${OUTPUT_DIR}/snapshot_CNI-102921_Collect_Emil_R3252512.zip
    Step                   run_script           once         AutoGen_UE_25_to_32_Setup_DL90mbps.sce
    Step                   run_script           once         AutoGen_UE_33_to_48_Setup_DL300mbps.sce
    Step                   run_script           once         AutoGen_UE_25_to_48_Release.sce
    dcap_stop              ${trace_id}
    dcap_get_results       ${trace_id}    ${OUTPUT_DIR}
    dcap_stop_container

[0]CNI-102921_Campaign1_Postlude
    Step                   Step_Postlude
