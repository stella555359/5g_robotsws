*** Variables ***

# capture setting
&{CAPTURE_L1L2}                                 is_capture_core=${False}
...                                             is_capture_cprt=${True}
...                                             is_capture_l1l2=${True}

# tests settings
&{cell_mod1}                                    cellnum=1
...                                             nr_arfcn=636000
...                                             gscn=7867

&{cell_mod2}                                    cellnum=2
...                                             nr_arfcn=636000
...                                             gscn=7867

@{allcells_mod}                                 &{cell_mod1}
...                                             &{cell_mod2}


&{CB011031_A}                                   capture_duration=0                      # capture duration during traffic starting phase
...                                             deviation=99                            # default deviation for throughput and double for uplink
...                                             dir=UL+DL
...                                             dldev=0                                 # DL deviation on tput for PM check
...                                             uldev=1                                 # UL deviation on tput for PM check
...                                             duration=3                              # traffic duration during declaration phase
...                                             pm_waiting_period=2                     # number of waiting periods added for observation
...                                             target_gnb=2                            # gnb target id
...                                             total_nb_cell=1                         # total number of cell used for ue's dispatching
...                                             total_nb_ue=0                           # total number of ue's to configure

# ue's settings # configuration based chBW=40Mhz
&{dict_settings_ue_01}                          ueid=1
...                                             original_cell=1                         # original cell for call establishment
...                                             throughput=600                          # dl throughput nonGBR max for ue in chBW=100MHz wo/blanking
...                                             throughput_gbr=${NO_THROUGHPUT}         # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                             throughput_ul=90                        # ul throughput nonGBR max for ue in chBW=100MHz wo/blanking

&{dict_settings_ue_21}                          ueid=21
...                                             original_cell=2
...                                             throughput=600
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=90

&{dict_settings_ue_101}                         ueid=101
...                                             original_cell=1
...                                             throughput=354
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=94

&{dict_settings_ue_121}                         ueid=121
...                                             original_cell=2
...                                             throughput=355
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=95

&{dict_settings_ue_default}                     original_cell=1
...                                             throughput=100
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=20

@{dict_settings_A_2}                            ${dict_settings_ue_01}
...                                             ${dict_settings_ue_21}


