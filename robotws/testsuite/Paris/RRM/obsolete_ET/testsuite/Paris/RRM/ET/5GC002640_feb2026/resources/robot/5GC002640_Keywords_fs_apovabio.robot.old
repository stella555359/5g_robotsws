DSS_CRM_Cell_Setup_Phase3_new    #brut de fonderie
    [Documentation]      KW used to set DSS Cell setup on primary Cell
    [Arguments]        ${id}=1    ${cell}=1    ${tgt_cell}=3    ${ul_allocated_prb_list}=11,35

    DSS_CMD    enb_xp_param                           id=1    ignore_xp=off    xp_listening_socket=on
    Sleep   2s
    DSS_CMD    enb_xp_param                           id=1    xp_peers=2
    Sleep   2s
    DSS_CMD    enb_xp_link_up                         enb=1    target=2
    Sleep   2s

    DSS_CMD    enb_x2_link_up                         enb=1    target=2
    Sleep   2s

    DSS_CMD    enb_dss_param                          id=${id}    feature_flag=on    message_sets=V1,DMS3
    Sleep   2s
    DSS_CMD    enb_cell_param                         enb=1    id=${id}    lte_nr_dss_mode=DSS_PHASE_3    antenna_ports_num=2
    Sleep   2s
    DSS_CMD    enb_cell_dss_feature                   enb=1    id=${id}    nr_dl_peak_rate_increase=on
    Sleep   2s
    DSS_CMD    enb_cell_dss_feature                   enb=1    id=${id}    superfast_allocation=on
    Sleep   2s
    #wtsemu.enb_dss_cell_param                     enb=1    id=1    dl_resource_sharing_algo=dl_buffer_level_based
    DSS_CMD    enb_cell_dss_param                     enb=1    id=${id}    dl_resource_sharing_algo=dl_buffer_level_based
    Sleep   2s

    DSS_CMD    enb_dss_configure_partnership          enb=1    cell=${cell}    dss_peer=2:${tgt_cell}
    Sleep   2s

    DSS_CMD    enb_crm_cell_resource_reservation      enb=1    cell=${cell}    tgt_enb=2     tgt_cell=${tgt_cell}
    ...                                               assigned_dl_minimum_share_to_nr=30     assigned_dl_maximum_share_to_nr=100
    ...                                               assigned_dl_minimum_share_to_lte=15    assigned_dl_maximum_share_to_lte=70
    ...                                               assigned_ul_minimum_share_to_nr=20     assigned_ul_maximum_share_to_nr=70
    Sleep   2s
    DSS_CMD    enb_crm_param                          id=1    ul_qos_load_meas_timer=200    dl_qos_load_meas_timer=200
    sleep    30s

    DSS_CMD    enb_dss_establish_partnership           enb=1    cell=${cell}    tgt_enb=2    tgt_cell=${tgt_cell}
    sleep   10s

    #wtsemu.enb_dss_cell_resource_reservation_dl    enb=1    cell=1    reset
    DSS_CMD    enb_dss_dl_cell_resource_reservation    enb=1    cell=${cell}    #reset
    Sleep   2s
    #wtsemu.enb_dss_cell_resource_reservation_ul    enb=1    cell=1    reset
    DSS_CMD    enb_dss_ul_cell_resource_reservation    enb=1    cell=${cell}    #reset
    Sleep    2s

    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1    prb_area_reservation_list=0,0,0-10-none+0,0,5-10-none+0,0,9-10-none
    DSS_CMD    enb_dss_dl_cell_resource_reservation    cell=${cell}    enb=1    prb_area_reservation_list=0,0,0-10-none+0,0,5-10-none+0,0,9-10-none
    Sleep    2s
    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1 reserved_fixed_normal_subframes=1000010001-1000010001-1000010001-1000010001-
    #...                                                                                            1000010001-1000010001-1000010001-1000010001
    DSS_CMD    enb_dss_dl_cell_resource_reservation    cell=${cell}    enb=1
    ...           reserved_fixed_normal_subframes=1000010001-1000010001-1000010001-1000010001-1000010001-1000010001-1000010001-1000010001
    Sleep    2s
    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1 min_lte_nr_dss_ratio=30    max_lte_nr_dss_ratio=100
    DSS_CMD    enb_dss_dl_cell_resource_reservation    cell=${cell}    enb=1    min_lte_nr_dss_ratio=30    max_lte_nr_dss_ratio=100
    Sleep    2s

    DSS_CMD    enb_dss_cell_resource_coordination      enb=1    cell=${cell}    tgt_enb=2    tgt_cell=${tgt_cell}    dir=DL
    Sleep    2s
    DSS_CMD    enb_dss_ul_cell_resource_reservation    enb=1    cell=${cell}    minimum_prb_share=30    maximum_prb_share=70
    Sleep    2s
    DSS_CMD    enb_dss_cell_resource_coordination      enb=1    cell=${cell}    tgt_enb=2    tgt_cell=${tgt_cell}    dir=UL
    Sleep    2s
    DSS_CMD    enb_crm_status                          enb=1    cell=1
    sleep    3m

    DSS_CMD    enb_dss_resource_allocation            enb=1    cell=${cell}    tgt_enb=2    tgt_cell=${tgt_cell}    dir=DL
    ...                                           allocation_start_time=immediate
    ...             dl_allocated_normal_subframes=0011101000-0111101110-0011101000-0111101110-0011101000-0111101110-0011101000-0111101110
    Sleep    2s
    #FOR PRBlanking
    DSS_CMD    enb_dss_resource_allocation            enb=1    cell=${cell}    tgt_enb=2    tgt_cell=${tgt_cell}    dir=UL
    ...                                           allocation_start_time=immediate    ul_allocated_prb_list=${ul_allocated_prb_list}
    Sleep    2s
    DSS_CMD    enb_crm_status                         enb=1    cell=1
    Sleep    2s



DSS_CRM_Cell_Setup_Phase3_SUPERFAST_new
    [Documentation]      KW used to set DSS Cell setup on primary Cell
    [Arguments]        ${id}=1    ${cell}=1    ${tgt_cell}=3

    DSS_CMD    enb_xp_param                           id=1    ignore_xp=off    xp_listening_socket=on
    Sleep   2s
    DSS_CMD    enb_xp_param                           id=1    xp_peers=2
    Sleep   2s
    DSS_CMD    enb_xp_link_up                         enb=1    target=2
    Sleep   2s

    DSS_CMD    enb_x2_link_up                         enb=1    target=2
    Sleep   2s

    Run Keyword If    ${debugDSS}                     DSS_CMD    sim_trace    enb=1    protocol=xp,xpu on
    Sleep   2s

    DSS_CMD    enb_dss_param                          id=${id}    feature_flag=on    message_sets=DMS3
    Sleep   2s
    DSS_CMD    enb_cell_param                         enb=1    id=${id}    lte_nr_dss_mode=DSS_PHASE_3    antenna_ports_num=2
    Sleep   2s
    DSS_CMD    enb_cell_dss_feature                   enb=1    id=${id}    nr_dl_peak_rate_increase=on
    Sleep   2s
    DSS_CMD    enb_cell_dss_feature                   enb=1    id=${id}    superfast_allocation=on
    Sleep   2s
    #wtsemu.enb_dss_cell_param                     enb=1    id=1    dl_resource_sharing_algo=dl_buffer_level_based
    DSS_CMD    enb_cell_dss_param                     enb=1    id=${id}    dl_resource_sharing_algo=dl_buffer_level_based
    Sleep   2s

    DSS_CMD    enb_dss_configure_partnership          enb=1    cell=${cell}    dss_peer=2:${tgt_cell}
    Sleep   2s

    DSS_CMD    enb_crm_cell_resource_reservation      enb=1    cell=${cell}    tgt_enb=2     tgt_cell=${tgt_cell}
    ...                                               assigned_dl_minimum_share_to_nr=30     assigned_dl_maximum_share_to_nr=100
    ...                                               assigned_dl_minimum_share_to_lte=15    assigned_dl_maximum_share_to_lte=70
    ...                                               assigned_ul_minimum_share_to_nr=20     assigned_ul_maximum_share_to_nr=70
    Sleep   2s
    DSS_CMD    enb_crm_param                          id=1    ul_qos_load_meas_timer=30    dl_qos_load_meas_timer=10
    sleep    30s

    DSS_CMD    enb_dss_establish_partnership           enb=1    cell=${cell}    tgt_enb=2    tgt_cell=${tgt_cell}
    sleep   10s

    wait until keyword succeeds     5min    20s    CheckCoordination

    #wtsemu.enb_dss_cell_resource_reservation_dl    enb=1    cell=1    reset
    DSS_CMD    enb_dss_dl_cell_resource_reservation    enb=1    cell=${cell}    #reset
    Sleep   2s
    #wtsemu.enb_dss_cell_resource_reservation_ul    enb=1    cell=1    reset
    DSS_CMD    enb_dss_ul_cell_resource_reservation    enb=1    cell=${cell}    #reset
    Sleep    2s

    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1    prb_area_reservation_list=0,0,0-10-none+0,0,5-10-none+0,0,9-10-none
    DSS_CMD    enb_dss_dl_cell_resource_reservation    cell=${cell}    enb=1    prb_area_reservation_list=0,0,0-10-none+0,0,5-10-none+0,0,9-10-none
    Sleep    2s
    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1 reserved_fixed_normal_subframes=0000000000-0000000000-0000000000-0000000000-
    #...                                                                                            0000000000-0000000000-0000000000-0000000000
    DSS_CMD    enb_dss_dl_cell_resource_reservation    cell=${cell}    enb=1
    ...           reserved_fixed_normal_subframes=0000000000-0000000000-0000000000-0000000000-0000000000-0000000000-0000000000-0000000000
    Sleep    2s
    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1 min_lte_nr_dss_ratio=30    max_lte_nr_dss_ratio=100
    DSS_CMD    enb_dss_dl_cell_resource_reservation    cell=${cell}    enb=1    min_lte_nr_dss_ratio=30    max_lte_nr_dss_ratio=100
    Sleep    2s

    DSS_CMD    enb_dss_cell_resource_coordination      enb=1    cell=${cell}    tgt_enb=2    tgt_cell=${tgt_cell}    dir=DL
    Sleep    2s
    DSS_CMD    enb_dss_ul_cell_resource_reservation    enb=1    cell=${cell}    minimum_prb_share=30    maximum_prb_share=70
    Sleep    2s
    DSS_CMD    enb_dss_cell_resource_coordination      enb=1    cell=${cell}    tgt_enb=2    tgt_cell=${tgt_cell}    dir=UL
    Sleep    2s
    DSS_CMD    enb_crm_status                          enb=1    cell=1
    sleep    3m

    ${dl_prb_area_allocation_list}=    Catenate    SEPARATOR=    0:0,52+1:0,0+2:0,52+3:0,52+4:0,52+5:0,36+6:0,52+7:0,52+8:0,52+9:0,
    ...                              36+10:0,52+11:0,52+12:0,52+13:0,52+14:0,52+15:0,36+16:0,52+17:0,52+18:0,52+19:0,36+20:0,52+21:0,
    ...                              0+22:0,52+23:0,52+24:0,52+25:0,36+26:0,52+27:0,52+28:0,52+29:0,36+30:0,52+31:0,52+32:0,52+33:0,
    ...                              52+34:0,52+35:0,36+36:0,52+37:0,52+38:0,52+39:0,36+40:0,52+41:0,0+42:0,52+43:0,52+44:0,52+45:0,
    ...                              36+46:0,52+47:0,52+48:0,52+49:0,36+50:0,52+51:0,52+52:0,52+53:0,52+54:0,52+55:0,36+56:0,52+57:0,
    ...                              52+58:0,52+59:0,36+60:0,52+61:0,0+62:0,52+63:0,52+64:0,52+65:0,36+66:0,52+67:0,52+68:0,52+69:0,
    ...                              36+70:0,52+71:0,52+72:0,52+73:0,52+74:0,52+75:0,36+76:0,52+77:0,52+78:0,52+79:0,36


    # wtsemu.enb_crm_periodic_allocation_pattern     enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=DL    allocation_start_time=auto
    # ...  delay_if_auto=20    dl_allocated_normal_subframes=1011111111-1111111111-1011111111-1111111111-1011111111-1111111111-1011111111-1111111111
    # ...  dl_prb_area_allocation_list=${dl_prb_area_allocation_list}
    DSS_CMD    enb_crm_periodic_allocation_pattern            enb=1    cell=${cell}    tgt_enb=2    tgt_cell=${tgt_cell}    dir=DL
    ...                                                       allocation_start_time=auto
    ...  delay_if_auto=20    dl_allocated_normal_subframes=1011111111-1111111111-1011111111-1111111111-1011111111-1111111111-1011111111-1111111111
    ...  dl_prb_area_allocation_list=${dl_prb_area_allocation_list}

    Sleep    2s

    ${dl_prb_area_allocation_list}=    Catenate    SEPARATOR=    0:0,0+1:0,0+2:0,52+3:0,52+4:0,52+5:0,0+6:0,52+7:0,52+8:0,52+9:0,
    ...                              0+10:0,0+11:0,52+12:0,52+13:0,52+14:0,52+15:0,0+16:0,52+17:0,52+18:0,52+19:0,0+20:0,0+21:0,
    ...                              0+22:0,52+23:0,52+24:0,52+25:0,0+26:0,52+27:0,52+28:0,52+29:0,0+30:0,0+31:0,52+32:0,52+33:0,
    ...                              52+34:0,52+35:0,0+36:0,52+37:0,52+38:0,52+39:0,0+40:0,0+41:0,0+42:0,52+43:0,52+44:0,52+45:0,
    ...                              0+46:0,52+47:0,52+48:0,52+49:0,0+50:0,0+51:0,52+52:0,52+53:0,52+54:0,52+55:0,0+56:0,52+57:0,
    ...                              52+58:0,52+59:0,0+60:0,0+61:0,0+62:0,52+63:0,52+64:0,52+65:0,0+66:0,52+67:0,52+68:0,52+69:0,
    ...                              0+70:0,0+71:0,52+72:0,52+73:0,52+74:0,52+75:0,0+76:0,52+77:0,52+78:0,52+79:0,0

    # wtsemu.enb_crm_periodic_allocation_pattern     enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=DL    allocation_start_time=auto
    # ...  delay_if_auto=20    dl_allocated_normal_subframes=0011101110-0111101110-0011101110-0111101110-0011101110-0111101110-0011101110-0111101110
    # ...  dl_prb_area_allocation_list=${dl_prb_area_allocation_list}
    DSS_CMD    enb_crm_periodic_allocation_pattern            enb=1    cell=${cell}    tgt_enb=2    tgt_cell=${tgt_cell}    dir=DL
    ...                                                       allocation_start_time=auto
    ...  delay_if_auto=20    dl_allocated_normal_subframes=0011101110-0111101110-0011101110-0111101110-0011101110-0111101110-0011101110-0111101110
    ...  dl_prb_area_allocation_list=${dl_prb_area_allocation_list}
    Sleep    2s

    # wtsemu.enb_crm_periodic_resource_allocation    enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=DL    periodicity=10    loopback=on
    # ...                                            periodicity_and_load_indication=on    periodicity_messages_logged=500
    DSS_CMD    enb_crm_periodic_resource_allocation    enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=DL    periodicity=10    loopback=on
    ...                                                periodicity_and_load_indication=on    periodicity_messages_logged=500
    Sleep    2s

    # wtsemu.enb_crm_periodic_allocation_pattern     enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL    allocation_start_time=auto
    # ...                                            delay_if_auto=20    ul_allocated_prb_list=1,35
    DSS_CMD    enb_crm_periodic_allocation_pattern     enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL    allocation_start_time=auto
    ...                                                delay_if_auto=20    ul_allocated_prb_list=1,35
    Sleep    2s

    # wtsemu.enb_crm_periodic_allocation_pattern     enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL    allocation_start_time=auto
    # ...                                            delay_if_auto=20    ul_allocated_prb_list=1,20
    DSS_CMD    enb_crm_periodic_allocation_pattern     enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL    allocation_start_time=auto
    ...                                                delay_if_auto=20    ul_allocated_prb_list=1,20
    Sleep    2s

    # wtsemu.enb_crm_periodic_resource_allocation    enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL    periodicity=30    loopback=on
    # ...                                            periodicity_and_load_indication=on    periodicity_messages_logged=500
    DSS_CMD    enb_crm_periodic_resource_allocation    enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL    periodicity=30    loopback=on
    ...                                                periodicity_and_load_indication=on    periodicity_messages_logged=500
    Sleep    2s

    DSS_CMD    enb_crm_status                         enb=1    cell=1
    Sleep    2s


DSS_CRM_Cell_Setup_Phase3_SUPERFAST_bdf    #brut de fonderie
    [Documentation]      KW used to set DSS Cell setup on primary Cell
    ...                  with Super fast allocation enabled in FDD Pcell

    wtsemu.enb_xp_param                           id=1    ignore_xp=off    xp_listening_socket=on
    Sleep   1s
    wtsemu.enb_xp_param                           id=1    xp_peers=2
    Sleep   1s
    wtsemu.enb_xp_link_up                         enb=1    target=2

    Sleep   10s

    wtsemu.enb_x2_link_up                         enb=1    target=2
    Sleep   2s

    Run Keyword If    ${debugDSS}                   wtsemu.sim_trace    enb=1    protocol=xp,xpu on
    Sleep   2s

    wtsemu.enb_dss_param                          id=1    feature_flag=on    message_sets=DMS3
    Sleep   1s
    wtsemu.enb_cell_param                         enb=1    id=1    lte_nr_dss_mode=DSS_PHASE_3    antenna_ports_num=2
    Sleep   1s
    wtsemu.enb_cell_dss_feature                   enb=1    id=1    nr_dl_peak_rate_increase=on
    Sleep   1s
    wtsemu.enb_cell_dss_feature                   enb=1    id=1    superfast_allocation=on
    Sleep   1s
    #wtsemu.enb_dss_cell_param                     enb=1    id=1    dl_resource_sharing_algo=dl_buffer_level_based
    wtsemu.enb_cell_dss_param                     enb=1    id=1    dl_resource_sharing_algo=dl_buffer_level_based
    Sleep   2s

    wtsemu.enb_dss_configure_partnership          enb=1    cell=1    dss_peer=2:3
    Sleep   2s

    wtsemu.enb_crm_cell_resource_reservation      enb=1    cell=1    tgt_enb=2    tgt_cell=3    assigned_dl_minimum_share_to_nr=30
    ...                                           assigned_dl_maximum_share_to_nr=100    assigned_dl_minimum_share_to_lte=15
    ...                                           assigned_dl_maximum_share_to_lte=70    assigned_ul_minimum_share_to_nr=20
    ...                                           assigned_ul_maximum_share_to_nr=70
    Sleep   2s
    wtsemu.enb_crm_param                          id=1    ul_qos_load_meas_timer=30    dl_qos_load_meas_timer=10

    sleep    60s

    wtsemu.enb_dss_establish_partnership           enb=1    cell=1    tgt_enb=2    tgt_cell=3
    sleep   10s

    wait until keyword succeeds     5min    20s    CheckCoordination

    #wtsemu.enb_dss_cell_resource_reservation_dl    enb=1    cell=1    reset
    wtsemu.enb_dss_dl_cell_resource_reservation    enb=1    cell=1    #reset
    Sleep   2s
    #wtsemu.enb_dss_cell_resource_reservation_ul    enb=1    cell=1    reset
    wtsemu.enb_dss_ul_cell_resource_reservation    enb=1    cell=1    #reset
    Sleep    2s

    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1    prb_area_reservation_list=0,0,0-10-none+0,0,5-10-none+0,0,9-10-none
    wtsemu.enb_dss_dl_cell_resource_reservation    cell=1    enb=1    prb_area_reservation_list=0,0,0-10-none+0,0,5-10-none+0,0,9-10-none
    Sleep    2s
    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1 reserved_fixed_normal_subframes=1000010001-1000010001-1000010001-1000010001-
    #...                                                                                            1000010001-1000010001-1000010001-1000010001
    wtsemu.enb_dss_dl_cell_resource_reservation    cell=1    enb=1
    ...    reserved_fixed_normal_subframes=0000000000-0000000000-0000000000-0000000000-0000000000-0000000000-0000000000-0000000000
    Sleep    10s
    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1 min_lte_nr_dss_ratio=30    max_lte_nr_dss_ratio=100
    wtsemu.enb_dss_dl_cell_resource_reservation    cell=1    enb=1    min_lte_nr_dss_ratio=30    max_lte_nr_dss_ratio=100
    Sleep    2s

    wtsemu.enb_dss_cell_resource_coordination      enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=DL
    Sleep    2s
    wtsemu.enb_dss_ul_cell_resource_reservation    enb=1    cell=1    minimum_prb_share=30    maximum_prb_share=70
    Sleep    2s
    wtsemu.enb_dss_cell_resource_coordination      enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL
    Sleep    2s
    wtsemu.enb_crm_status                          enb=1    cell=1
    sleep    2m

    ${dl_prb_area_allocation_list}=    Catenate    SEPARATOR=    0:0,52+1:0,0+2:0,52+3:0,52+4:0,52+5:0,36+6:0,52+7:0,52+8:0,52+9:0,
    ...                              36+10:0,52+11:0,52+12:0,52+13:0,52+14:0,52+15:0,36+16:0,52+17:0,52+18:0,52+19:0,36+20:0,52+21:0,
    ...                              0+22:0,52+23:0,52+24:0,52+25:0,36+26:0,52+27:0,52+28:0,52+29:0,36+30:0,52+31:0,52+32:0,52+33:0,
    ...                              52+34:0,52+35:0,36+36:0,52+37:0,52+38:0,52+39:0,36+40:0,52+41:0,0+42:0,52+43:0,52+44:0,52+45:0,
    ...                              36+46:0,52+47:0,52+48:0,52+49:0,36+50:0,52+51:0,52+52:0,52+53:0,52+54:0,52+55:0,36+56:0,52+57:0,
    ...                              52+58:0,52+59:0,36+60:0,52+61:0,0+62:0,52+63:0,52+64:0,52+65:0,36+66:0,52+67:0,52+68:0,52+69:0,
    ...                              36+70:0,52+71:0,52+72:0,52+73:0,52+74:0,52+75:0,36+76:0,52+77:0,52+78:0,52+79:0,36

    wtsemu.enb_crm_periodic_allocation_pattern     enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=DL    allocation_start_time=auto
    ...  delay_if_auto=20    dl_allocated_normal_subframes=1011111111-1111111111-1011111111-1111111111-1011111111-1111111111-1011111111-1111111111
    ...  dl_prb_area_allocation_list=${dl_prb_area_allocation_list}
    Sleep    2s

    ${dl_prb_area_allocation_list}=    Catenate    SEPARATOR=    0:0,0+1:0,0+2:0,52+3:0,52+4:0,52+5:0,0+6:0,52+7:0,52+8:0,52+9:0,
    ...                              0+10:0,0+11:0,52+12:0,52+13:0,52+14:0,52+15:0,0+16:0,52+17:0,52+18:0,52+19:0,0+20:0,0+21:0,
    ...                              0+22:0,52+23:0,52+24:0,52+25:0,0+26:0,52+27:0,52+28:0,52+29:0,0+30:0,0+31:0,52+32:0,52+33:0,
    ...                              52+34:0,52+35:0,0+36:0,52+37:0,52+38:0,52+39:0,0+40:0,0+41:0,0+42:0,52+43:0,52+44:0,52+45:0,
    ...                              0+46:0,52+47:0,52+48:0,52+49:0,0+50:0,0+51:0,52+52:0,52+53:0,52+54:0,52+55:0,0+56:0,52+57:0,
    ...                              52+58:0,52+59:0,0+60:0,0+61:0,0+62:0,52+63:0,52+64:0,52+65:0,0+66:0,52+67:0,52+68:0,52+69:0,
    ...                              0+70:0,0+71:0,52+72:0,52+73:0,52+74:0,52+75:0,0+76:0,52+77:0,52+78:0,52+79:0,0

    wtsemu.enb_crm_periodic_allocation_pattern     enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=DL    allocation_start_time=auto
    ...  delay_if_auto=20    dl_allocated_normal_subframes=0011101110-0111101110-0011101110-0111101110-0011101110-0111101110-0011101110-0111101110
    ...  dl_prb_area_allocation_list=${dl_prb_area_allocation_list}
    Sleep    2s
    wtsemu.enb_crm_periodic_resource_allocation    enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=DL    periodicity=10    loopback=on
    ...                                            periodicity_and_load_indication=on    periodicity_messages_logged=500
    Sleep    2s

    wtsemu.enb_crm_periodic_allocation_pattern     enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL    allocation_start_time=auto
    ...                                            delay_if_auto=20    ul_allocated_prb_list=1,35
    Sleep    2s
    wtsemu.enb_crm_periodic_allocation_pattern     enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL    allocation_start_time=auto
    ...                                            delay_if_auto=20    ul_allocated_prb_list=1,20
    Sleep    2s
    wtsemu.enb_crm_periodic_resource_allocation    enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL    periodicity=30    loopback=on
    ...                                            periodicity_and_load_indication=on    periodicity_messages_logged=500
    Sleep    2s
    wtsemu.enb_crm_status                          enb=1    cell=1
    Sleep    2s

CheckCoordination
    [documentation]    KW helping to check nessary messages in DSS Cell_setup

    CallSetup.Flush Egate Console Buffer
    Traced sleep   3s  msg=wait 3s to flush egate memory on egate_console.log
    Grep and check in file          host=${HOST_EPCSIM}             file=${tl.core.dir_path}/egate_console.log
    ...                             grep=EN DSS DL Cell             pattern=EN DSS DL Cell Resource Area Coordination success on remote NE
    Grep and check in file          host=${HOST_EPCSIM}             file=${tl.core.dir_path}/egate_console.log
    ...                             grep=EN DSS UL Cell             pattern=Subcarrier Resource Coordination success on remote NE

5GC002640-5G-8533AB5_Settings
    [Documentation]    Basic cfg donwload + Restart TL
    [Tags]  RESTART_STARTUP
    # [Arguments]        ${basic}=testsuite/Paris/RRM/ET/5GC002640/resources/config/basic_setup_8533_AB5.cfg

    #     run    cd /opt/iphy/latest && rm basic_wts_step2.modified.lua basic_wts_step2.modified.cfg basic_wts_step2.cfg 2>/dev/null
    # Basic_delivery     ${basic}
    Set Context_WTS CFG cell                               # set_cell id=3 => set_cell id=1
    #Update Arfcn in WTS Cfg multi Cell     ${param.arfcn} # this is brought now by basic_setup_8533_AB5.cfg
    #Update UeNrCapa In WTS Cfg multi UE    ${param.UEList} # this is brought now by basic_setup_8533_AB5.cfg
    Restart.Restart TL
    ${F_Restart}             set variable    PASS
    Set Suite Variable    ${F_Restart}

5GC002640-5G-F_Settings
    [Documentation]    Basic cfg donwload + Restart TL
    [Tags]  RESTART_STARTUP

    Set Context_WTS CFG cell                               # set_cell id=3 => set_cell id=1
    #Update Arfcn in WTS Cfg multi Cell     ${param.arfcn} # this is brought now by basic_setup_fts.cfg or basic_setup_ftsTC03.cfg
    Update UeNrCapa In WTS Cfg multi UE    ${param.UEList}
    Restart.Restart TL
    ${F_Restart}             set variable    PASS
    Set Suite Variable    ${F_Restart}

5GC002640-5G-F_Cell_Setup
    [Documentation]    Cell setup for cell non DSS
    [Tags]  Cell_Setup
    [Arguments]        ${blank}=${False}    ${DSS_SuperFastAlloc}=${False}    ${DSS_Ph3}=${False}

    # WTS Setup for DSS Plus nonDSS cells    shouldUseLua=${False}    postprocessing=Check_Cell_SetupIs_Ok_on_AirPhoneDSSnonDSSMixtCase
    WTS Setup for DSS Plus nonDSS cells    shouldUseLua=${False}    postprocessing=Check_IfAirPhone_is_waiting_DSScellsetup_commands

    Run Keyword If      ${blank}                 5GC002640-5G-F_DSS_Blanking
    Run Keyword If      ${DSS_SuperFastAlloc}    5GC002640-5G-F_DSS_SuperFastAlloc
    Run Keyword If      ${DSS_Ph3}               5GC002640-5G-F_DSS
    # Run Keyword If      ${8533_AB5}              DSS_CRM_Cell_Setup_Phase3_8533

    Traced sleep   20s        msg=To let time to Airphone to perform is cells setup  #in order to let time for cell_setup on AP

    Dated Log           CheckSIB
    Check SIB Using Cell Number   nbCell=6

    Traced sleep   3s   msg=wait 3s to flush egate memory on egate_console.log
    CallSetup.Flush Egate Console Buffer
    ${output}           SSH Wait For Connect and Cmd
    ...                 command=grep 'Cell Setup completed for' ${tl.core.dir_path}/egate_console.log
    ...                 host=${HOST_EPCSIM}

    FOR    ${i}    IN    @{CellList}
        Dated Log  is Cell Setup completed for [CELL_ID:${i}]  ?
        Should Contain	    ${output}	 Cell Setup completed for [CELL_ID:${i}]
    END

    Dated Log           ***********************************
    Dated Log           * AIRPHONE CELL_SETUP IS COMPLETE *
    Dated Log           ***********************************

    ${F_CellSetup}             set variable    PASS
    Set Suite Variable    ${F_CellSetup}

Check_IfAirPhone_is_waiting_DSScellsetup_commands
    [Documentation]    Check if all cells are up on Airphone side and start dss egate command for dss cells listed on @{DssCellList}

    ${pattern}=         Set Variable   PxyCellUeProtoControlHandler: MT_CELL_SETUP_REQ received for CellId:
    Dated Log           Check_AirPhone_is_waiting_DSScellsetup_commands: ${pattern}

    ${output}           SSH Wait For Connect and Cmd
	...                 command=grep -i ${pattern} /tmp/startup_l3.log
    ...                 host=${AP_DU.sys[0].M}

    # all Found => @{DssCellList} is empty
    Dated Log       $output:>${output}<
    Dated Log       $DssCellList:>${DssCellList}<

    FOR    ${i}    IN       @{DssCellList}
                            ${patternWithCellid} = 	Set Variable 	${pattern}${i}
                            Dated Log               check in /tmp/startup_l3.log ${patternWithCellid}
                            Should Contain    ${output}    ${patternWithCellid}
                            Remove Values From List 	${DssCellList} 	${i}
                            Dated Log     DssCellList: ${DssCellList}
                            ${toberun}     Evaluate    "DSS_CRM_Cell_Setup_Phase3_8533_tgt_cell${i}"
                            Dated Log     LANCEMENT DE : ${toberun}
                            Run Keyword    ${toberun}
    END

    # Should Contain	    ${output}	 ${patternWithCellid}
    Should Be Empty  ${DssCellList}

# Check_IfAirPhone_is_waiting_DSScellsetup_commands_C3
#     [Documentation]    Check if all cells are up on Airphone side
