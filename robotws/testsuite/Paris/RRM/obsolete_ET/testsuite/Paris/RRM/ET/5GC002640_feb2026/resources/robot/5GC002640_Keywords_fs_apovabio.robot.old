DSS_CMD
    [Documentation]      (FORECASTED not used ongoing) KW helping to send and log on console dss command not yet used
    [Arguments]          @{varargs}    &{kwargs}      #les non named vont dans la suite @{varargs} les named argument vont dans le dico &{kwargs}
    # ${msg}    set variable     ${EMPTY}
    # FOR    ${k}    IN    @{kwargs.keys()}
    #        ${msg}     CATENATE     ${msg}   ${space}${space}${k}=${kwargs['${k}']}
    # END
    # # log to console    ----> ${varargs[0]} ${msg} <----
    Dated Log    ----> wtsemu.${varargs[0]} &{kwargs}
    # ${msg}     CATENATE     wtsemu.${varargs[0]}    ${space}${space}${msg}
    # Dated Log      ${msg}
    Run Keyword    wtsemu.${varargs[0]}    &{kwargs}


DSS_CRM_Cell_Setup_Phase3_bdf    #brut de fonderie
    [Documentation]      KW used to set DSS Cell setup on primary Cell

    wtsemu.enb_xp_param                           id=1    ignore_xp=off    xp_listening_socket=on
    Sleep   2s
    wtsemu.enb_xp_param                           id=1    xp_peers=2
    Sleep   2s
    wtsemu.enb_xp_link_up                         enb=1    target=2
    Sleep   2s

    wtsemu.enb_x2_link_up                         enb=1    target=2
    Sleep   2s

    wtsemu.enb_dss_param                          id=1    feature_flag=on    message_sets=V1,DMS3
    Sleep   2s
    wtsemu.enb_cell_param                         enb=1    id=1    lte_nr_dss_mode=DSS_PHASE_3    antenna_ports_num=2
    Sleep   2s
    wtsemu.enb_cell_dss_feature                   enb=1    id=1    nr_dl_peak_rate_increase=on
    Sleep   2s
    wtsemu.enb_cell_dss_feature                   enb=1    id=1    superfast_allocation=on
    Sleep   2s
    #wtsemu.enb_dss_cell_param                     enb=1    id=1    dl_resource_sharing_algo=dl_buffer_level_based
    wtsemu.enb_cell_dss_param                     enb=1    id=1    dl_resource_sharing_algo=dl_buffer_level_based
    Sleep   2s

    wtsemu.enb_dss_configure_partnership          enb=1    cell=1    dss_peer=2:3
    Sleep   2s

    wtsemu.enb_crm_cell_resource_reservation      enb=1    cell=1    tgt_enb=2    tgt_cell=3    assigned_dl_minimum_share_to_nr=30
    ...                                           assigned_dl_maximum_share_to_nr=100    assigned_dl_minimum_share_to_lte=15
    ...                                           assigned_dl_maximum_share_to_lte=70    assigned_ul_minimum_share_to_nr=20
    ...                                           assigned_ul_maximum_share_to_nr=70
    Sleep   2s
    wtsemu.enb_crm_param                          id=1    ul_qos_load_meas_timer=200    dl_qos_load_meas_timer=200
    sleep    30s

    wtsemu.enb_dss_establish_partnership           enb=1    cell=1    tgt_enb=2    tgt_cell=3
    sleep   10s

    #wtsemu.enb_dss_cell_resource_reservation_dl    enb=1    cell=1    reset
    wtsemu.enb_dss_dl_cell_resource_reservation    enb=1    cell=1    #reset
    Sleep   2s
    #wtsemu.enb_dss_cell_resource_reservation_ul    enb=1    cell=1    reset
    wtsemu.enb_dss_ul_cell_resource_reservation    enb=1    cell=1    #reset
    Sleep    2s

    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1    prb_area_reservation_list=0,0,0-10-none+0,0,5-10-none+0,0,9-10-none
    wtsemu.enb_dss_dl_cell_resource_reservation    cell=1    enb=1    prb_area_reservation_list=0,0,0-10-none+0,0,5-10-none+0,0,9-10-none
    Sleep    2s
    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1 reserved_fixed_normal_subframes=1000010001-1000010001-1000010001-1000010001-
    #...                                                                                            1000010001-1000010001-1000010001-1000010001
    wtsemu.enb_dss_dl_cell_resource_reservation    cell=1    enb=1
    ...           reserved_fixed_normal_subframes=1000010001-1000010001-1000010001-1000010001-1000010001-1000010001-1000010001-1000010001
    Sleep    2s
    #wtsemu.enb_dss_dl_resource_cell_reservation    cell=1    enb=1 min_lte_nr_dss_ratio=30    max_lte_nr_dss_ratio=100
    wtsemu.enb_dss_dl_cell_resource_reservation    cell=1    enb=1    min_lte_nr_dss_ratio=30    max_lte_nr_dss_ratio=100
    Sleep    2s

    wtsemu.enb_dss_cell_resource_coordination      enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=DL
    Sleep    2s
    wtsemu.enb_dss_ul_cell_resource_reservation    enb=1    cell=1    minimum_prb_share=30    maximum_prb_share=70
    Sleep    2s
    wtsemu.enb_dss_cell_resource_coordination      enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL
    Sleep    2s
    wtsemu.enb_crm_status                          enb=1    cell=1
    sleep    3m

    wtsemu.enb_dss_resource_allocation            enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=DL
    ...                                           allocation_start_time=immediate
    ...             dl_allocated_normal_subframes=0011101000-0111101110-0011101000-0111101110-0011101000-0111101110-0011101000-0111101110
    Sleep    2s
    wtsemu.enb_dss_resource_allocation            enb=1    cell=1    tgt_enb=2    tgt_cell=3    dir=UL
    ...                                           allocation_start_time=immediate    ul_allocated_prb_list=1,35
    Sleep    2s
    wtsemu.enb_crm_status                         enb=1    cell=1
    Sleep    2s

