*** Keywords ***

Test Teardown 5GC002640
    [Documentation]    Stop eventual Sherpa traces
    ...                Stop Traffic (even if already done for Failed cases not leading to normal traffic stop
    ...                collect Sos Report if a TC is failed or if the user need traces ForceDebugDataCollection
    ...

    Dated log                       Test teardown 5GC002640: start
    Produce Scout Data

    Dated log                       traffic ongoing? : ${TRF_ongoing}
    Run Keyword If                  ${TRF_ongoing}         Traffics Stop    ${param.UEList}
    Dated log                       enable_sherpa : ${enable_sherpa}
    Run Keyword If                  ${enable_sherpa}     Run Keywords
    ...                             Dated log            SHERPA STOP AND COLLECTION ongoing
    ...                             AND
    ...                                                  Deactivate Sherpa and Stop Collect

    # commented as this part is done on automaticTeardown=FirstFail
    # Run Keyword If                                       ${ForceDebugDataCollection}   Get Sos Report
    # Run Keyword If                                       ${ForceDebugDataCollection}   Get Snapshot
    # wtsemu.Reset Wtsemu Cfg
    Dated log                                             Test teardown 5GC002640: end


TC 2640-AB_00 SA
    [Documentation]     Used for small developpent test
    [Arguments]         ${param}

    Init Sequence       ${param}

    Critical Step                   RestartTLab
    Step                            Set_sCellDeactivationTimerGNB    argument=${param.sCellDeactivationTimerGNB}
    GenericTest.Display diagnosis

TC 2640-AB_01 SA
    [Documentation]     Generic test for SANSA 3CC Cellsetup
    [Arguments]         ${param}

    ${enable_sherpa}             set variable           ${False}   #This TC not need Sherpa, this setting is present as Jenchins may set Sherpa
    Dated log                    enable_sherpa : ${enable_sherpa}
    Init Sequence                ${param}

    Critical Step                RestartTLab
    Critical Step                Start Mirroring And Traces AP
    Critical Step                Start Mirroring And Traces gNB
    Critical Step                WTS_Cell_Setup
    Critical Step                Stop Mirroring And Traces gNB
    Critical Step                Stop Mirroring And Traces AP
    Critical Step                carrierAggregationSupportList set to 600
    Critical Step                Check 5gnb still Cell on Air
    GenericTest.Display diagnosis


TC 2640-AB_02 SA
    [Documentation]     Generic test for SANSA 3CC Cellsetup
    [Arguments]         ${param}

    ${enable_sherpa}             set variable           ${False}   #This TC not need Sherpa, this setting is present as Jenchins may set Sherpa
    Init Sequence                ${param}

    #See Golden Critical Step                Commission SCF From Config Folder
    Critical Step                RestartTLab
    Critical Step                carrierAggregationSupportList set to 600
    Step                         weightForSCellSelection          argument=${param.NrRelweightForSCellSelection_List}
    Critical Step                WTS_Cell_Setup
    Step                         UE_register_Local                argument=${param.UEList}
    Step                         PDU_Session                      argument=${param.UEList}    depends=UE_register_Local
    Critical Step                Check_sCellToAddModList_onegateLogs
    Step                         Check_sCellIndex_onegateLogs    argument=${param.NrRel_TargetedbyWeight_List}
    GenericTest.Display diagnosis


TC 2640-AB_03 SA
    [Documentation]     Generic test for SANSA 3CC Cellsetup
    [Arguments]         ${param}

    Init Sequence       ${param}
    ${enable_sherpa}             set variable           ${False}   #This TC not need Sherpa, this setting is present as Jenchins may set Sherpa

    #See Golden Critical Step                Commission SCF From Config Folder
    Critical Step                RestartTLab
    Critical Step                carrierAggregationSupportList set to 600
    Step                         weightForSCellSelection          argument=${param.NrRelweightForSCellSelection_List}
    Step                         Set_NRREL_info                   argument=${param.NrRel_TC3_setting}
    Step                         Update UeNrCapa In WTS Cfg multi UE    argument=${param.UEList}
    # Critical Step                Start Mirroring And Traces AP    depends=weightForSCellSelection
    # Critical Step                Start Mirroring And Traces gNB
    Critical Step                WTS_Cell_Setup
    Run Keyword If               ${enable_sherpa}                 Activate Sherpa
    Step                         UE_register_Local                argument=${param.UEList}
    Step                         PDU_Session                      argument=${param.UEList}    depends=UE_register_Local
    # Critical Step                Stop Mirroring And Traces gNB
    # Critical Step                Stop Mirroring And Traces AP
    Critical Step                Check_sCellToAddModList_onegateLogs
    Step                         Check_sCellIndex_onegateLogs    argument=${param.NrRel_TargetedbyWeight_List}
    GenericTest.Display diagnosis


TC 2640-AB_04 SA
    [Documentation]     Generic test for SANSA 3CC Cellsetup
    ...                 "activated_successfully_at_airphone" message on egate is not seen at the  begining but after
    ...                 a moment. It is the reason why we attempt to find it each minutes on a 10min period
    ...                 This lead to see some red tags on html.log but without incidences to the test up to green one
    [Arguments]         ${param}

    Init Sequence       ${param}

    Critical Step                   RestartTLab
    Critical Step                   carrierAggregationSupportList set to 600
    Step                            weightForSCellSelection          argument=${param.NrRelweightForSCellSelection_List}
    Step                            Set_iniNumSCellsToActivate       argument=${param.iniNumSCellsToActivate}
    Step                            Set_sCellActivationMethod        argument=${param.sCellActivationMethod}
    Critical Step                   WTS_Cell_Setup
    Run Keyword If                  ${enable_sherpa}                 Activate Sherpa
    Step                            UE_register_Local                argument=${param.UEList}
    Step                            PDU_Session                      argument=${param.UEList}    depends=UE_register_Local
    Step                            Traffic                          argument=${param.UEList}    depends=PDU_Session
    Critical Step                   Check_sCellToAddModList_onegateLogs                          depends=Traffic
    Step                            Check_sCellIndex_onegateLogs    argument=${param.NrRel_TargetedbyWeight_List}    depends=Traffic
    #Warning first attempt may be failed !!!
    wait until keyword succeeds     10min    60s    Check_activated_successfully_at_airphone_onegateLogs
    Step                            Traffics Stop    argument=${param.UEList}    depends=Traffic
    GenericTest.Display diagnosis



TC 2640-AB_07 SA
    [Documentation]     This TC set on the fly several marameters
    ...                 carrierAggregationSupportList / weightForSCellSelection / iniNumSCellsToActivate
    ...                 sCellActivationMethod         / Set_sCellActivationMethod
    ...                 restart the test line
    ...                 start a SA L2 call on 1 ue_id3 CA capable
    ...                 Start UL & DL traffic for a short time
    ...                 check sCellToAddModList & sCellIndex on egate_logs
    ...                 Stop traffic DL only
    ...                 check sCellIndex 1 & 2 are deactivated on egate log
    ...                 stop all traffic
    [Arguments]         ${param}

    Init Sequence       ${param}
    TestSuiteFolderCreation    step=Config_TestStart_
    Collect_Configfiles        step=Config_TestStart_


    Critical Step                   carrierAggregationSupportList set to 600
    Step                            weightForSCellSelection          argument=${param.NrRelweightForSCellSelection_List}
    Step                            Set_iniNumSCellsToActivate       argument=${param.iniNumSCellsToActivate}
    Step                            Set_sCellDeactivationTimerGNB    argument=${param.sCellDeactivationTimerGNB}
    Step                            Set_sCellActivationMethod        argument=${param.sCellActivationMethod}

    Restart TL

    TestSuiteFolderCreation    step=configReady_
    Collect_Configfiles        step=configReady_

    # Critical Step                   WTS_Cell_Setup
    Critical Step                   WTS Setup for DSS Plus nonDSS cells    shouldUseLua=${False}    postprocessing=Check_Cell_SetupIs_Ok_on_AirPhone

    Run Keyword If                  ${enable_sherpa}                 Activate Sherpa
    Step                            UE_register_Local                argument=${param.UEList}
    Step                            PDU_Session                      argument=${param.UEList}    depends=UE_register_Local
    Step                            Traffic                          argument=${param.UEList}    depends=PDU_Session
    sleep     60s
    Step                            Traffics Check                   argument=${param.UEList}    depends=Traffic
    Critical Step                   Check_sCellToAddModList_onegateLogs                          depends=Traffic
    Step                            Check_sCellIndex_onegateLogs    argument=${param.NrRel_TargetedbyWeight_List}    depends=Traffic

    # Critical Step                Start Mirroring And Traces AP
    # Critical Step                Start Mirroring And Traces gNB

    Traffics Stop                   ${param.UEList}    dl
    sleep     30s

    # Critical Step                Stop Mirroring And Traces gNB
    # Critical Step                Stop Mirroring And Traces AP

    Step                            Traffics Stop    argument=${param.UEList}    depends=Traffic
    sleep     20s
    Check_sCellIndex_onegateLogs    ${param.NrRel_TargetedbyWeight_List}   actdeact=deactivated
    GenericTest.Display diagnosis


TC 2640-AB_08 SA
    [Documentation]
    ...       This TC check the DL traffic on 3 bearers : 1 default Bearer, 1  VONR signaling and 1 bearer VONR traffc
    ...       For 2640 feature with 1 Pcell and 2 Scell
    ...       Step :
    ...            1) modify commissioning
    ...            2) Cell Steup 6 cells 4 FDD and 2 TDD
    ...            3) UE register in SA
    ...            4) Setup PDU session for UE : defaut bearer 5QI-6
    ...            5.1) modify PDU session for UE : adding signaling VONR bearer 5QI-1
    ...            5.2) modify PDU session for UE : adding data VONR bearer 5QI-5
    ...            6) start trafic for the 3 bearers
    ...                 300Mbs DL 10Mbs UL for BE=5QI-6/QOS6
    ...                 tcp default for signaling VONR=5QI-1/QOS5
    ...                 codec amr_wb_18_25 for data VONR=5QI-5/QOS1
    ...            6) wait 10 minute to have the counters and check it :
    ...                 Check Legacy Counters DL for QOS1, 5 and 6
    ...                     QOS1 must be egal to 721+/-1 for the codec amr_wb_18_25 in 5 minute
    ...                     QOS5 must be egal to 618+/-1 for the tcp without data rate in 5 minute
    ...                     QOS6 must be in range 11235000 and 11348000 in 5min : 301.15 Mbs +/- 0.5%
    ...                 Check Primary+Secondary Path Counters for QOS1, 5 and 6
    ...                     QOS1 for primary path must be null : GBR bearer are not CA eligible
    ...                     QOS1 for Secondary path must be null : GBR bearer are not CA eligible
    ...                 for NO-GBR bearer due to bufferBased activation the DL data are sent to the 3 paths P-CELL and S-CELLs
    ...                     QOS5 for Primary + Secondary path must be eagal to Legacy QOS5
    ...                     QOS6 for Primary + Secondary path must be eagal to Legacy QOS6
    ...            7) stop all trafic and detach UE
    ...            8) Teardown
    ...
    ...       Manual Run : load the PM filter counter file testsuite/Paris/RRM/ET/5GC002640/resources/config/PM_Counters_filters_for_AB_TC08.xml
    ...                    in WEBUI to see the counters values
    [Arguments]         ${param}

    Init Sequence       ${param}
    TestSuiteFolderCreation    step=Config_TestStart_
    Collect_Configfiles        step=Config_TestStart_

    Critical Step                   carrierAggregationSupportList set to 600
    Step                            weightForSCellSelection          argument=${param.NrRelweightForSCellSelection_List}
    Step                            Set_iniNumSCellsToActivate       argument=${param.iniNumSCellsToActivate}
    Step                            Set_sCellDeactivationTimerGNB    argument=${param.sCellDeactivationTimerGNB}
    Step                            Set_sCellActivationMethod        argument=${param.sCellActivationMethod}

    Restart TL

    TestSuiteFolderCreation    step=configReady_
    Collect_Configfiles        step=configReady_

    # Critical Step                   WTS_Cell_Setup
    Critical Step                   WTS Setup for DSS Plus nonDSS cells    shouldUseLua=${False}    postprocessing=Check_Cell_SetupIs_Ok_on_AirPhone
    Run Keyword If                  ${enable_sherpa}                 Activate Sherpa
    Step                            UE_register_Local                argument=${param.UEList}
    Step                            PDU_Session                      argument=${param.UEList}    depends=UE_register_Local
    Step                            Add_VONR_PDU                     argument=${param.UEList}    depends=UE_register_Local
    Step                            Traffic_VONR                     argument=${param.UEList}    depends=PDU_Session
    Critical Step                   Check_sCellToAddModList_onegateLogs                          depends=Traffic
    Step                            Check_sCellIndex_onegateLogs    argument=${param.NrRel_TargetedbyWeight_List}    depends=Traffic
    Step                            Check_DL_Trafic_VONR
    Step                            Traffics VONR Stop              argument=${param.UEList}
    GenericTest.Display diagnosis

TC 8533-AB401
    [Documentation]
    ...                 This TC start on  IBCA/5GC002640/scfc-AB.xml and set on the fly several parameters :
    ...                 carrierAggregationSupportList / weightForSCellSelection / iniNumSCellsToActivate
    ...                 sCellActivationMethod         / Set_sCellActivationMethod
    ...                 restart the test line
    ...                 call setup with FDD – TDD FR1 DL CA 4CC (F+F+T+T) for the single UE with dynamic flow control,
    ...                 data split over PCell and 3 SCells, with blind SCells addition
    ...                 and buffer based SCells activation without beamforming on TDD FR1 SCells
    ...                 SA call setup is done on 3 step
    ...                 step1 few DL traffic so no Scell activation
    ...                 step2 increase of DL TP but not very important => only 2 Scell will be activated at the same time
    ...                 step3 heavy DL traffic is set so a third Scell will be activated in complement
    ...
    ...                 - PMCounters are correctly updated :
    ...                      M55316C03003 PSCELL_UE_3_ACT_SCELL_DL
    ...                      M55316C03003 MAX_PSCELL_UE_3_ACT_SCELL_DL
    ...                 - RDcounters are with correct value :
    ...                      SUCC_ACSI_PUSCH           # M55303CRD63000
    ...                      SUCC_PCSI_PUCCH_FORMAT3   # M55303CRD60001

    [Arguments]         ${param}

    Init Sequence       ${param}
    DdatedLog  params---> :${param}
    TestSuiteFolderCreation    step=Config_TestStart_
    Collect_Configfiles        step=Config_TestStart_

    #economy as redo on 5GC002640-5G-F_Settings               Critical Step                   RestartTLab
# - NRBTS/NRDU.actInterNumerologyCa = True
# - NRBTS/NRDU.flexibleCAMode = 2 (ConfigurationIndependent)
# - NRBTS/NRDU.actConnectedModeMobilityCA = True

    Critical Step                   carrierAggregationSupportList set to 600
    Step                            maxNumScellsDlFr1                                    argument=${param.maxNumScellsDl}
    Step                            weightForSCellSelection                              argument=${param.NrRelweightForSCellSelection_List}
    Step                            actAperCsi                                           argument=${param.NrRelactAperCsi_List}
    Step                            Set_iniNumSCellsToActivate                           argument=${param.iniNumSCellsToActivate}
    Step                            Set_sCellActivationMethod                            argument=${param.sCellActivationMethod}
    Step                            Set_sCellDeactivationTimerGNB                        argument=${param.sCellDeactivationTimerGNB}
    Step                            PM_StatisticsInterval                                argument=${param.PM_TimerGNB}
    Critical Step                   5GC002640-5G-F_Settings

    TestSuiteFolderCreation    step=configReady_
    Collect_Configfiles         step=configReady_

    Critical Step                   WTS_Cell_Setup

    Run Keyword If                   ${enable_sherpa}                 Activate Sherpa

    Critical Step                   UE_register_Local                ${param.UEList}
    Critical Step                   PDU_Session                      ${param.UEList}
    Critical Step                   Check 5gnb still Cell on Air
    Critical Step                   Check_sCellIndex_onegateLogs     ${param.NrRel_TargetedbyWeight_List}

    ${Trafic_step}    set variable    step1
    datedLog  ---> Trafic_step :${Trafic_step}
    Critical Step                   Traffic                          ${param.UEList}    ${Trafic_step}
    Critical Step                   Check_sCellToAddModList_onegateLogs
    #on this step we put 0 for occurency param to not mismatch with TC 2640-AB_04 SA
    ${passed}=                      Run Keyword And Return Status    Check_activated_successfully_at_airphone_onegateLogs_V2    occurency=0
    #Runs the given keyword with the given arguments if condition is false.
    #on step1 passed need to be false so continue
    Run Keyword If                  '${passed}' == '${true}'     FAIL    Check_activated_successfully_at_airphone_onegateLogs_V2
    ...                                                  has failed Scell shouldn't be active ate this step
    sleep    20s

    ${Trafic_step}    set variable    step2
    datedLog  ---> Trafic_step :${Trafic_step}
    Critical Step                   Traffic                          ${param.UEList}    ${Trafic_step}
    Step                            Check_sCellIndex_onegateLogs    argument=${param.NrRel_TargetedbyWeight_List_step2}
    sleep    30s
    Critical Step                   Check_sCellToAddModList_onegateLogs
    Critical Step                   Check_activated_successfully_at_airphone_onegateLogs_V2    occurency=2    samemilisecond=samemilisecond
    ...                             deviation=${param.deviation}    # ajout deviation

    ${Trafic_step}    set variable    step3
    datedLog  ---> Trafic_step :${Trafic_step}
    Critical Step                   Traffic                          ${param.UEList}    ${Trafic_step}
    Step                            Check_sCellIndex_onegateLogs    argument=${param.NrRel_TargetedbyWeight_List_step2}
    Critical Step                   Check_sCellToAddModList_onegateLogs
    wait until keyword succeeds     10min    60s    Check_activated_successfully_at_airphone_onegateLogs_V2
    ...                             occurency=3    samemilisecond=NOTsamemilisecond    deviation=${param.deviation}    # ajout deviation


    Run Keyword If                  ${enable_sherpa}     Run Keywords
    ...                             Dated log            SHERPA STOP AND COLLECTION ongoing
    ...                             AND
    ...                                                  Deactivate Sherpa and Stop Collect

    # - Coutners are correctly updated : PSCELL_UE_3_ACT_SCELL_DL & MAX_PSCELL_UE_3_ACT_SCELL_DL
    Dated Log   Pause to get the next PM period
    # Dated Log   ( to be set to 20mn if impossibility to change anymore first&Second LevelSchedulerStatisticsInterval )
    sleep   900
    Dated Log   Pause ended

    Dated Log   Check PM Counters for 3Scell
    Critical Step                   IBCA Collect PM Counters File
    5GC008533_PMCounterCheck_In_A_Range        ${PM_Counter_PSCell UEs with 3 activated SCells in DL}    270    330    # increase tolerance
    5GC008533_PMCounterCheck_Expected_Value    ${Maximum amount of PSCell UEs with 3 activated SCells in DL}    1

    Dated Log   Check RD Counters for Primry Scell
    Critical Step                   IBCA Collect RD Counters File
    GenericTest.Display diagnosis

TC 8533-AB5
    [Documentation]     This TC set on the fly several marameters
    ...                 carrierAggregationSupportList / weightForSCellSelection / iniNumSCellsToActivate
    ...                 sCellActivationMethod         / Set_sCellActivationMethod
    ...                 restart the test line
    ...                 Step1 : Set gNB and AP configurations
    ...                 Step 2 : Perform gNB commissioning

    [Arguments]         ${param}

    Init Sequence       ${param}
    DdatedLog  params---> :${param}
    TestSuiteFolderCreation     step=TestStart
    Collect_Configfiles         step=TestStart
    #economy as redo on 5GC002640-5G-F_Settings               Critical Step                   RestartTLab
# - NRBTS/NRDU.actInterNumerologyCa = True
# - NRBTS/NRDU.flexibleCAMode = 2 (ConfigurationIndependent)
# - NRBTS/NRDU.actConnectedModeMobilityCA = True
    Critical Step                   carrierAggregationSupportList set to 600
    # Step                            maxNumScellsDl                   argument=${param.maxNumScellsDl}
    Step                            maxNumScellsDlFr1                argument=${param.maxNumScellsDlFr1}
    Step                            weightForSCellSelection          argument=${param.NrRelweightForSCellSelection_List}
    Step                            Set_iniNumSCellsToActivate       argument=${param.iniNumSCellsToActivate}

    Step                            Set_sCellActivationMethod        argument=${param.sCellActivationMethod}
    Step                            Set_sCellDeactivationTimerGNB    argument=${param.sCellDeactivationTimerGNB}

    Critical Step                   5GC002640-5G-8533AB5_Settings
    TestSuiteFolderCreation     step=configReady
    Collect_Configfiles         step=configReady

    # Critical Step                   WTS_Cell_Setup
    Critical Step                   5GC002640-5G-F_Cell_Setup
    #Prendre un SCF DSS + PRB Clanking (type custom_config_2640-F_TC3 )!!
    # Critical Step                   DSS_CRM_Cell_Setup_Phase3_8533
    #Critical Step                   5GC002640-5G-F_UE_DSS_CA_ScellActivation_ueRegister_traffic

    Run Keyword If                   ${enable_sherpa}                 Activate Sherpa

    Critical Step                   UE_register_Local                ${param.UEList}
    Critical Step                   PDU_Session                      ${param.UEList}

    Critical Step                   Check 5gnb still Cell on Air
    Critical Step                   Check_sCellToAddModList_onegateLogs
    Critical Step                   Check_sCellIndex_onegateLogs     ${param.NrRel_TargetedbyWeight_List}

    Critical Step                   Traffic                          ${param.UEList}

    sleep     ${param.TrafficDuration}
    Critical Step                   Traffics Check                   ${param.UEList}

    # Check_activated_successfully_at_airphone_onegateLogs_V2 need improvment to be able to check this
    # Critical Step                   Check_activated_successfully_at_airphone_onegateLogs_V2    occurency=3    samemilisecond=samemilisecond

    Run Keyword If                  ${enable_sherpa}     Run Keywords
    ...                             Dated log            SHERPA STOP AND COLLECTION ongoing
    ...                             AND
    ...                                                  Deactivate Sherpa and Stop Collect
    GenericTest.Display diagnosis

#****************************** Keywords not for configuration topic ***************************************

#****************************** Keywords for RD counters ***************************************
IBCA Collect RD Counters File
    [Documentation]                 KW to get counters and store in specific directory with day date
    ${date}                          Get Current Date
    ${date_in_dir_name}              Convert Date         ${date}     result_format=%d%m%Y_%H%M
    ${log_path_rd}                   Set Variable         ${LOG_PATH}/RD_${date_in_dir_name}
    BuiltIn.Log              The RD counters file collected from gnb will be stored under : ${log_path_rd}
    #Collect and Verify RD Counters    counter_value=1    cell_id=3
    ${rd_files}=   Collect RD Counters
    RD Counter Verification    counter_files=${rd_files}    counter_names=${RD_COUNTERS_name}
    ...                        counter_v=${RD_COUNTERS_value}    cell_id=3


Collect RD Counters
    ${alias_gnb}                    SSH Wait For Connect                 ${GNB_DU.entryCard[0]}
    ${RD_counter_dir}=   Extract gz file    file_pattern=/tmp/RD.BTS-1*.gz    connection=${alias_gnb}
    [Return]    ${RD_counter_dir}


Extract gz file
    [Documentation]    :Author: Jing Liang
    ...
    [Arguments]    ${file_pattern}    ${connection}
    ${target_dir}=    testline.Get Testcase Log Directory
    ${target_dir_rd_counters}=    Set variable    ${target_dir}/gnb_rd_counters
    Set Suite Variable    ${target_dir_rd_counters}
    Create directory    ${target_dir_rd_counters}
    ${file_path}=    Get File Path on Target    file_pattern=${file_pattern}    connection=${connection}
    ${KINFE_PACKAGE.folder}    ${KINFE_PACKAGE.filename}=    Split String From Right    ${file_path}    separator=/    max_split=1
    Set Test Variable    ${source_file}    /tmp/${KINFE_PACKAGE.filename}
    ssh.execute    gunzip -c ${source_file} > /tmp/RD.BTS_counters.xml    connection=${connection}
    ssh.Download File   /tmp/RD.BTS_counters.xml   ${target_dir_rd_counters}/RD.BTS_counters.xml    connection=${connection}
    [Return]    ${target_dir_rd_counters}


Get File Path on Target
    [Documentation]    :Author: Jing Liang
    ...    copied from /ebs/ftourlon/FRT/robotws/testsuite/Ulm/resources/Common/util.robot
    ...
    ...    :param file_pattern:  file location and pattern, e.g. /ffs/run/swpool/OAM/psconfig_*.txz
    ...    :param connection:  alias name
    ...
    ...    :returns file_path:
    [Arguments]    ${file_pattern}    ${connection}
    ${output}=    ssh.execute    ls ${file_pattern}    connection=${connection}
    ${file_path}=    Strip String    ${output}
    [Return]    ${file_path}


RD Counter Verification
    [Arguments]   ${counter_files}  ${counter_names}  ${counter_v}=1  ${cell_id}=1
    ${idx}    Set Variable    0
    FOR  ${counter}  IN  @{counter_names}
       ${counter_value}    Set Variable    ${counter_v[${idx}]}
       ${idx}=             Evaluate        ${idx} + ${1}
       Dated Log  >>> check ${counter} <<<
	   Check RD counter value equal   ${counter_value}   ${counter_files}   ${counter}   NRBTS-1/NRCELL-${cell_id}
    END

Check RD counter value equal
    [Documentation]   adapted from Check PM counter value equal:Author: Giangiacomo Guglielmini
    ...        checks that the value of a counter in the last reporting period is equal to a given value
    ...
    ...        :param expected_value is the value compared to counter value
    ...        :param pm_files_location is the path to PM files
    ...        :param pi_id is the PM counter ID e.g. M55112C03001
    ...        :param moc is the class including the counter e.g. NRCELL-1
    ...               it is NOT necessary to give the full moc e.g. MRBTS-1113/NRBTS-1113/NRCELL-1
    [Arguments]    ${expected_value}   ${pm_files_location}   ${pi_id}    ${moc}
    ${pi_value}=   Get RD counter value   ${pm_files_location}   ${pi_id}    ${moc}
    ${pi_value}=   convert to integer    ${pi_value}
    ${expected_value}=   convert to integer    ${expected_value}
    #FTS should be equal  ${pi_value}   ${expected_value}     PM Counter ${pi_id} expected to be == ${expected_value} but is ${pi_value}
    Dated Log  Dod: Is ${pi_value} > ${expected_value}
    Run Keyword if   '${pi_value}'>'${expected_value}'    Dated Log  RD counter is ok upper than ${expected_value}
    ...    ELSE                                           Dated Log  RD counter is NOT ok as no upper than ${expected_value} ( obtained ${pi_value} )

Get RD counter value
    [Documentation]   adapted from Get PM counter value:Author: Giangiacomo Guglielmini
    ...        get the value of a counter in the last reporting period
    ...
    ...        :param pm_files_location is the path to PM files
    ...        :param pi_id is the PM counter ID e.g. M55112C03001
    ...        :param moc is the class including the counter e.g. NRCELL-1
    ...               it is NOT necessary to give the full moc e.g. MRBTS-1113/NRBTS-1113/NRCELL-1
    [Arguments]    ${pm_files_location}   ${pi_id}    ${moc}
    ${pi_list}=  Create List
    ...  ${pi_id}
    ${PM_report_dict_list}=  check_pm.get_pi_value
    ...  pi_list=${pi_list}
    ...  pi_dir=${pm_files_location}
    ...  pi_file_pattern=RD.BTS*
    ${last_report}    Get From List   ${PM_report_dict_list}     -1
    ${pi_dict}   Get Dictionary Values   ${last_report}
    ${first_pi}    Get From List   ${pi_dict}     0
    ${cell_dict_list}   Get Dictionary Values   ${first_pi}
    ${cell_dict}   Get From List   ${cell_dict_list}     0
    ${moc_list}   get dictionary keys   ${cell_dict}
    ${full_moc}    Set Variable     empty
    FOR  ${key}  IN   @{moc_list}
       ${key_is_moc}  Run Keyword And Return Status    Should Contain  ${key}   ${moc}
       ${full_moc}  Set Variable If   ${key_is_moc}   ${key}    ${full_moc}
    END
    ${pi_value}     Get From Dictionary      ${cell_dict}    ${full_moc}
    BuiltIn.Log    ${pi_id} value: ${pi_value}   console=${P_console}
    [Return]    ${pi_value}



