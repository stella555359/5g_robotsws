    Run Keyword If Test Failed    Run Keywords
    ...    Get GNB Snapshot
    ...    AND Collect Sos Report

    # kill edaemon and egate to avoid having "cell setup" state after rebooting the TL
    ${output}    SSH Wait For Connect and Cmd    sudo pkill edaemon; sudo pkill egate    ${HOST_EPCSIM}



#****************************** Keywords for config files setup ***************************************

Set MRBTSID and NRBTSID 2558-C
    ${nrbts_dist_name}              Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ${nrcell_dist_name}             Set Variable    ${nrbts_dist_name}/NRCELL-${FDD_Cell_list[0].nrCellId}
    ${nrcell_fdd_ch_dist_name}      Set Variable    ${nrcell_dist_name}/NRCELL_FDD-1
    ${nrcellgrp_dist_name}          Set Variable    ${nrbts_dist_name}/NRCELLGRP-1
    ${bwp4_dist_name}    Run Keyword If    not ${isAic}    Set Variable    ${nrbts_dist_name}/BWP_PROFILE-4/
    ...                              ELSE                  Set Variable    ${nrbts_dist_name}/BWP_PROFILE-10/
    Set Suite Variable              ${nrbts_dist_name}
    Set Suite Variable              ${nrcell_dist_name}
    Set Suite Variable              ${nrcell_fdd_ch_dist_name}
    Set Suite Variable              ${nrcellgrp_dist_name}
    Set Suite Variable              ${bwp4_dist_name}


Setup Config Files
    [Documentation]   Update config files (gNB SCF, AP iphy.xml, gNB swconfig.txt and WTS basic_setup.cfg) with needed information

    [Arguments]    ${test_name}
    ...            ${test_param}
    ...            ${mod_K2Min_K1Min}=${False}

    Set MRBTSID and NRBTSID 2558-C

    # copy the initial SCF_Setup.xml (previously backup by Suite Setup From Scratch)
    Set Suite Variable    ${test_scf_file_path}    ${LOG_PATH}/SCF_Test.xml
    ${output}    run    cp ${SCF_SETUP_PATH} ${test_scf_file_path}

    # XML config file where to take data to be inserted in SCF
    # (file name = <test name without '[1][1.0] ' prefix>.xml, "+" is not accepted as filename in CI --> replace it by "_")
    #${test_cfg_file_name}    run    echo ${test_name}.xml | sed s/^\\\\[1\\\\]// | sed s/+/_/g
    ${test_cfg_file_name}     run    echo ${test_name}.xml
    ${test_cfg_file_name}     Remove String Using Regexp    ${test_cfg_file_name}    \\[1\\]\\[\\d[.]\\d\\]
    ${test_cfg_file_name}     Remove String     ${test_cfg_file_name}    ${SPACE}
    ${test_cfg_file_name}     Replace String    ${test_cfg_file_name}    +    _
    ${test_cfg_file_path}     Set Variable    ${CURDIR}/../config/${test_cfg_file_name}

    # Add objects needed for the test to the copied SCF
    Get Data From Config Xml File And Add to Scf    ${test_cfg_file_path}    ${test_scf_file_path}

    Update WTS Cfg File    ${test_param.nrarfcnUl}
    ...                    ${test_param.nrarfcnDl}
    ...                    ${test_param.ue_nr_capa}

    Update Iphy Xml Cfg File    ${test_param.gscn}

    Run Keyword If    ${mod_K2Min_K1Min}    Update K2min K1min

    Set Specific Parameters In SCF    scf_file=${test_scf_file_path}
    ...                               test_param=${test_param}
    ...                               nrbts_dname=${nrbts_dist_name}
    ...                               nrcellgrp_dname=${nrcellgrp_dist_name}
    ...                               nrcell_dname=${nrcell_dist_name}
    ...                               nrcell_fdd_dname=${nrcell_fdd_ch_dist_name}


Set Specific Parameters In SCF
    [Arguments]    ${scf_file}
    ...            ${test_param}
    ...            ${nrbts_dname}
    ...            ${nrcellgrp_dname}
    ...            ${nrcell_dname}
    ...            ${nrcell_fdd_dname}

    SCF StartSession    scf_file=${scf_file}

    # Update BWP list to use the objects define in the configuration XML files
    ${list_name}               Set Variable    cellBwpList

    SCF Remove List            dist_name=${nrcell_dname}
    ...                        list_name=${list_name}

    SCF Add List               dist_name=${nrcell_dname}
    ...                        list_name=${list_name}

    ${item_dict}               Create Dictionary
    Set To Dictionary          ${item_dict}    actPdcchCceFragmentControl=${test_param.firstActPdcchCceFragmentControl}
    Set To Dictionary          ${item_dict}    actUpperThrAckNackFiltering=${test_param.firstActUpperThrAckNackFiltering}
    Set To Dictionary          ${item_dict}    actUpperThrAckNackHrFiltering=${test_param.firstActUpperThrAckNackHrFiltering}
    Set To Dictionary          ${item_dict}    bwpDN=${test_param.firstBwpDN}
    Set To Dictionary          ${item_dict}    cellBwpId=${test_param.firstCellBwpId}
    Set To Dictionary          ${item_dict}    pdcchResourcePreference=${test_param.firstPdcchResourcePreference}
    SCF Add Items To List      dist_name=${nrcell_dname}
    ...                        list_name=${list_name}
    ...                        elements=${item_dict}

    ${item_dict}               Create Dictionary
    Set To Dictionary          ${item_dict}    actPdcchCceFragmentControl=${test_param.secondActPdcchCceFragmentControl}
    Set To Dictionary          ${item_dict}    actUpperThrAckNackFiltering=${test_param.secondActUpperThrAckNackFiltering}
    Set To Dictionary          ${item_dict}    actUpperThrAckNackHrFiltering=${test_param.secondActUpperThrAckNackHrFiltering}
    Set To Dictionary          ${item_dict}    bwpDN=${test_param.secondBwpDN}
    Set To Dictionary          ${item_dict}    cellBwpId=${test_param.secondCellBwpId}
    Set To Dictionary          ${item_dict}    pdcchResourcePreference=${test_param.secondPdcchResourcePreference}
    SCF Add Items To List      dist_name=${nrcell_dname}
    ...                        list_name=${list_name}
    ...                        elements=${item_dict}

    # nrbts update

    SCF Set element    dist_name=${nrbts_dname}
    ...                element_name=actLteNrDss
    ...                element_value=${test_param.actLteNrDss}

    SCF Set element    dist_name=${nrbts_dname}
    ...                element_name=actGeneralConnectivitySilver
    ...                element_value=${test_param.actGeneralConnectivitySilver}

    SCF Set element    dist_name=${nrbts_dname}
    ...                element_name=actGeneralConnectivityGold
    ...                element_value=${test_param.actGeneralConnectivityGold}

    # nrcell group update

    SCF Set element    dist_name=${nrcellgrp_dname}
    ...                element_name=scs
    ...                element_value=${test_param.scs}

    # nrcell update

    SCF Set element    dist_name=${nrcell_fdd_dname}
    ...                element_name=nrarfcnDl
    ...                element_value=${test_param.nrarfcnDl}

    SCF Set element    dist_name=${nrcell_fdd_dname}
    ...                element_name=chBwUl
    ...                element_value=${test_param.chBwUl}

    SCF Set element    dist_name=${nrcell_fdd_dname}
    ...                element_name=nrarfcnUl
    ...                element_value=${test_param.nrarfcnUl}

    SCF Set element    dist_name=${nrcell_fdd_dname}
    ...                element_name=chBwDl
    ...                element_value=${test_param.chBwDl}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=${gscnParameterName}
    ...                element_value=${test_param.gscn}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=ssbScs
    ...                element_value=${test_param.ssbScs}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=type0CoresetConfigurationIndex
    ...                element_value=${test_param.type0CoresetConfigurationIndex}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=lteNrDssMode
    ...                element_value=${test_param.lteNrDssMode}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=aggregationLevel
    ...                element_value=${test_param.aggregationLevel}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=actPRBBlanking
    ...                element_value=${test_param.actPRBBlanking}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=nbrOfBlankedPRBsHighEdgeDL
    ...                element_value=${test_param.nbrOfBlankedPRBsHighEdgeDL}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=nbrOfBlankedPRBsHighEdgeUL
    ...                element_value=${test_param.nbrOfBlankedPRBsHighEdgeUL}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=nbrOfBlankedPRBsLowEdgeDL
    ...                element_value=${test_param.nbrOfBlankedPRBsLowEdgeDL}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=nbrOfBlankedPRBsLowEdgeUL
    ...                element_value=${test_param.nbrOfBlankedPRBsLowEdgeUL}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=msg1FrequencyStart
    ...                element_value=${test_param.msg1FrequencyStart}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=dmrsTypeAPosition
    ...                element_value=${test_param.dmrsTypeAPosition}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=trsMutingInBlankedPRBsEnabled
    ...                element_value=${test_param.trsMutingInBlankedPRBsEnabled}

    # ADT - temporary set "shortPucch" instead of default "longPucch"

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=pucchModeSelect
    ...                element_value=longPucch

    SCF StopSession    scf_file=${scf_file}

Update gNB swconfig
    [Documentation]                 Generic service to set a list of parameters into swconfig file
    ...                             param_list should be a list od dictionaries, each containing a "field" and a "value"
    [Arguments]                     ${param_list}                           ${host}=192.168.255.1
    ${local_file}                   set variable                            ${LOG_PATH}/swconfig.txt
    ${remote_file}                  set variable                            /ffs/run/swconfig.txt

    ${alias}                        SSH Wait For Connect                    ${GNB_DU.sys[0].M}
    csn.download_file               remote_path=${remote_file}
    ...                             local_path=${local_file}
    ...                             connection=${alias}
    # Adding newline at the end of the file to avoid appending data on the same line
    # (this happens if the last line does not have newline char at the end)
    run                             echo "" >> ${local_file}
    setFieldsInFile                 srcFile=${local_file}                   paramList=${param_list}
    csn.upload_file                 local_path=${local_file}
    ...                             remote_path=${remote_file}
    ...                             connection=${alias}
    SSH Exec                        command=crasign ${remote_file}          alias=${alias}

Update K2min K1min
    ${rdParamK2Min}=         create dictionary    field=0x58012d    value=2
    ${rdParamK1Min}=         create dictionary    field=0x5800f4    value=2
    ${swconfig_list}=        Create List    ${rdParamK2Min}    ${rdParamK1Min}
    Collect gNB swconfig
    Update gNB swconfig      param_list=${swconfig_list}
    Collect gNB swconfig     ${True}

Collect gNB swconfig
    [Documentation]    This keyword is used to collect gNB swconfig.txt from the /ffs/run/ folder
    ...                This is collected in the Test Log Folder
    [Arguments]                  ${is_mod}=${False}
    ${FilePrefix}                set Variable                            gnb_swconfig_
    ${OriFileSuffix}             set Variable                            ori.txt
    ${ModFileSuffix}             set Variable                            mod.txt
    ${FileName}=                 set Variable If    ${is_mod}
    ...                          ${FilePrefix}${ModFileSuffix}
    ...                          ${FilePrefix}${OriFileSuffix}
    ${alias_gnb}                 SSH Wait For Connect                ${GNB_DU.sys[0].M}
    Dated Log      Collecting gNB /ffs/run/swconfig.txt...
    csn.download_file               remote_path=/ffs/run/swconfig.txt
    ...                             local_path=${LOG_PATH}/${FileName}
    ...                             connection=${alias_gnb}
    Dated Log                  ${FileName} file stored to ${LOG_PATH}