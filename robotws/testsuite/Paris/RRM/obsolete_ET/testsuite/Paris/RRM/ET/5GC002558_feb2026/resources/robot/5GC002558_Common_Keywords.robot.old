#****************************** NSA and SA: Keywords for check in L2L1 ***************************************

Check In L2L1 SRS Configuration Traffic UL
    Dated Log    [Checking SRS configuration traffic UL]
    ${pcap_filtered}    Filter Pcap     pcap_file=${capture_gnb_l1l2.path}
    ...    messages=uldata_srsreceivereq or uldata_srsreceiverespps    name=srs_only
    ${pdml_srs}       Generate Pdml From Pcap    pcap_file=${pcap_filtered}
    Check In L2L1 SRS Allocation Traffic UL NSA SA  ${pdml_srs}

# Keyword updated to fit MCShark pdml
Check In L2L1 SRS Allocation Traffic UL NSA SA
    [Documentation]    This tests check the PRB allocation of SRS send request.
    [Arguments]    ${pdml_file}
    Dated Log    [Checking In L2L1 SRS allocation during traffic UL]
    Dated Log    -----> Starting check SRS allocation
    Dated Log    -----> SRS allocation shall be outside blanked PRB: startPrB >= ${rat1_start} and crb_end <= ${rat1_end}
    Dated Log    -----> 5 packets to checks. Please wait...

    ${ues_item}                set Variable                           ${0}
    FOR    ${packet}    IN RANGE    1    5
         ${packetsMatchReq}           Get Packet Match List
         ...                             pdmlFile=${pdml_file}
         ...                             packetName=uldata_srsreceivereq
         ...                             pathList=${listFieldSrsRcvReq}
         ...                             startPacket=${${packet}}
         ...                             endPacket=${${packet}}
         ${packetMatchReq}            set variable                           ${packetsMatchReq[0]}

         @{listPathBw}                Get Paths matching Field
         ...                             packetMatch=${packetMatchReq}          field=srsBandwidthConfig
         ${path}                      set variable                           ${listPathBw[${ues_item}]}
         ${srs_bw}                    set variable                           ${packetMatchReq.fields['${path}'].show}
         Dated log                    \t\tItem${ues_item}:srsBandwidthConfig=${srs_bw} PATH=${path}

         @{listPathPos}               Get Paths matching Field
         ...                              packetMatch=${packetMatchReq}      field=freqDomainPosition
         ${path}                      set variable                           ${listPathPos[${ues_item}]}
         ${srs_freq_pos}              set variable                           ${packetMatchReq.fields['${path}'].show}
         Dated log                    \t\tItem${ues_item}:freqDomainPosition=${srs_freq_pos} PATH=${path}

         @{listPathShift}             Get Paths matching Field
         ...                              packetMatch=${packetMatchReq}      field=freqDomainShift
         ${path}                      set variable                           ${listPathShift[${ues_item}]}
         ${srs_freq_shift}            set variable                           ${packetMatchReq.fields['${path}'].show}
         Dated log                    \t\tItem${ues_item}:field=freqDomainShift=${srs_freq_shift} PATH=${path}

         ${srs_bw_int}            Convert To Integer       ${srs_bw}
         ${srs_freq_pos_int}      Convert To Integer       ${srs_freq_pos}
         ${srs_freq_shift_int}    Convert To Integer       ${srs_freq_shift}
         Log To Console    ${packet}/10:
         Log To Console     --> SRS configuration [freqDomainPos:${srs_freq_pos_int} ; freqDomShift:${srs_freq_shift_int} ; BWcsrs:${srs_bw_int}]
        #  Should Be True     ${srs_bw_int}==${c_srs}
         Should Be True     ${srs_freq_pos_int}==${freq_pos}
        #  Should Be True     ${srs_freq_shift_int}==${freq_shift}

         ${packetsMatchResp}          Get Packet Match List
         ...                             pdmlFile=${pdml_file}
         ...                             packetName=uldata_srsreceiverespps
         ...                             pathList=${listFieldSrsRcvResp}
         ...                             startPacket=${${packet}}
         ...                             endPacket=${${packet}}
         ${packetMatchResp}           set variable                           ${packetsMatchResp[0]}

         @{listPathRank}              Get Paths matching Field
         ...                             packetMatch=${packetMatchResp}      field=ulRank
         ${nb}                        Get length                             ${listPathRank}
         Dated log                    \t\tList Length=${nb}
         ${path}                      set variable                           ${listPathRank[${ues_item}]}
         ${srs_ul_rank}               set variable                           ${packetMatchResp.fields['${path}'].show}
         Dated log                    \t\tItem${ues_item}:srsBandwidthConfig=${srs_ul_rank} PATH=${path}

         @{listPathSinr}              Get Paths matching Field
         ...                              packetMatch=${packetMatchResp}     field=ulPmiRank1Sinr
         ${path}                      set variable                           ${listPathSinr[${ues_item}]}
         ${srs_ul_pmi_rank1_sinr}     set variable                           ${packetMatchResp.fields['${path}'].show}
         Dated log                    \t\tItem${ues_item}:ulPmiRank1Sinr=${srs_ul_pmi_rank1_sinr} PATH=${path}

         @{listPathRank2}             Get Paths matching Field
         ...                              packetMatch=${packetMatchResp}     field=ulPmiRank2
         ${path}                      set variable                           ${listPathRank2[${ues_item}]}
         ${srs_ul_pmi_rank2}          set variable                           ${packetMatchResp.fields['${path}'].show}
         Dated log                    \t\tItem${ues_item}:ulPmiRank2=${srs_ul_pmi_rank2} PATH=${path}

         @{listPathSinr2}             Get Paths matching Field
         ...                              packetMatch=${packetMatchResp}     field=ulPmiRank2Sinr_item
         ${nb}                        Get length                             ${listPathSinr2}
         Dated log                    \t\tList Length=${nb}
         ${path}                      set variable                           ${listPathSinr2[${ues_item}]}
         ${srs_ul_pmi_rank2_sinr}     set variable                           ${packetMatchResp.fields['${path}'].show}
         Dated log                    \t\tItem${ues_item}:ulPmiRank2Sinr_item_0=${srs_ul_pmi_rank2_sinr} PATH=${path}

         @{listPathSnr}               Get Paths matching Field
         ...                              packetMatch=${packetMatchResp}     field=snr
         ${path}                      set variable                           ${listPathSnr[${ues_item}]}
         ${srs_snr}                   set variable                           ${packetMatchResp.fields['${path}'].show}
         Dated log                    \t\tItem${ues_item}:field=snr=${srs_snr} PATH=${path}

         Log To Console     ----> SRS measurements received:[ulRank:${srs_ul_rank} ; ulPmiRank1Sinr:${srs_ul_pmi_rank1_sinr}\n
         Log To Console     ----> ulPmiRank2:${srs_ul_pmi_rank2} ; ulPmiRank2Sinr:${srs_ul_pmi_rank2_sinr} ; snr:${srs_snr}]
    END
    Dated Log    Check of SRS allocation completed.

Check In L2L1 Rat1 Allocation Pusch Traffic UL 2558-C
    [Documentation]    This tests check the PRB allocation of pusch messages. (~1h)
    [Arguments]    ${pusch_pdml}
    Dated Log    [Checking In L2L1 Pusch Attach Configuration]
    Dated Log    -----> Starting check Rat1 PUSCH allocation (test duration is around 1 hour)...
    Dated Log    -----> RAT1 allocation of PUSCH shall be outside blanked PRB: startPrB >= ${rat1_start} and crb_end <= ${rat1_end}
    Dated Log    -----> 10 packets to checks. Please wait... (~15min)
    FOR    ${packet}   IN RANGE   1000   1011
        Verify Allocation In L2L1    pdml_file=${pusch_pdml}
        ...                          packet_name=uldata_puschreceivereq
        ...                          xpath_start=.*/UlData_PuschReceiveReq.grants_item_.*.startPrb$
        ...                          xpath_size=.*/UlData_PuschReceiveReq.grants_item_.*.numOfPrb$
        ...                          limit_start=${rat1_start}
        ...                          test_size=<=
        ...                          limit_size=${rat1_end}
        ...                          packet_start=${packet}
        ...                          packet_end=${packet}
    END
    Dated Log    Check of RAT1 PUSCH allocation completed.\n

# SA Only Keywords

Check In L2L1 Pdsch Attach Configuration SA
    Dated Log    [Checking In L2L1 Pdsch Attach Configuration in SA]
    ${pcap_filtered}    Filter Pcap     pcap_file=${capture_gnb_l1l2.path}    messages=dldata_pdschsendreq   name=pdsch_only
    ${pdml_pdsch}    Generate Pdml From Pcap    pcap_file=${pcap_filtered}
    #Initital pdsch configuration
    Check Initial Pdsch Allocation SA    pdsch_pdml=${pdml_pdsch}

# Keyword updated to fit MCShark pdml
Check Initial Pdsch Allocation SA
    [Arguments]    ${pdsch_pdml}
    Dated Log    [Checking initial Pdsch allocation in SA]
    Dated Log    StartPrb shall greater or equal to ${param.nbrOfBlankedPRBsLowEdgeDL}
    Dated Log    crb end location shall be less than ${blanking_area_crb_high}
    ${packet_num}                set Variable                           ${1}
    ${grant_item}                set Variable                           ${0}
    ${packetsMatch}              Get Packet Match List
    ...                             pdmlFile=${pdsch_pdml}
    ...                             packetName=dldata_pdschsendreq
    ...                             pathList=${listFieldPdsch}
    ...                             startPacket=${${packet_num}}
    ...                             endPacket=${${packet_num}}
    ${packetMatch}               set variable                           ${packetsMatch[0]}

    @{listPathStart}             Get Paths matching Field
    ...                             packetMatch=${packetMatch}          field=startPrb
    ${path}                      set variable                           ${listPathStart[${grant_item}]}
    ${startPrb}                  set variable                           ${packetMatch.fields['${path}'].show}
    Dated log                    \t\tItem${grant_item}:startPrb=${startPrb} PATH=${path}

    @{listPathNum}               Get Paths matching Field
    ...                              packetMatch=${packetMatch}         field=numOfPrb
    ${path}                      set variable                           ${listPathNum[${grant_item}]}
    ${numOfPrb}                  set variable                           ${packetMatch.fields['${path}'].show}
    Dated log                    \t\tItem${grant_item}:numOfPrb=${numOfPrb} PATH=${path}

    Verify Allocation In L2L1    start_rb_hex=${startPrb}
    ...                          nr_of_prb_hex=${numOfPrb}
    ...                          limit_start=${param.nbrOfBlankedPRBsLowEdgeDL}
    ...                          limit_size=${blanking_area_crb_high}

Check In Pdcch CoresetFreqDomain SA
    [Documentation]     The bitmap of CoresetFreqDomain shall be configured outside the blanked area.
    [Arguments]    ${pdcch_pdml}     ${coreset_0_value}=0x0000000000000000
    Dated Log    -----> SA: Checking initial CoresetFreqDomain configuration in pdcch...
    #Coreset0 (Initial BWP)
    ${coreset_0_value_int}          Convert To Integer     ${coreset_0_value}
    ${coreset_0_value_str}          Convert To String      ${coreset_0_value_int}
    analyzer.check_list             pdmlFile=${pdcch_pdml}
    ...                             packetName=dldata_pdcchsendreq
    ...                             kind=show
    ...                             path=coresetFreqDomain$
    ...                             value=${coreset_0_value_str}
    ...                             startPacket=${1}
    ...                             endPacket=${1}
    Dated Log    -----> Check completed.\n

# Keyword updated to fit MCShark pdml
Check In L2L1 CSI RS Tracking Allocation
    [Arguments]                     ${pdml_file}
    FOR    ${packet_num}            IN RANGE    1     6
        Dated Log New Line          Checking packet ${packet_num}/5
        ${packetsMatch}             Get Packet Match List
        ...                             pdmlFile=${pdml_file}
        ...                             packetName=dldata_csirssendreq
        ...                             pathList=${listFieldCsi}
        ...                             startPacket=${${packet_num}}
        ...                             endPacket=${${packet_num}}
        Verification TRS Symbol In L2L1
        ...                         packetMatch=${packetsMatch[0]}
    END
    Dated Log    Check of TRS allocation completed.\n

# Keyword updated to fit MCShark pdml
Verification TRS Symbol In L2L1
    [Arguments]                     ${packetMatch}
    @{listPath}                     Get Paths matching Field
    ...                                 packetMatch=${packetMatch}
    ...                                 field=startSymbol
    ${nb}                           Get length                              ${listPath}
    ${item}                         set Variable                            ${0}
    Dated Log                       -----> Nb CSI = ${nb}.
    Run Keyword If                  ${nb}==1
    ...                             Run keywords
    ...                                 Dated Log     -----> Skipping packet (length = 1).
    ...      AND                        Return from keyword
    FOR    ${path}         IN      @{listPath}
        ${value}                    set variable                            ${packetMatch.fields['${path}'].show}
        Dated log                   \tSYMBOL=${value} PATH=${path}
        Run Keyword If              '${value}' == '6' or '${value}' == '10'
        ...                         Verification TRS Allocation In L2L1
        ...                             packetMatch=${packetMatch}
        ...                             csi_item=${item}
        ...    ELSE                 Dated Log                               \t\tItem${item}:Skipping (symbol = 13).
        ${item}                     evaluate                                ${item} + 1
    END

# Keyword updated to fit MCShark pdml
Verification TRS Allocation In L2L1
    [Arguments]                     ${packetMatch}                          ${csi_item}
    Dated log                       \t\tItem${csi_item}:Verification TRS Allocation In L2L1

    @{listPathStart}                Get Paths matching Field
    ...                                 packetMatch=${packetMatch}          field=startPrb
    ${path}                         set variable                            ${listPathStart[${csi_item}]}
    ${startPrb}                     set variable                            ${packetMatch.fields['${path}'].show}
    Dated log                       \t\tItem${csi_item}:startPrb=${startPrb} PATH=${path}

    @{listPathNum}                  Get Paths matching Field
    ...                                 packetMatch=${packetMatch}          field=numOfPrb
    ${path}                         set variable                            ${listPathNum[${csi_item}]}
    ${numOfPrb}                     set variable                            ${packetMatch.fields['${path}'].show}
    Dated log                       \t\tItem${csi_item}:numOfPrb=${numOfPrb} PATH=${path}

    ${trs_size}    Set Variable If
    ...            '${param.trsMutingInBlankedPRBsEnabled}' == 'true' and ${param.nbrOfBlankedPRBsHighEdgeDL} == 0    ${csi_rs_size}
    ...            '${param.trsMutingInBlankedPRBsEnabled}' == 'true' and ${param.nbrOfBlankedPRBsHighEdgeDL} > 0     ${blanking_area_crb_high}
    ...            '${param.trsMutingInBlankedPRBsEnabled}' == 'false'    ${csi_rs_size}

    Run Keyword If  '${param.trsMutingInBlankedPRBsEnabled}' == 'true'
    ...                       Verify Allocation In L2L1
    ...                       start_rb_hex=${startPrb}
    ...                       nr_of_prb_hex=${numOfPrb}
    ...                       limit_start=${param.nbrOfBlankedPRBsLowEdgeDL}
    ...                       limit_size=${trs_size}
    ...   ELSE                Verify Allocation In L2L1
    ...                       start_rb_hex=${startPrb}
    ...                       nr_of_prb_hex=${numOfPrb}
    ...                       limit_start=${0}
    ...                       test_size=<=
    ...                       limit_size=${trs_size}

#****************************** Keywords for check in L3L2 ***************************************

Check In L3L2 SRS User Setup
    [Documentation]   Check in L3L2 setup that SRS is correclty configured outside the blanked area.
    [Arguments]    ${pdml_file}    ${value_pos}    ${value_shift}     ${value_csrs}    ${value_bsrs}    ${value_bhop}
    Dated Log    [Checking SRS configuration in l2ps_user_UserSetup_req]
    #From SPEC: freqDomainShift =  offsetPrbUl %4  = 2, offsetPrbUl = msg1FrequencyStart
    Dated Log    -----> Check of SRS freqDomainPosition
    ${frequ_pos_hex}      get_unique             pdmlFile=${pdml_file}
    ...                             packetName=itf_l2_ps_user_usersetupreq
    ...                             path=.*/itf_l2_ps_user_UserSetupReq.srsResource_item_.*.freqDomainPosition$
    ...                             kind=show
    ...                             startPacket=${1}
    ...                             endPacket=${1}
    ${frequ_pos_int}     Convert To Integer     ${frequ_pos_hex}
    Dated Log    -----> freqDomainPosition = ${frequ_pos_int}
    Should Be True     ${frequ_pos_int}==${value_pos}

    Dated Log    -----> Check of SRS freqDomainShift
    ${frequ_shift_hex}     get_unique             pdmlFile=${pdml_file}
    ...                             packetName=itf_l2_ps_user_usersetupreq
    ...                             path=.*/itf_l2_ps_user_UserSetupReq.srsResource_item_.*.freqDomainShift$
    ...                             kind=show
    ...                             startPacket=${1}
    ...                             endPacket=${1}
    ${frequ_shift_int}     Convert To Integer     ${frequ_shift_hex}
    Dated Log    -----> freqDomainShift = ${frequ_shift_int}
    Should Be True     ${frequ_shift_int}>=${value_shift}

    Dated Log    -----> Check of SRS freqHopping c_SRS
    ${csrs_hex}     get_unique             pdmlFile=${pdml_file}
    ...                             packetName=itf_l2_ps_user_usersetupreq
    ...                             path=.*/itf_l2_ps_user_UserSetupReq.freqHopping.c_SRS
    ...                             kind=show
    ...                             startPacket=${1}
    ...                             endPacket=${1}
    ${csrs_int}     Convert To Integer     ${csrs_hex}
    Dated Log    -----> freqHopping c_SRS = ${csrs_int}
    Should Be True     ${csrs_int}==${value_csrs}

    Dated Log    -----> Check of SRS freqHopping b_SRS
    ${bsrs_hex}     get_unique             pdmlFile=${pdml_file}
    ...                             packetName=itf_l2_ps_user_usersetupreq
    ...                             path=.*/itf_l2_ps_user_UserSetupReq.freqHopping.b_SRS
    ...                             kind=show
    ...                             startPacket=${1}
    ...                             endPacket=${1}
    ${bsrs_int}     Convert To Integer     ${bsrs_hex}
    Dated Log    -----> freqHopping b_SRS = ${bsrs_int}
    Should Be True     ${bsrs_int}==${value_bsrs}

    Dated Log    -----> Check of SRS freqHopping b_hop
    ${bhop_hex}     get_unique             pdmlFile=${pdml_file}
    ...                             packetName=itf_l2_ps_user_usersetupreq
    ...                             path=.*/itf_l2_ps_user_UserSetupReq.freqHopping.b_hop$
    ...                             kind=show
    ...                             startPacket=${1}
    ...                             endPacket=${1}
    ${bhop_int}     Convert To Integer     ${bhop_hex}
    Dated Log    -----> freqHopping b_hop = ${bhop_int}
    Should Be True     ${bhop_int}==${value_bhop}
    Dated Log    -----> Check SRS configuration completed.\n

Check In L3L2 TRS Cell Setup Configuration
    [Documentation]   Check in L2L3, in l2_ps_cell_CellSetupReq that TRS reference signal is correclty configured outside the blanked area.
    [Arguments]    ${pdml_file}
    Dated Log    [Checking TRS allocation in l2_ps_cell_CellSetupReq]
    Dated Log    -----> trsmuting = ${param.trsMutingInBlankedPRBsEnabled}. (if true TRS shall not occupied the whole BW)
    ${trs_start_hex}      get_unique     pdmlFile=${pdml_file}
    ...                                  packetName=itf_l2_ps_cell_CellSetupReq
    ...                                  path=.*/itf_l2_ps_cell_CellSetupReq.csirsTracking.csirsTrackingStartingPrb$
    ...                                  kind=show
    ...                                  startPacket=${1}
    ...                                  endPacket=${1}
    ${trs_start_int}     Convert To Integer     ${trs_start_hex}
    ${trs_numprb_hex}     get_unique     pdmlFile=${pdml_file}
    ...                                  packetName=itf_l2_ps_cell_CellSetupReq
    ...                                  path=.*/itf_l2_ps_cell_CellSetupReq.csirsTracking.csirsTrackingNumOfPrbs$
    ...                                  kind=show
    ...                                  startPacket=${1}
    ...                                  endPacket=${1}
    ${trs_numprb_int}     Convert To Integer     ${trs_numprb_hex}

    # need to subtract 1 from trs_crb_end to have the high frequence index (which starts from 0)
    ${trs_crb_end}     Evaluate    ${trs_start_int}+${trs_numprb_int}-1

    Dated Log    -----> TRS allocation:[startingPrb:${trs_start_int} ; NumOfPrbs: ${trs_numprb_int}]
    Run keyword If    '${param.trsMutingInBlankedPRBsEnabled}'=='false'    Should Be True     ${trs_start_int} == ${0}
    Run keyword If    '${param.trsMutingInBlankedPRBsEnabled}'=='false'    Should Be True     ${trs_crb_end} <= ${csi_rs_size}
    Run keyword If    '${param.trsMutingInBlankedPRBsEnabled}'=='true'     Should Be True     ${trs_start_int} >= ${param.nbrOfBlankedPRBsLowEdgeDL}
    Run keyword If    '${param.trsMutingInBlankedPRBsEnabled}'=='true' and ${param.nbrOfBlankedPRBsHighEdgeDL} == 0
    ...                Should Be True     ${trs_crb_end} <= ${csi_rs_size}
    Run keyword If    '${param.trsMutingInBlankedPRBsEnabled}'=='true' and ${param.nbrOfBlankedPRBsHighEdgeDL} > 0
    ...                Should Be True     ${trs_crb_end} < ${blanking_area_crb_high}

