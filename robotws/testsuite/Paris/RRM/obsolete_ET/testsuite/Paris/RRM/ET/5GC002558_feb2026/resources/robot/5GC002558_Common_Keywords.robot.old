#****************************** Keywords for Test Line configuration ***************************************

Set Context Initial Location And Bandwidth UL
    [Documentation]   To set the cRbStart and size of the location of the dedicated BandwidthDl and BandwidthUl.
    [Arguments]     ${crb_size_ul}   ${crb_start_ul}
    #PDCCH_CONFIG_COMMON/coresetCommon
    &{param_init}    Create Dictionary    cRbSizeUl=${crb_size_ul}  cRbStartUl=${crb_start_ul}
    &{framestructure}    Evaluate    {'dist_name': '${bwp_initial_dist_name}','parameter': 'locationAndBandwidthUl','value':[&{param_init}]}
    @{modify_param_list}     Create List     ${framestructure}
    [Return]   ${modify_param_list}


Commission SCF From Config Folder
    [Documentation]  Commission SCF from config folder.
    Dated Log    [Commissioning SCF of the feature]
    OAM Perform Full Commissioning    ${test_scf_file_path}
    # If gNB was rebooted after re-commissioning, wait until it's ready again.
    Airscale Wait for Ready    ${GNB_DU}
    Dated Log      -----> Commissioning completed

Lock_Unused_Cells
   Oam.OAM Cell Lock  cell_id=2
