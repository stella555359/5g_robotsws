*** Keywords ***
# --------------------------------------------------------------------------------------------------------------------------------------------------
Suite Teardown CB009915-B4
    [Documentation]
    ...     Conditions:     it needs no conditions
    ...     Actions:        it restores the files when the test is finished
    ...     Checks:         it needs no checks
    ...     Verdict:        suite teardown is passed

    Restore Files

    # Saving Snapshot as debug data
    ##agf Dated Log                                   ===> get snapshot just if requested and not already generated after failure...
    # ${snapshot_path}=                           Set Variable    ${LOG_PATH}/SNAPSHOT_GNB*.zip
    # ${status}   ${ret}   Run Keyword And Ignore Error    OperatingSystem.File Should Exist    ${snapshot_path}
    # Run Keyword If   '${status}' == 'PASS'      Dated Log    ===> ${snapshot_path} is already present
    # ...         ELSE IF    ${AUTO_SAVE_DEBUG_DATA}    Setup.Get Snapshot



    ####agf test avec OAM Restore File
    OAM Restore File       setupPath=${scf_suite_setup_backup}

    Dated Log                                   ===> restore file is ${scf_suite_setup_backup}
    ${timestamp_suite_teardown}=                DateTime.Get Current Date    result_format=%Y%m%d-%H%M%S
    Set Suite Variable                          ${timestamp_suite_teardown}
    Dated Log New Line                          ===> RUNTIME: ${timestamp_suite_setup} -> ${timestamp_suite_teardown}

Reconfigure SCF via Json-initial
    sbts_coam.connect_to          name=${gnb_alias}
    Dated Log New Line          delta_file=${scf_delta_config_9915_DTX_initial}
    # Apply delta scf
    coam_parameter.perform_scf_delta_commission
    ...                           delta_file=${scf_delta_config_9915_DTX_initial}
    ...                           connection=${gnb_alias}
    #dialogs.Execute Manual Step       wait keyboard
    OAM wait available
    sbts_coam.teardown            connection=${gnb_alias}

    Restart TL
    OAM Get SCF File                            file=SCF_updated_for_testing-initial.xml

Reconfigure SCF via Json-new DRX threshold
    sbts_coam.connect_to          name=${gnb_alias}
    Dated Log New Line          delta_file=${scf_delta_config_9915_DTX_NewThreshold}
    # Apply delta scf
    coam_parameter.perform_scf_delta_commission
    ...                           delta_file=${scf_delta_config_9915_DTX_NewThreshold}
    ...                           connection=${gnb_alias}
    #dialogs.Execute Manual Step       wait keyboard
    OAM wait available
    sbts_coam.teardown            connection=${gnb_alias}
    #dialogs.Execute Manual Step       wait keyboard
    # Restart TL
    OAM Get SCF File                            file=SCF_updated_for_testing-NewThreshold.xml

# --------------------------------------------------------------------------------------------------------------------------------------------------
CB009915_B4_11_SA
    [Documentation]
    ...     Conditions:     it is based on the arguments ${config_blanking} ${} ${is_capture} ${param} ${test_name}
    ...     Actions:        it performs the call setup for multi-ues with traffic on different cells
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues with traffic and PRB blanking are passed
    [Arguments]             ${config_blanking}
    ...                     ${list_ues}
    ...                     ${is_capture}
    ...                     ${param}
    ...                     ${test_name}

    Init Sequence                               ${param}
    Dated Log New Line                          ===> test name is ${test_name}
    Run Keyword If    ${SUITE_DEBUG_MODE}       Set Debug Mode

    Run Keyword If    ${param.act_blanking} == ${True}    Dated Log New Line    ===> blanking variable is enabled
    ...         ELSE                            Dated Log New Line    ===> BLANKING VARIABLE is disabled


    Reconfigure SCF via Json-initial

    # Configure new ue's dynamically
    ${initial_nb_ue}=                           get length    ${list_ues}
    Run Keyword If    ${initial_nb_ue} < ${param.total_nb_ue}    Configure New Ues    ${list_ues}
    ...                                                             ${initial_nb_ue}
    ...                                                             ${param.total_nb_ue}
    ...                                                             ${dict_settings_ue_default}
    # Configure the current setting for all the ue's
    ${param.total_nb_ue}=                       get length    ${list_ues}
    Dated Log New Line                          ===> configure the setting for all the ${param.total_nb_ue} ue's
    Dated Log New Line                          ===> ue's list is ${list_ues}

    # Start SYSLOG capture during call setup
    ${syslog}=                                  SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_call_setup

    # Capture TTI traces during call setup
    ##Start TTI Logs

    # Setup wtsemu NSA for all the ue's
    Step                                        CallSetup.WTS Setup    shouldUseLua=${False}

    # Capture TTI traces during call setup
    Start TTI Logs

    # UE register for all the ue's
    FOR    ${current_elem}    IN    @{list_ues}
        Step                               UE Register                     ue=${current_elem.ue}
        Step                               Launch PDU Session              ue=${current_elem.ue}    pdu=${current_elem.pdu}    gw=${current_elem.ue}
    END

    Step                                   Stop and Get TTI Logs    trace_name=${test_name}_call_setup
    Step                                   SYSLOG Stop    syslog=${syslog}

    # Start bursty low traffic on 2 UEs
    FOR    ${current_elem}    IN    @{list_ues}
        Step                             wtsemu.trf_data_start     ue=${current_elem.ue}   pdu=1 qfi=1 dir=dl trf_id=1 period_ms=20 size=3000 burst=1

    END

    # WA by moving Captures Init and Start to avoid exceeded traffic - Capture L1L2 during traffic for verification
    Run Keyword If    not ${CALL_SETUP_ONLY}    Run Keywords    Captures Init
    ...    AND                                  Captures Start    action_core=${is_capture.is_capture_core}
    ...                                                           action_cprt=${is_capture.is_capture_cprt}
    ...                                                           action_l1l2=${is_capture.is_capture_l1l2}
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic for L1L2 trace
    ...    AND    Step                          Captures Stop     action_core=${is_capture.is_capture_core}
    ...                                                           action_cprt=${is_capture.is_capture_cprt}
    ...                                                           action_l1l2=${is_capture.is_capture_l1l2}

    ${list_l1l2_messages_filters}=              CB009915 Create Filter Message List

    Run Keyword If    not ${CALL_SETUP_ONLY} and ${is_capture.is_capture_l1l2}    Run Keywords    Step    CB009915 Analyze pcap and pdml
    ...                                                            pcap_file=${capture_l1l2.path}
    ...                                                            list_message_filter=${list_l1l2_messages_filters}
    # dlData pdcchSendReq - Cell1
    ...    AND    Step                          Check dlData pdcchSendReq coresetFreqDomain
    ...                                             pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdcchsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdcchSendReq_coresetFreqDomain_check_9915_B4}
    ...                                                             subcellid=0
    ...                                                             packet_end=512    #-1
    ...                                                             coresetFreqDomain=${coresetFreqDomain_9915_B4_C1}
    ...                                                             coresetFreqDomain_0xFFFF=70093866270720

    # dlData pdcchSendReq - Cell2
    ...    AND    Step                          Check dlData pdcchSendReq coresetFreqDomain
    ...                                             pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdcchsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdcchSendReq_coresetFreqDomain_check_9915_B4}
    ...                                                             subcellid=1
    ...                                                             packet_end=512    #-1
    ...                                                             coresetFreqDomain=${coresetFreqDomain_9915_B4_C2}
    ...                                                             coresetFreqDomain_0xFFFF=70093866270720

    # dlData pdschSendReq - Cell1
    ...    AND    Step                          Check dlData pdschSendReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdschSendReq_check_9915_B4}
    ...                                                             subcellid=0
    ...                                                             packet_end=512    #-1
    ...                                                             nb_prb_blanking_low=18
    ...                                                             nb_prb_blanking_high=0
    ...                                                             total_prb=273
    ...                                                             rbgsize=16

    # dlData pdschSendReq - Cell2
    ...    AND    Step                          Check dlData pdschSendReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdschSendReq_check_9915_B4}
    ...                                                             subcellid=1
    ...                                                             packet_end=512    #-1
    ...                                                             nb_prb_blanking_low=34
    ...                                                             nb_prb_blanking_high=14
    ...                                                             total_prb=273
    ...                                                             rbgsize=16

    # no check on ulData pucchReceiveReq because too much ulData puschReceiveReq on ul slots
    # ulData puschReceiveReq
    ...    AND    Step                          Check ulData puschReceiveReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_puschreceivereq}].pdml_file_result}
    ...                                                             field_values=${ulData_puschReceiveReq_check_9915_B4}
    ...                                                             subcellid=0
    ...                                                             packet_end=512    #-1
    ...                                                             nb_prb_blanking_low=18
    ...                                                             nb_prb_blanking_high=0
    ...                                                             total_prb=273
    ...                                                             prb_reserved=20
    ...                                                             is_nb_prb_max_triggered=${false}

    # ulData puschReceiveReq
    ...    AND    Step                          Check ulData puschReceiveReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_puschreceivereq}].pdml_file_result}
    ...                                                             field_values=${ulData_puschReceiveReq_check_9915_B4}
    ...                                                             subcellid=1
    ...                                                             packet_end=512    #-1
    ...                                                             nb_prb_blanking_low=34
    ...                                                             nb_prb_blanking_high=14
    ...                                                             total_prb=273
    ...                                                             prb_reserved=20
    ...                                                             is_nb_prb_max_triggered=${false}

    # no checks on ulData srsReceiveReq

    # Capture TTI traces during traffic for verification
    Run Keyword If    not ${CALL_SETUP_ONLY}    Run Keywords    Start TTI Logs
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic for TTI trace
    ...    AND    Step                          Stop and Get TTI Logs    trace_name=${test_name}_traffic

    # Check that threshold is reached.
    ${nbDTXEventstate}              dlDTXOptimData    jsonPathName=${TTIjson}    State=DTXPRBTHRES
    Dated Log    Nombre de DTXPRBTHRES ${nbDTXEventstate}
    Should Be True                              ${nbDTXEventstate} != 0

    ${nbDTXEventstate}              dlDTXOptimData    jsonPathName=${TTIjson}    State=REMOVALUE
    Dated Log    Nombre de REMOVALUE ${nbDTXEventstate}
    Should Be True                              ${nbDTXEventstate} != 0

    Step   Reconfigure SCF via Json-new DRX threshold
    # Capture TTI traces during traffic for verification
    Run Keyword If    not ${CALL_SETUP_ONLY}    Run Keywords    Start TTI Logs
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic for TTI trace_NewThreshold
    ...    AND    Step                          Stop and Get TTI Logs    trace_name=${test_name}_traffic_NewThreshold

    # Check that threshold is not reached.
    ${nbDTXEventstate}              dlDTXOptimData    jsonPathName=${TTIjson}    State=DTXPRBTHRES
    Dated Log    Nombre de DTXPRBTHRES ${nbDTXEventstate}
    Should Be True                              ${nbDTXEventstate} <= 5


    ${nbDTXEventstate}              dlDTXOptimData    jsonPathName=${TTIjson}    State=REMOVALUE
    Dated Log    Nombre de REMOVALUE ${nbDTXEventstate}
    Should Be True                              ${nbDTXEventstate} != 0

    ${zoi}                          ZOI Start
    ${zoi_end_remain}=              ZOI Remaining Sec           ${zoi}
    ${start_loop_remaining}=        Evaluate                    ${zoi_end_remain} - ${GP_DEF}


        # To be sure to have a GP fully filled with the same events inside every loop and avoid changing KPIs/counters:
        # If ZOI start is T0, ZOI end is T0 + ${GUARD_DELAY_DEF} + ${GP_DEF} + ${PM_AVAIL_DELAY_DEF}
        # So, test is started at the beginning of the GP before ZOI end, so:
        # ZOI End - ${GP_DEF}
        # Ex. 1: ZOI start is 10h02 => ZOI End is 10h02 + 40s (GUARD_DELAY_DEF) + 1 GP + 1 mn (PM_AVAIL_DELAY_DEF)
        #        => Time for next GP for ZOI End is 10h11, so test is started at 10h06 and KPIs retrieved at 10h11
        # Ex. 2: ZOI start is 10h14:40s => ZOI End is 10h14:40 + 40s (GUARD_DELAY_DEF) + 1 GP + 1 mn (PM_AVAIL_DELAY_DEF)
        #        => Time for next GP for ZOI End is 10h26 as gaurd delay excedd thenext GP frontier,
        #        so test is started at 10h21 and KPIs retrieved at 10h26
        # And, test duration must not exceed 1 GP - 1 mn per loop

    Traced Sleep                    ${start_loop_remaining} seconds
    ...                             msg=before starting scenario

    Dated Log New Line              **** Waiting for end of ZOI ****
    ZOI Wait End                     zoi=${zoi}

    #Check the PM
    ${pm_path}                      Counters.Collect PM files from BTS    ${LOG_PATH}/PM
    Step                            KPI Evaluate                    pmFile=${pm_path}
    ...                             constraintsFile=${cb009915_B4_DTX_constraints}
    ...                             failOnError=${True}

    [Teardown]      Display diagnosis
# --------------------------------------------------------------------------------------------------------------------------------------------------

