#!usr/bin/python

import sys
import subprocess
import re
# import commands
import argparse
from argparse import RawTextHelpFormatter

parser = argparse.ArgumentParser(
    description='This Script Checks the patternIds in the Wireshark \
            and verifies if the values are as expected as in the xml file. \
            a. TstXpLua.py script path \
            b. Pcap file path \
            c. Xpluashark.lua file path \
            d. pdml results path \
    example for script to be used as standalone: \
    python TestXpLua.py GNB_ASIK_M.pcap /home/csamson/tools/luashark/XpShark_2.2.0/xpshark.lua Patterns_XP.pdml',
    epilog='Note : Input files to be provided in the above order only!',
    formatter_class=RawTextHelpFormatter)

parser.add_argument('pcap path', type=str)
parser.add_argument('luashark path', type=str)
parser.add_argument('Patterns_BeamId path', type=str)

args = parser.parse_args()
pcapfile = sys.argv[1]
luafile = sys.argv[2]
pdml = sys.argv[3]

# cmd = "tshark -r " + pcapfile + " -X lua_script:" + luafile + " -T pdml > Patterns_XP.pdml"
cmd = "tshark -r " + pcapfile + " -X lua_script:" + luafile + " -T pdml > " + pdml + " "
MyOut = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE)
MyOut.stdout.close()
MyOut.wait()
