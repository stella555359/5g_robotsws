*** Settings ***
Documentation       [SUITE PURPOSE] CB009915-B-10-robustness cases
...                 Robustness test for CB009915 - based on robustness for 10850:
...                 - Configured gNB to blank 33 PRBs in high edge
...                 - Attach 2 UEs and send mex UL throughput
...                 - When for the end of the current GP and check counter to ensure all PRB except the blanked
...                 PRB are used, check there is not call drop and BLER level
...                 - Detach UE
...                 - Online update gNB configuration to 33 PRBs blanked in low edge
...                 - Repeates above steps several times
...                 Test Case Scenario author   : axel.gouilly-frossard@nokia.com
...                 Test Case Scenario contact  : axel.gouilly-frossard@nokia.com
...                 Creation Date               : 04/10/2023
...                 Last Modification           : 24/09/2024 - richard.duthu@nokia.com - Produce Scout data + some RF50 fixes

# Resources
Resource                                        ./resources/robot/CB009915-A-Keywords.robot
Resource                                        ../../../resources/SWENG/robot/WtsCfgConfig.robot
Resource                                        ../../../resources/SWENG/robot/Syslogs.robot
Resource                                        ../../../resources/SWENG/robot/Hardening.robot
#Library                                         Dialogs

# Tags
Force Tags                                      CA_5G_SW_FR-Villarceaux    RRM    PY36
...                                             CLOUD_5G_I_LO_AP_LO VARIANT_SANSA_FS_CPRI_CMWV_FDD+ECPRI_CMWV_TDD_AEQE
...                                             master_classicalbts_all    SBTS00
...                                             CONFIGURED    5G_RAN    RAN_5G    CRT

# Suites
#Suite Setup                                     CB009915-Common-Keywords.Suite Setup CB009915-Common    keep_all_data_in_file=${True}
Suite Setup                         Suite Setup from scratch            listBackupFiles=${FD_ALL}
...                                                                     keepAllUeDataInCfgFile=${True}
#Suite Teardown                                  CB009915-Common-Keywords.Suite Teardown CB009915-Common
Suite Teardown                                  Suite Teardown


*** Variables ***

# capture setting
&{CAPTURE_OFF}                                  is_capture_core=${False}
...                                             is_capture_cprt=${False}
...                                             is_capture_l1l2=${False}

&{CAPTURE_INVES}                                is_capture_core=${False}
...                                             is_capture_cprt=${False}
...                                             is_capture_l1l2=${False}

&{CAPTURE_L1L2}                                 is_capture_core=${False}
...                                             is_capture_cprt=${False}
...                                             is_capture_l1l2=${True}

# tests settings
&{CB009915-A}                                   capture_duration=0                      # capture duration during traffic starting phase
...                                             deviation=10                            # default deviation for throughput and double for uplink
...                                             dir=UL+DL
...                                             duration=3                              # traffic duration during declaration phase
...                                             pm_waiting_period=2                     # number of waiting periods added for observation
...                                             target_gnb=2                            # gnb target id
...                                             total_nb_cell=2                         # total number of cell used for ue's dispatching
...                                             total_nb_ue=0                           # total number of ue's to configure

&{dict_settings_ue_1}                           nsa_bearer=2
...                                             original_cell=1                         # original cell for call establishment
...                                             throughput=600                          # dl throughput nonGBR max for ue in chBW=100Hz wo/ blanking
...                                             throughput_gbr=${NO_THROUGHPUT}         # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                             throughput_ul=150                       # ul throughput nonGBR max for ue in chBW=100MHz wo/ blanking

&{dict_settings_ue_2}                           nsa_bearer=2
...                                             original_cell=1
...                                             throughput=600
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=150

@{dict_settings_single_ue}                      ${dict_settings_ue_1}

# configuration chBW=100MHz wo/ PRB blanking:
#    throughput - Direction L1 Values - Downlink 1337 Mbps - Uplink 196.0 Mbps #vbo#X Y and PRBs PUSCH#
#    number of PRBs in DL: 273
#    number of PRBs in UL: 273
#    RBG Size: 16 & number of RBGs: 18
#    size for RBG 0 : 16
#    size for RBG 1 : 16
#    size for RBG 2 : 16
#    size for RBG n : 16
#    size for RBG 17: 1
#    PRB Pooling: PRB reduction dataDLnumberOfPrbs=273, dataULnumberOfPrbs=273
# for chBW=100MHz + frameStructureType=semiStatic + ulDlDataSlotRatio=1/4 + basicBeamSet=beamSet_6 + ssBurstSetPeriod=20 + csirsTrackingPeriod=80ms
#    + actPdschAtSsbSlots=false
#    DL: every 8 SFNs <=> every 160 slots: DL= 12 SIB1 + 32 Specific + 70 DL= 114 slots and 114* 273= 31122 PRBs for PDSCH
#        every 5 min (pm counter interval) coeff.= (5*60*1000*2)/160=3750 <=> 31122* 3750= 116707500 PRBs for PDSCH  => M55308C10003= 116707500
#    UL: every 8 SFNs <=> every 160 slots <=> 26 UL + 6 RA slots w/ PRBs for PUSCH
#        every 5 min <=> ((26* X)+ (6* Y))* coeff.= ??? PRBs for PUSCH                       => M55308C10004= 30000000      #vbo#X Y and PRBs PUSCH#

${REQ_MIN_NUM_PUSCH_PRB_100MHZ_MAXI}            253    # limitation on NRCELL.reqMinNumPuschPrb for chBW=100MHz
${REQ_MIN_NUM_PUSCH_PRB_100MHZ_DEFAULT}         213    # default value defined into MIND for our configuration or maxi as not well defined
# configuration chBW=100MHz with PRB blanking:
&{CONFIG_BLANKING_A_100MHZ_default}             chBW=100MHz
...                                             type0CoresetConfigIndex=10
...                                             reqMinNumPuschPrb_maxi=${REQ_MIN_NUM_PUSCH_PRB_100MHZ_MAXI}
...                                             reqMinNumPuschPrb_default=${REQ_MIN_NUM_PUSCH_PRB_100MHZ_DEFAULT}
### nbBlankedPRBsHighEdge=0 and nbBlankedPRBsLowEdge=5:
${THROUGHPUT_DL_LOW5_BLANKED_100MHZ}            500    #vbo#throughput not maxi but used for A-9 testing#
${THROUGHPUT_UL_LOW5_BLANKED_100MHZ}            190    #vbo#throughput not maxi but used for A-9 testing#
### nbBlankedPRBsHighEdge=22 and nbBlankedPRBsLowEdge=0:
${THROUGHPUT_DL_HIGH22_BLANKED_100MHZ}          500    #vbo#throughput not maxi but used for A-9 testing#
${THROUGHPUT_UL_HIGH22_BLANKED_100MHZ}          190    #vbo#throughput not maxi but used for A-9 testing#
### nbBlankedPRBsHighEdge=13 and nbBlankedPRBsLowEdge=14:
${THROUGHPUT_DL_HIGH13_LOW14_BLANKED_100MHZ}    500    #vbo#throughput not maxi but used for A-9 testing#
${THROUGHPUT_UL_HIGH13_LOW14_BLANKED_100MHZ}    190    #vbo#throughput not maxi but used for A-9 testing#


${nb_loops}                                 10
# In Mbps
${ul_tput_per_ue}                           100
${dl_tput_per_ue}                           100

# First UE id for FDD cell (cell3) with variant SANSA_FS_CPRI_CMWV_FDD+ECPRI_CMWV_TDD_AEQE
${ue_id_base_cell}                         1

${traffic_duration}                         10s

${scf_delta_config_9915_robustness}         testsuite/Paris/RRM/ET/CB009915/resources/config/Delta_scf_CB009915_AA_Robustness.json
${delta_config_high_edge}                   testsuite/Paris/RRM/ET/CB009915/resources/config/Delta_scf_High_Edge_CB009915_AA_Robustness.json
${delta_config_low_edge}                    testsuite/Paris/RRM/ET/CB009915/resources/config/Delta_scf_Low_Edge_CB009915_AA_Robustness.json
${cb009915_Robustness_constraints}          testsuite/Paris/RRM/ET/CB009915/resources/config/CB009915_Robustness_constraints.csv

${nbRobustnessUEs}                          1
@{SA_UE_List}

${trcColor}                                 Evaluate    "${CYAN}"
${defColor}                                 Evaluate    "${NORMAL}"
${OkColor}                                  Evaluate    "${GREEN}"

${gnb_alias}                      gnb_under_test

*** Keywords ***

CB009915 Robustness Test Setup
    [Documentation]             Perform needed actions at the begining of a test case
    Init Trace color

CB009915 Robustness Test Teardown
    [Documentation]             Perform needed actions at the end of a test case
    # "Test Teardown" KW from Setup.robot
    Test Teardown
    #dialogs.Execute Manual Step       wait keyboard
    Restore Files               listFileDesc=${FD_ALL}

Init Trace color
    ${trcColor}                 Evaluate    "${CYAN}"
    ${defColor}                 Evaluate    "${NORMAL}"
    ${OkColor}                  Evaluate    "${GREEN}"
    Set Suite Variable          ${trcColor}
    Set Suite Variable          ${defColor}
    Set Suite Variable          ${OkColor}

CB009915_Robustness_Configuration
    [Documentation]               Dedicated KW to add use a delta commissioning file
    ...                           2 cells in TDD 100 MHz (cell1/cell2)

    [Arguments]                   ${pooling_delta_file}     ${gnb_alias}

    # Open connection towards cOAM
    sbts_coam.connect_to          name=${gnb_alias}

    Dated Log New Line          delta_file=${scf_delta_config_9915_robustness}
    # Apply delta scf
    coam_parameter.perform_scf_delta_commission
    ...                           delta_file=${scf_delta_config_9915_robustness}
    ...                           connection=${gnb_alias}

    #dialogs.Execute Manual Step       wait keyboard
    OAM wait available

    sbts_coam.teardown            connection=${gnb_alias}

