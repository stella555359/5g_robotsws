import logging
from robot.libraries.OperatingSystem import OperatingSystem
from robot.libraries.BuiltIn import BuiltIn
from taf.config.wts import wts as wts_config
import os
from ue_caps_vars import UE_CAPABILITIES_A03


def _load_default_wts_config():
    default_wts_config_path = BuiltIn().get_variable_value("${DEFAULT_WTS_CONFIG_PATH}")
    wts_conf_instance = wts_config()
    wts_conf_instance.load_wts_cfg(default_wts_config_path)
    return wts_conf_instance


def _get_and_set_new_wts_config_path(wts_config_filename):
    new_config_path = os.path.join(BuiltIn().get_variable_value("${EPCSIM_DIR_PATH}"), wts_config_filename)
    logging.info(new_config_path)
    BuiltIn().set_test_variable("${WTS_CONFIG_PATH}", new_config_path)
    return new_config_path


def create_wts_config_for_A13():
    new_wts_config_name = "wts_8204_A13.cfg"
    wts_conf_instance = _load_default_wts_config()

    wts_conf_instance.modify(command="enb_param id=1", modification="endc_capable_qci=9,8")
    wts_conf_instance.modify(command="set_bearer id=2 ue=102", modification="qci=8")

    new_config_path = _get_and_set_new_wts_config_path(new_wts_config_name)
    wts_conf_instance.save_wts_cfg(new_config_path)


def create_wts_config_for_A03():
    new_wts_config_name = "wts_8204_A03.cfg"
    wts_conf_instance = _load_default_wts_config()

    wts_conf_instance.modify(
                            command="ue_param id=1",
                            modification="ue_nr_capabilities={}".format(UE_CAPABILITIES_A03)
    )

    new_config_path = _get_and_set_new_wts_config_path(new_wts_config_name)
    wts_conf_instance.save_wts_cfg(new_config_path)


def create_wts_config_for_D02():
    new_wts_config_name = "wts_8204_D02.cfg"
    wts_conf_instance = _load_default_wts_config()

    wts_conf_instance.clone_and_modify(command="set_ue simulated id=1",
                                       modification="id=2 suci=0:311:489:0000:0:0:021645401")
    wts_conf_instance.clone_and_modify(command="ue_param id=1", modification="id=2")
    wts_conf_instance.clone_and_modify(command="set_pdu_gateway id=1", modification="id=2 ue_nat_ip=72.23.0.2")

    new_config_path = _get_and_set_new_wts_config_path(new_wts_config_name)
    wts_conf_instance.save_wts_cfg(new_config_path)


def create_wts_config_for_D05():
    new_wts_config_name = "wts_8204_D05.cfg"
    wts_conf_instance = _load_default_wts_config()

    wts_conf_instance.clone_and_modify(command="set_ue simulated id=11",
                                       modification="id=12 imsi=311:489:21645501")
    wts_conf_instance.clone_and_modify(command="ue_param id=11", modification="id=12")
    wts_conf_instance.clone_and_modify(command="set_pdu_gateway id=11", modification="id=12 ue_nat_ip=72.23.0.12")
    wts_conf_instance.clone_and_modify(command="set_bearer id=2 ue=11", modification="ue=12 ip=4.7.254.209")

    new_config_path = _get_and_set_new_wts_config_path(new_wts_config_name)
    wts_conf_instance.save_wts_cfg(new_config_path)


def create_wts_config_for_E01():
    new_wts_config_name = "wts_8204_E01.cfg"
    wts_conf_instance = _load_default_wts_config()

    ue_1_definition = wts_conf_instance.find_all(command="set_ue simulated id=1")
    ue_1_caps = wts_conf_instance.find_all(command="ue_param id=1")
    ue_1_gateway = wts_conf_instance.find_all(command="set_pdu_gateway id=1")
    ue_21_definition = wts_conf_instance.find_all(command="set_ue simulated id=21")
    ue_21_caps = wts_conf_instance.find_all(command="ue_param id=21")
    ue_21_gateway = wts_conf_instance.find_all(command="set_pdu_gateway id=21")
    combined_list_to_keep = ue_1_definition + ue_1_gateway + ue_1_caps + ue_21_definition + ue_21_gateway + ue_21_caps

    ue_definition_list = wts_conf_instance.find_all(command="set_ue simulated")
    ue_gateway_list = wts_conf_instance.find_all(command="set_pdu_gateway")
    ue_bearer_list = wts_conf_instance.find_all(command="set_bearer")
    ue_caps_list = wts_conf_instance.find_all(command="ue_param")
    combined_list = ue_bearer_list + ue_definition_list + ue_gateway_list + ue_caps_list

    for commands_to_remove in combined_list_to_keep:
        combined_list.remove(commands_to_remove)

    for command_to_delete in combined_list:
        wts_conf_instance.delete(command=command_to_delete)

    wts_conf_instance.modify(command="set_qosflow id=1 5qi=6 default=on", modification="ue=1")
    wts_conf_instance.modify(command="set_qosflow id=2 5qi=5", modification="default=on ue=21")

    new_config_path = _get_and_set_new_wts_config_path(new_wts_config_name)
    wts_conf_instance.save_wts_cfg(new_config_path)
