*** Keywords ***
CB010793_TC-C_1_Receiver_test_model_80MHz_TDD_G-FR1-A1-5_with_8Rx_TDD_Cell_Configuration_ABIP
    Init Sequence         "CB010793-C1"

    Critical Step         CB010793C Test Line Preparation       ${pooling_delta_file_80Mhz}
    Critical Step         Activate Test dedicated Mode
    ...                      depends=CB010793C Test Line Preparation
	Step                  CB010793 setup Mirroring for BIP capture    prefix=CB010793_C1_NR_Uplink
    ...                      depends=Activate Test dedicated Mode
	Step                  CB010793 Start Capture CPRT
    ...                      depends=CB010793 setup Mirroring for BIP capture
	Step                  CB010793 Start Capture L1L2
    ...                      depends=CB010793 setup Mirroring for BIP capture
    Step                  CB010793 Start 5g test NR Uplink           ${param_NR_Uplink}
    ...                      depends=Activate Test dedicated Mode
    Traced Sleep          1    msg=CPRT and BIP L1L2 logs capture ongoing before beam pattern Id change
    @{beamPatternList}    Create List    200    200    200    200
    ${beamPatternIdUpd}   Set Variable   ${beamPatternList}
    Step                  CB010793 Change Beam Pattern Id                   beamPatternId=${beamPatternIdUpd}    TM_className=NR_UPLINK_TEST-1
    ...                      depends=CB010793 Start 5g test NR Perf PUCCH
    Traced Sleep          1    msg=CPRT and BIP L1L2 logs capture ongoing when beam pattern Id changed
	Step                  Capture Stop         capture=${CAPTURE_L1L2}
    ...                      depends=CB010793 Start Capture L1L2
	Step                  Capture Stop         capture=${CAPTURE_CPRT}
    ...                      depends=CB010793 Start Capture CPRT
	Step                  CB010793 Stop uplink Test Model
    ...                      depends=CB010793 Start 5g test NR Uplink
    Step                  CB010793 Check CellSetupRequest                   ${CAPTURE_CPRT}   ${CellSetupRequest_checkShowName_TDD_80MHz}
    ...                      depends=CB010793 Start 5g test NR Uplink
    Step                  CB010793 Check StartConformanceTestReq            ${CAPTURE_CPRT}   ${StartConformanceTestReq_checkShowName_NR_Uplink}
    ...                      depends=CB010793 Start 5g test NR Uplink
    Step                  CB010793 Check StartConformanceTestResp status    ${CAPTURE_CPRT}
    ...                      depends=CB010793 Start 5g test NR Uplink
    Step                  CB010793 Check beamPatternChangeReq               ${CAPTURE_CPRT}   ${beamPatternChangeReq_checkShowName_NR_Uplink}
    ...                      depends=CB010793 Start 5g test NR Perf PUCCH
    Step                  CB010793C Check PuschReceiveReq                   ${CAPTURE_L1L2}   ${PuschReceiveReq_checkShowName_NR_Uplink}
    ...                      depends=CB010793 Start 5g test NR Uplink
    [Teardown]            CB010793 Teardown TC

CB010793_TC-C_3_PUSCH_Performance_Test_Model_40MHz_TDD_G-FR1-A3-13_with_8Rx_TDD_Cell_Configuration_ABIP
