########################  CB010793-C KWs  ########################
CB010793C Check PuschReceiveReq
    [Arguments]    ${BIP_L1L2}    ${FieldShowName}

    ${pdmlFile}           CB010793 Check PuschReceiveReq    ${BIP_L1L2}    ${FieldShowName}

    Dated Log             --- Check pBoost is not 0
    analyzer.check_field     pdmlFile=${pdmlFile}
    ...                      packetName=UlData_PuschReceiveReq_t
    ...                      fieldName=UlData_puschReceiveReqGrant_t.pBoost
    ...                      value=0
    ...                      test=!=


CB010793C Test Line Preparation
    [Documentation]               TL config using a delta commissioning file
    [Arguments]                   ${pooling_delta_file}

    # Open connection towards cOAM
    Dated Log       ==== Starting : CB010793 C Test Line Preparation ====
    ${gnb_alias}         Set Variable    gnb_under_test
    coam_interface_admin.connect_to          name=${gnb_alias}

    # Apply delta scf
    Dated Log       ==== Begin : Applying 10793 C delta commissioning with json file : ${pooling_delta_file} =====
    coam_parameter.perform_scf_delta_commission
    ...                  delta_file=${pooling_delta_file}
    ...                  connection=${gnb_alias}
    ...                  timeout=300
    Dated Log       ==== End : Apply json file, waiting for gnb UP ====
    OAM wait available
    ${cmd}               Set Variable    get_bts_statuses
    ${gnb_status}        SBTS OAM Run Command    oam=${TGNB_DU[0].oam}    cmd=${cmd}
    Dated Log       ==== Current GNB status = ${gnb_status}
    ${cmd}               Set Variable    get_cells_info
    ${cells_info}        SBTS OAM Run Command    oam=${TGNB_DU[0].oam}    cmd=${cmd}
    Dated log       ==== Current cell(s) info = ${cells_info}
    Dated Log       ==== Completed : CB010793 C Test Line Preparation ====
