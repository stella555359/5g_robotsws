CB010793 Set Context_AP IPHY
    [Arguments]    ${card_name}    ${GSCN}
    CB010793 Backup Iphy AirphoneConfig

    GnbXmlTools.Get Data From Gnb TargetBD File    card_name=${card_name}

    WtsXmlConfig.startSession         file=iphy

    #set iphy parameters
    WtsXmlConfig.setTextUsingIndex    //GSCN                  ${GSCN}         idx=1
    WtsXmlConfig.setTextUsingIndex    //cardName              ${card_name}    idx=1

    # update iphy.xml with swVersion and swFileKey values taken fomr GNB TargetBD_*.xml
    WtsXmlConfig.setTextUsingIndex    //version               ${g_resource_swVersion}    idx=1
    WtsXmlConfig.setTextUsingIndex    //bldVersion            ${g_resource_swVersion}    idx=1
# obsolete param:    WtsXmlConfig.setTextUsingIndex    //buildversion          ${g_resource_swVersion}    idx=1
    WtsXmlConfig.setTextUsingIndex    //software/file/name    ${g_resource_swFileKey}    idx=1

    WtsXmlConfig.stopSession          file=iphy

    ${alias}                          SSH Connect             ${AP_DU.sys[0].M}

    ${file}                           SSH Cmd                 command=readlink -f /rom/simmode/iphy.xml
    ...                               alias=${alias}
    ${file}                           Strip String            ${file}
    ssh.Download File                 remote_path=${file}     local_path=${LOG_PATH}/modified_iphy.xml    connection=${alias}


CB010793 Backup Iphy AirphoneConfig
    ${alias}                          SSH Connect               ${AP_DU.sys[0].M}

    ${file}                           SSH Cmd                   command=readlink -f /rom/simmode/iphy.xml
    ...                               alias=${alias}
    ${file}                           Strip String              ${file}

    ${iphy_backup_exists}             SSH Cmd                   command=test -f ${file}.backup && echo -n "okman" || echo -n "noway"
    ...                               alias=${alias}
    ${iphy_file_exist}                SSH Cmd                   command=test -f ${file} && echo -n "okman" || echo -n "noway"
    ...                               alias=${alias}

    run keyword if                    '${iphy_file_exist}'=='okman' and '${iphy_backup_exists}'!='okman'
    ...                               SSH Cmd                   command=cp ${file} ${file}.backup     alias=${alias}
    ssh.Download File                 remote_path=${file}       local_path=${LOG_PATH}/original_iphy.xml   connection=${alias}


CB010793 setup Mirroring for BIP capture
    [Arguments]    ${prefix}

    ${CAPTURE_L1L2}           Capture L1L2 Set Upon Config
    Set Suite Variable        ${CAPTURE_L1L2}
    ${CAPTURE_CPRT}           Capture CPRT Set Upon Config
    Set Suite Variable        ${CAPTURE_CPRT}

    ${CAPTURE_CPRT.filter}    Get Filter For SCTP
    ${CAPTURE_CPRT.prefix}    Set Variable    CPRT_${prefix}
    ${CAPTURE_L1L2.prefix}    Set Variable    L1L2_${prefix}


CB010793 Start Capture CPRT
    Capture Init              ${CAPTURE_CPRT}
    Capture Start             ${CAPTURE_CPRT}


CB010793 Start Capture L1L2
    Capture Init              ${CAPTURE_L1L2}
    Capture Start             ${CAPTURE_L1L2}


CB010793 Teardown TC
    Dated log          Test ${TEST_NAME} done
    Produce Scout Data
    [Teardown]         GenericTest.Display diagnosis
