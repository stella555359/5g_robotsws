*** Keywords ***
CB010793 Start 5g test NR Downlink
    [Arguments]    ${TMparam}
    Dated Log          Start test model NR Downlink

    ${rtId}            Get Runtime Id
    ${tCellId}         Set Variable    1
    ${cell_dn}         Set Variable    /MRBTS-1/RAT-1/RUNTIME_VIEW-${rtId}/MRBTS_R-${rtId}/NRBTS_R-${tCellId}/NRCELL_R-${tCellId}

    ${cmd}             Set Variable    start_5g_downlink_test
    &{args}            Create Dictionary
    ...                dist_name="${cell_dn}"
    ...                test_model="${TMparam.test_model}"
    ...                beam_pattern_id=${TMparam.beam_pattern_id}
    ...                polarization="${TMparam.polarization}"
    ...                power_backoff=${TMparam.power_backoff}
    ...                ru_mode="${TMparam.ru_mode}"
    ...                p_max=${TMparam.p_max}
    ...                phys_cell_id=${TMparam.phys_cell_id}
    ...                mimo_rank=${TMparam.mimo_rank}
    ...                codebook_2_antports=${TMparam.codebook_2_antports}
    ...                i11_codebook_4_antports=${TMparam.i11_codebook_4_antports}
    ...                i2_codebook_4_antports=${TMparam.i2_codebook_4_antports}
    ...                i13_codebook_4_antports=${TMparam.i13_codebook_4_antports}

    ${Response}        SBTS OAM Run Command    oam=${TGNB_DU[0].oam}   cmd=${cmd}    cmd_args=${args}

    Dated Log          start_5g_downlink_test Response: ${Response}
    ${result_node}     Get From Dictionary    ${Response}       resultNode
    ${parameters}      Get From Dictionary    ${result_node}    parameters
    ${status}          Get From Dictionary    ${parameters}     status
    Should Contain     ${status}    Succeeded


