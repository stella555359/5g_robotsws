*** Test Cases ***

TestLine_preparation
   [Tags]    FULL_RUN     10MHZ    2574_A3
   ...       CIT
   5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A1}
   [Teardown]        Run Keyword And Ignore Error     common_Dss_Keywords.Get GNB BTS Info

TestLine_2574_Test_setup_10Mhz
   [Tags]    FULL_RUN   FULL_CALL  10MHZ   2574_A3
   ...       CIT
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory
   ${tc_name}        Set variable    TestLine_preparation
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...               5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A1}
   5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A1}


# TC covered under New Feature
# [1]5GC002574-A3_TC11_NSA_CallSetup_SANSA_10MHz_DL_ratio_max_70_Check_Counters
[1][1.0] 5GC002574-A3_TC11_NSA_CallSetup_SANSA_10MHz_DL_ratio_max_70_Check_Counters
   [Tags]    FULL_RUN     10MHZ    2574   2574_A3
   ...       CRT
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 70%, NSA 5g Call , DL Tput
   ...                 Check counter PRBs used for PDSCH (M55308C10001)
   ...                 Check counter PRBs available for PDSCH (M55308C10003)
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None                                 AND
   ...       update Get Mem Usage Variable    with_Get_Mem_Usage=True                                     AND
   ...       set Test Variable    ${dl_tput_value}                   50                                   AND
   ...       set Test Variable    ${ul_tput_value}                   30                                   AND
   #         deviation need to take into account crm ul settings
   ...       set Test Variable    ${deviation}                       10                                   AND
   ...       common_Dss_Keywords.Get testcase log directory                                               AND
   ...       common_Dss_Keywords.Prepare Test Name                                                        AND
   ...       Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0                                      AND
   ...       5GC002574_keywords.create header csv test result                                             AND
   ...       common_Dss_Keywords.Prepare Logs Directory Path   subdir=ap_udpsyslogs                       AND
   ...       BuiltIn.Run Keyword And Warn On Failure   btslog.Start Btslog                                AND
   ...       BuiltIn.Run Keyword And Warn On Failure   apUDPlog.Start To Capture Iphy Udplog      target_dir=${testCaseDir}/ap_udpsyslogs    AND
   ...       set test variable    ${collector_name}    FDD_DSS_scenario_TC11      AND
   ...       depends   TestLine_2574_Test_setup_10Mhz

   # csamson : prevent egate lockup when being started via Run Kw
   # TC 2574 NSA CellSetup Working                             ${TestDSS10Mhz_2574_A3_Counters}    egate_5GC002574_A3_TC11
   # TC 2574 5g NSA Call Working                               ${TestDSS10Mhz_2574_A3_Counters}    egate_5GC002574_A3_TC11
   # ${Ueid}=    set variable    ${TestDSS10Mhz_2574_A3_Counters.Context.UeId1}
   # ute_wtssim NSA Start Generating "${80}"mbps DL Traffic for Ue "${Ueid}" on NSA using alias "egate_5GC002574_A3_TC11"
   # Pass execution     testing purpose
   # end csamson

   ${tc_name}        Set variable    TestLine_preparation
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...               5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A3_Counters}
   ${tc_name}        Set variable    TestLine_2574_Test_setup_10Mhz
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A3_Counters}
   Get Mem Usage for 2574    period=before
   ${msg}   Catenate   "5GC002574-A3_TC_10_5gCall_with_Traffic_NSA_Mode: sw release used [${convert_version}], Cellsetup Dss phase 3, BW= 10MHz,
   ...                DL RATIO = 70%, , NSA 5g Call , DL Tput\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                 Check counter PRBs used for PDSCH (M55308C10001)\n
   ...                 Check counter PRBs available for PDSCH (M55308C10003)"
   common_Dss_Keywords.Log Test description   ${msg}

   # Update nrCellType into Context for CellId=1
   Update nrCellType into "${TestDSS10Mhz_2574_A3_Counters}" for cellID "1"

   # Specific Setting for this test...
   Update assigned_dl_maximum_share_to_nr with "70" into "${TestDSS10Mhz_2574_A3_Counters}"
   # desactivate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS10Mhz_2574_A3_Counters}"

   # modification DL Ratio into the test param Ctx
   5GC002574_keywords.Update DSS DL pattern with     ${TestDSS10Mhz_2574_A3_Counters}     ${PATTERN_DL_70_SA_OK}
   Dated log       DL pattern into TestParam is ${TestDSS10Mhz_2574_A3_Counters.seq.dl_allocated_normal_subframes}

   # update CatM data with CatMinfo_10MHz_CatMData_CatMPaging_CatMSib1Br in Context
   Update CatMinfo with ${CatMinfo_10MHz_CatMData_CatMPaging_CatMSib1Br_DLRATIO_70} into "${TestDSS10Mhz_2574_A3_Counters}"

   common_Dss_Keywords.Start Tcpdump on TestPc       interface=eth3    option=-s0 sctp or icmp
   # TC 2574 NSA CellSetup                             ${TestDSS10Mhz_2574_A3_Counters}    egate_5GC002574_A3_TC11
   # TC 2574 5g NSA Call                               ${TestDSS10Mhz_2574_A3_Counters}    egate_5GC002574_A3_TC11
   # csamson : prevent egate lockup when being started via Run Kw
   TC 2574 NSA CellSetup Working                        ${TestDSS10Mhz_2574_A3_Counters}    egate_5GC002574_A3_TC11
   set test variable        ${logs_and_traces_flags['BackhaulTrace']}     ${True}
   set test variable        ${logs_and_traces_flags['L1L2BIPTrace']}      ${True}
   set test variable        ${logs_and_traces_flags['AP_L1L2BIPTrace']}   ${True}
   5GC002574_keywords.Start/Stop BIP/backaul Traces  call_location=before_attach  collector_name=${collector_name}_attach
   TC 2574 5g NSA Call Working                          ${TestDSS10Mhz_2574_A3_Counters}    egate_5GC002574_A3_TC11
   Run Keywords   5GC002574_keywords.Start/Stop BIP/backaul Traces  call_location=after_attach  collector_name=${collector_name}_attach
   ...              AND         set test variable        ${logs_and_traces_flags['BackhaulTrace']}     ${False}
   ...              AND         set test variable        ${logs_and_traces_flags['L1L2BIPTrace']}      ${False}
   ...              AND         set test variable        ${logs_and_traces_flags['AP_L1L2BIPTrace']}   ${False}
   common_Dss_Keywords.Stop Tcpdump on TestPc           interface=eth3    target_dir=${testCaseDir}
   TC 2574 DL Tput NSA Mode wo Stopping dl Tput         ${TestDSS10Mhz_2574_A3_Counters}
   ...                                                  ul_rate=${ul_tput_value}
   ...                                                  dl_rate=${dl_tput_value}
   ...                                                  alias=egate_5GC002574_A3_TC11

   ${L1L2_Pcap_File}=   5GC002574_keywords.Get L1L2 traces    time=12s   prefix=TC11_2574_DL_Tput_NSA_Mode.12s.wL1L2Bip
   ${sum_prb}   ${sum_prb_5min}  ${dl_ratio}=    Sum NbrOfPrb pdschsendreq from L1L2 Pcap    ${TestDSS10Mhz_2574_A3_Counters}
   ...                                                                                       ${testCaseDir}/${L1L2_Pcap_File.name}.pcap
   # computed dl ratio not in line with Qos Dl Load Ind
   ${dl_ratio}=   set variable    95

    # Sleep 15 mn in case of GP overlap - Traffic is still ongoing
    Traced Sleep   15 minutes     msg=counters GP overlap

    # Collect PM
    Run Keyword If        '${check_counters}' == '1'    run keywords   Dated log     =========> Collect PM Counters File    AND
    ...                                                                common_Dss_Keywords.Collect PM Counters File
    Run Keyword If        '${check_counters}' == '1'    run keywords   Dated log     =========> Check 2574 Counters         AND
    ...                                                                5GC002574_Keywords.Check 2574 Counters      sum_prb_over_5min=${sum_prb_5min}

    common_Dss_Keywords.Check Tput over GP period   nb_cell=1    dl_expected_tput=43.292    ul_expected_tput=0

    ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
    should contain	                ${output}	                            passed

    [Teardown]     Run Keywords       BuiltIn.Run Keyword And Warn On Failure   btslog.Stop Btslog    target_dir=${testCaseDir}    AND
    ...                               BuiltIn.Run Keyword And Warn On Failure   apUDPlog.Stop Capture Iphy Udplog       AND
    ...                               common_Dss_Keywords.Collect PM Counters file coam   target_dir=${testCaseDir}     AND
    ...                               Get Mem Usage for 2574    period=teardown                                         AND
    ...                               Update assigned_dl_maximum_share_to_nr with   ${TestDSS10Mhz_2574_A3_Counters}   70    AND
    ...                               Stop TcpDump if TestCase Failed                                                        AND
    ...                               Get Gnb Snapshot if TestCase Failed                                                    AND
    ...                               Teardown 2574     alias=egate_5GC002574_A3_TC11                                   AND
    ...                               set test variable   ${logs_and_traces_flags_L1L2BIPTrace}    False                AND
    ...                               set Suite Variable  ${testCaseDir}  None

*** Keywords ***
# robocop: off=unused-argument
# robocop: off=possible-variable-overwriting

TC 2574 NSA CellSetup Working
   [Documentation]                Generic test for 2574: test purpose is to setup X2, Xp and DSS CellSetup Phase3
   [Arguments]                    ${param}     ${alias}=default
   BuiltIn.log                    alias is ${alias}
   Init Sequence                  ${param}
   common_Dss_Keywords.Restart     OwnTLReset=${False}     GNBCallback=common_Dss_Keywords.Set Reset Loop Counter
   Step                            Start capture Backhaul XP for DSS                                   depends=common_Dss_Keywords.Restart
   # Step                           5GC002574_keywords.Start WTS For NSA       argument=${alias}
   common_Dss_Keywords.Kill WTS Services
   common_Dss_Keywords.Start WTS for Airphone    wts_alias=${alias}
   # Init lua config file with nb of UE
   ${LuaFileName}                  TxtConfig Init                          nbUe=${1}
   set global variable             ${LuaFileName_generated}                ${LuaFileName}
   Step       common_Dss_Keywords.Config WTS for Airphone   pass_regexp=NG link is Up
   ...                                                      timeout=120   cfg_file=${LuaFileName}    wts_alias=${alias}
   ...                                                      depends=common_Dss_Keywords.Start WTS for Airphone
   Step       common_Dss_command.Wait wts state ACTIVE Using ute wtssim  argument=${alias}   depends=common_Dss_Keywords.Config WTS for Airphone
   Step       common_Dss_command.Wait Xp Link Up Using Ute Wtssim     argument=${alias}   depends=common_Dss_Keywords.Config WTS for Airphone
   Step       common_Dss_command.X2Ap link Setup Using ute wtssim     argument=${alias}   depends=common_Dss_Keywords.Config WTS for Airphone
   # Step     common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3    argument=${alias}     depends=Wait Xp link Up
   Step       common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3    alias=${alias}    wtsObj=${wtsObj}
   ...                                                          depends=common_Dss_Keywords.Wait Xp link Up Using ute wtssim
   ${pdmlFile}         Stop capture Backhaul XP for DSS
   Run Keyword if       '${CELLSETUP_SHOULD_BE_CHECK}' == '1'
   ...    Step        Check DSS CellSetup Phase3      argument=${pdmlFile}   depends=common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3
   Critical Step                  common_Dss_CellSetup.Verify AP Classical Cell Setup
   [Teardown]               GenericTest.Display diagnosis

TC 2574 NSA CellSetup
   [Documentation]                Generic test for 2574: test purpose is to setup X2, Xp and DSS CellSetup Phase3
   [Arguments]                    ${param}     ${alias}=default
   BuiltIn.log                    alias is ${alias}
   Init Sequence                  ${param}
   common_Dss_Keywords.Restart     OwnTLReset=${False}     GNBCallback=common_Dss_Keywords.Set Reset Loop Counter
   Step                           Start capture Backhaul XP for DSS                                   depends=common_Dss_Keywords.Restart
   Step                           5GC002574_keywords.Start WTS For NSA       argument=${alias}
   Step                           Check wts in active state                  argument=${alias}        depends=5GC002574_keywords.Start WTS For NSA
   Step                           Wait Xp link Up                            argument=${alias}        depends=5GC002574_keywords.Start WTS For NSA
   Step                           X2Ap link Setup                            argument=${alias}        depends=5GC002574_keywords.Start WTS For NSA
   # Step                           common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3    argument=${alias}     depends=Wait Xp link Up
   Step                           common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3    alias=${alias}    wtsObj=${wtsObj}     depends=Wait Xp link Up
   ${pdmlFile}                    Stop capture Backhaul XP for DSS
   Run Keyword if       '${CELLSETUP_SHOULD_BE_CHECK}' == '1'
   ...                    Step        Check DSS CellSetup Phase3      argument=${pdmlFile}   depends=common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3
   Critical Step                  common_Dss_CellSetup.Verify AP Classical Cell Setup
   [Teardown]               GenericTest.Display diagnosis

