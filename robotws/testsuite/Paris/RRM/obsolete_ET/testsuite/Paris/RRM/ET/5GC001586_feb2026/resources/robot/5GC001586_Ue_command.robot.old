Get PDSCH and PUSCH ue_stats_nr
   [arguments]     ${ue_id}=1   ${DLthroughput}=0    ${ULthroughput}=0   ${CallType}=NSA       ${alias}=default
   ${scell_idx}   set variable if    '${CallType}'=='NSA'     8
   ...                                                        0
   ${DLTput_unit}   set variable if    '${DLthroughput}'=='0'     Kbps
   ...                                                            Mbps
   ${ULTput_unit}   set variable if    '${ULthroughput}'=='0'     Kbps
   ...                                                            Mbps
   ${Ue_Avg_PDSCH_Tput}=    run Keyword if    '${DLthroughput}'!='0'    Get PDSCH ue_stats_nr   ue_id=${ue_id}   scell_idx=${scell_idx}
   ...                                                                                          unit=${DLTput_unit}   alias=${alias}
   ...  ELSE                set variable   0
   ${Ue_Avg_PUSCH_Tput}=    run Keyword if    '${ULthroughput}'!='0'    Get PUSCH ue_stats_nr   ue_id=${ue_id}   scell_idx=${scell_idx}
   ...                                                                                          unit=${ULTput_unit}   alias=${alias}
   ...  ELSE                set variable   0
   [return]     ${Ue_Avg_PDSCH_Tput}    ${Ue_Avg_PUSCH_Tput}

prepare egate cmd results log to console
    [Documentation]    [PRIVATE]    prepare egate cmd results log to console, remove empty lines, strip lines
    [Arguments]    ${contents}
    @{lines}       Split to lines     ${contents}
    ${contents_output}    set variable  ''

    FOR   ${line}    IN    @{lines}
       ${length}    GetLength    ${line}
       Run Keyword if  ${length} == 0    Continue For Loop
       ${line_wo_blanks}     Strip String     ${line}
       ${length}    GetLength    ${line_wo_blanks}
       Run Keyword if  ${length} == 0    Continue For Loop
       ${contents_output}=   catenate    SEPARATOR=\n   ${contents_output}   ${line_wo_blanks}
    END
    [Return]      ${contents_output}

GET UE TO REVIEW IF NEEDED
   [Arguments]     ${expected}=UE-
    ${output}    wtsemu.read_wtsemu_output_until_prompt    timeout=10
    # TRY2 : ${output}    wtsemu.read_wtsemu_output_until_re    expected=${expected}   timeout=10
    # TRY3 : ${output}    wtsemu.read_wtsemu_output_until    expected=${expected}   timeout=10
    ${result}    Get Lines Matching Regexp    ${output}    ${expected}    partial_match=${TRUE}
    ${contents_output}=   prepare egate cmd results log to console   ${output}
    Log to Console    ${contents_output}
    should contain    ${output}    aggregate MBR
    [Return]      ${output}

Get Ue_disp TO REVIEW IF NEEDED
    [Arguments]
    Log to Console    Get Ue_disp
    # ute_wtssim.script    file=${run_script_log_set}    entry=sim_log_set_flush()
    wtsemu.ue_disp
    ${output}    Wait Until Keyword Succeeds     1 min    2 sec    GET UE   expected=UE-
    [Return]      ${output}

Get PDSCH UE Stats for Given CC
    [Arguments]    ${ue_id}=1    ${scell_idx}=0     ${alias}=default
    # Log to Console    PDSCH UE stats for given CC
    ${cmd}=   Catenate   ue_stats_nr id=${ue_id} type=pdsch scell=${scell_idx}
    ${pattern}     Set Variable        CellIndex-${scell_idx}
    ${output}    wts.Execute Egate Command And Wait For Data    cmd=${cmd}
    ...    pass_regexp=${pattern}    timeout=5     alias=${alias}
    ${output}    String.Get Lines Matching Regexp    ${output}    ${pattern}    partial_match=True
    # Dated log        ${cmd}
    # Log To Console    \n${output}
    [Return]      ${output}

