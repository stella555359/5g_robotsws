Display PDSCH and PUSCH ue_stats_nr for UEList
    [arguments]     ${UEsList}   ${DlTput}=0    ${UlTput}=0   ${CallType}=NSA       ${alias}=default
    ${scell_idx}     set variable if    '${CallType}'=='NSA'   8
    ...                                                        0
    ${DLTput_unit}   set variable if    '${DlTput}'=='0'     Kbps
    ...                                                      Mbps
    ${ULTput_unit}   set variable if    '${UlTput}'=='0'     Kbps
    ...                                                      Mbps
    FOR    ${UEcurrent}     IN      @{UEsList}
         Dated log   =========> Display PDSCH and PUSCH ue_stats_nr for ue_id=${UEcurrent.ue}
         Display PDSCH and PUSCH ue_stats_nr   ue_id=${UEcurrent.ue}
         ...                                   CallType=${CallType}
         ...                                   DlTput=${DlTput}
         ...                                   UlTput=${UlTput}
         ...                                   alias=${alias}
    END

