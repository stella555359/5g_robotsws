Resource                            ./CB008238_keywords.robot
Resource                            ../../../resources/common/TtiTrace/ttitrace.robot


*** Variables ***
${DL_duration}                   60
${DL_trace_duration}             2

${TputVolMargin}                 5


*** Keywords ***
CB008238_TC_C_01_Single_UE_with_PRB_resources_higher_than_dtxPrbThreshold_TDD_SA
    CB008238 CellSetup            actDtxOptimzedScheduler=true       MaxRetentionDelay=5    dtxPrbThreshold=5
    ...                           CallType=SA
    ...                           actDl256Qam=false
    CB008238 Attach SA            ueSetting=${BASIC_UE_SA}

    # L1/L2 capture configuration
    ${CaptureBIP_DL}              Capture L1L2 Set Upon Config       airscale=${GNB_DU}
    Capture Init                  ${CaptureBIP_DL}                   suffix=_C01

    # TTI capture configuration
    ${TTIdir}                     Get TTI Trace Path                 dir_suffix=C01

    Dated Log New Line            ${trcColor}=== Start packets sending ${defColor}
    ${pktPeriod}                  Evaluate    8
    ${pktSize}                    Evaluate    500
    ${pktBurst}                   Evaluate    1
    Send UE DL packets            ueSetting=${BASIC_UE_SA}
    ...                           duration=0
    ...                           period_ms=${pktPeriod}
    ...                           size=${pktSize}
    ...                           burst=${pktBurst}
    ...                           shouldBeStop=${False}
    ...                           deviation=${TputVolMargin}
    ${timeStartTraffic}           Get Current Date

    # start TTI capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2

    # start L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=START

    Traced Sleep                  ${DL_trace_duration}               msg=DL traffic capture

    # stop L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=STOP

    # stop TTI capture
    ${TTIpcap}                    Stop TTI Traces in Streaming mode
    ...                           tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTITrace_C01

    Traced Sleep                  ${DL_duration}                     msg=DL traffic

    Dated Log New Line            ${trcColor}=== Stop packets sending and detach UE ${defColor}
    ${timeStopTraffic}            Get Current Date
    Traffic Stop                  ueSetting=${BASIC_UE_SA}           dir=dl
    UE Deregister                 id=${BASIC_UE_SA.ue}

    ${TTIjson}                    Convert TTItrace from pcap to others
    ...                           input_file_path=${TTIpcap}
    ${TTIcsv}                     decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=10000

    # Because TTI trace sequence evolves regularly,and as 8238 is now mature,
    # TTI check is removed and checks are done with counters.
    #Dated Log New Line            ${trcColor}=== Check retention in TTI trace ${defColor}
    #${nbCheck}                    CheckTTItrace_PRBthreshold_1UE    jsonPathName=${TTIjson}    mode=TDD
    #Should Be True                ${nbCheck}>0

    CB008238 get PM files

    ${uDTX_OPTIMIZED}  ${uDTX_NO_BUNDLING}    CB008238 get uDTX counters
    ${SlotsWithPDSCH}                         CB008238 get number of slot with PDSCH
    Dated Log New Line            ${trcColor}=== Number of slot with PDSCH: ${SlotsWithPDSCH} ${defColor}
    Dated Log New Line            ${trcColor}=== uDTX_OPTIMIZED: ${uDTX_OPTIMIZED}, uDTX_NO_BUNDLING: ${uDTX_NO_BUNDLING} ${defColor}

    ${timeDiff}                   Subtract Date From Date    ${timeStopTraffic}    ${timeStartTraffic}
    ${trafficDuration}            Convert To Integer    ${timeDiff}
    ${DLtput}                     Evaluate       ${pktSize}*${pktBurst}*8*1000/${pktPeriod}
    ${expectedDataVol}            Evaluate       ${DLtput}*${trafficDuration}/8
    ${expectedDataVolMargin}      Evaluate       ${expectedDataVol} - ${expectedDataVol}*${TputVolMargin}/100
    ${status_DL_dataVolume}       CB008238 check DL Data Volume    QCI=QCI6    expectedDataVol=${expectedDataVolMargin}
    ${status_DL_BLER}             CB008238 check DL BLER    maxBLER=1

    # uDTX_OPTIMIZED: have to take into account PDSCH slots for SA attach/detach
    Should be True                ${uDTX_OPTIMIZED}>=(${SlotsWithPDSCH}-20) and ${uDTX_NO_BUNDLING}==0
    Should be True                ${status_DL_dataVolume} and ${status_DL_BLER}


CB008238_TC_C_05_Multi_UEs_interactions_with_dtxPrbThreshold_FDD_SA
    CB008238 CellSetup            actDtxOptimzedScheduler=true       MaxRetentionDelay=10    dtxPrbThreshold=14
    ...                           CallType=SA                        nbUe=2
    ...                           actDl256Qam=false

    &{UE1_SA}                     copy dictionary    ${BASIC_UE_SA}
    &{UE2_SA}                     copy dictionary    ${BASIC_UE_SA}
    ${UE2_SA.ue}                  Set Variable       2
    ${UE2_SA.pdu}                 Set Variable       2
    ${UE2_SA.trf_id}              Set Variable       2

    Dated Log New Line            ${trcColor}=== Attach UE1 ${defColor}
    CB008238 Attach SA            ueSetting=${UE1_SA}
    Dated Log New Line            ${trcColor}=== Attach UE2 ${defColor}
    CB008238 Attach SA            ueSetting=${UE2_SA}

    # L1/L2 capture configuration
    ${CaptureBIP_DL}              Capture L1L2 Set Upon Config       airscale=${GNB_DU}
    Capture Init                  ${CaptureBIP_DL}                   suffix=_C05

    # TTI capture configuration
    ${TTIdir}                     Get TTI Trace Path                 dir_suffix=C05

    Dated Log New Line            ${trcColor}=== Start traffic on UE1 ${defColor}
    ${pktPeriodUE1}               Evaluate    20
    ${pktSizeUE1}                 Evaluate    50
    ${pktBurstUE1}                Evaluate    1
    Send UE DL packets            ueSetting=${UE1_SA}
    ...                           duration=0
    ...                           period_ms=${pktPeriodUE1}
    ...                           size=${pktSizeUE1}
    ...                           burst=${pktBurstUE1}
    ...                           shouldBeStop=${False}
    ...                           deviation=${TputVolMargin}
    ${timeStartTrafficUE1}        Get Current Date

    Dated Log New Line            ${trcColor}=== Start traffic on UE2 ${defColor}
    ${pktPeriodUE2}               Set Variable    ${pktPeriodUE1}
    ${pktSizeUE2}                 Evaluate    100
    ${pktBurstUE2}                Evaluate    1
    Send UE DL packets            ueSetting=${UE2_SA}
    ...                           duration=0
    ...                           period_ms=${pktPeriodUE2}
    ...                           size=${pktSizeUE2}
    ...                           burst=${pktBurstUE2}
    ...                           shouldBeStop=${False}
    ...                           deviation=${TputVolMargin}
    ${timeStartTrafficUE2}        Get Current Date

    # start TTI capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2

    # start L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=START

    Traced Sleep                  ${DL_trace_duration}               msg=DL traffic capture

    # stop L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=STOP

    # stop TTI capture
    ${TTIpcap}                    Stop TTI Traces in Streaming mode
    ...                           tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTITrace_C05

    Traced Sleep                  ${DL_duration}                     msg=DL traffic

    Dated Log New Line            ${trcColor}=== Stop traffic on UE1 ${defColor}
    ${timeStopTrafficUE1}         Get Current Date
    Traffic Stop                  ueSetting=${UE1_SA}                dir=dl

    Dated Log New Line            ${trcColor}=== Stop traffic on UE2 ${defColor}
    ${timeStopTrafficUE2}         Get Current Date
    Traffic Stop                  ueSetting=${UE2_SA}               dir=dl

    Dated Log New Line            ${trcColor}=== Detach UEs ${defColor}
    UE Deregister                 id=${UE1_SA.ue}
    UE Deregister                 id=${UE2_SA.ue}

    ${TTIjson}                    Convert TTItrace from pcap to others
    ...                           input_file_path=${TTIpcap}
    ${TTIcsv}                     decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=10000

    CB008238 get PM files

    ${uDTX_OPTIMIZED}  ${uDTX_NO_BUNDLING}    CB008238 get uDTX counters
    Dated Log New Line            ${trcColor}=== uDTX_OPTIMIZED: ${uDTX_OPTIMIZED}, uDTX_NO_BUNDLING: ${uDTX_NO_BUNDLING} ${defColor}

    ${UE1timeDiff}                Subtract Date From Date    ${timeStopTrafficUE1}    ${timeStartTrafficUE1}
    ${UE1trafficDuration}         Convert To Integer    ${UE1timeDiff}
    ${UE2timeDiff}                Subtract Date From Date    ${timeStopTrafficUE2}    ${timeStartTrafficUE2}
    ${UE2trafficDuration}         Convert To Integer    ${UE2timeDiff}

    ${UE1uDTXexpectedMin}         Evaluate       ${UE1trafficDuration}*1000/${pktPeriodUE1}
    ${UE2uDTXexpectedMin}         Evaluate       ${UE2trafficDuration}*1000/${pktPeriodUE2}
    ${uDTXexpectedMin}            Evaluate       ${UE1uDTXexpectedMin}+${UE2uDTXexpectedMin}

    ${UEstartDiff}                Subtract Date From Date    ${timeStartTrafficUE2}    ${timeStartTrafficUE1}
    ${UEstartDiffSec}             Convert To Integer    ${UEstartDiff}
    ${UEstopDiff}                 Subtract Date From Date    ${timeStopTrafficUE2}     ${timeStopTrafficUE1}
    ${UEstopDiffSec}              Convert To Integer    ${UEstopDiff}
    ${uDTXNoBundlingMin}          Evaluate       ${UEstartDiffSec}*1000/${pktPeriodUE1}+${UEstopDiffSec}*1000/${pktPeriodUE2}
    ${uDTXNoBundlingMax}          Evaluate       ${UEstartDiffSec+1}*1000/${pktPeriodUE1}+${UEstopDiffSec+1}*1000/${pktPeriodUE2}

    ${UE1DLtput}                  Evaluate       ${pktSizeUE1}*${pktBurstUE1}*8*1000/${pktPeriodUE1}
    ${UE1expectedDataVol}         Evaluate       ${UE1DLtput}*${UE1trafficDuration}/8
    ${UE1expectedDataVolMargin}   Evaluate       ${UE1expectedDataVol} - ${UE1expectedDataVol}*${TputVolMargin}/100
    ${UE2DLtput}                  Evaluate       ${pktSizeUE2}*${pktBurstUE2}*8*1000/${pktPeriodUE2}
    ${UE2expectedDataVol}         Evaluate       ${UE2DLtput}*${UE2trafficDuration}/8
    ${UE2expectedDataVolMargin}   Evaluate       ${UE2expectedDataVol} - ${UE2expectedDataVol}*${TputVolMargin}/100
    ${expectedDataVolMargin}      Evaluate       ${UE1expectedDataVolMargin} + ${UE2expectedDataVolMargin}

    ${status_DRB_dataVolume}      CB008238 check DL Data Volume    QCI=QCI6    expectedDataVol=${expectedDataVolMargin}
    ${status_DL_BLER}             CB008238 check DL BLER    maxBLER=1

    Should be True                ${uDTX_OPTIMIZED}>=${uDTXexpectedMin}
    Should be True                ${uDTX_NO_BUNDLING}>=${uDTXNoBundlingMin} and ${uDTX_NO_BUNDLING}<${uDTXNoBundlingMax}
    Should be True                ${status_DRB_dataVolume} and ${status_DL_BLER}


CB008238_TC_C_07_Single_UE_with_high_DL_throughput_evaluation_FDD_NSA
    CB008238 CellSetup            actDtxOptimzedScheduler=true       MaxRetentionDelay=10    dtxPrbThreshold=80
    ...                           CallType=NSA
    ...                           actDl256Qam=false
    CB008238 Attach NSA           ueSetting=${UE_SIMPLE}

    # TTI capture configuration
    ${TTIdir}                     Get TTI Trace Path                 dir_suffix=C07

    Dated Log New Line            ${trcColor}=== Start packets sending ${defColor}
    Traffic UE DL                 ueSetting=${UE_SIMPLE}
    ...                           throughput=150
    ...                           duration=0
    ...                           shouldBeStop=${False}
    ...                           shouldBeCheck=${False}
    ${timeStartTraffic}           Get Current Date

    # start TTI capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2
    Traced Sleep                  ${DL_trace_duration}               msg=DL traffic capture
    # stop TTI capture
    ${TTIpcap}                    Stop TTI Traces in Streaming mode
    ...                           tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTITrace_C07

    Traced Sleep                  ${DL_duration}                     msg=DL traffic

    Dated Log New Line            ${trcColor}=== Stop packets sending and detach UE ${defColor}
    ${timeStopTraffic}            Get Current Date
    Traffic Stop                  ueSetting=${UE_SIMPLE}             dir=dl
    UE Detach Enb                 ueSetting=${UE_SIMPLE}

    ${TTIjson}                    Convert TTItrace from pcap to others
    ...                           input_file_path=${TTIpcap}
    ${TTIcsv}                     decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=10000

    CB008238 get PM files

    ${timeDiff}                   Subtract Date From Date    ${timeStopTraffic}    ${timeStartTraffic}
    ${trafficDuration}            Convert To Integer    ${timeDiff}
    ${DLtput}                     Evaluate       140*1000000
    ${expectedDataVol}            Evaluate       ${DLtput}*${trafficDuration}/8
    ${expectedDataVolMargin}      Evaluate       ${expectedDataVol} - ${expectedDataVol}*${TputVolMargin}/100
    ${status_DL_dataVolume}       CB008238 check DL Data Volume    QCI=QCI9    expectedDataVol=${expectedDataVolMargin}
    ${status_DL_BLER}             CB008238 check DL BLER    maxBLER=5
    Should be True                ${status_DL_dataVolume} and ${status_DL_BLER}


CB008238_TC_C_09_Multi_UEs_rdDtxCS1SizeThreshold_FDD_SA
    CB008238 CellSetup            actDtxOptimzedScheduler=true    MaxRetentionDelay=10    CallType=SA
    ...                           nbUe=2    CS1size=2
    ...                           actDl256Qam=false
    &{UE1_SA}                     copy dictionary    ${BASIC_UE_SA}
    &{UE2_SA}                     copy dictionary    ${BASIC_UE_SA}
    ${UE2_SA.ue}                  Set Variable       2
    ${UE2_SA.pdu}                 Set Variable       2
    ${UE2_SA.trf_id}              Set Variable       2

    Dated Log New Line            ${trcColor}=== Attach UE1 ${defColor}
    CB008238 Attach SA            ueSetting=${UE1_SA}
    Dated Log New Line            ${trcColor}=== Attach UE2 ${defColor}
    CB008238 Attach SA            ueSetting=${UE2_SA}

    # L1/L2 capture configuration
    ${CaptureBIP_DL}              Capture L1L2 Set Upon Config       airscale=${GNB_DU}
    Capture Init                  ${CaptureBIP_DL}                   suffix=_C09

    # TTI capture configuration
    ${TTIdir}                     Get TTI Trace Path                 dir_suffix=C09

    Dated Log New Line            ${trcColor}=== Start traffic on UE1 ${defColor}
    ${pktPeriodUE1}               Evaluate    6
    ${pktSizeUE1}                 Evaluate    70
    ${pktBurstUE1}                Evaluate    1
    Send UE DL packets            ueSetting=${UE1_SA}
    ...                           duration=0
    ...                           period_ms=${pktPeriodUE1}
    ...                           size=${pktSizeUE1}
    ...                           burst=${pktBurstUE1}
    ...                           shouldBeStop=${False}
    ...                           deviation=${TputVolMargin}
    ${timeStartTrafficUE1}        Get Current Date

    Dated Log New Line            ${trcColor}=== Start traffic on UE2 ${defColor}
    ${pktPeriodUE2}               Evaluate    6
    ${pktSizeUE2}                 Evaluate    100
    ${pktBurstUE2}                Evaluate    1
    Send UE DL packets            ueSetting=${UE2_SA}
    ...                           duration=0
    ...                           period_ms=${pktPeriodUE2}
    ...                           size=${pktSizeUE2}
    ...                           burst=${pktBurstUE2}
    ...                           shouldBeStop=${False}
    ...                           deviation=${TputVolMargin}
    ${timeStartTrafficUE2}        Get Current Date

    # start TTI capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2

    # start L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=START

    Traced Sleep                  ${DL_trace_duration}               msg=DL traffic capture

    # stop L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=STOP

    # stop TTI capture
    ${TTIpcap}                    Stop TTI Traces in Streaming mode
    ...                           tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTITrace_C09

    Traced Sleep                  ${DL_duration}                     msg=DL traffic

    Dated Log New Line            ${trcColor}=== Stop traffic on UE1 ${defColor}
    ${timeStopTrafficUE1}         Get Current Date
    Traffic Stop                  ueSetting=${UE1_SA}                dir=dl

    Dated Log New Line            ${trcColor}=== Stop traffic on UE2 ${defColor}
    ${timeStopTrafficUE2}         Get Current Date
    Traffic Stop                  ueSetting=${UE2_SA}               dir=dl

    Dated Log New Line            ${trcColor}=== Detach UEs ${defColor}
    UE Deregister                 id=${UE1_SA.ue}
    UE Deregister                 id=${UE2_SA.ue}

    ${TTIjson}                    Convert TTItrace from pcap to others
    ...                           input_file_path=${TTIpcap}
    ${TTIcsv}                     decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=10000

    # Because TTI trace sequence evolves regularly,and as 8238 is now mature,
    # TTI check is removed and checks are done with counters.
    #Dated Log New Line            ${trcColor}=== Check retention in TTI trace ${defColor}
    #${nbCheck}                    CheckTTItrace_CS1sizeThreshold_2UEs    jsonPathName=${TTIjson}    mode=FDD
    #Should Be True                ${nbCheck}>0

    CB008238 get PM files

    ${UE1timeDiff}                Subtract Date From Date    ${timeStopTrafficUE1}    ${timeStartTrafficUE1}
    ${UE1trafficDuration}         Convert To Integer    ${UE1timeDiff}
    ${UE1DLtput}                  Evaluate       ${pktSizeUE1}*${pktBurstUE1}*8*1000/${pktPeriodUE1}
    ${UE1expectedDataVol}         Evaluate       ${UE1DLtput}*${UE1trafficDuration}/8
    ${UE1expectedDataVolMargin}   Evaluate       ${UE1expectedDataVol} - ${UE1expectedDataVol}*${TputVolMargin}/100

    ${UE2timeDiff}                Subtract Date From Date    ${timeStopTrafficUE2}    ${timeStartTrafficUE2}
    ${UE2trafficDuration}         Convert To Integer    ${UE2timeDiff}
    ${UE2DLtput}                  Evaluate       ${pktSizeUE2}*${pktBurstUE2}*8*1000/${pktPeriodUE2}
    ${UE2expectedDataVol}         Evaluate       ${UE2DLtput}*${UE2trafficDuration}/8
    ${UE2expectedDataVolMargin}   Evaluate       ${UE2expectedDataVol} - ${UE2expectedDataVol}*${TputVolMargin}/100

    ${expectedDataVolMargin}      Evaluate       ${UE1expectedDataVolMargin} + ${UE2expectedDataVolMargin}

    ${status_DRB_dataVolume}      CB008238 check DL Data Volume    QCI=QCI6    expectedDataVol=${expectedDataVolMargin}
    ${status_DL_BLER}             CB008238 check DL BLER    maxBLER=1
    Should be True                ${status_DRB_dataVolume} and ${status_DL_BLER}


CB008238_TC_C_13_Micro_DTX_interactions_with_PRB_Blanking_FDD_NSA
    CB008238 CellSetup            actDtxOptimzedScheduler=true       MaxRetentionDelay=10    dtxPrbThreshold=8
    ...                           CallType=NSA    PRBblanking=true
    ...                           actDl256Qam=false
    CB008238 Attach NSA           ueSetting=${UE_SIMPLE}

    # L1/L2 capture configuration
    ${CaptureBIP_DL}              Capture L1L2 Set Upon Config       airscale=${GNB_DU}
    Capture Init                  ${CaptureBIP_DL}                   suffix=_C13

    # TTI capture configuration
    ${TTIdir}                     Get TTI Trace Path                 dir_suffix=C13

    Dated Log New Line            ${trcColor}=== Start packets sending ${defColor}
    ${pktPeriod}                  Evaluate    12
    ${pktSize}                    Evaluate    100
    ${pktBurst}                   Evaluate    1
    Send UE DL packets            ueSetting=${UE_SIMPLE}
    ...                           duration=0
    ...                           period_ms=${pktPeriod}
    ...                           size=${pktSize}
    ...                           burst=${pktBurst}
    ...                           shouldBeStop=${False}
    ...                           deviation=${TputVolMargin}
    ${timeStartTraffic}           Get Current Date

    # start TTI capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2

    # start L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=START

    Traced Sleep                  ${DL_trace_duration}               msg=DL traffic capture

    # stop L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=STOP

    # stop TTI capture
    ${TTIpcap}                    Stop TTI Traces in Streaming mode
    ...                           tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTITrace_C13

    Traced Sleep                  ${DL_duration}                     msg=DL traffic

    Dated Log New Line            ${trcColor}=== Stop packets sending and detach UE ${defColor}
    ${timeStopTraffic}            Get Current Date
    Traffic Stop                  ueSetting=${UE_SIMPLE}             dir=dl
    UE Detach Enb                 ueSetting=${UE_SIMPLE}

    ${TTIjson}                    Convert TTItrace from pcap to others
    ...                           input_file_path=${TTIpcap}
    ${TTIcsv}                     decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=10000

    # Because TTI trace sequence evolves regularly,and as 8238 is now mature,
    # TTI check is removed and checks are done with counters.
    #Dated Log New Line            ${trcColor}=== Check retention in TTI trace ${defColor}
    #${nbCheck}                    CheckTTItrace_PRBthreshold_1UE    jsonPathName=${TTIjson}    mode=FDD
    #Should Be True                ${nbCheck}>0

    CB008238 get PM files

    ${uDTX_OPTIMIZED}  ${uDTX_NO_BUNDLING}    CB008238 get uDTX counters
    ${SlotsWithPDSCH}                         CB008238 get number of slot with PDSCH
    Dated Log New Line            ${trcColor}=== Number of slot with PDSCH: ${SlotsWithPDSCH} ${defColor}
    Dated Log New Line            ${trcColor}=== uDTX_OPTIMIZED: ${uDTX_OPTIMIZED}, uDTX_NO_BUNDLING: ${uDTX_NO_BUNDLING} ${defColor}

    ${timeDiff}                   Subtract Date From Date    ${timeStopTraffic}    ${timeStartTraffic}
    ${trafficDuration}            Convert To Integer    ${timeDiff}
    ${DLtput}                     Evaluate       ${pktSize}*${pktBurst}*8*1000/${pktPeriod}
    ${expectedDataVol}            Evaluate       ${DLtput}*${trafficDuration}/8
    ${expectedDataVolMargin}      Evaluate       ${expectedDataVol} - ${expectedDataVol}*${TputVolMargin}/100
    ${status_DL_dataVolume}       CB008238 check DL Data Volume    QCI=QCI9    expectedDataVol=${expectedDataVolMargin}
    ${status_DL_BLER}             CB008238 check DL BLER    maxBLER=1

    # uDTX_OPTIMIZED: have to take into account PDSCH slots for NSA attach
    Should be True                ${uDTX_OPTIMIZED}>=(${SlotsWithPDSCH}-4) and ${uDTX_NO_BUNDLING}==0
    Should be True                ${status_DL_dataVolume} and ${status_DL_BLER}
