    ${DL_PRB_Alloc_BBRM}        Get from list     ${DL_PRB_Alloc_BBRM_total}        1
    ${DL_PRB_Alloc_BBRM_Minus6}     Get from list     ${DL_PRB_Alloc_BBRM_total}        0
    ${msgToLog}     Catenate   Based on ${consTraceColor}dlAllocatedPooledResourcesData${defColor} Event: first SFN is ${DL_PRB_Alloc_BBRM['sfn']}:
    ...     DL PRBs Alloc BBRM UE1: PRB Alloc: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]}${defColor},
    ...     hasZabPrivilege: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['hasZabPrivilege'][0]}${defColor},
    ...     UE2: PRB Alloc: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]}${defColor},
    ...     hasZabPrivilege: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['hasZabPrivilege'][1]}${defColor},
    ...     UE3: PRB Alloc: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]}${defColor},
    ...     hasZabPrivilege: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['hasZabPrivilege'][2]}${defColor}
    dated log    ------> ${msgToLog}
    ${SFN}      Get From Dictionary     ${DL_PRB_Alloc_BBRM}        sfn
    ${SFNToCheck}       Evaluate      str(int(${SFN})+1)
    ${Assigned_PRB}     Get MicroDTX Assigned PRB CB009890      ${TTITraceDict}       ${SFNToCheck}
    ${msg}=  Catenate   Based on ${consTraceColor}dlDtxOptimData${defColor} Event,
    ...                 Check MicroDtx PRB Assignment CB009890-L : Assigned_PRB=${consTraceColor}${Assigned_PRB}${defColor}
    dated log    ------> ${consTraceColorBgYellow}${consTraceColorBlack}SFNToCheck=${SFNToCheck}${defColor}
    dated log    ------> ${msg}
    ${numAllocCellPrbDlMicroDTX}        Get from list     ${Assigned_PRB}        0
    ${Cond1}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}'!='${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell1 => result is ${Cond1}
    ${Cond2}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}'!='${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell2 => result is ${Cond2}
    ${Cond3}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}'!='${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell3 => result is ${Cond3}
    # for cell0 , no dlDtxOptimData present in TtiTraces as with NonGBR=1200Mbps , no MicroDTX seen
    # should be True     ${Cond1}
    # ...     msg=${consTraceColorRed} prbAvailableInfo in Event dlDtxOptimData is ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]} for Cell0${defColor}
    ${msg}  Catenate   prbAvailableInfo in Event dlDtxOptimData is not as expected [${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]}] for Cell1
    should be True     ${Cond2}       msg=${consTraceColorRed}${msg}${defColor}
    ${msg}  Catenate   prbAvailableInfo in Event dlDtxOptimData is not as expected [${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]}] for Cell2
    should be True     ${Cond3}       msg=${consTraceColorRed}${msg}${defColor}

    ${SFNToCheck}       Evaluate      str(int(${SFN})+2)
