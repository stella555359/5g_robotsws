    robot_extension.Run Keyword And Warn On Failure   Produce Scout Data
    robot_extension.Run Keyword And Warn On Failure   CB009890-A-Common-Keywords.Stop Tcpdump on TestPc  interface=eth3   target_dir=${testCaseDir}
    robot_extension.Run Keyword And Warn On Failure   btslog.Stop Btslog    target_dir=${testCaseDir}
    teardownP1
    teardownP2

