    ${actCsirsMultiplexing_to_update}=   set variable if   '${actCsirsMultiplexing.lower()}'=='false'     True
    ...                                                                                                   False
    ${OAMParam_modiflist}=  Run Keyword if   '${actCsirsMultiplexing_to_update}'=='True'    Set_NRCELL_mod_ListParam      actCsirsMultiplexing
    ...                                                                                                                     ${CellId}
    ...                                                                                                                     true
