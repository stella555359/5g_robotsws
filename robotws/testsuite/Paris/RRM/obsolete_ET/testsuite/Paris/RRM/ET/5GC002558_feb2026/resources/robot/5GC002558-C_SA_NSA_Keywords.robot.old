*** Keywords ***

TC 2558-C SA+NSA Attach NSA Call
    [Documentation]     Generic test for SA+NSA attach with PRB blanking
    [Arguments]         ${param}

    Init Sequence                ${param}

    Critical Step                Commission SCF From Config Folder
    Critical Step                Restart TL
	Run Keyword If               not ${isAic} 
    ...		 Step                Lock_Unused_Cells 
    # Critical Step                Start Mirroring And Traces AP
    Critical Step                Start Mirroring And Traces gNB
    Critical Step                Establish X2 Link
    Critical Step                Check AP Cell Setup Is Completed
    Critical Step                SgNB Addition And 5G Attach In SA+NSA Mode
    Critical Step                Stop Mirroring And Traces gNB
    # Critical Step                Stop Mirroring And Traces AP
    # Critical Step                Validation RRC Setup 2558-C NSA Attach
    Critical Step                Validation L2L1 2558-C NSA Attach


TC 2558-C SA+NSA Traffic DL UL NSA Call
    [Documentation]     Generic test for SA+NSA traffic with PRB blanking
    [Arguments]         ${param}

    Init Sequence                ${param}

    Critical Step                Commission SCF From Config Folder
    Critical Step                Restart TL
    Run Keyword If               not ${isAic} 
    ...		 Step                Lock_Unused_Cells 	
    Critical Step                Establish X2 Link
    Critical Step                Check AP Cell Setup Is Completed
    Critical Step                SgNB Addition And 5G Attach In SA+NSA Mode
    # Critical Step                Start Mirroring And Traces AP
    Critical Step                Start Mirroring And Traces gNB
    Critical Step                Traffic DL NSA In SA+NSA Mode
    Critical Step                Traffic UL NSA In SA+NSA Mode
    Critical Step                Stop Mirroring And Traces gNB
    # Critical Step                Stop Mirroring And Traces AP
    Critical Step                Validation L2L1 2558-C If TRS Muting NSA

TC 2558-C SA+NSA Attach SA Call
    [Documentation]     Generic test for SA+NSA attach with PRB blanking

    [Arguments]         ${param}

    Init Sequence                ${param}

    Critical Step                Commission SCF From Config Folder 
    Critical Step                Restart TL
	Run Keyword If               not ${isAic} 
    ...		 Step                Lock_Unused_Cells 
    # Critical Step                Start Mirroring And Traces AP
    Critical Step                Start Mirroring And Traces gNB
    Critical Step                CallSetup.Setup Wtsemu SA    nbCell=1
    Critical Step                Check AP Cell Setup Is Completed
    Critical step                Setup X2 link In SA+NSA Mode SA
    Critical Step                CallSetup.UE Register
    Critical step                CallSetup.Launch PDU Session
    Critical Step                Stop Mirroring And Traces gNB
    # Critical Step                Stop Mirroring And Traces AP
    # Critical Step                Validation SA Cplane Attach 2558-C
    Critical Step                Validation L2L1 SA Attach 2558-C

TC 2558-C SA+NSA Traffic DL UL SA Call
    [Documentation]     Generic test for SA traffic with PRB blanking
    [Arguments]         ${param}

    Init Sequence                ${param}

    Critical Step                Commission SCF From Config Folder 
    Critical Step                Restart TL
	Run Keyword If               not ${isAic} 
    ...		 Step                Lock_Unused_Cells 
    Critical Step                CallSetup.Setup Wtsemu SA    nbCell=1
    Critical Step                Check AP Cell Setup Is Completed
    Critical Step                Setup X2 link In SA+NSA Mode SA
    Critical Step                CallSetup.UE Register
    Critical step                CallSetup.Launch PDU Session
    # Critical Step                Start Mirroring And Traces AP
    Critical Step                Start Mirroring And Traces gNB
    Critical Step                Start DL traffic SA
    Critical Step                Start UL traffic SA
    Critical Step                Stop Mirroring And Traces gNB
    # Critical Step                Stop Mirroring And Traces AP
    Critical Step                Validation L2L1 2558-C If TRS Muting SA

Initialisation Variables 2558-C SA+NSA 20MHz Low Edge NSA Call
    [Documentation]   All global variables needed for the checks in L2L1. Variables are set according to the number of blanking PRB configuration.
    ...    nbrOfBlankedPRBsHighEdgeDL=0
    ...    nbrOfBlankedPRBsHighEdgeUL=0
    ...    nbrOfBlankedPRBsLowEdgeDL=26
    ...    nbrOfBlankedPRBsLowEdgeUL=26
    [Arguments]    ${param}
    Dated Log New Line     [Initialisation Variables for TC: 2558-C SA+NSA 20MHz Low Edge NSA call]
    #Total PRB available in BW before blanking
    ${total_prb_bw}   Set Variable If      '${param.chBwDl}' == '10MHz'    52
    ...                                    '${param.chBwDl}' == '15MHz'    79
    ...                                    '${param.chBwDl}' == '20MHz'    106
    Set Suite Variable    ${total_prb_bw}
    Dated Log    -----> Bandwidth is ${param.chBwDl} and the total of PRB available in BW is ${total_prb_bw}.\n
    #Blanking area acording location to nbrOfBlankedPRBsLowEdge and nbrOfBlankedPRBsHighEdge
    ${blanking_area_crb_low}       Evaluate      ${param.nbrOfBlankedPRBsLowEdgeDL}-1
    ${blanking_area_crb_high}      Evaluate      ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeDL}
    Set Suite Variable     ${blanking_area_crb_low}
    Set Suite Variable     ${blanking_area_crb_high}
    Dated Log    -----> Blanking area: [crb0<xxxx>${blanking_area_crb_low}<--BW-->crb${total_prb_bw}].Shall not be used ! 
    #Overlapping TC or not
    Set Suite Variable     ${IsOverlapping}     False
    # For CSI RS for measurment and tracking (TRS)
    # From SPEC : set to 4*ROUNDUP(offsetPrbDl/4). For OffsetPrbDl see [5G_RAN_CP_36783]
    # From SPEC see [5G_RAN_CP_11056] 
    ${csi_rs_size}        Set Variable If     '${param.chBwDl}' == '10MHz'    52
    ...                                       '${param.chBwDl}' == '15MHz'    80
    ...                                       '${param.chBwDl}' == '20MHz'    108
    Set Suite Variable    ${csi_rs_size}
    #Msg1
    ${prach_prb_offset}     Evaluate    ${param.StartUl}+${param.msg1FrequencyStart}
    Set Suite Variable    ${prach_prb_offset} 
    Set Suite Variable    ${rrc_prach_prb_offset}   26
    #RAT0 allocation for PDSCH
    #From SPEC: In case of blanking. All RBGs containing at least one blanked PRB are excluded from PDSCH scheduling 
    Set Suite Variable    ${rat0_start}     ${32}
    Set Suite Variable    ${rat0_end}       ${105}
    Set Suite Variable    ${rat0_size}      ${74}
    #RAT1 allocation for PUSCH and pdsch for msg2.
    #From SPEC: Blanked PRB are excluded from PUSCH scheduling
    Set Suite Variable        ${rat1_start}     ${param.nbrOfBlankedPRBsLowEdgeUL}  
    ${rat1_end}    Evaluate   ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeUL}-1 
    Set Suite Variable        ${rat1_end}
    #PDCCH
    #coreset0
    Set Suite Variable    ${l1l2_coreset0}             0x7f80000000000000
    Set Suite Variable    ${l1l2_coreset0_rb_shift}    01
    Set Suite Variable    ${rrc_coreset0}              7f8000000000           
    #SRS Configuration : 5G_RAN_CP_36175
    ${available_ul_prb}    Evaluate             ${total_prb_bw}-${param.nbrOfBlankedPRBsLowEdgeUL}-${param.nbrOfBlankedPRBsHighEdgeUL}
    ${c_srs}               Set Variable If     ${available_ul_prb} < ${24}    1
    ...                                        ${available_ul_prb} >= ${24} and ${available_ul_prb} < ${32}     7
    ...                                        ${available_ul_prb} >= ${32} and ${available_ul_prb} < ${52}     9
    ...                                        ${available_ul_prb} >= ${52} and ${available_ul_prb} < ${79}     14
    ...                                        ${available_ul_prb} >= ${79} and ${available_ul_prb} < ${106}    20
    ...                                        ${available_ul_prb} == ${106}    9
    Set Suite Variable    ${freq_pos}     0
    Set Suite Variable    ${freq_shift}   ${param.nbrOfBlankedPRBsLowEdgeUL}
    Set Suite Variable    ${c_srs}        
    Set Suite Variable    ${b_srs}        0
    Set Suite Variable    ${b_hop}        0
    Dated Log    -----> All variables are initialised.

Initialisation Variables 2558-C SA+NSA 10MHz High Edge SA Call
    [Documentation]   All global variables needed for the checks in L2L1. Variables are set according to the number of blanking PRB configuration.
    ...    nbrOfBlankedPRBsHighEdgeDL=4
    ...    nbrOfBlankedPRBsHighEdgeUL=4
    ...    nbrOfBlankedPRBsLowEdgeDL=0
    ...    nbrOfBlankedPRBsLowEdgeUL=0
    [Arguments]    ${param}
    Dated Log New Line     [Initialisation Variables for TC: 2558-C SA+NSA 10MHz High Edge SA call]
    #Total PRB available in BW before blanking
    ${total_prb_bw}   Set Variable If      '${param.chBwDl}' == '10MHz'    52
    ...                                    '${param.chBwDl}' == '15MHz'    79
    ...                                    '${param.chBwDl}' == '20MHz'    106
    Set Suite Variable    ${total_prb_bw}
    Dated Log    -----> Bandwidth is ${param.chBwDl} and the total of PRB available in BW is ${total_prb_bw}.\n
    #Blanking area acording location to nbrOfBlankedPRBsLowEdge and nbrOfBlankedPRBsHighEdge
    ${blanking_area_crb_low}       Evaluate      ${param.nbrOfBlankedPRBsLowEdgeDL}-1
    ${blanking_area_crb_high}      Evaluate      ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeDL}
    Set Suite Variable     ${blanking_area_crb_low}
    Set Suite Variable     ${blanking_area_crb_high}
    Dated Log    -----> Blanking area: [${blanking_area_crb_low}<--BW-->crb${total_prb_bw}].Shall not be used ! 
    #Overlapping TC or not
    Set Suite Variable     ${IsOverlapping}     False
    # For CSI RS for measurment and tracking (TRS)
    # From SPEC : set to 4*ROUNDUP(offsetPrbDl/4). For OffsetPrbDl see [5G_RAN_CP_36783]
    # From SPEC see [5G_RAN_CP_11056] 
    ${csi_rs_size}        Set Variable If     '${param.chBwDl}' == '10MHz'    52
    ...                                       '${param.chBwDl}' == '15MHz'    80
    ...                                       '${param.chBwDl}' == '20MHz'    108
    Set Suite Variable    ${csi_rs_size}
    #Msg1
    ${prach_prb_offset}     Evaluate    ${param.StartUl}+${param.msg1FrequencyStart}
    Set Suite Variable    ${prach_prb_offset} 
    Set Suite Variable    ${rrc_prach_prb_offset}   0
    #RAT0 allocation for PDSCH
    #From SPEC: In case of blanking. All RBGs containing at least one blanked PRB are excluded from PDSCH scheduling 
    Set Suite Variable    ${rat0_start}     ${0}
    Set Suite Variable    ${rat0_end}       ${48}
    Set Suite Variable    ${rat0_size}      ${48}
    #RAT1 allocation for PUSCH and pdsch for msg2.
    #From SPEC: Blanked PRB are excluded from PUSCH scheduling
    Set Suite Variable        ${rat1_start}     ${param.nbrOfBlankedPRBsLowEdgeUL}  
    ${rat1_end}    Evaluate   ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeUL}-1 
    Set Suite Variable        ${rat1_end}
    #PDCCH
    #coreset0
    Set Suite Variable    ${l1l2_coreset0}             0xff00000000000000
    Set Suite Variable    ${l1l2_coreset0_rb_shift}    00
    Set Suite Variable    ${rrc_coreset0}              ff0000000000           
    #SRS Configuration : 5G_RAN_CP_36175
    ${available_ul_prb}    Evaluate             ${total_prb_bw}-${param.nbrOfBlankedPRBsLowEdgeUL}-${param.nbrOfBlankedPRBsHighEdgeUL}
    ${c_srs}               Set Variable If     ${available_ul_prb} < ${24}    1
    ...                                        ${available_ul_prb} >= ${24} and ${available_ul_prb} < ${32}     7
    ...                                        ${available_ul_prb} >= ${32} and ${available_ul_prb} < ${52}     9
    ...                                        ${available_ul_prb} >= ${52} and ${available_ul_prb} < ${79}     14
    ...                                        ${available_ul_prb} >= ${79} and ${available_ul_prb} < ${106}    20
    ...                                        ${available_ul_prb} == ${106}    9
    Set Suite Variable    ${freq_pos}     0
    Set Suite Variable    ${freq_shift}   ${param.nbrOfBlankedPRBsLowEdgeUL}
    Set Suite Variable    ${c_srs}        
    Set Suite Variable    ${b_srs}        0
    Set Suite Variable    ${b_hop}        0
    Dated Log    -----> All variables are initialised.

Setup X2 link In SA+NSA Mode SA
    [Documentation]    set X2 link setup in SA
    wtsemu.enb_x2_link_up           enb=1       target=2
    wtsemu.Read Wtsemu Output Until Re
    ...                             expected=ENB-${ENB_ID}: X2AP Link with [EG]NB-2 \\((\\d+\\.){3}\\d+\\:\\d+\\[\\d\\]\\) is up
    ...                             timeout=60

SgNB Addition And 5G Attach In SA+NSA Mode
    CallSetup.SgNB Addition to ENB          ueSetting=${UE_NSA}

Traffic DL NSA In SA+NSA Mode
    # ADT - increase duration to 60s instead of 30s as it seems that, when the duration is short, average traffic rate
    #        may be missing from bearer statistics data
    #       (in fact, 60s is already the default value of the KW Traffic UE DL so it can be removed here)
    
    #Traffic UE DL   ueSetting=${UE_NSA}    duration=60s   throughput=2  shouldBeCheck=True
    Traffic UE DL   duration=60s  throughput=2  shouldBeCheck=True

Traffic UL NSA In SA+NSA Mode
    # ADT - increase duration to 60s instead of 30s as it seems that, when the duration is short, average traffic rate
    #        may be missing from bearer statistics data
    #       (in fact, 60s is already the default value of the KW Traffic UE DL so it can be removed here)
 
    #Traffic UE UL   ueSetting=${UE_NSA}    duration=60s   throughput=2  shouldBeCheck=True
    Traffic UE UL   duration=60s  throughput=2  shouldBeCheck=True

