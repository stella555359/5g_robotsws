*** Settings ***
Documentation       [SUITE PURPOSE] CB010507-E IWK102&IWK105
...                 Aim of this test is to check that n78 UE can traffic on n77 extended band cell on
...                 the BWP included in the legacy part of n77
...                 The same configuration files are used for both tests.
...                 In SA the ue 5 is configured with n78 band, in NSA it is the ue 12.
...                 Cell 1 is configured with  nrarfcn: 643500 (3652,5MHz) (From 3603.36MHz to 3701.64 MHz)
...                 gscn 7924, with 2 BWP: small 40 MHz (From 3603.36MHz to 3643.36MHz) and large 100MHz
...                 meaning small BWP is within legacy n77, while large BWP is partly in extended BWP, but still in n78 one.
...                 Cell 2 is configured with  nrarfcn: 636666  (3549.99MHz) (From 3500.85MHz to 3599.13 MHz)
...                 gscn 7880, with 1 BWP: 100MHz
...                 this BWP is fully in legacy n77.
...                 The cells are MFBI capable, so n78 ue can use n77 cells.
...                 This is scope of canadian bands
...                 Test Case Scenario author   : axel.gouilly-frossard@nokia.com
...                 Test Case Scenario contact  : axel.gouilly-frossard@nokia.com
...                 Creation Date               : 24/05/2024


# Resources

Library                                         taf.sbts.oam.coam.admin    WITH NAME    sbts_coam
Library                                         ../../../resources/SWENG/python/CoamParameter.py    WITH NAME    coam_parameter
Library                                         taf.wts.runner             WITH NAME    wtsemu

Resource                                        ../../../resources/SWENG/robot/GenericTest.robot
# Resource                                        ../../../resources/SWENG/robot/Capture.robot
Resource                                        ../../../resources/SWENG/robot/WtsCfgConfig.robot
Resource                                        ../../../resources/SWENG/robot/WtsXmlConfig.robot
Resource                                        ../../../resources/SWENG/robot/CallSetup.robot
Resource                                        ../../../resources/SWENG/robot/Traffic.robot
Resource                                        ../../../resources/SWENG/robot/Counters.robot
Resource                                        ../../../resources/SWENG/robot/KPIs.robot


# Tags
Force Tags                                      CA_5G_SW_FR-Villarceaux    RRM    PY36
...                                             CLOUD_5G_I_LO_AP_LO_SANSA_FS_ECPRI_CMWV_TDD
...                                             master_classicalbts_all    SBTS00
...                                             CONFIGURED    5G_RAN    RAN_5G    CRT

# Suites

Suite Setup                         Suite Setup from scratch            listBackupFiles=${FD_ALL}
...                                                                     keepAllUeDataInCfgFile=${True}

Suite Teardown                      Suite Teardown


*** Variables ***
${CB010507-E_constraints}           ${CURDIR}/config/CB010507-E_constraints.csv
${CB010507-E_constraints-UE6}           ${CURDIR}/config/CB010507-E_constraints-UE6.csv

${CB010507-E_NSA-constraints}       ${CURDIR}/config/CB010507-E_NSA-constraints.csv
${scf_delta_config_10507-IWK102}    ${CURDIR}/config/custom/CB010507-E/Delta_scf_CB010507-E.json

${gnb_alias}                        gnb_under_test

${nbUEs}                            1

${Test105HasRun}                    False

&{dict_settings_ue_1}
...                                 original_cell=1                         # original cell for call establishment
...                                 throughput=10                           # dl throughput nonGBR max for ue in chBW=100MHz wo/blanking
...                                 throughput_gbr=${NO_THROUGHPUT}         # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                 throughput_ul=${NO_THROUGHPUT}          # ul throughput nonGBR max for ue in chBW=100MHz wo/blanking
...                                 ue=5
...                                 profile=None                            type=${None}
...                                 pdu=1                                   qfi=1
...                                 bearer=${None}                          testMode=False
...                                 trf_id=1                                burst=${None}
...                                 target_gnb=${None}                      target_cells=${TARGET_CELLS}
...                                 testModeValue=csi_report_override       c_rnti=${None}
...                                 period_ms=${None}                       size=${None}

@{dict_settings_single_ue}          ${dict_settings_ue_1}

&{dict_settings_ue_1_NSA}
...                                 original_cell=1                         # original cell for call establishment
...                                 throughput=10                           # dl throughput nonGBR max for ue in chBW=100MHz wo/blanking
...                                 throughput_gbr=${NO_THROUGHPUT}         # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                 throughput_ul=${NO_THROUGHPUT}          # ul throughput nonGBR max for ue in chBW=100MHz wo/blanking
...                                 ue=12
...                                 profile=None                            type=${None}
...                                 pdu=${None}                             qfi=${None}
...                                 bearer=2                                testMode=False
...                                 trf_id=1                                burst=${None}
...                                 target_gnb=2                            target_cells=${TARGET_CELLS}
...                                 testModeValue=csi_report_override       c_rnti=${None}
...                                 period_ms=${None}                       size=${None}

@{dict_settings_single_ue_NSA}      ${dict_settings_ue_1_NSA}

${dl_tput_per_ue}                    10
@{SA_UE_List}
@{NSA_UE_List}


*** Keywords ***

Init Trace color
    [Documentation]                Just a tool to use some colors in trace logs

    ${trcColor}                 Evaluate    "${BG_CYAN}"
    ${defColor}                 Evaluate    "${NORMAL}"
    ${OkColor}                  Evaluate    "${GREEN}"
    Set Suite Variable          ${trcColor}
    Set Suite Variable          ${defColor}
    Set Suite Variable          ${OkColor}

CB010507_Configuration
    [Documentation]               Dedicated KW to add use a delta commissioning file
    ...                           to configure the 2 cells with canadian PLMN n77 extended and several BWP

    [Arguments]                   ${10705_delta_file}     ${gnb_alias}

    # Open connection towards cOAM
    sbts_coam.connect_to          name=${gnb_alias}

    Dated Log New Line            delta_file=${10705_delta_file}
    # Apply delta scf
    coam_parameter.perform_scf_delta_commission
    ...                           delta_file=${10705_delta_file}
    ...                           connection=${gnb_alias}

    OAM wait available
    sbts_coam.teardown            connection=${gnb_alias}


CB010507_IWK2_MFBI_Scenario_Init
    [Documentation]                 KW used to initialise context for CB010507 TC execution
    ...                             Copy ue_capa file, change gscn in iphy file
    ...                             Update SCF with suitable parameters by using a delta JSON file
    ...                             Update basic.fcg files by custom config, then restart the TL and start WTS
    ...                             Start X2 link and create ue lists (one ue only in this case) for SA and NSA


    Init Trace color
    Dated Log New Line              ${trcColor}---> Starting gNB commissioning ${defColor}

    #Add UE cap file  --  the ue capabilities are in a dedicated file
    ${std_output}=                  Run    cp ${CURDIR}/config/custom/CB010507-E/Capa-10705.cfg /opt/iphy/latest/
    Dated Log New Line              ${trcColor}---> Copy of UE Capa File : ${std_output} ${defColor}

    #Modify gscn for iPhy
    WtsXmlConfig.startSession           file=iphy
    WtsXmlConfig.setTextUsingIndex      //GSCN                          7924            1
    WtsXmlConfig.stopSession            file=iphy

    #Commissionning of the gNB with json delta scf
    CB010507_Configuration      ${scf_delta_config_10507-IWK102}            ${gnb_alias}

    #Update basic.cfg via custom config
    Apply Custom Config    scfc=${EMPTY}
    ...                   iphy=${EMPTY}
    ...                   cfg=${CURDIR}/config/custom/CB010507-E/basic-CanadPlmn-n77-643500-SA-Mfbi-UE5-6.cfg
    ...                   rad_params=${EMPTY}
    ...                   vendor_params=${EMPTY}

    #restart the TL ans start WTS
    Dated Log New Line                  ${trcColor}---> Restart TL ${defColor}
    Restart TL
    OAM wait available
    Dated Log New Line                  ${trcColor}---> WTS setup SA ${defColor}
    WTS Setup                           shouldUseLua=${False}

    # Start X2
    Traced Sleep                                duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    CallSetup.WTS Set X2 Link

    # Build UE list
    #empty the list
    @{SA_UE_List}          Create List
    Set Suite Variable     @{SA_UE_List}

    FOR        ${ue_id}      IN RANGE        0        ${nbUEs}
        &{ue_in_list}=                  Copy dictionary     ${dict_settings_ue_1}
        # ${ue_absolute_id}=              Evaluate            ${ue_id} + ${ue_id_base_cell}
        # Set To Dictionary               ${ue_in_list}       ue          ${ue_absolute_id}
        # Set To Dictionary               ${ue_in_list}       pdu         1
        Append To List                  ${SA_UE_List}       ${ue_in_list}
    END
    FOR        ${ue_id}      IN RANGE        0        ${nbUEs}
        &{ue_in_list}=                  Copy dictionary     ${dict_settings_ue_1_NSA}
        # ${ue_absolute_id}=              Evaluate            ${ue_id} + ${ue_id_base_cell}
        # Set To Dictionary               ${ue_in_list}       ue          ${ue_absolute_id}
        # Set To Dictionary               ${ue_in_list}       pdu         1
        Append To List                  ${NSA_UE_List}       ${ue_in_list}
    END


CB010507_Attach_All_UEs
    Dated Log New Line       ${trcColor}---> Attaching UEs ${defColor}
    FOR        ${current_ue}            IN         @{SA_UE_List}
        UE Register                     ue=${current_ue.ue}
        Launch PDU Session              ue=${current_ue.ue}    pdu=${current_ue.pdu}    gw=${current_ue.ue}
    END
    Dated Log New Line       ${trcColor}---> All needed UEs are now attached${defColor}

CB010507_Check egate_console
    [Documentation]                 This KW checks the last value of LocatioAndBandwidth parameter in egate_cosole.log
    ...                             that indicates the BW used: default value 28875 is for 40Mhz, 13750 for 20Mhz,
    ...                             31624 for 60Mhz and 1099 for 100MHz.
    [Arguments]            ${bandwidth}=28875
    CallSetup.Flush Egate Console Buffer
    ${cmd}      Catenate
        ...                      cd ${tl.core.dir_path};
        ...                       grep -i "locationandband" egate_console.log
        ...         | awk '{for(i=1;i<=NF;i++) if($i=="locationAndBandwidth") value=substr($(i+1), 1, length($(i+1))-1)} END {print value}'

    ${std_output}=   Run    ${cmd}
    Dated Log New Line       ${trcColor}--->locationAndBandwidth ${std_output} ${defColor}
    Should be equal        ${std_output}   ${bandwidth}


CB010507_RegisterNSA_All_UEs
    Dated Log New Line       ${trcColor}---> Attaching UEs ${defColor}
    FOR        ${current_ue}            IN         @{NSA_UE_List}
        SgNB Addition to ENB            ueSetting=${current_ue}
    END
    Dated Log New Line       ${trcColor}---> All needed UEs are now attached${defColor}


CB10507_ZOI_Start
    ${zoi}                          ZOI Start
    ${zoi_end_remain}=              ZOI Remaining Sec           ${zoi}
    ${start_loop_remaining}=        Evaluate                    ${zoi_end_remain} - ${GP_DEF}


    # To be sure to have a GP fully filled with the same events inside every loop and avoid changing KPIs/counters:
    # If ZOI start is T0, ZOI end is T0 + ${GUARD_DELAY_DEF} + ${GP_DEF} + ${PM_AVAIL_DELAY_DEF}
    # So, test is started at the beginning of the GP before ZOI end, so:
    # ZOI End - ${GP_DEF}
    # Ex. 1: ZOI start is 10h02 => ZOI End is 10h02 + 40s (GUARD_DELAY_DEF) + 1 GP + 1 mn (PM_AVAIL_DELAY_DEF)
    #        => Time for next GP for ZOI End is 10h11, so test is started at 10h06 and KPIs retrieved at 10h11
    # Ex. 2: ZOI start is 10h14:40s => ZOI End is 10h14:40 + 40s (GUARD_DELAY_DEF) + 1 GP + 1 mn (PM_AVAIL_DELAY_DEF)
    #        => Time for next GP for ZOI End is 10h26 as gaurd delay excedd thenext GP frontier,
    #        so test is started at 10h21 and KPIs retrieved at 10h26
    # And, test duration must not exceed 1 GP - 1 mn per loop
    Traced Sleep                    ${start_loop_remaining} seconds
    ...                             msg=before starting scenario
    Set Suite Variable              ${zoi}

CB10507_ZOI_Wait_End
    Dated Log New Line               ${trcColor}=== Waiting for end of ZOI ${defColor}
    ZOI Wait End                     zoi=${zoi}

CB10507_backup_egate_console
    CallSetup.Flush Egate Console Buffer
    ${current_date}=                    DateTime.Get Current Date       result_format=%Y%m%d-%H%M%S
    ${filename}                         set variable                    ${current_date}_egate_console_10705-E.log
    ${cmd}                              Catenate
    ...                                 cd ${tl.core.dir_path};
    ...                                 cp ${tl.core.dir_path}/egate_console.log ${LOG_PATH}/${filename}
    ${output}                           SSH Wait For Connect and Cmd
    ...                                 command=${cmd}
    ...                                 host=${HOST_EPCSIM}

CB010507_Traffic_SA
    Traffic.Traffic UEs DL          ueSettingList=${SA_UE_List}
    ...                             shouldBeStop=False      shouldBeCheck=True
    ...                             throughput=${dl_tput_per_ue}

CB010507_Traffic_NSA
    Traffic.Traffic UEs DL          ueSettingList=${NSA_UE_List}
    ...                             shouldBeStop=False      shouldBeCheck=True
    ...                             throughput=${dl_tput_per_ue}

*** Test Cases ***

[1]CB010507-E-IWK105_1
    [Documentation]              Main entry. Perform gNB initialisation, lanch call for n78 UE12 (NSA)
    ...                          Check eGate.log for BWP used then check counters,

    # Change configuration
    ${test_name}           set variable    UE band 78 on extended n77 cell with MFBI - NSA
    Init Sequence                   ${test_name}
    step               CB010507_IWK2_MFBI_Scenario_Init
    step               CB10507_ZOI_Start
    step               CB010507_RegisterNSA_All_UEs
    # Start UL traffic over all UEs
    # perform call UE12 - n78
    step               CB010507_Traffic_NSA
    step               CB010507_Check egate_console
    step               CB10507_ZOI_Wait_End
    # KPIs and counters checks
    ${pm_path}                      Counters.Collect PM files from BTS    ${LOG_PATH}/PM
    step               KPI Evaluate                    pmFile=${pm_path}
    ...                             constraintsFile=${CB010507-E_NSA-constraints}
    ...                             failOnError=${True}
    Produce Scout Data
    CB10507_backup_egate_console
    ${Test105HasRun}      set variable   True
    Set Suite Variable     ${Test105HasRun}
    Suite Teardown
    [Teardown]                      GenericTest.Display diagnosis


[1]CB010507-E-IWK102_1
    [Documentation]              Main entry. Perform gNB initialisation, lanch call for n78 UE5
    ...                          Check eGate.log for BWP used then check counters,
    ...                          Then attach UE6 on cell2 (n78) then perform HO to cell 1 (MFBI)

    # Change configuration
    run keyword if      ${Test105HasRun}==${True}      Suite Setup from scratch      listBackupFiles=${FD_ALL}
    ...                                                                              keepAllUeDataInCfgFile=${True}
    ${test_name}           set variable    UE band 78 on extended n77 cell with MFBI
    Init Sequence                   ${test_name}
    step               CB010507_IWK2_MFBI_Scenario_Init
    step               CB10507_ZOI_Start
    # perform call UE5 - n78 - Cell1
    step               CB010507_Attach_All_UEs
    # Start UL traffic over all UEs
    step               CB010507_Traffic_SA
    step               CB010507_Check egate_console    bandwidth=28875
    step               CB10507_ZOI_Wait_End
    # KPIs and counters checks
    ${pm_path}                      Counters.Collect PM files from BTS    ${LOG_PATH}/PM
    step      KPI Evaluate                    pmFile=${pm_path}
    ...                             constraintsFile=${CB010507-E_constraints}
    ...                             failOnError=${True}

    #Redo the test with UE6on cell2 the perform HO
    step               Restart TL
    OAM wait available
    Dated Log New Line                  ${trcColor}---> WTS setup SA ${defColor}
    step               CallSetup.WTS Setup                 shouldUseLua=${False}
    # Start X2
    Traced Sleep       duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    step               CallSetup.WTS Set X2 Link
    step               CB10507_ZOI_Start
    #Change ue: Use ue=6, starting on cell2
    FOR        ${current_ue}            IN         @{SA_UE_List}
        ${current_ue.ue}            set variable        6
    END
    step               CB010507_Attach_All_UEs
    # Start UL traffic over all UEs
    step               CB010507_Traffic_SA
    #ue shall use BWP with 100MHz, since on cell2
    CB010507_Check egate_console             bandwidth=1099
    #perform HO
    wtsemu.ue_measurement_send_nr    id=6   meas_id=1   event=A2   srsrp_nr=5   srsrq_nr=5   srs_result=0:5:5:0
    Traced Sleep                     duration=5s    msg=Waiting HO events
    wtsemu.ue_measurement_send_nr    id=6   meas_id=5   event=A3   srsrp_nr=1   srsrq_nr=1   phycell_id=50   nrsrp_nr=30   nrsrq_nr=20
    step               CB010507_Check egate_console        bandwidth=28875
    step               CB10507_ZOI_Wait_End
    # KPIs and counters checks
    ${pm_path}                      Counters.Collect PM files from BTS    ${LOG_PATH}/PM
    step               KPI Evaluate                    pmFile=${pm_path}
    ...                             constraintsFile=${CB010507-E_constraints-UE6}
    ...                             failOnError=${True}
    Produce Scout Data
    CB10507_backup_egate_console
    [Teardown]                      GenericTest.Display diagnosis
