*** Variables ***
# List of RadParams to be set during "Suite Setup":
@{rad_params}           0x580117=1    # CSI-RS Event Sherpa
    ...                 0x580758=0    # rdAllowInterL1SpPoolingFdd  - 0 : Disabled(IntraL1SubPool) - 1 : Enabled(InterL1SubPool)
    ...                 0x580690=0    # rdAllowZeroAllocBypass      - 0 : ZAB Disabled - 1 : ZAB Enabled
# List of Vendor Params defined during "Suite Setup":
# WMP: NR_L1Pool_Thor_FDD_FR1_CPRI, ABIP
# Cell Slot Size = 48, Direction=DL
