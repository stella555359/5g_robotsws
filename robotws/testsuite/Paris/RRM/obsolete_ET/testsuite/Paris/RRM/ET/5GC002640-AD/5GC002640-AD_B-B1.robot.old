*** Settings ***

Documentation
...   author: Justyna Balcerzak, Mateusz Plinta
...   contact: justyna.balcerzak@nokia.com, mateusz.plinta@nokia.com
...   description: 5GC002640-AD

Library    ta5g_delta
Library    ta5g_enb
Library    ute_fsmaccess
Library    ta5g_iphy
Library    ute_wtssim
Library    ta5g_egate
Library    ta5g_testline_management
Library    ta5g_throughput
Library    ta5g_tshark
Library    ta_egate_cmd_parser

Library     taf.collectors.tcpdump       WITH NAME  tct
Library     taf.collectors.l2stream3     WITH NAME  tcl
Library     taf.collectors.core          WITH NAME  tcc
Library     taf.converters.eventdecoder  WITH NAME  tce

Library    resources/suite_specific_keywords.py
Library    resources/egate_actions.py
Library    resources/syslog_validation.py
Library    resources/tti_trace_keywords.py
Library    resources/pm_counters.py     WITH NAME  pm_counters
Resource   taf/rfrl/common_resources/robot/libraries_instances.robot
Resource   resources/keywords.robot

Force Tags      STATE_CONFIGURED    RAN_5G    CLOUD_5G_I_BOO_AP_LOO    VARIANT_SANSA_FS_ECPRI_CMWV_FDD+TDD


Suite Setup     Run Keywords    Set Variables Based On Deployment And Release
...             AND             Configure VM interfaces
...             AND             Add debug mctrl flags if enabled
...             AND             Perform feature delta commissioning if ASIL

Suite Teardown   Run Keyword And Ignore Error    Collect Admin Api Logs    subdir=${SUITE_NAME}
...                                                                        dir_name=admin_api_logs

Variables  resources/variables.py

*** Test Cases ***
## to additional options for pybot type: --variable DEBUG_MCTRL_ENABLED:True

[1]2640_AD_B2_017_3CC_DL_CA_DRX_VoNR_call_after_data_call_Blind_add_Buffer_act_FTT_DRX_aligment_success_BF_on
    [Tags]        CRT
    # DEPRECATED => COMMENT
    ${cells_division_variant}=    Set Variable    FTT
    # [Setup]       Run keywords  Adjust parameters using delta    delta=${DELTA_B2_TC17}
    # ...                    AND  Prepare environment    wts_config_filename=${WTS_CONFIG_FILENAME}
    # ...                    AND  Wait for first counters values to arrive
    # ...                    AND  Start collecting logs

    # ${cells_division_variant}=    Set Variable    FTT
    # ${SCELLS}=    Set Variable    ${SCELLS_${cells_division_variant}}
    # ${ue_id}=    Set Variable    14
    # Create aliases  ue_id=${ue_id}
    # Prepare internal traffic generator     ue_id=${ue_id}
    # Expect PDU messages flow     ue_id=${ue_id}
    # Attach UE and establish PDU session     ue_id=${ue_id}
    # Check if PDU messages flow occurred     ue_id=${ue_id}

    # Pcap verify BF enabled BR disabled for FTT      ue_id=${ue_id}
    # Pcap Verify maxMIMO Layers      ue_id=${ue_id}    scells_variant=${cells_division_variant}

    # Verify selected SCells for FTT 3CC CA in UE CON MOD REQ    ue_id=${ue_id}
    # Verify added SCells for FTT 3CC CA in UE CON MOD RESP    ue_id=${ue_id}
    # Verify drx config in UE_CON_MOD_RESP    ue_id=${ue_id}   inactivity_timer=40    on_duration_timer=80
    # ...                                     long_cycle_start_offset=160   retransmission_timer_dl=16    retransmission_timer_ul=16
    # Verify fiveQI QosFlowSetupRequestList after VONR for 3CC CA in INIT CON SET REQ    ue_id=${ue_id}

    # Start traffic on bearer 5qi 5   ue_id=${ue_id}    ul_mbps=${UL_MBPS}    dl_mbps=${DL_MBPS}
    # Wait for throughput stable    sec=60

    # Display stats for UE    ue_id=${ue_id}

    # Expect PDU session modify message flow for VoNR    ue_id=${ue_id}
    # Add bearer with 5qi for pdu session for VoNR          ue_id=${ue_id}
    # Check if PDU session modify messages flow occurred    ue_id=${ue_id}
    # Verify drx config in UE_CON_MOD_RESP    ue_id=${ue_id}   inactivity_timer=20    on_duration_timer=20
    # ...                                     retransmission_timer_dl=0    retransmission_timer_ul=0
    # ...                                     message_alias=UEContextModificationResponse_2nd    flow_alias=Modify_PDU_UE
    # Verify fiveQI QosFlowSetupRequestList after VONR for 3CC CA in PDU SES RSC MOD REQ     ue_id=${ue_id}

    # Start traffic on bearer 5qi 1   ue_id=${ue_id}
    # Wait for throughput stable    sec=10

    # Display stats for UE    ue_id=${ue_id}
    # Run Keyword And Continue On Failure    Check UE statistics on egate   _id=${ue_id}    scell=0-2

    # Collect BIP and TTItrace logs    tti_collection_time=3

    # Wait for next PM period to start
    # Verify counters for AD B2 tests    scells=${SCELLS}     include_vonr=${True}

    # Convert TTI trace from pcap  format=excelCsv  directory_name=TTItrace
    # Check TTI Traces for Beam Reports and CSI-RS and CSI Measurements and DTX ratio    scells=${SCELLS}    pcell=${PCELL_ID}

    # [Teardown]    Run Keywords    Teardown collecting logs in robot
    # ...                    AND    Cleanup parameters after testcase    delta=${CLEANUP_DELTA_B2_FTT}


[1]2640_AD_B2_025_3CC_DL_CA_DRX_VoNR_call_along_data_call_Blind_add_Buffer_act_FTT_DRX_aligment_success_BF_on_BR_on
    [Tags]        CRT
   # DEPRECATED => COMMENT
   ${cells_division_variant}=    Set Variable    FTT
    # [Setup]       Run keywords  Adjust parameters using delta    delta=${DELTA_B2_TC25}
    # ...                    AND  Prepare environment    wts_config_filename=${WTS_CONFIG_FILENAME}
    # ...                    AND  Wait for first counters values to arrive
    # ...                    AND  Start collecting logs

    # ${cells_division_variant}=    Set Variable    FTT
    # ${SCELLS}=    Set Variable    ${SCELLS_${cells_division_variant}}
    # ${ue_id}=      Set Variable    14
    # Create aliases  ue_id=${ue_id}
    # Prepare additional bearer setup for VoNR
    # Prepare internal traffic generator      ue_id=${ue_id}
    # Create beam profile    profile_id=1    ue_beam_index_initial=0,1    csirs_bestbeam=0    csirs_rsrp_best=-44    csirs_rsrp_avg=-50
    # Create beam profile    profile_id=2    ue_beam_index_initial=1,0    csirs_bestbeam=1    csirs_rsrp_best=-45    csirs_rsrp_avg=-120
    # Associate UE to testmode    ue_id=${ue_id}    profile_id=1    beamaction=attach

    # Expect PDU messages flow     ue_id=${ue_id}
    # Attach UE and establish PDU session     ue_id=${ue_id}
    # Check if PDU messages flow occurred     ue_id=${ue_id}

    # Pcap verify BF enabled BR enabled for FTT    ue_id=${ue_id}
    # Pcap Verify maxMIMO Layers    ue_id=${ue_id}    scells_variant=${cells_division_variant}
    # Verify selected SCells for FTT 3CC CA in UE CON MOD REQ     ue_id=${ue_id}
    # Verify added SCells for FTT 3CC CA in UE CON MOD RESP    ue_id=${ue_id}
    # Verify fiveQI QosFlowSetupRequestList along VONR for 3CC CA in INIT CON SET REQ     ue_id=${ue_id}
    # Verify drx config in UE_CON_MOD_RESP    ue_id=${ue_id}   inactivity_timer=20    on_duration_timer=20
    # ...                                     retransmission_timer_dl=0    retransmission_timer_ul=0

    # Start traffic on bearer 5qi 5   ue_id=${ue_id}    ul_mbps=${UL_MBPS}    dl_mbps=${DL_MBPS}
    # Start traffic on bearer 5qi 1   ue_id=${ue_id}
    # Associate UE to testmode    ue_id=${ue_id}    profile_id=2    beamaction=switch    scell=2
    # Wait for throughput stable    sec=10

    # Display stats for UE    ue_id=${ue_id}
    # Run Keyword And Continue On Failure    Check UE statistics on egate   _id=${ue_id}    scell=0-2

    # Collect BIP and TTItrace logs    tti_collection_time=3

    # Wait for next PM period to start
    # Verify counters for AD B2 tests    scells=${SCELLS}     include_vonr=${True}

    # Convert TTI trace from pcap  format=excelCsv  directory_name=TTItrace
    # Check TTI Traces for Beam Reports and CSI-RS and CSI Measurements and DTX ratio    scells=${SCELLS}   beamrefinement=${True}   pcell=${PCELL_ID}

    # [Teardown]    Run Keywords    Teardown collecting logs in robot
    # ...                    AND    Cleanup parameters after testcase    delta=${CLEANUP_DELTA_B2_FTT_BR_on}


