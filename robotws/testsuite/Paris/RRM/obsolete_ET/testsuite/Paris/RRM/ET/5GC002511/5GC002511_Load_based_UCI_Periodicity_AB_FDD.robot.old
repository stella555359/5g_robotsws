*** Test Cases ***

#
# For TCs AB_8 and AB_9, number of UE used for threshold are based on the number of UE that can be attached.
# Number of UEs are retrieved from :
# https://nokia.sharepoint.com/sites/5GSystemEngineering/RRM_Telecom_TD/CP_Domain/_layouts/15/# Doc.aspx?sourcedoc=
# %7BA4DF2825-1CCF-4E68-920E-5B2EED28355E%7D&file=5G_classic_gNB_DU_Capacity_Requirements.xlsx&action=default&mobileredirect=true
#
# Number of UE need to be consistent with the configuration used:
#
# With FDD configuration:
#  - Max Nb UE slots20 = 17 => with 25 % threshold, 4 UEs with slots20, others with slots160
#  - Max Nb UE slots20 = 17 => with 50 %, 9 with slots20, others with slots160
#  - Max Nb UE slots20 = 17 => with 75 %, 13 with slots20, others with slots160
#

[1][1.0] 5GC002511_AB_8_FR1_FDD_actLoadCsiPeriodicity OFF

   [Documentation]                 Automation for 2511-AB TC_8

   # Expected CSI list in the order of UE attachments (from 1 to 6)
   # In this case: 1st UE: 20 slots period
   @{expected_csi_period}          Create List           slots20    slots20    slots20    slots20    slots20    slots20

   Generic KW for CSI Periodicity         feature_activation=false
   ...                                    csi_period=slots20
   ...                                    nb_ue=6
   ...                                    default_mcs=16
   ...                                    prach_ci=12
   ...                                    techno=fdd
   ...                                    expected_csi_configuration=${expected_csi_period}

   # Sleep 15 mn in case of GP overlap
   Traced Sleep                           ${pm_reporting_period}

   # Retrieve counters and compare with a reference
   ${status}             Run Keyword If        '${check_counters}' == 'True'       Verify PM Values With Margin     5GC002511_AB_8

   [Teardown]            Test Teardown for 2511


