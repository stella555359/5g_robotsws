# Used to enable debug logs inside console
${debug_2511}                   True
# Used to enable CPRT traces through R&D parameter
${enable_CPRT_traces}           False
# Dump WTS sos report and gNB snapshot in case a test is failed
${snapshots_dump}               True

# PM reporting period
${pm_reporting_period}          5 minutes
# Used to enable PM Counters verification
${check_counters}               True


# CSI Report period conversion
&{csi_report_period_converter}             slots20=5      slots40=6       slots160=8       slots320=9

# Dictionary to retrieve domain to which a counter belongs
&{dict_counter_domains}             M55115C00501=NRBTS      M55112C00002=NRCELL      M55112C00004=NRCELL
...                                 M55112C03002=NRCELL     M55117C01009=NRDU        M55319C02009=NRBTS
...                                 M55310C01009=NRCELL     M55319C06009=NRBTS       M55310C04009=NRCELL

# KPIs reference definition
# M55115C00501  Number of Users configured with the maximum supported csi periodicity
# M55112C00002  Number of outgoing SGNB ADDITION REQUEST ACKNOWLEDGE sent to LTE eNB) for call setup
# M55112C00004  Number of incoming and successful SGNB RECONFIGURATION COMPLETE received from LTE eNB for call setup
# M55112C03002  Number of radio bearer successfully established
# M55117C01009  Number of Ue Context Release Command received
# M55319C02009  DL PDCP SDU volume transmitted for NSA Bearer - QoS Group 09
# M55310C01009  DL RLC data PDU volume transmitted by Low RLC  - QoS Group 09
# M55319C06009  UL PDCP SDU volume received for NSA Bearer - QoS Group 09
# M55310C04009  UL RLC data PDUs received by Low RLC - QoS Group 09

