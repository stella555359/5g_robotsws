*** Keywords ***

Test Suite Setup for 2511
    [Documentation]                 KW used to save initial configuration (SCF, gNB and Airphone swconfig.txt, WTS CFG and xml, AP PHY xml)
    ...                             Initial configuration is restored at Tear Down step
    ...                             Activates also CPRT Debug Logs if requested through enable_CPRT_traces variable

    # listBackupFiles=${FD_ALL} will save and restore all configuration files
    Setup.Suite Setup From Scratch          listBackupFiles=${FD_ALL}

    # Activate CPRT debug traces if requested, "Restart TL" is called just below
    Run Keyword If    '${enable_CPRT_traces}'=='True'
    ...               Run Keywords
    ...               Activate CPRT Traces      AND
    ...               Restart TL

    # Set Debug Mode for logs if ${debug_2511} is True
    Run Keyword If    '${debug_2511}'=='True'    Set Debug Mode    True
    ...               ELSE                       Set Debug Mode    False


Test Teardown for 2511
    [Documentation]                 KW used at end of a test to collect WTS sos report and gNB Snapshot in case the test is failed

    # Produce Sos Report and gNB snapshot in case a Test is Failed
    Run Keyword If Test Failed      Run Keyword If    '${snapshots_dump}'=='True'
    ...                             Run Keywords
    ...                             Get Sos Report      AND
    ...                             Get Snapshot


Activate CPRT Traces
    [Documentation]                 KW used to activate CPRT traces on gNB side
    ${p1}=                          create dictionary                       field=${CPRT_ENABLE_DEBUG_LOG_ADDR}
    ...                             value=1
    ${param_list}=                  Create List                             ${p1}
    Set Fields in swconfig DU       param_list=${param_list}


Set CSI Configuration
    [Documentation]                 KW used to set configuration on gNB side inside SCF

    [Arguments]                     ${feature_activated}
    ...                             ${csi_report_period}
    ...                             ${threshold}=50Percent
    ...                             ${default_mcs}=5
    ...                             ${prach_ci}=96
    ...                             ${techno}=tdd

    Dated Log New Line    Calling Set CSI Configuration
    selenium_coam.enable_virtual_display
    Debug Dated Log    Opening ${GNB_DU.oam.url}...
    selenium_coam.login    url=${GNB_DU.oam.url}
    ...                    username=${GNB_DU.oam.httpConnection.username}
    ...                    password=${GNB_DU.oam.httpConnection.password}
    selenium_coam.disable_message_box
    Run Keyword If         ${TLConfig.isUTE}==${True}
    ...                    Run Keyword And Ignore Error        selenium_coam.close_start_up_view_window

    Debug Dated Log    Setting SCF Parameter Activate LTE-NR dynamic spectrum sharing to false
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...                                  filter_param=Activate LTE-NR dynamic spectrum sharing
    ...                                  new_value=false
    Debug Dated Log    Setting SCF Parameter Activate frequency domain scheduling to false
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...                                  filter_param=Activate frequency domain scheduling
    ...                                  new_value=false
    Debug Dated Log    Setting SCF Parameter Number of transmitted Synchronization Signal Blocks to 1 beam
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/${NRCELL_GRP}
    ...                                  filter_param=Number of transmitted Synchronization Signal Blocks
    ...                                  new_value=1 beam
    Debug Dated Log    Setting SCF Parameter Activate load based CSI periodicity to ${feature_activated}
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/${NRCELL_GRP}
    ...                                  filter_param=Activate load based CSI periodicity
    ...                                  new_value=${feature_activated}
    Debug Dated Log    Setting SCF Parameter Load Based Csi Periodicity increase Threshold to ${threshold}
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/${NRCELL_GRP}
    ...                                  filter_param=Load Based Csi Periodicity increase Threshold
    ...                                  new_value=${threshold}
    Debug Dated Log    Setting SCF Parameter SS Burst Set Period to 20
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/${NRCELL_GRP}
    ...                                  filter_param=SS Burst Set Period
    ...                                  new_value=20
    Debug Dated Log    Setting SCF Parameter CSI reporting periodicity to ${csi_report_period}
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                  filter_param=CSI reporting periodicity
    ...                                  new_value=${csi_report_period}
    Debug Dated Log    Setting SCF Parameter PUCCH mode selection to shortPucch
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                  filter_param=PUCCH mode selection
    ...                                  new_value=shortPucch
    Debug Dated Log    Setting SCF Parameter Activate Beamforming to false
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                  filter_param=Activate Beamforming
    ...                                  new_value=false
    Debug Dated Log    Setting SCF Parameter PRACH configuration index to ${prach_ci}
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                  filter_param=PRACH configuration index
    ...                                  new_value=${prach_ci}
    Debug Dated Log    Setting SCF Parameter Initial MCS for DL transmission to ${default_mcs}
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                  filter_param=Initial MCS for DL transmission
    ...                                  new_value=${default_mcs}
    Debug Dated Log    Setting SCF Parameter Initial MCS for UL Transmission to ${default_mcs}
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                  filter_param=Initial MCS for UL Transmission
    ...                                  new_value=${default_mcs}
    Debug Dated Log    Setting SCF Parameter Activate PRACH slot uplink channel multiplexing to false
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                  filter_param=Activate PRACH slot uplink channel multiplexing
    ...                                  new_value=false
    Debug Dated Log    Setting SCF Parameter Activate Periodic CSI FDM to false
    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                  filter_param=Activate Periodic CSI FDM
    ...                                  new_value=false

    # Manage update of Frame Structure parameters in case of TDD
    Run Keyword if    '${techno}' == 'tdd'
    ...    Run Keywords
    ...    Debug Dated Log    Setting SCF Parameter Frame Structure Type to tdLte    AND
    ...    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                         filter_param=Frame Structure Type
    ...                                         new_value=tdLte                      AND
    ...    Debug Dated Log    Setting SCF Parameter Guard Period length to 4Symbols              AND
    ...    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                         filter_param=Guard Period length
    ...                                         new_value=4Symbols                   AND
    ...    Debug Dated Log    Setting SCF Parameter UL to DL logical data slot ratio to 1/4      AND
    ...    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                         filter_param=UL to DL logical data slot ratio
    ...                                         new_value=1/4                        AND
    ...    Debug Dated Log    Setting SCF Parameter TDLTE UL-DL configuration to tdLteConfig2    AND
    ...    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                         filter_param=TDLTE UL-DL configuration
    ...                                         new_value=tdLteConfig2               AND
    ...    Debug Dated Log    Setting SCF Parameter Basic Beam Set to beamSet_1                  AND
    ...    selenium_coam.set_parameter_value    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                                         filter_param=Basic Beam Set
    ...                                         new_value=beamSet_1

    selenium_coam.validate_plan
    selenium_coam.activate_plan     activate_plan_despite_errors=${true}   execute=${true}
    Traced Sleep                    300
    Debug Dated Log                 Parameters applied, waiting for gNB to be available...
    OAM wait available
    Debug Dated Log                 gNB is available, continue...
    Run Keyword And Ignore Error    selenium_coam.continue_after_reload_modal_appear
    Run Keyword And Ignore Error    selenium_coam.logout


# KW to parse counter list for each TC and compare with predefined value with an error percentage
Verify PM Values With Margin
    [Documentation]                 KW to parse counter list for each TC and
    ...                             compare with predefined value with an error percentage
    [Arguments]                     ${TC_name}

   ${date}                          Get Current Date
   ${date_in_dir_name}              Convert Date         ${date}     result_format=%d%m%Y_%H%M
   ${log_path_pm}                   Set Variable         ${LOG_PATH}/PM_${date_in_dir_name}
   ${pm_latest}                    Collect PM files from BTS    ${log_path_pm}

   ${tc_kpi_dict}                  Get From Dictionary     ${dict_kpis_all_tc}     ${TC_name}
   ${tc_dict_keys}                 Get Dictionary Keys     ${tc_kpi_dict}

   Run Keyword If       '${debug_2511}' == 'True'       Log To Console                  ${tc_kpi_dict}
   Run Keyword If       '${debug_2511}' == 'True'       Log To Console                  Keys: ${tc_dict_keys}

   # For loop parsing counter defined inside ${tc_kpi_dict} and compare with a predefinied value
   FOR        ${counter}      IN      @{tc_dict_keys}
       ${domain}            Get From Dictionary     ${dict_counter_domains}     ${counter}
       ${min_max}           Get From Dictionary     ${tc_kpi_dict}     ${counter}
       ${valeur_min}        Get From List     ${min_max}        0
       ${valeur_max}        Get From List     ${min_max}        1
       ${valeur_min_to_string}                Convert To String    ${valeur_min}
       ${valeur_max_to_string}                Convert To String    ${valeur_max}
       Run Keyword If       ${debug_2511} == 1       Log To Console  Compteur: ${counter}
       Run Keyword If       ${debug_2511} == 1       Log To Console  ---> Value Min: ${valeur_min} - Value Max: ${valeur_max}
       &{counter_dict}      Create Dictionary     counter=${counter}    obj=${domain}
       ...                                        min=${valeur_min_to_string}      max=${valeur_max_to_string}
       Run Keyword If       ${debug_2511} == 1       Dated Log       Checking PM with NRBTS_ID=${NRBTS_ID} and dictionary: ${counter_dict}
       ${range_status}      Run Keyword If       '${domain}' == 'NRBTS'
       ...             Verify Object Counter with ID Sum Of Values In A Range      ${log_path_pm}     ${NRBTS_ID}      &{counter_dict}
       ...             ELSE
       ...             Verify Object Counter Sum Of Values In A Range              ${log_path_pm}     &{counter_dict}
       Should Be True   '${range_status}' == 'True'
   END


# Temporary KW used for releasing a UE by using it's WTS id (does not seems to be available inside CRT KWs)
UE Detach for 2511
    [Arguments]                     ${ueSetting}=${UE_NO_PROFILE}           # Reference to UE Settings

    wtsemu.Ue Detach                         id=${ueSetting.ue}
    wtsemu.Read Wtsemu Output Until Re       expected=UE${ueSetting.ue}: detached               timeout=10


Generic KW for CSI Periodicity

   [Documentation]                 Common KW used for TCs AA_1, AA_2, AA_3, AA_4

   [Arguments]                     ${feature_activation}=${true}
   ...                             ${csi_period}=slots20
   ...                             ${threshold}=50Percent
   ...                             ${nb_ue}=6
   ...                             ${default_mcs}=5
   ...                             ${prach_ci}=96
   ...                             ${techno}=tdd
   ...                             ${dl_rate}=1
   ...                             ${ul_rate}=1
   ...                             ${duration}=2 minutes
   ...                             ${expected_csi_configuration}={slots20, slots20, slots20, slots20, slots20}

   Set CSI Configuration           feature_activated=${feature_activation}
   ...                             csi_report_period=${csi_period}
   ...                             threshold=${threshold}
   ...                             default_mcs=${default_mcs}
   ...                             prach_ci=${prach_ci}
   ...                             techno=${techno}

   # Previous SCF configuration lead to a gNB restart, but only gNB side.
   # So, wait until gNB is ready and restart TL again for AP part.
   WA Airscale Wait For Ready      ${GNB_DU}
   Restart TL

   # Configure WTS wih 10 UEs ( > max number of UEs used for 2511) and perform cellsetup.
   WTS Setup                      nbUe=10
   # Start Sherpa capture if requested
   Run Keyword If                ${enable_sherpa}==${True}               Sherpa.Activate Sherpa

   &{MY_UE}=                     Copy Dictionary          ${UE_SIMPLE}

   ${CaptureX2}                  Capture CORE Set Upon Config            airscale=${GNB_DU}
   ${CaptureX2.filter}           Get Filter For SCTP
   Capture Init                  ${CaptureX2}            withTN=True
   # Start capture on core side to get all RRC Reconfiguration messages
   Capture Start                 ${CaptureX2}

   ${nb_ue}                        Evaluate              ${nb_ue} + 1
   FOR        ${ue_id}      IN RANGE        1        ${nb_ue}
        Set To Dictionary               ${MY_UE}      ue       ${ue_id}
        Log To Console                  ${MY_UE}
        SgNB Addition to ENB            ueSetting=${MY_UE}
   END

   # Stop capture on core side
   Capture Stop                   ${CaptureX2}

   # Check CSI load periodicity inside RRC reconfiguration messages
   ${pdmlFile}=                    analyzer.pcap_to_pdml          ${CaptureX2.path}

   @{msg_field}                    Create List        nr-rrc.reportSlotConfig

   # Extract CSI report period from pdml
   @{listPacketMatch}              PacketSearch.Get Packet Match List
   ...                             pdmlFile=${pdmlFile}
   ...                             packetName=SgNBAdditionRequestAcknowledge
   ...                             pathList=@{msg_field}

   # Loop on each selected packet and check CSI period is the same as the one expected
   # Packet list is supposed to be ordered in the same way as in @{expected_csi_period}
   ${i}                            Set Variable          0
   FOR    ${packet}               IN      @{listPacketMatch}
           ${csi_period}           Get Value In Packet Match   ${packet}       field=reportSlotConfig
           Run Keyword If          '${debug_2511}'=='True'     Log To Console          CSI period read value: ${csi_period}
           ${expected_value}       Get From List   ${expected_csi_configuration}     ${i}
           Run Keyword If          '${debug_2511}'=='True'     Log To Console          Expected value: ${expected_value}
           ${raw_value}            Get From Dictionary     ${csi_report_period_converter}     ${expected_value}
           Run Keyword If          '${debug_2511}'=='True'     Log To Console          Expected raw value: ${raw_value}
           Log To Console          CSI report value inside RRC: ${csi_period}, expected value: ${raw_value}
           Should Be True          '${csi_period}' == '${raw_value}'
           ${i}                    Evaluate     ${i} + 1
   END

   # Perform 1 Mbps traffic for each UE
   ${ue_list}                     Create List
   FOR        ${ue_id}      IN RANGE        1        ${nb_ue}
           &{current_UE}=                  Copy Dictionary          ${UE_SIMPLE}
           Set To Dictionary               ${current_UE}      ue       ${ue_id}
           Append To List                  ${ue_list}    ${current_UE}
   END
   Log To Console          ${ue_list}
   # Perform DL traffic
   Traffic UEs DL          ueSettingList=${ue_list}     throughput=${dl_rate}      duration=${duration}      deviation=10
   # Perform UL trafic
   Traffic UEs UL          ueSettingList=${ue_list}     throughput=${ul_rate}      duration=${duration}      deviation=10

   # Stop Sherpa capture if it was requested
   Run Keyword If                ${enable_sherpa}==${True}               Sherpa.Deactivate Sherpa and Stop Collect

   # Detach UEs
   # FOR        ${ue_id}      IN RANGE        5
   #     Sleep                5
   #     UE Detach            ${ue_id}
   # END
