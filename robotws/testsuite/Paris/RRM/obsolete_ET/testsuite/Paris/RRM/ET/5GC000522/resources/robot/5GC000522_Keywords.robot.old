Set 256QAM Config VRAN4
    [Documentation]                 Set suitable configuration for 256QAM tests (SCF and swconfig.txt)
    # Updated SCF

    ${SCF_PATH_522_DU}              OAM Get SCF File                oam=${GNB_DU.oam}        file=SCF_Setup_522_DU.xml
    ${SCF_PATH_522_CU}              OAM Get CU SCF File             file=SCF_Setup_522_CU.xml

    Set Suite Variable              ${SCF_PATH_522_DU}
    Set Suite Variable              ${SCF_PATH_522_CU}

    SCF StartSession                scf_file=${SCF_PATH_522_DU}     second_scf_file=${SCF_PATH_522_CU}

    SCF Set element                 dist_name=${dist_name_nrbts}
    ...                             element_name=actGeneralConnectivitySilver
    ...                             element_value=true
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${dist_name_nrcell1}
    ...                             element_name=actDl256Qam
    ...                             element_value=true
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

