    OAM Set Params      ${modify_param}


gNB_Startup_Ok_with_Flags
    [Tags]  RESTART_STARTUP
    Restart.Restart TL

Cell_Setup
    [Tags]  Cell_Setup
    Sleep    5s
    CallSetup.Setup Wtsemu SA

Attach_UE_FDD_CA_Capable
    sleep    5s
    CallSetup.UE Register           ue=3

PDU_Session_UE_FDD_CA_Capable
    5GC002255_Keywords.Start Capture BIP ABIO 2slots
    CallSetup.Launch PDU Session  ue=3  pdu=3  gw=3
    sleep   2s
    ${ueSetting}        set variable    ${BASIC_UE_SA}
    ${ueSetting.pdu}    set variable    3
    ${ueSetting.ue}     set variable    3
    Traffic.Traffic UE UL    throughput=20     duration=10    ueSetting=${ueSetting}  shouldBeCheck=${False}   shouldBeStop=${False}
    Traffic.Traffic UE DL    throughput=20     duration=10    ueSetting=${ueSetting}  shouldBeCheck=${False}   shouldBeStop=${False}
    5GC002255_Keywords.Stop Capture L1L2

Get_Snapshot_gNB
    Setup.Get Snapshot

5GC002255_C_B1a_2_Scell_Activation_Without_Scheduling
    5GC002255_Keywords.Check_PsPeerCtrl_ScellUeSchedulingReqResp    ${CaptureL1L2.path}

5GC002255_C_B1c_7_Transmission_CSI_RS
    5GC002255_Keywords.Check_PsPeerCtrl_ScellPucchReceiveRespPs     ${CaptureL1L2.path}

5GC002255_C_B1e_9_Traffic_UL_DL
    5GC002255_Keywords.Check_PsPeerCtrl_ScellPuschReceiveIndPs     ${CaptureL1L2.path}

Teardown 5GC002255_C
    [Documentation]    collect Sos Report if a TC is failed or if the user need traces ForceDebugDataCollection
    Dated log                       Teardown for 5GC002255_C
    Produce Scout Data
    Run Keyword If                  ${ForceDebugDataCollection}   Get Sos Report
    [Teardown]                      GenericTest.Display diagnosis
