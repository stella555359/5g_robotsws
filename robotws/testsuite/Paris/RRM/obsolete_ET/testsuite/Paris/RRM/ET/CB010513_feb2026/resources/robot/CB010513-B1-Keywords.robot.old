## The counter M55308C1005 (PRB available for PDSCH with L1 Basebnad pooling activated) value
##
## Semi Static frame struct, with the trs tracking period =80ms, 6 beams, beamRefinement true, ss burst period=20ms, bw=100Mhz (full DL PRB=273)
##   - 12 SSB slots   :     273-64=209 PRB for PDSCH  // or 54-20-28=6 PRB for PDSCH
##   - 12 SIB  slots   :    273 PRB
##   - 2 TRS   slots    :   273 PRB, 1 muted
##   - 30 specific slots :  273 PRB
##   - 72 full DL slots  :   counted for this counter, 9 muted
## If zab cell :  in total 128
##
## Cell 1 : zab cell, BBRM allocats 273 PRB due to inter subpool pooling
##               in every 160slots : 12*209+12*273+2*273+30*273+72*273=34176
##               in 5 mins :  34176*(600000/160)=128160000
##
## Cell 2 : non zab cell, BBRM allocates 54 PRB due to inter subpool pooling
##               in every 160slots : 10 muted slots,  12*(54-48)+12*54+30*54+72*54-10*54=5796
##               in 5mins ;   5796*(600000/160)=21735000
##
## Cell 3 : non zab cell, BBRM allocates 273 PRB due to inter sub,
##               in every 160slots :  12*209+12*273+2*273+30*273+72*273=34176
##                                    10 muted slots ==> 34176-10*273=31446
##               in 5mins :   31446*(600000/160)=117922500

&{7113_UL_BB_POOL_Counter_Expected}     PM_ID=M55308C10006
...                                     CELL_1_Expected=28800000
...                                     CELL_2_Expected=28800000
...                                     CELL_3_Expected=28800000

&{PRB_AVAIL_PUSCH_LEGACY_Expected}      PM_ID=M55308C10004
...                                     CELL_1_Expected=28800000
...                                     CELL_2_Expected=28800000
...                                     CELL_3_Expected=28800000

&{PRB_AVAIL_PDSCH_LEGACY_Expected}      PM_ID=M55308C10003
...                                     CELL_1_Expected=128160000
...                                     CELL_2_Expected=117922500
...                                     CELL_3_Expected=117922500

*** Keywords ***

TC 10513 IWK ViNR with PRB Pooling
    [Arguments]            ${param}        ${vendor_custom}
    Init Sequence          ${param}
    Step                   Set RAD Params Of 10513-B
    Critical Step          CB008940-Common-Keywords.Deploy Vendor File Config  vendor_param=${vendor_custom}  is_perform_full_commissioning=${True}
    Dated Log New Line     ${vendor_custom}
    Step                   Multi Cells Setup 10513                 argument=${param.nbCell}
    Step                   CB010513-B1-Keywords.SA Call DL ViNR Traffic With UE Profile      argument=${Profile_UE_1}
    Step                   sleep    2s
    Step                   CB010513-B1-Keywords.SA Call DL ViNR Traffic With UE Profile      argument=${Profile_UE_2}
    Step                   sleep    2s
    Step                   CB010513-B1-Keywords.SA Call DL ViNR Traffic With UE Profile      argument=${Profile_UE_3}
    Step                   sleep    2s
    Step                   Activate Sherpa On All Cells
    Step                   sleep    10s
    Step                   Stop Sherpa Collection
    Step                   Calling Panda Extract Csv function
    Step                   Verification of BB Pooling Mode within PRB Pooling Allocation Report    pool_id=10
    Step                   Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4001    subpool_id=0
    Step                   Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4002    subpool_id=1
    Step                   Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4003    subpool_id=0
    Step                   Check Min and MAX PRB values
    Step                   Verification of Variable Stream PRB Information within PRB Pooling Report
    Step                   CB010513-B1-Keywords.SA DeRegister three UEs
    Step                   sleep    2s
    Step                   CB010513-B1-Keywords.SA Call DL UL ViNR Traffic With UE Profile     argument=${Profile_UE_1_ZAB_SP0}
    Step                   sleep    2s
    Step                   CB010513-B1-Keywords.SA Call DL UL ViNR Traffic With UE Profile     argument=${Profile_UE_2_ZAB_SP0}
    Step                   sleep    2s
    Step                   CB010513-B1-Keywords.SA Call DL UL ViNR Traffic With UE Profile     argument=${Profile_UE_3_ZAB_SP0}
    Step                   sleep    2s
    Step                   Activate Sherpa On All Cells
    Step                   sleep    10s
    Step                   Stop Sherpa Collection
    Step                   Verify ZAB Privilege cells
#    Step                   sleep    600s
#    Step                   Collect Lastest PM Counters File
    Step                   CB010513-B1-Keywords.Check pooling Counters
#    Step                   Check 8940 J PM Counters
#    Step                   Check 10513 B UL DL AND LEGACY PM Counters


