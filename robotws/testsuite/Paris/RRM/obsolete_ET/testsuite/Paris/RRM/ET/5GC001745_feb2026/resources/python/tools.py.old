        except Exception as e:
            rbi.log("install_multidynamic_if_neeeded(): Exception = <%s>" % str(e))


def logException(functionNameStr, e, silent=False):
    rbi.log("%s(): Exception = <%s>" % (functionNameStr, str(e)), "TRACE")
    if not silent:
        rbi.log_to_console("  %s: exception happened (see log.html)" % functionNameStr)


def decode_tti_traces_in_streaming_mode_to_remove(inputStr=""):
    # ------------------------------------------------------------------------------------------------[120 characters]
    # No need to comment, as it going to be replaced by TAF Library (see TALIB-559 for details)
    # ------------------------------------------------------------------------------------------------[120 characters]
    rbi.log_to_console("TTI Trace decoding .", no_newline=True)
    root = get_root_path()
    tti_dissectors_root = "{}/tools/tti_dissectors".format(root)
    resultDir = rbi.run_keyword("common_Dss_Keywords.Get Testcase Log Directory")
    pcapPathName = resultDir + "/ttitrace_streaming.pcap"
    rbi.log("stop_tti_traces_in_streaming_mode(): pcapPathName = %s" % pcapPathName)
    udpPathName = pcapPathName.replace(".pcap", ".udp")
    if os.path.exists(pcapPathName) and os.path.getsize(pcapPathName) > 24:
        try:
            rbi.log_to_console(".1.", no_newline=True)
            cmdStr1 = "tshark -r %s --disable-protocol swe --disable-protocol syscom -T fields -e data" % pcapPathName
            cmdStr2 = " | perl -0ne's/\\n//g;print pack\"H*\",$_' > %s" % udpPathName
            cmdStr = cmdStr1 + cmdStr2
            rbi.log("stop_tti_traces_in_streaming_mode(): cmdStr = %s" % cmdStr)
            stdoutStr = os.system(cmdStr)
            rbi.log("stop_tti_traces_in_streaming_mode(): stdoutStr = %s" % stdoutStr)
            rbi.log_to_console(".2.", no_newline=True)
        except Exception as e:
            logException("decode_tti_traces_in_streaming_mode [1]", e)
            rbi.log_to_console(".ERROR")
            return
    rbi.log("stop_tti_traces_in_streaming_mode(): udpPathName = %s" % udpPathName)
    if os.path.exists(udpPathName) and os.path.getsize(udpPathName) > 24:
        try:
            # os.system("rm %s >/dev/null 2>&1" % pcapPathName)
            rbi.log_to_console(".3.", no_newline=True)
            file_name = udpPathName
            msgFile_all = open(resultDir + "/msg_all.csv", "w")
            with open(file_name, 'rb') as file_obj:
                startTime = int(time.time())
                msgFile_all.write("-;" * 10 + "\n")
                for i, event in enumerate(TtitraceReader(multi_base_folder=tti_dissectors_root, file_obj=file_obj)):
                    if event.type != "ttiStartInd":
                        outStr = str(event.type) + ";" + repr(event.data) + "\n"
                        outStr = outStr.replace("{", "").replace("}", "").replace(" ", "")
                        outStr = outStr.replace("[", "").replace("]", "").replace("'", "")
                        outStr = outStr.replace(":", ";").replace(",", ";")
                        msgFile_all.write(outStr)
            msgFile_all.close()
            rbi.log_to_console(".4.", no_newline=True)
            os.system("zip -mj %s/ttiTrace_stream_udp.zip %s >/dev/null 2>&1" % (resultDir, udpPathName))
        except Exception as e:
            logException("decode_tti_traces_in_streaming_mode [2]", e)
            rbi.log_to_console(".ERROR")
            return
    rbi.log_to_console(".done")


def decode_tti_traces(inputStr="", event_nr_max=1000):
    # ------------------------------------------------------------------------------------------------[120 characters]
    rbi.log_to_console("TTI Trace decoding .", no_newline=True)
    resultDir = rbi.run_keyword("common_Dss_Keywords.Get Testcase Log Directory")
    pcapPathName = resultDir + "/ttitrace_streaming.pcap"
    rbi.log("decode_tti_traces(): pcapPathName = %s" % pcapPathName)
    udpPathName = pcapPathName.replace(".pcap", ".udp")
    if os.path.exists(pcapPathName) and os.path.getsize(pcapPathName) > 24:
        try:
            rbi.log_to_console(".1.", no_newline=True)
            cmdStr1 = "tshark -r %s --disable-protocol swe --disable-protocol syscom -T fields -e data" % pcapPathName
            cmdStr2 = " | perl -0ne's/\\n//g;print pack\"H*\",$_' > %s" % udpPathName
            cmdStr = cmdStr1 + cmdStr2
            rbi.log("decode_tti_traces(): cmdStr = %s" % cmdStr)
            stdoutStr = os.system(cmdStr)
            rbi.log("decode_tti_traces(): stdoutStr = %s" % stdoutStr)
            rbi.log_to_console(".2.", no_newline=True)
        except Exception as e:
            logException("decode_tti_traces [1]", e)
            rbi.log_to_console(".ERROR")
            return
    rbi.log("decode_tti_traces(): udpPathName = %s" % udpPathName)
    if os.path.exists(udpPathName) and os.path.getsize(udpPathName) > 24:
        try:
            # os.system("rm %s >/dev/null 2>&1" % pcapPathName)
            rbi.log_to_console(".3.", no_newline=True)
            file_name = udpPathName
            msgFile_all = open(resultDir + "/msg_all.csv", "w")
            with open(file_name, 'rb') as file_obj:
                startTime = int(time.time())
                msgFile_all.write("-;" * 10 + "\n")
                for i, event in enumerate(TtitraceReader(file_obj=file_obj)):
                    if i > event_nr_max:
                        break
                    if event.type != "ttiStartInd":
                        outStr = str(event.type) + ";" + repr(event.data) + "\n"
                        outStr = outStr.replace("{", "").replace("}", "").replace(" ", "")
                        outStr = outStr.replace("[", "").replace("]", "").replace("'", "")
                        outStr = outStr.replace(":", ";").replace(",", ";")
                        msgFile_all.write(outStr)
            msgFile_all.close()
            rbi.log_to_console(".4.", no_newline=True)
            os.system("zip -mj %s/ttiTrace_stream_udp.zip %s >/dev/null 2>&1" % (resultDir, udpPathName))
        except Exception as e:
            logException("decode_tti_traces [2]", e)
            rbi.log_to_console(".ERROR")
            return
    rbi.log_to_console(".done")


def verify_5GC001586_UL_MCS_NbrPrb(resultDir):
    # TTITraces Events: dlFdSchedData + csiSrReportData
    filePathName = resultDir + "/msg_all.csv"
    BuiltIn().log("verify_qc_test_case(5GC001586): filePathName = %s" % filePathName, logLevel)
    mcsList = []
    numOfPrbList = []
    averageMcs = 0
    gradiantMcs = 0
    averageNbrPrb = 0
    gradiantNbrPrb = 0
    tcResult = "failed"
    try:
        if os.path.isfile(filePathName):
            BuiltIn().log("verify_qc_test_case(5GC001586): file OK = %s " % (filePathName))
            with open(filePathName, "r") as csvFile:
                lineNumber = 0
                BuiltIn().log("verify_qc_test_case(5GC001586): open file OK = %s " % (filePathName))
                for line in csvFile:
                    # BuiltIn().log("verify_qc_test_case(5GC001586): line content = %s " % (line))
                    lineNumber += 1
                    # BuiltIn().log("verify_qc_test_case(5GC001586): line content = %s %s" % (line,lineNumber))
                    if "ulFdSchedData;" in line and "isValidWhatIsProposed;1" in line:
                        a = line.find(";rrmUlProposedMcs;") + 18
                        b = line[a:].find(";") + a
                        mcs = line[a:b]
                        # BuiltIn().log("verify_qc_test_case(5GC001586): mcs = %s (%s)" % (mcs, lineNumber))
                        try:
                            mcsList.append(int(mcs))
                        except Exception as e:
                            BuiltIn().log("verify_qc_test_case(5GC001586): MCS exit")
                            logException("verify_qc_test_case", e, True)
                        # numOfPrb;35;startPrb;4
                        a = line.find(";numOfPrb;") + 10
                        b = line[a:].find(";") + a
                        numOfPrbs = line[a:b]
                        # BuiltIn().log("verify_qc_test_case(5GC001586): numOfPrb = %s (%s)" % (numOfPrbs, lineNumber))
                        try:
                            numOfPrbList.append(int(numOfPrbs))
                        except Exception as e:
                            BuiltIn().log("verify_qc_test_case(5GC001586): numOfPrbs exit")
                            logException("verify_qc_test_case", e, True)
                    if "csiSrReportData;" in line:
                        a = line.find(";cqi;") + 5
                        b = line[a:].find(";") + a
                        cqi = line[a:b]
                        # BuiltIn().log("verify_qc_test_case(5GC001586): cqi = %s (%s)" % (cqi, lineNumber))
                        # break
            BuiltIn().log("verify_qc_test_case(5GC001586): mcsList = %s" % (mcsList))
            length = len(mcsList)
            if length > 2:
                aX = sum(mcsList)/length
                BuiltIn().log("verify_qc_test_case(5GC001586): aX = %s" % (aX))
                averageMcs = aX
                aY = (1+length)/2
                BuiltIn().log("verify_qc_test_case(5GC001586): aY = %s" % (aY))
                y, m1, m2, m = 0, 0, 0, 0
                for mcs in mcsList:
                    y += 1
                    m1 += (mcs-aX) * (y-aY)
                    m2 += (mcs-aX) * (mcs-aX)
                BuiltIn().log("verify_qc_test_case(5GC001586): m1 = %s" % (m1))
                BuiltIn().log("verify_qc_test_case(5GC001586): m2 = %s" % (m2))
                if m2 == 0:
                    m2 = 1.0
                m = m1 / m2
                BuiltIn().log("verify_qc_test_case(5GC001586): m = %s" % (m))
                gradiantMcs = m
            BuiltIn().log("verify_qc_test_case(5GC001586): numOfPrbList = %s" % (numOfPrbList))
            length = len(numOfPrbList)
            if length > 2:
                aX = sum(numOfPrbList)/length
                BuiltIn().log("verify_qc_test_case(5GC001586): numOfPrb aX = %s" % (aX))
                averagenumOfPrb = aX
                aY = (1+length)/2
                BuiltIn().log("verify_qc_test_case(5GC001586): numOfPrb aY = %s" % (aY))
                y, m1, m2, m = 0, 0, 0, 0
                for numOfPrb in numOfPrbList:
                    y += 1
                    m1 += (numOfPrb-aX) * (y-aY)
                    m2 += (numOfPrb-aX) * (numOfPrb-aX)
                BuiltIn().log("verify_qc_test_case(5GC001586): numOfPrb m1 = %s" % (m1))
                BuiltIn().log("verify_qc_test_case(5GC001586): numOfPrb m2 = %s" % (m2))
                if m2 == 0:
                    m2 = 1.0
                m = m1 / m2
                BuiltIn().log("verify_qc_test_case(5GC001586): numOfPrb m = %s" % (m))
                gradiantNbrPrb = m
        if averagenumOfPrb >= 35 and 35 in numOfPrbList and gradiantNbrPrb >= 0.0:
            tcResult = "passed"
        msg = "averageNumOfPrb=" + str(averagenumOfPrb)
        BuiltIn().log_to_console(BOLD + (GREEN if tcResult.lower() == 'passed' else RED) + msg + RESET + "",
                                 no_newline=False)
    except Exception as e:
        logException("verify_qc_test_case", e)
    return tcResult


