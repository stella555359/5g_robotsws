    return averageaggregationLevel


def _get_cell_data_rate(throughput_stats, precision=3):
    for row in throughput_stats:
        if row['Parameter'] == 'Average data rate':
            return round(float(row['Value']) / 1000000, precision)


def get_bearer_stats(ue, bearer, direction, retry=0, precision=3, alias="egate"):
    table_parser = TableParser()
    raw_throughput_string = _get_bearer_stats(ue, bearer, direction, retry, alias)
    throughput_stats = table_parser.parse_egate_table(raw_throughput_string)
    try:
        return _get_cell_data_rate(throughput_stats, precision)
    except KeyError:
        raise ThroughputException()


def _get_bearer_stats_SA(ue, pdu, qfi, direction, retry=0, alias="egate"):
    try:
        cmd = "bearer_stats ue={} pdu={} qfi={} dir={}".format(ue, pdu, qfi, direction)
    except KeyError:
        raise ThroughputException("Wrong direction and/or layer name")
    return send_cmd_with_retry_2(cmd, retry, alias)


def get_bearer_stats_SA(ue, pdu, qfi, direction, retry=0, precision=3, alias="egate"):
    table_parser = TableParser()
    raw_throughput_string = _get_bearer_stats_SA(ue, pdu, qfi, direction, retry, alias)
    throughput_stats = table_parser.parse_egate_table(raw_throughput_string)
    try:
        return _get_cell_data_rate(throughput_stats, precision)
    except KeyError:
        raise ThroughputException()


def _get_bearer_stats(ue, bearer, direction, retry=0, alias="egate"):
    try:
        cmd = "bearer_stats ue={} id={} type=l3 dir={}".format(ue, bearer, direction)
    except KeyError:
        raise ThroughputException("Wrong direction and/or layer name")
    return send_cmd_with_retry_2(cmd, retry, alias)


def send_cmd_with_retry(cmd, retry):
    raw_throughput_string = ''
    egate_interface = EgateInterface()
    for i in range(0, int(retry) + 1):
        raw_throughput_string = egate_interface.send_command_check_for_faults(cmd)
        if '===' in raw_throughput_string:
            break
        elif i == int(retry):
            raise EgateRetryException(
                'Egate was not able to find valid throughput output in {} retries:\n {}'.format(
                    retry, raw_throughput_string
                )
            )
    return raw_throughput_string


def send_cmd_with_retry_2(inputStr="", retry=0, alias="egate"):
    # ------------------------------------------------------------------------------------------------[120 characters]
    # Private Keyword: send_cmd_with_retry
    # ------------------------------------------------------------------------------------------------[120 characters]
    # BuiltIn().log_to_console(" send_cmd_with_retry_2 with %s ." % inputStr, no_newline=True)
    wtsObj = BuiltIn().get_variable_value("${wtsObj}")
    # BuiltIn().log_to_console(" send_cmd_with_retry_2 : wtsObj = %s ." % wtsObj, no_newline=True)
    try:
        result = wtsObj.execute_egate_command_and_wait_for_data(cmd=inputStr, alias=alias)
        # msg = "send_cmd_with_retry_2 : result = %s ."
        # BuiltIn().log_to_console(msg % result, no_newline=False)
        BuiltIn().sleep("3s")
        # BuiltIn().log_to_console(".done")
    except Exception as e:
        logException("send_cmd_with_retry_2", e)
        BuiltIn().log_to_console(".ERROR")
    return result


def send_cmd_with_retry_old(cmd, retry):
    raw_throughput_string = ''
    for i in range(0, int(retry) + 1):
        raw_throughput_string = egate_interface.send_command_check_for_faults(cmd)
        if '===' in raw_throughput_string:
            break
        elif i == int(retry):
            raise EgateRetryException(
                'Egate was not able to find valid throughput output in {} retries:\n {}'.format(
                    retry, raw_throughput_string
                )
            )
    return raw_throughput_string


def parse_mac_address(mac_address):
    return "0x" + mac_address.replace(":", '').split()[1]


def modify_suci_for_ue(old_suci, plmn):
    """
    Update PLMN in SUCI.
    :param old_suci: SUCI code
    :param plmn: e.g. 510:93
    :return: new SUCI code
    """
    mcc, mnc = plmn.split(":")
    old_suci_len = len(old_suci)
    old_suci = old_suci.split(":", 3)
    new_suci = "0:{}:{}:{}".format(mcc, mnc, old_suci[-1])
    if old_suci_len > len(new_suci):
        for i in range(0, old_suci_len - len(new_suci)):
            new_suci = new_suci + "0"
    elif old_suci_len < len(new_suci):
        for i in range(0, len(new_suci) - old_suci_len):
            new_suci = new_suci[0:-1]
    return new_suci
