def verify_5GC001586_J2_UL_AL_After_Reception_of_CQI_Report(resultDir, rnti_ue, rdDssUlDciAggregationThreshold=10):
    # TTITraces Events: ulFdSchedData + csiSrReportData
    filePathName = resultDir + "/msg_all.csv"
    print("verify_qc_test_case(5GC001586): filePathName = %s" % filePathName)
    aggregationLevelList = []
    cqiList = []
    averageAl = 0
    averageCqi = 0
    gradiantCqi = 0
    tcResult = "failed"
    rnti_csiSrReportData_s = 0
    try:
        if os.path.isfile(filePathName):
            with open(filePathName, "r") as csvFile:
                lineNumber = 0
                for line in csvFile:
                    lineNumber += 1
                    if "csiSrReportData;" in line:
                        a = line.find(";cqi;") + 5
                        b = line[a:].find(";") + a
                        cqi = (int)(line[a:b])
                        a = line.find(";rnti;") + 6
                        b = line[a:].find(";") + a
                        rnti_csiSrReportData = (int)(line[a:b])
                        s = "csiSrReportData : rnti_csiSrReportData = %s (%s) "
                        BuiltIn().log(s % (rnti_csiSrReportData, rnti_ue))
                        if rnti_csiSrReportData != rnti_ue:
                            BuiltIn().log("csiSrReportData : %s discarded => continue..." % rnti_csiSrReportData)
                            continue
                        BuiltIn().log("csiSrReportData : rnti %s found (%s)" % (rnti_csiSrReportData, rnti_ue))
                        rnti_csiSrReportData_s = rnti_csiSrReportData
                        cqi_csiSrReportData_s = cqi
                        try:
                            cqiList.append(int(cqi_csiSrReportData_s))
                        except Exception as e:
                            logException("verify_qc_test_case", e, True)
                        s = "verify_qc_test_case(5GC001586): cqi = %s rnti = %s (%s)"
                        BuiltIn().log(s % (cqi, rnti_csiSrReportData, lineNumber))
                    if "ulFdSchedData;" in line and "isValidWhatIsProposed;1" in line and\
                       "isDefaultMcsProposed;0" in line:
                        a = line.find(";rnti;") + 6
                        b = line[a:].find(";") + a
                        rnti2 = (int)(line[a:b])
                        if rnti2 != rnti_csiSrReportData_s:
                            BuiltIn().log("ulFdSchedData: %s discarded => continue..." % rnti2)
                            continue
                        a = line.find(";aggregationLevel;") + 18
                        # b = line[a:].find(";") + a
                        # AL is the last field
                        b = a + 1
                        aggregationLevel = line[a:b]
                        # BuiltIn().log("ligne = %s" % line)
                        s = "verify_qc_test_case(5GC001586): ulFdSchedData : aggregationLevel = %s rnti = (%s) (%s) "
                        BuiltIn().log(s % (aggregationLevel, rnti2, lineNumber))
                        try:
                            aggregationLevelList.append(int(aggregationLevel))
                        except Exception as e:
                            logException("verify_qc_test_case", e, True)
            BuiltIn().log("verify_qc_test_case(5GC001586): aggregationLevelList = %s" % (aggregationLevelList))
            BuiltIn().log("verify_qc_test_case(5GC001586): cqiList = %s" % (cqiList))
            length = len(aggregationLevelList)
            if length > 2:
                averageAl = sum(aggregationLevelList)/length
                BuiltIn().log("verify_qc_test_case(5GC001586): averageAl = %s" % (averageAl))
            length = len(cqiList)
            if length > 2:
                averageCqi = sum(cqiList)/length
                aX = averageCqi
                aY = (1+length)/2
                BuiltIn().log("verify_qc_test_case(5GC001586): aY = %s" % (aY))
                y, m1, m2, m = 0, 0, 0, 0
                for cqi in cqiList:
                    y += 1
                    m1 += (cqi-aX) * (y-aY)
                    m2 += (cqi-aX) * (cqi-aX)
                BuiltIn().log("verify_qc_test_case(5GC001586): m1 = %s" % (m1))
                BuiltIn().log("verify_qc_test_case(5GC001586): m2 = %s" % (m2))
                if m2 == 0:
                    m2 = 1.0
                m = m1 / m2
                BuiltIn().log("verify_qc_test_case(5GC001586): m = %s" % (m))
                gradiantCqi = m
                msg = "verify_qc_test_case(5GC001586): averageCqi = %s gradiantCqi=%s "
                BuiltIn().log(msg % (averageCqi, gradiantCqi))
        if ((averageCqi >= rdDssUlDciAggregationThreshold and averageAl == 2) or
           (averageCqi < rdDssUlDciAggregationThreshold and averageAl == 4)):
            tcResult = "passed"
        msg = "rnti_ue=" + str(rnti_ue)\
              + " averageAl=" + str(averageAl)\
              + " averageCqi=" + str(averageCqi)\
              + " gradiantCqi=" + str(gradiantCqi)\
              + " rdDssUlDciAggregationThreshold=" + str(rdDssUlDciAggregationThreshold)
        BuiltIn().log_to_console(BOLD + (GREEN if tcResult.lower() == 'passed' else RED) + msg + RESET + "",
                                 no_newline=False)
    except Exception as e:
        logException("verify_qc_test_case", e)
    return tcResult


def verifyFeatureActivation(resultBaseDir):
    tcResult = "failed"
    actFdmScheduling = ""
    try:
        scfObj = scf()
        scfObj.load_scf(BuiltIn().run_keyword("common_Dss_Keywords.Get Testcase Log Directory") + "/SCF.xml")
        actFdmScheduling = scfObj.get_value_from_scf(p_name="actFdmScheduling")
        BuiltIn().log("verifyFeatureActivation: actFdmScheduling = %s (SCF)" % actFdmScheduling)
        if actFdmScheduling.lower() == "true":
            tcResult = "passed"
    except Exception as e:
        logException("verifyFeatureActivation", e)
    BuiltIn().log("verifyFeatureActivation(5GC001586): tcResult = %s" % tcResult, logLevel)
    return tcResult


def verify_qc_test_case(testCaseName, repFlag="without Reporting", rnti_ue=61):
    """Keyword: Verify QC Test Case"""
    BuiltIn().log_to_console(BOLD + " Verify QC Test Case(s) of 5GC001586: " + RESET + "~" * 102 + "")
    BuiltIn().log_to_console(("  "+testCaseName+"   "+repFlag).ljust(133), no_newline=True)
    tcResult = "failed"
    # ------------------------------------------------------------------------------------------------[120 characters]
    if offlineVerification:
        resultBaseDir = offlineVerification[:offlineVerification[:-2].rfind("/")]
        resultDir = offlineVerification
    else:
        resultBaseDir = BuiltIn().run_keyword("common_Dss_Keywords.Get Testcase Log Directory")
        resultDir = BuiltIn().run_keyword("common_Dss_Keywords.Get Testcase Log Directory")
    BuiltIn().log("verify_qc_test_case(): resultBaseDir = %s" % resultBaseDir, logLevel)
    BuiltIn().log("verify_qc_test_case(): resultDir = %s" % resultDir, logLevel)
    # ------------------------------------------------------------------------------------------------[120 characters]
    if verifyFeatureActivation(resultBaseDir) == "failed":
        BuiltIn().log_to_console(BOLD + RED + "5GC001586-K/-J is NOT enabled!" + RESET + "", no_newline=True)
    if "verify_5GC001586_UL_MCS_NbrPrb" == testCaseName:
        featureList = ["5GC001586-J"]
        tcResult = verify_5GC001586_UL_MCS_NbrPrb(resultDir)
    if "verify_5GC001586_UL_MCS_StartPrb" == testCaseName:
        featureList = ["5GC001586-J"]
        tcResult = verify_5GC001586_UL_MCS_StartPrb(resultDir)
    if "verify_5GC001586_UL_AL_Based_Cqi" == testCaseName:
        featureList = ["5GC001586-J"]
        tcResult = verify_5GC001586_J2_UL_AL_After_Reception_of_CQI_Report(resultDir, rnti_ue)
    # ------------------------------------------------------------------------------------------------[120 characters]
    BuiltIn().log_to_console((GREEN if tcResult.lower() == 'passed' else RED) + tcResult + RESET + "")
    if "without" not in repFlag:
        BuiltIn().run_keyword("Online Reporting to ReP",
                              testCaseName,
                              tcResult,
                              "resultDir=%s" % resultDir,
                              "isForDebugging=%s" % ("YES" if "without" in repFlag or "ailed" in tcResult else "NO"))
    return tcResult


def set_cqi_to(inputStr=""):
    # ------------------------------------------------------------------------------------------------[120 characters]
    # Private Keyword: Set CQI to
    # ------------------------------------------------------------------------------------------------[120 characters]
    BuiltIn().log_to_console(" Set CQI to %s ." % inputStr, no_newline=True)
    ueType = BuiltIn().run_keyword("Get UE type")
    BuiltIn().log("set_cqi_to(): ueType = %s" % ueType, logLevel)
    wtsObj = BuiltIn().get_variable_value("${wtsObj}")
    try:
        if ueType.lower() == "airphone":
            if inputStr.lower() == "oscillating":
                cmdStr1 = "ue_cqi_param id=1 on=nr nr_cqi=0 nr_cqi_mode=oscillating"
                cmdStr2 = " nr_cqi_min=0 nr_cqi_max=15 nr_cqi_step=15 nr_cqi_period=2 scell=5"
                cmdStr = cmdStr1 + cmdStr2
            else:
                cmdStr = "ue_cqi_param id=1 on=nr nr_cqi=%s nr_cqi_mode=fixed scell=5" % inputStr
            wtsObj.execute_egate_command(cmd=cmdStr, alias="egate")
        else:
            BuiltIn().log("set_cqi_to(ERROR): not supported UE Type!")
            return
        BuiltIn().sleep("3s")
        BuiltIn().log_to_console(".done")
    except Exception as e:
        logException("set_cqi_to", e)
        BuiltIn().log_to_console(".ERROR")


