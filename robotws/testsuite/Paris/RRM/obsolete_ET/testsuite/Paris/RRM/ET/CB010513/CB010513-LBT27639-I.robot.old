# CB010513-I_1
[1]CB010513-I_9_ITW_CB008278_Option2b_tdLte_3ms_csiperiodicity_320slots_actExplicitCsirsPoolSolution_false
    [Documentation]
    ...     Conditions:     it is based on the configuration ${CB010513_I}
    ...     Actions:        it performs the call setup for multi-ues on different cells
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        correct searchspaceid are used in CSI/TRS slots

    CB010513_I_TC_9_bis                             param=${CB010513_I}
    ...                                             test_name=CB010513-I_9_ITW_CB008278
    ...                                             vendor_custom=${VENDOR_CUSTOM_1}
    ...                                             dict_ues=${dict_settings_all_ues}
    ...                                             is_capture=${CAPTURE_OFF}
    [Teardown]                                      Setup.Test Teardown     # must be called whether the test is OK or not: Scout data are mandatory

