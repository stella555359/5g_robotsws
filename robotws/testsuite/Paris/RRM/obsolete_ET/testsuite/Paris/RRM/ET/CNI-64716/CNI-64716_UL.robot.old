Variables         ../../../resources/SWENG/python/ReadConfig.py
Resource          robot/CNI-64716_Keywords.robot
Resource          ../../../resources/SWENG/robot/Scf.robot

# Library           resources/python/BrkPoint_KW.py

#Force Tags        CA_5G_SW_FR-Villarceaux   QCD_MN_5G   QCP_5G     RRM
Force Tags        CA_5G_SW_FR-Villarceaux   RRM
...   PY36
...               master_classicalbts_all    
...               CONFIGURED    5G_RAN    RAN_5G

Suite Setup       Setup.suite setup from scratch             #    automaticTeardown=${True}  is set in 5GC002255_Keywords.robot
Suite Teardown    Setup.Suite Teardown       reset_ap=${True}

*** Variables ***

# preset of variables for QC settings
${Startup}      FAILED
${CellSetup}    FAILED
${TestCheck}    FAILED


*** Test Cases ***

CNI_64716_Check_SINR_to_MCS_with_UL_Traffic
    [Tags]                   CRT    CLOUD_5G_I_LO_AP_LO_SANSA_FS_ECPRI_CMWV_TDD
    ...                      SBTS00    SBTS23R1    SBTS22R4	
    [Documentation]                 Carrier Aggregation 2255-1390
    Init Sequence                   _
    Step                            CNI_64716_gNB_Startup_Ok
    Step                            CNI_64716_Cell_Setup_Register_PDU
    Step                            Check_SINR_to_MCS_with_UL_Traffic

#  following TC are only for result MAPPING on QC ##    
gNB_Startup_Ok
    [Tags]                   CRT    CLOUD_5G_I_LO_AP_LO_SANSA_FS_ECPRI_CMWV_TDD
    ...                      SBTS00    SBTS23R1    SBTS22R4	
    [Documentation]   The aim of this test is to check that gNB startup is ok with the cpri link 
    ...               and RU simulators AAHF(TDD)									
    Run Keyword if    '${Startup}' == 'FAILED'    FAIL    dependencies issue

Cell_Setup_Register_PDU
    [Tags]                   CRT    CLOUD_5G_I_LO_AP_LO_SANSA_FS_ECPRI_CMWV_TDD
    ...                      SBTS00    SBTS23R1    SBTS22R4	
    [Documentation]   The aim of this test is to check that gNB cell setup Register and PDU Session are OK						
    Run Keyword if    '${CellSetup}' == 'FAILED'    FAIL    dependencies issue
    
[1][1.0] CNI-64716_2_Check_SINR_to_MCS_with_UL_Traffic
    [Tags]                   CRT    CLOUD_5G_I_LO_AP_LO_SANSA_FS_ECPRI_CMWV_TDD
    ...                      SBTS00    SBTS23R1    SBTS22R4	
    [Documentation]   The aim of this test is to check that Counter Values for MCS are correct
    Run Keyword if    '${TestCheck}' == 'FAILED'    FAIL    dependencies issue

*** Keywords ***

CNI_64716_gNB_Startup_Ok
    [Tags]  RESTART_STARTUP
    CNI-64716_Keywords.Set SCF Context
    Restart.Restart TL
    ${Startup}             set variable    PASS
    Set Suite Variable    ${Startup}

CNI_64716_Cell_Setup_Register_PDU
    [Tags]  Cell_Setup   
    #SA_keywords_2.Setup Wtsemu Environment    timeout=600
    CallSetup.Setup Wtsemu SA
    sleep   60s
    CallSetup.UE Register    ue=1
    CallSetup.Launch PDU Session    ue=1    pdu=1    gw=1    
    ${CellSetup}             set variable    PASS
    Set Suite Variable    ${CellSetup}

Check_SINR_to_MCS_with_UL_Traffic
    ${ueSetting}        set variable    ${BASIC_UE_SA}
    ${ueSetting.pdu}    set variable    1
    ${ueSetting.ue}     set variable    1
	Dated Log           Before Traffic
    Traffic.Traffic UE UL    throughput=60    ueSetting=${ueSetting}    shouldBeCheck=False    shouldBeStop=False
	Dated Log           After Traffic
	wtsemu.ul_sinr_testmode_nr    profile_id=3    sinr_target_pusch=-200    noise_pusch=-700
	wtsemu.ue_testmode_set_nr    id=1    testmode=ul_sinr    profile_id=3    action=activate
	sleep   700s
    CNI-64716_Keywords.Collect PM Counters File
    CNI-64716_Keywords.Check MCS UL Values	
    ${TestCheck}    set variable    PASS
    Set Suite Variable    ${TestCheck}

