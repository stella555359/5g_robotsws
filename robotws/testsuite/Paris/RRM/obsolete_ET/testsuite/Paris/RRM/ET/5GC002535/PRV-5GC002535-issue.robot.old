    ${output}    set variable    passed
    should contain	                ${output}	                            passed


# TC covered under New feature
# TC_02	NSA_Classical_attach_with_1_DMRS_w_FDM_PDSCH_DMRS_5Mhz_256QAM_2_2_MIMO
# TC_03	NSA_Classical_traffic_with_1_DMRS_w_FDM_PDSCH_DMRS_5Mhz_256QAM_2_2_MIMO
5GC002535_TC_01_NSA_Check_FDM_PDSCH_with_1_DMRS_5Mhz_256QAM
    [Tags]    FULL_RUN    5MHZ    2535    2535_TC1
    [Documentation]    1DMRS - 256QAM - BW=5MHZ - DL Tput - CQI=15 - sw release used [${convert_version}]
    ...                Check actDlDataDmrsFdm and actDl256Qam correclty activated in SCF
    ...                Check numCdmGroupNoData == 1  if rrmDlUsedMcs >= rdMcsIndexForDmrsFDMThreshold and numOfLayers <= 2
    [Setup]    Run Keywords     set Suite Variable    ${testCaseDir}    None     AND
    ...                         5GC002535_Keywords.Get testcase log directory    AND
    ...                         depends     TestLine_2535_5MHz_Test_setup
    Dated Log      Scf update for specific test parameters
    Set SCF 2535 Test case     ${Test5Mhz_2535_1DMRS_256QAM}
    ${tc_name}    Set variable    TestLine_2535_5MHz_Test_setup
    ${tc_status}    getTcStatusByName    name=${tc_name}
    # Run keyword if    '${tc_status}'!='PASS'
    # ...           5GC002535_Kw_TestSetup.Test Setup 2535    ${Test5Mhz_2535_1DMRS_256QAM}
    ${msg}=    Catenate    "5GC002535_TC_01_NSA_Check_FDM_PDSCH_with_1_DMRS_5Mhz_256QAM: sw release used [${convert_version}],
    ...                     BW=5MHZ - 1DMRS - 256QAM - DL Tput - CQI=15 "
    Log Test description      ${msg}
    Test case setup                                                ${Test5Mhz_2535_1DMRS_256QAM}
    TC 2535 CellSetup                                              ${Test5Mhz_2535_1DMRS_256QAM}    alias_TC1
    TC 2535-5gCall                                                 ${Test5Mhz_2535_1DMRS_256QAM}
    ${output}=    TC 2535-DLOnly and check numOfDmrsCdmGroupWithoutData          ${Test5Mhz_2535_2DMRS_256QAM}
    # ${output}    set variable    passed

    # ${resultDir}=     5GC002535_Keywords.Get Testcase Log Directory
    # ${UeList}    nps_2535_tools.get_rntis     ${resultDir}
    # ${UeId1}   set variable     @{UeList}[0]
    # Dated log     verify_5GC002535_DL_numOfDmrsCdmGroupWithoutData_Based_Mcs for Ue_RNTI ${UeId1}
    # ${output}=    nps_2535_tools.Verify QC Test Case    verify_5GC002535_DL_numOfDmrsCdmGroupWithoutData_Based_Mcs
    # ...                                                          rnti_ue=${UeId1}
    # ...                               rdMcsIndexForDmrsFDMThreshold=${Test5Mhz_2535_1DMRS_256QAM.scfFile.nrcell.dlDataDmrsFdmThres256QamMcs}
    # ${output}    set variable    passed
    should contain	                ${output}	                            passed

    [Teardown]         run keywords        GenericTest.Display diagnosis     AND
    ...                                    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureBIP.path}     AND
    ...                                    Run Keyword And Ignore Error    OperatingSystem.Copy File    ${CaptureBIP.path}    ${testCaseDir}   AND
    ...                                    Teardown 2535      ${Test5Mhz_2535_2DMRS_256QAM}     alias=alias_TC1    AND
    ...                                    set Suite Variable    ${testCaseDir}    None

