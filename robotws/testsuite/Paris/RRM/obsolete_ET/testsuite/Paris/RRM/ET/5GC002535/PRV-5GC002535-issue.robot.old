*** Keywords ***

Prepare TL for TTITraces
    [Documentation]    :
    ...    This keyword helps to download and install MULTI packages needed for TTITraces
    ...
    nps_ttitraces_tools.install_multidynamic_if_needed

Log Test description
  [Arguments]                    ${text}
    Run Keyword And Ignore Error    OperatingSystem.touch    ${testCaseDir}/TestDescription_${SUITE_NAME}_${TEST_NAME}.txt
    Run Keyword And Ignore Error    OperatingSystem.run      echo ${text} > ${testCaseDir}/TestDescription_${SUITE_NAME}_${TEST_NAME}.txt

Test case setup
    [Arguments]         ${testParam}   ${w_setSpecificXmlFile}=false    ${SpecificXmlFile}='AirphoneConfig.xml'

    # iPHY gscn update depending of chBwDl
    Dated Log      iPHY gscn update with ${testParam.scfFile.nrcell.gscn} : chBwDl=${testParam.scfFile.nrcellfdd.chBwDl}
    Set Context_AP IPHY    ${testParam}

    # default configuration is 5MHz case , nothing to do in this case
    Run Keyword If   '${testParam.seq.bandwidth}'!='5MHz'   Modify Bandwidth Parameters for WTS   ${testParam}
    ...                                                                                           w_setSpecificXmlFile=${w_setSpecificXmlFile}
    ...                                                                                           SpecificXmlFile=${SpecificXmlFile}

    # RAD param to put here if needed

    # SCF.xml is used by procedure verifyFeatureActivation
    ${test_scf_file}             OAM Get SCF File            dir=${testCaseDir}      file=SCF.xml
    Set Suite Variable              ${test_scf_file}
    Dated Log                  Current 2535 SCF file stored to ${test_scf_file}

# WA for cqi TM
# enb_endc_param id=1 serving_cell_index_range_scg=5:31
Add Scell Range To NSA
    [Arguments]                    ${alias}=default
    Log To Console    add scell range to NSA...
    wts.Execute Egate Command
    ...    cmd=enb_endc_param id=1 serving_cell_index_range_scg=5:31     alias=${alias}

# ue_cqi_param id=1 on=nr nr_cqi=8 nr_cqi_mode=fixed nr_cqi_min=1 nr_cqi_max=15 nr_cqi_step=1 nr_cqi_period=10 scell=5
NSA UE Testmode Cqi param
    [Arguments]    ${UeId}    ${nr_cqi}    ${nr_cqi_mode}    ${nr_cqi_period}       ${alias}=default
    [Documentation]    This keyword is used to set UE CQI Testmode after NSA L3 Call on eGate.
    ...    | Input Parameters | Man. | Description |
    ...    | nr_cqi | Yes | cqi |
    ...    | nr_cqi_mode | Yes | cqi mode |
    ...    | nr_cqi_period | Yes | cqi period |
    ...    Example:
    ...    | NSA UE Testmode CQI param | 8 | fixed | 10
    Log To Console    add UE testmode Cqi param...
    ${cmd}    Catenate    ue_cqi_param id=${UeId} on=nr nr_cqi=${nr_cqi} nr_cqi_mode=${nr_cqi_mode} nr_cqi_min=1 nr_cqi_max=15
    ...                        nr_cqi_step=1 nr_cqi_period=${nr_cqi_period} scell=5
    ${output}    wts.Execute Egate Command    cmd=${cmd}       alias=${alias}
    Should Not Contain    ${output}    UE may be OFF or killed
    Dated log        ${cmd}
    Log To Console    set_UE_CQI_Testmode_is_ok

NSA UE Testmode NR Profile
    [Arguments]    ${ul_sinr_profile_index}    ${sinr_target_srs}    ${sinr_target_pusch}    ${sinr_target_pucch}    ${sinr_target_preamble}
    [Documentation]    This keyword is used to set UE Testmode after NSA L3 Call on eGate.
    ...    | Input Parameters | Man. | Description |
    ...    | ul_sinr_profile_index | Yes | ulsinr profile index |
    ...    | sinr_target_srs | Yes | sinr_target_srs |
    ...    | sinr_target_pusch | Yes | sinr_target_pusch |
    ...    | sinr_target_pucch | Yes | sinr_target_pucch |
    ...    | sinr_target_preamble | Yes | sinr_target_preamble |
    ...    Example:
    ...    | NSA UE Testmode NR Profile | 1 | 100 | 100 | 100 | 100 |
    Log To Console    add UE testmode NR profile...
    ${cmd}    Catenate    ul_sinr_testmode_nr profile_id=${ul_sinr_profile_index} sinr_target_srs=${sinr_target_srs}
    ...    sinr_target_pusch=${sinr_target_pusch} sinr_target_pucch=${sinr_target_pucch} sinr_target_preamble=${sinr_target_preamble}
    ${output}    wts.Execute Egate Command    cmd=${cmd}
    Should Not Contain    ${output}    UE may be OFF or killed
    Log To Console    set_UE_Testmode_is_ok

TC CellSetup
    [Documentation]                Generic test for 2535: test purpose is to setup X2
    [Arguments]                    ${param}     ${alias}=default
    Init Sequence                  ${param}
    5GC002535_Keywords.Start WTS         egate_alias=${alias}    shouldUseLua=${True}   nbUe=2
    Step                           5GC002535_Keywords.X2Ap link Setup     argument=${alias}            depends=5GC002535_Keywords.Start WTS
    Critical Step                  5GC002535_Ue_command.Verify AP Classical Cell Setup
    [Teardown]               GenericTest.Display diagnosis

Save swconfig file used
  [Arguments]                    ${testParam}
    # Get swconfig file that will be used during 1586 tests
    ${alias_gnb}                    SSH Wait For Connect                ${GNB_DU.sys[0].M}
    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${LOG_PATH}/swconfig_used_for_2535_${testParam.seq.bandwidth}_Tests.txt
    ...                             connection=${alias_gnb}
    Run Keyword And Ignore Error  OperatingSystem.Move File  ${LOG_PATH}/swconfig_used_for_2535_${testParam.seq.bandwidth}_Test.txt  ${testCaseDir}
    Dated Log                  Current 2535 swconfig file stored to ${testCaseDir}/swconfig_used_for_2535_${testParam.seq.bandwidth}_Test.txt
    # Save current SCF file used during test cases
    ${current_scf_file}             OAM Get SCF File            dir=${testCaseDir}     file=SCF_used_for_2535_${testParam.seq.bandwidth}_Test.xml
    Set Suite Variable              ${current_scf_file}
    Dated Log                  Current 2535 SCF file stored to ${current_scf_file}

TC 2535 Stop Dl Traffic on 2 Ues
    [Documentation]                Test purpose is to stop dl traffic
    [Arguments]                    ${param}
    Init Sequence                  ${param}

    Traffic Stop                    ueSetting=${UE_PROFILE1}      dir=dl
    Traffic Stop                    ueSetting=${UE_PROFILE2}      dir=dl
#     [Teardown]           GenericTest.Display diagnosis

Stop and collect all needed traces
   [Arguments]       ${testParam}       ${w_snapshot}=true      ${w_pcap}=true    ${w_Trace}=true    ${w_stopTraffic}=true
    run Keyword if    '${w_stopTraffic}' == 'true'      run Keywords      Dated Log     Stop DL Traffic on 2 Ues...      AND
    ...                                                                   TC 2535 Stop Dl Traffic on 2 Ues     ${testParam}
    run Keyword if    '${w_Trace}' == 'true'      run Keywords       Dated log         Stop TTI Traces in Streaming Mode...   AND
    ...                                                              ttitrace.Stop TTI Traces in Streaming Mode     tti_trace_path=${testCaseDir}
    run Keyword if    '${w_pcap}' == 'true'    run Keywords       Dated Log         Stop capture for 2535...     AND
    ...             Capture Stop     ${CAPTURE_L1L2_GNB_FS_2535}      AND
    ...             Run Keyword And Ignore Error     OperatingSystem.File Should Exist   ${CAPTURE_L1L2_GNB_FS_2535.path}     AND
    ...             Run Keyword And Ignore Error     OperatingSystem.Move File   ${CAPTURE_L1L2_GNB_FS_2535.path}  ${testCaseDir}
    ${msg}=   run Keyword if    '${w_pcap}' == 'true'
    ...                   Catenate       pcap file ${CAPTURE_L1L2_GNB_FS_2535.path} generated and copied into ${testCaseDir}
    ...                   ELSE     set Variable    None
    run Keyword if    '${w_pcap}' == 'true'         Dated Log     ${msg}
    run Keyword if    '${w_Trace}' == 'true'      run Keywords      Dated log         Decode TTI Traces...      AND
    ...                                           nps_2535_tools.Decode TTI Traces in Streaming Mode    desired_storage_directory=${testCaseDir}
    run Keyword if    '${w_snapshot}' == 'true'    Dated Log New Line         Get gNB snapshot...
    ${snapshot_path}=      run Keyword if    '${w_snapshot}' == 'true'        5GC002535_Keywords.Get GNB Logs from Coam
    run Keyword if    '${w_snapshot}' == 'true'    run Keywords
    ...                                       Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${snapshot_path}   AND
    ...                                       Run Keyword And Ignore Error    OperatingSystem.Move File    ${snapshot_path}    ${testCaseDir}   AND
    ...                                       Dated Log     gNB snapshot ${snapshot_path} generated and copied into ${testCaseDir}
    Save swconfig file used       ${testParam}

dss_call_2Ue_w_cqi_diff
    [Arguments]                    ${testParam}     ${w_stopTraffic}=true    ${w_Trace}=true     ${alias}=default
    Init Sequence                  ${testParam}
    5GC002535_Keywords.Restart     OwnTLReset=${true}
    run Keyword if    '${w_Trace}' == 'true'      run Keywords      Dated Log         Start Bip and BH capture for 2535...   AND
    ...                                                             Start capture for 2535        BH_L1L2_BIP_CELLSETUP_ATTACH_2Ues
    Dated Log         5g Cellsetup...
    TC CellSetup             ${testParam}   alias=${alias}
    Dated log         5g Call and DL Traffic with 2Ues
    UE Attach Enb                   ueSetting=${UE_PROFILE1}
    Add Scell Range To NSA        alias=${alias}
    UE Attach Gnb                   ueSetting=${UE_PROFILE1}
    # Critical Step     CallSetup.UE Attach Check
    NSA UE Testmode Cqi param   UeId=1   nr_cqi=8    nr_cqi_mode=fixed    nr_cqi_period=10     alias=${alias}
    run Keyword if    '${w_Trace}' == 'true'      run Keywords       Dated Log         Start TTI Traces in Streaming Mode     AND
    ...                                                              ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traffic UE DL  ueSetting=${UE_PROFILE1}  throughput=${param.seq.dl_throughput}
    ...             duration=1  shouldBeStop=False  shouldBeCheck=False  deviation=15
    # NSA UE Testmode Cqi param   UeId=1   nr_cqi=8    nr_cqi_mode=fixed    nr_cqi_period=10     alias=${alias}
    UE Attach Enb                   ueSetting=${UE_PROFILE2}
    UE Attach Gnb                   ueSetting=${UE_PROFILE2}
    # Critical Step     CallSetup.UE Attach Check
    Traffic UE DL  ueSetting=${UE_PROFILE2}  throughput=${param.seq.dl_throughput}
    ...             duration=${param.seq.timeDuration}  shouldBeStop=False  shouldBeCheck=False  deviation=15
    # ${param.seq.timeDuration} au lieu de 10s
    [Teardown]    Stop and collect all needed traces     ${testParam}
    ...                                                  w_snapshot=false
    ...                                                  w_pcap=${w_Trace}
    ...                                                  w_Trace=${w_Trace}
    ...                                                  w_stopTraffic=${w_stopTraffic}

Check BTS status in WEM for cOAM
    [Documentation]   This keyword is used to Check BTS status in WEM for cOAM.
    ...    author: Ch SAMSON
    [Arguments]     ${cell_id}=0
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=    coam.get_bts_statuses    timeout=30    connection=${GNB_DU.oam.httpAlias}
    Dated log      =======> Current bts status is ${bts_status}
    should be equal    ${bts_status['operationalState']}     Enabled         ignore_case=true
    should be equal    ${bts_status['proceduralState']}       OnAir       msg=ENB is not on air, Current status is ${bts_status}  ignore_case=true
    should be equal    ${bts_status['blockingState']}       Unblocked            ignore_case=true

    ${cell_info}=    coam.get_cells_info    cell_type=nr    timeout=30    connection=${GNB_DU.oam.httpAlias}
    Dated log      =======> Current cell(s) info is ${cell_info}
    FOR    ${elem}    IN    @{cell_info}
#    ${cell_info}=    set variable   ${cell_info[${cell_id}]['status']}
        Should be equal    ${elem['status']['operationalState']}    Enabled    ignore_case=true
        Should be equal    ${elem['status']['proceduralStatus']}    configured    ignore_case=true
        Should be equal    ${elem['status']['administrativeState']}    Unlocked    ignore_case=true
    END

    OAM Disconnect                  ${GNB_DU.oam}

Restart TL wo WTS clear
    [Documentation]                 Entry point for the restart of a TL, Classical only , without WTS clear
    [Arguments]                     ${GNBCallback}=None                     ${APCallback}=None
    ...                             ${isOAMRebooted}=False
    Dated Log                       Start Restart TL ${TLConfig.configName}. Is GNB Cloud: ${TLConfig.isGnbCloud}
    ...                             first=True
    Private Restart Gnb Classical           GNBCallback=${GNBCallback}          APCallback=${APCallback}
    ...                             isOAMRebooted=${isOAMRebooted}


reset TL if BTS not OnAir
    [Arguments]  ${connection}=${GNB_DU.oam}
    ${aliasGNB}                     OAM Connect                             ${connection}
    ${bts_status}=  coam.get_bts_statuses   connection=${connection.httpAlias}
    OAM Disconnect                  ${GNB_DU.oam}
    Dated log     BTS procedural state is now: ${bts_status["proceduralState"]}
    Run Keyword If  '${bts_status["proceduralState"]}'!='OnAir' and '${bts_status["proceduralState"]}'!='Configured'
    ...          Run Keywords       Log To Console  \n BTS procedural state is now: ${bts_status["proceduralState"]} ==> Reset TL     AND
    ...                             Restart TL wo WTS clear     AND
    # ...                             run keyword and ignore error        5GC002535_Kw_TestSetup.Upload 2535 Configuration          AND
    ...                             run keyword and ignore error        5GC002535_Keywords.Start WTS        egate_alias_default   AND
    ...                             run keyword and ignore error        5GC002535_Keywords.X2Ap link Setup     egate_alias_default


Get gNB cell 5g On air
    [Documentation]       get gNB 5g cell On air
    Return From Keyword If    "${WAIT_5G_CELL_ONAIR}" == "0"
    Log to Console like Next Step     0     Get gNB 5g cell OnAir
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=  coam.get_bts_statuses   connection=${GNB_DU.oam.httpAlias}
    OAM Disconnect                  ${GNB_DU.oam}
    Log To Console  \n BTS procedural state is now: ${bts_status["proceduralState"]}
    Return From Keyword If    '${bts_status["proceduralState"]}'=='OnAir' or '${bts_status["proceduralState"]}'=='Configured'
    # run keyword and ignore error        5GC002535_Kw_TestSetup.Upload 2535 Configuration
    run keyword and ignore error        5GC002535_Keywords.Start WTS        egate_alias_default
    run keyword and ignore error        5GC002535_Keywords.X2Ap link Setup     egate_alias_default
    run keyword and ignore error        wait until keyword succeeds    2min    30s      Check BTS status in WEM for cOAM
    Dated log new line         =======> Restart TL if needed to get Cell Is OnAir/Configured
    run keyword and ignore error        reset TL if BTS not OnAir
    run keyword and ignore error        wait until keyword succeeds    5min    30s      Check BTS status in WEM for cOAM



