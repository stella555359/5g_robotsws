*** Settings ***
# https://confluence.ext.net.nokia.com/pages/viewpage.action?spaceKey=5GFTPARIS&title=ET+Coding+Rules
# --------------------------------------------------------------------------------------------------------------------------------------------------
Documentation     [SUITE PURPOSE]
...                  == CB011028-D Test suite ==
...                  - The aim is to check IWK between PRB pooling and RIM Framework-0 configured on all cells.
...                  - RIM configuration is the same on all cells.
...                  - The test verify behavior of BWP configurations with PRB Pooling scenarios when RACH is not present in the
...                    Power saving BWP.
...                  - UEs supporting PS-BWP are configured with PS-BWP without RACH config.
...                  == Prerequisite ==
...                  - gNB configured with 4 Cells & RU detected. Physical cells id are 50, 51, etc.
...                  == Scope ==
...                  - call setup - nGBR traffic several Ues
...                  == Info ==
...                  - Test Case Scenario author   : christophe.samson@nokia.com
...                  - Creation Date               : 09-12-2023
...                  - Modified Date               : 09-12-2023
...                  - Last Modified by            : christophe.samson@nokia.com
...                  - Version   Date          Author                                   Notes
...                  - 0.1       09-12-2023    christophe.samson@nokia.com              Creation
# --------------------------------------------------------------------------------------------------------------------------------------------------

# Libraries
Library      taf.transport.ssh                                   WITH NAME          ssh
Library      taf.sbts.oam.coam.admin.interface
Library      taf.sbts.oam.coam.admin                             WITH NAME          coam
Library      taf.collectors.tcpdump                              WITH NAME          tcpdump
Library      taf.collectors.core                                 WITH NAME          core
Library      ute_wtssim
Library      taf.config.wts                                      WITH NAME          wts

# Libraries SWENG
Library         ../../../resources/SWENG/python/StringTool.py

# Libraries CB011028
Library      resources/python/Constants-CB011028-D.py            WITH NAME          MyConstants

# Resources CB011028
Resource     ./resources/robot/CB011028-Common-Keywords.robot
Resource     ./resources/robot/CB011028-D-Keywords.robot
Resource     ./resources/robot/CB011028-D-Test-Template-Keywords.robot

Variables    ./resources/python/Constants-CB011028-D.py

# Suites and Tests setup and teardown
Suite Setup       Suite Setup CB011028-D-Common
...                    test_dictParam=${dictParam}
# ...                    yamlPathname=${CURDIR}/../../../../../custom-config/${feature path}${custom_config_file}
...               yamlPathname=${CURDIR}/../../../../../custom-config/${feature path ASOE}${custom_config_file_ASOE}
Suite Teardown    Suite Teardown CB011028-D-Common
Test Setup        Test Setup for CB011028-Common
Test Teardown     Test Teardown for CB011028-Common

*** Variables ***

# for ABIP
${feature path}                          POOLING/CB009890/CLOUD_5G_I_MP_AP_LOOO_SANSA_FS_ECPRI_CMWV_TDD_3Cells/
${custom_config_file}                    config_ABIP_DL_CL_MIMO_4x4_3Cells_AP_3ABIO_FeatA_MIMO_DL.yaml

# for ASOE
${feature path ASOE}                     POOLING/CB011028/CLOUD_5G_O_E_AP_LO_SANSA_FS_ECPRI_CMWV_TDD_4Cells/
# ${custom_config_file_ASOE}               config_ASOE_DL_CL_MIMO_8x8_4Cells_BeamSet_6_AP_2ABIO.yaml
${custom_config_file_ASOE}               config_ASOE_DL_CL_MIMO_8x8_4Cells_BeamSet_6_AP_2ABIO_woBSR.yaml

${relative_json_path}                                               ${CURDIR}/CB011028_D_data_tests.json

${TestSharkTool}                                                    MC_SHARK

&{dictParam}                                                        w_Basic_Call_to_Setup_Wtsemu=${True}
...                                                                 w_enable_sherpa_Traces=True
...                                                                 w_check_9890_using_sherpa=False
...                                                                 w_GetTtiTrace=True
...                                                                 w_convert_TtiPcap_to_excelCsv=False
...                                                                 w_GetL1L2Bip=False
...                                                                 w_generic_capture=True
...                                                                 w_CaptureCORE=${False}
...                                                                 w_CaptureL1L2=${False}
...                                                                 w_CaptureCPRT=${True}
...                                                                 w_ue_detach=False
...                                                                 w_GetBtsLog=True
...                                                                 w_DISPLAY_ue_stats_nr_15min=False

# capture Time setting
&{CAPTURE}                                                          GetTtiTraceTime=1s
...                                                                 Getl1l2TraceTime=1s
...                                                                 GetSherpaTraceTime=1s
...                                                                 GetTtiTraceNumOfEvent=5000

&{dictExpectedValues}                                               expected_avg_total_prbs_spool1=546
