                and
                resourceList contains (10, 11)
                and
                maxPayloadSize eq 8
            )
            and
            resourceSetToAddModList contains
            (
                pucch-ResourceSetId eq 2
                and
                length(resourceList) eq 2
                and
                resourceList  contains (9, 20)
            )
            and
            format3 contains
            (
                maxCodeRate eq "zeroDot15"
            )
        )
    )
    """

