import testsuite.Paris.RRM.ET.resources_KRK.python.pm_counters as pm_counters
from robot.libraries.BuiltIn import BuiltIn
from testsuite.Paris.RRM.ET.resources_KRK.python.utilities import *


def wait_for_next_pm_period_to_start(delay=30):
    return pm_counters.wait_for_next_pm_period(int(BuiltIn().get_variable_value("${PM_PERIOD}")), delay=delay)


def verify_counters_for_mu_mimo_2_ues():
    output_dir = BuiltIn().get_variable_value("${OUTPUT_DIR}")
    test_prefix = BuiltIn().get_variable_value("${TEST_PREFIX}")
    ACC_SCHED_UE_PDSCH = "M55308C17001"
    DL_DATA_SLOTS = "M55308C00001"
    counters_list = [ACC_SCHED_UE_PDSCH, DL_DATA_SLOTS]
    counters_data = pm_counters.get_pm_counters_values(counter_ids_list=counters_list,
                                                       csv_filepath=os.path.join(output_dir, test_prefix, "counters"))
    values = pm_counters.get_latest_values_for_specified_counters(counters_list, path_filters="NRCELL-1",
                                                                  counters_data=counters_data)
    error_msg = """Accumulated number of scheduled slots is not right for 2 UEs: ACC_SCHED_UE_PDSCH: {},
    DL_DATA_SLOTS: {}"""
    acc_sched_val = values[ACC_SCHED_UE_PDSCH]
    dl_data_val = values[DL_DATA_SLOTS]
    assert round(float(acc_sched_val)/float(dl_data_val)) == 2, error_msg.format(acc_sched_val, dl_data_val)
