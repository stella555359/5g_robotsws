# TC covered under New feature
# TC_06	NSA_Classical_attach_traffic_with_2_DMRS_w_FDM_PDSCH_DMRS_5Mhz_256QAM_2_2_MIMO
[1][1.0] 5GC002535_TC_02_5GC002535_TC_02_NSA_Check_FDM_PDSCH_with_2_DMRS_5Mhz_256QAM
    [Tags]    FULL_RUN    5MHZ    2535    2535_TC2     CRT    CDRT
    [Documentation]    2DMRS - 256QAM - BW=5MHZ - DL Tput - CQI=15 - sw release used [${convert_version}]
    ...                Check actDlDataDmrsFdm and actDl256Qam correclty activated in SCF
    ...                Check numCdmGroupNoData == 1  if rrmDlUsedMcs >= rdMcsIndexForDmrsFDMThreshold and numOfLayers <= 2
    [Setup]    Run Keywords     set Suite Variable    ${testCaseDir}    None     AND
    ...                         update Get Mem Usage Variable                    AND
    ...                         5GC002535_Keywords.Get testcase log directory    AND
    ...                         5GC002535_Keywords.Prepare Test Name             AND
    ...                         5GC002535_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp     AND
    ...                         depends     TestLine_2535_5MHz_Test_setup
    ${tc_name}    Set variable    TestLine_preparation
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'
    ...           5GC002535_Kw_TestSetup.Test Line Preparation    ${Test5Mhz_2535_1DMRS_256QAM}
    Dated Log      Scf update for specific test parameters
    Set SCF 2535 Test case for AiC and Classical     ${Test5Mhz_2535_2DMRS_256QAM}
    ${tc_name}    Set variable    TestLine_2535_5MHz_Test_setup
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'
    ...           5GC002535_Kw_TestSetup.Test Setup 2535    ${Test5Mhz_2535_2DMRS_256QAM}
    # Update nrCellType into Context for CellId=1
    Update nrCellType into "${Test5Mhz_2535_2DMRS_256QAM}" for cellID "1"
    # depend on SHOULD_UPDATE_DEBUG_L2PS_RAD variable
    ${l2ps_debug_swconfig_gnb}=      Set 2535 L2PS Debug Specific RAD    ${Test5Mhz_2535_2DMRS_256QAM}
    Update gNB Swconfig New     ${l2ps_debug_swconfig_gnb}
    ${msg}=    Catenate    "5GC002535_TC_02_NSA_Check_FDM_PDSCH_with_2_DMRS_5Mhz_256QAM: sw release used [${convert_version}],
    ...                     BW=5MHZ - 2DMRS - 256QAM - DL Tput - CQI=15 - ${current_sw_version_for_lua_gNB} "
    Log Test description      ${msg}
    robot_extension.Run Keyword And Warn On Failure    btslog.Start Btslog
    Test case setup                                                      ${Test5Mhz_2535_2DMRS_256QAM}
    TC 2535 CellSetup                                                    ${Test5Mhz_2535_2DMRS_256QAM}
    TC 2535-5gCall                                                       ${Test5Mhz_2535_2DMRS_256QAM}
    ${output}=    TC 2535-DLOnly and check numOfDmrsCdmGroupWithoutData                ${Test5Mhz_2535_2DMRS_256QAM}
    robot_extension.Run Keyword And Warn On Failure    btslog.Stop Btslog
    should contain	                ${output}	                            passed
    [Teardown]      run keywords      Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureBIP.path}     AND
    ...                               Run Keyword And Ignore Error    OperatingSystem.Copy File    ${CaptureBIP.path}    ${testCaseDir}   AND
    ...                               5GC002535_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
    ...                               Run Keyword And Ignore Error     btslog.Stop Btslog      AND
    ...                               Teardown 2535      ${Test5Mhz_2535_2DMRS_256QAM}    alias=default   AND
    ...                               set Suite Variable    ${testCaseDir}    None


