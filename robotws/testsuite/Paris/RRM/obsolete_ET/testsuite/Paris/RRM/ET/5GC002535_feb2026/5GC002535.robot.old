[1][1.0] 5GC002535_TC_07_5GC002535_TC_07_NSA_DMRS_Auto_MUE_diff_CQI_15Mhz_256QAM_ORAN
    [Tags]    FULL_RUN    15MHZ    2535   2535_TC7    CRT
    [Documentation]    DMRS Auto - 256QAM - BW=15MHZ - DL Tput - Diff CQI - sw release used [${convert_version}]
    ...                Check actDlDataDmrsFdm and actDl256Qam correclty activated in SCF
    ...                Check numCdmGroupNoData == 1  if rrmDlUsedMcs >= rdMcsIndexForDmrsFDMThreshold and numOfLayers <= 2
    ...                2Ues (Ue1 Cqi=8 and Ue2 Cqi=15)
    [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None     AND
    ...                       5GC002535_Keywords.Get testcase log directory    AND
    ...                       5GC002535_Keywords.Prepare Test Name             AND
    ...                       5GC002535_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp     AND
    ...                       depends     TestLine_2535_15MHz_Test_setup
    ${tc_name}    Set variable    TestLine_preparation
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'
    ...           5GC002535_Kw_TestSetup.Test Line Preparation    ${Test15Mhz_2535_DMRS_auto_256QAM_OR}
    Dated Log      Scf update for specific test parameters
    Set SCF 2535 Test case for AiC and Classical     ${Test15Mhz_2535_DMRS_auto_256QAM_OR}
    ${tc_name}    Set variable    TestLine_2535_15MHz_Test_setup
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'
    ...           5GC002535_Kw_TestSetup.Test Setup 2535    ${Test15Mhz_2535_DMRS_auto_256QAM_OR}
    ${msg}=    Catenate     "5GC002535_TC_07_NSA_MUE_diff_CQI_15Mhz: sw release used [${convert_version}], "
    ...                     " DMRS Auto - 256QAM - BW=15MHZ - DL Tput - Diff CQI "
    ...                     " Ue1 Cqi=8 , Ue2 Cqi=15 - ${current_sw_version_for_lua_gNB} "
    ...                     " dlDataDmrsFdmThres256QamMcs=${Test15Mhz_2535_DMRS_auto_256QAM.scfFile.nrcell.dlDataDmrsFdmThres256QamMcs} "
    Log Test description  ${msg}
    # Need specific AP xml file wo TM to use  correclty CQI TM
    robot_extension.Run Keyword And Warn On Failure    btslog.Start Btslog
    Test case setup     ${Test15Mhz_2535_DMRS_auto_256QAM_OR}   w_setSpecificXmlFile=false
    dss_call_2Ue_w_cqi_diff   ${Test15Mhz_2535_DMRS_auto_256QAM_OR}   alias=TC7_2535_15MHZ
    robot_extension.Run Keyword And Warn On Failure    btslog.Stop Btslog
    ${resultDir}=     5GC002535_Keywords.Get Testcase Log Directory
    ${UeList}    nps_2535_tools.get_rntis     ${resultDir}
    ${UeId1}   set variable     ${UeList}[0]
    ${UeId2}   set variable     ${UeList}[1]
    Dated log     verify_5GC002535_numOfDmrsCdmGroupWithoutData_Based_MCS for ${UeId1} and ${UeId2}
    ${output}=    5GC002535_tools.Verify QC Test Case    verify_5GC002535_DL_numOfDmrsCdmGroupWithoutData_Based_Mcs
    ...                                                          rnti_ue=${UeId2}
    ...                                 rdMcsIndexForDmrsFDMThreshold=${Test15Mhz_2535_DMRS_auto_256QAM.scfFile.nrcell.dlDataDmrsFdmThres256QamMcs}
    ...                                 method="Expand array item Field"
    should contain	                ${output}	                            passed
    ${output}=    5GC002535_tools.Verify QC Test Case    verify_5GC002535_DL_numOfDmrsCdmGroupWithoutData_Based_Mcs
    ...                                                          rnti_ue=${UeId1}
    ...                                 rdMcsIndexForDmrsFDMThreshold=${Test15Mhz_2535_DMRS_auto_256QAM.scfFile.nrcell.dlDataDmrsFdmThres256QamMcs}
    ...                                 method="Expand array item Field"
    should contain	                ${output}	                            passed
    [Teardown]    run keywords      5GC002535_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
    ...                             Run Keyword And Ignore Error     btslog.Stop Btslog     AND
    ...                             Teardown 2535      ${Test15Mhz_2535_DMRS_auto_256QAM_OR}    TC7_2535_15MHZ

