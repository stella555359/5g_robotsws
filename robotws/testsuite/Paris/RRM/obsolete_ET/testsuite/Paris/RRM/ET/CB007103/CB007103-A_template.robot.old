*** Settings ***
Documentation      [SUITE PURPOSE]  Template of Test cases CB007103 feature
...                Test Case Scenario author   : anne.enyih@nokia.com
...                Test Case Scenario author   : francois.tourlonnias@nokia.com
...
...                This Template need your attention on following part of this common database
...                Please modify as you need data value between # Modification block / # END Modification block

Resource           ./resources/robot/CB007103_keywords_common.robot
Variables          ./resources/python/Constants.py

Suite Setup        CB007103_keywords_common.Suite Setup 7103
Suite Teardown     CB007103_keywords_common.Suite Teardown 7103
Test Teardown      kwmkt_Test Teardown

*** Variables ***
${recursion_limit}   1000   # 1000 is the default value
${NL}                Nested_List

${expected_PuschDmrsSeqType}    0    # either 0/TYPE_1 or 1/TYPE_2

&{A1}
...     Scfdetails=${ScfComposition}
...     Feat7103niddSpecific=${FeatureParameterSheet}
...     ListOfUeEngaged=${uelist}
...     rad_param=${radList}
...     PMdod=testsuite/Paris/RRM/ET/CB007103/resources/config/PM/CB007103_Constraints_template.csv
...     GetTtiTraceTime=80ms
...     dod=${AcceptanceCriteriaL1L2}

# Modification block ==================================================================================================
# Cells important for the test check SIB arrival only on following cell
@{CellList}          1    2

# SCF delivery  ====== This part help to dertemine how iso level need to be done ======================================
&{ScfComposition}
...     BeamForming=True
...		ULCloseLoopPowerControl=True
...		UlDftSOfdm=True

#SCF parameters of the test ===========================================================================================
@{FeatureParameterSheet}
...         ${actRel16DmrsForPucchF3_C1}       ${actRel16DmrsForPusch_C1}      ${pucchF3Rel16Pi2BpskAlwaysOn_C1}    ${pucchF3ModulationScheme_C1}
...         ${miNrUlSignalQuality2}            ${miNrResourceUtilizationPerCell}      ${miNrUlHarqOne}
...         ${actRel16DmrsForPucchF3_C2}       ${actRel16DmrsForPusch_C2}      ${pucchF3Rel16Pi2BpskAlwaysOn_C2}
...         ${pucchF3ModulationScheme_C2}      ${clpcPucchTargetSinr}          ${clpcPucchtIntervalSinrUpd}
...         ${ulTransPrePi2BpskPwrBoost_C1}    ${ulTransPrePi2BpskPwrBoost_C2}

&{miNrUlSignalQuality2}              dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1    param=miNrUlSignalQuality2           value=5min
&{miNrResourceUtilizationPerCell}    dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1    param=miNrResourceUtilizationPerCell    value=5min
&{miNrUlHarqOne}                     dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1    param=miNrUlHarqOne                  value=5min
&{actRel16DmrsForPucchF3_C1}         dist_name=MRBTS-1/NRBTS-1/NRCELL-1     param=actRel16DmrsForPucchF3         value=false
&{actRel16DmrsForPusch_C1}           dist_name=MRBTS-1/NRBTS-1/NRCELL-1     param=actRel16DmrsForPusch           value=false
&{pucchF3Rel16Pi2BpskAlwaysOn_C1}    dist_name=MRBTS-1/NRBTS-1/NRCELL-1     param=pucchF3Rel16Pi2BpskAlwaysOn    value=false
&{pucchF3ModulationScheme_C1}        dist_name=MRBTS-1/NRBTS-1/NRCELL-1     param=pucchF3ModulationScheme        value=qpsk_4psk
&{actRel16DmrsForPucchF3_C2}         dist_name=MRBTS-1/NRBTS-1/NRCELL-2     param=actRel16DmrsForPucchF3         value=false     #7103 unactif
&{actRel16DmrsForPusch_C2}           dist_name=MRBTS-1/NRBTS-1/NRCELL-2     param=actRel16DmrsForPusch           value=false     #7103 unactif
&{pucchF3Rel16Pi2BpskAlwaysOn_C2}    dist_name=MRBTS-1/NRBTS-1/NRCELL-2     param=pucchF3Rel16Pi2BpskAlwaysOn    value=false
&{pucchF3ModulationScheme_C2}        dist_name=MRBTS-1/NRBTS-1/NRCELL-2     param=pucchF3ModulationScheme        value=qpsk_4psk
&{clpcPucchTargetSinr}               dist_name=MRBTS-1/NRBTS-1/NRULCLPC_PROFILE-0     list_name=clpcPucch     param=targetSinr          value=19
&{clpcPucchtIntervalSinrUpd}         dist_name=MRBTS-1/NRBTS-1/NRULCLPC_PROFILE-0     list_name=clpcPucch     param=tIntervalSinrUpd    value=10ms
&{ulTransPrePi2BpskPwrBoost_C1}      dist_name=MRBTS-1/NRBTS-1/NRCELL-1     param=ulTransPrePi2BpskPwrBoost        value=true
&{ulTransPrePi2BpskPwrBoost_C2}      dist_name=MRBTS-1/NRBTS-1/NRCELL-2     param=ulTransPrePi2BpskPwrBoost        value=true
# END SCF parameters of the test ======================================================================================

#swconfig Rad Parameters

# @{radList}    ${radDic_580832}     ${radDic_580833}    ${radDic_58082F}    ${radDic_580376}    ${radDic_580377}
# ...           ${radDic_580831}     ${radDic_580830}    ${radDic_58057A}    ${radDic_58057D}    ${radDic_4B000F}

@{radList}    ${radDic_58082F}    ${radDic_580376}    ${radDic_580377}
...           ${radDic_58057A}    ${radDic_58057D}    ${radDic_4B000F}

# &{radDic_580832}     field=0x580832    value=100          #${EMPTY}     #rdUlTransPrecodeOnSinrThreshR16DmrsOffset
# &{radDic_580833}     field=0x580833    value=100          #${EMPTY}     #rdUlTransPrecodeOffSinrThreshR16DmrsOffset
&{radDic_58082F}     field=0x58082F    value=30           #${EMPTY}     #rdPmaxBoost
&{radDic_580376}     field=0x580376    value=5            #${EMPTY}     #rdTransPrecodeHystThresh
&{radDic_580377}     field=0x580377    value=2            #${EMPTY}     #rdTransPrecodeBufferThresh
# &{radDic_580831}     field=0x580831    value=100          #${EMPTY}     #rdUlRank2to1ThreshR16DmrsOffset
# &{radDic_580830}     field=0x580830    value=100          #${EMPTY}     #rdUlRank1to2ThreshR16DmrsOffset
&{radDic_58057A}     field=0x58057A    value=4            #rdFeatureFlagBitmapLevel
&{radDic_58057D}     field=0x58057D    value=786432       #rdFeatureFlagBitmap2
&{radDic_4B000F}     field=0x4B000F    value=1            # RF_SW_Version_check_disabled

#UE corner
&{UE_1_SA_TDD_UE_R15_PC3}
...     ueid=1
...     ue_nr_capabilities=${SA_TDD_UE_R15_PC3}
...     ue_release=${EMPTY}    #${EMPTY} => basic already tuned correctly
...     Target_cell=1          #${EMPTY} => basic already tuned correctly

&{UE_2_SA_TDD_UE_R16}
...     ueid=2
...     ue_nr_capabilities=${SA_TDD_UE_R16}
...     ue_release=16   #${EMPTY} => basic already tuned correctly
...     Target_cell=2   #${EMPTY} => basic already tuned correctly

@{uelist}    ${UE_1_SA_TDD_UE_R15_PC3}    ${UE_2_SA_TDD_UE_R16}


#DOD Corner
@{DODlist}      # list empty for now will contain all DOD corner

@{AcceptanceCriteriaL1L2}    ${AC1}    ${AC2}    ${AC3}    ${AC4}    ${AC5}    ${AC6}    ${AC7}    ${AC8}

#            Trace Type           subcell_id       Message in Trace (Filter)         IE description
#...	     Requested Value
#                              (/!\  subcell_id0=Cell1)
#UE DMRS_SEQ_TYPE_1 or DMRS_SEQ_TYPE_2 for 7103-A on subcell_id=1:

&{AC1}       PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.puschTransformPrecoderFlag
...          value=1             dodtype=ExactValueForall    PercentTol=20
# MLLB_MH     If UlData_puschReceiveReqGrant_t.puschTransformPrecoderFlag<> 1/enabled  Then KO else OK
#            Case one occurrence <> 1 then KO

&{AC2}       PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.mcs
...          value=1             dodtype=InfEgalValueFarll    PercentTol=20
# MLLB_MH    If UlData_puschReceiveReqGrant_t.mcs<>0 or 1          Then KO else OK
#            Case one occurrence > 1 then KO

&{AC3}       PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.dmrsSequenceType
...          value=${expected_PuschDmrsSeqType}   dodtype=ExactValueForall    PercentTol=20
# MLLB_MH    Variable "expected_PuschDmrsSeqType" : either 0/TYPE_1 or 1/TYPE_2
#            If UlData_puschReceiveReqGrant_t.dmrsSequenceType <> expected_PuschDmrsSeqType     Then KO else OK
#            Case one occurrence <> expected_PuschDmrsSeqType then KO

&{AC4}       PcapType=L1L2        subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.modulationOrder
...          value=1              dodtype=ExactValueForall    PercentTol=20
# MLLB_MH    If UlData_puschReceiveReqGrant_t.modulationOrder<>1/Order1              Then KO else OK
#            Case one occurrence <> 1 then KO

&{AC5}       PcapType=L1L2        subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.mcsTable
...          value=0              dodtype=ExactValueForall    PercentTol=20
# MLLB_MH    If UlData_puschReceiveReqGrant_t.mcsTable<>0/max64QAM                   Then KO else OK
#            Case one occurrence <> 0 then KO

&{AC6}       PcapType=L1L2        subcell_id=1     msg=uldata_puschreceiverespps	  field=UlData_UePuschReceiveRespPs_t.sinr_item
...          value=Display        dodtype=DisplayAverage    PercentTol=20
# MLLB_MH    No check on this parameter  for now - will be used for manual tests "Calcul moyenne param sinr udata_PuschReceiveRespPs"
#            Display ONLY - AVERAGE

&{AC7}       PcapType=L1L2        subcell_id=1     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.crc
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- CRC OK/0 or CRC KO/1
# MLLB_MH    Count nb of  "UlData_UePuschReceiveRespHarqU_t.crc" occurrences
#            Count nb of UlData_UePuschReceiveRespHarqU_t.crc=NOK/1
#            Gives percentSubcellId1PuschCRCKO CRC NOK
#            Display ONLY

&{AC8}       PcapType=L1L2        subcell_id=1     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.dtx
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- NON_DTX/0 or DTX/1
# MLLB_MH    Count nb of  "UlData_UePuschReceiveRespHarqU_t.dtx" occurrences
#            Count nb of UlData_UePuschReceiveRespHarqU_t.dtx=DTX/1
#            Gives percentSubcellId1DTX DTX DTX
#            Display ONLY
# END Modification block ==============================================================================================



*** Test Cases ***

[1]CB007103-Ax-TCyy_TestGeneric_template
# CB007103-Ax-TCyy_TestGeneric_template
    # [Tags]                      CLOUD_5G_I_MP_AP_LO, SANSA_FS_ECPRI_CMWV_TDD
    # [Tags]                      CLOUD_5G_I_LO_AP_LO, SANSA_FS_CPRI_CMWV_FDD+ECPRI_CMWV_TDD_AEQE

    #Special Need for this test

    Set Suite Variable    ${userneed_PCAP}       ${True}
    # Set Suite Variable    ${tti}                 ${True}
    Set Suite Variable    ${userneed_Btslog}     ${True}
    Set Suite Variable    ${userneed_PM}         ${True}
    Set Suite Variable    ${DodIsSet}            ${True}

    CB007103_mainKW       ${A1}

*** Keywords ***

CB007103_mainKW
    [Documentation]                 CB007103-Base-
    [Arguments]                     ${param}
    kwmkt_dbg_log                   Global variable list DBGlogs: ${DBGlogs}          ##
    kwmkt_dbg_log                   info we are on KeepConfig: ${KeepConfig}           # these informative line to bypass Robot 5 new sanity :-)
    kwmkt_dbg_log                   info we are on NoSnap: ${NoSnap}                   #
    kwmkt_dbg_log                   info we are on egatelogoutput: ${egatelogoutput}   #
    kwmkt_dbg_log                   info we are on EnSher: ${EnSher}                   #
    kwmkt_dbg_log                   info we are on tti: ${tti}                         #
    kwmkt_dbg_log                   info we are on DodIsSet: ${DodIsSet}               #
    kwmkt_dbg_log                   recursion_limit: ${recursion_limit}               ##

    Init Sequence                   ${param}
    Step                            kwmkt_Create_Test_Suite_Folder

    Critical Step                   Set_basic_context
    Critical Step                   Set_RadParameters
    Critical Step                   Set_SCF_ConfigMarket     ${param.Scfdetails}
    Critical Step                   Set_SCF_ofTheTest        ${param.Feat7103niddSpecific}

    Critical Step                   kwmkt_Cell_setup         ${CellList}
    Run Keyword If                  not ${tti} and ${EnSher}                Activate Sherpa

    #L3call
    Run Keyword If                  ${userneed_PCAP}         kwmkt_Capture_Start    Attach

    Critical Step                   kwmkt_run_script_once    ${CURDIR}/resources/egCmd/egCmd_simple.sce

    Run Keyword If                  ${userneed_PCAP}         kwmkt_Capture_Stop     Attach

    #TTI
    Run Keyword If                  ${tti} and not ${EnSher}    kwmkt_TTI_capt    ${param.GetTtiTraceTime}

    #BIP L1L2
    Dated log                       1s L1L2 Bip collection
    kwmkt_Capture_Start             Traff
    Sleep    1s     #5ms
    ${pcappa}                       kwmkt_Capture_Stop      Traff
    Dated log                       pcap path: ${pcappa}

    Check_in_pcap                   PcapType=L1L2     PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
    #PM counters
    ${PMdod} =	                    Run Keyword And Return Status    kwmkt_PM_general
    kwmkt_dbg_log                   ${PMdod}
    Append to List                  ${DODlist}    ${PMdod}

    #L1L2 check
    pcap2csv                        PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}

    # /!\  elemRank help to chose info when tshark result return several information elemRank=0 => first elem of the list
    ${resSub0}                      Check_in_pcap            PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
    ...                                                      SbcId=1          elemRank=0
    Append to List                  ${DODlist}    ${resSub0}

    Dated log                                           DOD_7103: DodIsSet:${DodIsSet} res:${DODlist}
    Run Keyword If                  ${DodIsSet}         kwmkt_Check_For_False_In_${NL}    ${DODlist}
