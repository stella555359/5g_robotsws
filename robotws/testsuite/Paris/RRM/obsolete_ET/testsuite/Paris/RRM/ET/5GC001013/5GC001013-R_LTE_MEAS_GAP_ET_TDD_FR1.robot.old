*** Variables ***
${TestSharkTool}      MC_SHARK

@{ModRejectCUFlow}              x2ap.SgNBModificationRequest_element
...							    x2ap.SgNBModificationRequestReject_element

@{ModRejectDUFlow}              x2ap.SgNBModificationRequest_element
...							    f1ap.UEContextModificationRequest_element
...							    f1ap.UEContextModificationFailure_element
...							    x2ap.SgNBModificationRequestReject_element

@{AddRejectCUFlow}              x2ap.SgNBAdditionRequest_element
...							    x2ap.SgNBAdditionRequestReject_element


@{AddRejectDUFlow}              x2ap.SgNBAdditionRequest_element
...							    f1ap.UEContextSetupRequest_element
...							    f1ap.UEContextSetupFailure_element
...							    x2ap.SgNBAdditionRequestReject_element

@{AddIgnoreCUFlow}              x2ap.SgNBAdditionRequest_element
...							    x2ap.SgNBAdditionRequestAcknowledge_element

@{ModIgnoreCUFlow}              x2ap.SgNBModificationRequest_element
...							    x2ap.SgNBModificationRequestAcknowledge_element

@{ModIgnoreDUFlow}              x2ap.SgNBModificationRequest_element
...							    f1ap.UEContextModificationRequest_element
...							    f1ap.UEContextModificationResponse_element
...							    x2ap.SgNBModificationRequestAcknowledge_element

