*** Keywords ***
CB010793_TC-A_1_Transmitter_test_model_35MHz_FDD_NR-FR1-TM1_1
    Init Sequence      "CB010793-A1"

    Step               CB010793A Test Line Preparation    ${Scf35MHzFR1}
    Critical Step      oam.Activate Test dedicated Mode
    ...                   depends=CB010793A Test Line Preparation
	Step               CB010793 setup Mirroring for BIP capture    prefix=CB010793_A1_NR_Downlink
    ...                   depends=Activate Test dedicated Mode
	Step               CB010793 Start Capture CPRT
    ...                   depends=CB010793 setup Mirroring for BIP capture
	Step               CB010793 Start Capture L1L2
    ...                   depends=CB010793 setup Mirroring for BIP capture
    Step               CB010793 Start 5g test NR Downlink       ${param_NR_Downlink_FR1_TM1_1}
    ...                   depends=Activate Test dedicated Mode
    Traced Sleep       2    msg=CPRT and BIP L1L2 logs capture ongoing
	Step               Capture Stop         capture=${CAPTURE_L1L2}
    ...                   depends=CB010793 Start Capture L1L2
	Step               Capture Stop         capture=${CAPTURE_CPRT}
    ...                   depends=CB010793 Start Capture CPRT
	Step               CB010793 Stop downlink Test Model
    ...                   depends=CB010793 Start 5g test NR Downlink
    Step               CB010793 Check CellSetupRequest                   ${CAPTURE_CPRT}    ${CellSetupRequest_checkShowName_BW35MHz}
    ...                   depends=CB010793 Start 5g test NR Downlink
    Step               CB010793 Check StartConformanceTestReq            ${CAPTURE_CPRT}    ${StartConformanceTestReq_checkShowName_NR_FR1_TM1_1}
    ...                   depends=CB010793 Start 5g test NR Downlink
    Step               CB010793 Check StartConformanceTestResp status    ${CAPTURE_CPRT}
    ...                   depends=CB010793 Start 5g test NR Downlinkq
    Step               CB010793A Check pdschsendreq NR_FR1_TM1_1         ${CAPTURE_L1L2}
    ...                   depends=CB010793 Start 5g test NR Downlink
    [Teardown]         CB010793 Teardown TC

CB010793_TC-A_2_Receiver_test_model_35MHz_FDD_NR-G-FR1-A2-4
    Init Sequence      "CB010793-A2"

    Step               CB010793A Test Line Preparation    ${Scf35MHzFR1}
    Critical Step      oam.Activate Test dedicated Mode
    ...                   depends=CB010793A Test Line Preparation
	Step               CB010793 setup Mirroring for BIP capture    prefix=CB010793_A2_NR_Uplink
