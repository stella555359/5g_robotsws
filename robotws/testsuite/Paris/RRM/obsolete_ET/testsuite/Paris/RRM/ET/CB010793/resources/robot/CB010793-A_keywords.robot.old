	Step               CB010793 Start Capture CPRT
    ...                   depends=CB010793 setup Mirroring for BIP capture
	Step               CB010793 Start Capture L1L2
    ...                   depends=CB010793 setup Mirroring for BIP capture
    Step               CB010793 Start 5g test NR Uplink       ${param_NR_Uplink_G_FR1_A2_4}
    ...                   depends=Activate Test dedicated Mode
    Traced Sleep       2    msg=CPRT and BIP L1L2 logs capture ongoing
	Step               Capture Stop         capture=${CAPTURE_L1L2}
    ...                   depends=CB010793 Start Capture L1L2
	Step               Capture Stop         capture=${CAPTURE_CPRT}
    ...                   depends=CB010793 Start Capture CPRT
#	Step               CB010793 Stop uplink Test Model
#    ...                   depends=CB010793 Start 5g test NR Uplink
    Step               CB010793 Check CellSetupRequest                   ${CAPTURE_CPRT}    ${CellSetupRequest_checkShowName_BW35MHz}
    ...                   depends=CB010793 Start 5g test NR Uplink
    Step               CB010793 Check StartConformanceTestReq            ${CAPTURE_CPRT}    ${StartConformanceTestReq_checkShowName_G_FR1_A2_4}
    ...                   depends=CB010793 Start 5g test NR Uplink
    Step               CB010793 Check StartConformanceTestResp status    ${CAPTURE_CPRT}
    ...                   depends=CB010793 Start 5g test NR Uplink
    Step               CB010793A Check PuschReceiveReq                   ${CAPTURE_L1L2}    ${PuschReceiveReq_checkValue_G_FR1_A2_4}
    ...                   depends=CB010793 Start 5g test NR Uplink
    [Teardown]         CB010793 Teardown TC


########################  CB010793-A KWs  ########################
CB010793A Check pdschsendreq NR_FR1_TM1_1
    [Arguments]    ${BIP_L1L2}
    Dated Log      Check dldata_pdschsendreq parameters

    ${pcapFiltered}    analyzer.filter_pcap
    ...                pcapInFile=${BIP_L1L2.path}
    ...                filterName=dldata_pdschsendreq
    ...                filterExp=dldata_pdschsendreq

    ${pdml}=           analyzer.pcap_to_pdml    ${pcapFiltered}

    CB010793A Check PdschSendReq IEs RNTI
    ...                PDML_L1L2=${pdml}
    ...                RNTI=0
    ...                FieldValue=${PdschSendreqReq_checkValue_NR_FR1_TM1_1_RNTI0}

    CB010793A Check PdschSendReq IEs RNTI
    ...                PDML_L1L2=${pdml}
    ...                RNTI=2
    ...                FieldValue=${PdschSendreqReq_checkValue_NR_FR1_TM1_1_RNTI2}

CB010793A Check PdschSendReq IEs RNTI
    [Arguments]    ${PDML_L1L2}    ${RNTI}    ${FieldValue}
    Dated Log      With RNTI ${RNTI}:

    ${msg_field}    Set Variable    @{FieldValue.keys()}

    @{listPacketMatch}    Get Packet Match List
    ...           pdmlFile=${PDML_L1L2}
    ...           packetName=dldata_pdschsendreq
    ...           pathList=@{msg_field}
    ...           startPacket=${1}
    ...           endPacket=${10}
    ...           filter='rnti$'==${RNTI}

    ${lenPdschSendReq}    get length    ${listPacketMatch}
    Dated Log             Number of pdschsendreq msgs with RNTI ${RNTI}: ${lenPdschSendReq}
    should be true        ${lenPdschSendReq}!=0

    ${packet}             set variable    ${listPacketMatch[0]}
    CB010793A Check PdschSendReq IEs    ${packet}    ${FieldValue}

CB010793A Check PdschSendReq IEs
    [Arguments]    ${packet}    ${FieldValue}

    FOR   ${Field}   IN   @{FieldValue.keys()}
        ${ParamValue}     Get Value In Packet Match
        ...               ${packet}
        ...               field=${Field}

        ${Value}          set variable    ${FieldValue["${Field}"]}
        Dated Log         --- Check ${Field} = ${Value}
        should be true    ${ParamValue} ==${Value}
    END

CB010793A Check PuschReceiveReq
    [Arguments]    ${BIP_L1L2}    ${FieldValue}
    Dated Log      Check uldata_puschreceivereq parameters

    ${pcapFiltered}    analyzer.filter_pcap
    ...                pcapInFile=${BIP_L1L2.path}
    ...                filterName=uldata_puschreceivereq
    ...                filterExp=uldata_puschreceivereq

    ${pdml}=           analyzer.pcap_to_pdml    ${pcapFiltered}

    ${msg_field}       Set Variable    @{FieldValue.keys()}

    FOR   ${slot}  IN RANGE   0  10
        @{listPacketMatch}    Get Packet Match List
        ...                   pdmlFile=${pdml}
        ...                   packetName=uldata_puschreceivereq
        ...                   pathList=@{msg_field}
        ...                   startPacket=${1}
        ...                   endPacket=${20}
        ...                   filter='slot$'== ${slot}

        ${lenPuschSendReq}    get length    ${listPacketMatch}
        Dated Log             Number of PdcchSendReq msgs with slot ${slot}: ${lenPuschSendReq}
        should be true        ${lenPuschSendReq}!=0

        ${packet}             set variable    ${listPacketMatch[0]}
        CB010793A Check PuschReceiveReq IEs    ${packet}    ${FieldValue}
    END

CB010793A Check PuschReceiveReq IEs
    [Arguments]    ${packet}    ${FieldValue}

    FOR   ${Field}   IN   @{FieldValue.keys()}
        ${ParamValue}     Get Value In Packet Match
        ...               ${packet}
        ...               field=${Field}

        ${Value}          set variable    ${FieldValue["${Field}"]}
        Dated Log         --- Check ${Field} = ${Value}
        should be true    ${ParamValue} ==${Value}
    END


CB010793A Test Line Preparation
    [Arguments]    ${testParam}
    CB010793 Set Context_AP IPHY    card_name=${testParam.nrcell.RU}    GSCN=${testParam.nrcell.gscn}
    CB010793A Set SCF               ${testParam}


CB010793A Set SCF
    [Arguments]    ${testParam}
    Dated log      NIDD configuration

    &{modify_param0}    Create Dictionary
    ...    parameter=btsName
    ...    dist_name=MRBTS-${MRBTS_ID}
    ...    value=${testParam.btsName}
    &{modify_param1}    Create Dictionary
    ...    parameter=prodCodePlanned
    ...    dist_name=MRBTS-${MRBTS_ID}/EQM-1/APEQM-1/RMOD-1
    ...    value=${testParam.nrcell.prodCodePlanned}
    &{modify_param2}    Create Dictionary
    ...    parameter=freqBandIndicatorNR
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.nrcell.freqBandIndicatorNR}
    &{modify_param3}    Create Dictionary
    ...    parameter=gscnOrSsPbchArfcn
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.nrcell.gscn}
    &{modify_param4}    Create Dictionary
    ...    parameter=chBwDl
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1/NRCELL_FDD-1
    ...    value=${testParam.nrcell.chBwDL}
    &{modify_param5}    Create Dictionary
    ...    parameter=chBwUl
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1/NRCELL_FDD-1
    ...    value=${testParam.nrcell.chBwUL}
    &{modify_param6}    Create Dictionary
    ...    parameter=nrarfcnDl
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1/NRCELL_FDD-1
    ...    value=${testParam.nrcell.nrarfcnDL}
    &{modify_param7}    Create Dictionary
    ...    parameter=nrarfcnUl
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1/NRCELL_FDD-1
    ...    value=${testParam.nrcell.nrarfcnUL}

    @{modify_param_FR1}     Create List
    ...     ${modify_param0}        ${modify_param1}        ${modify_param2}
    ...     ${modify_param3}        ${modify_param4}        ${modify_param5}
    ...     ${modify_param6}        ${modify_param7}

    OAM Set Params      ${modify_param_FR1}
