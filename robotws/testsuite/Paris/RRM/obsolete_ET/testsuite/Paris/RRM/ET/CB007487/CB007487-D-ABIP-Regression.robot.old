*** Keywords ***

CB007487_SA_NSA_call
    [Arguments]                     ${param}
    Init Sequence    ${param}

    SA_call          ${param}
    Clean Simu Basic Files
    Dated Log        Fresh basic_wts_step2.cfg creation
    Copy Config Files For WTS
    NSA_call         ${param}
    Clean Simu Basic Files

SA_call
    [Documentation]                 SA call DL and after UL traffic
    [Arguments]                     ${param}

    Restart TL
    Critical Step                   CallSetup.Setup Wtsemu SA    shouldSaveBasicCfg=${True}
    Critical Step                   CallSetup.UE Register                                         depends=CallSetup.Setup Wtsemu SA
    Critical Step                   CallSetup.UE Attach Check                                     depends=CallSetup.UE Register
    Critical Step                   CallSetup.Launch PDU Session                                  depends=CallSetup.UE Attach Check
    Critical Step                   DL Traffic Feature BW        ueSetting_type=${BASIC_UE_SA}    depends=CallSetup.Launch PDU Session
    Critical Step                   UL Traffic Feature BW        ueSetting_type=${BASIC_UE_SA}    depends=CallSetup.Launch PDU Session

NSA_call
    [Documentation]                 NSA call DL and after UL traffic
    [Arguments]                     ${param}

    Restart TL
    Critical Step                   WTS Setup                    shouldSaveBasicCfg=${True}       shouldUseLua=${False}
    Critical Step                   UE Cell Setup Check                                           depends=WTS Setup
    Critical Step         CallSetup.SgNB Addition to ENB         ueSetting=${UE_SIMPLE}           depends=UE Cell Setup Check
    Critical Step                   UE Attach Check                                               depends=SgNB Addition to ENB
    Critical Step                   DL Traffic Feature BW        ueSetting_type=${UE_SIMPLE}      ue_id=11    scell_idx=8      
    Critical Step                   UL Traffic Feature BW        ueSetting_type=${UE_SIMPLE}      ue_id=11    scell_idx=8

UL Traffic Feature BW
    [Arguments]       ${ueSetting_type}=none    ${ue_id}=1    ${scell_idx}=0
    Dated log                       Starting UL Traffic procedure
    Traffic UE UL     ueSetting=${ueSetting_type}    throughput=${param.Uplink_throughput}    duration=30    deviation=50
    ...               shouldBeStop=False    shouldBeCheck=${False}  #line added to bypass traffic UL bearer check

    #block added to bypass traffic UL bearer check
    ${Ue_Avg_PUSCH_Tput}=    run Keyword if      '${param.Uplink_throughput}'!='0'
    ...                      Get PUSCH ue_stats_nr  ue_id=${ue_id}  scell_idx=${scell_idx}
    ...  ELSE                set variable   0

    ${trig}=                 Evaluate            ${param.Uplink_throughput} - ( ${param.Uplink_throughput} * 50 / 100 )
    ${value}                 Set Variable if     ${Ue_Avg_PUSCH_Tput} > 0     ${Ue_Avg_PUSCH_Tput}    0
    ${DOD}                   Set Variable if     ${value} >= ${trig}          True                    False          
    Dated log                ** => ** UL Traffic ${value} Mbps, DOD ${DOD}  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
    Should Be True           '${DOD}' == 'True'


DL Traffic Feature BW
    [Arguments]       ${ueSetting_type}=none         ${ue_id}=1  ${scell_idx}=0
    Dated log         Starting DL Traffic procedure
    Traffic UE DL     ueSetting=${ueSetting_type}    throughput=${param.Downlink_throughput}  duration=30  deviation=50
    ...               shouldBeStop=False             shouldBeCheck=${False}  #line added to bypass traffic DL bearer check

    #block added to bypass traffic UL bearer check
    ${Ue_Avg_PDSCH_Tput}=    run Keyword if      '${param.Downlink_throughput}'!='0'
    ...                      Get PDSCH ue_stats_nr  ue_id=${ue_id}  scell_idx=${scell_idx}
    ...  ELSE                set variable   0
    Dated log                ** => ** UL Traffic ${Ue_Avg_PDSCH_Tput}

    ${trig}=                 Evaluate            ${param.Downlink_throughput} - ( ${param.Downlink_throughput} * 50 / 100 )
    ${value}                 Set Variable if     ${Ue_Avg_PDSCH_Tput} > 0     ${Ue_Avg_PDSCH_Tput}    0
    ${DOD}                   Set Variable if     ${value} >= ${trig}          True                    False          
    Dated log                ** => ** UL Traffic ${value} Mbps, DOD ${DOD}  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
    Should Be True           '${DOD}' == 'True'

Teardown_CB007487_SA_NSA_introutecloud
    [Documentation]    At the end of This test case
    ...                1/ erase Sweng scories
    ...                2/ Sos Report and Snapshot collection 
    ...                     on failure 
    ...                     or on user request (AutoSaveDebugData variable set to True on the top of this robot scenario)

    Dated log          Test Teardown_CB007487_SA_NSA_introutecloud : start

    Clean Simu Basic Files

    # this mini algo save SOS Report, OAM snapshot if testcase failed or if ${AutoSaveDebugData} is ${True}
    Set Global Variable             ${save_debug_data}     ${False}  #mini Algo initialisation
    Run Keyword If Test Failed      Set Global Variable    ${save_debug_data}    ${True}
    Run Keyword If                  ${AutoSaveDebugData} == ${True}    Set Global Variable    ${save_debug_data}    ${True}
    # Get_Traces_Sherpa to be added when it's OK
    Run Keyword If                  ${save_debug_data} == ${True} and not ${isAic}    Run Keywords
    ...                             Get Sos Report
    ...                             Get Snapshot

    Dated log        Test Teardown_CB007487_SA_NSA_introutecloud : end
