UL Traffic Feature BW
    [Documentation]   UL traffic is sent using SWENG "Traffic UE UL" keyword
    ...               Traffic is not checked by the sweng KW and UL traffic stay running
    ...               traffic UL result is kept using egate ue_stats_nr for PUSCH

    [Arguments]       ${TP}=0  ${ueSetting}=none  ${ue_id}=1  ${scell_idx}=0

    BuiltIn.Log      \nTest ${TEST_NAME} UL Traffic Feature BW   console=yes
    Dated log         Starting UL Traffic procedure
    Traffic UE UL     ueSetting=${ueSetting}    throughput=${TP}    duration=60    deviation=50
    ...               shouldBeStop=False    shouldBeCheck=${False}  #line added to bypass traffic UL bearer check

    #block added to bypass traffic UL bearer check
    ${Ue_Avg_PUSCH_Tput}=    run Keyword if      '${TP}'!='0'
    ...                      Get PUSCH ue_stats_nr  ue_id=${ue_id}  scell_idx=${scell_idx}
    ...  ELSE                set variable   0
    Set global variable    ${Ue_Avg_PUSCH_Tput}
    Dated log                ** => ** UL Traffic ${Ue_Avg_PUSCH_Tput}

    ${trig}=                 Evaluate            ${TP} - ( ${TP} * 50 / 100 )
    ${value}                 Set Variable if     ${Ue_Avg_PUSCH_Tput} > 0     ${Ue_Avg_PUSCH_Tput}    0
    ${DOD}                   Set Variable if     ${value} >= ${trig}          True                    False          
    Dated log                ** => ** UL Traffic ${value} Mbps >= ${trig} => DOD ${DOD}  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
    #Should Be True           '${DOD}' == 'True'

DL Traffic Feature BW
    [Documentation]   DL traffic is sent using SWENG "Traffic UE DL" keyword
    ...               Traffic is not checked by the sweng KW and DL traffic stay running
    ...               traffic DL result is kept using egate ue_stats_nr for PUSCH

    [Arguments]       ${TP}=0  ${ueSetting}=none  ${ue_id}=1  ${scell_idx}=0

    BuiltIn.Log      \nTest ${TEST_NAME} DL Traffic Feature BW   console=yes
    Dated log         Starting DL Traffic procedure
    Traffic UE DL     ueSetting=${ueSetting}    throughput=${TP}  duration=60  deviation=50
    ...               shouldBeStop=False             shouldBeCheck=${False}  #line added to bypass traffic DL bearer check

    #block added to bypass traffic UL bearer check

    #=> solution usage o fshell interrogation
    #     ${Ue_Avg_PDSCH_Tput}   ${unite}=    run Keyword if      '${TP}'!='0'
    # ...                      Get_PxSCH_ue_stats_nr  ue_id=${ue_id}  scell_idx=${scell_idx}
    # ${Ue_Avg_PDSCH_Tput}   ${unite}=    run Keyword if      '${TP}'!='0'

    ${Ue_Avg_PDSCH_Tput}=    run Keyword if      '${TP}'!='0'
    ...                      Get PDSCH ue_stats_nr  ue_id=${ue_id}  scell_idx=${scell_idx}
    ...  ELSE                set variable   0
    Set global variable      ${Ue_Avg_PDSCH_Tput}
    # Dated log                ** => ** DL Traffic ${Ue_Avg_PDSCH_Tput} uu:${unite}
    Dated log                ** => ** DL Traffic ${Ue_Avg_PDSCH_Tput}

    ${trig}=                 Evaluate            ${TP} - ( ${TP} * 50 / 100 )
    ${value}                 Set Variable if     ${Ue_Avg_PDSCH_Tput} > 0     ${Ue_Avg_PDSCH_Tput}    0
    ${DOD}                   Set Variable if     ${value} >= ${trig}          True                    False          
    Dated log                ** => ** DL Traffic ${value} Mbps >= ${trig} => DOD ${DOD}  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
#    Should Be True           '${DOD}' == 'True'

Get_PxSCH_ue_stats_nr
    [documentation]   Return the Average of a ue_stats_nr command based on ue_stats_nr egate command provided by TAF runner library
    ...               def ue_stats_nr(self, **kwargs):
    ...                    """
    ...                    :param id: Specified UE ID(s)
    ...                    :param type: (Optional) Statistics type
    ...                    :param scell: (Optional) Carrier Aggregation serving cell (carrier compo
    ...                           nent, CC). Primary is for scell index 0. Secondary is for scell indexes 1-31.
    ...                    :param format: (Optional) Display Format
    ...                    :param size_unit: (Optional) unit of PDU/SDU/packets size

    [Arguments]    ${ue_id}=1    ${scell_idx}=0    ${type}=pdsch
    
    BuiltIn.Log      \nTest ${TEST_NAME} Get_PxSCH_ue_stats_nr   console=yes
    Dated Log      PxSCH UE stats  ${ue_id}  ${scell_idx}  ${type}

    ${matchTarget}   set variable if    '${type}'=='pdsch'     PDSCH Throughput
    ...                                                        PUSCH Throughput
    Dated Log  Arguments ===> id ${ue_id} type ${type} scell ${scell_idx} delay 1000 searched: ${matchTarget}
    #wtsemu.ue_stats_nr  id=${ue_id}  type=${type}  scell=${scell_idx}   delay=1000   #ms
    wtsemu.ue_stats_nr  id=${ue_id}  type=${type}  scell=${scell_idx}
    Sleep  3s
    # wtsemu.sim_log_set  flush   #unfortunately not implemented on TAF runner delivery
    # solution =usage of sim_state_disp command to flush the egate_condole.log file with a lot of data 
    wtsemu.sim_state_disp
    wtsemu.sim_state_disp
    wtsemu.sim_state_disp
    wtsemu.sim_state_disp
    wtsemu.sim_state_disp
    wtsemu.sim_state_disp

    ${alias_epc}      SSH Wait For Connect    ${HOST_EPCSIM}
    ${targetfile}=    Set Variable    ${tl.core.dir_path}/egate_console.log
    ${work_file}=     Set Variable    ${tl.core.dir_path}/fts${type}.txt
    ${command_1}      Catenate
    ...               grep -e CellIndex-${scell_idx} -e UE-1: ${targetfile} | awk 'BEGIN{FS=" "; OFS=" "} {print $(NF-1),$NF}' > ${work_file}
    ${resShell_1}     run            ${command_1}

    ${res}=           run    sed -n '/${matchTarget}/ {n;p}' ${work_file}   #no numeric exploitation | cut -d' ' -f1

    #${first two}= 	  Get Substring  ${res}  0  1
    # ${pre} 	${post}= 	Split String 	    ${res} 	:: 	1
    @{words}=    Split String       ${res}  ,${SPACE}
    Dated Log    debug words        @{words}
    ${list1}=    Split String       ${words[0]}
    ${result}= 	 Convert To Number 	${list1[0]} 	1
    ${uu}=   	 Split String       ${list1[1]} 	1
    ${unit}=     Convert To String  ${list1[1]}
    Dated Log    result ${result} unit ${unit}
    
    ${contenu}   run   cat ${work_file}
    Dated Log    \t ** CellIndex-${scell_idx} ===> ${contenu} ** 
    [Return]      ${result}  ${unit}

BM_CB007487_Testline_settings
    [Documentation]
    ...                 This KW will help to set 5gnb swconfig file for mcs purpose
    ...                 and call Set_XL_mod to set UL_mod / DL_mod in the scf
    [Arguments]         ${BM_id}=${BM_CB007487_D1}

    BuiltIn.Log      \nTest ${TEST_NAME} BM_CB007487_Testline_settings   console=yes
    #** 5gnb swconfig update
    Dated Log  **MCS** Settings value on 5gnb swconfig.txt ${BM_id}

    #exemple in swconfig
    # 0x58000E=0x1fffffff     #rdSupportedDl64QamMcs
    # 0x58000F=0x1fffffff     #rdSupportedDl256QamMcs
    # 0x580010=0x1fffffff     #rdSupportedUlMCS

    FOR    ${i}    IN RANGE    3    #switch case simulation   for 0 1 2 3 (4 steps)

        Dated Log  DBG BM_id.DL_MCS: ${BM_id.DL_MCS}

        ${mcsVal}    Set Variable if    "${BM_id.DL_MCS}" == "0"        0x01    not0
        Dated Log  DBG mcsval r1: ${mcsVal}
        Exit For Loop If    "${mcsVal}"!="not0"
        ${mcsVal}    Set Variable if    "${BM_id.DL_MCS}" == "3"        0x0F    not3
        Dated Log  DBG mcsval r2: ${mcsVal}
        Exit For Loop If    "${mcsVal}"!="not3"
        ${mcsVal}    Set Variable if    "${BM_id.DL_MCS}" == "5"        0x3F    not5
        Dated Log  DBG mcsval r3: ${mcsVal}
        Exit For Loop If    "${mcsVal}"!="not5"
        ${mcsVal}    Set Variable if    "${BM_id.DL_MCS}" == "Max"      0x1FFFFFFF    notMax
        Dated Log  DBG mcsval r4: ${mcsVal}
        Exit For Loop If    "${mcsVal}"!="notMax"
        Dated Log  Adding ${mcsVal}  NOT FOUND

    END
    Dated Log  mcsval: ${mcsVal}
    #0x58000F rdSupportedDl256QamMcs
    #0x58000E rdSupportedDl64QamMcs
    ${TargetToSetforDL}   Set Variable if      "${BM_id.DL_Mod}" == "256QAM"    0x58000F    0x58000E
    Dated Log  DBG : TargetToSetforDL ${TargetToSetforDL}
    &{Dico1}           Create Dictionary     field=${TargetToSetforDL}    value=${mcsVal}
    &{Dico2}           Create Dictionary     field=0x580010               value=${mcsVal}
    @{Dicolist}        Create List    ${Dico1}    ${Dico2}
    Dated Log  Adding ${Dicolist} in 5gnb-swconfig.txt (+crasign)
    Set Fields in swconfig DU    ${Dicolist}    ${GNB_DU.entryCard[0]}

    #** SCF update
    ${value}    set variable if    '${BM_id.DL_Mod}' == '256QAM'    ${TRUE}    ${FALSE}
    BM_Set_xL_mod    actDl256Qam    ${value}    ${BM_id.CELL}

BM_Set_XL_mod
    [Documentation]
    ...              This KW will help to set actDl256Qam on line
    ...              OAM request is done 1 time with a dictionnary created in a loop
    [Arguments]    ${arg}    ${value}    ${cell}

    BuiltIn.Log      \nTest ${TEST_NAME} BM_Set_XL_mod   console=yes
    Dated Log      "${arg} set ${value}"
    @{modiflist}    Create List
           ${dn}             set variable           MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${cell}
           &{modify_param}   Create Dictionary
                             ...                    parameter=${arg}
                             ...                    dist_name=${dn}
                             ...                    value=${value}

           Dated log                                ${modify_param}
           Append To List     ${modiflist}          ${modify_param}
           Dated log    \n
    OAM Set Params            ${modiflist}            # OAM need a list ....
    Dated Log  on ${modify_param.dist_name}, ${arg} have been modified with value: ${value}

TteardownP3
    [Documentation]  save SOS Report, OAM snapshot if testcase failed or if ${AutoSaveDebugData} is ${True}
    BuiltIn.Log       \nTest ${TEST_NAME} TteardownP3   console=yes
    Run Keyword If    ${AutoSaveDebugData} == ${True}    Get Snapshot

CS_Create Header Csv Test result
  [Arguments]                    ${text}=""
    ${test_env}    Topo.set
    ${text}    catenate   "Subfeature; BMId; technology; BF; SA/NSA; DL Mod; downlinkMimoMode; DL MCS; UL Mimo; UL Mod; UL MCS; cipher;"
    ...                   "CellId; DLTput Reached (Mbps); ULTput Reached (Mbps);"
    ...                   "5gnb Sw version; AP Sw version;"

    ${timeStamp}=    DateTime.Get current date    exclude_millis=True    result_format=%Y%m%d-%H%M%S
    #${filename}   set Variable    TestResults-${SUITE_NAME}-BM-${BENCHMARK_ID}-${higher_cipher}-${higher_integrity}-${timeStamp}.csv
    ${BENCHMARK_ID}   set Variable    BMID
    ${filename}   set Variable    TestResults-${timeStamp}.csv
    Run Keyword And Ignore Error    OperatingSystem.touch    ${LOG_PATH}/${filename}
    Run Keyword And Ignore Error    OperatingSystem.run      echo ${text} > ${LOG_PATH}/${filename}
    set suite variable      ${csv_file_results}       ${LOG_PATH}/${filename}
    set suite variable      ${test_env}
    
CS_Log Test results
  [Arguments]                    ${text}
    Run Keyword And Ignore Error    OperatingSystem.run      echo "${text}" >> ${csv_file_results}

AlarmsCollection
    [Arguments]                    ${testCaseDir}
    # get Alarm at the end of the test and store it into a file
    Dated log New Line  OAM Get Active Alarms to Save into file
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}

    ${active_alarms}     OAM Get Active Alarms                   oam=${GNB_DU.oam}       textFormat=${False}
    ${len}    Get Length    ${active_alarms}
    ${alarm_id_list}    Create List
    ${alarm_name_list}    Create List
    ${faultId}=     set variable if    ${isAiC}        fault_id
    ...                                                faultId
    ${faultName}=     set variable if    ${isAiC}      fault_name
    ...                                                faultName

    FOR    ${i}    IN RANGE    ${len}
         ${tmp_id}    Get From Dictionary    ${active_alarms[${i}]}    ${faultId}
         ${tmp_name_id}    Get From Dictionary    ${active_alarms[${i}]}    ${faultName}
         Append To List    ${alarm_id_list}    ${tmp_id}
         Append To List    ${alarm_name_list}    ${tmp_name_id}
    END
    # Dated log     Active alarms: alarm_id_list=${alarm_id_list}
    # Dated log     Active alarms: alarm_name_list=${alarm_name_list}

    Append To File    ${testCaseDir}/OAM_Alarms_After_${TEST_NAME}.txt     Active Alarms Id List:\n${alarm_id_list}\n\n
    Append To File    ${testCaseDir}/OAM_Alarms_After_${TEST_NAME}.txt     Active Alarms Name List:\n${alarm_name_list}\n\n

    OAM Disconnect                          ${GNB_DU.oam}

Save current context
    [Arguments]                        ${testCaseDir}
    # Save current SCF file used during test cases
    ${current_scf_file}                OAM Get SCF File            dir=${testCaseDir}      file=SCF_used_for_${BM}_Tests.xml
    Set Suite Variable                 ${current_scf_file}
    Dated Log New Line                 Current SCF file stored to ${current_scf_file}

    # Get swconfig file used during 7487 tests
    ${ret}   ${alias_gnb}              Run Keyword And Ignore Error         SSH Wait For Connect                ${GNB_DU.sys[0].M}
    Run Keyword And Ignore Error       csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                                local_path=${testCaseDir}/swconfig_used_for_${BM}_Tests.txt
    ...                                connection=${alias_gnb}
    Dated Log                          Current ${TEST_NAME} swconfig file stored to ${testCaseDir}/swconfig_used_for_${BM}_Tests.txt

    # Get EPC file configuration used during 7487 tests
    ${alias_epc}                       SSH Wait For Connect                ${HOST_EPCSIM}
    csn.download_file                  remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                                local_path=${testCaseDir}/basic_wts_used_for_${BM}_Tests.cfg
    ...                                connection=${alias_epc}

    ${msg}=   Catenate                 Current ${BM} basic file ${tl.core.cfg_filename} stored
    ...                                to ${testCaseDir}/basic_wts_used_for_${BM}_Tests.cfg
    Dated Log                          ${msg}
    Dated Log                          Current ${TEST_NAME} ApOamConfig file stored to ${testCaseDir}/ApOamConfig_used_for_${BM}_Tests.xml


BM_teardown
    BuiltIn.Log      \nTest ${BENCHMARK_ID} BM_teardown   console=yes
    Dated Log New Line   ** INTERRUPTION running ${BENCHMARK_ID} !! **

    Run Keyword If   '${BtsLogStarted}'=='True'      run Keywords    Dated log     =====> Stop Btslog
    ...                                              AND             btslog.Stop Btslog    target_dir=${testCaseDir}
    Run Keyword And Ignore Error
    ...                             Run Keyword If    ${enable_sherpa} == ${True}
    ...                                 run Keywords    Dated log     =====> Stop Sherpa
    ...                                 AND             Sherpa.Deactivate Sherpa and Stop Collect    keep_pcap_file=True

    AlarmsCollection       ${testCaseDir}
    Save current context   ${testCaseDir}
    CleanBasicFiles  #maybe too much
    Dated Log  LOGPATH_ORIG:      ${LOGPATH_ORIG}
    Dated Log  testCaseDir_ORIG:  ${testCaseDir_ORIG}
    Restore Orignal Configuration 7487-D_BM    ${LOGPATH_ORIG}/${testCaseDir_ORIG}    #maybe too much

