*** Keywords ***

BM_CleanBasicLuaFiles
    [Documentation]         At the end of the test, this KW erase all Sweng adding arround basic cfg/lua
    BuiltIn.Log      \nTest ${TEST_NAME} BM_CleanBasicLuaFiles   console=yes
    Dated Log               ERASE LUA FILES from previous test
    ${alias}                SSH Connect           ${HOST_EPCSIM}
    ${myCommand}=           set variable          rm -f /opt/iphy/latest/basic*step2*.lua;rm -rf /tmp/ute/
    ${result}=              SSH Exec              command=${myCommand}
    ...                                           alias=${alias}
    Dated Log               result=${result}
BM_CB007487 cell setup
    [Arguments]                     ${CallType}    ${num_of_cells}=1   ${isOAMRebooted}=False
    BuiltIn.Log      \nTest ${TEST_NAME} BM_CB007487 cell setup   console=yes
    Dated Log new line              ${consTraceColor}=== Restart TL === ${defColor}
    Restart TL                      isOAMRebooted=${isOAMRebooted}    GNBCallback=CB007487 Start Capture After GNB Ready
    Dated Log new line              ${consTraceColor}=== WTS setup === ${defColor}

    Run Keyword If                  "${CallType}" == "NSA"     WTS setup          shouldUseLua=${False}    shouldSaveBasicCfg=${True}
    Run Keyword If                  "${CallType}" == "SA"      Setup Wtsemu SA    shouldUseLua=${False}    shouldSaveBasicCfg=${True}

    UE Cell Setup Check
    ${num_of_cells}=    Get Cell Number
    Wait gNB cells 5g On air    num_of_cells=${num_of_cells}

    [teardown]   CB007487 Capture Stop           cellSetup

BM_CB007487 check BLER
    [Arguments]                 ${CellID}    ${Duration}    ${DLtput}    ${ULtput}    ${DL_Mod}=none
    Dated Log new line          DBG: check BLER argument: ${CellID} ${Duration} ${DLtput} ${ULtput} ${DL_Mod}
    ${DLBLERStatus}             Run Keyword If    ${Duration} != 0 and ${DLtput} != 0
    ...                         BM_CB007487 check BLER level    dl_or_ul=DL    CellID=${CellID}    Dlmod=${DL_Mod}
	...                         ELSE
	...                         Set Variable    ${None}

    ${ULBLERStatus}             Run Keyword If    ${Duration} != 0 and ${ULtput} != 0
    ...                         BM_CB007487 check BLER level    dl_or_ul=UL    CellID=${CellID}
	...                         ELSE
	...                         Set Variable    ${None}

    [Return]                    ${DLBLERStatus}    ${ULBLERStatus}
    
BM_CB007487 check BLER level
    [Arguments]                 ${dl_or_ul}    ${CellID}    ${Dlmod}=64QAM
    Dated Log new line          ${consTraceColor}=== Check BLER ${dl_or_ul} in ${Dlmod} === ${defColor}

    #this part help to set good PM counters value for 64 or 256 QAM - only DL are set -
    ${counters_initial_dl_transmission}=   set Variable if   '${Dlmod}'=='256QAM'    ${counters_initial_dl_transmission_256QAM}
    ...                                                                              ${counters_initial_dl_transmission}
    ${counters_success_dl_transmission}=   set Variable if   '${Dlmod}'=='256QAM'    ${counters_success_dl_transmission_256QAM}
    ...                                                                              ${counters_success_dl_transmission}
    ###

    # 1. Initial transmission
    @{counters_initial_transmission}        Run Keyword If          '${dl_or_ul}'=='DL'
    ...                                     Copy List         ${counters_initial_dl_transmission}
    ...                                     ELSE
    ...                                     Copy List         ${counters_initial_ul_transmission}

    ${num_of_initial_transmission}          Set Variable      0
    FOR    ${counter}    IN    @{counters_initial_transmission}
        ${value}              Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter}    object_id=${CellID}

        ${num_of_initial_transmission}      Evaluate          ${num_of_initial_transmission} + ${value}
    END
    Dated Log new line          ${consTraceColor}- Number of initial ${dl_or_ul} transmission: ${num_of_initial_transmission} ${defColor}

    # 2. Successful transmission
    @{counters_successful_transmission}     Run Keyword If          '${dl_or_ul}'=='DL'
    ...                                     Copy List         ${counters_success_dl_transmission}
    ...                                     ELSE
    ...                                     Copy List         ${counters_success_ul_transmission}

    ${num_of_successful_transmission}       Set Variable      0
    FOR    ${counter}    IN    @{counters_successful_transmission}

        ${value}              Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter}    object_id=${CellID}

        ${num_of_successful_transmission}     Evaluate        ${num_of_successful_transmission} + ${value}
    END
    Dated Log new line          ${consTraceColor}- Number of successful ${dl_or_ul} transmission: ${num_of_successful_transmission} ${defColor}

    ${bler_level}   Run Keyword If  ${num_of_initial_transmission}!=0
    ...             Evaluate    (${num_of_initial_transmission} - ${num_of_successful_transmission})*100 / ${num_of_initial_transmission}
    ...             ELSE
    ...             Set Variable    100

    Dated Log new line          ${consTraceColor}- BLER ${dl_or_ul}: ${bler_level}% (expected max ${maxBLER}%) ${defColor}
    ${Status}                   Set Variable If    ${bler_level} < ${maxBLER}    ${True}    ${False}
    [Return]                    ${Status}

BM_CB007487_L3_call
    [Documentation]                 Generic KW to attach/detach n UEs, with or without traffic
    ...                             Argument is a dictionary including following keys:
    ...                             loopNb:           number of loops "attach/traffic/detach"
    ...                             UEnb:             number of UEs to "attach/traffic/detach" simultaneously
    ...                             CallType:         NSA or SA (for all UEs)
    ...                             Cell:             Target cell (must be index 1, 2, ...)
    ...                             TrafficDuration:  duration of traffic (0 means no traffic)
    ...                             DLthroughput:     DL throughput
    ...                             ULthroughput:     UL throughput
    ...                             shouldBeStop:     To Stop or not traffic after TrafficDuration
    ...                             shouldBeCheck:    To Check or not traffic after TrafficDuration
    ...                             w_UE_CSI_TM_for_4_4_DL_MIMO:      with Cqi Ri airphone TestMode
    ...                             GetTtiTraceTime:  Time of TtiTrace
    ...                             GetL1L2TraceTime: Time of L1L2 Bip Trace
    ...                             num_of_cells_cellsetup:   Num of cell to check after CellSetup
    ...                             w_ue_detach:              With Or Without Ue Detach
    ...                             NOTE: If both DL and UL throughput are not null,
    ...                                   DL and UL traffic are launched simultaneously
    [Arguments]         ${dictParam}    ${BM}=none
    BuiltIn.Log      \nTest ${TEST_NAME} BM_CB007487_L3_call   console=yes
    Init Trace color

    ${CellID}                   set variable            ${NRCELL_ID_LIST[${dictParam.Cell}-1]}
    ${Expected_UEnb_attached}   Evaluate                ${dictParam.loopNb} * ${dictParam.UEnb}
    ${UEnb_attached}            Evaluate                0

    Dated log     =====> Start Btslog
    btslog.Start Btslog
    set Test variable     ${BtsLogStarted}    True

    BM_CB007487 cell setup     CallType=${dictParam.CallType}    num_of_cells=${dictParam.num_of_cells_cellsetup}

    Run Keyword If         ${enable_sherpa} == ${True}         Activate Sherpa

    Run Keyword If         '${dictParam.CallType}'=='SA'
    ...                    Run Keywords
    ...                        CallSetup.UE Register
    ...  AND                   CallSetup.UE Attach Check
    ...  AND                   CallSetup.Launch PDU Session
    ...  AND                   DL Traffic Feature BW        TP=${dictParam.DLthroughput}  ueSetting=${BASIC_UE_SA}  ue_id=1  scell_idx=0
    ...  AND                   UL Traffic Feature BW        TP=${dictParam.ULthroughput}  ueSetting=${BASIC_UE_SA}  ue_id=1  scell_idx=0
    ...  ELSE              Run Keywords
    ...                        CallSetup.SgNB Addition to ENB   ueSetting=${UE_SIMPLE}
    ...  AND                   UE Attach Check
    ...  AND                   DL Traffic Feature BW        TP=${dictParam.DLthroughput}  ueSetting=${UE_SIMPLE}    ue_id=11  scell_idx=8
    ...  AND                   UL Traffic Feature BW        TP=${dictParam.ULthroughput}  ueSetting=${UE_SIMPLE}    ue_id=11  scell_idx=8      

    #adding result for this run on csv file 
    ${text}   catenate     ${subFeature}; BENCHMARK_${BENCHMARK_ID}; ${test_env.duplex}; ${BF}; ${BM.NRdeploymentoptions}; ${BM.DL_Mod};
    ...                    ${BM.DL_MIMO}; ${BM.DL_MCS}; ${BM.UL_Mod}; ${BM.UL_MIMO}; ${BM.UL_MCS}; ${BM.Encrypt}; ${BM.CELL};
    ...                    ${Ue_Avg_PDSCH_Tput}; ${Ue_Avg_PUSCH_Tput}; ${test_env.gnbVersion}; ${test_env.simuVersion};

    Dated log              ${text}
    CS_Log Test results    ${text}

    Dated log     =====> Stop Btslog
    btslog.Stop Btslog     target_dir=${testCaseDir}
    set Test variable      ${BtsLogStarted}      False

    Run Keyword If         ${enable_sherpa} == ${True}    Sherpa.Deactivate Sherpa and Stop Collect    keep_pcap_file=True

    #Debut bloc a mettre au point
    # #NE FONCTIONNE PAS le decodage echoue :
