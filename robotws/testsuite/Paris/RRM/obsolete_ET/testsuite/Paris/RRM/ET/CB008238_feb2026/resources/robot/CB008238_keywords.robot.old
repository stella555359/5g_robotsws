#CB008238 Start Capture After GNB Ready
#    [Documentation]                 ORIGINAL CODE TO BE RESTORED WHEN THE PR803992 (ASIM board not detected) IS FIXED
#    ...                             DO NOT FORGET TO REMOVE TEMPORARY CODE BELOW
#
#    ${CaptureCPRT_setup}            Capture CPRT Set upon config
#    ${TestNameWOspace}              getFormattedTestName
#
#    ${CaptureCPRT_setup.filter}     Get Filter For SCTP
#    # Filter to use when CNI-78299 will be implemented again:
#    #${CaptureCPRT_setup.filter}     Get Filter For TCP
#    Capture Init                    ${CaptureCPRT_setup}             withTN=True             suffix=_setup
#
#    ${CaptureCore_setup}            Capture CORE Set Upon Config
#    Capture Init                    ${CaptureCore_setup}             withTN=True             suffix=_setup
#
#    Capture Start                   ${CaptureCPRT_setup}
#    Capture Start                   ${CaptureCore_setup}
#    Set Suite Variable              ${CaptureCPRT_setup}
#    Set Suite Variable              ${CaptureCore_setup}

CB008238 Start Capture After GNB Ready
    [Documentation]                 TEMPORARY CODE TO BE REMOVED WHEN THE PR803992 (ASIM board not detected) IS FIXED
    Dated log                       >>> WARNING: ASIM board not detected (PR803992)=> CPRT TRACES ARE TEMPORARILY INHIBITED
    ${TestNameWOspace}              getFormattedTestName
    ${CaptureCore_setup}            Capture CORE Set Upon Config
    Capture Init                    ${CaptureCore_setup}            withTN=True                     suffix=_setup
    Capture Start                   ${CaptureCore_setup}
    Set Suite Variable              ${CaptureCore_setup}


CB008238 Start Capture Attach
    [Arguments]                     ${UEid}=1
    ${TestNameWOspace}              getFormattedTestName

    ${CaptureCPRT_attach}           Capture CPRT Set upon config
    ${CaptureCPRT_attach.filter}    Get Filter For TCP
    Capture Init                    ${CaptureCPRT_attach}            withTN=True             suffix=_attach_${UEid}

    ${CaptureCore_attach}           Capture CORE Set Upon Config
    Capture Init                    ${CaptureCore_attach}            withTN=True             suffix=_attach_${UEid}

    Capture Start                   ${CaptureCPRT_attach}
    Capture Start                   ${CaptureCore_attach}
    Set Suite Variable              ${CaptureCPRT_attach}
    Set Suite Variable              ${CaptureCore_attach}


#CB008238 Capture Stop
#    [Documentation]                 ORIGINAL CODE TO BE RESTORED WHEN THE PR803992 (ASIM board not detected) IS FIXED
#    ...                             DO NOT FORGET TO REMOVE TEMPORARY CODE BELOW
#
#    [Arguments]                     ${step}
#    Run Keyword If                  "${step}" == "cellSetup"         Run Keywords
#    ...                             Capture Stop                     ${CaptureCore_setup}
#    ...                             AND
#    ...                             Capture Stop                     ${CaptureCPRT_setup}
#    Run Keyword If                  "${step}" == "Attach"            Run Keywords
#    ...                             Capture Stop                     ${CaptureCore_attach}
#    ...                             AND
#    ...                             Capture Stop                     ${CaptureCPRT_attach}


CB008238 Capture Stop
#    [Documentation]                 TEMPORARY CODE TO BE RESTORED WHEN THE PR803992 (ASIM board not detected) IS FIXED
    [Arguments]                     ${step}
    ...                             ${CPRTcapture}=${False}
    Dated log                       >>> WARNING: ASIM board not detected (PR803992) => CPRT TRACES ARE TEMPORARILY INHIBITED
    Run Keyword If                  "${step}" == "cellSetup" and ${CPRTcapture} == ${True}
    ...                             Capture Stop                     ${CaptureCPRT_setup}

    Run Keyword If                  "${step}" == "cellSetup"
    ...                             Capture Stop                     ${CaptureCore_setup}

    Run Keyword If                  "${step}" == "Attach" and ${CPRTcapture} == ${True}
    ...                             Capture Stop                     ${CaptureCPRT_attach}

    Run Keyword If                  "${step}" == "Attach"
    ...                             Capture Stop                     ${CaptureCore_attach}


##########################  TM BLER  ##########################
CB008238 activate DL BLER
    [Documentation]                 Activate DL BLER Target for the UE (per thousand).
    ...                             Number of elements correspond to 1st transmission, 2nd to 8th re-transmission
    ...                             e.g. BLER=200,100 means 20% initial BLER and 10% BLER on retrans.
    [Arguments]                     ${UEid}=1    ${BLER}=100

    # Define BLER configurations
    wtsemu.bler_testmode_nr         profile_id=${UEid}
    ...                             dl_bler=${BLER}

    wtsemu.ue_testmode_set_nr       id=${UEid}
    ...                             testmode=bler
    ...                             profile_id=${UEid}
    ...                             scell=${default_cell_bound}
    ...                             action=activate

CB008238 deactivate DL BLER
    [Documentation]                 Deactivate DL BLER Target for the UE
    [Arguments]                     ${UEid}=1

    wtsemu.ue_testmode_set_nr       id=${UEid}
    ...                             testmode=bler
    ...                             profile_id=${UEid}
    ...                             scell=${default_cell_bound}
    ...                             action=deactivate


#########################  Check KWs  #########################
CB008238 get PM files
    CB008238 Get Reporting Interval PM
    Traced Sleep                    ${reportingIntervalPm}[0]    msg=waiting PM counter generation
    ${pm_path}                      Set Variable                 ${LOG_PATH}/pm_files
    ${pm_latest}                    Collect PM files from BTS    ${pm_path}
    Set Suite Variable              ${pm_path}

CB008238 Get Reporting Interval PM
    ${CURRENT_SCF}                  OAM Get SCF File
    ...                             oam=${GNB_DU.oam}            file=SCF_DU_Current.xml
    SCF StartSession                scf_file=${CURRENT_SCF}
    ${dist_name}                    Set Variable                 MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/PMCADM-1
    ${reportingIntervalPm}          SCF Get Single Value         ${dist_name}           reportingIntervalPm
    SCF StopSession                 scf_file=${CURRENT_SCF}
    Dated Log new line              ${trcColor}- ReportingIntervalPm is: ${reportingIntervalPm} ${defColor}
    Set Suite Variable              ${reportingIntervalPm}

CB008238 check CellSetup
    [Arguments]                     ${actDtxOptimzedScheduler}    ${MaxRetentionDelay}    ${dtxPrbThreshold}
    Dated Log new line              ${trcColor}=== Check cell setup ${defColor}

    ${pdmlFile}                     analyzer.pcap_to_pdml         ${CaptureCPRT_setup.path}

    ${actDtxOptimzedSchedulerVal}     Set Variable If   '${actDtxOptimzedScheduler}'=='true'    True    False
    ${MaxRetentionDelayHexa}          Convert To Hex    ${MaxRetentionDelay}   prefix=0x    length=4    lowercase=${True}
    ${dtxPrbThresholdHexa}            Convert To Hex    ${dtxPrbThreshold}     prefix=0x    length=4    lowercase=${True}

    ${actDtxOptimzedSchedulerPath}    set variable       itf_l2_ps_cell_CellSetupReq_t.actDtxOptimizedScheduler
    ${MaxRetentionDelayPath}          set variable       itf_l2_ps_DtxOptimizedScheduler.dtxMaxRetentionDelay
    ${dtxPrbThresholdPath}            set variable       itf_l2_ps_DtxOptimizedScheduler.dtxPrbThreshold

    analyzer.check_exists_once      pdmlFile=${pdmlFile}
    ...                             packetName=itf_l2_ps_cell_cellsetupreq
    ...                             path=${actDtxOptimzedSchedulerPath}
    ...                             value=${actDtxOptimzedSchedulerVal}

    analyzer.check_exists_once      pdmlFile=${pdmlFile}
    ...                             packetName=itf_l2_ps_cell_cellsetupreq
    ...                             path=${MaxRetentionDelayPath}
    ...                             value=${MaxRetentionDelay}

    analyzer.check_exists_once      pdmlFile=${pdmlFile}
    ...                             packetName=itf_l2_ps_cell_cellsetupreq
    ...                             path=${dtxPrbThresholdPath}
    ...                             value=${dtxPrbThreshold}

CB008238 check DL Data Volume
    [Arguments]                 ${QCI}    ${expectedDataVol}
    Dated Log new line          ${trcColor}=== Check DL data volume counters for ${QCI} ${defColor}

    ${counter_dataVol}          Get From Dictionary     ${counter_DL_RLCdataPDUvolume}     ${QCI}
    ${data_volume}              Retrieve Counter Sum of Values From Pm Files For Object With Name
    ...                         ${pm_path}     NRCELL    ${counter_dataVol}    object_id=${NRCELL_ID}

    Dated Log new line          ${trcColor}- ${counter_dataVol} : ${data_volume} (expected ${expectedDataVol}) ${defColor}
    ${Status}                   Set Variable If    ${data_volume} > ${expectedDataVol}    ${True}    ${False}
    [Return]                    ${Status}

CB008238 check DL BLER
    [Arguments]                 ${maxBLER}=10
    Dated Log new line          ${trcColor}=== Check DL BLER ${defColor}

    # 1. Initial transmission
    ${num_of_initial_transmission}          Set Variable      0
    FOR    ${counter}    IN    @{counters_initial_dl_transmission}
        ${value}              Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter}    object_id=${NRCELL_ID}

        ${num_of_initial_transmission}      Evaluate          ${num_of_initial_transmission} + ${value}
    END
    Dated Log new line          ${trcColor}- Number of initial DL transmission: ${num_of_initial_transmission} ${defColor}

    # 2. Successful transmission
    ${num_of_successful_transmission}       Set Variable      0
    FOR    ${counter}    IN    @{counters_success_dl_transmission}

        ${value}              Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter}    object_id=${NRCELL_ID}

        ${num_of_successful_transmission}     Evaluate        ${num_of_successful_transmission} + ${value}
    END
    Dated Log new line          ${trcColor}- Number of successful DL transmission: ${num_of_successful_transmission} ${defColor}

    ${bler_level}   Run Keyword If  ${num_of_initial_transmission}!=0
    ...             Evaluate    (${num_of_initial_transmission} - ${num_of_successful_transmission})*100 / ${num_of_initial_transmission}
    ...             ELSE
    ...             Set Variable    100

    Dated Log new line          ${trcColor}- DL BLER: ${bler_level}% (expected max ${maxBLER}%) ${defColor}
    ${Status}                   Set Variable If    ${bler_level} < ${maxBLER}    ${True}    ${False}
    [Return]                    ${Status}

CB008238 get Average Delay
    [Arguments]                 ${QCI}
    Dated Log new line          ${trcColor}=== Compute average delay for ${QCI} ${defColor}

    ${counter_sumDelay}         Get From Dictionary     ${counter_DL_RLC_sumDelay}     ${QCI}
    ${counter_PDUnb}            Get From Dictionary     ${counter_DL_PDCP_SDUnb}       ${QCI}
    ${sumDelay}                 Retrieve Counter Sum of Values From Pm Files For Object With Name
    ...                         ${pm_path}     NRCELL    ${counter_sumDelay}    object_id=${NRCELL_ID}
    ${PDUnb}                    Retrieve Counter Sum of Values From Pm Files For Object With Name
    ...                         ${pm_path}     NRDU    ${counter_PDUnb}       object_id=1

    ${AverageDelay}             Evaluate    ${sumDelay} / ${PDUnb} / 1000.0
    Dated Log new line          ${trcColor}- Average delay for ${QCI} : ${AverageDelay} ${defColor}
    [Return]                    ${AverageDelay}

CB008238 get uDTX counters
        ${uDTX_OPTIMIZED}     Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter_MICRO_DTX_OPTIMIZED}    object_id=${NRCELL_ID}
        ${uDTX_NO_BUNDLING}   Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter_MICRO_DTX_NO_BUNDLING}    object_id=${NRCELL_ID}
        [Return]              ${uDTX_OPTIMIZED}    ${uDTX_NO_BUNDLING}

CB008238 get number of slot with PDSCH
        ${SlotWithPDSCH}      Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter_DataSlotWithPDSCH}    object_id=${NRCELL_ID}
        [Return]              ${SlotWithPDSCH}


####################  Setup/Teardown KWs  ####################
CB008238 Test Setup
    [Documentation]             Perform needed actions at the begining of a test case
    Init Trace color

CB008238 Test Teardown
    [Documentation]             Perform needed actions at the end of a test case
    Restore Files               listFileDesc=${FD_ALL}

    # "Test Teardown" KW from Setup.robot
    Test Teardown

Init Trace color
    ${trcColor}                 Evaluate    "${CYAN}"
    ${defColor}                 Evaluate    "${NORMAL}"
    ${OkColor}                  Evaluate    "${GREEN}"
    Set Suite Variable          ${trcColor}
    Set Suite Variable          ${defColor}
    Set Suite Variable          ${OkColor}
