*** Keywords ***
CB008238 CellSetup
    [Documentation]                 Keyword to configure the TL.
    ...                             Common parameters:
    ...                               actDtxOptimzedScheduler: enable/disable uDTX, default: true
    ...                               MaxRetentionDelay: max retention delay value, default: 10
    ...                               dtxPrbThreshold: uDTX PRB threshold, default: 100 to disable it
    ...                               CallType: NSA or SA, default: NSA
    ...                               nbUe: number of UEs to configure, default: 1
    ...                             Parameters associated to a TC:
    ...                               actPdschAtSsbSlots: enable/disable scheduling on SSB, default: false
    ...                               VoNR: to configure VoNR environment, default: false
    ...                               PRBblanking: to configure PRB blanking environment, default: false
    ...                               CS1size: uDTX CS1 size threshold, default: 0 to disable it
    ...                               CS1Threshold: enable/disable uDtx Nb of UE Cs1 Threshold, default: false
    ...                               dtxDelaySinceLastScheduling: uDTX delay since last scheduling, default: 0 to disable it
    ...                               actNonGbrServiceDif: enable/disable scheduling weight, default: false
    ...                               schedulWeight: scheduling weight of the default bearer, default: 1
    [Arguments]                     ${actDtxOptimzedScheduler}=true    ${MaxRetentionDelay}=10        ${dtxPrbThreshold}=100
    ...                             ${CallType}=NSA                    ${actPdschAtSsbSlots}=false    ${VoNR}=false
    ...                             ${nbUe}=1                          ${PRBblanking}=false           ${CS1size}=0
    ...                             ${CS1Threshold}=false              ${dtxDelaySinceLastScheduling}=0
    ...                             ${actNonGbrServiceDiff}=false      ${schedulWeight}=1             ${actDl256Qam}=false
    CB008238 Config                 actDtxOptimzedScheduler=${actDtxOptimzedScheduler}    MaxRetentionDelay=${MaxRetentionDelay}
    ...                             dtxPrbThreshold=${dtxPrbThreshold}   actPdschAtSsbSlots=${actPdschAtSsbSlots}
    ...                             VoNR=${VoNR}    PRBblanking=${PRBblanking}    CS1size=${CS1size}    CallType=${CallType}
    ...                             CS1Threshold=${CS1Threshold}    dtxDelaySinceLastScheduling=${dtxDelaySinceLastScheduling}
    ...                             actNonGbrServiceDiff=${actNonGbrServiceDiff}      schedulWeight=${schedulWeight}
    ...                             actDl256Qam=${actDl256Qam}
    Dated Log new line              ${trcColor}--- Restart TL ${defColor}
    Restart TL
    CB008238 Start Capture After GNB Ready
    Dated Log new line              ${trcColor}--- WTS setup ${CallType} ${defColor}
    Run Keyword If                  "${CallType}" == "NSA"     WTS setup    nbUe=${nbUe}
    Run Keyword If                  "${CallType}" == "SA"      Setup Wtsemu SA    nbUe=${nbUe}    nbSaUe=${nbUe}    shouldUseLua=${True}
    CB008238 Capture Stop           cellSetup

CB008238 CellSetup CA
    [Arguments]                     ${actDtxOptimzedScheduler}=true    ${MaxRetentionDelay}=10                 ${dtxPrbThreshold}=100
    ...                             ${CallType}=SA                     ${sCellActivationMethod}=blind    ${sCellDeactivationTimerGNB}=infinity
    ...                             ${nbUe}=3                          ${dtxDelaySinceLastScheduling}=0        ${actDl256Qam}=false
    Dated Log                       WARNING - RF50 W0919 Keyword argument '${actDl256Qam}' is not used
    CB008238 Config CA              actDtxOptimzedScheduler=${actDtxOptimzedScheduler}    MaxRetentionDelay=${MaxRetentionDelay}
    ...                             dtxPrbThreshold=${dtxPrbThreshold}   sCellActivationMethod=${sCellActivationMethod}
    ...                             sCellDeactivationTimerGNB=${sCellDeactivationTimerGNB}
    ...                             dtxDelaySinceLastScheduling=${dtxDelaySinceLastScheduling}

    Dated Log new line              ${trcColor}--- Restart TL ${defColor}
    Restart TL
    CB008238 Start Capture After GNB Ready
    Dated Log new line              ${trcColor}--- WTS setup ${CallType} ${defColor}
    Run Keyword If                  "${CallType}" == "SA"      Setup Wtsemu SA    nbUe=${nbUe}    nbSaUe=${nbUe}    shouldUseLua=${False}
    CB008238 Capture Stop           cellSetup CA

CB008238 Attach NSA
    [Arguments]                     ${ueSetting}    ${CPRTcapture}=${False}
    Dated Log new line              ${trcColor}--- NSA call UE ${ueSetting.ue} ${defColor}
    Run Keyword If                  ${CPRTcapture} == ${True}
    ...                             CB008238 Start Capture Attach       UE=${ueSetting.ue}
    SgNB Addition to ENB            ueSetting=${ueSetting}
    Run Keyword If                  ${CPRTcapture} == ${True}
    ...                             CB008238 Capture Stop               Attach


CB008238 Attach SA
    [Arguments]                     ${ueSetting}    ${CPRTcapture}=${False}    ${VoNR}=false
    Dated Log new line              ${trcColor}--- SA call UE ${ueSetting.ue} ${defColor}
    Run Keyword If                  ${CPRTcapture} == ${True}
    ...                             CB008238 Start Capture Attach       UE=${ueSetting.ue}
    UE Register                     ue=${ueSetting.ue}
    Launch PDU Session              ue=${ueSetting.ue}    pdu=${ueSetting.ue}    gw=${ueSetting.ue}
    Run Keyword If                  '${VoNR}'=='true'
    ...                             CB008238 Modify PDU for VoNR        ueSetting=${ueSetting}
    Run Keyword If                  ${CPRTcapture} == ${True}
    ...                             CB008238 Capture Stop               Attach


CB008238 Modify PDU for VoNR
    [Arguments]                     ${ueSetting}
    UE PDU Session Modify           ue=${ueSetting.ue}    pdu=${ueSetting.ue}    qfta=2    by=amf
    UE PDU Session Modify           ue=${ueSetting.ue}    pdu=${ueSetting.ue}    qfta=3    by=amf


CB008238 Set VoNR UE Capa
    ${UEcapa}                       Set Variable If       '${duplexMode}' == 'TDD'    ${UEcapa_VoNR_TDD}    ${UEcapa_VoNR_FDD}
    Modify Field in WtsEmu Cfg File    field=ue_nr_capabilities    value=${UEcapa}


CB008238 Get Config PRBblanking
    &{NIDD_actPRBBlanking}                   Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                           parameter=actPRBBlanking
    ...                                                           value=true

    &{NIDD_trsMutingInBlankedPRBsEnabled}    Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                           parameter=trsMutingInBlankedPRBsEnabled
    ...                                                           value=true

    #&{NIDD_actConnectivitySilver}            Create Dictionary    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    #...                                                           parameter=actGeneralConnectivitySilver
    #...                                                           value=true

    #&{NIDD_actConnectivityGold}              Create Dictionary    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    #...                                                           parameter=actGeneralConnectivityGold
    #...                                                           value=true

    &{NIDD_aggregationLevel}                 Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                           parameter=aggregationLevel
    ...                                                           value=4CCEs

    &{NIDD_nbrOfBlankedPRBsLowEdgeDL}        Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                           parameter=nbrOfBlankedPRBsLowEdgeDL
    ...                                                           value=6

    &{NIDD_nbrOfBlankedPRBsLowEdgeUL}        Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                           parameter=nbrOfBlankedPRBsLowEdgeUL
    ...                                                           value=6

    @{param_list_PRBblanking}       Create List          ${NIDD_actPRBBlanking}    ${NIDD_trsMutingInBlankedPRBsEnabled}
    ...                                                  ${NIDD_nbrOfBlankedPRBsLowEdgeDL}    ${NIDD_nbrOfBlankedPRBsLowEdgeUL}
    ...                                                  ${NIDD_aggregationLevel}

    [Return]    ${param_list_PRBblanking}


CB008238 Set CS1sizeThreshold
    [Arguments]                     ${CS1size}
    ${prd_DtxCS1SizeThreshold}      Create Dictionary    field=${RD_DtxCS1SizeThreshold}      value=${CS1size}
    ${list_rad_param}               Create List          ${prd_DtxCS1SizeThreshold}
    Set Fields in swconfig DU       param_list=${list_rad_param}


CB008238 Set CellNbUeCs1PercentThreshold
    [Arguments]                     ${CS1Threshold}
    Dated Log                       WARNING - RF50 W0919 Keyword argument '${CS1Threshold}' is not used
    ${prd_CS1percentThresholdHigh}  Create Dictionary    field=${RD_DtxCellNbUeCs1ThresholdHigh_percent}   value=${Cs1ThresholdHigh}
    ${prd_CS1percentThresholdLow}   Create Dictionary    field=${RD_DtxCellNbUeCs1ThresholdLow_percent}    value=${Cs1ThresholdLow}
    ${prd_CellEnablingTimer}        Create Dictionary    field=${RD_DtxCellEnablingTimer_ms}               value=${DtxCellEnablingTimer}
    ${list_rad_param}               Create List          ${prd_CS1percentThresholdHigh}    ${prd_CS1percentThresholdLow}
    ...                                                  ${prd_CellEnablingTimer}
    Set Fields in swconfig DU       param_list=${list_rad_param}


CB008238 Get Config schedulWeight
    [Arguments]                     ${schedulWeight}    ${CallType}=NSA
    &{NIDD_actNonGbrServiceDiff}    Create Dictionary    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...                                                  parameter=actNonGbrServiceDiff
    ...                                                  value=true

    ${bearerToFind}                 Set Variable If      "${CallType}" == "NSA"    9    6
    ${distName}                     OAM Get nrDrbDN      callType=${CallType}    bearerId=${bearerToFind}    oam=${GNB_DU.oam}
    &{NIDD_schedulWeight}           Create Dictionary    dist_name=${distName}
    ...                                                  parameter=schedulWeight
    ...                                                  value=${schedulWeight}

    @{param_list_schedulWeight}     Create List          ${NIDD_actNonGbrServiceDiff}    ${NIDD_schedulWeight}

    [Return]    ${param_list_schedulWeight}


CB008238 Config
    [Arguments]                     ${actDtxOptimzedScheduler}=true    ${MaxRetentionDelay}=20    ${dtxPrbThreshold}=100
    ...                             ${actPdschAtSsbSlots}=false        ${VoNR}=false    ${PRBblanking}=false    ${CS1size}=0
    ...                             ${CallType}=NSA                    ${CS1Threshold}=false      ${dtxDelaySinceLastScheduling}=0
    ...                             ${actNonGbrServiceDiff}=false      ${schedulWeight}=1         ${actDl256Qam}=false

    Run Keyword If                  '${VoNR}'=='true'                  CB008238 Set VoNR UE Capa
    Run Keyword If                  ${CS1size}!=0                      CB008238 Set CS1sizeThreshold    CS1size=${CS1size}
    Run Keyword If                  '${CS1Threshold}'=='true'          CB008238 Set CellNbUeCs1PercentThreshold    CS1Threshold=${CS1Threshold}

    &{NIDD_actInactDetNSAUe}        Create Dictionary    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...                                                  parameter=actInactDetNSAUe
    ...                                                  value=false

    &{NIDD_actDtxOptimSched}        Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                  parameter=actDtxOptimizedScheduler
    ...                                                  value=${actDtxOptimzedScheduler}

    &{NIDD_dtxOptimSched_val}       Create Dictionary    dtxMaxRetentionDelay=${MaxRetentionDelay}
    ...                                                  dtxPrbThreshold=${dtxPrbThreshold}
    ...                                                  dtxDelaySinceLastScheduling=${dtxDelaySinceLastScheduling}

    &{NIDD_dtxOptimSched_struct}    Evaluate
    ...                             {'dist_name':'${NRCELL_DIST_NAME}','parameter':'dtxOptimizedScheduler','value':[&{NIDD_dtxOptimSched_val}]}

    &{NIDD_actVoNR}                 Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                  parameter=actVoNR
    ...                                                  value=${VoNR}

    &{NIDD_actPdschAtSsbSlots}      Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                  parameter=actPdschAtSsbSlots
    ...                                                  value=${actPdschAtSsbSlots}

    &{NIDD_actPdschRmCsirsForTracking}    Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                  parameter=actPdschRmCsirsForTracking
    ...                                                  value=${actPdschAtSsbSlots}

    &{NIDD_Dl256Qam}                Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                  parameter=actDl256Qam
    ...                                                  value=${actDl256Qam}

    @{param_list}                   Create List          ${NIDD_actInactDetNSAUe}        ${NIDD_actDtxOptimSched}
    ...                                                  ${NIDD_dtxOptimSched_struct}    ${NIDD_actVoNR}
    ...                                                  ${NIDD_actPdschAtSsbSlots}      ${NIDD_actPdschRmCsirsForTracking}
    ...                                                  ${NIDD_Dl256Qam}

    @{param_list_PRBblanking}       Run Keyword If      '${PRBblanking}'=='true'    CB008238 Get Config PRBblanking
    ...                             ELSE                Create List

    @{param_list_ServiceDiff}       Run Keyword If      '${actNonGbrServiceDiff}'=='true'
    ...                             CB008238 Get Config schedulWeight    schedulWeight=${schedulWeight}    CallType=${CallType}
    ...                             ELSE                Create List

    ${param_scf}                    Combine lists       ${param_list}    ${param_list_PRBblanking}    ${param_list_ServiceDiff}

    Dated Log new line              ${trcColor}--- Updating SCF file with: ${param_scf} ${defColor}
    OAM Set Params                  ${param_scf}


CB008238 Config CA
    [Arguments]                     ${actDtxOptimzedScheduler}=true    ${MaxRetentionDelay}=10    ${dtxPrbThreshold}=100
    ...                             ${sCellActivationMethod}=blind     ${sCellDeactivationTimerGNB}=infinity
    ...                             ${dtxDelaySinceLastScheduling}=0

    &{NIDD_actDtxOptimSched}        Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                  parameter=actDtxOptimizedScheduler
    ...                                                  value=${actDtxOptimzedScheduler}
    ...                                                  dtxDelaySinceLastScheduling=${dtxDelaySinceLastScheduling}

    &{NIDD_actDtxOptimSched_cell2}  Create Dictionary    dist_name=MRBTS-1/NRBTS-1/NRCELL-3
    ...                                                  parameter=actDtxOptimizedScheduler
    ...                                                  value=${actDtxOptimzedScheduler}
    ...                                                  dtxDelaySinceLastScheduling=${dtxDelaySinceLastScheduling}

    &{NIDD_dtxOptimSched_val}       Create Dictionary    dtxMaxRetentionDelay=${MaxRetentionDelay}
    ...                                                  dtxPrbThreshold=${dtxPrbThreshold}

    &{NIDD_dtxOptimSched_struct}    Evaluate
    ...                             {'dist_name':'${NRCELL_DIST_NAME}','parameter':'dtxOptimizedScheduler','value':[&{NIDD_dtxOptimSched_val}]}

    &{NIDD_dtxOptimSched_struct_2}  Evaluate
    ...                             {'dist_name':'MRBTS-1/NRBTS-1/NRCELL-3','parameter':'dtxOptimizedScheduler','value':[&{NIDD_dtxOptimSched_val}]}

    &{NIDD_sCellDeactTimer}         Create Dictionary    dist_name=${NRCELL_DIST_NAME}
    ...                                                  parameter=sCellDeactivationTimerGNB
    ...                                                  value=${sCellDeactivationTimerGNB}

    # NRCELL-3 is 60 MHz TDD with variant VARIANT_SANSA_FS_ECPRI_CMWV_FDD+TDD
    &{NIDD_sCellDeactTimer_cell2}   Create Dictionary    dist_name=MRBTS-1/NRBTS-1/NRCELL-3
    ...                                                  parameter=sCellDeactivationTimerGNB
    ...                                                  value=${sCellDeactivationTimerGNB}

    &{NIDD_sCellActivationMethod}   Create Dictionary    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...                                                  parameter=sCellActivationMethod
    ...                                                  value=${sCellActivationMethod}

    @{param_list}                   Create List          ${NIDD_actDtxOptimSched}        ${NIDD_dtxOptimSched_struct}
    ...                                                  ${NIDD_actDtxOptimSched_cell2}  ${NIDD_dtxOptimSched_struct_2}

    @{param_list_CA}                Create List          ${NIDD_sCellActivationMethod}   ${NIDD_sCellDeactTimer}
    ...                                                  ${NIDD_sCellDeactTimer_cell2}

    ${param_scf}                    Combine lists        ${param_list}    ${param_list_CA}

    Dated Log new line              ${trcColor}--- Updating SCF file with: ${param_scf} ${defColor}
    OAM Set Params                  ${param_scf}


