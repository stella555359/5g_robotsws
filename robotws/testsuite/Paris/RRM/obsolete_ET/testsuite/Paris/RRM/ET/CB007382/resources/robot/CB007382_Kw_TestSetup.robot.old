&{BurstLevel100}    load_type=burstLoad
...                 load_level_burst=burst_100
...                 num_of_ssb_beam_pattern_id=ssb_8
...                 ssb_beam_pattern_id=${ssb_beam_pattern_id_list_8}
...                 burstlevel=100
...                 NumOfPdschSlots=8
...                 SumOfDlSymbols=104

&{Subfeature}       Subfeature_A=A
...                 Subfeature_B=B
...                 Subfeature_C=C
...                 Subfeature_D=D

&{Freq_Range}       above_3GHz=FR1
...                 below_3GHz=FR1
...                 above_6GHz=FR2

&{TM_100MHzFR1}         seq=${T1}           scf=${Scf100MHzFR1}             Context=${Context}

&{TM_20MHzFR1}          seq=${T2}           scf=${Scf20MHzFR1}              Context=${Context}

&{TM_100MHzFR2}         seq=${T3}           scf=${Scf100MHzFR2}             Context=${Context}






