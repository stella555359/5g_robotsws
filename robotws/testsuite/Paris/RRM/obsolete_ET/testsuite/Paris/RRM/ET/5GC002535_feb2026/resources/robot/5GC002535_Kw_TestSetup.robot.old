*** Keywords ***
# robocop: off=unused-argument
# robocop: off=possible-variable-overwriting
##################################################################################

gNB_ModifySCFwithNewGNBID
    [Arguments]    ${scf_path}    ${gnbID}=NRBTS-1
    run    command=sed -i 's|NRBTS-1|${gnbID}|g' ${scf_path}

gNB_ModifySCFwithNewNRBTS
    [Arguments]    ${scf_path}    ${nrbtsID_original}=NRBTS-1     ${nrbtsID_new}=NRBTS-1
    run    command=sed -i 's|${nrbtsID_original}|${nrbtsID_new}|g' ${scf_path}

gNB_ModifySCFwithNewMRBTS
    [Arguments]    ${scf_path}    ${mrbtsID_original}=MRBTS-1     ${mrbtsID_new}=MRBTS-1
    run    command=sed -i 's|${mrbtsID_original}|${mrbtsID_new}|g' ${scf_path}

add PDCCH 5MHz cellBwpList to SCF
    [Arguments]    ${scf_file_path}
    log to console    Add PDCCH 5MHz cellBwpList to SCF
    scf.Load scf    ${scf_file_path}
    ${dist_name}  set variable  MRBTS-1/NRBTS-1/NRCELL-1
    ${result}  scf.is_list_in_object  dist_name=${dist_name}     list_name=cellBwpList
    run keyword if    ${result}==True    scf.remove_list_from_scf  dist_name=${dist_name}   list_name=cellBwpList
    scf.add list to scf  dist_name=${dist_name}   list_name=cellBwpList
    FOR    ${item}    IN    @{SANSA_5MHZ_LIST_ITEMS_PARAMS_TO_DELETE}
         scf.add item to list  dist_name=${item}[dist_name]    list_name=${item}[list_name]    elements=${item}[elements]
    END
    scf.Save scf    ${scf_file_path}
    [Return]    ${scf_file_path}

add PDCCH 15MHz cellBwpList to SCF
    [Arguments]    ${scf_file_path}
    log to console    Add PDCCH 15MHz cellBwpList to SCF
    scf.Load scf    ${scf_file_path}
    ${dist_name}  set variable  MRBTS-1/NRBTS-1/NRCELL-1
    ${result}  scf.is_list_in_object  dist_name=${dist_name}     list_name=cellBwpList
    run keyword if    ${result}==True    scf.remove_list_from_scf  dist_name=${dist_name}   list_name=cellBwpList
    scf.add list to scf  dist_name=${dist_name}   list_name=cellBwpList
    FOR    ${item}    IN    @{1SANSA_5MHZ_LIST_ITEMS_PARAMS_TO_DELETE}
         scf.add item to list  dist_name=${item}[dist_name]    list_name=${item}[list_name]    elements=${item}[elements]
    END
    scf.Save scf    ${scf_file_path}
    [Return]    ${scf_file_path}

Get scf file name
    [Arguments]    ${scf_file_path}   ${extension}=${EMPTY}
    ${scf_file_name}    Fetch from right    ${scf_file_path}    /
    ${file_name_without_extension}    String.Replace string    ${scf_file_name}    .xml    ${EMPTY}
    ${scf_name_for_update}    catenate    SEPARATOR=${EMPTY}    ${file_name_without_extension}
    ...    ${extension}
    [return]    ${scf_name_for_update}

Delete PDCCH Information If Exist
    [Documentation]   Author: Ch SAMSON
    [Arguments]    ${scf_file_path_du}   ${scf_file_path_cu}=${EMPTY}   ${nodeType}=Classical
    log to console    Delete PDCCH Information If Exist
    ${default_scf_file_path_du}    Copy file    source=${scf_file_path_du}    destination=${LOG_PATH}/PDCCH_delete/
    ${default_scf_file_path_cu}   run keyword if    '${scf_file_path_cu}'!='${EMPTY}'      Copy file    source=${scf_file_path_cu}
    ...                                                                                                 destination=${LOG_PATH}/PDCCH_delete/
    ...    ELSE                                                                            set variable    ${EMPTY}
    ${scf_name_for_update}=    Get scf file name     ${scf_file_path_du}    _PDCCH_delete.xml
    ${scf_name_for_update_cu}=    run Keyword if  '${scf_file_path_cu}'!='${EMPTY}'    Get scf file name     ${scf_file_path_cu}   _PDCCH_delete.xml
    ...    ELSE                                                                        set variable    ${EMPTY}
    ${scf_file_update_path}    set variable    ${LOG_PATH}/PDCCH_delete/${scf_name_for_update}
    ${scf_file_update_path_cu}    set variable if    '${scf_file_path_cu}'!='${EMPTY}'    ${LOG_PATH}/PDCCH_delete/${scf_name_for_update_cu}
    ...                                                                                    ${EMPTY}
    scf.Load scf    ${default_scf_file_path_du}
    run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Load scf    ${default_scf_file_path_cu}
    # ${MNL_version}=    scf.get_mo_attribute    MRBTS-1/MNL-1    version
    FOR    ${item}    IN    @{SANSA_5MHZ_PARAMS_TO_ADD}
        ${result}    scf.is_object_in_scf    dist_name=${item}[dist_name]     nodeType=${item}[nodeType]
        run keyword if    ${result}==True    scf.remove_mo_with_descendant_mos    dist_name=${item}[dist_name]     nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{SANSA_15MHZ_PARAMS_TO_ADD}
        ${result}    scf.is_object_in_scf    dist_name=${item}[dist_name]    nodeType=${item}[nodeType]
        run keyword if    ${result}==True    scf.remove_mo_with_descendant_mos    dist_name=${item}[dist_name]    nodeType=${item}[nodeType]
    END

    # modify list under object
    # MRBTS-1/NRBTS-1/NRCELL-1
    # cellBwpList
    ${dist_name}  set variable  MRBTS-1/NRBTS-1/NRCELL-1
    ${result}  scf.is_list_in_object  dist_name=${dist_name}     list_name=cellBwpList    nodeType=${nodeType}
    run keyword if    ${result}==True    scf.remove_list_from_scf  dist_name=${dist_name}   list_name=cellBwpList    nodeType=${nodeType}
    scf.add list to scf  dist_name=${dist_name}   list_name=cellBwpList    nodeType=${nodeType}

    ${nodeType_}     set variable if    '${nodeType}'=='Classical'        Classical
    ...                                                                   Vdu
    scf.Save scf    file_path=${scf_file_update_path}    nodeType=${nodeType_}
    run Keyword if    '${scf_file_path_cu}'!='${EMPTY}'       scf.Save scf   file_path=${scf_file_update_path_cu}      nodeType=Vcu
    [Return]    ${scf_file_update_path}     ${scf_file_update_path_cu}

get nrcell version VcuVdu
     [Arguments]   ${scf_file_path_du}   ${scf_file_path_cu}
     scf.Load scf      ${scf_file_path_du}
     run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Load scf    ${scf_file_path_cu}

     ${nrcell_version1}=    scf.get_mo_attribute    MRBTS-1/NRBTS-1/NRCELL-1/NRCELL_FDD-1     version   nodeType=Vcu
     ${nodeType_1}=    set variable      Vcu
     ${nrcell_version2}=    scf.get_mo_attribute    MRBTS-1/NRBTS-1/NRCELL-1/NRCELL_FDD-1     version   nodeType=Vdu
     ${nodeType_2}=    set variable      Vdu
     [return]    ${nrcell_version1}   ${nodeType_1}   ${nrcell_version2}   ${nodeType_2}

get nrcell version nodeType
     [Arguments]   ${scf_file_path_du}   ${scf_file_path_cu}   ${nodeType}=Classical
     scf.Load scf      ${scf_file_path_du}
     run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Load scf    ${scf_file_path_cu}

     ${nrcell_version1}=   scf.get_mo_attribute    MRBTS-1/NRBTS-1/NRCELL-1/NRCELL_FDD-1     version   nodeType=${nodeType}
     ${nodeType_1}=        set variable       ${nodeType}
     ${nrcell_version2}=   set variable       ${EMPTY}
     ${nodeType_2}=        set variable       ${EMPTY}
     [return]    ${nrcell_version1}   ${nodeType_1}   ${nrcell_version2}   ${nodeType_2}

get nrcell version
     [Arguments]   ${scf_file_path_du}   ${scf_file_path_cu}   ${nodeType}=Classical
     ${nrcell_version1}   ${nodeType_1}  ${nrcell_version2}   ${nodeType_2}=   run Keyword if   '${nodeType}'=='VcuVdu' or '${nodeType}'=='VduVcu'
     ...                get nrcell version VcuVdu       ${scf_file_path_du}    ${scf_file_path_cu}
     ...   ELSE         get nrcell version nodeType     ${scf_file_path_du}    ${scf_file_path_cu}   nodeType=${nodeType}
     &{nrcell_version_1}    Create Dictionary
     ...    nodeType=${nodeType_1}
     ...    nrcell_version=${nrcell_version1}
     &{nrcell_version_2}    Create Dictionary
     ...    nodeType=${nodeType_2}
     ...    nrcell_version=${nrcell_version2}
     @{nrcell_version_param}    Create List    ${nrcell_version_1}
     ...                ${nrcell_version_2}
     [return]   ${nrcell_version_param}

Add PDCCH information to scf
    [Documentation]   Author: Ch SAMSON
    [Arguments]    ${scf_file_path}    ${scf_file_path_cu}=${EMPTY}   ${nodeType}=Classical
    log to console    Add PDCCH information to scf
    ${default_scf_file_path}    Copy file    source=${scf_file_path}    destination=${LOG_PATH}/PDCCH_add/
    ${default_scf_file_vcu_path}    run Keyword if    '${scf_file_path_cu}'!='${EMPTY}'    Copy file    source=${scf_file_path_cu}
    ...                                                                                                 destination=${LOG_PATH}/PDCCH_add/
    ${scf_name_for_update}=       Get scf file name     ${scf_file_path}    _PDCCH_add.xml
    ${scf_name_for_update_cu}=    run Keyword if    '${scf_file_path_cu}'!='${EMPTY}'    Get scf file name     ${scf_file_path_cu}    _PDCCH_add.xml
    ...    ELSE                                                                          set variable    ${EMPTY}

    ${scf_file_update_path}       set variable    ${LOG_PATH}/PDCCH_add/${scf_name_for_update}
    ${scf_file_update_path_cu}    set variable if    '${scf_file_path_cu}'!='${EMPTY}'    ${LOG_PATH}/PDCCH_add/${scf_name_for_update_cu}
    ...                                                                                    ${EMPTY}

    ${nrcell_version}=    get nrcell version     ${scf_file_path}    ${scf_file_path_cu}   ${nodeType}
    Dated log     nrcell_version=${nrcell_version}

    scf.Load scf    ${default_scf_file_path}
    run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Load scf    ${default_scf_file_vcu_path}
    # ${nrcell_version}=    scf.get_mo_attribute    MRBTS-${MRBTS_ID}/NRBTS-2/NRCELL-1/NRCELL_FDD-1    version
    # ${nrcell_version}=    scf.get_mo_attribute    MRBTS-1/NRBTS-1/NRCELL-1/NRCELL_FDD-1     version   nodeType=${nodeType}
    # ${MNL_version}=    scf.get_mo_attribute    MRBTS-1/MNL-1      version    nodeType=${nodeType}

    FOR    ${item}    IN    @{SANSA_5MHZ_PARAMS_TO_ADD}
        # scf.add object to scf  class_name=${item}[class_name]  dist_name=${item}[dist_name]  version=${nrcell_version}   nodeType=${item}[nodeType]
        dated log    nodeType=${item}[nodeType]
        ${nodeType_}=   set variable     ${item}[nodeType]
        run Keyword if   '${item}[nodeType]'!='VduVcu'       scf.add object to scf  class_name=${item}[class_name]
        ...                                                                         dist_name=${item}[dist_name]
        ...                                                                         version=${nrcell_version[0]}[nrcell_version]
        ...                                                                         nodeType=${item}[nodeType]
        ...   ELSE      run Keywords      scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]
        ...                                                      version=${nrcell_version[0]}[nrcell_version]
        ...                                                      nodeType=Vcu                                                        AND
        ...                               scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]
        ...                                                      version=${nrcell_version[1]}[nrcell_version]
        ...                                                      nodeType=Vdu
    END
    FOR    ${item}    IN    @{SANSA_15MHZ_PARAMS_TO_ADD}
        # scf.add object to scf  class_name=${item}[class_name]  dist_name=${item}[dist_name]  version=${nrcell_version}   nodeType=${item}[nodeType]
        dated log    nodeType=${item}[nodeType]
        ${nodeType_}=   set variable     ${item}[nodeType]
        run Keyword if   '${item}[nodeType]'!='VduVcu'       scf.add object to scf  class_name=${item}[class_name]
        ...                                                                         dist_name=${item}[dist_name]
        ...                                                                         version=${nrcell_version[0]}[nrcell_version]
        ...                                                                         nodeType=${item}[nodeType]
        ...   ELSE      run Keywords      scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]
        ...                                                      version=${nrcell_version[0]}[nrcell_version]
        ...                                                      nodeType=Vcu                                                        AND
        ...                               scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]
        ...                                                      version=${nrcell_version[1]}[nrcell_version]
        ...                                                      nodeType=Vdu
    END
    FOR    ${item}    IN    @{SANSA_5MHZ_LIST_NAME_PARAMS_TO_ADD}
        scf.add list to scf  dist_name=${item}[dist_name]   list_name=${item}[list_name]   nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{SANSA_15MHZ_LIST_NAME_PARAMS_TO_ADD}
        scf.add list to scf  dist_name=${item}[dist_name]   list_name=${item}[list_name]   nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{SANSA_5MHZ_LIST_ITEMS_PARAMS_TO_ADD}
        scf.add item to list  dist_name=${item}[dist_name]    list_name=${item}[list_name]   elements=${item}[elements]   nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{SANSA_15MHZ_LIST_ITEMS_PARAMS_TO_ADD}
        scf.add item to list  dist_name=${item}[dist_name]    list_name=${item}[list_name]   elements=${item}[elements]   nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{SANSA_5MHZ_LIST_ELEMENTS_PARAMS_TO_ADD}
        scf.add elements to list  dist_name=${item}[dist_name]  list_name=${item}[list_name]  elements=${item}[elements]  nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{SANSA_15MHZ_LIST_ELEMENTS_PARAMS_TO_ADD}
        scf.add elements to list  dist_name=${item}[dist_name]  list_name=${item}[list_name]  elements=${item}[elements]  nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{SANSA_5MHZ_ELEMENTS_PARAMS_TO_ADD}
        scf.add element to scf  dist_name=${item}[dist_name]    p_name=${item}[p_name]    value=${item}[value]   nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{SANSA_15MHZ_ELEMENTS_PARAMS_TO_ADD}
        scf.add element to scf  dist_name=${item}[dist_name]    p_name=${item}[p_name]    value=${item}[value]   nodeType=${item}[nodeType]
    END
    ${nodeType_}     set variable if    '${nodeType}'=='Classical'        Classical
    ...                                                                   Vdu
    scf.Save scf       file_path=${scf_file_update_path}    nodeType=${nodeType_}
    run Keyword if    '${scf_file_path_cu}'!='${EMPTY}'       scf.Save scf      file_path=${scf_file_update_path_cu}    nodeType=Vcu
    [Return]    ${scf_file_update_path}    ${scf_file_update_path_cu}

Commissioning SCF
    [Tags]                          INIT_AND_TEST
    [Arguments]                     ${ScfFile}     ${oam}=${GNB_DU.oam}   ${w_TlRestart}=True
    Dated log                       Commisioning SCF : ${ScfFile}
    File should exist               ${ScfFile}                              SCF file ${ScfFile} not found
    OAM Perform Full Commissioning  scf_file=${ScfFile}    oam=${oam}
    OAM wait available    oam=${oam}
    ${isOAMRebooted}     run Keyword if   '${isAic}'=='${False}'    SSH Was OAM Rebooted        ${GNB_DU}          timeout=60
    ...   ELSE                                                                    set variable      False
    # If gNB was rebooted after re-commissioning, wait until it's ready again.
    Run Keyword If                  '${isOAMRebooted}' == 'True'        Airscale Wait for Ready         ${GNB_DU}
    Run Keyword If                  '${w_TlRestart}' == 'True'          5GC002535_Keywords.Restart      isOAMRebooted=${isOAMRebooted}
    ...                                                                                                 OwnTLReset=${false}

Get GNB BTS Info
   [Documentation]                 Retrieve several info from GNB OAM
    ...                             Information retrieved are :
    ...                                 NRBTS_ID, MRBTS_ID and NRCELL_DIST_NAME
   ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
   OAM Get GNB BTS Info            oam=${GNB_DU.oam}
   Dated log                       \tMRBTS_ID=${MRBTS_ID}
   Dated log                       \tNRBTS_ID=${NRBTS_ID}
   Dated log                       \tNRCELL_DIST_NAME=${NRCELL_DIST_NAME}
   OAM Disconnect                  ${GNB_DU.oam}

PrintTLInformation
    log many    EGATE_CFG_NAME=${tl.core.cfg_filename}    WTS_FILE_PATH=${tl.core.dir_path}   GNB_IP=${GNB_IP}
    log many    UTE_IP=${tl.core.default_ssh_connection_details.addr}
    ...         UTE_USERNAME=${tl.core.default_ssh_connection_details.username}
    ...         UTE_PASSWORD=${tl.core.default_ssh_connection_details.password}

COAM_Admin_Login
    [Arguments]   ${bts_host}=${WEBUI_IP}   ${username}=${WEBUI_USERNAME}   ${password}=${WEBUI_PASSWORD}
    ...   ${bts_port}=${443}   ${log_dir}=${LOG_PATH}   ${alias}=COAM
    coam.connect_to
    ...   bts_host=${bts_host}
    ...   bts_port=${bts_port}
    ...   username=${username}
    ...   password=${password}
    ...   use_ssl=${True}
    ...   update_interval=${5000}
    ...   admin_api_log_dir=${log_dir}
    ...   name=${alias}

COAM_Admin_Logout
    [Arguments]   ${connection}=COAM
    coam.teardown      connection=${connection}

COAM_Admin_BackupSCF
    [Arguments]   ${local_dir}=${LOG_PATH}   ${file_name}=old_commission.xml   ${connection}=COAM
    wait until keyword succeeds   3x   1min    COAM_Admin_Login
    coam.get_current_scf_file   local_dir_path=${local_dir}   file_name=${file_name}   connection=${connection}   timeout=10
    ${backupfile}=   Join Path   ${local_dir}   ${file_name}
    COAM_Admin_Logout
    [Return]  ${backupfile}

gNB BackupSCF
    [Arguments]   ${oam_type}=${OAM_TYPE}
    ${bakupfolder}    set variable    backups
    run   command=mkdir ${LOG_PATH}${/}${bakupfolder}
    set global variable    ${BACKUP_DIR}    ${LOG_PATH}${/}${bakupfolder}

    # ${scffile}=    run keyword     COAM_Admin_BackupSCF
    # ${scf_file_path}    ${scf_file_name}    OperatingSystem.split path    ${scffile}
    # sleep    3s

    ${sufix}=     set variable if          ${isAic}            _DU
    ...                                                        ${EMPTY}
    ${scffile}                   set variable                old_commission${sufix}.xml
    ${scf_file_path}             OAM Get SCF File           dir=${BACKUP_DIR}      file=${scffile}
    set global variable    ${BACKUP_SCF}    ${scf_file_path}
    return from Keyword if      '${isAic}'=='${FALSE}'
    ${sufix}=     set variable if       ${isAic}     _CU
    ...                                              ${EMPTY}
    ${scffile}                   set variable                old_commission${sufix}.xml
    ${scf_file_path}             OAM Get SCF File           dir=${BACKUP_DIR}      file=${scffile}     oam=${GNB_CU.oam}
    # OperatingSystem.Copy File    ${scffile}    ${BACKUP_DIR}
    set global variable    ${BACKUP_CU_SCF}    ${scf_file_path}

Get All Cell Id
    [Documentation]  ru_index=None: get all gnb cells, ru_index=ru_index: get all cells under RU
    [Arguments]   ${connection}    ${ru_index}=${None}
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${output}=    coam.get_cells_info    connection=${aliasGNB}
    Log Many      ${output}    level=DEBUG
    Dated log     get_cells_info=${output}
    ${cell_list}  create list
    FOR  ${cell}  IN  @{output}
        run keyword if  ${ru_index}==${None}    append to list  ${cell_list}  ${cell['globalCellId']}
        ${carrier}    set variable  ${cell['carrierList'][0]}
        ${status}  run keyword if  ${ru_index}!=${None}    run keyword and return status
                   ...    should contain  ${carrier['antennaLineId']['configuration']}    RMOD-${ru_index}
        run keyword if    ${status}    append to list  ${cell_list}  ${cell['globalCellId']}
    END
    Sort List   ${cell_list}
    [Return]  ${cell_list}

get Classical Cell summary
   [Documentation]     [PRIVATE]  get Classical Cell Info
   ${aliasGNB}                     OAM Connect                          ${GNB_DU.oam}
   ${cell_info}=    coam.get_cells_info    cell_type=nr    timeout=30    connection=${GNB_DU.oam.httpAlias}
   # Dated log      =======> Current cell(s) info is ${cell_info}
   ${Nbr Cell locked}      set variable    ${0}
   ${Nbr Cell unlocked}    set variable    ${0}
   ${nbr_cell}=   Get length    ${cell_info}
   Dated log     nbr_cell=${nbr_cell}
   FOR    ${elem}    IN    @{cell_info}
     &{cell_status}    get from dictionary    ${elem}    status
     ${status}    run Keyword and return status     Dictionary should contain item    ${cell_status}    administrativeState      Unlocked
     ${Nbr Cell unlocked}    run Keyword if   '${status}'=='True'        Evaluate     ${Nbr Cell unlocked}+${1}
     ...   ELSE                                                          set variable    ${Nbr Cell unlocked}
   END
   FOR    ${elem}    IN    @{cell_info}
     &{cell_status}    get from dictionary    ${elem}    status
     ${status}    run Keyword and return status       Dictionary should contain item    ${cell_status}    administrativeState      Locked
     ${Nbr Cell locked}    run Keyword if   '${status}'=='True'            Evaluate             ${Nbr Cell locked}+${1}
     ...   ELSE                                                          set variable    ${Nbr Cell locked}
   END
   Dated log      get Classical Cell summary ----> Nbr Cell locked=${Nbr Cell locked}
   Dated log      get Classical Cell summary ----> Nbr Cell unlocked=${Nbr Cell unlocked}
   [return]      ${Nbr Cell locked}    ${Nbr Cell unlocked}
   [teardown]    robot_extension.Run Keyword And Warn On Failure    OAM Disconnect                 ${GNB_DU.oam}

Test Line Preparation
   [Arguments]       ${testParam}

   Log to Console like Next Step    0    ${SUITE NAME} - ${TEST NAME.replace(" ", "_")}

   PrintTLInformation
   gNB BackupSCF

   ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
   Set Suite Variable              ${test_scf_file}
   ${cellDepType}=   5GC002535_Kw_TestSetup.get cellDepType from SCF
   ${testParam.Context.cellDepType}      set variable    ${cellDepType}

   Return From Keyword If    "${testParam.Context.cellDepType}" == "NSA"

   # Get current  SCF file
   5GC002535_Keywords.Prepare Logs Directory Path    resultDir=${LOG_PATH}    subdir=PDCCH_delete
   ${default_local_scf_file_path}       OAM Get SCF File       dir=${LOG_PATH}/PDCCH_delete      file=SCF_used_for_2535_Tests_FirstCommissioning.xml
   Set Suite Variable              ${default_local_scf_file_path}

   ${local_path_scf_file}   ${local_path_scf_file_cu}    Delete PDCCH Information If Exist     scf_file_path_du=${default_local_scf_file_path}
   Set Suite Variable              ${local_path_scf_file}

   ${local_path_scf_file_with_pdcch_info}     ${local_path_scf_file_cu}    Add PDCCH information to scf    scf_file_path=${local_path_scf_file}
   Set Suite Variable              ${local_path_scf_file_with_pdcch_info}

   # SANSA case only
   add PDCCH 5MHz cellBwpList to SCF     ${local_path_scf_file_with_pdcch_info}

   Run Keyword If        '${SHOULD_BE_COMMISSIONED_GNB_FIRST}' == '1'       Commissioning SCF      ${local_path_scf_file_with_pdcch_info}
   ...     ELSE        Dated log     gNB not Commissioning because SHOULD_BE_COMMISSIONED_GNB_FIRST==0
   Run Keyword If        '${SHOULD_BE_COMMISSIONED_GNB_FIRST}' == '1'       Get GNB BTS Info

   # get Cell info and update context
   ${Nbr_Cell_locked}   ${Nbr_Cell_unlocked}=     get Classical Cell summary
   Update cell state with "${Nbr_Cell_unlocked}" and "${Nbr_Cell_locked}" into "${testParam}"

   # SCF.xml is used by procedure verifyFeatureActivation
   ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
   Set Suite Variable              ${test_scf_file}
   Dated Log                  Current 2535 SCF file stored to ${test_scf_file}


Update gNB Swconfig
    [Arguments]                      ${testParam}
    return from Keyword if    '${SHOULD_UPDATE_RAD}' == '0'
    ${rdEnableFDMPdschDmrs_0x5801a6}=      create dictionary            field=0x5801a6          value=${testParam.rdEnableFDMPdschDmrs_0x5801a6}
    ${swconfig_gnb}=                 Create List                        ${rdEnableFDMPdschDmrs_0x5801a6}
    Set Fields in swconfig DU       param_list=${swconfig_gnb}

Update gNB Swconfig New
    [Arguments]                      ${swconfig_gnb}
    [Documentation]     only update swconfig with ${swconfig_gnb} content
    ...        Exemple :
    ...              ${l2ps_rdEnableFDMPdschDmrs_0x5801a6}=      create dictionary          field=0x5801a6
    ...                                                                value=${testParam.rdEnableFDMPdschDmrs_0x5801a6}
    ...              ${cprt_log_level_0x590072}=       create dictionary                  field=0x590072          value=1
    ...              ${my_swconfig_gnb}=                 Create List           ${l2ps_rdEnableFDMPdschDmrs_0x5801a6}
    ...                                                                        ${cprt_log_level_0x590072}
    ...              Update gNB Swconfig   swconfig_gnb=${my_swconfig_gnb}
    ${isEmpty}    Run Keyword And Return Status    Should Be Empty      ${swconfig_gnb}
    return from keyword if     ${isEmpty}
    Set Fields in swconfig DU       param_list=${swconfig_gnb}

Upload 2535 Configuration
    [Documentation]   Auther: Ch SAMSON , upload xml from Git into WTS

    # upload xml
    ${ap_configfile}                Get XML AirPhoneConfig Path
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    run Keyword if      '${ap_configfile}' != '${empty}'    csn.upload_file          remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                                                                              local_path=${CURDIR}/${xml_wts_noTM}
    ...                                                                              connection=${alias_epc}

    Dated Log                 ApOamConfig has been uploaded with default (${CURDIR}/${xml_wts_noTM})

Test Setup 2535
    [Arguments]         ${testParam}    ${btsType}=Classical

    Log to Console like Next Step     0     5GC002535_Kw_TestSetup.Test Setup BW=${testParam.seq.bandwidth}

    run keyword if                '${SHOULD_FORCE_XML_AP}' == '1'            Upload 2535 Configuration

    run keyword and ignore error      Remove RAD param for Link Adaptation on swconfig if present

    ${nodeType}=   set variable if   '${btsType}' == 'Classical'     Classical
    ...                                                              vDU

    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable              ${test_scf_file}
    ${cellDepType}=   5GC002535_Kw_TestSetup.get cellDepType from SCF    nodeType=${nodeType}
    ${testParam.Context.cellDepType}      set variable    ${cellDepType}
    set suite variable     ${NWtype_}      ${cellDepType}

    Run Keyword If                 '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'      Set Specific RAD & scf parameters  ${testParam}   btsType=${btsType}
    # Run Keyword If                 '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'      Set cellBwpList SCF 2535    ${testParam}
    Run Keyword If                 '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'      Set cellBwpList SCF 2535 for Aic and Classical    ${testParam}
    ...                                                                                                                         btsType=${btsType}
    Run Keyword If                 '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'      Modify systemInformationTargetRate Parameter with zero    ${testParam}

    # iPHY gscn update depending of chBwDl
    Dated Log      iPHY gscn update with ${testParam.scfFile.nrcell.gscn} : chBwDl=${testParam.scfFile.nrcellfdd.chBwDl}
    Set Context_AP IPHY    ${testParam}

    # default configuration is 5MHz case , nothing to do in this case
    # Run Keyword If   '${testParam.seq.bandwidth}'!='5MHz'   Modify Bandwidth Parameters for WTS   ${testParam}
    # 05/07/2021 : update Bw Parameters in WTS file whatever the BW
    # Modify Bandwidth Parameters for WTS   ${testParam}
    # 12/16/2022 : tempory WA for CB008325 (ABIP)
    # => UTE Cloud TL : only nrCellType = 4DL4UL is supported for ABIP for the moment
    # and Ue capa delevered by UTE Cloud allow to support only 2 DL Layers => so in case of ABIP; the Ue capa are not forced for the moment
    # => to change when ABIP gNB will support nrCellType = 2DL2UL
    ${w_force_ue_capa}=   set Variable if    '${GNB_DU.bb[0].M.boardType}'=='ABIP'    False
    ...                                                                               True
    Modify Bandwidth Parameters for WTS   ${testParam}  w_force_ue_capa=${w_force_ue_capa}

    ${isOAMRebooted}        Run Keyword If     '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'      SSH Was OAM Rebooted     ${GNB_DU}    timeout=60

    # Save current SCF file used during test cases
    ${current_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF_used_for_2535_${testParam.seq.bandwidth}_Tests.xml
    Set Suite Variable              ${current_scf_file}
    Dated Log New Line         Current 2535 SCF file stored to ${current_scf_file}

    # Get swconfig file that will be used during 2535 tests
    ${alias_gnb}           run keyword and ignore error         SSH Wait For Connect                ${GNB_DU.sys[0].M}
    run keyword and ignore error   csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${LOG_PATH}/swconfig_used_for_2535_${testParam.seq.bandwidth}_Tests.txt
    ...                             connection=${alias_gnb}
    Dated Log                  Current 1586-M swconfig file stored to ${LOG_PATH}/swconfig_used_for_2535_${testParam.seq.bandwidth}_Tests.txt

    # Get EPC file configuration that will be used during 2535 tests
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.download_file               remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${LOG_PATH}/basic_wts_used_for_2535_${testParam.seq.bandwidth}_Tests.cfg
    ...                             connection=${alias_epc}

    # Get AP configuration file that will be used during 2535 tests
    ${ap_configfile}                Get XML AirPhoneConfig Path
    run Keyword if      '${ap_configfile}' != '${empty}'    csn.download_file      remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${LOG_PATH}/ApOamConfig_used_for_2535_${testParam.seq.bandwidth}_Tests.xml
    ...                             connection=${alias_epc}

Remove RAD param for Link Adaptation on swconfig if present
   [Documentation]         workaround on swconfig.txt to remove RAD param for Link adaptation
    ${SWCONFIG_LOCAL_PATH}          getTempDir
    ${SWCONFIG_REMOTE_PATH}         set variable                        /ffs/run/swconfig.txt
    Set Suite Variable              ${SWCONFIG_LOCAL_PATH}
    ...                             ${SWCONFIG_LOCAL_PATH}/swconfig.txt
    set suite variable              ${SWCONFIG_REMOTE_PATH}
    Dated Log                       startSession : Download ${SWCONFIG_REMOTE_PATH} in ${SWCONFIG_LOCAL_PATH}
    ${alias}                        SSH Wait For Connect                 ${GNB_DU.sys[0].M}
    csn.download_file               remote_path=${SWCONFIG_REMOTE_PATH}
    ...                             local_path=${SWCONFIG_LOCAL_PATH}
    ...                             connection=${alias}

    Dated log      Workaround on swconfig.txt to remove RAD param for Link adaptation
    Dated Log      sed -i -e 's/0x580011=0/#0x580011=0/g' ${SWCONFIG_LOCAL_PATH}
    Dated Log      sed -i -e 's/0x580012=0/#0x580012=0/g' ${SWCONFIG_LOCAL_PATH}
    Dated Log      sed -i -e 's/0x580013=0/#0x580013=0/g' ${SWCONFIG_LOCAL_PATH}
    Dated Log      sed -i -e 's/0x580014=0/#0x580014=0/g' ${SWCONFIG_LOCAL_PATH}

    Run          command=sed -i 's/0x580011=0/#0x580011=0/g' ${SWCONFIG_LOCAL_PATH}
    Run          command=sed -i 's/0x580012=0/#0x580012=0/g' ${SWCONFIG_LOCAL_PATH}
    Run          command=sed -i 's/0x580013=0/#0x580013=0/g' ${SWCONFIG_LOCAL_PATH}
    Run          command=sed -i 's/0x580014=0/#0x580014=0/g' ${SWCONFIG_LOCAL_PATH}

    Dated Log                       Upload ${SWCONFIG_LOCAL_PATH} in ${SWCONFIG_REMOTE_PATH}.new
    csn.upload_file                 local_path=${SWCONFIG_LOCAL_PATH}
    ...                             remote_path=${SWCONFIG_REMOTE_PATH}.new
    ...                             connection=${GNB_DU.sys[0].M.alias}
    Dated Log                       cp ${SWCONFIG_REMOTE_PATH} ${SWCONFIG_REMOTE_PATH}.sav
    SSH Exec                        command=cp ${SWCONFIG_REMOTE_PATH} ${SWCONFIG_REMOTE_PATH}.sav           alias=${alias}
    Dated Log                       remove ${SWCONFIG_REMOTE_PATH}
    SSH Exec                        command=rm ${SWCONFIG_REMOTE_PATH}           alias=${alias}
    ${output}=     SSH Exec         command=ls -lrt ${SWCONFIG_REMOTE_PATH}           alias=${alias}
    Dated log                       output ls ${SWCONFIG_REMOTE_PATH} = ${output.strip()}
    Dated Log                       cp ${SWCONFIG_REMOTE_PATH}.new ${SWCONFIG_REMOTE_PATH}
    ${output}=     SSH Exec         command=cp ${SWCONFIG_REMOTE_PATH}.new ${SWCONFIG_REMOTE_PATH}     alias=${alias}    timeout=20
    ${output}=     SSH Exec         command=ls -lrt ${SWCONFIG_REMOTE_PATH}           alias=${alias}
    Dated log                       output ls ${SWCONFIG_REMOTE_PATH} = ${output.strip()}
    Dated Log                       stopSession : crasign ${SWCONFIG_REMOTE_PATH}
    SSH Exec                        command=crasign ${SWCONFIG_REMOTE_PATH}           alias=${alias}

Set Specific RAD & scf parameters
   [Arguments]       ${testParam}    ${btsType}=Classical

    # set specific RAD param for 2535
    Dated Log New Line   Set Specific RAD parameters
    Update gNB Swconfig    ${testParam}

    # Update specific param depending BW into scf (the default case is 5Mhz)
    Dated Log      Scf update for ${testParam.scfFile.nrcellfdd.chBwDl}
    # Set SCF 2535     ${testParam}    ${nodeType}
    Set SCF 2535 for AiC and Classical     ${testParam}    ${btsType}

Modify Bandwidth Parameters for WTS
   [Arguments]       ${testParam}    ${w_setSpecificXmlFile}=false     ${SpecificXmlFile}='AirphoneConfig.xml'   ${w_force_ue_capa}=True
   Dated Log New Line  Set WTS cfg and xml parameters for ${testParam.scfFile.nrcellfdd.chBwDl}
   WTS cfg Preparation    ${testParam}   w_setSpecificXmlFile=${w_setSpecificXmlFile}    SpecificXmlFile=${SpecificXmlFile}
   WTS xml Preparation    ${testParam}
   ${status}  ${message}=   Run Keyword And Ignore Error      Variable Should Exist       ${testParam.seq.ue_nr_capa_value}
   return from Keyword if    "${status}"=="FAIL"
   Run Keyword if   '${w_force_ue_capa}' == 'True'    Dated Log   Set Ue capa for ${testParam.scfFile.nrcellfdd.chBwDl}
   Run Keyword if   '${w_force_ue_capa}' == 'True'    Set UE capa on EPCSim   ${testParam.seq.ue_nr_capa_value}  ${testParam.seq.ue_ue_eutra_nr_capa}

Update cell state with "${nbr_cell_unlock}" and "${nbr_cell_lock}" into "${testParam}"
   ${testParam_2535}                 Tools.Dictionary Get              ${testParam}
   ${testParam_2535.Context.nbr_cell_unlock}    set Variable     ${nbr_cell_unlock}
   ${testParam_2535.Context.nbr_cell_lock}      set Variable     ${nbr_cell_lock}
   set suite variable    ${testParam_2535}
   [Return]      ${testParam_2535}

#=======================================================================================================================
# CONFIG/SETTINGS services on basic.cfg (the default basic.cfg is for 10MHz)
#=======================================================================================================================

Backup XML AirphoneConfig
    [Documentation]                 Backup current AirphoneConfig file on ePCSim
    ${file}                         Get XML AirPhoneConfig Path
    return from Keyword if      '${file}'=='${EMPTY}'    ${EMPTY}
    Dated log                       On wtsemu, backing up file ${file}
    ${alias}                        SSH Connect                       ${HOST_EPCSIM}
    # Creates a copy of current XML AirphoneConfig
    ${backup_exists}=    csn.execute    test -f ${file}.backup && echo -n "okman" || echo -n "noway"    connection=${alias}
    ${file_exists}=      csn.execute    test -f ${file} && echo -n "okman" || echo -n "noway"    connection=${alias}
    Run Keyword If    '${file_exists}'=='okman' and '${backup_exists}'!='okman'    csn.execute    cp ${file} ${file}.backup    connection=${alias}
    Return from Keyword     ${file}

Set FullStack NodeId
    [Arguments]                      ${x_path_l1Hw}
    setText                          ${x_path_l1Hw}/l1UlNodeId          ${Fullstack_NodeId_WtsXml}
    setText                          ${x_path_l1Hw}/l1DlNodeId          ${Fullstack_NodeId_WtsXml}

Set L1ByPass NodeId
    [Arguments]                      ${x_path_l1Hw}
    setText                          ${x_path_l1Hw}/l1UlNodeId          ${L1bypass_NodeId_WtsXml}
    setText                          ${x_path_l1Hw}/l1DlNodeId          ${L1bypass_NodeId_WtsXml}

WTS Preparation
    [Arguments]       ${testParam}
    WTS cfg Preparation                ${testParam}
    WTS xml Preparation             ${testParam}
    WTS Setup                       nbUe=${testParam.seq.totalUE}

WTS cfg Preparation
    [Arguments]       ${testParam}     ${w_setSpecificXmlFile}=false     ${SpecificXmlFile}='AirphoneConfig.xml'
    WtsCfgConfig.startSession
    ${oldValue}          getParam           prefix=set_cell          param=nr_arfcn
    replaceValue         prefix=set_cell
    ...                  param=nr_arfcn
    ...                  oldValue=${oldValue}
    ...                  newValue=${testParam.wtsXmlFile.ulNrArfcn}:${testParam.wtsXmlFile.dlNrArfcn}
    #set xml file name if needed
    ${oldValue}     run Keyword if    '${w_setSpecificXmlFile}' == 'true'      getParam       prefix=set_uec      param=file
    run Keyword if   '${w_setSpecificXmlFile}' == 'true'       replaceValue         prefix=set_uec
    ...                                                                             param=file
    ...                                                                             oldValue=${oldValue}
    ...                                                                             newValue=${SpecificXmlFile}
    ${oldValue}          getParam           prefix=set_cell          param=tdd_cell
    replaceValue         prefix=set_cell
    ...                  param=tdd_cell
    ...                  oldValue=${oldValue}
    ...                  newValue=off
    WtsCfgConfig.stopSession         rename=modified

WTS xml Preparation
    [Arguments]          ${testParam}
    ${file}       Backup XML AirphoneConfig
    return from Keyword if   '${file}'=='${EMPTY}'    ${EMPTY}
    WtsXmlConfig.startSession
    # 07/07/2021 : to remove as not present anymore in the xml file
    # ${x_path_cellGrp}                set variable                           /config/cellGroupConfig/cellGroup
    # setText                          ${x_path_cellGrp}/dlBandwidth          ${testParam.wtsXmlFile.dlUlBandwidth}
    # setText                          ${x_path_cellGrp}/ulBandwidth          ${testParam.wtsXmlFile.dlUlBandwidth}
    # setText                          ${x_path_cellGrp}/ssBlockPrbOffset          ${testParam.wtsXmlFile.ssBlockPrbOffset}
    #set Arfcn
    WtsXmlConfig.setListEltText         //dlNrArfcn                        ${testParam.scfFile.nrcellfdd.nrarfcnDl}
    WtsXmlConfig.setListEltText         //ulNrArfcn                        ${testParam.scfFile.nrcellfdd.nrarfcnUl}
    WtsXmlConfig.setListEltText         //gscn                             ${testParam.scfFile.nrcell.gscn}
    WtsXmlConfig.stopSession


# the basic configuration is for 10MHz
Set UE capa on EPCSim
    [Arguments]                     ${ue_nr_capa_value}=${ue_nr_capabilities_20MHz}    ${ue_ue_eutra_nr_capa}=${ue_ue_eutra_nr_capabilities_20MHz}
    Modify Field in WtsEmu Cfg File
    ...                             field=ue_nr_capabilities                 value=${ue_nr_capa_value}
    Modify Field in WtsEmu Cfg File
    ...                             field=ue_eutra_nr_capabilities                 value=${ue_ue_eutra_nr_capa}

#=======================================================================================================================
# IPHY settings
#=======================================================================================================================

Set Context_AP IPHY
    [Arguments]          ${testParam}
    WtsXmlConfig.startSession           file=iphy
    #set GSCN
    # WtsXmlConfig.setListEltText         //GSCN                          ${testParam.scfFile.nrcell.gscn}
    WtsXmlConfig.setListEltText         //RE[1]//GSCN                          ${testParam.scfFile.nrcell.gscn}
    WtsXmlConfig.stopSession            file=iphy

