Set SCF 2535 Test case
    [Arguments]          ${testParam}     ${nodeType}=Classical
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
    &{modify_param}    Create Dictionary
    ...    parameter=dlDMRSAdditionalPosition
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.dlDMRSAdditionalPosition}
    &{modify_param1}    Create Dictionary
    ...    parameter=ulDMRSAdditionalPosition
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.ulDMRSAdditionalPosition}
    &{modify_param2}    run Keyword if    '${nodeType}' == 'Classical'    Create Dictionary
    ...    parameter=actDl256Qam
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.actDl256Qam}
   &{modify_param3}    Create Dictionary
    ...    parameter=actDlDataDmrsFdm
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.actDlDataDmrsFdm}
   &{modify_param4}    Create Dictionary
    ...    parameter=dlDataDmrsFdmThres256QamMcs
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.dlDataDmrsFdmThres256QamMcs}
    &{modify_param5}    Create Dictionary
    ...    parameter=actGeneralConnectivitySilver
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...    value=${testParam.scfFile.mrbts.actGeneralConnectivitySilver}
    &{modify_param6}    Create Dictionary
    ...    parameter=cellName
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.cellName}
    &{modify_param7}    run Keyword if    '${nodeType}' == 'Classical'       Create Dictionary
    ...    parameter=actInactDetNSAUe
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...    value=${testParam.scfFile.mrbts.actInactDetNSAUe}
    @{modify_params}    Create List
    # WARNING : to bypass for the moment modify_param and modify_param1
    #     ${modify_param}
    # ...                ${modify_param1}
#     ...                ${modify_param2}
#    ...                ${modify_param3}
#    ...                ${modify_param4}
#     ...                ${modify_param5}
    ...                ${modify_param6}
#     ...                ${modify_param7}

    # Specific case for Classical (for the moment)
    # WARNING : need to bypass for the moment modify_param and modify_param1 in case of AiC
    run Keyword if    '${nodeType}' == 'Classical'   append to List   ${modify_params}   ${modify_param}   ${modify_param1}

    # actInactDetNSAUe is DU param for Classical and CU param for AiC
    run Keyword if    '${nodeType}' == 'Classical'   append to List   ${modify_params}   ${modify_param2}
    run Keyword if    '${nodeType}' == 'Classical'   append to List   ${modify_params}   ${modify_param7}

    BuiltIn.Log      \nDU Parameters to modify:\n @{modify_params}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params      modify_param=@{modify_params}

    run Keyword if     '${nodeType}' == 'Classical'     Modify 2535 dlDataDmrsFdm related Parameters     ${testParam}

    return from Keyword if    '${nodeType}' == 'Classical'

    # DU specific case
    Modify 2535 dlDataDmrsFdm related DU Parameters     ${testParam}

    # CU specific case
    &{modify_param}    Create Dictionary
    ...    parameter=actGeneralConnectivitySilver
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...    value=${testParam.scfFile.mrbts.actGeneralConnectivitySilver}
    &{modify_param1}    Create Dictionary
    ...    parameter=actInactDetNSAUe
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...    value=${testParam.scfFile.mrbts.actInactDetNSAUe}
    @{modify_params}    Create List
    # ...                ${modify_param}
    ...                ${modify_param1}

    BuiltIn.Log      \nCU Parameters to modify:\n @{modify_params}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params      modify_param=@{modify_params}       oam=${GNB_CU.oam}


Set SCF 2535 Test case for AiC and Classical
    [Arguments]          ${testParam}     ${btsType}=Classical
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}

    # list param for AiC VDU or Classical
    ${nodeType}=     set variable if   '${btsType}' == 'Classical'    Classical
    ...                                                               Vdu

    &{modify_param}    Create Dictionary
    ...    parameter=dlDMRSAdditionalPosition
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.dlDMRSAdditionalPosition}
    ...    nodeType=${nodeType}
    &{modify_param1}    Create Dictionary
    ...    parameter=ulDMRSAdditionalPosition
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.ulDMRSAdditionalPosition}
    ...    nodeType=${nodeType}
    &{modify_param2}     Create Dictionary
    ...    parameter=actDl256Qam
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.actDl256Qam}
    ...    nodeType=${nodeType}
    &{modify_param3}    Create Dictionary
    ...    parameter=cellName
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.cellName}
    ...    nodeType=${nodeType}

    # list param for AiC VDU and VCU or Classical
    ${nodeType}=     set variable if   '${btsType}' == 'Classical'    Classical
    ...                                                               VcuVdu

    &{modify_param4}    Create Dictionary
    ...    parameter=actGeneralConnectivitySilver
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...    value=${testParam.scfFile.mrbts.actGeneralConnectivitySilver}
    ...    nodeType=${nodeType}

    # list param for AiC VCU Only or Classical
    ${nodeType}=     set variable if   '${btsType}' == 'Classical'    Classical
    ...                                                               Vcu

    &{modify_param5}   Create Dictionary
    ...    parameter=actInactDetNSAUe
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...    value=${testParam.scfFile.mrbts.actInactDetNSAUe}
    ...    nodeType=${nodeType}

    @{modify_params}    Create List
    # WARNING : to bypass for the moment modify_param and modify_param1
    #     ${modify_param}
    # ...                ${modify_param1}
#     ...                ${modify_param2}   # modify_param2 is set at same place than minMCS=27 (WA for AiC)
    ...                ${modify_param3}
    # ...                ${modify_param4}
    ...                ${modify_param5}

    # Specific case for Classical (for the moment)
    # WARNING : need to bypass for the moment modify_param and modify_param1 in case of AiC
    run Keyword if    '${btsType}' == 'Classical'   append to List   ${modify_params}   ${modify_param}   ${modify_param1}

    # WA for the moment : actDl256Qam only for Classical
    # AiC case is managed by other specific Kw
    run Keyword if    '${btsType}' == 'Classical'   append to List   ${modify_params}   ${modify_param2}

    BuiltIn.Log      \n${btsType} Parameters to modify:\n @{modify_params}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params AIC      modify_param=@{modify_params}

    Modify 2535 dlDataDmrsFdm related Parameters for Aic and Classical     ${testParam}    btsType=${btsType}



Set SCF 2535 18 02 2022
    [Arguments]          ${testParam}
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
#      TestParam is ${testParam}
    ${btsName}=     Catenate    ${testParam.scfFile.mrbts.btsName} ${testline_name}
    &{modify_param}    Create Dictionary
    ...    parameter=btsName
    ...    dist_name=MRBTS-${MRBTS_ID}
    ...    value=${btsName}
    &{modify_param1}    Create Dictionary
    ...    parameter=chBwDl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.chBwDl}
    &{modify_param2}    Create Dictionary
    ...    parameter=chBwUl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.chBwUl}
    &{modify_param3}    Create Dictionary
    ...    parameter=nrarfcnDl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.nrarfcnDl}
    &{modify_param4}    Create Dictionary
    ...    parameter=nrarfcnUl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.nrarfcnUl}

    coam.connect to   bts_host=${tl.gnbs[0].cu.oam_http_connection_details.addr}   name=coam_admin
    ${gscn_value}    coam_parameter.get_single_value_from_scf_file    parameter=${gscnParameterName}    dist_name=${NRCELL_DIST_NAME}
    ...                                                               connection=coam_admin
    coam.teardown    connection=coam_admin

    &{modify_param5}=   Create dictionary
    ...     parameter=${gscnParameterName}
    ...     dist_name=${NRCELL_DIST_NAME}
    ...     value=${testParam.scfFile.nrcell.gscn}
    Dated log      gscn param: ${gscnParameterName}=${gscn_value} => updating with gscn=${testParam.scfFile.nrcell.gscn}

    &{modify_param6}    Create Dictionary
    ...    parameter=type0CoresetConfigurationIndex
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.type0CoresetConfigurationIndex}
    &{modify_param7}    Create Dictionary
    ...    parameter=cellName
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.cellName}
    &{modify_param8}    Create Dictionary
    ...    parameter=localIpAddr
    ...    dist_name=MRBTS-${MRBTS_ID}/TNLSVC-1/TNL-1/IPNO-1/IPIF-1/IPADDRESSV4-1
    ...    value=${testParam.scfFile.ipif.localIpAddr}
    &{modify_param9}    Create Dictionary
    ...    parameter=actInternalTrace
    ...    dist_name=MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/TRBLCADM-1
    ...    value=${testParam.scfFile.nrbts_trblcadm.actInternalTrace}
    &{modify_param10}    Create Dictionary
    ...    parameter=actCli
    ...    dist_name=MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/FEATCADM-1
    ...    value=${testParam.scfFile.nrbts_featcadm.actCli}
    @{modify_param}    Create List    ${modify_param}
    ...                ${modify_param1}
    ...                ${modify_param2}
    ...                ${modify_param3}
    ...                ${modify_param4}
    ...                ${modify_param5}
    ...                ${modify_param6}
    ...                ${modify_param7}
    ...                ${modify_param9}
    ...                ${modify_param10}

    BuiltIn.Log      \nParameters to modify:\n @{modify_param}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params      modify_param=@{modify_param}

# MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
get single value from scf file
    [Arguments]     ${parameter}=${EMPTY}  ${dist_name}=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1  ${nodeType}=Classical
    # Get SCF File (SCF.xml) in test setup
    ${current_scf_fullname}    set Variable      ${test_scf_file}
    scf.load_scf	 ${current_scf_fullname}
    # MRBTS-1/NRBTS-1/NRCELL-1
    ${value}	 scf.get_value_from_scf
    ...                 p_name=${parameter}
    ...                 dist_name=${dist_name}
    ...                 nodeType=${nodeType}
    [return]     ${value}

Set SCF 2535
    [Arguments]          ${testParam}    ${nodeType}=Classical
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
#      TestParam is ${testParam}
    ${btsName}=     Catenate    ${nodeType} ${testParam.scfFile.mrbts.btsName} ${testline_name}
    &{modify_param}    Create Dictionary
    ...    parameter=btsName
    ...    dist_name=MRBTS-${MRBTS_ID}
    ...    value=${btsName}
    # ...    nodeType=VcuVdu
    &{modify_param1}    Create Dictionary
    ...    parameter=chBwDl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.chBwDl}
    # ...    nodeType=VcuVdu
    &{modify_param2}    Create Dictionary
    ...    parameter=chBwUl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.chBwUl}
    # ...    nodeType=VcuVdu
    &{modify_param3}    Create Dictionary
    ...    parameter=nrarfcnDl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.nrarfcnDl}
    # ...    nodeType=VcuVdu
    &{modify_param4}    Create Dictionary
    ...    parameter=nrarfcnUl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.nrarfcnUl}
    # ...    nodeType=VcuVdu

    # coam.connect to   bts_host=${tl.gnbs[0].cu.oam_http_connection_details.addr}   name=coam_admin
    # ${aliasGNB}                     OAM Connect                          ${GNB_DU.oam}
    ${gscn_value}=    get single value from scf file    parameter=${gscnParameterName}    dist_name=${NRCELL_DIST_NAME}   nodeType=${nodeType}
    # ...                                                               connection=${aliasGNB}
    # OAM Disconnect                  ${GNB_DU.oam}
    # coam.teardown    connection=coam_admin

    &{modify_param5}=   Create dictionary
    ...     parameter=${gscnParameterName}
    ...     dist_name=${NRCELL_DIST_NAME}
    ...     value=${testParam.scfFile.nrcell.gscn}
    # ...     nodeType=Vdu
    Dated log      gscn param: ${gscnParameterName}=${gscn_value} => updating with gscn=${testParam.scfFile.nrcell.gscn}

    &{modify_param6}    Create Dictionary
    ...    parameter=type0CoresetConfigurationIndex
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.type0CoresetConfigurationIndex}
    # ...    nodeType=Vdu
    &{modify_param7}    Create Dictionary
    ...    parameter=cellName
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.cellName}
    # ...    nodeType=Vdu
    &{modify_param8}    Create Dictionary
    ...    parameter=localIpAddr
    ...    dist_name=MRBTS-${MRBTS_ID}/TNLSVC-1/TNL-1/IPNO-1/IPIF-1/IPADDRESSV4-1
    ...    value=${testParam.scfFile.ipif.localIpAddr}
    # ...     nodeType=Classical
    &{modify_param9}    Create Dictionary
    ...    parameter=actInternalTrace
    ...    dist_name=MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/TRBLCADM-1
    ...    value=${testParam.scfFile.nrbts_trblcadm.actInternalTrace}
    # ...    nodeType=VcuVdu
    &{modify_param10}    Create Dictionary
    ...    parameter=actCli
    ...    dist_name=MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/FEATCADM-1
    ...    value=${testParam.scfFile.nrbts_featcadm.actCli}
    # ...    nodeType=VcuVdu
    @{modify_params}    Create List    ${modify_param}
    ...                ${modify_param1}
    ...                ${modify_param2}
    ...                ${modify_param3}
    ...                ${modify_param4}
    ...                ${modify_param5}
    ...                ${modify_param6}
    ...                ${modify_param7}
    ...                ${modify_param9}
    ...                ${modify_param10}

    BuiltIn.Log      \nDU Parameters to modify:\n @{modify_params}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params      modify_param=@{modify_params}   oam=${GNB_DU.oam}

    return from Keyword if    '${nodeType}' == 'Classical'

    ${btsName}=     Catenate    Vcu ${testParam.scfFile.mrbts.btsName} ${testline_name}
    &{modify_param}    Create Dictionary
    ...    parameter=btsName
    ...    dist_name=MRBTS-${MRBTS_ID}
    ...    value=${btsName}
    # ...    nodeType=Vcu
    &{modify_param1}    Create Dictionary
    ...    parameter=chBwDl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.chBwDl}
    # ...    nodeType=Vcu
    &{modify_param2}    Create Dictionary
    ...    parameter=chBwUl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.chBwUl}
    # ...    nodeType=Vcu
    &{modify_param3}    Create Dictionary
    ...    parameter=nrarfcnDl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.nrarfcnDl}
    # ...    nodeType=Vcu
    &{modify_param4}    Create Dictionary
    ...    parameter=nrarfcnUl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.nrarfcnUl}
    # ...    nodeType=Vcu

    @{modify_params}    Create List    ${modify_param}
    ...                ${modify_param1}
    ...                ${modify_param2}
    ...                ${modify_param3}
    ...                ${modify_param4}

    BuiltIn.Log      \nCU Parameters to modify:\n @{modify_params}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params      modify_param=@{modify_params}   oam=${GNB_CU.oam}


Set SCF 2535 for AiC and Classical
    [Arguments]          ${testParam}    ${btsType}=Classical
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
#      TestParam is ${testParam}

    ${btsNameClassical}=     Catenate    Classical ${testParam.scfFile.mrbts.btsName} ${testline_name}
    &{modify_param_Classical}    Create Dictionary
    ...    parameter=btsName
    ...    dist_name=MRBTS-${MRBTS_ID}
    ...    value=${btsNameClassical}
    ...    nodeType=Classical

    ${btsNameCU}=     Catenate    CU ${testParam.scfFile.mrbts.btsName} ${testline_name}
    # list param for vCU and VDU   or Classical
    &{modify_param_CU}    Create Dictionary
    ...    parameter=btsName
    ...    dist_name=MRBTS-${MRBTS_ID}
    ...    value=${btsNameCU}
    ...    nodeType=vCU

    ${btsNameDU}=     Catenate    DU ${testParam.scfFile.mrbts.btsName} ${testline_name}
    # list param for vCU and VDU   or Classical
    &{modify_param_DU}    Create Dictionary
    ...    parameter=btsName
    ...    dist_name=MRBTS-${MRBTS_ID}
    ...    value=${btsNameDU}
    ...    nodeType=vDU

    # list param for vCU and VDU   or  Classical
    ${nodeType}=     set variable if   '${btsType}' == 'Classical'    Classical
    ...                                                               VcuVdu

    &{modify_param1}    Create Dictionary
    ...    parameter=chBwDl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.chBwDl}
    ...    nodeType=${nodeType}
    &{modify_param2}    Create Dictionary
    ...    parameter=chBwUl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.chBwUl}
    ...    nodeType=${nodeType}
    &{modify_param3}    Create Dictionary
    ...    parameter=nrarfcnDl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.nrarfcnDl}
    ...    nodeType=${nodeType}
    &{modify_param4}    Create Dictionary
    ...    parameter=nrarfcnUl
    ...    dist_name=${NRCELL_DIST_NAME}/NRCELL_FDD-1
    ...    value=${testParam.scfFile.nrcellfdd.nrarfcnUl}
    ...    nodeType=${nodeType}
    &{modify_param5}    Create Dictionary
    ...    parameter=actInternalTrace
    ...    dist_name=MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/TRBLCADM-1
    ...    value=${testParam.scfFile.nrbts_trblcadm.actInternalTrace}
    ...    nodeType=${nodeType}
    &{modify_param6}    Create Dictionary
    ...    parameter=actCli
    ...    dist_name=MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/FEATCADM-1
    ...    value=${testParam.scfFile.nrbts_featcadm.actCli}
    ...    nodeType=${nodeType}

    ${nodeType}=     set variable if   '${btsType}' == 'Classical'    Classical
    ...                                                               Vdu

    ${gscn_value}=    get single value from scf file    parameter=${gscnParameterName}    dist_name=${NRCELL_DIST_NAME}   nodeType=${nodeType}
    # ${gscn_value}=   set variable   2503

    # list param for AiC VDU Only   or Classical
    ${nodeType}=     set variable if   '${btsType}' == 'Classical'    Classical
    ...                                                               Vdu
    &{modify_param7}=   Create dictionary
    ...     parameter=${gscnParameterName}
    ...     dist_name=${NRCELL_DIST_NAME}
    ...     value=${testParam.scfFile.nrcell.gscn}
    ...     nodeType=${nodeType}
    Dated log      gscn param: ${gscnParameterName}=${gscn_value} => updating with gscn=${testParam.scfFile.nrcell.gscn}

    &{modify_param8}    Create Dictionary
    ...    parameter=type0CoresetConfigurationIndex
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.type0CoresetConfigurationIndex}
    ...    nodeType=${nodeType}
    &{modify_param9}    Create Dictionary
    ...    parameter=cellName
    ...    dist_name=${NRCELL_DIST_NAME}
    ...    value=${testParam.scfFile.nrcell.cellName}
    ...    nodeType=${nodeType}
    # Classical or AiC => do not change localIpAddr of the TL !!!  => modify_param10 is not used
    &{modify_param10}    Create Dictionary
    ...    parameter=localIpAddr
    ...    dist_name=MRBTS-${MRBTS_ID}/TNLSVC-1/TNL-1/IPNO-1/IPIF-1/IPADDRESSV4-1
    ...    value=${testParam.scfFile.ipif.localIpAddr}
    ...     nodeType=Classical

# actInactDetNSAUe is DU param for Classical and CU param for AiC
    ${nodeType}=     set variable if   '${btsType}' == 'Classical'    Classical
    ...                                                               Vcu
    # &{modify_param11}    Create Dictionary
    # ...    parameter=actGeneralConnectivitySilver
    # ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    # ...    value=${testParam.scfFile.mrbts.actGeneralConnectivitySilver}
    # ...    nodeType=${nodeType}
    &{modify_param12}    Create Dictionary
    ...    parameter=actInactDetNSAUe
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...    value=${testParam.scfFile.mrbts.actInactDetNSAUe}
    ...    nodeType=${nodeType}


    @{modify_params}    Create List
    ...                ${modify_param1}
    ...                ${modify_param2}
    ...                ${modify_param3}
    ...                ${modify_param4}
    ...                ${modify_param5}
    ...                ${modify_param6}
    ...                ${modify_param7}
    ...                ${modify_param8}
    ...                ${modify_param9}
    # ...                ${modify_param11}
    ...                ${modify_param12}

    run Keyword if   '${btsType}' == 'Classical'    Append to list   ${modify_params}    ${modify_param_Classical}
    ...  ELSE                                       run Keywords     Append to list   ${modify_params}    ${modify_param_CU}  AND
    ...                                                              Append to list   ${modify_params}    ${modify_param_DU}

    BuiltIn.Log      \n${btsType} Parameters to modify:\n @{modify_params}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params AIC      modify_param=@{modify_params}


get cellDepType from SCF
    [Arguments]          ${nodeType}=Classical
    # Get SCF File (SCF.xml) in test setup
    ${current_scf_fullname}    set Variable      ${test_scf_file}
    scf.load_scf	 ${current_scf_fullname}
    # MRBTS-1/NRBTS-1/NRCELL-1
    ${cellDepType}	 scf.get_value_from_scf   p_name=cellDepType
    ...              dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...              nodeType=${nodeType}
    [return]     ${cellDepType}

Set cellBwpList SCF 2535
    [Arguments]          ${testParam}     ${nodeType}=Classical
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
#      TestParam is ${testParam}

    # WARNING : AF OAM Set Params dont support the code below !!!!
    return from Keyword if     '${isAic}' == '${True}'

    &{cellBwpList}    Create Dictionary     bwpDN=${testParam.scfFile.cellBwpList_Item1.bwpDN}
    ...                                     cellBwpId=${testParam.scfFile.cellBwpList_Item1.cellBwpId}
    &{cellBwpList2}    Create Dictionary     bwpDN=${testParam.scfFile.cellBwpList_Item2.bwpDN}
    ...                                      cellBwpId=${testParam.scfFile.cellBwpList_Item2.cellBwpId}
    @{cellBwpList_value}    create list
    Append To List    ${cellBwpList_value}    ${cellBwpList}    ${cellBwpList2}
    &{cellBwpList_value_params}   Create Dictionary   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    parameter=cellBwpList
    ...    value=${cellBwpList_value}
    dated log          cellBwpList_value_params=${cellBwpList_value_params}

    @{modify_param}    Create List    ${cellBwpList_value_params}

    BuiltIn.Log      \nDU Parameters to modify:\n @{modify_param}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params      modify_param=@{modify_param}

    return from Keyword if     '${nodeType}' == 'Classical'

    BuiltIn.Log      \nCU Parameters to modify:\n @{modify_param}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params      modify_param=@{modify_param}    oam=${GNB_CU.oam}


