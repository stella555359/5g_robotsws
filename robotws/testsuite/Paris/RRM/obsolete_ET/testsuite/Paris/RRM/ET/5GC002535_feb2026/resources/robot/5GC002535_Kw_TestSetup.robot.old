    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}

    # list param for AiC VDU or Classical
    ${nodeType}=     set variable if   '${btsType}' == 'Classical'    Classical
    ...                                                               Vdu

    &{dlDataDmrsFdm0}    Create Dictionary     actDlDataDmrsFdm=${testParam.scfFile.nrcell.actDlDataDmrsFdm}
    ...                 dlDataDmrsFdmThres256QamMcs=${testParam.scfFile.nrcell.dlDataDmrsFdmThres256QamMcs}

    @{dlDataDmrsFdm_value}    create list
    Append To List    ${dlDataDmrsFdm_value}    ${dlDataDmrsFdm0}
    &{dlDataDmrsFdm_params}   Create Dictionary   dist_name=${NRCELL_DIST_NAME}
    ...    parameter=dlDataDmrsFdm
    ...    value=${dlDataDmrsFdm_value}
    ...    nodeType=${nodeType}
    dated log          dlDataDmrsFdm_params=${dlDataDmrsFdm_params}

    @{modify_param}    Create List    ${dlDataDmrsFdm_params}
    BuiltIn.Log      \nDU Parameters to modify:\n @{modify_param}   console=yes
    OAM Set Params AIC      modify_param=@{modify_param}

