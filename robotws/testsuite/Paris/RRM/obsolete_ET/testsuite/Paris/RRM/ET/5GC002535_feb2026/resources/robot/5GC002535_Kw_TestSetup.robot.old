Set cellBwpList SCF 2535 for Aic and Classical version1 to remove later
    [Arguments]          ${testParam}     ${btsType}=Classical
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
#      TestParam is ${testParam}

    # list param for AiC VDU and VCU or Classical
    ${nodeType}=     set variable if   '${btsType}' == 'Classical'    Classical
    ...                                                               VcuVdu

    # @{cellBwpList_value_params}    create list
    &{cellBwpList_value_param1}   Create Dictionary   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    parameter=cellBwpList/0/bwpDN
    ...    value=${testParam.scfFile.cellBwpList_Item1.bwpDN}
    ...    nodeType=${nodeType}
    &{cellBwpList_value_param2}   Create Dictionary   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    parameter=cellBwpList/0/cellBwpId
    ...    value=${testParam.scfFile.cellBwpList_Item1.cellBwpId}
    ...    nodeType=${nodeType}
    &{cellBwpList_value_param3}   Create Dictionary   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    parameter=cellBwpList/1/bwpDN
    ...    value=${testParam.scfFile.cellBwpList_Item2.bwpDN}
    ...    nodeType=${nodeType}
    &{cellBwpList_value_param4}   Create Dictionary   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    parameter=cellBwpList/1/cellBwpId
    ...    value=${testParam.scfFile.cellBwpList_Item2.cellBwpId}
    ...    nodeType=${nodeType}
    # Append To List    ${cellBwpList_value_params}    ${cellBwpList_value_param1}    ${cellBwpList_value_param2}
    # ...        ${cellBwpList_value_param3}    ${cellBwpList_value_param4}
    # dated log          cellBwpList_value_params=${cellBwpList_value_params}

    @{modify_params}    Create List    ${cellBwpList_value_param1}    ${cellBwpList_value_param2}
    ...        ${cellBwpList_value_param3}    ${cellBwpList_value_param4}

    BuiltIn.Log      \n${btsType} Parameters to modify:\n @{modify_params}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params AIC      modify_param=@{modify_params}

Get Testline Name
    ${ret}    ${testline_name}=    OperatingSystem.Run And Return Rc And Output    hostname|sed 's/-/_/g'
    BuiltIn.Log     Testline Name: ${testline_name}      console=${True}
    BuiltIn.Log     Testline init file is /home/ute/testline_configuration/${testline_name}/       console=${True}
    Set Suite Metadata    Testline Name    ${testline_name}
    Set global variable   ${testline_name}
    [return]    ${testline_name}

Get Topology from Common Agent File
    [Arguments]    ${file_path}=/home/ute/testline_init_results/agent.log
    ${file_content}           OperatingSystem.Get File    ${file_path}
    ${label_from_install}     Should Match Regexp         ${file_content}    LABEL:\\s+(\\S+)
    ${variant_from_install}   Should Match Regexp         ${file_content}    VARIANT:\\s+(\\S+)
    Set Suite Variable        ${TOPOLOGY_LABEL}           ${label_from_install[1]}
    Set Suite Variable        ${TOPOLOGY_VARIANT}         ${variant_from_install[1]}
    Set Suite Metadata        Topology [Common Agent]     ${TOPOLOGY_LABEL}
    Set Suite Metadata        Variant [Common Agent]      ${TOPOLOGY_VARIANT}
