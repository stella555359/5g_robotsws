msg = module_name + " is imported from :"
StringTool.datedConsole(StringTool.getHeaderLine(msg, __file__))


#####################################################
# Configuration parameters
#####################################################

# wait 5g cell onair (CellSetup Acceptance Criteria)
WAIT_5G_CELL_ONAIR = 0

# COLLECT_LOGS if TEST STATUS is FAIL and EXCLUDE_LOGS_IF_FAIL == 0
# COLLECT_LOGS if COLLECT_LOGS == 1
EXCLUDE_LOGS_IF_FAIL = 0
COLLECT_LOGS = 0

#  gNB snapshot will be triggered at the end of the test in case of failed TC
#  Get sos report and snapshot only if test is fail
# mandatory for CRT to have snapshot in case of failed TC
ENABLE_TEST_TEARDOWN = 1

# To enable counter verification at the end of the test - mandatory for CRT
ENABLE_CHECK_COUNTERS = 1

# To enable/disable Test Suite Teardown - Enable IS mandatory for CRT
WITHOUT_TEST_SUITE_TEARDOWN = 0

# to perform unitary robot test
isUnitaryTest = 0

# to prepare MCShark use
WITH_MCSHARK = 0

# with BtsLog
WITH_BTSLOG = 1

