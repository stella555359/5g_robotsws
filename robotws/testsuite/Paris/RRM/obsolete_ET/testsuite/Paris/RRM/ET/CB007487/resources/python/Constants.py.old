def hello():
    print("This is imported from %s [%s]" % (__file__, os.path.basename(__file__)))
    module_name = os.path.basename(__file__)
    msg = module_name+" is imported from :"
    StringTool.datedConsole(StringTool.getHeaderLine(msg, __file__))
    exec_dir = BuiltIn().get_variable_value("${EXECDIR}")
    msg = "robot is executed from : "
    StringTool.datedConsole(StringTool.getHeaderLine(msg, exec_dir))
