#===== checks TTI KWs start =====

TTI Verification of Pool Id for given Subpool Id
    [Documentation]
    ...     Conditions:     it is based on the arguments ${pool_id} ${subpool_id} ${json_file}
    ...     Actions:        it verifies the pool id of the recommended sub pool id
    ...     Checks:         it checks the values within ul and dl InterL1SubpoolReconfData
    ...     Verdict:        pool id value is as expected
    [Arguments]             ${json_file}
    ...                     ${pool_id}
    ...                     ${subpool_id}
    Dated Log New Line     ===> Check if l1PoolId = ${pool_id} for subPoolId= ${subpool_id}
    ${result_check}        checkPoolId       ${json_file}     ${pool_id}     ${subpool_id}
    Should Be True         ${result_check}

TTI Verify ZAB Eligible Cell InterL1Sp
    [Documentation]         To check the zab previleged cell
    [Arguments]             ${NRCellId}
    ...                     ${expected_ZAB_value}
    ...                     ${json_file}

    Dated Log New Line    ===> check that NRCellID ${NRCellId} has ${expected_ZAB_value} ZAB priviledge

    ${ZAB_check}           checkZABPrivilege       ${NRCellId}     ${expected_ZAB_value}        ${json_file}
    Should Be True         ${ZAB_check}

TTI Verification of DL PRB Allocation Consistency
    [Documentation]
    ...     Conditions:     it is based on the arguments ${pool_id} ${pool_max_num_stream_prb}
    ...     Actions:        it verifies consistency of PRB allocation
    ...     Checks:         it checks the values within ul and dl InterL1SubpoolReconfData
    ...     Verdict:        poolMaxNumStreamPrb value is as expected && StreamPrbCapacityPerSp is consistent
    [Arguments]             ${pool_id}
    ...                     ${pool_max_num_stream_prb}
    ...                     ${json_file}
    Dated Log New Line    ===> check that l1SubPoolStreamPrbCapacity value is consistent
    ${result_check}        check_l1SubPoolStreamPrbCapacity_consistency    ${pool_id}    ${pool_max_num_stream_prb}    ${json_file}
    Should Be True         ${result_check}

TTI Verification of DL PRB Allocation within a range of min and max values
    [Documentation]
    ...     Conditions:     it is based on the arguments ${NRCellId} ${min_prb_value} ${max_prb_value}
    ...     Actions:        it verifies PRB Allocated within a range of min and max values
    ...     Checks:         it checks the values within dl InterL1SubpoolReconfData
    ...     Verdict:        numAllocCellPrbDl values are as expected
    [Arguments]             ${NRCellId}
    ...                     ${min_prb_value}
    ...                     ${max_prb_value}
    ...                     ${json_file}
    Dated Log New Line    ===> check numAllocCellPrbDl values for nrCellIdentity=${NRCellId}
    ${result_check}        check_numAllocCellPrbDl_within_a_range    ${NRCellId}    ${min_prb_value}    ${max_prb_value}    ${json_file}
    Should Be True         ${result_check}

#===== checks TTI KWs end =====

TC 10513 Inter L1 sub-pool 8DL8UL nonGBR GBR UL and DL Traffic
    [Documentation]
    [Arguments]            ${param}
    ...                    ${vendor_custom}
    ...                    ${dict_ues}
    ...                    ${nrCell}
    Init Sequence          ${param}
    ${test_name}           set variable    TC_CB010513_03165922_InterL1Sp
    Dated Log New Line     ${test_name}
    Dated Log New Line     ${vendor_custom}
    Step          Set RAD Params Of PRB Pooling Inter L1SubPool
    Step          CB008940-Common-Keywords.Deploy Vendor File Config    vendor_param=${vendor_custom}
    ...                    is_perform_full_commissioning=${False}
    #  Verify nidd flag of the new enhanced PRB Pooling Algorithm
    Dated Log New Line      Activate TDD PRB Pooling Enhanced Algorithm
    #  Check SCF
    ${current_scf}    String.Replace string    ${scf_suite_setup_backup}    _Suite_Setup_Backup.xml    ${EMPTY}
    ${updated_scf}    catenate    SEPARATOR=${EMPTY}    ${current_scf}_FR1_TDD_PRB_Pooling_Enhanced_Algorithm_enabled.xml
    ${std_output}=    Run    cp ${scf_suite_setup_backup} ${updated_scf}
    Dated Log New Line      Update scf : ${updated_scf}
    SCF StartSession        scf_file=${updated_scf}
    scf.load_scf    ${updated_scf}
    ${actBbPoolTddFr1AlgEnh}    scf.get_value_from_scf    p_name=actBbPoolTddFr1AlgEnh    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    Dated Log New Line       TDD PRB Pooling Enhanced Algorithm is set to : ${actBbPoolTddFr1AlgEnh}
    # Definition of the objects dist_name
    ${dist_name_mrbts}        Set Variable    MRBTS-${TMRBTS_ID[0]}
    Dated Log New Line        dist_name_mrbts is ${dist_name_mrbts}
    ${dist_name_nrbts}        Set Variable    ${dist_name_mrbts}/NRBTS-${TNRBTS_ID[0]}
    Dated Log New Line        dist_name_nrbts is ${dist_name_nrbts}
    # BtsName / update / + ${test_name}
    SCF Set element    dist_name=${dist_name_mrbts}    element_name=btsName    element_value=${test_name}    scope=Classical
    SCF Set element    dist_name=${dist_name_nrbts}    element_name=actBbPoolTddFr1AlgEnh    element_value=${True}    scope=Classical
    [return]     ${actBbPoolTddFr1AlgEnh}
    SCF StopSession                             scf_file=${updated_scf}
    OAM Perform Full Commissioning              scf_file=${updated_scf}
    OAM wait available
    OAM Get SCF File                            file=SCF_Updated_PRB_Pooling_Enhanced_Algorithm_enabled.xml
    Dated Log               SCF Update file =  ${updated_scf}
    Dated Log New Line     Configure Ue's dynamically
    ${initial_NbOfUe}       get length          ${dict_ues}
    Run Keyword If    ${initial_NbOfUe} < ${param.totalNbOfUe}    CB008940-Common-Keywords.Configure New Ues    ${dict_ues}
    ...                                                                                                         ${initial_NbOfUe}
    ...                                                                                                         ${param.totalNbOfUe}
    ...                                                                                                         ${dict_settings_ue_default}
    # Configure the current setting for all the ue's
    ${param.totalNbOfUe}    get length          ${dict_ues}
    Dated Log New Line           Configure the setting for the ${param.totalNbOfUe} ue's
    @{listOfUes}            Create List
    FOR    ${current_id}    IN RANGE    0    ${param.totalNbOfUe}
        ${current_ue}=                Evaluate                      ${current_id} + 1
        ${current_ueSetting}=         Copy Dictionary               ${BASIC_UE_SA}
        Set To Dictionary             ${current_ueSetting}          ue                  ${current_ue}
        Set To Dictionary             ${current_ueSetting}          pdu                 1
        Set To Dictionary             ${current_ueSetting}          trf_id              ${current_ue}
        Set To Dictionary             ${current_ueSetting}          target_gnb          ${param.targetGnb}
        # Dispatching each ue on the requested original cell for the call establishment
        Set To Dictionary             ${current_ueSetting}          target_cells           ${dict_ues[${current_id}].originalCell}
        # Set the correct requested throughput per ue
        Set To Dictionary             ${current_ueSetting}          DL_throughput          ${dict_ues[${current_id}].DL_throughput}
        Set To Dictionary             ${current_ueSetting}          DL_throughput_GBR      ${dict_ues[${current_id}].DL_throughput_GBR}
        Set To Dictionary             ${current_ueSetting}          UL_throughput          ${dict_ues[${current_id}].UL_throughput}
        Append To List                ${listOfUes}                  ${current_ueSetting}
    END
    Dated Log New Line                UE_List=${listOfUes}
    CB008940-Common-Keywords.Check Multi Ues Setting In List        multiUesList=${listOfUes}
    # Setup wtsemu SA for all the ue's
    Dated Log New Line      Setup wtsemu SA for all the ue's
    Critical Step           CallSetup.Setup Wtsemu SA               nbUe=${param.totalNbOfUe}
    ...                                                             nbSaUe=${param.totalNbOfUe}
    ...                                                             shouldUseLua=${False}
    ###...                                                          nbCell=${param.totalNbOfCell}
    ...                                                             list_of_UE_tobe_created=${listOfUes}
    Traced Sleep    duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    Step            CallSetup.WTS Set X2 Link
    Dated Log New Line         UE's registration
    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{listOfUes}
                            Critical Step       CallSetup.UE Register
        ...                                                         ue=${current_elem.ue}
        ...                 depends=CallSetup.Setup Wtsemu SA
                            Critical Step       CallSetup.Launch PDU Session
        ...                                                         ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         gw=${current_elem.ue}
        ...                 depends=CallSetup.UE Register
    END
    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        set test variable   ${current_elem}
        ${dir}=   set Variable If    ${current_elem.DL_throughput} > ${0}    DL
        ...                                                                  NONE
        ${kw to run}=   Catenate   ${dir} Traffic SA Not Stopped with "${current_elem.DL_throughput}"Mbps "${param.duration}"s duration
        ...                        and "${param.deviation}" percent deviation
        Run Keyword If      ${current_elem.DL_throughput} > ${0}
        ...      Critical Step     ${kw to run}       depends=CallSetup.Launch PDU Session

        ${dir}=   set Variable If    ${current_elem.UL_throughput} > ${0}    UL
        ...                                                                  NONE
        ${kw to run}=   Catenate   ${dir} Traffic SA Not Stopped with "${current_elem.UL_throughput}"Mbps "${param.duration}"s duration
        ...                        and "${param.deviation}" percent deviation
        Run Keyword If      ${current_elem.UL_throughput} > ${0}
        ...      Critical Step     ${kw to run}       depends=CallSetup.Launch PDU Session
    END
    # PDU session modify reserved for the ue's configured with GBR traffic
    ${nbOfUe_traffic_GBR}=   CB008940-Q-B2-Keywords.Get Number Of Ue Configured With GBR Traffic    dict_ues=${listOfUes}
    FOR    ${current_elem}    IN    @{listOfUes}
        CallSetup.UE PDU Session Modify       ue=${current_elem.ue}
        ...                                   pdu=${current_elem.pdu}
        ...                                   qfta=2
        ...                                   by=amf
    END
    # Start the GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        set test variable   ${current_elem}
        ${dir}=   set Variable If    ${current_elem.DL_throughput_GBR} > ${0}    DL
        ...                                                                      NONE
        ${kw to run}=   Catenate    ${dir} Traffic GBR SA Not Stopped with "${current_elem.DL_throughput_GBR}"Mbps "${param.duration}"s duration
        ...                         and "${param.deviation}" percent deviation
        Run Keyword If      '${current_elem.DL_throughput_GBR}' != '0'
        ...    Critical Step   ${kw to run}    depends=CallSetup.Launch PDU Session
    END
    Step    Activate Sherpa On All Cells
    Step    sleep    10s
    Step    Stop Sherpa Collection
    Step    CB010513-LBT27586-03165922-Keywords.TTI Trace Collection
    Step    Calling Panda Extract Csv function
    Step    CB008940-Common-Keywords.Verification of BB Pooling Mode within PRB Pooling Allocation Report    pool_id=10
    Step    CB008940-Common-Keywords.Verification of Pool Id within PRB Pooling Report    pool_id=10    subpool_id=0
    Step    CB008940-Common-Keywords.Verification of Pool Id within PRB Pooling Report    pool_id=10    subpool_id=1
    Step    CB008940-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4001    subpool_id=0
    Step    CB008940-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4002    subpool_id=1
    Step    CB008940-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4003    subpool_id=0
    Step    CB010513 InterL1SubPool Verification of NumMinPrbAlloc NumMaxPrbAlloc
    Step    CB010513-Common-Keywords.Verification of Stream PRB Information within PRB Pooling Report    stream_prb_capa=1800
    ...                                                                                                  alloc_stream_prb=1800
    ...                                                                                                  subpool_id=0
    ...                                                                                                  check_operator=>
    Step    CB010513-Common-Keywords.Verification of Stream PRB Information within PRB Pooling Report    stream_prb_capa=500
    ...                                                                                                  alloc_stream_prb=500
    ...                                                                                                  subpool_id=1
    ...                                                                                                  check_operator=>
    Step    Verify ZAB Eligible Cells InterL1Sp
    Step    CB010513 InterL1SubPool Verification of DL PRB Demand
    Step    CB010513 InterL1SubPool Verification of DL PRB Allocation

#   SWENG 3.15.53 KPIs.robot AttributeError NoneType Object issue preventing belows KPI https://jiradc.ext.net.nokia.com/browse/FIVEG_FTPS-49046
