    FOR    ${current_elem}    IN    @{listOfUes}
        Run Keyword If      ${current_elem.target_cells} != ${nrCell}
        ...                 Step      CallSetup.UE Deregister       id=${current_elem.ue}
        ...                                                         depends=CallSetup.UE Register
    END

Suite Setup CB010513-ABIO
    [Documentation]
    ...     Conditions:     customs configurations scf et basic setup
    ...     Actions:        it performs the generic suite setup and backup the configurations files
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        suite setup is passed
    [Arguments]             ${scfPath}=${EMPTY}
    ...                     ${basiccfgPath}=${EMPTY}
    Setup.Suite Setup From Scratch
    ...                     keepAllUeDataInCfgFile=${True}
    ...                     automaticTeardown=${True}
    ...                     scfcPathname=${scfPath}
    ...                     basicPathname=${basiccfgPath}
    Backup Files
    ${scf_suite_setup_backup}         OAM Get SCF File    file=SCF_Suite_Setup_Backup.xml
    Set Suite Variable      ${scf_suite_setup_backup}
    Dated Log               SCF backup file = ${scf_suite_setup_backup}

Set RAD Params Of PRB Pooling Intra L1SubPool
   [Documentation]      Add the RAD params to enable the new PRB Pooling Enhancement
    ...                 will be replaced in 24R1 by NIDD param actBbPoolTddFr1AlgEnh
    ...                 0x580787=1 : actBbPoolTddFr1AlgEnh=True - 0 : Disabled - 1 : Enabled
    ...                 0x580117=1 : CSI-RS Event Sherpa
    ...                 0x58066a=1 : InterL1SubPool    - 0 : Disabled(IntraL1SubPool) - 1 : Enabled(InterL1SubPool)
    ...                 0x580690=0 : ZAB Disabled
    ...                 0x420080=0 : rdTddSubCellDeactivation  CB09890 BB pooling Subcell deactivation
    Dated Log New Line   Set RAD Params Of PRB Pooling enhancement and Disable Inter L1SubPool ......
    ${rad_param_1}=      create dictionary       field=0x580117    value=1
    ${rad_param_2}=      create dictionary       field=0x580787    value=1
    ${rad_param_3}=      create dictionary       field=0x58066a    value=0
    ${rad_param_4}=      create dictionary       field=0x420080    value=0
    ${rad_param_5}=      create dictionary       field=0x580690    value=0
    ${rad_param_list}=       Create List         ${rad_param_1}
#   ...                                          ${rad_param_2}  actBbPoolTddFr1AlgEnh enabled via Nidd
    ...                                          ${rad_param_3}
#   ...                                          ${rad_param_4}
    ...                                          ${rad_param_5}
    Dated Log New Line    RAD params:  ${rad_param_list}
    SetConfig.Set Fields in swconfig DU       param_list=${rad_param_list}
    Dated Log New Line   RAD params of the new 24R1 PRB Pooling enhancement completed

Set RAD Params Of PRB Pooling Inter L1SubPool
   [Documentation]      Add RAD params to force new PRB Pooling Enhancement Algoritm until 24R1 release
    ...                 will be replaced in 24R1 by NIDD param actBbPoolTddFr1AlgEnh
    ...                 0x580117=1 : CSI-RS Event Sherpa
    ...                 0x580787=1 : actBbPoolTddFr1AlgEnh=True - 0 : Disabled - 1 : Enabled
    ...                 0x58066a=1 : InterL1SubPool    - 0 : IntraL1SubPool - 1 : InterL1SubPool
    ...                 0x420080=0 : rdTddSubCellDeactivation
    ...                 0x580690=1 : ZAB enabled
    Dated Log New Line   Set RAD Params Of PRB Pooling enhancement and Disable Inter L1SubPool ......
    ${rad_param_1}=      create dictionary       field=0x580117    value=1
    ${rad_param_2}=      create dictionary       field=0x580787    value=1
    ${rad_param_3}=      create dictionary       field=0x58066a    value=1
    ${rad_param_4}=      create dictionary       field=0x420080    value=0
    ${rad_param_5}=      create dictionary       field=0x580690    value=1
    ${rad_param_list}=       Create List         ${rad_param_1}
#   ...                                          ${rad_param_2}
    ...                                          ${rad_param_3}
#   ...                                          ${rad_param_4}
    ...                                          ${rad_param_5}
    Dated Log New Line    RAD params:  ${rad_param_list}
    SetConfig.Set Fields in swconfig DU       param_list=${rad_param_list}
    Dated Log New Line   RAD params of the new 24R1 PRB Pooling enhancement completed

Configure Multi UE Dynamically
    [Arguments]             ${dict_ues}
    ${initial_NbOfUe}       get length            ${dict_ues}
    CB008940-Common-Keywords.Configure New Ues    ${dict_ues}
    ...                                           ${initial_NbOfUe}
    ...                                           ${param.totalNbOfUe}
    ...                                           ${dict_settings_ue_default}
    # Configure the current setting for all the ue's
    ${param.totalNbOfUe}    get length          ${dict_ues}
    Step                    Dated Log           Configure the setting for the ${param.totalNbOfUe} ue's
    @{listOfUes}            Create List
    FOR    ${current_id}    IN RANGE    0    ${param.totalNbOfUe}
        ${current_ue}=                Evaluate                      ${current_id} + 1
        ${current_ueSetting}=         Copy Dictionary               ${BASIC_UE_SA}
        Set To Dictionary             ${current_ueSetting}          ue                  ${current_ue}
        Set To Dictionary             ${current_ueSetting}          pdu                 1
        Set To Dictionary             ${current_ueSetting}          trf_id              ${current_ue}
        Set To Dictionary             ${current_ueSetting}          target_gnb          ${param.targetGnb}
        # Dispatching each ue on the requested original cell for the call establishment
        Set To Dictionary             ${current_ueSetting}          target_cells           ${dict_ues[${current_id}].originalCell}
        # Set the correct requested throughput per ue
        Set To Dictionary             ${current_ueSetting}          DL_throughput          ${dict_ues[${current_id}].DL_throughput}
        Set To Dictionary             ${current_ueSetting}          DL_throughput_GBR      ${dict_ues[${current_id}].DL_throughput_GBR}
        Set To Dictionary             ${current_ueSetting}          UL_throughput          ${dict_ues[${current_id}].UL_throughput}
        Append To List                ${listOfUes}                  ${current_ueSetting}
    END
    Dated Log New Line                UE_List=${listOfUes}
    CB008940-Common-Keywords.Check Multi Ues Setting In List        multiUesList=${listOfUes}

Multi Cells Setup
    [Arguments]       ${nbCell}
    ${msgStr}=    Catenate  Test ${nbCell} Cells Setup
    Dated Log   ${msgStr}
    # Setup wtsemu SA for all the ue's
    Traced Sleep            duration=60s         msg=before setup Wtsemu SA to give radio modules time to start
    Critical Step           CallSetup.Setup Wtsemu SA               nbUe=${param.totalNbOfUe}
    ...                                                             nbSaUe=${param.totalNbOfUe}
    ...                                                             shouldUseLua=${True}
    ###...                                                          nbCell=${totalNbOfCell}
    ...                                                             list_of_UE_tobe_created=${listOfUes}
    WTS Set X2 Link
    sleep    5s
    # WTS Testmode Decode PDSCH On SSB Slot

UE Registration and PDU Session establishment
    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{listOfUes}
                            Critical Step       CallSetup.UE Register
        ...                                                         ue=${current_elem.ue}
        ###...                                                      nwslice=1
        ###...                                                      timeout=30
        ...                 depends=CallSetup.Setup Wtsemu SA
                            Critical Step       CallSetup.Launch PDU Session
        ...                                                         ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         gw=${current_elem.ue}
        ###...                                                      nwslice=1
        ...                 depends=CallSetup.UE Register
    END

Launch UL DL nonGBR Traffic
    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        set test variable   ${current_elem}
        ${dir}=   set Variable If    ${current_elem.DL_throughput} > ${0}    DL
        ...                                                                  NONE
        ${kw to run}=   Catenate   ${dir} Traffic SA Not Stopped with "${current_elem.DL_throughput}"Mbps "${param.duration}"s duration
        ...                        and "${param.deviation}" percent deviation
        Run Keyword If      ${current_elem.DL_throughput} > ${0}
        ...      Critical Step     ${kw to run}       depends=CallSetup.Launch PDU Session

        ${dir}=   set Variable If    ${current_elem.UL_throughput} > ${0}    UL
        ...                                                                  NONE
        ${kw to run}=   Catenate   ${dir} Traffic SA Not Stopped with "${current_elem.UL_throughput}"Mbps "${param.duration}"s duration
        ...                        and "${param.deviation}" percent deviation
        Run Keyword If      ${current_elem.UL_throughput} > ${0}
        ...      Critical Step     ${kw to run}       depends=CallSetup.Launch PDU Session
    END

Launch UL DL GBR Traffic
    # PDU session modify reserved for the ue's configured with GBR traffic
    ${nbOfUe_traffic_GBR}=   CB008940-Q-B2-Keywords.Get Number Of Ue Configured With GBR Traffic    dict_ues=${listOfUes}
    FOR    ${current_elem}    IN    @{listOfUes}
        CallSetup.UE PDU Session Modify       ue=${current_elem.ue}
        ...                                   pdu=${current_elem.pdu}
        ...                                   qfta=2
        ...                                   by=amf
    END
    # Start the GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        set test variable   ${current_elem}
        ${dir}=   set Variable If    ${current_elem.DL_throughput_GBR} > ${0}    DL
        ...                                                                      NONE
        ${kw to run}=   Catenate    ${dir} Traffic GBR SA Not Stopped with "${current_elem.DL_throughput_GBR}"Mbps "${param.duration}"s duration
        ...                         and "${param.deviation}" percent deviation
        Run Keyword If      '${current_elem.DL_throughput_GBR}' != '0'
        ...    Critical Step   ${kw to run}    depends=CallSetup.Launch PDU Session
    END

WTS Testmode Decode PDSCH On SSB Slot
    wtsemu.ue_testmode_decode_muxphychan    decode_mux_phy_chan=decode_PDSCH
    sleep    2s

Recommissioning
    Oam.OAM Perform Full Commissioning       scf_file=${SCF_SETUP_PATH}
    WA Airscale Wait For Ready               ${GNB_DU}

