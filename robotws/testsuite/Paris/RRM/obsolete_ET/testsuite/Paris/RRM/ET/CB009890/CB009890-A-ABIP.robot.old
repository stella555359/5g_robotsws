*** Test Cases ***
### SA

# CB009890-A_01_Secondary_DL_Subcell_Deactivation_based_On_Load_Based_Algorithm for ABIP(LBT27586 - 03165922 - TMO CAS)
CB009890_A_01_Secondary_DL_Subcell_Deactivation_based_On_Load_Based_Algorithm_MP
    [Documentation]
    ...     This Test Case is for testing ABIP Parity on CB009890-A
    ...     Conditions:     it is based on the configuration ${C_Cell}
    ...                     GNB is configured with profile CB006915-N#1 CFG#4
    ...                     CFG#4	"Three cells are configured on each BB board -
    ...                     CB010513 (NIDD actBbPoolTddFr1AlgEnh=true) is activated by default
    ...                              3x100MHz 8DL-4UL streams NR TDD FR1 BF cell"
    ...                              Cell1 & Cell3 in L1SubPool1
    ...                              Cell2 in L1SubPool2
    ...                     TDD Frame Structure is set to semi static
    ...                       NRBTS/NRCELL/tddFrameStructure. frameStructureType = semiStatic
    ...                       NRBTS/NRCELL/tddFrameStructure. guardPeriodLength = 2Symbols
    ...                       NRBTS/NRCELL/tddFrameStructure. ulDlDataSlotRatio = 1/4
    ...                     Preparation of the TL is needed first
    ...                         actDlSrsBm is activated
    ...                         srsForBeamMgmt at Cell level
    ...                              <list name="srsForBeamMgmt">
    ...                                   <item>
    ...                                   <p name="bSRS">2</p>
    ...                                   <p name="cSRS">63</p>
    ...                                   <p name="srsPowerThresholdForDlBm">-1200</p>
    ...                                   <p name="srsTypeAllocForDlBm">antenna switching or codebook</p>
    ...                                   <p name="srsUePeriodicity">slots40</p>
    ...                                   </item>
    ...                              </list>
    ...                        actUeCsirsCoexistCellCsirs = TRUE
    ...                    In egate, you need to activate the Srs mode : cfg file modified by KW
    ...                                                       "Update Basic Configuration File for actDlSrsBm Test Mode"
    ...                      cell_srs_beam_pos_nr profile_id=1 num_of_ue_positions=4 azimuth=-70,-19,20,70
    ...                      cell_testmode_set_nr cell_id=1 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
    ...                      cell_testmode_set_nr cell_id=2 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
    ...                      cell_testmode_set_nr cell_id=3 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
    ...                    Test with 6 Ues (2Ues per Cells)
    ...                     Ue1, Ue3 and Ue5 ue_srs_beam_pos init_pos0 srsMode=fixed
    ...                     Ue2, Ue4 and Ue6 ue_srs_beam_pos init_pos3 srsMode=fixed
    ...                    Ue settings defined into ${relative_json_path} json file
    ...     Checks / Verdict:
    ...                     Check that nb of dlSubCell per L1pool and L1Spool dont exceed maxNumDlSubcellL1Pool and maxNumDlSubcellL1Sp
    ...                               defined in Vendor File
    ...                                     NRBTS\bbPoolCapacity\maxNumDlSubcellL1Pool for ASOE: 5
    ...                                     NRBTS\bbPoolCapacity\maxNumDlSubcellL1Sp for ASOE: 4
    ...                     Based on dlTdSchedSubcellData,numAllocCellPrbDl , check prbstreamcapa as expected
    ...                      for subpool1 and subpoll2
    ...                     Calls for multi ues and PRB pooling are passed / no Dtx / no Dl Bler
    [Tags]  CRT
    TC CB009890 FOR ABIP  ${C_Cell}    ${dictParam}    ${Vendor_IWK_CB8940-L_CB7113}    ${dict_settings_all_ues}    nrCell=3
    ...          kw Set RAD Params=Set RAD Params for 9890-A
    ...          kw NIDD Set=Set CB009890-A NIDD PARAMETERS with dlMUMIMO
    ...          kw NIDD Check=Check CB009890-A NIDD PARAMETERS with dlMUMIMO
    ...          kw Set TestMode=Update Basic Configuration File for actDlSrsBm Test Mode with azimuth=-70,-19,20,70
    ...          kw Specific Set TestMode Before Attach=Override and Activate Ue SRS Beam pos profile 2 for all ${C_Cell.totalNbOfUe} Ues
    ...          kw Specific Set TestMode After Attach=Override and Activate UE CSI profile for all ${C_Cell.totalNbOfUe} Ues
    ...          NIDD_9890_PARAMS=${NIDD_9890_w_CB008940_CB007113_PARAMS_ABIP}
    ...          kw Specific Check=Check PRB Assignment CB009890-A TC1
    ...          kw Check SCF parameters=verify_SCF_Paramaters
    ...          Kw TestLine Preparation=TL_Preparation_CB009890_SCF_CB006915_CFG_4_woBSR
    ...          Json test configuration=${relative_json_path}

# CB009890-A_01_Secondary_DL_Subcell_Deactivation_based_On_Load_Based_Algorithm_ABIP
PRV_CB009890-A_01_Secondary_DL_Subcell_Deactivation_based_On_Load_Based_Algorithm_ABIP_OLD_ALGO
    [Documentation]
    ...     This Test Case is for testing ABIP Parity on CB009890-A
    ...     Conditions:     it is based on the configuration ${C_Cell}
    ...                     GNB is configured with profile CB006915-N#1 CFG#4
    ...                     CB010513 (NIDD actBbPoolTddFr1AlgEnh=true) is activated by default
    ...                     CFG#4	"Three cells are configured on each BB board -
    ...                              3x100MHz 8DL-4UL streams NR TDD FR1 BF cell"
    ...                              Cell1 & Cell3 in L1SubPool1
    ...                              Cell2 in L1SubPool2
    ...                     TDD Frame Structure is set to semi static
    ...                       NRBTS/NRCELL/tddFrameStructure. frameStructureType = semiStatic
    ...                       NRBTS/NRCELL/tddFrameStructure. guardPeriodLength = 2Symbols
    ...                       NRBTS/NRCELL/tddFrameStructure. ulDlDataSlotRatio = 1/4
    ...                     Preparation of the TL is needed first
    ...                         actDlSrsBm is activated
    ...                         srsForBeamMgmt at Cell level
    ...                              <list name="srsForBeamMgmt">
    ...                                   <item>
    ...                                   <p name="bSRS">2</p>
    ...                                   <p name="cSRS">63</p>
    ...                                   <p name="srsPowerThresholdForDlBm">-1200</p>
    ...                                   <p name="srsTypeAllocForDlBm">antenna switching or codebook</p>
    ...                                   <p name="srsUePeriodicity">slots40</p>
    ...                                   </item>
    ...                              </list>
    ...                        actUeCsirsCoexistCellCsirs = TRUE
    ...                    In egate, you need to activate the Srs mode : cfg file modified by KW
    ...                                                       "Update Basic Configuration File for actDlSrsBm Test Mode"
    ...                      cell_srs_beam_pos_nr profile_id=1 num_of_ue_positions=4 azimuth=-70,-19,20,70
    ...                      cell_testmode_set_nr cell_id=1 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
    ...                      cell_testmode_set_nr cell_id=2 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
    ...                      cell_testmode_set_nr cell_id=3 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
    ...                    Test with 6 Ues (2Ues per Cells)
    ...                     Ue1, Ue3 and Ue5 ue_srs_beam_pos init_pos0 srsMode=fixed
    ...                     Ue2, Ue4 and Ue6 ue_srs_beam_pos init_pos3 srsMode=fixed
    ...                    Ue settings defined into ${relative_json_path} json file
    ...     Checks / Verdict:
    ...                     Check that nb of dlSubCell per L1pool and L1Spool dont exceed maxNumDlSubcellL1Pool and maxNumDlSubcellL1Sp
    ...                               defined in Vendor File
    ...                                     NRBTS\bbPoolCapacity\maxNumDlSubcellL1Pool for ASOE: 5
    ...                                     NRBTS\bbPoolCapacity\maxNumDlSubcellL1Sp for ASOE: 4
    ...                     Based on dlTdSchedSubcellData,numAllocCellPrbDl , check prbstreamcapa as expected
    ...                      for subpool1 and subpoll2
    ...                     Calls for multi ues and PRB pooling are passed / no Dtx / no Dl Bler
    [Tags]  CRT
    TC CB009890 FOR ABIP  ${C_Cell}    ${dictParam}    ${Vendor_IWK_CB8940-L_CB7113}    ${dict_settings_all_ues}    nrCell=3
    ...          kw Set RAD Params=Set RAD Params for 9890-A
    ...          kw NIDD Set=Set CB009890-A NIDD PARAMETERS with dlMUMIMO
    ...          kw NIDD Check=Check CB009890-A NIDD PARAMETERS with dlMUMIMO
    ...          kw Set TestMode=Update Basic Configuration File for actDlSrsBm Test Mode with azimuth=-70,-19,20,70
    ...          kw Specific Set TestMode Before Attach=Override and Activate Ue SRS Beam pos profile 2 for all ${C_Cell.totalNbOfUe} Ues
    ...          kw Specific Set TestMode After Attach=Override and Activate UE CSI profile for all ${C_Cell.totalNbOfUe} Ues
    ...          NIDD_9890_PARAMS=${NIDD_9890_w_CB008940_CB007113_PARAMS_ASOE_OLD_ALGO}
    ...          kw Specific Check=Check PRB Assignment CB009890-A TC1
    ...          kw Check SCF parameters=verify_SCF_Paramaters
    ...          Kw TestLine Preparation=TL_Preparation_CB009890_SCF_CB006915_CFG_4_woBSR
    ...          Json test configuration=${relative_json_path}


