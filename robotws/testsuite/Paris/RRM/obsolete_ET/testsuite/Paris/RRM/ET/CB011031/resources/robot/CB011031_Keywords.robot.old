Check SSBlock and 5GC002538 IWK in L1L2 Logs master

    Dated Log New Line      ===> CaptureBip.name: ${CaptureBip.name}
    Dated Log New Line      ===> LOG_PATH: ${LOG_PATH}
    ${file}=                catenate    ${LOG_PATH}/${CaptureBIP.name}.pcap
    Dated Log New Line      ===> PCAP L1L2 PATH: ${file}
    Dated Log New Line      Extract dldata_ssblocksendreql1sw and dldata_pdschpayloadtbsendreql1sw
    ...                   and dldata_csirssendreql1sw info from L1L2 PCAP file : ${file}


# filter L1L2 trace with exact wireshark columns needed for analyses
    set test variable                 ${pcapprocessed}           L1L2_IWK_2534_2538.csv
    set test variable                 ${pcapprocessed_path}      ${LOG_PATH}/${pcapprocessed}

    ${cmd_mcshark}      Catenate    tshark -r
    ...                 ${file}
    ...                 -T fields -Y "dldata_ssblocksendreql1sw || dldata_pdschpayloadtbsendreql1sw || dldata_csirssendreql1sw" -e _ws.col.info
    ...                 -e 3gpp.sfn
    ...                 -e 3gpp.slot
    ...                 -e 3gpp.subcellid
    ...                 -e DlData_CsiRsResourceL1sw_t.startSymbol
    ...                 -E header=y -E separator=';' > ${pcapprocessed_path}
    Run                 ${cmd_mcshark}

    Run      command=sed -i -e 's/ //g' ${pcapprocessed_path}

# Check in Python IWK between CB011031 and 5GC002534 and 5GC002538
    ${results}              CheckFileIWK2538master      csvPathName=${pcapprocessed_path}

# Report issue if there is not SFN on subcell0 slot1 with coexistence of PDSCH and SSB
    ${status_IWK_subcell0slot1}=         run keyword and return status    Should be True         ${results}[iwk2538occurslot1] >= 1
    Run Keyword if          ${status_IWK_subcell0slot1} >= 1
    ...            Dated Log New Line     ${trcColor}--- There are CsiRs on the same SFN,slot as SSB and PDSCH of subcellId0 ${defColor}
    ...        ELSE
    ...            Dated Log New Line     ${trcColor}--- There are CsiRs issues on subcellId0  = ${results}[iwk2538occurslot1] ${defColor}

    ${status_IWK_subcell0slot2}=         run keyword and return status    Should be True         ${results}[iwk2538occurslot2] >= 1
    Run Keyword if          ${status_IWK_subcell0slot2} >= 1
    ...            Dated Log New Line     ${trcColor}--- There are CsiRs slot2 symb6,10 on same SFN as SSB/PDSCH of subcellId0 ${defColor}
    ...        ELSE
    ...            Dated Log New Line     ${trcColor}--- There are CsiRs issues on subcellId0  = ${results}[iwk2538occurslot2] ${defColor}

    ${status_2538slot1_subcell0}=         run keyword and return status    Should be True         ${results}[iwk2538issueslot1occur] == 0
    Run Keyword if          ${status_2538slot1_subcell0} == 0
    ...            Dated Log New Line     ${trcColor}--- CsiRs is on symbol 6 or 10 of slot 1 subcellId0 ${defColor}
    ...        ELSE
    ...            Dated Log New Line     ${trcColor}--- CsiRs not exp Symb / Slt1 SbCl0 = ${results}[iwk2538issueslot1occur] ${defColor}

    ${status_2538slot2_subcell0}=         run keyword and return status    Should be True         ${results}[iwk2538issueslot2occur] == 0
    Run Keyword if          ${status_2538slot2_subcell0} == 0
    ...            Dated Log New Line     ${trcColor}--- CsiRs is on symbol 6 or 10 of slot 2 subcellId0 ${defColor}
    ...        ELSE
    ...            Dated Log New Line     ${trcColor}--- CsiRs not exp Symb / Slt 2 SbCl0 = ${results}[iwk2538issueslot2occur] ${defColor}


    Should be True          ${status_IWK_subcell0slot1} == True          msg=CsiRs is mixed with SSB and PDSCH on slot1, same SFN
    Should be True          ${status_IWK_subcell0slot2} == True          msg=CsiRs slot2 is on the same SFN that PDSCH,SSB, CSIRS slot1
    Should be True          ${status_2538slot1_subcell0} == True          msg=CsiRs is on symbol 6 or 10 of slot 1 when SSB shift
    Should be True          ${status_2538slot2_subcell0} == True          msg=CsiRs is on symbol 6 or 10 of slot 2 when SSB shift

