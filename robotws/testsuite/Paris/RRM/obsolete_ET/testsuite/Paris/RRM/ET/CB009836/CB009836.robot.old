[1]CB009836_A_10_tdLTE_1116_3ms_Canada_SANSA_Mixed_BW_ASOE_2SS_SSB_2
    [Documentation]
    ...     Conditions:     it is based on the configuration ${C_Cell}
    ...                     Beware that this TC is not fully automatic (not be part of CRT tests)
    ...                     need first to prepare manually the UTE TL (CLOUD_5G_O_E_AP_LOO_8DL8UL) with scf
    ...                      "Configuration_scf_MRBTS-1-2_subsectors_4T2R_1_CHANNELGROUP_w_8Tx_8Rx-4Cells-RU-AZQL_ASOE.xml"
    ...                       DO NOT FORGET TO ADAPT THE VLANID in this SCF (MRBTS-1/TNLSVC-1/TNL-1/ETHSVC-1/ETHIF-1/VLANIF-1)
    ...                       with the vlanId of the UTE TL
    ...                      (see testsuite/Paris/RRM/ET/CB009836/resources/config/custom/CLOUD_5G_O_E_AP_LOO_8DL8UL)
    ...                      this allow to create 1 ChannelGroup + 8 ANTL + 16 channels (8 Tx and 8 Rx) by Cell to support BeamSet_2SS
    ...                      and to adapt scf for simulated RU AZQJ
    ...                     After, runRobot with SHOULD_BE_COMMISSIONED_GNB_FIRST=1, UPDATE_SCF=1 and WITH_APPLY_DELTA_COMMISSIONING=1
    ...     Actions:        based on dlTdSchedSubcellData,numAllocCellPrbDl , check prbstreamcapa as expected
    ...                      for subpool1 and subpoll2
    ...     Checks:
    ...     Verdict:        calls for multi ues and PRB pooling are passed
    [Tags]  CLOUD_5G_O_E_AP_LOO_8DL8UL     VARIANT_SANSA_FS_ECPRI_CMWV_TDD    CB009836-A    CB009836-A-10
    Set To Dictionary       ${C_Cell}    totalNbOfUe       4
    Set test Variable       ${GNB_PLATFORM_TYPE}           ASOE
    Set test Variable       ${LuaFileToUsed_path}          ${LuaFileToUsed_path_TddLte_3_Canada_ASOE}
    Set test Variable       ${iphy_file_4Cells}            ${iphy_file_4Cells_AZQJ}
    # vlanId is updated by modify_scf_and_perform_full_commission
    @{LIST_PARAM_EMPTY}=     Create List
    Run Keyword if     '${SHOULD_BE_COMMISSIONED_GNB_FIRST}'=='1' and '${UPDATE_SCF}'=='1'
    ...       Dev_lib.modify_scf_and_perform_full_commission    ${scf_file_startup_for_2_SubSectors}    ${LIST_PARAM_EMPTY}
    TC CB009836 4 Cells   ${C_Cell}    ${dictParam}    ${Vendor_IWK_CB8940-L_CB7113}    ${dict_settings_all_ues}    nrCell=4
    ...       Kw TestLine Preparation=TL_Preparation_CB009836_4Cells_4DL_2UL_w_SubSector
    ...       kw Set RAD Params=Set RAD Params Of 9836 ASOE
    # ...       kw Active Config=${EMPTY}
    ...       kw Active Config=12_CB009836_A01_02_BW_100_100_100_100_5GC001116_3_Canada_2ssb_80sl_ss_2_ASOE
    ...       kw Specific Set TestMode After Attach=Override and Activate UE CSI profile for all ${C_Cell.totalNbOfUe} Ues
    ...       NIDD_9836_PARAMS=${NIDD_9836_DL_MIMO_w_CB008940_CB007113_PARAMS_ASOE_SS}
    ...       kw Specific Check=Check Trs and CsiRs Periodicity From l1l2 pcap
    ...       Json test configuration=${relative_json_path}
    ...       FrameStructure=5GC001116_3_Canada

