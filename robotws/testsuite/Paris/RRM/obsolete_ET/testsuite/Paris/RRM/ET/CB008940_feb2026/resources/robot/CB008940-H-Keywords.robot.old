Check 8940 PM Counters Expected values
    [Documentation]                 To Check 8940 PM counter values are as exepected
    [Arguments]                     ${8940_PM_Counters_Expected}
    Dated Log                       =======================================================================
    Dated Log                       PM counter : ${8940_PM_Counters_Expected.PM_ID}
    Dated Log                       PM counter : ${8940_PM_Counters_Expected}
    Dated Log                       --------------------------------------------------------------------------------
    ${Value_PM_Counter_Cell_1}=     Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                                    ${LATEST_PM_FILE}       ${8940_PM_Counters_Expected.PM_ID}       1
    Dated Log                       Value of PM counter : ${8940_PM_Counters_Expected.PM_ID} : cell : 1 : ${Value_PM_Counter_Cell_1}
    ${Value_PM_Counter_Cell_2}=     Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                                    ${LATEST_PM_FILE}       ${8940_PM_Counters_Expected.PM_ID}       2
    Dated Log                       Value of PM counter : ${8940_PM_Counters_Expected.PM_ID} : cell : 2 : ${Value_PM_Counter_Cell_2}
    ${Value_PM_Counter_Cell_3}=     Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                                    ${LATEST_PM_FILE}       ${8940_PM_Counters_Expected.PM_ID}       3
    Dated Log                       Value of PM counter : ${8940_PM_Counters_Expected.PM_ID} : cell : 3 : ${Value_PM_Counter_Cell_3}

    ${status}    ${message}         BuiltIn.Run Keyword And Warn On Failure
    ...                             Compare Counters to Reference
    ...                                     value=${Value_PM_Counter_Cell_1}                reference=${8940_PM_Counters_Expected.CELL_1_Expected}
    ...                                     pm_name=${8940_PM_Counters_Expected.PM_ID}      delta=25                cell=1
    Run keyword if                  '${status}'=='FAIL'
    ...                             Dated Log           >>> INCORRECT VALUE FOR COUNTER - PLEASE TAKE ACTION TO UNDERSTAND WHY !

    ${status}    ${message}         BuiltIn.Run Keyword And Warn On Failure
    ...                             Compare Counters to Reference
    ...                                     value=${Value_PM_Counter_Cell_2}                reference=${8940_PM_Counters_Expected.CELL_2_Expected}
    ...                                     pm_name=${8940_PM_Counters_Expected.PM_ID}      delta=35                cell=2
    Run keyword if                  '${status}'=='FAIL'
    ...                             Dated Log           >>> INCORRECT VALUE FOR COUNTER - PLEASE TAKE ACTION TO UNDERSTAND WHY !

    ${status}    ${message}         BuiltIn.Run Keyword And Warn On Failure
    ...                             Compare Counters to Reference
    ...                                     value=${Value_PM_Counter_Cell_3}                reference=${8940_PM_Counters_Expected.CELL_3_Expected}
    ...                                     pm_name=${8940_PM_Counters_Expected.PM_ID}      delta=35                cell=3
    Run keyword if                  '${status}'=='FAIL'
