*** Variables ***
${TestSharkTool}            MC_SHARK

&{params}                   nbCell=3
...                         duration=30
...                         deviation=40


&{Vendor_Param}             bbHwVariant=ABIO
...                         maxNumScheUePdschL1Pool=None        # bbPoolCapacity
...                         maxNumScheUePdschL1Sp=None          # bbPoolCapacity
...                         maxNumLayerPrbL1Sp=1650             # bbL1SpPrbInitCapacity
...                         maxNumStreamPrbL1Sp=1650            # bbL1SpPrbInitCapacity
...                         maxNumWbStreamPrbL1Sp=550



# ue's settings
&{dict_settings_ue_1}                                               originalCell=1               # original cell for call establishment
...                                                                 throughput=600               # throughput nonGBR
...                                                                 throughput_GBR=0             # throughput GBR
...                                                                 ue_nr_capa=${SA_TDD_RANK4}

&{dict_settings_ue_2}                                               originalCell=2
...                                                                 throughput=0
...                                                                 throughput_GBR=20
...                                                                 ue_nr_capa=${SA_TDD_RANK4}

&{dict_settings_ue_3}                                               originalCell=1
...                                                                 throughput=600
...                                                                 throughput_GBR=0
...                                                                 ue_nr_capa=${SA_TDD_RANK2}

&{dict_settings_ue_4}                                               originalCell=3
...                                                                 throughput=100
...                                                                 throughput_GBR=0
...                                                                 ue_nr_capa=${SA_TDD_RANK2}

&{dict_settings_ue_5}                                               originalCell=1
...                                                                 throughput=50
...                                                                 throughput_GBR=0
...                                                                 ue_nr_capa=${SA_TDD_RANK2}


@{dict_ues}                                                         ${dict_settings_ue_1}
