import csv


def CheckFileSsBlockmaster(csvPathName):
    """
    """
# Check SSBlockSendReq content to see if CB011031 is triggered
    ssblockshiftissue = 0
    ssblocknoshiftissue = 0

    ssblocktable = []

    with open(csvPathName) as csvfile:
        reader = csv.DictReader(csvfile, delimiter=';')
        for row in reader:
            if row['_ws.col.info'] == "DlData_SsBlockSendReqL1sw,MIB":
                ssblocktable.append(row)

    for ssb in ssblocktable:
        # check that on subcell0, SSB is sent on slot=1 with activeSsBlock=128 and threeLsbSsbIndex=2
        # If this condition is false then ssblockshiftissue is incremented
        if ssb['3gpp.subcellid'] == "0" and\
            (ssb['3gpp.slot'] != "1" or ssb['DlData_SsBlockSendReqL1sw_t.activeSsBlocks'] != "128" or
                ssb['DlData_SsBlockSendReqL1sw_t.threeLsbSsbIndex'] != "2"):
            ssblockshiftissue += 1
        # check that on subcell1, SSB is sent on slot=0 with activeSsBlock=128 and threeLsbSsbIndex=0
        # If this condition is false then ssblocknoshiftissue is incremented
        if ssb['3gpp.subcellid'] == "1" and\
            (ssb['3gpp.slot'] != "0" or ssb['DlData_SsBlockSendReqL1sw_t.activeSsBlocks'] != "128" or
                ssb['DlData_SsBlockSendReqL1sw_t.threeLsbSsbIndex'] != "0"):
            ssblocknoshiftissue += 1

    results = {"ssblockshiftissue": ssblockshiftissue,
               "ssblocknoshiftissue": ssblocknoshiftissue}

    return results
