*** Keywords ***

CB010850_AA_Configuration
    [Documentation]               Dedicated KW to add use a delta commissioning file and configure config files
    ...                           2 FDD cells 10Mhz & 20Mhz configuration n25
    [Arguments]                   ${delta_file}     ${gnb_alias}

    Dated Log                     Dedicated configuration for CB010850_AA test
    Run Keyword If    not ${isAic}    Run Keywords    # Perform the delta commissioning
    # Open connection towards cOAM
    ...    sbts_coam.connect_to       name=${gnb_alias}
    # Apply delta scf
    ...    AND                        coam_parameter.perform_scf_delta_commission
    ...                                   delta_file=${delta_file}
    ...                                   connection=${gnb_alias}
    ...                                   skip_parameter_relation_errors=True
    ...                                   timeout=300
    ...    AND                        OAM wait available
    ...    AND                        sbts_coam.teardown    connection=${gnb_alias}

    # Change configuration on the AP IPHY
    GnbXmlTools.Get Data From Gnb TargetBD File    card_name=AHFII
    WtsXmlConfig.startSession         file=iphy
    #
    Run Keyword If    not ${isAic}    Run Keywords    # Update IPHY GSCN to new value
    ...                               WtsXmlConfig.setTextUsingIndex    path=//cardName            val=AHFII                  idx=3
    ...    AND                        WtsXmlConfig.setTextUsingIndex    path=//cardName            val=AHFII                  idx=4
    ...    AND                        WtsXmlConfig.setTextUsingIndex    path=//resourceBuildKey    val=LTX_AHFII              idx=3
    ...    AND                        WtsXmlConfig.setTextUsingIndex    path=//resourceBuildKey    val=LTX_AHFII              idx=4
    ...    AND                        WtsXmlConfig.setTextUsingIndex    path=//GSCN                val=4907                   idx=3
    ...    AND                        WtsXmlConfig.setTextUsingIndex    path=//GSCN                val=4907                   idx=4
    # update iphy.xml with swVersion and swFileKey values taken fomr GNB TargetBD_*.xml
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //version                  ${g_resource_swVersion}    idx=5
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //version                  ${g_resource_swVersion}    idx=6
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //version                  ${g_resource_swVersion}    idx=7
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //version                  ${g_resource_swVersion}    idx=8
    #
    # ...    AND                        WtsXmlConfig.setTextUsingIndex    //buildversion             ${g_resource_swVersion}    idx=3
    #...    AND                        WtsXmlConfig.setTextUsingIndex    //buildversion             ${g_resource_swVersion}    idx=4
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //bldVersion               ${g_resource_swVersion}    idx=3
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //bldVersion               ${g_resource_swVersion}    idx=4
    ...    AND                        WtsXmlConfig.setTextUsingIndex    ////name                   ${g_resource_swFileKey}    idx=5
    ...    AND                        WtsXmlConfig.setTextUsingIndex    ////name                   ${g_resource_swFileKey}    idx=6
    ...    AND                        WtsXmlConfig.setTextUsingIndex    ////name                   ${g_resource_swFileKey}    idx=7
    ...    AND                        WtsXmlConfig.setTextUsingIndex    ////name                   ${g_resource_swFileKey}    idx=8
    ...         ELSE                  Run Keywords
    ...                               WtsXmlConfig.setTextUsingIndex    path=//cardName            val=AHFII                  idx=2
    ...    AND                        WtsXmlConfig.setTextUsingIndex    path=//cardName            val=AHFII                  idx=3
    ...    AND                        WtsXmlConfig.setTextUsingIndex    path=//resourceBuildKey    val=LTX_AHFII              idx=2
    ...    AND                        WtsXmlConfig.setTextUsingIndex    path=//resourceBuildKey    val=LTX_AHFII              idx=3
    ...    AND                        WtsXmlConfig.setTextUsingIndex    path=//GSCN                val=4907                   idx=3
    ...    AND                        WtsXmlConfig.setTextUsingIndex    path=//GSCN                val=4907                   idx=4
    # update iphy.xml with swVersion and swFileKey values taken fomr GNB TargetBD_*.xml
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //version                  ${g_resource_swVersion}    idx=3
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //version                  ${g_resource_swVersion}    idx=4
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //version                  ${g_resource_swVersion}    idx=5
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //version                  ${g_resource_swVersion}    idx=6
    #
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //bldVersion               ${g_resource_swVersion}    idx=2
    ...    AND                        WtsXmlConfig.setTextUsingIndex    //bldVersion               ${g_resource_swVersion}    idx=3
    ...    AND                        WtsXmlConfig.setTextUsingIndex    ////name                   ${g_resource_swFileKey}    idx=3
    ...    AND                        WtsXmlConfig.setTextUsingIndex    ////name                   ${g_resource_swFileKey}    idx=4
    ...    AND                        WtsXmlConfig.setTextUsingIndex    ////name                   ${g_resource_swFileKey}    idx=5
    ...    AND                        WtsXmlConfig.setTextUsingIndex    ////name                   ${g_resource_swFileKey}    idx=6
    #
    WtsXmlConfig.stopSession          file=iphy

    # Change the configuration on the WTS basic_setup
    ${prefix_cell3}                   set variable    set_cell id=3 gnb
    ${prefix_cell4}                   set variable    set_cell id=4 gnb
    Run Keyword If    not ${isAic}    Run Keywords
        ...    WtsCfgConfig.startSession
        #Cells n25
        #Cell 3 10Mhz
        ...    AND    WtsCfgConfig.replaceValue            prefix=${prefix_cell3}
        ...                                  param=nr_arfcn        oldValue=135760:126380    newValue=376500:392500
        ...    AND    WtsCfgConfig.replaceValue            prefix=${prefix_cell3}
        ...                                  param=gscn            oldValue=1582             newValue=4907
        #Cell 4 20Mhz
        ...    AND    WtsCfgConfig.replaceValue            prefix=${prefix_cell4}
        ...                                  param=nr_arfcn        oldValue=135760:126380    newValue=376500:392500
        ...    AND    WtsCfgConfig.replaceValue            prefix=${prefix_cell4}
        ...                                  param=gscn            oldValue=1582             newValue=4907
        #
        ...    AND    WtsCfgConfig.stopSession             rename=modified
        ...    AND    Modify Field in WtsEmu Cfg File      field=SA_UE_CAPABILITIES_FDD    value=${nr_capas_10Mhz_20Mhz_n25}

Cell Setup
    Dated Log               Launch the setup of cell
    Setup Wtsemu SA               shouldUseLua=False    nbCell=4

Build UEs list SA Multi UEs

    ${totalNbOfUe}          get length          ${dict_settings_all_ues}
    Dated Log               Configure the setting for the ${totalNbOfUe} ue's
    Set Global Variable     ${totalNbOfUe}
    Dated Log New Line      ${dict_settings_all_ues}

    @{listOfUes}            Create List
    FOR    ${current_id}    IN RANGE    0    ${totalNbOfUe}
        ${current_ue}=                Evaluate                      ${dict_settings_all_ues[${current_id}].ue}
        ${current_ueSetting}=         Copy Dictionary               ${BASIC_UE_SA}
        Set To Dictionary             ${current_ueSetting}          ue                  ${current_ue}
        Set To Dictionary             ${current_ueSetting}          pdu                 ${dict_settings_all_ues[${current_id}].pdu}
        Set To Dictionary             ${current_ueSetting}          trf_id              ${current_ue}
        Set To Dictionary             ${current_ueSetting}          target_gnb          2
        Set To Dictionary             ${current_ueSetting}          target_cells        ${dict_settings_all_ues[${current_id}].originalCell}
        Set To Dictionary             ${current_ueSetting}          throughput          ${dict_settings_all_ues[${current_id}].throughput}

        Append To List                ${listOfUes}                  ${current_ueSetting}
    END
    Dated Log New Line                UE_List=${listOfUes}

    [Return]                          ${listOfUes}

SA Attach and Start Traffic Multi UEs
    [Arguments]                     ${listOfUes}
    FOR    ${current_elem}    IN    @{listOfUes}
        Dated Log New Line     === SA Register UE ${current_elem.ue} on cell ${current_elem.target_cells} ===
        CallSetup.UE Register                                   ue=${current_elem.ue}

        CallSetup.Launch PDU Session                            ue=${current_elem.ue}
        ...                                                     pdu=${current_elem.pdu}
        ...                                                     gw=${current_elem.ue}
    END

    # Start the Non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        Dated Log New Line   === Start Traffic UL on UE ${current_elem.ue} ===
        Traffic SA UL NOT Stopped
        ...                                                     ueSetting=${current_elem}
    END

Traffic SA UL NOT Stopped
    [Documentation]
    ...     Actions:        it manages the UL traffic on the UEs
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        UL traffic is passed
    [Arguments]                   ${ueSetting}

    #UL
    Set To Dictionary       ${ueSetting}        trf_id    1
    Traffic UE UL           ueSetting=${ueSetting}
    ...                               throughput=${ueSetting.throughput}
    ...                               captureCallback=None
    ...                               capture=None
    ...                               captureDuration=0
    ...                               duration=3
    ...                               shouldBeStop=${False}
    ...                               shouldBeCheck=${False}

Collect and Check CB010850 Counter/ KPI
    [Documentation]                 Retrieve and Check 10850 AA PM counter and KPI values are as expected
    ...                             M55308C10004 M55308C36002 M55308C18001 M55308C18002 Counters
    ...                             Check also UL initial BLER and UL residual BLER

    Dated Log                       Waiting 10 minutes before collecting counters
    sleep                           600s
    ${date}                         Get Current Date
    ${date_in_dir_name}             Convert Date         ${date}     result_format=%d%m%Y_%H%M
    ${log_path_pm}                  Set Variable         ${LOG_PATH}/PM_${date_in_dir_name}
    Dated Log                       The PM counters file collected from gnb will be stored under : ${log_path_pm}
    ${pm_latest}=    Run Keyword If    ${isAic}    Counters.Collect PM files from BTS    ${log_path_pm}
    ...                                                             optional_files=${True}    posProcess=${True}
    ...                          ELSE              Counters.Collect PM files from BTS    ${log_path_pm}
    set Suite Variable              ${LATEST_PM_FILE}       ${pm_latest}
    set Suite Variable              ${log_path_pm}
    Dated Log                       Latest pm counters file : ${LATEST_PM_FILE}

    Dated Log                        ===> check counter and KPI constraints is started

    KPI Evaluate                     pmFile=${LATEST_PM_FILE}
    ...                              constraintsFile=${CB010850_AA__constraints}
    ...                              failOnError=${True}

    Dated Log                        ===> check counter and KPI constraints is ended

CB010850_AA_Check_RRC
    [Documentation]                 Check RRC message for Cell 3 and 4
    ...                             Pucch-ResourceCommon in SIBs
    ...                             LocationAndBandwidth in initial UL BWP in SIBs
    ...                             LocationAndBandwidth in dedicated UL BWP during UE register
    ...                             Check SRS prbs are not in blanked area during UE register

    # Backup of egate_console.log file:
    ${current_date}=                    DateTime.Get Current Date       result_format=%Y%m%d-%H%M%S
    ${filename}                         set variable                    ${current_date}_egate_console_Check_AA_RRC_UL_Blanking.log
    ${cmd}                              Catenate
    ...                                 cd ${tl.core.dir_path};
    ...                                 cp ${tl.core.dir_path}/egate_console.log ${LOG_PATH}/${filename}
    ${output}                           SSH Wait For Connect and Cmd
    ...                                 command=${cmd}
    ...                                 host=${HOST_EPCSIM}
    # Check egate_console.log file:
    Dated Log                           === check Cell 4 ====
    ${rrc_status}                       CB010850_AA_RRC_Check_Cell4                  ${LOG_PATH}/${filename}
    Should Be True                      ${rrc_status} == True

    Dated Log                           === check Cell 3 ====
    ${rrc_status}                       CB010850_AA_RRC_Check_Cell3                  ${LOG_PATH}/${filename}
    Should Be True                      ${rrc_status} == True

    Dated Log                           === check UEs ====
    ${rrc_status}                       CB010850_AA_RRC_Check_Ues                    ${LOG_PATH}/${filename}
    Should Be True                      ${rrc_status} == True
