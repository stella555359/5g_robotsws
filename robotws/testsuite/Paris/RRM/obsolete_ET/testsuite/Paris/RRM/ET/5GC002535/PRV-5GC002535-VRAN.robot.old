Test_7
    ${resultDir}=     5GC002535_Keywords.Get testcase log directory
    ${CaptureBIP1}                   Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    # set a specific name to keep the trace
    ${CaptureBIP1.prefix}   set Variable   L1L2_BIP_GNB_FS_TEST_1
    ${CaptureBIP1CaptureBIP1.withTN}   set Variable   True

    ${CaptureBIP2}                   Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    # set a specific name to keep the trace
    ${CaptureBIP2.prefix}   set Variable   L1L2_BIP_GNB_FS_TEST_2
    ${CaptureBIP2.withTN}   set Variable   True

    ${CaptureBIP3}                   Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    # set a specific name to keep the trace
    ${CaptureBIP3.prefix}   set Variable   L1L2_BIP_GNB_FS_TEST_3
    ${CaptureBIP3.withTN}   set Variable   True

    Capture Init      capture=${CaptureBIP1}
    Capture Start     ${CaptureBIP1}
    sleep  1s
    Capture Stop      ${CaptureBIP1}

    Capture Init      capture=${CaptureBIP2}
    Capture Start     ${CaptureBIP2}
    sleep  1s
    Capture Stop      ${CaptureBIP2}

    Capture Init      capture=${CaptureBIP3}
    Capture Start     ${CaptureBIP3}
    sleep  1s
    Capture Stop      ${CaptureBIP3}

