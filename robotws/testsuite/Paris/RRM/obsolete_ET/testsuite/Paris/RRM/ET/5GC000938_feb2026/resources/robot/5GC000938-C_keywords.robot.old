    #...                  param=file
    #...                  oldValue=${oldValue}
    #...                  newValue=AirphoneConfig.xml
    #set nr_arfcn
    #${oldValue}          getParam           prefix=set_cell          param=nr_arfcn
    #replaceValue         prefix=set_cell
    #...                  param=nr_arfcn
    #...                  oldValue=${oldValue}
    #...                  newValue=${testParam.nrarfcnUl}:${testParam.nrarfcnDl}
    #${oldValue}          getParam           prefix=set_cell          param=nr_arfcn
    #Dated log            Value changed :*** ${oldValue} ***
    WtsCfgConfig.stopSession         rename=modified

WTS xml Preparation
    [Arguments]          ${testParam}
    WtsXmlConfig.startSession
    #set Arfcn
    #WtsXmlConfig.setListEltText         //gscn                             ${testParam.gscn}
    #WtsXmlConfig.setListEltText         //dlNrArfcn                        ${testParam.nrarfcnDl}
    #WtsXmlConfig.setListEltText         //ulNrArfcn                        ${testParam.nrarfcnUl}
    WtsXmlConfig.setListEltText         //dlBandwidth                        ${testParam.BandwidthXml}
    WtsXmlConfig.setListEltText         //ulBandwidth                        ${testParam.BandwidthXml}
    #WtsXmlConfig.setListEltText         //prachZeroCorrelationZoneConfig            0
    WtsXmlConfig.stopSession

