## End of Keyword for TC

# SA Keywords
Cell Setup SA
    CallSetup.WTS Setup    nbSaUe=1    bypassX2Setup=${True}    shouldUseLua=${False}

Launch UL Traffic SA
    [Arguments]         ${testParam}
    log to console      testParam=${testParam}      # RF50 workaround to W0919
    Debug Dated Log     Launch UL Traffic SA
    Traffic.Traffic UE UL    duration=600    throughput=50    ueSetting=${BASIC_UE_SA}
    ...                      shouldBeCheck=False

Launch DL Traffic SA
    [Arguments]         ${testParam}
    Debug Dated Log     Launch DL Traffic SA
    log to console      testParam=${testParam}      # RF50 workaround to W0919
    Traffic.Traffic UE DL    duration=30    throughput=140    ueSetting=${BASIC_UE_SA}
    ...                      shouldBeCheck=False

UE attach And PDU Session SA
    [Arguments]         ${testParam}
    log to console      testParam=${testParam}      # RF50 workaround to W0919
    CallSetup.UE Register
    sleep     5s
    CallSetup.Launch PDU Session

Teardown TC
    Dated log              Test ending
    Produce Scout Data
    [Teardown]             GenericTest.Display diagnosis

# Update SCF
Set MRBTSID and NRBTSID
    ${dist_name} =       Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ${ch_dist_name} =    Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELLGRP-0
    ${nrcell_dist_name}  Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    set suite variable    &{FRAME_PARAMETER_TYPE}    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...                   p_name=frameStructureType
    Set Suite Variable    ${dist_name}
    Set Suite Variable    ${ch_dist_name}


Update gNB Scf Vran
    [Arguments]                    ${testParam}
    ${SCF_PATH_938_DU}              OAM Get SCF File                oam=${GNB_DU.oam}        file=SCF_Setup_938_DU.xml
    ${SCF_PATH_938_CU}              OAM Get CU SCF File             file=SCF_Setup_938_CU.xml

    Set Suite Variable              ${SCF_PATH_938_DU}
    Set Suite Variable              ${SCF_PATH_938_CU}
    SCF StartSession                scf_file=${SCF_PATH_938_DU}     second_scf_file=${SCF_PATH_938_CU}

    # FB2324 : some params are already set to be the requested value in the default SCF file, no need to reset
    # SCF Set element                 dist_name=${dist_name}
    # ...                             element_name=actFdmScheduling
    # ...                             element_value=${testparam.seq.actFdmScheduling}
    # ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    # SCF Set element                 dist_name=${nrcell_dist_name}
    # ...                             element_name=actPrachMultiplexing
    # ...                             element_value=${testparam.seq.actPrachMultiplexing}
    # ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${dist_name}
    ...                             element_name=actFdmEnhancedScheduling
    ...                             element_value=${testparam.seq.actFdmEnhancedScheduling}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${nrcell_dist_name}
    ...                             element_name=prachConfigurationIndex
    ...                             element_value=${testparam.seq.prachConfigurationIndex}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${nrcell_dist_name}
    ...                             element_name=zeroCorrelationZoneConfig
    ...                             element_value=${testParam.ZeroCorrZoneConfig}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}



    SCF StopSession                 scf_file=${SCF_PATH_938_DU}     second_scf_file=${SCF_PATH_938_CU}
    Dated Log                         Modifications completed.\n
    Oam.OAM Perform Full Commissioning          scf_file=${SCF_PATH_938_DU}
    Run Keyword If                 ${isAic}
    ...                            Oam.OAM Perform Full Commissioning    scf_file=${SCF_PATH_938_CU}    oam=${GNB_CU.oam}

    Run keyword if                  ${isAic}
	...                             Wait Vcu And Vdu Available

    Run Keyword If                  not ${isAic}
    ...                             WA Airscale Wait For Ready              ${GNB_DU}

Update gNB Scf
    [Arguments]                    ${testParam}
    &{modify_param0}    Create Dictionary
    ...    parameter=prachConfigurationIndex
    ...    dist_name=${nrcell_dist_name}
    ...    value=${testParam.seq.prachConfigurationIndex}
    &{modify_param1}    Create Dictionary
    ...    parameter=actPrachMultiplexing
    ...    dist_name=${nrcell_dist_name}
    ...    value=${testParam.seq.actPrachMultiplexing}
    &{modify_param2}    Create Dictionary
    ...    parameter=actFdmScheduling
    ...    dist_name=${dist_name}
    ...    value=${testParam.seq.actFdmScheduling}
    &{modify_param3}    Create Dictionary
    ...    parameter=actFdmEnhancedScheduling
    ...    dist_name=${dist_name}
    ...    value=${testParam.seq.actFdmEnhancedScheduling}
    &{modify_param4}    Create Dictionary
    ...    parameter=msg1FrequencyStart
    ...    dist_name=${nrcell_dist_name}
    ...    value=${testParam.msg1FrequencyStart}
    &{modify_param5}    Create Dictionary
    ...    parameter=chBwDl
    ...    dist_name=${nrcell_dist_name}/NRCELL_FDD-1
    ...    value=${testParam.bandwidth}
    &{modify_param6}    Create Dictionary
    ...    parameter=chBwUl
    ...    dist_name=${nrcell_dist_name}/NRCELL_FDD-1
    ...    value=${testParam.bandwidth}
    &{modify_param7}    Create Dictionary
    ...    parameter=zeroCorrelationZoneConfig
    ...    dist_name=${nrcell_dist_name}
    ...    value=${testParam.ZeroCorrZoneConfig}
    &{modify_param8}    Create Dictionary
    ...    parameter=pucchModeSelect
    ...    dist_name=${nrcell_dist_name}
    ...    value=${testParam.pucchMode}
    @{modify_param}=            Create List                ${modify_param0}
    ...                                                    ${modify_param1}
    ...                                                    ${modify_param2}
    ...                                                    ${modify_param3}
    ...                                                    ${modify_param4}
    ...                                                    ${modify_param5}
    ...                                                    ${modify_param6}
    ...                                                    ${modify_param7}
    ...                                                    ${modify_param8}


    OAM Set Params                    ${modify_param}

# swconfig update
Update gNB Swconfig
    [Arguments]               ${testParam}
    ${590076}=                create dictionary      field=0x590076     value=${testParam.seq.RadParamL2ps1348}
    ${580198}=                create dictionary      field=0x580198      value=${testParam.seq.RadParamCprt1348}
    ${swconfig_gnb}=          Create List            ${590076}           ${580198}
    Set Fields in swconfig DU       param_list=${swconfig_gnb}
    Dated log          RadParams to modify:\n ${swconfig_gnb}

Update gNB Swconfig Vran
    [Arguments]               ${testParam}
    [Documentation]         Apply the non default RAD params required by the TC
    Dated Log               ------> Read the value of the RAD param : 0x590076 rdPucchFdmWithPrach
    ${590076_default}       Get Rad Value Using Aashell3    rad_param=0x590076    domain_nom=cprt    domain_elem=cprt-0
    Dated Log               ------> set the value of 0x590076 from : ${590076_default} to be : ${testParam.seq.RadParamL2ps1348}
    Set Rad Parameter Using Aashell  rad_param_value=${testParam.seq.RadParamL2ps1348}  rad_param=0x590076  domain_nom=cprt  domain_elem=cprt-0
    Dated Log               ------> Read the value of the RAD param : 0x580198  rdUlChMux1348Activated
    ${580198_default}       Get Rad Value Using Aashell3    rad_param=0x580198    domain_nom=l2rt    domain_elem=l2rt-a-0
    Dated Log               ------> set the value of 0x580198 from : ${580198_default} to be : ${testParam.seq.RadParamCprt1348}
    Set Rad Parameter Using Aashell  rad_param_value=${testParam.seq.RadParamCprt1348}   rad_param=0x580198   domain_nom=l2rt   domain_elem=l2rt-a-0
    ${590076_new}=          Get Rad Value Using Aashell3    rad_param=0x590076    domain_nom=cprt    domain_elem=cprt-0
    Dated Log               ------> new value of 0x590076 is : ${590076_new}
    ${580198_new}=          Get Rad Value Using Aashell3    rad_param=0x580198    domain_nom=l2rt    domain_elem=l2rt-a-0
    Dated Log               ------> new value of 0x580198 is : ${580198_new}


# Update WTS Config file
WTS cfg Preparation
    [Arguments]         ${testParam}
