SA Start Traffic Multi UEs NonGBR

    [Arguments]       ${listOfUes}

    FOR    ${current_elem}    IN    @{listOfUes}
        Dated Log New Line     === SA Register UE ${current_elem.ue} on cell ${current_elem.target_cells} ===
        CallSetup.UE Register                                   ue=${current_elem.ue}

        CallSetup.Launch PDU Session                            ue=${current_elem.ue}
        ...                                                     pdu=${current_elem.pdu}
        ...                                                     gw=${current_elem.ue}
    END

# Start the UL Non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        Run Keyword If      ${current_elem.UL_throughput} > ${NO_THROUGHPUT}     Run Keywords
        ...    Dated Log New Line
        ...       === Launch ${current_elem.UL_throughput}Mbits/s NonGBR UL traffic UE ${current_elem.ue} on cell ${current_elem.target_cells} ===
        ...    AND       Start UL Traffic SA Not Stopped
        ...                                                     param=${params}
        ...                                                     ueSetting=${current_elem}
    END

# Start the Non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        Run Keyword If      ${current_elem.DL_throughput} > ${NO_THROUGHPUT}     Run Keywords
        ...    Dated Log New Line
        ...       === Launch ${current_elem.DL_throughput}Mbits/s NonGBR DL traffic UE ${current_elem.ue} on cell ${current_elem.target_cells} ===
        ...    AND       Start DL Traffic SA Not Stopped
        ...                                                     param=${params}
        ...                                                     ueSetting=${current_elem}
    END



Start DL Traffic SA Not Stopped

    [Arguments]             ${param}
    ...                     ${ueSetting}=${BASIC_UE_SA}

    Set To Dictionary       ${ueSetting}        trf_id    1
    Traffic UE DL           ueSetting=${ueSetting}
    ...                               throughput=${ueSetting.DL_throughput}
    ...                               captureCallback=None
    ...                               capture=None
    ...                               captureDuration=0
    ...                               duration=${param.duration}
    ...                               shouldBeStop=False
    ...                               deviation=${param.deviation}



Start UL Traffic SA Not Stopped

    [Arguments]             ${param}
    ...                     ${ueSetting}=${BASIC_UE_SA}

    Set To Dictionary       ${ueSetting}        trf_id    1
    Traffic UE UL           ueSetting=${ueSetting}
    ...                     throughput=${ueSetting.UL_throughput}
    ...                     captureCallback=None
    ...                     capture=None
    ...                     captureDuration=0
    ...                     duration=${param.duration}
    ...                     shouldBeStop=False
    ...                     deviation=${param.deviation}



SA DeRegister Multi UEs

    [Arguments]       ${listOfUes}

    FOR    ${current_elem}    IN    @{listOfUes}
        Dated Log New Line     === SA DeRegister UE ${current_elem.ue} on cell ${current_elem.target_cells} ===
        CallSetup.UE Deregister       id=${current_elem.ue}
    END



Get TTI Logs

    # TTI capture configuration
    ${TTIdir}                             Get TTI Trace Path    dir_suffix=TTI

    # Start TTI capture
    Dated Log New Line                    Start TTI traces capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2
    Traced Sleep                3         msg=DL TTI traffic capture 5 seconds

    # Stop TTI capture
    Dated Log New Line                    Stop TTI traces capture
    ${TTIpcap}                            Stop TTI Traces in Streaming mode
    ...                                   tti_trace_path=${TTIdir}
    ...                                   tti_trace_filename=TTI_TC9915

    Dated Log New Line                    Convert TTItrace to json and csv
    ${TTIjson}                            Convert TTItrace from pcap to others
    ...                                   input_file_path=${TTIpcap}
    ${TTIcsv}                             ttitrace_tools.decode_tti_traces_json_using_TtitraceReaderEvtDec
    ...                                   jsonPathName=${TTIjson}   #  num_of_events=10000

    Dated Log New Line                    === TTI csv path : ${TTIcsv} ===
    Set Global Variable                   ${TTIcsv}

    Dated Log New Line                    === TTI json path : ${TTIjson} ===
    Set Global Variable                   ${TTIjson}



Start Capture CPRT

    ${Capture_CPRT}             Capture CPRT Set Upon Config    airscale=${GNB_DU}

    Set Suite Variable              ${Capture_CPRT}
    Capture Init                    ${Capture_CPRT}
    Capture Start                   ${Capture_CPRT}



Stop Capture CPRT
    Capture Stop    ${Capture_CPRT}

    Dated Log New Line              === path capture : ${Capture_CPRT.path} ===

    Set Global Variable             ${Capture_CPRT.path}



Check Switch to SRS WB in RRC Reconf

    Dated Log New Line                Extract itf_l2_ps_user_reconfigurationrequiredind info from PCAP file here : ${Capture_CPRT.path}

    set test variable                 ${pcapprocessed}           RRC_Reconf.csv
    set test variable                 ${pcapprocessed_path}      ${LOG_PATH}/${pcapprocessed}

    ${cmd_mcshark}                    Catenate    tshark -r
    ...                               ${Capture_CPRT.path} -T fields -Y "itf_l2_ps_user_reconfigurationrequiredind"
    ...                               -e _ws.col.Info
    ...                               -e itf_l2_ps_user_ReconfigurationRequiredInd_t.nrCellIdentity
    ...                               -e itf_l2_ps_user_ReconfigurationRequiredInd_t.tasSrsResourceInd
    ...                               -E header=y -E separator=';' > ${pcapprocessed_path}
    Run                               ${cmd_mcshark}

    Run      command=sed -i -e 's/ //g' ${pcapprocessed_path}

    ${results}              CheckSwWbRrcReconf
    ...                                                   csvPathName=${pcapprocessed_path}
    ...                                                   ListofCell=${list_Cells}

    ${tasSrsResourceIndtab}=        Create List

    ${nb_Cell}          get length         ${List_Cells}

    FOR        ${i}    IN RANGE    0       ${nb_Cell}

        ${cell_id}=             Evaluate    ${i} + 1
        Dated Log New Line      ========== Check Switch to SRS WB for Cell ${cell_id} ==========

        ${status}=     run keyword and return status    Should be True         ${results}[tasSrsResourceInd][${i}] > 0
        Run Keyword if          ${status} == True
        ...                     Dated Log New Line
        ...    Switch to WB ${results}[tasSrsResourceInd][${i}]/${results}[RrcReconf][${i}] RRC Reconf >> ${status}
        ...        ELSE         Run Keywords        Append To List     ${tasSrsResourceIndtab}    ${status}
        ...        AND             Dated Log New Line
        ...    Switch to WB ${results}[tasSrsResourceInd][${i}]/${results}[RrcReconf][${i}] RRC Reconf >> ${status}
    END

    FOR        ${i}    IN      @{tasSrsResourceIndtab}
        Run Keyword if     ${i} == False          Fail    Switch to SRS WB Failure
    END



Get L1L2 Logs

    Dated Log                         ======> Get L1L2 Bip Traces

    ${CaptureBIP}                     Capture L1L2 Set Upon Config     airscale=${GNB_DU}

  #  ${bipMsgList}                     Set Variable               ${TrafficFilter}
  #  ${Capture_BIP.filter}             Run Keyword                Get Filter For Particular Msgs    ${bipMsgList}

    Capture Init                      ${CaptureBIP}
    Capture start                     ${CaptureBIP}
    Traced sleep                      ${params.timeCapture}
    Capture stop                      ${CaptureBIP}

    Dated Log New Line                === path capture : ${CaptureBIP.path} ===

    Set Global Variable               ${CaptureBIP.path}



Check ChecksrsBwvEnableFlag and SRS Blanking in L1L2

    Dated Log New Line                Extract uldata_srsreceivereq info from PCAP file here : ${CaptureBIP.path}

    set test variable                 ${pcapprocessed}           L1L2.csv
    set test variable                 ${pcapprocessed_path}      ${LOG_PATH}/${pcapprocessed}

    ${cmd_mcshark}                    Catenate    tshark -r
    ...                               ${CaptureBIP.path} -T fields -Y "uldata_srsreceivereq"
    ...                               -e _ws.col.Info
    ...                               -e 3gpp.sfn
    ...                               -e 3gpp.slot
    ...                               -e 3gpp.subcellid
    ...                               -e UlData_srsReceiveReqSubcell_t.srsBwvEnable
    ...                               -e UlData_srsBwvReportRequest_t.startPrb
    ...                               -e UlData_srsBwvReportRequest_t.startPrbLtCoMa
    ...                               -E header=y -E separator=';' > ${pcapprocessed_path}
    Run                               ${cmd_mcshark}

    Run      command=sed -i -e 's/ //g' ${pcapprocessed_path}

    ${results}              ChecksrsBwvEnableFlag
    ...                                                   csvPathName=${pcapprocessed_path}
    ...                                                   ListofCell=${list_Cells}

    ${srsBwvEnabletab}=        Create List
    ${LowFailtab}=             Create List
    ${LowFailComatab}=         Create List

    ${nb_Cell}          get length         ${List_Cells}

    FOR        ${i}    IN RANGE    0       ${nb_Cell}

        ${cell_id}=             Evaluate    ${i} + 1
        Dated Log New Line      ========== Check ChecksrsBwvEnableFlag for Cell ${cell_id} ==========

        ${status}=     run keyword and return status    Should be True         ${results}[srsBwvEnable][${i}] > 0
        Run Keyword if          ${status} == True
        ...                     Dated Log New Line
        ...    ChecksrsBwvEnableFlag to True ${results}[srsBwvEnable][${i}]/${results}[SrsReveiveReq][${i}] messages >> ${status}
        ...        ELSE         Run Keywords        Append To List     ${srsBwvEnabletab}    ${status}
        ...        AND             Dated Log New Line
        ...    ChecksrsBwvEnableFlag to True ${results}[srsBwvEnable][${i}]/${results}[SrsReveiveReq][${i}] messages >> ${status}

        Dated Log New Line      ========== Check Low Blanking in SRS for Cell ${cell_id} ==========
        ${status}=     run keyword and return status    Should be True         ${results}[LowFail][${i}] == 0
        Run Keyword if          ${status} == True
        ...                     Dated Log New Line
        ...    Low Prb Blanking issues = ${results}[LowFail][${i}]/${results}[srsBwvEnable][${i}] messages >> ${status}
        ...        ELSE         Run Keywords        Append To List     ${LowFailtab}    ${status}
        ...        AND             Dated Log New Line
        ...    Low Prb Blanking issues = ${results}[LowFail][${i}]/${results}[srsBwvEnable][${i}] messages >> ${status}

        Dated Log New Line      ========== Check Low Blanking Coma in SRS for Cell ${cell_id} ==========
        ${status}=     run keyword and return status    Should be True         ${results}[LowFailComa][${i}] == 0
        Run Keyword if          ${status} == True
        ...                     Dated Log New Line
        ...    Low Prb Blanking issues = ${results}[LowFailComa][${i}]/${results}[srsBwvEnable][${i}] messages >> ${status}
        ...        ELSE         Run Keywords        Append To List     ${LowFailComatab}    ${status}
        ...        AND             Dated Log New Line
        ...    Low Prb Blanking issues = ${results}[LowFailComa][${i}]/${results}[srsBwvEnable][${i}] messages >> ${status}
    END

    FOR        ${i}    IN      @{srsBwvEnabletab}
        Run Keyword if     ${i} == False          Fail    Switch to SRS WB Failure
    END

    FOR        ${i}    IN      @{LowFailtab}
        Run Keyword if     ${i} == False          Fail    Blanking Low Failure
    END

    FOR        ${i}    IN      @{LowFailComatab}
        Run Keyword if     ${i} == False          Fail    Blanking Low Coma Failure
    END



Check 9915 PM Counters

