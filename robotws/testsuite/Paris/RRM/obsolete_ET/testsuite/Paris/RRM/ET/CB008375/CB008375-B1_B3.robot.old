*** Settings ***
Documentation      [SUITE PURPOSE]  CB008375 feature -B (both TDD and FDD)
...                Test Case Scenario author   : anne.enyih@nokia.com
...                 This test suite covers the following test instances:
...                 [1][1.0] CB008375-SR-H-UPD002_B07_Flooding_TDD_gNB_with_S1_Traffic_QDDiscad_Disable_non_critical_threshold
...                 Run as:  CB008375_mainKW       ${B1_NCritical}
...                 [1][1.0] CB008375-SR-H-UPD002_B06_Flooding_TDD_gNB_with_S1_Traffic_QDDiscad_Disable_critical_threshold.
...                 Run as: CB008375_mainKW       ${B1_Critical}
...                 [1]CB008375-SR-B_3_Flooding_FDD_DU_with_CU_Traffic_setting_#1
...                 Run as: CB008375_mainKW       ${B3}
...                 Using the same keywork, each test case is configured based the parameters sent to it.


Resource           ./resources/robot/CB008375_keywords_common.robot
Variables          ./resources/python/Constants.py

Suite Setup        CB008375_keywords_common.Suite Setup 8375
Suite Teardown     CB008375_keywords_common.Suite Teardown 8375
Test Teardown      kwmkt_Test Teardown

*** Variables ***
${recursion_limit}   1000   # 1000 is the default value
${NL}                Nested_List

&{B3}
...     Feat8375niddSpecific=${FeatureParameterSheet}
...     ListOfUeEngaged=${uelist_FDD}
...     PMdod=testsuite/Paris/RRM/ET/CB008375/resources/config/PM/CB008375_Constraints_template.csv
...     GetTtiTraceTime=80ms
...     TestType=fdd

&{B1_Critical}
...     Feat8375niddSpecific=${FeatureParameterSheet_critical}
...     ListOfUeEngaged=${uelist_TDD}
...     PMdod=testsuite/Paris/RRM/ET/CB008375/resources/config/PM/CB008375_B3_Constraints_template.csv
...     GetTtiTraceTime=80ms
...     TestType=tdd_Crit


&{B1_NCritical}
...     Feat8375niddSpecific=${FeatureParameterSheet_Ncritical}
...     ListOfUeEngaged=${uelist_TDD}
...     PMdod=testsuite/Paris/RRM/ET/CB008375/resources/config/PM/CB008375_B3_Constraints_template.csv
...     GetTtiTraceTime=80ms
...     TestType=tdd_nCrit



# Modification block ==================================================================================================
# Cells important for the test check SIB arrival only on following cell
@{CellList}          4


#SCF parameters of the test ===========================================================================================
@{FeatureParameterSheet}
...         ${actPdcpRlcBufCongestionMechsm}     ${pdcpBufUsageThreshold_def}    ${rlcBufUsageThreshold}    ${bopNumPdcpSduDiscard}
...         ${bopNumRlcSduDiscard}     ${numNonGbrPdcpSduDiscard}   ${numNonGbrRlcSduDiscard}    ${queuingDelayDiscarding_11}
...         ${queuingDelayDiscarding_12}    ${discardTimer_11}    ${discardTimer_12}      ${bopThNonCriticalTraffic}
...         ${miNrPDCP1Report}          ${miNrCellUtilization}      ${miNrHighRlcCell}

@{FeatureParameterSheet_critical}
...         ${actPdcpRlcBufCongestionMechsm}     ${pdcpBufUsageThreshold_c}    ${rlcBufUsageThreshold}    ${bopNumPdcpSduDiscard}
...         ${bopNumRlcSduDiscard}     ${numNonGbrPdcpSduDiscard}   ${numNonGbrRlcSduDiscard}    ${queuingDelayDiscarding_11}
...         ${queuingDelayDiscarding_12}    ${discardTimer_11}    ${discardTimer_12}      ${bopThNonCriticalTraffic}
...         ${miNrPDCP1Report}          ${miNrCellUtilization}      ${miNrHighRlcCell}      ${miNrPDCP2Report}      ${miNrPDCPCell}
...         ${pdcpBufDiscardEnabled_1}   ${pdcpBufDiscardEnabled_2}   ${pdcpBufDiscardEnabled_3}


@{FeatureParameterSheet_Ncritical}
...         ${actPdcpRlcBufCongestionMechsm}     ${pdcpBufUsageThreshold_nc}    ${rlcBufUsageThreshold}    ${bopNumPdcpSduDiscard}
...         ${bopNumRlcSduDiscard}     ${numNonGbrPdcpSduDiscard}   ${numNonGbrRlcSduDiscard}    ${queuingDelayDiscarding_11}
...         ${queuingDelayDiscarding_12}    ${discardTimer_11}    ${discardTimer_12}      ${bopThNonCriticalTraffic}
...         ${miNrPDCP1Report}          ${miNrCellUtilization}      ${miNrHighRlcCell}      ${miNrPDCP2Report}     ${miNrPDCPCell}
...         ${pdcpBufDiscardEnabled_1}   ${pdcpBufDiscardEnabled_2}   ${pdcpBufDiscardEnabled_3}


&{miNrPDCP1Report}                       dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1    param=miNrPDCP1Report                 value=5min
&{miNrPDCP2Report}                       dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1    param=miNrPDCP2Report                 value=5min
&{miNrPDCPCell}                          dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1    param=miNrPDCPCell                    value=5min
&{miNrCellUtilization}                   dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1    param=miNrCellUtilization             value=5min
&{miNrHighRlcCell}                       dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1    param=miNrHighRlcCell                 value=5min
&{actPdcpRlcBufCongestionMechsm}         dist_name=MRBTS-1/NRBTS-1      param=actPdcpRlcBufCongestionMechsm   value=bufferOverflowProtection
&{pdcpBufUsageThreshold_c}               dist_name=MRBTS-1/NRBTS-1              param=pdcpBufUsageThreshold           value=100
&{pdcpBufUsageThreshold_nc}              dist_name=MRBTS-1/NRBTS-1              param=pdcpBufUsageThreshold           value=80
&{pdcpBufUsageThreshold_def}             dist_name=MRBTS-1/NRBTS-1              param=pdcpBufUsageThreshold           value=95
&{rlcBufUsageThreshold}                  dist_name=MRBTS-1/NRBTS-1              param=rlcBufUsageThreshold            value=95
&{bopThNonCriticalTraffic}               dist_name=MRBTS-1/NRBTS-1              param=bopThNonCriticalTraffic         value=90
&{bopNumPdcpSduDiscard}                  dist_name=MRBTS-1/NRBTS-1              param=bopNumPdcpSduDiscard            value=5
&{bopNumRlcSduDiscard}                   dist_name=MRBTS-1/NRBTS-1              param=bopNumRlcSduDiscard             value=5
&{numNonGbrPdcpSduDiscard}               dist_name=MRBTS-1/NRBTS-1              param=numNonGbrPdcpSduDiscard         value=5
&{numNonGbrRlcSduDiscard}                dist_name=MRBTS-1/NRBTS-1              param=numNonGbrRlcSduDiscard          value=5
&{queuingDelayDiscarding_11}             dist_name=MRBTS-1/NRBTS-1/NRDRB-11     param=queuingDelayDiscarding          value=Disabled
&{queuingDelayDiscarding_12}             dist_name=MRBTS-1/NRBTS-1/NRDRB-12     param=queuingDelayDiscarding          value=Disabled
&{discardTimer_11}                       dist_name=MRBTS-1/NRBTS-1/NRDRB-11     param=discardTimer                    value=infinity
&{discardTimer_12}                       dist_name=MRBTS-1/NRBTS-1/NRDRB-12     param=discardTimer                    value=infinity
&{pdcpBufDiscardEnabled_1}               dist_name=MRBTS-1/NRBTS-1/NRDRB_PDCP-1    param=pdcpBufDiscardEnabled        value=false
&{pdcpBufDiscardEnabled_2}               dist_name=MRBTS-1/NRBTS-1/NRDRB_PDCP-2    param=pdcpBufDiscardEnabled        value=false
&{pdcpBufDiscardEnabled_3}               dist_name=MRBTS-1/NRBTS-1/NRDRB_PDCP-3    param=pdcpBufDiscardEnabled        value=false

# END SCF parameters of the test ======================================================================================

