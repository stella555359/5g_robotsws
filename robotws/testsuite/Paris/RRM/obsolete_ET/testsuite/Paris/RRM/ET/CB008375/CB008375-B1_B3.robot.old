*** Test Cases ***

[1]CB008375-B1_B3_Flooding_TDD_and_FDD_gNB_with_CU_and_DU_traffic


    #Special Need for this test
    Set Suite Variable    ${userneed_PCAP}       ${False}
    Set Suite Variable    ${userneed_Btslog}     ${True}
    Set Suite Variable    ${userneed_PM}         ${False}

    CB008375_mainKW       ${B1_NCritical}

    CB008375_mainKW       ${B1_Critical}

    CB008375_mainKW       ${B3}


*** Keywords ***

CB008375_mainKW
    [Documentation]                 CB008375-Base-
    [Arguments]                     ${param}

    Init Sequence                   ${param}
    Step                            kwmkt_Create_Test_Suite_Folder

    Run Keyword If                  '${param.TestType}' == 'fdd'         Set_cfg_file_dedicated_bearer

    Critical Step                   Set_SCF_ofTheTest        ${param.Feat8375niddSpecific}

    Critical Step                   kwmkt_Cell_setup         ${CellList}

    #L3call and creation of dedicated bearer
    Run Keyword If           '${param.TestType}' == 'fdd'     CB008375_fdd_attach_add_ext_traffic    ${param}

    Run Keyword If           '${param.TestType}' == 'tdd_Crit' or '${param.TestType}' == 'tdd_nCrit'
    ...                             kwmkt_run_script_once    ${CURDIR}/resources/egCmd/egCmd_attach_add_internal_traffic.sce

    Sleep    60s

    #SYSLOGS
    Dated log                                                Collecting Syslogs for 10 Seconds
    kwmkt_Start Btslog

    Sleep    10s

    kwmkt_Stop Btslog

    Sleep    600s

    Collect Lastest PM Counters File


    CB008375_Verify_test_PM_Counters   ${param}


    CB008375_test_Clean_Up    ${param}



CB008375_fdd_attach_add_ext_traffic
    [Documentation]                 CB008375-Base-
    [Arguments]                     ${param}
    Dated log                In CB008375_fdd_attach_add_ext_traffic with Param.TestType set to ${param.TestType}
    Critical Step                   kwmkt_run_script_once    ${CURDIR}/resources/egCmd/egCmd_attach_add_dedicated_tcp_bearer.sce

	Critical Step 					Launch iperf traffic severs

	Critical Step 					Launch iperf traffic Clients



CB008375_Verify_test_PM_Counters
    [Documentation]                 CB008375-Base-
    [Arguments]                     ${param}
    Dated log                In CB008375_Verify_test_PM_Counters with Param.TestType set to ${param.TestType}
    Run Keyword If           '${param.TestType}' == 'fdd'               Verify Pm counters FDD

    Run Keyword If           '${param.TestType}' == 'tdd_nCrit'         Verify Pm counters B1 nCrit Threshold

    Run Keyword If           '${param.TestType}' == 'tdd_Crit'         Verify Pm counters B1 Crit Threshold


CB008375_test_Clean_Up
    [Documentation]                 CB008375-Base-
    [Arguments]                     ${param}

    Dated log                In CB008375_test_Clean_Up with Param.TestType set to ${param.TestType}

    Run Keyword If           '${param.TestType}' == 'tdd_Crit' or '${param.TestType}' == 'tdd_nCrit'
    ...                       kwmkt_run_script_once    ${CURDIR}/resources/egCmd/egCmd_deregister_ue_4UEs.sce

     Run Keyword If           '${param.TestType}' == 'fdd'
    ...                       Stop all iperf traffic

    Run Keyword If           '${param.TestType}' == 'fdd'
    ...                       kwmkt_run_script_once    ${CURDIR}/resources/egCmd/egCmd_deregister_ue.sce

