*** Settings ***
Documentation      [SUITE PURPOSE]  Template of Test cases CB007103 feature
...                Test Case Scenario author   : anne.enyih@nokia.com
...                Test Case Scenario author   : francois.tourlonnias@nokia.com
...
...                This Template need your attention on following part of this common database
...                Please modify as you need data value between # Modification block / # END Modification block

Resource           ./resources/robot/CB007103_keywords_common.robot
Variables          ./resources/python/Constants.py

Suite Setup        CB007103_keywords_common.Suite Setup 7103
Suite Teardown     CB007103_keywords_common.Suite Teardown 7103
Test Teardown      kwmkt_Test Teardown

*** Variables ***
${recursion_limit}   1000   # 1000 is the default value
${NL}                Nested_List

${expected_PuschDmrsSeqType_cell1}    0    # either 0/TYPE_1 or 1/TYPE_2
${expected_PuschDmrsSeqType_cell2}    1    # either 0/TYPE_1 or 1/TYPE_2
${expected_PucchDmrsSeqType_cell1}    0    # either 0/TYPE_1 or 1/TYPE_2
${expected_PucchDmrsSeqType_cell2}    1    # either 0/TYPE_1 or 1/TYPE_2

&{C6_TC06}
...     Scfdetails=${ScfComposition}
...     Feat7103niddSpecific=${FeatureParameterSheet}
...     ListOfUeEngaged=${uelist}
...     rad_param=${radList}
...     PMdod=testsuite/Paris/RRM/ET/CB007103/resources/config/PM/CB007103_Constraints_C6_TC06_ASOH.csv  #the values put here are valid for MP_Ap_LO
...     GetTtiTraceTime=2
...     dod=${AcceptanceCriteriaL1L2}

# Modification block ==================================================================================================
# Cells important for the test check SIB arrival only on following cell

${KeepConfig}    ${True}   # This setting will help you in case you use the script only for configuration purpose / or stay on last config known
@{CellList}          1    2

# SCF delivery  ====== This part help to dertemine how iso level need to be done ======================================
&{ScfComposition}
...     BeamForming=True
...     ULCloseLoopPowerControl=True
...     UlDftSOfdm=True

#SCF parameters of the test ===========================================================================================
@{FeatureParameterSheet}
...         ${actRel16DmrsForPucchF3_C1}     ${actRel16DmrsForPusch_C1}      ${pucchF3Rel16Pi2BpskAlwaysOn_C1}
...         ${pucchF3ModulationScheme_C1}
...         ${miNrUlSignalQuality2}          ${miNrResourceUtilizationPerCell}      ${miNrUlHarqOne}
...         ${actRel16DmrsForPucchF3_C2}    ${actRel16DmrsForPusch_C2}           ${pucchF3Rel16Pi2BpskAlwaysOn_C2}
...         ${pucchF3ModulationScheme_C2}
...         ${clpcPucchTargetSinr}          ${clpcPucchtIntervalSinrUpd}

&{miNrUlSignalQuality2}              dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1    param=miNrUlSignalQuality2           value=5min
&{miNrResourceUtilizationPerCell}    dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1    param=miNrResourceUtilizationPerCell    value=5min
&{miNrUlHarqOne}                     dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1    param=miNrUlHarqOne                  value=5min
&{actRel16DmrsForPucchF3_C1}         dist_name=MRBTS-1/NRBTS-1/NRCELL-1     param=actRel16DmrsForPucchF3         value=false
&{actRel16DmrsForPusch_C1}           dist_name=MRBTS-1/NRBTS-1/NRCELL-1     param=actRel16DmrsForPusch           value=false
&{pucchF3Rel16Pi2BpskAlwaysOn_C1}    dist_name=MRBTS-1/NRBTS-1/NRCELL-1     param=pucchF3Rel16Pi2BpskAlwaysOn    value=false
&{pucchF3ModulationScheme_C1}        dist_name=MRBTS-1/NRBTS-1/NRCELL-1     param=pucchF3ModulationScheme        value=pi2bpsk
&{actRel16DmrsForPucchF3_C2}         dist_name=MRBTS-1/NRBTS-1/NRCELL-2     param=actRel16DmrsForPucchF3         value=true
&{actRel16DmrsForPusch_C2}           dist_name=MRBTS-1/NRBTS-1/NRCELL-2     param=actRel16DmrsForPusch           value=true
&{pucchF3Rel16Pi2BpskAlwaysOn_C2}    dist_name=MRBTS-1/NRBTS-1/NRCELL-2     param=pucchF3Rel16Pi2BpskAlwaysOn    value=false
&{pucchF3ModulationScheme_C2}        dist_name=MRBTS-1/NRBTS-1/NRCELL-2     param=pucchF3ModulationScheme        value=pi2bpsk
&{clpcPucchTargetSinr}               dist_name=MRBTS-1/NRBTS-1/NRULCLPC_PROFILE-0     list_name=clpcPucch     param=targetSinr          value=19
&{clpcPucchtIntervalSinrUpd}         dist_name=MRBTS-1/NRBTS-1/NRULCLPC_PROFILE-0     list_name=clpcPucch     param=tIntervalSinrUpd    value=10ms

# END SCF parameters of the test ======================================================================================

#swconfig Rad Parameters
# @{radList}    ${radDic_580832}     ${radDic_580833}    ${radDic_58082F}    ${radDic_580376}    ${radDic_580377}
# ...           ${radDic_580831}     ${radDic_580830}    ${radDic_58057A}    ${radDic_58057D}    ${radDic_4B000F}

@{radList}    ${radDic_58082F}    ${radDic_580376}    ${radDic_580377}
...           ${radDic_58057A}    ${radDic_58057D}    ${radDic_4B000F}

# &{radDic_580832}     field=0x580832    value=100          #${EMPTY}     #rdUlTransPrecodeOnSinrThreshR16DmrsOffset
# &{radDic_580833}     field=0x580833    value=100          #${EMPTY}     #rdUlTransPrecodeOffSinrThreshR16DmrsOffset
&{radDic_58082F}     field=0x58082F    value=30           #${EMPTY}     #rdPmaxBoost
&{radDic_580376}     field=0x580376    value=5            #${EMPTY}     #rdTransPrecodeHystThresh
&{radDic_580377}     field=0x580377    value=2            #${EMPTY}     #rdTransPrecodeBufferThresh
# &{radDic_580831}     field=0x580831    value=100          #${EMPTY}     #rdUlRank2to1ThreshR16DmrsOffset
# &{radDic_580830}     field=0x580830    value=100          #${EMPTY}     #rdUlRank1to2ThreshR16DmrsOffset
&{radDic_58057A}     field=0x58057A    value=4            #rdFeatureFlagBitmapLevel
&{radDic_58057D}     field=0x58057D    value=786432       #rdFeatureFlagBitmap2
&{radDic_4B000F}     field=0x4B000F    value=1            # RF_SW_Version_check_disabled

#UE corner
&{UE_1_SA_TDD_UE_R16}
...     ueid=1
...     ue_nr_capabilities=${SA_TDD_UE_R16}         #${SA_TDD_UE_R15_PC3}
...     ue_release=16    #${EMPTY} => basic already tuned correctly
...     Target_cell=1          #${EMPTY} => basic already tuned correctly

&{UE_2_SA_TDD_UE_R16}
...     ueid=2
...     ue_nr_capabilities=${SA_TDD_UE_R16}
...     ue_release=16   #${EMPTY} => basic already tuned correctly
...     Target_cell=2   #${EMPTY} => basic already tuned correctly

@{uelist}    ${UE_1_SA_TDD_UE_R16}    ${UE_2_SA_TDD_UE_R16}
#@{uelist}    ${UE_2_SA_TDD_UE_R16}

#DOD Corner
@{DODlist}      # list empty for now will contain all DOD corner

#DOD Corner L1L2
# Focusing on Cell 1 for MULTI UE setup
@{AcceptanceCriteriaL1L2}    ${AC1_1}    ${AC2_1}    ${AC3_1}    ${AC4_1}    ${AC5_1}    ${AC6_1}    ${AC7_1}    ${AC8_1}
...                          ${AC20_1}    ${AC21_1}    ${AC22_1}    ${AC23_1}    ${AC24_1}    ${AC25_1}    ${AC26_1}
#...                          ${AC1_0}    ${AC3_0}    ${AC6_0}    ${AC7_0}    ${AC8_0}
#...                          ${AC23_0}    ${AC25_0}    ${AC26_0}


# Trace Type | subcell_id | Message in Trace (Filter) | IE description | Requested Value
# Note: subcell_id0=Cell1

# Case 1 UE for 7103-A:
# UE DMRS_SEQ_TYPE_1 or DMRS_SEQ_TYPE_2 for 7103-A on subcell_id=1:

&{AC1_1}     PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.puschTransformPrecoderFlag
...          value=1             dodtype=ExactValueForall    PercentTol=20
# If UlData_puschReceiveReqGrant_t.puschTransformPrecoderFlag<> 1/enabled  Then KO else OK
# Case one occurrence <> 1 then KO

&{AC2_1}     PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.mcs
...          value=1             dodtype=InfEgalValueFarll    PercentTol=20
# If UlData_puschReceiveReqGrant_t.mcs<>0 or 1          Then KO else OK
# Case one occurrence > 1 then KO

&{AC3_1}     PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.dmrsSequenceType
...          value=${expected_PuschDmrsSeqType_cell2}  dodtype=ExactValueForall    PercentTol=20
# Variable "expected_PuschDmrsSeqType" : either 0/TYPE_1 or 1/TYPE_2
# If UlData_puschReceiveReqGrant_t.dmrsSequenceType <> expected_PuschDmrsSeqType     Then KO else OK
# Case one occurrence <> expected_PuschDmrsSeqType then KO

&{AC4_1}     PcapType=L1L2        subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.modulationOrder
...          value=1              dodtype=ExactValueForall    PercentTol=20
# If UlData_puschReceiveReqGrant_t.modulationOrder<>1/Order1              Then KO else OK
# Case one occurrence <> 1 then KO

&{AC5_1}     PcapType=L1L2        subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.mcsTable
...          value=0              dodtype=ExactValueForall    PercentTol=20
# If UlData_puschReceiveReqGrant_t.mcsTable<>0/max64QAM                   Then KO else OK
# Case one occurrence <> 0 then KO

&{AC6_1}     PcapType=L1L2        subcell_id=1     msg=uldata_puschreceiverespps	  field=UlData_UePuschReceiveRespPs_t.sinr_item
...          value=Display        dodtype=DisplayAverage    PercentTol=20
# No check on this parameter  for now - will be used for manual tests "Calcul moyenne param sinr udata_PuschReceiveRespPs"
# Display ONLY - AVERAGE

&{AC7_1}     PcapType=L1L2        subcell_id=1     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.crc
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- CRC OK/0 or CRC KO/1
# Count nb of  "UlData_UePuschReceiveRespHarqU_t.crc" occurrences
# Count nb of UlData_UePuschReceiveRespHarqU_t.crc=NOK/1
# Gives percentSubcellId1PuschCRCKO CRC NOK
# Display ONLY

&{AC8_1}     PcapType=L1L2        subcell_id=1     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.dtx
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- NON_DTX/0 or DTX/1
# Count nb of  "UlData_UePuschReceiveRespHarqU_t.dtx" occurrences
# Count nb of UlData_UePuschReceiveRespHarqU_t.dtx=DTX/1
# Gives percentSubcellId1DTX DTX DTX
# Display ONLY

# Case 2 UES for 7103-A:
# Case 1 UE DMRS_SEQ_TYPE_1 on subcell_id=0 and 1 UE DMRS_SEQ_TYPE_2 on subcell_id=1 for 7103-A:

&{AC1_0}     PcapType=L1L2       subcell_id=0     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.puschTransformPrecoderFlag
...          value=1             dodtype=ExactValueForall    PercentTol=20
# If UlData_puschReceiveReqGrant_t.puschTransformPrecoderFlag<> 1/enabled  Then KO else OK
# Case one occurrence <> 1 then KO

&{AC3_0}     PcapType=L1L2       subcell_id=0     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.dmrsSequenceType
...          value=${expected_PuschDmrsSeqType_cell1}   dodtype=ExactValueForall    PercentTol=20
# Variable "expected_PuschDmrsSeqType" : either 0/TYPE_1 or 1/TYPE_2
# If UlData_puschReceiveReqGrant_t.dmrsSequenceType <> expected_PuschDmrsSeqType     Then KO else OK
# Case one occurrence <> expected_PuschDmrsSeqType then KO

&{AC6_0}     PcapType=L1L2        subcell_id=0     msg=uldata_puschreceiverespps	  field=UlData_UePuschReceiveRespPs_t.sinr_item
...          value=Display        dodtype=DisplayAverage    PercentTol=20
# No check on this parameter  for now - will be used for manual tests "Calcul moyenne param sinr udata_PuschReceiveRespPs"
# Display ONLY - AVERAGE

&{AC7_0}     PcapType=L1L2        subcell_id=0     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.crc
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- CRC OK/0 or CRC KO/1
# Count nb of  "UlData_UePuschReceiveRespHarqU_t.crc" occurrences
# Count nb of UlData_UePuschReceiveRespHarqU_t.crc=NOK/1
# Gives percentSubcellId1PuschCRCKO CRC NOK
# Display ONLY
# If percentSubcellId1PuschCRCKO > percentSubcellId0PuschCRCKO                   Then KO else OK

&{AC8_0}     PcapType=L1L2        subcell_id=0     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.dtx
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- NON_DTX/0 or DTX/1
# Count nb of  "UlData_UePuschReceiveRespHarqU_t.dtx" occurrences
# Count nb of UlData_UePuschReceiveRespHarqU_t.dtx=DTX/1
# Gives percentSubcellId1DTX DTX DTX
# Display ONLY

# Case 1 UE for 7103-B:
# UE DMRS_SEQ_TYPE_1 or DMRS_SEQ_TYPE_2 for 7103-B on subcell_id=1:

&{AC20_1}     PcapType=L1L2       subcell_id=1     msg=uldata_pucchreceivereq	      field=UlData_pucchReceiveReqPucchResource_t.pucchFormat
...           value=Display           dodtype=PercentOfEachCase    PercentTol=20
# CountPucchFormat3 = nb of UlData_pucchReceiveReqPucchResource_t.pucchFormat=PUCCH_FORMAT_3/3
# Case one occurrence then OK

&{AC21_1}     PcapType=L1L2       subcell_id=1     msg=uldata_pucchreceivereq	      field=UlData_pucchReceiveReqPucchResource_t.numOfLayers
...           value=1             dodtype=ExactValueForall    PercentTol=20
# if UlData_pucchReceiveReqPucchResource_t.numOfLayers <> 1/NUM_OF_LAYERS_VAL_1                Then KO else OK
# Case one occurrence <> 1 then KO

&{AC22_1}     PcapType=L1L2       subcell_id=1     msg=uldata_pucchreceivereq	      field=UlData_pucchReceiveReqPucchResource_t.modulationType
...           value=0              dodtype=ExactValueForall    PercentTol=20
# if UlData_pucchReceiveReqPucchResource_t.modulationType <> 0/BPSK                Then KO else OK
                               #Case one occurrence <> 0 then KO

&{AC23_1}     PcapType=L1L2        subcell_id=1     msg=uldata_pucchreceivereq	      field=UlData_pucchReceiveReqPucchResource_t.dmrsSequenceType
...           value=${expected_PucchDmrsSeqType_cell2}  dodtype=ExactValueForall    PercentTol=20
# Variable "expected_PuschDmrsSeqType" : either 0/TYPE_1 or 1/TYPE_2
# If UlData_pucchReceiveReqPucchResource_t.dmrsSequenceType <> expected_PucchDmrsSeqType                Then KO else OK
# Case one occurrence <> expected_PucchDmrsSeqType     then KO

&{AC24_1}     PcapType=L1L2        subcell_id=1     msg=uldata_pucchreceiverespps	      field=UlData_pucchReceiveRespPsPucchResource_t.pucchFormat
...           value=Display           dodtype=PercentOfEachCase    PercentTol=20
# CountPucchFormat3 = nb of UlData_pucchReceiveReqPucchResource_t.pucchFormat=PUCCH_FORMAT_3/3
# IfcountPucchRespPsFormat3 = 0                 Then KO else OK
# Case one occurrence then OK

&{AC25_1}     PcapType=L1L2        subcell_id=1     msg=uldata_pucchreceiverespps	  field=UlData_pucchReceiveRespPsPucchResource_t.crc
...           value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- CRC OK/0 or CRC KO/1
# Count nb of  "UlData_UePucchReceiveRespps.crc" occurrences
# Count nb of UlData_UePucchReceiveRespps.crc=NOK/1
# Gives percentSubcellId1PucchCRCKO
# Display ONLY

&{AC26_1}     PcapType=L1L2        subcell_id=1     msg=uldata_pucchreceiverespps   field=UlData_pucchReceiveRespPsPucchResource_t.dtx
...           value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- NON_DTX /0 or DTX /1
# Count nb of  "UlData_UePucchReceiveRespps.dtx" occurrences
# Count nb of UlData_UePuschReceiveRespps.dtx=DTX/1
# Gives percentSubcellId1PucchDTXKO
# Display ONLY


# Case 2 UES for 7103-B:
# Case 1 UE DMRS_SEQ_TYPE_1 on subcell_id=0 and 1 UE DMRS_SEQ_TYPE_2 on subcell_id=1 for 7103-B:

&{AC23_0}     PcapType=L1L2       subcell_id=0     msg=uldata_pucchreceivereq	      field=UlData_pucchReceiveReqPucchResource_t.dmrsSequenceType
...           value=${expected_PucchDmrsSeqType_cell1}  dodtype=ExactValueForall    PercentTol=20
# Variable "expected_PuschDmrsSeqType" : either 0/TYPE_1 or 1/TYPE_2
# If UlData_pucchReceiveReqPucchResource_t.dmrsSequenceType <> expected_PucchDmrsSeqType                Then KO else OK
# Case one occurrence <> expected_PucchDmrsSeqType     then KO

&{AC25_0}     PcapType=L1L2       subcell_id=0     msg=uldata_pucchreceiverespps	      field=UlData_pucchReceiveRespPsPucchResource_t.crc
...           value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- CRC OK/0 or CRC KO/1
# Count nb of  "UlData_UePucchReceiveRespps.crc" occurrences
