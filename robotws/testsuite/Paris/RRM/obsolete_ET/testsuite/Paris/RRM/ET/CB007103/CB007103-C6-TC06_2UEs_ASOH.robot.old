*** Test Cases ***

[1]CB007103-C6-TC06_R16ToR15_Pusch_PucchF3Pi2_NotPUCCHR16AlwsOn_ASOH
    # [Tags]                      CLOUD_5G_I_MP_AP_LO, SANSA_FS_ECPRI_CMWV_TDD

                            # ATTENTION THIS TOPOLOGY LO_AP_LO IS NOT USED ANYMORE as CSV constraints are specific to MP_AP_LO CLOUD_5G_I_LO_AP_LO,
                            # SANSA_FS_CPRI_CMWV_FDD+ECPRI_CMWV_TDD_AEQE

    #Special Need for this test

    Set Suite Variable    ${userneed_PCAP}       ${True}
    Set Suite Variable    ${tti}                 ${True}
    Set Suite Variable    ${userneed_Btslog}     ${True}
    Set Suite Variable    ${userneed_PM}         ${True}
    Set Suite Variable    ${DodIsSet}            ${True}

    CB007103_mainKW    ${C6_TC06}

*** Keywords ***

CB007103_mainKW
    [Documentation]                 CB007103-Base-
    [Arguments]                     ${param}
    kwmkt_dbg_log                   Global variable list DBGlogs: ${DBGlogs}          ##
    kwmkt_dbg_log                   info we are on KeepConfig: ${KeepConfig}           # these informative line to bypass Robot 5 new sanity :-)
    kwmkt_dbg_log                   info we are on NoSnap: ${NoSnap}                   #
    kwmkt_dbg_log                   info we are on egatelogoutput: ${egatelogoutput}   #
    kwmkt_dbg_log                   info we are on EnSher: ${EnSher}                   #
    kwmkt_dbg_log                   info we are on tti: ${tti}                         #
    kwmkt_dbg_log                   info we are on DodIsSet: ${DodIsSet}               #
    kwmkt_dbg_log                   recursion_limit: ${recursion_limit}                #
    kwmkt_dbg_log                   print to be used (sanity RF5 5 :-) ) ${AC1_0} ${AC3_0} ${AC6_0} ${AC7_0} ${AC8_0}
    kwmkt_dbg_log                   print to be used (sanity RF5 5 :-) ) ${AC23_0} ${AC25_0} ${AC26_0}

    Init Sequence                   ${param}
    Step                            kwmkt_Create_Test_Suite_Folder

    Critical Step                   Set_basic_context
    Critical Step                   Set_RadParameters
    Critical Step                   Set_SCF_ConfigMarket     ${param.Scfdetails}
    Critical Step                   Set_SCF_ofTheTest        ${param.Feat7103niddSpecific}

    Critical Step                   kwmkt_Cell_setup         ${CellList}
    Run Keyword If                  not ${tti} and ${EnSher}                Activate Sherpa

    #L3call
    Run Keyword If                  ${userneed_PCAP}         kwmkt_Capture_Start    Attach


    #TTI for Attach with PuschSinr and cellnoise
    #Run Keyword If                  ${tti} and not ${EnSher}
    #...                             kwmkt_TTI_start    time=${param.GetTtiTraceTime}

    Critical Step                kwmkt_run_script_once    ${CURDIR}/resources/egCmd/BC_2UEs/egCmd_B-C_attach_TP_OFF_ON_CellNoise_2UEs_ASOH.sce

    #Run Keyword If                  ${tti} and not ${EnSher}
    #...                             kwmkt_TTI_stop     suffix=TTI_Attach_PuschSinr_cellnoise_2UEs
    #...                                                targpath=${logsDir}/tti
    # ...                                              nm_convert=${False}


    #TTI for switching from TP OFF to TP ON
    #Run Keyword If                  ${tti} and not ${EnSher}
    #...                             kwmkt_TTI_start   time=${param.GetTtiTraceTime}

    Critical Step                   kwmkt_run_script_once       ${CURDIR}/resources/egCmd/BC_2UEs/egCmd_B-C_PHR_TM_2UEs.sce


    #Run Keyword If                  ${tti} and not ${EnSher}
    #...                             kwmkt_TTI_stop     suffix=TTI_PHR_TM_2UEs
    #...                                                targpath=${logsDir}/tti
    # ...                                              nm_convert=${False}

    #BIP L1L2
    Dated log                                                2s L1L2 Bip collection
    kwmkt_Capture_Start                                      Traff
    Sleep    2s     #5ms
    ${pcappa}    kwmkt_Capture_Stop                          Traff

	Traced Sleep                    600               msg=Sleep for 10mins to let counters stablilize

    #PM counters
    ${PMdod} =	                    Run Keyword And Return Status    kwmkt_PM_general
    kwmkt_dbg_log                   ${PMdod}
    Append to List                  ${DODlist}    ${PMdod}

    #TTI for switching from TP ON to TP OFF
    #Run Keyword If                  ${tti} and not ${EnSher}
    #...                             kwmkt_TTI_start    time=${param.GetTtiTraceTime}

    Critical Step                   kwmkt_run_script_once       ${CURDIR}/resources/egCmd/BC_2UEs/egCmd_B-C_TP_ON_OFF_2UEs.sce

    #Run Keyword If                  ${tti} and not ${EnSher}
    #...                             kwmkt_TTI_stop     suffix=TTI_TP_ON_OFF_2UEs
    #...                                                targpath=${logsDir}/tti
    # ...                                              nm_convert=${False}

    Run Keyword If                  ${userneed_PCAP}         kwmkt_Capture_Stop     Attach

    #L1L2 check
    pcap2csv                        PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
# /!\  elemRank help to choose info when tshark result return several information elemRank=0 => first elem of the list
  #  ${resSub0}                      Check_in_pcap            PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
  #  ...                                                      SbcId=0          elemRank=0
                                                                         #on WireShark in case of multiple ue, all information are in the same item
                                                                         #so we need to specify the range of the item to check [0] is item 1 so UE1
                                                                         #If we focus on UE_id=2 the range may be [3] for UE2 depending to csv file

    ${resSub1}                       Check_in_pcap           PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
    ...                                                      SbcId=1          elemRank=0
    #on WireShark in case of multiple ue, all information are in the same item
                                                                         #so we need to specify the range of the item to check [0] is item 1 so UE1
                                                                         #If we focus on UE_id=2 the range may be [3] for UE2 depending to csv file

    # Dated log    dod global vision: PM:${pcappa}
   # Dated log    dod global vision: resSub0:${resSub0}
    Dated log    dod global vision: resSub1:${resSub1}
    #Append to List                  ${DODlist}    ${resSub0}    ${resSub1}
    Append to List                  ${DODlist}     ${resSub1}

    Dated log                                           DOD_7103: DodIsSet:${DodIsSet} res:${DODlist}
    Run Keyword If                  ${DodIsSet}         kwmkt_Check_For_False_In_${NL}    ${DODlist}
