    GnbSwconfigManager().log_swconfig_contents()


def combine_scf_with_delta(target_scf_path, delta):
    """
    Perform full SCF commissioning due to parameters that cannot be modified by delta.
    Modify in SCF parameters defined in delta. Only 'delete' and 'update' operations are supported.

    :param target_scf_path: (str) Path to new SCF file
    :param delta: (list) json-like list with dict objects (for example see DELTA_CELL_2_ON_LOKI_B in deltas.py)
    """

    test_prefix = get_test_prefix()
    output_dir = BuiltIn().get_variable_value('${OUTPUT_DIR}')
    scf_path = os.path.join(output_dir, test_prefix, f'before_{test_prefix}_scf.xml')
    scf_instance = scf()
    scf_instance.load_scf(scf_path)

    for obj in range(len(delta)):
        dist_name = delta[obj]['distName']
        operation = delta[obj]['operation']
        scf_instance.is_object_in_scf(dist_name)
        if operation == 'delete':
            logger_info(f'Deleting object {dist_name}')
            scf_instance.remove_mo_with_descendant_mos(dist_name)
        elif operation == 'update':
            logger_info(f'Modifying object {dist_name}')
            parameters = delta[obj]['parameters']
            for parameter in parameters:
                param_name = parameter['parameterName']
                logger_info(f'Updating value of {dist_name}/{param_name}')
                try:
                    scf_instance.modify_scf_element(
                        value=parameter['value'],
                        dist_name=dist_name,
                        p_name=param_name
                    )
                except KeyError:
                    scf_instance.modify_scf_element(
                        value=parameter['value'][0],
                        index=1,
                        dist_name=dist_name,
                        list_name=param_name
                    )
    scf_instance.save_scf(target_scf_path)
    perform_gnb_commissioning(target_scf_path)
    wait_for_requested_bts_state(bts_state='commissioned')


def create_copy_of_iphy_file():
    run_on_ap('cp /rom/simmode/iphy.xml /rom/simmode/iphy_copy.xml')


def switch_to_old_iphy():
    run_on_ap('ln -sf /rom/simmode/iphy_copy.xml /rom/simmode/iphy.xml')


def switch_to_old_scf():
    test_prefix = get_test_prefix()
    scf_path = os.path.join(BuiltIn().get_variable_value('${OUTPUT_DIR}'), test_prefix, f'basic_{test_prefix}_scf.xml')
    perform_gnb_commissioning(scf_path)
    wait_for_requested_bts_state(bts_state='configured')


def create_scf_copy():
    prefix = get_test_prefix()
    collect_scf_file(prefix='basic', subdir=prefix, name=prefix)


def get_testline_name():
    # Returns the name of the Testline. Ex: 2_16_UTE5GCLASSICAL4246
    for module in sys.modules.copy().values():
        if type(module) is ModuleType:
            if "tl" in dir(module):
                return os.path.basename(os.path.dirname(module.__file__))
    raise Exception('No Testline Module Loaded!')


def check_if_cm_execution():
    # returns False if the test was launched by the CloudManager, otherwise returns True.
    return False if os.environ.get("CM_EXECUTION_ID") is None else True
