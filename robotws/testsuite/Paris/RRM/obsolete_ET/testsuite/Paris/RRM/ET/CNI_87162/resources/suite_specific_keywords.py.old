def set_variables_based_on_deployment_and_release():
    capacity_unit = get_capability_unit_name()
    release = get_gnb_build_release(convert_to_trunk=True)
    release_no_conv = get_gnb_build_release(convert_to_trunk=False)
    pm_interval = pm_counters.get_measurement_period_from_scf()
    pm_interval = int(pm_interval.replace('min', ''))
    ru_card_name = establish_topology_by_radio_head_card_name()
    BuiltIn().set_suite_variable("${PM_PERIOD}", pm_interval)
    BuiltIn().set_suite_variable("${UNIT_NAME}", capacity_unit)
    BuiltIn().set_suite_variable("${RELEASE}", release)
    BuiltIn().set_suite_variable("${RELEASE_NO_CONV}", release_no_conv)
    BuiltIn().set_suite_variable("${RU_CARD_NAME}", ru_card_name)


def establish_topology_by_radio_head_card_name():
    iphy_instance = IphyManagement()
    iphy_instance.load_iphy_contents_from_airphone()
    card_names = iphy_instance.get_all_radio_heads_card_names()
    return "AZQJ" if "AZQJ" in card_names else "AEQE"


def get_test_prefix():
    tc_name = ta5g_interface_tools().get_robot_test_name()
    match = re.search(r'(?P<feature>CNI_87162)_(?P<tc>\w{3})_(?P<usc>USC\d|Robustness\d)', tc_name)
    prefix = match.group() if match else tc_name
    BuiltIn().set_test_variable("${TEST_PREFIX}", prefix)
    return prefix


def ensure_gnb_files_flags_are_in_order():
