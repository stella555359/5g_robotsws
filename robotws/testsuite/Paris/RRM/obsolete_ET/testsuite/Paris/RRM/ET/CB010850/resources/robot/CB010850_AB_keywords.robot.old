*** Variables ***

${gnb_alias}                      gnb_under_test

${nrarfcnDl}                      392500
${nrarfcnUl}                      376500
${gscn}                           4907
${off}                            off

${NRCELLID_1_idx}                   1
${NRCELLID_2_idx}                   2
${NRCELLID_3_idx}                   3

# expected counters value with CB009215 activated
# &{BB_POOL_Counter_Expected}             PM_ID=M55308C10006
# ...                                     CELL_1_Expected=5250000
# ...                                     CELL_2_Expected=5250000
# ...                                     CELL_3_Expected=6750000


# expected counters value without CB009215 activated
