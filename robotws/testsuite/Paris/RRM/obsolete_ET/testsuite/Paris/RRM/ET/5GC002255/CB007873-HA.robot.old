*** Variables ***
${TestSharkTool}      MC_SHARK

# variable set to ${True} to automatically save SOS report and OAM snapshot
# (by default, these information are saved only if a test is failed)
${ForceDebugDataCollection}    ${False}
#${ForceDebugDataCollection}    ${True}

# UE Profile for call Setup
&{UE_11}                            ue=11                                   profile=1
...                                 bearer=2                                testMode=False
...                                 pdu=${None}                             qfi=${None}             type=l3
...                                 trf_id=1                                burst=${None}
...                                 target_gnb=2                            target_cells=2
...                                 throughput=350                          testModeValue=csi_report_override
...                                 maxThroughputPerTransfer=175            trfDuration=300s
...                                 deviation=25                            throughputul=15          period_ms=${None}

&{Dico_UE}  UE_11=${UE_11}


&{HA}
...                                 trfDuration=300s
...                                 deviation=25

