*** Keywords ***
TC 5GC000524_G_01 NSA
    [Documentation]     Generic test for NSA Cellsetup

    Init Sequence          ${TLConfig.topo}
    Critical Step          5GC000524 SCF config
    Critical Step          5GC000524 Full Commissioning
    Critical Step          WTS Setup                       shouldUseLua=False
    Step                   5GC000524 Update UE id
    Step                   UE_register_Local               depends=5GC000524 Update UE id
    Step                   PDU_Session                     depends=UE_register_Local
    Step                   Attach UE_NSA                   depends=5GC000524 Update UE id
    Step                   Traffic_SA                      depends=PDU_Session
    Step                   Traffic_NSA                     depends=Attach UE_NSA


5GC000524 SCF config
    OAM Get SCF Files
    ${TC_file_name}             getFormattedTestName
    ${DU_SCF}                   Set Variable    ${LOG_PATH}/SCF_DU_${TC_file_name}.xml
    Run                         cp ${SCF_SETUP_PATH} ${DU_SCF}

    SCF StartSession            scf_file=${DU_SCF}

    ${TDDcellID}                Set Variable    ${TDD_Cell_list[0].nrCellId}
    ${NRbtsDistName}            Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ${cellDistName}             Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${TDDcellID}

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=actBeamforming
    ...                         element_value=true

    SCF Set element in List     dist_name=${cellDistName}    list_name=beamSet
    ...                         element_name=basicBeamSet
    ...                         element_value=beamSet_2

    SCF Set element in List     dist_name=${cellDistName}    list_name=beamSet
    ...                         element_name=leftEdgeAngle
    ...                         element_value=60

    SCF Set element in List     dist_name=${cellDistName}    list_name=beamSet
    ...                         element_name=lowerEdgeAngle
    ...                         element_value=120

    SCF Set element in List     dist_name=${cellDistName}    list_name=beamSet
    ...                         element_name=nrBtsBeamRefinementP2
    ...                         element_value=true

    SCF Set element in List     dist_name=${cellDistName}    list_name=beamSet
    ...                         element_name=rightEdgeAngle
    ...                         element_value=60

    SCF Set element in List     dist_name=${cellDistName}    list_name=beamSet
    ...                         element_name=tiltOffset
    ...                         element_value=0

    SCF Set element in List     dist_name=${cellDistName}    list_name=beamSet
    ...                         element_name=upperEdgeAngle
    ...                         element_value=60

    ${cell_1_Grp_DistName}      OAM Get NR Cell GROUP    NRCellId=${TDDcellID}
    SCF Set element             dist_name=${cell_1_Grp_DistName}
    ...                         element_name=numberOfTransmittedSsBlocks
    ...                         element_value=2 beams

    SCF Set element             dist_name=${cell_1_Grp_DistName}
    ...                         element_name=ssBurstSetPeriod
    ...                         element_value=20

    SCF Set element in List     dist_name=${cellDistName}    list_name=csirsBeamMgmt
    ...                         element_name=csirsBmMgmtDensity
    ...                         element_value=density3

    SCF Set element in List     dist_name=${cellDistName}    list_name=csirsBeamMgmt
    ...                         element_name=csirsBmMgmtReIndex
    ...                         element_value=0

    SCF Set element in List     dist_name=${cellDistName}    list_name=csirsBeamMgmt
    ...                         element_name=csirsBmMgmtSubband
    ...                         element_value=aboveSSPBCHBlock

    SCF Set element             dist_name=${NRbtsDistName}
    ...                         element_name=actFdmScheduling
    ...                         element_value=true

    SCF Set element             dist_name=${NRbtsDistName}
    ...                         element_name=actFdmEnhancedScheduling
    ...                         element_value=true

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=eirpControlTimeAveragingWindow
    ...                         element_value=6

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=mcsIndexForArtificialLoad
    ...                         element_value=0

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=pMax
    ...                         element_value=260

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=ssPbchBlockPower
    ...                         element_value=6

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=targetTotalLoad
    ...                         element_value=0

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=type0SearchSpaceConfigurationIndex
    ...                         element_value=4

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=type0CoresetConfigurationIndex
    ...                         element_value=10

    SCF Set element in List     dist_name=${cellDistName}    list_name=csirsForTracking
    ...                         element_name=csirsTrackingPeriod
    ...                         element_value=80ms

    SCF Set element in List     dist_name=${cellDistName}    list_name=csirsForTracking
    ...                         element_name=firstRE
    ...                         element_value=0

    SCF Set element in List     dist_name=${cellDistName}    list_name=csirsForTracking
    ...                         element_name=rbAllocation
    ...                         element_value=BWP

    SCF Set element in List     dist_name=${cellDistName}    list_name=csirsForTracking
    ...                         element_name=startRB
    ...     element_value=0

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=dlMimoMode
    ...                         element_value=4x4 or 4x2 Closed Loop Spatial Multiplexing

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=dlMuMaxNumPairedUEs
    ...                         element_value=8

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=dlMuPairingThreshold
    ...                         element_value=5

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=dlMuLowSinrThreshold
    ...                         element_value=-6

    SCF Set element             dist_name=${NRbtsDistName}
    ...                         element_name=actCarrierAggregation
    ...                         element_value=false

    SCF Set element             dist_name=${cellDistName}
    ...                         element_name=actEirpControl
    ...                         element_value=false

    SCF StopSession             scf_file=${DU_SCF}
    Set Suite Variable          ${DU_SCF}


5GC000524 Full Commissioning
    OAM Perform Full Commissioning    scf_file=${DU_SCF}
    OAM wait available


5GC000524 Update UE id
    [Documentation]   Update UE id according to the UE definition in CFG file
    ${BASIC_UE_SA_1.ue}            Get First SA UE Id    cell=NRCELL-${TDD_Cell_list[0].nrCellId}
    ${BASIC_UE_SA_2.ue}            Evaluate        ${BASIC_UE_SA_1.ue}+1
    ${UE_SIMPLE_TEST_NSA_11.ue}    Set Variable    ${FIRST_NSA_UE_ID}
    ${UE_SIMPLE_TEST_NSA_12.ue}    Evaluate        ${FIRST_NSA_UE_ID}+1


#########################################################
###  Old version used with previous TDD_TEMP variant  ###
###  which defines only 2 TDD cells 2DL2UL            ###
