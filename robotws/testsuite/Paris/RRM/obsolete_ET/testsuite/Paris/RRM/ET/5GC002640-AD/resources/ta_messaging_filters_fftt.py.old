        and
        pusch-ServingCellConfig is not present
    )
    and
    sCellToAddModList contains
    (
        sCellIndex eq 2
        and
        pdsch-ServingCellConfig contains (maxMIMO-Layers eq 2)
        and
        pusch-ServingCellConfig is not present
    )
    and
    sCellToAddModList contains
    (
        sCellIndex eq 3
        and
        pdsch-ServingCellConfig contains (maxMIMO-Layers eq 4)
        and
        pusch-ServingCellConfig is not present
    )
    and
    spCellConfigDedicated is present
    and
    spCellConfigDedicated contains
    (
        pdsch-ServingCellConfig contains (maxMIMO-Layers eq 2)
    )
    and
    spCellConfigDedicated contains (uplinkConfig is present)
    and
    uplinkConfig contains
    (
        pusch-ServingCellConfig contains (maxMIMO-Layers eq 2)
    )
    """


