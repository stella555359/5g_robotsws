Resource          resources/robot/5GC001745_Kw_TestSetup.robot
Resource          resources/robot/5GC001745_Keywords.robot

Variables         resources/python/Constants.py

# Suite Setup         Run keywords   Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0   AND
Suite Setup         Run keywords
...                                Print My Constants version  AND
...                                Test Suite Setup for 1745   AND
...                                Get gNB cell 5g On air
Suite Teardown      Test suite teardown for 1745

*** Variables ***

${PATTERN_DL_70_SA_OK}      0011100010-0111101110-0011100010-0111101110-0011100010-0111101110-0011100010-0111101110

# 20 %
${tput_deviation}       0.2

# 5 %
${ul_Qos_Load_deviation}       0.05

*** Test Cases ***

# prepare the test line
TestLine_preparation
   [Tags]    FULL_RUN    Cellsetup     10MHZ    1745
   5GC001745_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_1745_C}

TestLine_1745_Test_setup
    [Tags]    FULL_RUN    Cellsetup     10MHZ    1745
    [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%
    [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    ...                       common_Dss_Keywords.Get testcase log directory
    ${tc_name}    Set variable    TestLine_preparation
    ${tc_status}    getTcStatusByName    name=${tc_name}
    ${msg}   Catenate   "TestLine_1745_Test_setup: sw release used [${convert_version}], Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%"
    common_Dss_Keywords.Log Test description   ${msg}
    Run keyword if    '${tc_status}'!='PASS'
    ...           5GC001745_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_1745_C}
    5GC001745_Kw_TestSetup.Test Setup 1745       ${TestDSS10Mhz_1745_C}
    5GC001745_Keywords.TC 1745 CellSetup         ${TestDSS10Mhz_1745_C}   egate_TC1
    [Teardown]      Run Keywords    Teardown 1745      alias=egate_TC1    w_TearDown_wts=False    AND
    ...                             set Suite Variable  ${testCaseDir}  None     AND
    ...                             GenericTest.Display diagnosis

[1]TC1_5GC001745_Check_SA_5g_call_with_1745_activated
    [Tags]    FULL_RUN   FULL_CALL  10MHZ    1745
    [Documentation]     Check 5g DSS SA Call , BW=10MHZ, DL ratio = 100%
    [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    ...       common_Dss_Keywords.Get testcase log directory    AND
    ...       common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp    AND
    ...       depends   TestLine_1745_Test_setup
    ${tc_name}    Set variable    TestLine_1745_Test_setup
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'    Run keywords
    ...                          5GC001745_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_1745_C}    AND
    ...                          5GC001745_Kw_TestSetup.Test Setup 1745       ${TestDSS10Mhz_1745_C}       AND
    ...                          5GC001745_Keywords.TC 1745 CellSetup         ${TestDSS10Mhz_1745_C}   egate_TC1
    TC 1745-5g SA Call                ${TestDSS10Mhz_1745_C}    egate_TC1
    [Teardown]     Run Keywords
    ...                common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
    ...                Teardown 1745     alias=egate_TC1            AND
    ...                set Suite Variable  ${testCaseDir}  None     AND
    ...                GenericTest.Display diagnosis

[1]TC2_5GC001745_Check_SA_5g_call_with_ul_dl_traffic_with_1745_activated_DL_UL_RATIO_70
    [Tags]    FULL_RUN   FULL_CALL  10MHZ    1745
    [Documentation]     Check 5g DSS SA Call , BW=10MHZ, DL/UL ratio = 70%
    [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    ...       common_Dss_Keywords.Get testcase log directory    AND
    ...       common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp   AND
    ...       depends   TestLine_1745_Test_setup
    ${tc_name}    Set variable    TestLine_preparation
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'    Run keywords
    ...                          5GC001745_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_1745_C}   AND
    ...                          5GC001745_Kw_TestSetup.Test Setup 1745       ${TestDSS10Mhz_1745_C}
    # modification DL Ratio into the test param Ctx
    Update DSS DL pattern with     ${TestDSS10Mhz_1745_C}     ${PATTERN_DL_70_SA_OK}
    Dated log       DL pattern into TestParam is ${TestDSS10Mhz_1745_C.seq.dl_allocated_normal_subframes}
    5GC001745_Keywords.TC 1745 CellSetup         ${TestDSS10Mhz_1745_C}    egate_TC2
    TC 1745-5g SA Call                ${TestDSS10Mhz_1745_C}    egate_TC2
    common_Dss_SA_NSA.DSS_5g_SA_UL_DL_Traffic           ${TestDSS10Mhz_1745_C}    ul_rate=20    dl_rate=80   alias=egate_TC2
    Traced Sleep    10s      msg=Waiting for UL/DL Tput
    Start capture Backhaul XP for 1745
    Traced Sleep    1s      msg=Waiting for Xp pcap traces
    ${XpPdmlFile}    Stop capture Backhaul XP for 1745
    Dated log             Point AF_PATH and ENB_BUILD to local luashark XP package
    Point AF_PATH to local luashark XP package
    Point ENB_BUILD to local luashark XP package
    Dated log     =========> Check UL and DL Qos Load Indication MeasuredNgbrNnbrLoad ...
    ${status}    ${avg_ul_MeasuredNgbrNnbrLoad}=  Run Keyword and Ignore Error  common_Dss_Keywords.Check UL Qos Load Indication MeasuredNgbrNnbrLoad
    ...                                                                                              ${XpPdmlFile}
    ...                                                                                              value=64
    ...                                                                                              with_verdict=False
    Run Keyword and Ignore Error      common_Dss_Keywords.Check DL Qos Load Indication MeasuredNgbrNnbrLoad       ${XpPdmlFile}
    Dated log     =========> get ul throughput for ue (0x${TestDSS10Mhz_1745_C.Context.UeId1})
    ${ul_throughput_for_ue1}=  nps_1745_tools.get_bearer_stats_SA   ue=${TestDSS10Mhz_1745_C.Context.UeId1}
    ...                                                             pdu=1   qfi=1    direction=ul  alias=egate_TC2
    dated log     ul throughput for ue1 is ${ul_throughput_for_ue1} Mbps
    ${dl_throughput_for_ue1}=  nps_1745_tools.get_bearer_stats_SA   ue=${TestDSS10Mhz_1745_C.Context.UeId1}
    ...                                                             pdu=1   qfi=1    direction=dl  alias=egate_TC2
    dated log     dl throughput for ue1 is ${dl_throughput_for_ue1} Mbps
    Dated log     =========> Test if Expected ul Qos Load Indication is reached
    # 100 %
    ${expect_UL_Qos_load_Ind_value}    set variable    100
    ${expect_UL_Qos_load_Ind}=    Evaluate    float(${expect_UL_Qos_load_Ind_value})
    Verify UL Qos Load Ind as expected      ul_qos_load_value=${avg_ul_MeasuredNgbrNnbrLoad}    expect_ul_qos_load_value=${expect_UL_Qos_load_Ind}
    ${ul_expect_tput_value}    set variable     15
    Dated log     =========> Test if Expected ul Tput For all Ues is reached [expected=${ul_expect_tput_value}Mbps]
    ${expect_tput}=    Evaluate    float(${ul_expect_tput_value})
    Verify UE tput as expected      tput_value=${ul_throughput_for_ue1}    expect_tput_value=${expect_tput}
    [Teardown]     Run Keywords
    ...                common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
    ...                Teardown 1745     alias=egate_TC2     AND
    ...                set Suite Variable  ${testCaseDir}  None     AND
    ...                GenericTest.Display diagnosis

