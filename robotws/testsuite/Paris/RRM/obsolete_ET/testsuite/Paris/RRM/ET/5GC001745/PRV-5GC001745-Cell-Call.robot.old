*** Keywords ***

TC 1745-5g SA Call
    [Documentation]                Test purpose is to test 5g DSS SA Call
    [Arguments]                    ${param}    ${alias}=default
    Init Sequence                  ${param}
    Step           Start capture Bip and Xp for 1745
    Step           common_Dss_SA_NSA.DSS_5g_Call_SA           argument=${alias}
    Step           Stop capture Bip and Xp for 1745       depends=Start capture Bip and Xp for 1745
    [Teardown]                      GenericTest.Display diagnosis

Update DSS DL pattern with
   [Arguments]                    ${testParam}     ${dl_allocated_normal_subframes}

   ${testParam_dss}                 Tools.Dictionary Get              ${testParam}
   ${testParam_dss.seq.dl_allocated_normal_subframes}      set Variable     ${dl_allocated_normal_subframes}
   set suite variable    ${testParam_dss}
   [Return]      ${testParam_dss}

Verify UE tput as expected
    [Documentation]
    [Arguments]    ${tput_value}    ${expect_tput_value}    ${deviation}=${tput_deviation}
    run keyword if    ${expect_tput_value}==${0}    run keywords
    ...    should be true    ${tput_value}>=0    AND   return from keyword

    ${min}    evaluate    ${expect_tput_value}*(1-${deviation})
    ${max}    evaluate    ${expect_tput_value}*(1+${deviation})
    ${is_tput_as_expected}    evaluate    ${min} <= ${tput_value} <= ${max}
    ${msg}=     Run Keyword If     '${is_tput_as_expected}'=='True'
    ...    Catenate     \t${green} UL Tput for all Ues REACHED: expected = ${expect_tput_value} Mbps,
    ...                            current = ${tput_value} Mbps ${normal}
    ...    ELSE
    ...    Catenate     \t${red} UL Tput for all Ues NOT REACHED: expected = ${expect_tput_value} Mbps,
    ...                          current = ${tput_value} Mbps ${normal}
    Log to Console         ${msg}
    should be true    '${is_tput_as_expected}'=='True'    Tput is not as expected!

Verify UL Qos Load Ind as expected
    [Documentation]
    [Arguments]    ${ul_qos_load_value}    ${expect_ul_qos_load_value}    ${deviation}=${ul_Qos_Load_deviation}
    run keyword if    ${expect_ul_qos_load_value}==${0}    run keywords
    ...    should be true    ${ul_qos_load_value}>=0    AND   return from keyword

    ${min}    evaluate    ${expect_ul_qos_load_value}*(1-${deviation})
    ${max}    evaluate    ${expect_ul_qos_load_value}*(1+${deviation})
    ${is_ul_qos_load_as_expected}    evaluate    ${min} <= ${ul_qos_load_value} <= ${max}
    Run Keyword If                  '${is_ul_qos_load_as_expected}'=='True'
    ...    Log to Console            \t${green} Average UL DSS Ratio REACHED: expected = 100 % , current = ${ul_qos_load_value} % ${normal}
    ...    ELSE
    ...    Log to Console            \t${red} Average UL DSS RATIO NOT REACHED: expected = 100 %, current = ${ul_qos_load_value} % ${normal}
    should be true    '${is_ul_qos_load_as_expected}'=='True'    UL Qos load Indication is not as expected!

Verify DL Qos Load Ind as expected
    [Documentation]
    [Arguments]    ${dl_qos_load_value}    ${expect_dl_qos_load_value}    ${deviation}=${ul_Qos_Load_deviation}
    run keyword if    ${expect_dl_qos_load_value}==${0}    run keywords
    ...    should be true    ${dl_qos_load_value}>=0    AND   return from keyword

    ${min}    evaluate    ${expect_dl_qos_load_value}*(1-${deviation})
    ${max}    evaluate    ${expect_dl_qos_load_value}*(1+${deviation})
    ${is_ul_qos_load_as_expected}    evaluate    ${min} <= ${dl_qos_load_value} <= ${max}
    Run Keyword If                  '${is_dl_qos_load_as_expected}'=='True'
    ...    Log to Console            \t${green} Average DL DSS Ratio REACHED: expected = 100 % , current = ${dl_qos_load_value} % ${normal}
    ...    ELSE
    ...    Log to Console            \t${red} Average DL DSS RATIO NOT REACHED: expected = 100 %, current = ${dl_qos_load_value} % ${normal}
    should be true    '${is_dl_qos_load_as_expected}'=='True'    DL Qos load Indication is not as expected!

Verify BTS Procedural State
    [Arguments]    ${alias}=cOAM    ${proceduralStates}=Configured    ${timeout}=30
    [Documentation]  Verify BTS Procedural State and blocking State
    ...     alias:   AdminConnection object or if used, string name alias
    ...     timeout: Time to wait for positive procedure result
    ...     proceduralStates: (string or list) BTS procedural States, opetions=Configured or OnAir or Commissioned
    ${bts_status}=    coam.get_bts_statuses    timeout=${timeout}    connection=${alias}
    List Should Contain Value    ${proceduralStates}    ${bts_status['proceduralState']}
    should be equal    ${bts_status['blockingState']}       Unblocked            ignore_case=true

Check BTS status in WEM for cOAM
    [Documentation]   This keyword is used to Check BTS status in WEM for cOAM.
    ...    author: Ch SAMSON
    [Arguments]     ${cell_id}=0
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=    coam.get_bts_statuses    timeout=30    connection=${GNB_DU.oam.httpAlias}
    Dated log      =======> Current bts status is ${bts_status}
    should Contain Any    ${bts_status['proceduralState']}       configured    OnAir    msg=ENB is not configured, Current status is ${bts_status}
    ...                                                                                 ignore_case=true
    should be equal    ${bts_status['blockingState']}       Unblocked            ignore_case=true

    ${cell_info}=    coam.get_cells_info    cell_type=nr    timeout=30    connection=${GNB_DU.oam.httpAlias}
    Dated log      =======> Current cell(s) info is ${cell_info}
    FOR    ${elem}    IN    @{cell_info}
#    ${cell_info}=    set variable   ${cell_info[${cell_id}]['status']}
#        Should be equal    ${elem['status']['operationalState']}    Enabled    ignore_case=true
#        Should be equal    ${elem['status']['proceduralStatus']}    configured    ignore_case=true
        Should be equal    ${elem['status']['proceduralStatus']}    not initialized    ignore_case=true
        Should be equal    ${elem['status']['administrativeState']}    Unlocked    ignore_case=true
    END
    OAM Disconnect                  ${GNB_DU.oam}

Restart TL wo WTS clear
    [Documentation]                 Entry point for the restart of a TL, Classical only , without WTS clear
    [Arguments]                     ${GNBCallback}=None                     ${APCallback}=None
    ...                             ${isOAMRebooted}=False
    Dated Log                       Start Restart TL ${TLConfig.configName}. Is GNB Cloud: ${TLConfig.isGnbCloud}
    ...                             first=True
    Private Restart Gnb Classical           GNBCallback=${GNBCallback}          APCallback=${APCallback}
    ...                             isOAMRebooted=${isOAMRebooted}


reset TL if BTS not OnAir
    [Arguments]  ${connection}=${GNB_DU.oam}
    ${aliasGNB}                     OAM Connect                             ${connection}
    ${bts_status}=  coam.get_bts_statuses   connection=${connection.httpAlias}
    OAM Disconnect                  ${GNB_DU.oam}
    Dated log     BTS procedural state is now: ${bts_status["proceduralState"]}
    Run Keyword If  '${bts_status["proceduralState"]}'!='OnAir' and '${bts_status["proceduralState"]}'!='Configured'
    ...          Run Keywords       Log To Console  \n BTS procedural state is now: ${bts_status["proceduralState"]} ==> Reset TL     AND
    ...                             Restart TL wo WTS clear     AND
    ...                             run keyword and ignore error        Start WTS        egate_alias_default   AND
    ...                             run keyword and ignore error        X2Ap link Setup     egate_alias_default


Get gNB cell 5g On air
    [Documentation]       get gNB 5g cell On air
    Return From Keyword If    "${WAIT_5G_CELL_ONAIR}" == "0"
    Log to Console like Next Step     0     Get gNB 5g cell OnAir
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=  coam.get_bts_statuses   connection=${GNB_DU.oam.httpAlias}
    OAM Disconnect                  ${GNB_DU.oam}
    Log To Console  \n BTS procedural state is now: ${bts_status["proceduralState"]}
    Return From Keyword If    '${bts_status["proceduralState"]}'=='OnAir' or '${bts_status["proceduralState"]}'=='Configured'
    run keyword and ignore error        Start WTS        egate_alias_default
    run keyword and ignore error        X2Ap link Setup     egate_alias_default
    run keyword and ignore error        wait until keyword succeeds    2min    30s      Check BTS status in WEM for cOAM
    Dated log new line         =======> Restart TL if needed to get Cell Is OnAir/Configured
    run keyword and ignore error        reset TL if BTS not OnAir
    run keyword and ignore error        wait until keyword succeeds    5min    30s      Check BTS status in WEM for cOAM

Print My Constants version
    [Documentation]   Print to Console Constants.py version
    run Keyword    MyConstants.hello

Get Mem Usage for 1745
  [Documentation]     Get Mem Usage for 1745
  ...                 w_Get_Mem_Usage is a global variable
  [Arguments]         ${period}=before
  return from Keyword if     '${w_Get_Mem_Usage}' == 'False'
  dated log    Get Mem Usage during period=${period}
  ${aliasGNB_2}=   common_Dss_Keywords.Connect to gNB Common Unit     gnb_id=0    du_id=0     comu_id=0
  set Test Variable       ${aliasGNB_2}
  robot_extension.Run Keyword And Warn On Failure     common_Dss_Keywords.Get Mem Usage      board_id=1
  ...                                                 period=${period}
  ...                                                 connection=${aliasGNB_2}
  robot_extension.Run Keyword And Warn On Failure     ssh.disconnect      connection=${aliasGNB_2}



