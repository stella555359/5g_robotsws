*** Variables ***

${gnb_alias}                        gnb_under_test

${trcColor}                         Evaluate    "${CYAN}"
${defColor}                         Evaluate    "${NORMAL}"
${OkColor}                          Evaluate    "${GREEN}"

*** Keywords ***

CB012207_Update_SCF
    [Documentation]               Dedicated KW to apply a delta commissioning file.
    ...                           It performs delta commissioning and waits until gNB is up again
    ...                           (in case of RAT reset is needed for example)
    [Arguments]                   ${delta_file}

    # Open connection towards cOAM
    sbts_coam.connect_to          name=${gnb_alias}

    # Apply delta scf
    coam_parameter.perform_scf_delta_commission
    ...                           delta_file=${delta_file}
    ...                           connection=${gnb_alias}
    ...                           timeout=300
    ...                           skip_parameter_relation_errors=True

    OAM wait available

    sbts_coam.teardown            connection=${gnb_alias}


CB012207 Build UE List
    [Arguments]            ${SA_UE_List}    ${nb_UEs}
    # Build UE list
    FOR        ${ue_id}      IN RANGE        1        ${nb_UEs} + 1
        &{ue_in_list}=                  Copy dictionary     ${BASIC_UE_SA}
        Set To Dictionary               ${ue_in_list}       ue          ${ue_id}
        Set To Dictionary               ${ue_in_list}       pdu         1
        Append To List                  ${SA_UE_List}       ${ue_in_list}
    END

CB012207 Attach_all_UEs
    [Arguments]            ${SA_UE_List}
    FOR        ${current_ue}            IN         @{SA_UE_List}
        UE Register                     ue=${current_ue.ue}
        Launch PDU Session              ue=${current_ue.ue}    pdu=${current_ue.pdu}    gw=${current_ue.ue}
    END

CB012207 Detach_all_UEs
    [Arguments]            ${SA_UE_List}
    FOR        ${current_ue}            IN         @{SA_UE_List}
        UE Deregister                   id=${current_ue.ue}
    END

Check SRS receive
    [Documentation]     KW used to check if SRS is well handled by gNB in case of FR2 SA as
    ...                 slot including SRS have a specific SLIV value.
    ...                 It triggerd a TTI trace and looks for SRS messages inside it.
    ...                 However, SRS is only triggered in case of RANK 1 UL transmissions
    ...                 So, as a first test, an AP test mode is used to add UL correlation
    ...                 and fallback to rank 1 during TTI trace capture

    wtsemu.ul_mimo_switch_nr                profile_id=1
    ...                                     pusch_tx_mix_ratio=100

    # Trigger SRS reports by moving to rank1
    wtsemu.ue_testmode_set_nr               id=1
    ...                                     testmode=ul_mimo_switch_nr
    ...                                     profile_id=1
    ...                                     action=activate

    # Capture TTI trace
    # TTI capture configuration
    ${TTIdir}                     Get TTI Trace Path                 dir_suffix=CB012207_FR2_SA_UL

    Start TTI Traces in Streaming mode    src_ip=10.0.1.2

    Traced Sleep                  1 seconds               msg=TTI traffic capture

    # stop TTI capture
    ${TTIpcap}                    Stop TTI Traces in Streaming mode
    ...                           tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTITrace_D_IWK10_TC5

    Dated Log New Line            === Convert TTItrace to json and csv ===
    ${TTIjson}                    Convert TTItrace from pcap to others      input_file_path=${TTIpcap}
    &{events_list}=               gettti_events          ${TTIjson}

    ${srs_event_list}=            Set Variable       ${events_list}[ulSrsReceiveRespPsData]

    # Check there are SRS reports
    Should Not Be Empty         ${srs_event_list}
    # Parse L2PS events and just check that SRS is received with a good SNR.
    # The check is just intended to verify that SRS works fine in case of 15 MHz.
    FOR     ${srs_event}    IN      @{srs_event_list}
        Should be True               ${srs_event}[snr] > 35
    END

    # Disable AP test mode
    wtsemu.ue_testmode_set_nr               id=1
    ...                                     testmode=ul_mimo_switch_nr
    ...                                     profile_id=1
    ...                                     action=deactivate

Check additional DMRS UL RRC Config
    [Documentation]     KW used to check RRC UL configuration regarding PTRS and additional DMRS

    # Backup of egate_console.log file:
    ${current_date}=                    DateTime.Get Current Date       result_format=%Y%m%d-%H%M%S
    ${filename}                         Set Variable                    ${current_date}_egate_console_Check_UL_Add_DMRS.log
    ${cmd}                              Catenate
    ...                                 cd ${tl.core.dir_path};
    ...                                 cp ${tl.core.dir_path}/egate_console.log ${LOG_PATH}/${filename}
    SSH Wait For Connect and Cmd
    ...                                 command=${cmd}
    ...                                 host=${HOST_EPCSIM}

    ${rrc_status}                       Check_RRC_Config             UL    ${LOG_PATH}/${filename}
    Should Be True                      ${rrc_status} == True

Check additional DMRS DL RRC Config
    [Documentation]     KW used to check RRC DL configuration regarding PTRS and additional DMRS

    # Backup of egate_console.log file:
    ${current_date}=                    DateTime.Get Current Date       result_format=%Y%m%d-%H%M%S
    ${filename}                         Set Variable                    ${current_date}_egate_console_Check_DL_Add_DMRS.log
    ${cmd}                              Catenate
    ...                                 cd ${tl.core.dir_path};
    ...                                 cp ${tl.core.dir_path}/egate_console.log ${LOG_PATH}/${filename}
    SSH Wait For Connect and Cmd
    ...                                 command=${cmd}
    ...                                 host=${HOST_EPCSIM}

    ${rrc_status}                       Check_RRC_Config             DL     ${LOG_PATH}/${filename}
    Should Be True                      ${rrc_status} == True