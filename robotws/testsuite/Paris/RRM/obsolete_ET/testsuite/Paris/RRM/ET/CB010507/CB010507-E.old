*** Settings ***
Documentation       [SUITE PURPOSE] CB010507-E IWK102
...                 Aim of this test is to check that n78 UE can traffic on n77 extended band cell on 
...                 the BWP included in the legacy part of n77
...                 This is scope of canadian bands
...                 Test Case Scenario author   : axel.gouilly-frossard@nokia.com
...                 Test Case Scenario contact  : axel.gouilly-frossard@nokia.com
...                 Creation Date               : 24/05/2024


# Resources
#Resource                                        ./resources/robot/CB009915-A-Keywords.robot
Resource                                        ../../../resources/SWENG/robot/WtsCfgConfig.robot
#Resource                                        ../../../resources/SWENG/robot/Syslogs.robot
#Resource                                        ../../../resources/SWENG/robot/Hardening.robot
#Library                                         Dialogs

# Tags
#Force Tags                                      CA_5G_SW_FR-Villarceaux    RRM    PY36
...                                             CLOUD_5G_I_LO_AP_LO_SANSA_FS_ECPRI_CMWV_TDD
...                                             master_classicalbts_all    SBTS00
...                                             CONFIGURED    5G_RAN    RAN_5G    CRT

# Suites
#Suite Setup                                     CB009915-Common-Keywords.Suite Setup CB009915-Common    keep_all_data_in_file=${True}
Suite Setup                         Suite Setup from scratch            listBackupFiles=${FD_ALL}
...                                                                     keepAllUeDataInCfgFile=${True}
#Suite Teardown                                  CB009915-Common-Keywords.Suite Teardown CB009915-Common
Suite Teardown                                  Suite Teardown


*** Variables ***

# capture setting
&{CAPTURE_OFF}                                  is_capture_core=${False}
...                                             is_capture_cprt=${False}
...                                             is_capture_l1l2=${False}

&{CAPTURE_INVES}                                is_capture_core=${False}
...                                             is_capture_cprt=${False}
...                                             is_capture_l1l2=${False}

&{CAPTURE_L1L2}                                 is_capture_core=${False}
...                                             is_capture_cprt=${False}
...                                             is_capture_l1l2=${True}

# tests settings
&{CB009915-A}                                   capture_duration=0                      # capture duration during traffic starting phase
...                                             deviation=10                            # default deviation for throughput and double for uplink
...                                             dir=UL+DL
...                                             duration=3                              # traffic duration during declaration phase
...                                             pm_waiting_period=2                     # number of waiting periods added for observation
...                                             target_gnb=2                            # gnb target id
...                                             total_nb_cell=2                         # total number of cell used for ue's dispatching
...                                             total_nb_ue=0                           # total number of ue's to configure

&{dict_settings_ue_1}                           nsa_bearer=2
...                                             original_cell=1                         # original cell for call establishment
...                                             throughput=600                          # dl throughput nonGBR max for ue in chBW=100Hz wo/ blanking
...                                             throughput_gbr=${NO_THROUGHPUT}         # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                             throughput_ul=150                       # ul throughput nonGBR max for ue in chBW=100MHz wo/ blanking

&{dict_settings_ue_2}                           nsa_bearer=2
...                                             original_cell=1
...                                             throughput=600
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=150

@{dict_settings_single_ue}                      ${dict_settings_ue_1}

#


# First UE id for FDD cell (cell3) with variant SANSA_FS_CPRI_CMWV_FDD+ECPRI_CMWV_TDD_AEQE
${ue_id_base_cell}                         1

${traffic_duration}                         10s

${scf_delta_config_9915_robustness}         testsuite/Paris/RRM/ET/CB009915/resources/config/Delta_scf_CB009915_AA_Robustness.json


${nbRobustnessUEs}                          1
@{SA_UE_List}

${trcColor}                                 Evaluate    "${CYAN}"
${defColor}                                 Evaluate    "${NORMAL}"
${OkColor}                                  Evaluate    "${GREEN}"

${gnb_alias}                      gnb_under_test

*** Keywords ***

CB009915 Robustness Test Setup
    [Documentation]             Perform needed actions at the begining of a test case
    Init Trace color

CB009915 Robustness Test Teardown
    [Documentation]             Perform needed actions at the end of a test case
    
    #dialogs.Execute Manual Step       wait keyboard
    Restore Files               listFileDesc=${FD_ALL}
    # "Test Teardown" KW from Setup.robot
    Test Teardown

Init Trace color
    ${trcColor}                 Evaluate    "${CYAN}"
    ${defColor}                 Evaluate    "${NORMAL}"
    ${OkColor}                  Evaluate    "${GREEN}"
    Set Suite Variable          ${trcColor}
    Set Suite Variable          ${defColor}
    Set Suite Variable          ${OkColor}

CB009915_Robustness_Configuration
    [Documentation]               Dedicated KW to add use a delta commissioning file
    ...                           2 cells in TDD 100 MHz (cell1/cell2)
    
    [Arguments]                   ${pooling_delta_file}     ${gnb_alias}

    # Open connection towards cOAM
    sbts_coam.connect_to          name=${gnb_alias}

    Dated Log New Line          delta_file=${scf_delta_config_9915_robustness}  
    # Apply delta scf
    coam_parameter.perform_scf_delta_commission      
    ...                           delta_file=${scf_delta_config_9915_robustness}    
    ...                           connection=${gnb_alias}
   
    #dialogs.Execute Manual Step       wait keyboard
    OAM wait available

    sbts_coam.teardown            connection=${gnb_alias}

