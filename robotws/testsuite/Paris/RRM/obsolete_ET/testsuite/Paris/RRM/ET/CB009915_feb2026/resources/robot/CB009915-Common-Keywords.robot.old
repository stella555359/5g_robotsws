    Set To Dictionary                           ${current_ue_setting}    trf_id    ${current_trf_id}
    Set To Dictionary                           ${current_ue_setting}    qfi    3
    Traffic UE UL                               ueSetting=${current_ue_setting}
    ...                                         throughput=${current_ue_setting.throughput_gbr}
