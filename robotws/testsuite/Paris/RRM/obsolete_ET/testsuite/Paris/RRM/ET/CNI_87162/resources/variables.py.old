CELLS_ENBx1_GNBx2 = {1: [1], 2: [1, 2]}
CELLS_ENBx1_GNBx4 = {1: [1], 2: [1, 2, 3, 4]}
CELLS_ENBx1_GNBx6 = {1: [1], 2: [1, 2, 3, 4, 5, 6]}
