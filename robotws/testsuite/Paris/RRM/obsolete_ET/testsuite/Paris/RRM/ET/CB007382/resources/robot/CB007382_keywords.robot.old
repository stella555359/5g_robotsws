*** Keywords ***

    # Start Keyword for TCs

CB007382_TDD_test_model_for_power_measurement
    [Arguments]           ${param}     ${freq}     ${feat}     ${load}
    [Documentation]       Test Model for power measurement

    Set Suite Variable    ${param}
    Init Sequence         ${param}

    Set Suite Variable    ${freq}
    Set Suite Variable    ${feat}

    Step                   Test Line Preparation                              argument=${param}

    Critical Step          Activate Test dedicated Mode                       depends=Test Line Preparation
    Step                   Start 5g downlink test                             argument=${load}              depends=Activate Test dedicated Mode
    Step                   Check CpRtCm_StartConformanceTestReq parameters    argument=${CAPTURE_CPRT}      depends=Start 5g downlink test
    Run Keyword If         '${test_mode.load_type}'=='flatLoad'
    ...            Step    Check TM for power measurement flat load           argument=${CAPTURE_GNB}       depends=Start 5g downlink test
    ...    ELSE    Step    Check TM for power mesurement burst load           argument=${CAPTURE_GNB}       depends=Start 5g downlink test

    [Teardown]            Teardown TC

Start 5g downlink test
    [Documentation]         Prepare capture CPRT and gNB, start and stop downlink Test
    [Arguments]             ${test_mode}

    Set Suite Variable      ${test_mode}

    ${CAPTURE_CPRT.prefix}    Set Variable If
    ...    '${test_mode.load_type}'=='flatLoad'    Cprt${test_mode.load_level_flat}    Cprt${test_mode.load_level_burst}

    ${CAPTURE_GNB.prefix}     Set Variable If
    ...    '${test_mode.load_type}'=='flatLoad'    gNB${test_mode.load_level_flat}     gNB${test_mode.load_level_burst}

    Dated log               Cprt capture prefix: ${CAPTURE_CPRT.prefix} & Gnb capture prefix: ${CAPTURE_GNB.prefix}

    Start Capture CPRT      ${CAPTURE_CPRT}
    Start Capture GNB       ${CAPTURE_GNB}

    run keyword if          '${test_mode.load_type}'=='flatLoad'
    ...                     Start 5g downlink test flat Load     ${test_mode}
    ...    ELSE             Start 5g downlink test Burst Load    ${test_mode}

    Traced Sleep   2        msg=CPRT and BIP L1L2 logs capture is ongoing

    Run Keyword And Ignore Error    Stop 5g downlink Test

    Stop Capture            ${CAPTURE_GNB}
    Stop Capture            ${CAPTURE_CPRT}

Check TM for power mesurement burst load
    [Documentation]    KW's purpose is to check burst load
    [Arguments]     ${BIP_L1L2}

    ${SymbolsPer5ms}        Evaluate        104
    ${level}                Evaluate        float(${test_mode.burstlevel})
    ${TotalPdschSlots}      set variable    ${test_mode.NumOfPdschSlots}
    ${sum}                  Evaluate        0

    Set Suite Variable      ${SymbolsPer5ms}
    Set Suite Variable      ${sum}
    Set Suite Variable      ${level}
    Set Suite Variable      ${TotalPdschSlots}

    Dated log               Convert pcap to pdml file [pdschsendreq filtered]...

    ${pcapFiltered}         analyzer.filter_pcap
    ...                     pcapInFile=${BIP_L1L2.path}
    ...                     filterName=dldata_pdschsendreq
    ...                     filterExp=(dldata_pdschsendreq)&&(3gpp.rnti==0)

    ${pdml}=                analyzer.pcap_to_pdml    ${pcapFiltered}

    @{ListOfPdschSendReqIEs}        Create List      slot       numOfPdschSymbols

    @{lisOfPdschSendReq}    Get Packet Match List
    ...                     pdmlFile=${pdml}
    ...                     packetName=dldata_pdschsendreq
    ...                     pathList=@{ListOfPdschSendReqIEs}
    ...                     startPacket=${1}
    ...                     endPacket=${TotalPdschSlots}

    ${lenPdschSendReq}      get length          ${lisOfPdschSendReq}
    Dated Log New Line      Total number of PdschSendReq msgs: ${lenPdschSendReq}
    should be true          ${lenPdschSendReq}!=0

    FOR     ${packet}       IN      @{lisOfPdschSendReq}
            ${numOfPdschSymbols}    Get Value In Packet Match
            ...                     packetMatch=${packet}
            ...                     field=numOfPdschSymbols
            ${numOfPdschSymbols}    Convert To Integer    ${numOfPdschSymbols}
            ${sum}                  Evaluate              ${sum}+${numOfPdschSymbols}
    END

    Dated log           Sum of "numOfPdschSymbols": ${sum}

    ${EstimatedLoad}    Evaluate             (round(${sum})*100)/round(${SymbolsPer5ms})

    Dated log           Estimated burst load from Bip L1L2 capture: ${EstimatedLoad}

    ${EstimatedLoad}    Convert to Number    ${EstimatedLoad}       1

    Dated log           Estimated burst load from Bip L1L2 capture: ${EstimatedLoad}

    Dated log           Estimated load ${EstimatedLoad} should be equal to : ${test_mode.burstlevel}

    should be true      ${EstimatedLoad}==${level}


Check TM for power measurement flat load
    [Documentation]   This KWs aims to check BIP L1L2 logs for subfeature A-B-C and flat load level
    [Arguments]     ${CAPTURE_GNB}

    #Subfeature A
    run Keyword If       '${feat}'=='A' and '${test_mode.load_level_flat}'=='low'      run keywords
    ...     Dated Log       Check SIB1 IEs for CB007382-${feat} and load level=${test_mode.load_level_flat}
    ...     AND             Check SIB1 IEs    ${CAPTURE_GNB}

    run Keyword If      '${feat}'=='A' and '${test_mode.load_level_flat}'!='low'
    ...    run keywords    Check PdschSendReq IEs - Subfeature A    ${CAPTURE_GNB}
    ...    AND             Check PDCCH IEs    ${CAPTURE_GNB}

    #Subfeature B
    run Keyword If      '${feat}'=='B' and '${test_mode.load_level_flat}'=='low'      run keywords
    ...     Dated Log       Check SIB1 IEs for CB007382-${feat} and load level=${test_mode.load_level_flat}
    ...     AND             Check SIB1 IEs    ${CAPTURE_GNB}

    run Keyword If      '${feat}'=='B' and '${test_mode.load_level_flat}'!='low'
    ...    run keywords    Check PdschSendReq IEs - Subfeature B    ${CAPTURE_GNB}
    ...    AND             Check PDCCH IEs    ${CAPTURE_GNB}

    #Subfeature C
    run Keyword If      '${feat}'=='C' and '${test_mode.load_level_flat}'=='low'
    ...                    Check SIB1 IEs    ${CAPTURE_GNB}

    run Keyword If      '${feat}'=='C' and '${test_mode.load_level_flat}'!='low'
    ...    run keywords    Check PdschSendReq IEs - Subfeature C    ${CAPTURE_GNB}
    ...    AND             Check PDCCH IEs    ${CAPTURE_GNB}


Check CpRtCm_StartConformanceTestReq parameters
    [Documentation]
    ...     Check CpRtCm_StartConformanceTestReq parameters
    ...    -testModel: Indicate which test model for the testing (TM1_1_ETSI)
    ...    -loadType:
    ...     a) flatLoad is equally distributed in time and the used bandwidth is constant (CB007382-A-B-C)
    ...     b) burstLoad indicate concentrated load in time and uses the full bandwidth (CB007382-D)
    ...    -loadLevelFlat (CB007382-A-B-C): Indicate the used traffic load levels. Low load (0%), medium load (30%,
    ...     busy load (50%) and full load (100%)
    ...    -loadLevelBurst (CB007382-D), Indicate the used traffic load levels. The load levels are for RF thermal
    ...     heat measurements with burst load type. enum {burst_13_5; burst_19_2; burst_32_7; burst_46_2;
    ...     burst_59_6; burst_73_1; burst_86_5; burst_100}
    ...    -numOfSsbBeamPatternId: This number is only valid for loadLevelFlat=low and loadType=flatLoad.
    ...     4 for FR1≤3GHz; 8 for 3 GHz < FR1 ≤ 6 GHz and 32 for FR2
    ...    -ssbBeamPatternId: This number is only valid for loadLevelFlat=low and loadType=flatLoad. The beam
    ...     pattern ID used for SSB during the power measurement.

    [Arguments]         ${CAPTURE_CPRT}

    ${CB007382_TestModel}    set variable    TM1_1_ETSI

    Dated Log       Capture_CPRT_path ${CAPTURE_CPRT.path}  ${CAPTURE_CPRT}

    ${pdmlFileCprt}     analyzer.pcap_to_pdml       ${CAPTURE_CPRT.path}

    Dated Log       Check CpRtCm_StartConformanceTestReq parameters

    @{msg_field}    Create List     testModel
    ...                             loadType
    ...                             numOfSsbBeamPatternId
    ...                             loadLevelFlat
    ...                             loadLevelBurst

    @{listPacketMatch}              Get Packet Match List
    ...                             pdmlFile=${pdmlFileCprt}
    ...                             packetName=itf_l2_ps_tm_cell_startconformancetestreq_t
    ...                             pathList=@{msg_field}

    ${packet}                       set variable                  ${listPacketMatch[0]}

    ${testModel}                    Get Value In Packet Match
    ...                             ${packet}
    ...                             field=testModel
    ...                             kind=showname

    Should contain                  ${testModel}        ${CB007382_TestModel}

    ${loadLevelFlat}                Get Value In Packet Match
    ...                             ${packet}
    ...                             field=loadLevelFlat
    ...                             kind=showname

    ${loadLevelBurst}               Get Value In Packet Match
    ...                             ${packet}
    ...                             field=loadLevelBurst
    ...                             kind=showname

    Run Keyword If    '${test_mode.load_type}'=='flatLoad'
    ...                Should contain    ${loadLevelFlat}     ${test_mode.load_level_flat}
    ...        ELSE    Should contain    ${loadLevelBurst}    ${test_mode.load_level_burst}



Check PDCCH IEs
    [Documentation]     Check PDCCH IEs
    [Arguments]         ${BIP_L1L2}

    ${pcapFiltered}          analyzer.filter_pcap
    ...                      pcapInFile=${BIP_L1L2.path}
    ...                      filterName=dldata_pdcchsendreq
    ...                      filterExp=(dldata_pdcchsendreq)&&(3gpp.rnti==0)

    ${pdml}=                 analyzer.pcap_to_pdml         ${pcapFiltered}

    @{ListOfPdcchSendReqIEs}           Create List      beamId        rnti      startSymbolNumber     numOfSymbols
    ...     startCce    aggregationLevel    dmrsReferencePoint     dmrsScramblingSequenceInt    pdcchDciTransmitPower
    ...     dciSize     coresetFreqDomain       cceRegMappingType      regBundleSize     precoderGranularity
    ...     coresetFreqDomainRbShift    pdcchPrecodingOption4x4    polarizationSelection

    @{lisOfPdcchSendReq}            Get Packet Match List
    ...                             pdmlFile=${pdml}
    ...                             packetName=dldata_pdcchsendreq
    ...                             pathList=@{ListOfPdcchSendReqIEs}
    ...                             startPacket=${1}
    ...                             endPacket=${16}

    ${lenPdcchSendReq}              get length          ${lisOfPdcchSendReq}
    Dated Log New Line              Total number of PdcchSendReq msgs: ${lenPdcchSendReq}
    should be true                  ${lenPdcchSendReq}!=0

    Dated Log  =====> Start check PDCCH IEs

    #Check PDCCH IEs
    FOR    ${packet}   IN           @{lisOfPdcchSendReq}
           #beamId
           ${beamId}                Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=beamId
           should be true           ${beamId}==0
           #rnti
           ${rnti}                  Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=rnti
           should be true           ${rnti}==0
           #startSymbolNumber
           ${startSymbolNumber}     Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startSymbolNumber
           should be true           ${startSymbolNumber}==0
           #numOfSymbols
           ${numOfSymbols}          Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=numOfSymbols
           should be true           ${numOfSymbols}==2
           #startCce
           ${startCce}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startCce
           should be true           ${startCce}==0
           #aggregationLevel
           ${aggregationLevel}      Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=aggregationLevel
           should be true           ${aggregationLevel}==1
           #dmrsReferencePoint
           ${dmrsReferencePoint}    Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=dmrsReferencePoint
           should be true           ${dmrsReferencePoint}==0
           #dmrsScramblingSequenceInt
           ${dmrsScramblingSequenceInt}     Get Value In Packet Match
           ...                              packetMatch=${packet}
           ...                              field=dmrsScramblingSequenceInt
           should be true                   ${dmrsScramblingSequenceInt}==50
           #pdcchDciTransmitPower
           ${pdcchDciTransmitPower}     Get Value In Packet Match
           ...                          packetMatch=${packet}
           ...                          field=pdcchDciTransmitPower
           run Keyword If    '${feat}'=='A'    should be true       ${pdcchDciTransmitPower}==-352
           ...    ELSE IF    '${feat}'=='B'    should be true       ${pdcchDciTransmitPower}==-279
           ...    ELSE                         should be true       ${pdcchDciTransmitPower}==-290
           #dciSize
           ${dciSize}               Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=dciSize
           should be true           ${dciSize}==48
           #coresetFreqDomain
           ${coresetFreqDomain}     Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=coresetFreqDomain
           should be true           ${coresetFreqDomain}==9223372036854775808
           #cceRegMappingType
           ${cceRegMappingType}     Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=cceRegMappingType
           should be true           ${cceRegMappingType}==1
           #regBundleSize
           ${regBundleSize}         Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=regBundleSize
           should be true           ${regBundleSize}==6
           #precoderGranularity
           ${precoderGranularity}   Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=precoderGranularity
           should be true           ${precoderGranularity}==0
           #coresetFreqDomainRbShift
           ${coresetFreqDomainRbShift}      Get Value In Packet Match
           ...                              packetMatch=${packet}
           ...                              field=coresetFreqDomainRbShift
           should be true                   ${coresetFreqDomainRbShift}==0
           #pdcchPrecodingOption4x4
           ${pdcchPrecodingOption4x4}       Get Value In Packet Match
           ...                              packetMatch=${packet}
           ...                              field=pdcchPrecodingOption4x4
           should be true                   ${pdcchPrecodingOption4x4}==0
           #polarizationSelection
           ${polarizationSelection}         Get Value In Packet Match
           ...                              packetMatch=${packet}
           ...                              field=polarizationSelection
           should be true                   ${polarizationSelection}==0
    END

Check SIB1 IEs
    [Documentation]     Check SIB1 IE - low load level
    [Arguments]         ${BIP_L1L2}

    ${pcapFiltered}          analyzer.filter_pcap          ${BIP_L1L2.path}
    ...                      filterName=dldata_pdschsendreq
    ...                      filterExp=(dldata_pdschsendreq)&&(3gpp.rnti==65535)

    ${pdml}=                 analyzer.pcap_to_pdml         ${pcapFiltered}

    @{ListOfPdschSendReqIEs}        Create List             rnti            mcs             mcsTable        startSymbol
    ...                             numOfPdschSymbols       startPrb        numOfPrb        rat0Bitmap
    ...                             pdschTbTransmitPower    modulationOrder

    @{lisOfPdschSendReq}            Get Packet Match List
    ...                             pdmlFile=${pdml}
    ...                             packetName=dldata_pdschsendreq
    ...                             pathList=@{ListOfPdschSendReqIEs}
    ...                             startPacket=${1}
    ...                             endPacket=${16}

    #Dated Log  =====> Start check SIB1 IEs

    #Check SIB1 IEs
    FOR    ${packet}   IN           @{lisOfPdschSendReq}
           #rnti
           ${rnti}                  Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=rnti
           should be true           ${rnti}==65535
           #mcs
           ${mcs}                   Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=mcs
           should be true           ${mcs}==0
           #mcsTable
           ${mcsTable}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=mcsTable
           run Keyword If           '${freq}'=='FR1'    should be true       ${mcsTable}==1
           ...                                  ELSE         should be true       ${mcsTable}==0
           #startSymbol
           ${startSymbol}           Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startSymbol
           should be true           ${startSymbol}==0
          # numOfPdschSymbols
           ${numOfPdschSymbols}     Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=numOfPdschSymbols
           should be true           ${numOfPdschSymbols}==14
           #startPrb
           ${startPrb}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startPrb
           run Keyword If           '${feat}'=='A'    should be true       ${startPrb}==270
           ...    ELSE IF           '${feat}'=='B'    should be true       ${startPrb}==48
           ...    ELSE                                should be true       ${startPrb}==63
           #numOfPrb
           ${numOfPrb}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=numOfPrb
           should be true           ${numOfPrb}==3
           #rat0Bitmapny
           ${rat0Bitmap}            Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=rat0Bitmap
           should be true           ${rat0Bitmap}==0
           #pdschTbTransmitPower
           ${pdschTbTransmitPower}  Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=pdschTbTransmitPower
           run Keyword If           '${feat}'=='A'    should be true       ${pdschTbTransmitPower}==-352
           ...    ELSE IF           '${feat}'=='B'    should be true       ${pdschTbTransmitPower}==-279
           ...    ELSE                                should be true       ${pdschTbTransmitPower}==-290
           #modulationOrder
           ${modulationOrder}       Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=modulationOrder
           should be true           ${modulationOrder}==2
    END

Check PdschSendReq IEs - Subfeature A
    [Documentation]     Check PdschSendReq IEs for UE1 (rnti=0) and UE2 (rnti=2) - Subfeature A
    [Arguments]         ${BIP_L1L2}

    ${load_level}            set variable    ${test_mode.load_level_flat}

    ${pcapFiltered_rnti0}           analyzer.filter_pcap
    ...                             pcapInFile=${BIP_L1L2.path}
    ...                             filterName=dldata_pdschsendreq_ue1
    ...                             filterExp=(dldata_pdschsendreq)&&(3gpp.rnti==0)

    ${pdml_rnti0}=                  analyzer.pcap_to_pdml         ${pcapFiltered_rnti0}

    @{ListOfPdschSendReqIEs}        Create List     rnti          mcs             mcsTable      startSymbol
    ...                             numOfPdschSymbols       startPrb        numOfPrb            rat0Bitmap
    ...                             pdschTbTransmitPower    modulationOrder

    @{lisOfPdschSendReq_rnti0}      Get Packet Match List
    ...                             pdmlFile=${pdml_rnti0}
    ...                             packetName=dldata_pdschsendreq
    ...                             pathList=@{ListOfPdschSendReqIEs}
    ...                             startPacket=${1}
    ...                             endPacket=${16}


    Dated Log  =====> Start check PdschSendReq IEs for UE1 (rnti=0)

    #Check PdschSendReq IEs for UE1 (rnti=0)
    FOR    ${packet}   IN           @{lisOfPdschSendReq_rnti0}
           #rnti
           ${rnti}                  Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=rnti
           should be true           ${rnti}==0
           #mcs
           ${mcs}                   Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=mcs
           should be true           ${mcs}==0
           #mcsTable
           ${mcsTable}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=mcsTable
           should be true           ${mcsTable}==1
           #startSymbol
           ${startSymbol}           Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startSymbol
           should be true           ${startSymbol}==0
          # numOfPdschSymbols
           ${numOfPdschSymbols}     Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=numOfPdschSymbols
           should Contain Any       ${numOfPdschSymbols}    14      6
           #startPrb
           ${startPrb}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startPrb
           should be true           ${startPrb}==3
           #numOfPrb
           ${numOfPrb}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=numOfPrb
           run Keyword If           '${load_level}'=='medium'    should Contain Any    ${numOfPrb}    104    81    84
           ...    ELSE IF           '${load_level}'=='busy'      should Contain Any    ${numOfPrb}    147    124    138    135
           ...    ELSE                                           should be true        ${numOfPrb}==270
           #rat0Bitmapny
           ${rat0Bitmap}            Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=rat0Bitmap
           should be true           ${rat0Bitmap}==0
           #pdschTbTransmitPower
           ${pdschTbTransmitPower}  Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=pdschTbTransmitPower
           should be true           ${pdschTbTransmitPower}==-352
           #modulationOrder
           ${modulationOrder}       Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=modulationOrder
           should be true           ${modulationOrder}==2
    END

    ${pcapFiltered_rnti2}           analyzer.filter_pcap
    ...                             pcapInFile=${BIP_L1L2.path}
    ...                             filterName=dldata_pdschsendreq_ue2
    ...                             filterExp=(dldata_pdschsendreq)&&(3gpp.rnti==2)

    ${pdml_rnti2}=                  analyzer.pcap_to_pdml         ${pcapFiltered_rnti2}

    @{lisOfPdschSendReq_rnti2}      Get Packet Match List
    ...                             pdmlFile=${pdml_rnti2}
    ...                             packetName=dldata_pdschsendreq
    ...                             pathList=@{ListOfPdschSendReqIEs}
    ...                             startPacket=${1}
    ...                             endPacket=${16}

    Dated Log  =====> Start check PdschSendReq IEs for UE2 (rnti=2)

    #Check PdschSendReq IEs for UE2 (rnti=2)
    FOR    ${packet}   IN           @{lisOfPdschSendReq_rnti2}
           #rnti
           ${rnti}                  Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=rnti
           should be true           ${rnti}==2
           #mcs
           ${mcs}                   Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=mcs
           should be true           ${mcs}==0
           #mcsTable
           ${mcsTable}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=mcsTable
           should be true           ${mcsTable}==1
           #startSymbol
           ${startSymbol}           Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startSymbol
           should be true           ${startSymbol}==2
          # numOfPdschSymbols
           ${numOfPdschSymbols}     Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=numOfPdschSymbols
           should Contain Any       ${numOfPdschSymbols}    12      4
           #startPrb
           ${startPrb}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startPrb
           should be true           ${startPrb}==0
           #numOfPrb
           ${numOfPrb}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=numOfPrb
           run Keyword If           '${load_level}'=='medium'    should be true    ${numOfPrb}==1
           ...    ELSE IF           '${load_level}'=='busy'      should be true    ${numOfPrb}==2
           ...    ELSE                                           should be true    ${numOfPrb}==3
           #rat0Bitmapny
           ${rat0Bitmap}            Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=rat0Bitmap
           should be true           ${rat0Bitmap}==0
           #pdschTbTransmitPower
           ${pdschTbTransmitPower}  Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=pdschTbTransmitPower
           should be true           ${pdschTbTransmitPower}==-352
           #modulationOrder
           ${modulationOrder}       Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=modulationOrder
           should be true           ${modulationOrder}==2
    END

Check PdschSendReq IEs - Subfeature B
    [Documentation]     Check PdschSendReq IEs for UE1 (rnti=0) and UE2 (rnti=2) - Subfeature B
    [Arguments]         ${BIP_L1L2}

    ${load_level}            set variable    ${test_mode.load_level_flat}

    ${pcapFiltered_rnti0}           analyzer.filter_pcap
    ...                             pcapInFile=${BIP_L1L2.path}
    ...                             filterName=dldata_pdschsendreq_ue1
    ...                             filterExp=(dldata_pdschsendreq)&&(3gpp.rnti==0)

    ${pdml_rnti0}=                  analyzer.pcap_to_pdml         ${pcapFiltered_rnti0}

    ${pcapFiltered_rnti2}           analyzer.filter_pcap
    ...                             pcapInFile=${BIP_L1L2.path}
    ...                             filterName=dldata_pdschsendreq_ue2
    ...                             filterExp=(dldata_pdschsendreq)&&(3gpp.rnti==2)

    ${pdml_rnti2}=                  analyzer.pcap_to_pdml         ${pcapFiltered_rnti2}

    @{ListOfPdschSendReqIEs}        Create List     rnti        mcs         mcsTable            startSymbol
    ...                             numOfPdschSymbols       startPrb        numOfPrb            rat0Bitmap
    ...                             pdschTbTransmitPower    modulationOrder

    @{lisOfPdschSendReq_rnti0}      Get Packet Match List
    ...                             pdmlFile=${pdml_rnti0}
    ...                             packetName=dldata_pdschsendreq
    ...                             pathList=@{ListOfPdschSendReqIEs}
    ...                             startPacket=${1}
    ...                             endPacket=${16}

    @{lisOfPdschSendReq_rnti2}      Get Packet Match List
    ...                             pdmlFile=${pdml_rnti2}
    ...                             packetName=dldata_pdschsendreq
    ...                             pathList=@{ListOfPdschSendReqIEs}
    ...                             startPacket=${1}
    ...                             endPacket=${16}

    Dated Log  =====> Start check PdschSendReq IEs for UE1 (rnti=0)

    #Check PdschSendReq IEs for UE1 (rnti=0)
    FOR    ${packet}   IN           @{lisOfPdschSendReq_rnti0}
           #rnti
           ${rnti}                  Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=rnti
           should be true           ${rnti}==0
           #mcs
           ${mcs}                   Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=mcs
           should be true           ${mcs}==0
           #mcsTable
           ${mcsTable}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=mcsTable
           should be true           ${mcsTable}==1
           #startSymbol
           ${startSymbol}           Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startSymbol
           should be true           ${startSymbol}==0
          # numOfPdschSymbols
           ${numOfPdschSymbols}     Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=numOfPdschSymbols
           should Contain Any       ${numOfPdschSymbols}    14      6
           #startPrb
           ${startPrb}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startPrb
           should be true           ${startPrb}==3
           #numOfPrb
           ${numOfPrb}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=numOfPrb
           run Keyword If           '${load_level}'=='medium'    should Contain Any    ${numOfPrb}    36    13    18    15
           ...    ELSE IF           '${load_level}'=='busy'      should Contain Any    ${numOfPrb}    36    13    27    24
           ...    ELSE                                           should be true        ${numOfPrb}==48
           #rat0Bitmapny
           ${rat0Bitmap}            Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=rat0Bitmap
           should be true           ${rat0Bitmap}==0
           #pdschTbTransmitPower
           ${pdschTbTransmitPower}  Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=pdschTbTransmitPower
           should be true           ${pdschTbTransmitPower}==-279
           #modulationOrder
           ${modulationOrder}       Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=modulationOrder
           should be true           ${modulationOrder}==2
    END

    Dated Log  =====> Start check PdschSendReq IEs for UE2 (rnti=2)

    #Check PdschSendReq IEs for UE2 (rnti=2)
    FOR    ${packet}   IN           @{lisOfPdschSendReq_rnti2}
           #rnti
           ${rnti}                  Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=rnti
           should be true           ${rnti}==2
           #mcs
           ${mcs}                   Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=mcs
           should be true           ${mcs}==0
           #mcsTable
           ${mcsTable}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=mcsTable
           should be true           ${mcsTable}==1
           #startSymbol
           ${startSymbol}           Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startSymbol
           should be true           ${startSymbol}==2
          # numOfPdschSymbols
           ${numOfPdschSymbols}     Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=numOfPdschSymbols
           should Contain Any       ${numOfPdschSymbols}    12      4
           #startPrb
           ${startPrb}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=startPrb
           should be true           ${startPrb}==0
           #numOfPrb
           ${numOfPrb}              Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=numOfPrb
           run Keyword If           '${load_level}'=='medium'    should be true    ${numOfPrb}==1
           ...    ELSE IF           '${load_level}'=='busy'      should be true    ${numOfPrb}==2
           ...    ELSE                                           should be true    ${numOfPrb}==3
           #rat0Bitmapny
           ${rat0Bitmap}            Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=rat0Bitmap
           should be true           ${rat0Bitmap}==0
           #pdschTbTransmitPower
           ${pdschTbTransmitPower}  Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=pdschTbTransmitPower
           should be true           ${pdschTbTransmitPower}==-279
           #modulationOrder
           ${modulationOrder}       Get Value In Packet Match
           ...                      packetMatch=${packet}
           ...                      field=modulationOrder
           should be true           ${modulationOrder}==2
    END

