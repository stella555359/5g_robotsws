    nps_ttitraces_tools.install_multidynamic_if_needed

Init Trace color
    ${consTraceColor}               Evaluate                    "${CYAN}"
    ${defColor}                     Evaluate                    "${NORMAL}"
    Set Suite Variable              ${consTraceColor}
    Set Suite Variable              ${defColor}


Start Capture BIP L1L2
    [Documentation]                 Start capture BIP L1L2 logs

    Init Trace color

    ${CaptureL1L2}                  Capture L1L2 Set Upon Config        airscale=${GNB_DU}
    Capture Init                    ${CaptureL1L2}                      withTN=True
    Set Suite Variable              ${CaptureL1L2}
    Capture Start                   capture=${CaptureL1L2}


Stop Capture BIP L1L2
    [Documentation]                 Stop capture BIP L1L2 logs

    Init Trace color

    Capture Stop           capture=${CaptureL1L2}
    Dated Log              BIP L1L2 log saved to ${CaptureL1L2.path}\n
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureL1L2.path}     AND
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${CaptureL1L2.path}    ${testCaseDir}
    Dated Log              BIP L1L2 log saved to ${testCaseDir}\n

Get L1L2 traces
    [Arguments]     ${time}=1s   ${prefix}=DL_UL_Tput
    Dated Log         Get L1L2 Bip Traces
    ${CaptureBIP}              Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    ${CaptureBIP.prefix}       set Variable   ${prefix}
    ${CaptureBIP.withTN}       set Variable   True
    # Capture Init   ${CaptureBIP}
    #define options of gnbMirroring.sh (BIP only)
    ${OPT_GNB_MIRRORING_DSS}                 Tools.Dictionary Get              ${OPT_GNB_MIRRORING}
    ${OPT_GNB_MIRRORING_DSS.mirroring_mode}            set Variable         'manual'
    ${OPT_GNB_MIRRORING_DSS.l2_l1_bip}                 set Variable         'true'
    ${OPT_GNB_MIRRORING_DSS.backhaul_mirroring}        set Variable         'false'
    Set Suite Variable              ${OPT_GNB_MIRRORING_DSS}
    Execute Mirror Script with options for DSS      ${CaptureBIP.scriptDef}    ${OPT_GNB_MIRRORING_DSS}
    Capture start  ${CaptureBIP}
    Traced Sleep   ${time}     msg=take BIP L1L2 traces with DL/UL Tput
    Capture stop   ${CaptureBIP}
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureBIP.path}     AND
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${CaptureBIP.path}    ${testCaseDir}
    [Return]    ${CaptureBIP}
