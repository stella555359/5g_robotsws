Check BTS status in WEM for cOAM
    [Documentation]   This keyword is used to Check BTS status in WEM for cOAM.
    ...               author: Ch SAMSON
    [Arguments]     ${cell_id}=0
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=    coam.get_bts_statuses    timeout=30    connection=${GNB_DU.oam.httpAlias}
    Dated log      =======> Current bts status is ${bts_status}
    should Contain Any    ${bts_status['operationalState']}    Enabled   Disabled       ignore_case=true
    # should Contain Any    ${bts_status['proceduralState']}     configured   Test    msg=ENB is not in Test Mode, Current status is ${bts_status}
    should be equal    ${bts_status['proceduralState']}     Test    msg=BTS is not in Test Mode, Current status is ${bts_status}
    ...                                                                           ignore_case=true
    should be equal    ${bts_status['blockingState']}       Unblocked            ignore_case=true

    ${cell_info}=    coam.get_cells_info    cell_type=nr    timeout=30    connection=${GNB_DU.oam.httpAlias}
    # Dated log      =======> Current cell(s) info is ${cell_info}
    FOR    ${elem}    IN    @{cell_info}
        should Contain Any    ${elem['status']['proceduralStatus']}    not initialized   configured   OnAir    ignore_case=true
        Should be equal    ${elem['status']['administrativeState']}    Unlocked    ignore_case=true
    END
    OAM Disconnect                  ${GNB_DU.oam}

    #Riyad
Wait gNB Test Mode State
    [Documentation]       Wait gNB Test Mode State
    Dated Log       Get gNB in Test Mode
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=  coam.get_bts_statuses   connection=${GNB_DU.oam.httpAlias}
    OAM Disconnect                  ${GNB_DU.oam}
    Dated Log New Line      =======> BTS procedural state is now: ${bts_status["proceduralState"]}
    ${gnb_status}=     evaluate    '${bts_status["proceduralState"]}'.lower()
    Return From Keyword If    '${gnb_status}'=='Test'.lower()
    run keyword and ignore error        wait until keyword succeeds    3min    30s      Check BTS status in WEM for cOAM

    #Riyad
    #agf
    # Activate Test dedicated Mode
    #     [Documentation]         CB007382: Enable Test Dedicated State
    #     Dated Log New Line      CB007382 - Enable Test Dedicated State (TDS)
    #     coam.connect to                     bts_host=${WEBUI_IP}    name=coam_admin
    #     coam.Reset_To_Test_Dedicated        connection=coam_admin
    #     OAM wait available
    #     Wait gNB Test Mode State
    #     [Teardown]      coam.teardown       connection=coam_admin


Start Capture CPRT
    [Arguments]                     ${capture}
    [Tags]                          CAPTURE
    ${capture.filter}               Get Filter For SCTP
    Get Filter For TCP
    Set Suite Variable              ${capture}
    Capture Init                    ${capture}           withTN=True
    Capture Start                   ${capture}

Start Capture GNB
    [Arguments]                     ${capture}
    [Tags]                          CAPTURE
    Set Suite Variable              ${capture}
    Capture Init                    ${capture}           withTN=True
    Capture Start                   ${capture}

Stop Capture
    [Arguments]                     ${capture}
    [Tags]                          CAPTURE
    ${stop_path}                    Capture Stop                    ${capture}
    Dated Log  log dans ${stop_path}
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${Capture.path}     AND
    Run Keyword And Ignore Error    OperatingSystem.Copy File    ${Capture.path}    ${testCaseDir}
    Dated Log              log saved to ${testCaseDir}\n


Set SCF CB007382
    [Arguments]                    ${testParam}
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
    &{modify_param0}    Create Dictionary
    ...    parameter=nrarfcn
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scf.nrcell.nrarfcn}
    &{modify_param1}    Create Dictionary
    ...    parameter=chBw
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scf.nrcell.chBw}
    &{modify_param2}    Create Dictionary
    ...    parameter=ssbScs
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scf.nrcell.ssbScs}
    &{modify_param3}    Create Dictionary
    ...    parameter=freqBandIndicatorNR
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scf.nrcell.freqBandIndicatorNR}
    &{modify_param4}    Create Dictionary
    ...    parameter=gscnOrSsPbchArfcn
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scf.nrcell.gscn}
    &{modify_param5}    Create Dictionary
    ...    parameter=ssBurstSetPeriod
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELLGRP-0
    ...    value=${testParam.scf.nrcellgrp.ssBurstSetPeriod}
    &{modify_param6}    Create Dictionary
    ...    parameter=scs
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELLGRP-0
    ...    value=${testParam.scf.nrcellgrp.scs}
    &{modify_param7}    Create Dictionary
    ...    parameter=freqBandIndicatorNR
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRSYSINFO_PROFILE-1/NRIRFIM-1
    ...    value=${testParam.scf.nrirfim.freqBandIndicatorNR}
    &{modify_param8}    Create Dictionary
    ...    parameter=ssbScs
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRSYSINFO_PROFILE-1/NRIRFIM-1
    ...    value=${testParam.scf.nrirfim.ssbScs}
    &{modify_param9}    Create Dictionary
    ...    parameter=btsName
    ...    dist_name=MRBTS-${MRBTS_ID}
    ...    value=${testParam.scf.mrbts.btsName}

    @{modify_param_FR1}     Create List
    ...     ${modify_param0}        ${modify_param1}        ${modify_param2}
    ...     ${modify_param3}        ${modify_param4}        ${modify_param5}
    ...     ${modify_param6}        ${modify_param7}        ${modify_param8}
    ...     ${modify_param9}

    @{modify_param_FR2}     Create List
    ...     ${modify_param0}        ${modify_param1}        ${modify_param2}
    ...     ${modify_param3}        ${modify_param4}        ${modify_param5}
    ...     ${modify_param6}        ${modify_param9}

    Dated Log       Frequency Range: ${freq}

    run Keyword If      '${freq}'=='FR1'
    ...                     OAM Set Params      ${modify_param_FR1}
    ...     ELSE            OAM Set Params      ${modify_param_FR2}

    #Common
PrintTLInformation
    log many    EGATE_CFG_NAME=${tl.core.cfg_filename}    WTS_FILE_PATH=${tl.core.dir_path}   GNB_IP=${GNB_IP}
    log many    UTE_IP=${tl.core.default_ssh_connection_details.addr}
    ...         UTE_USERNAME=${tl.core.default_ssh_connection_details.username}
    ...         UTE_PASSWORD=${tl.core.default_ssh_connection_details.password}

    #Common
gNB BackupSCF
    [Arguments]   ${oam_type}=${OAM_TYPE}
    ${bakupfolder}    set variable    backups
    run   command=mkdir ${LOG_PATH}${/}${bakupfolder}
    set global variable    ${BACKUP_DIR}    ${LOG_PATH}${/}${bakupfolder}

    ${sufix}=     set variable if          ${isAic}            _DU
    ...                                                        ${EMPTY}
    ${scffile}                   set variable                old_commission${sufix}.xml
    ${scf_file_path}             OAM Get SCF File           dir=${BACKUP_DIR}      file=${scffile}
    set global variable    ${BACKUP_SCF}    ${scf_file_path}
    return from Keyword if      '${isAic}'=='${FALSE}'
    ${sufix}=     set variable if       ${isAic}     _CU
    ...                                              ${EMPTY}
    ${scffile}                   set variable                old_commission${sufix}.xml
    ${scf_file_path}             OAM Get SCF File           dir=${BACKUP_DIR}      file=${scffile}     oam=${GNB_CU.oam}
    # OperatingSystem.Copy File    ${scffile}    ${BACKUP_DIR}
    set global variable    ${BACKUP_CU_SCF}    ${scf_file_path}

Create Test Case Folder
    [Documentation]    create test case folder
    ${testCaseDir}    Replace String    ${TEST_NAME[0:30]}    ${SPACE}    _
    ${testCaseDir}    Replace String    ${testCaseDir}    .    _
    ${testCaseDir}    Remove String    ${testCaseDir}    [1]
    ${testCaseDir}    Remove String    ${testCaseDir}    [
    ${testCaseDir}    Remove String    ${testCaseDir}    ]
    Dated log       Create Test Case Folder ${testSuiteDir}/${testCaseDir}
    Set Suite Variable    ${testCaseDir}    ${testSuiteDir}/${testCaseDir}
    Create Directory    ${testCaseDir}

    #Common
Get testcase log directory
    [Documentation]    :Author: Ch SAMSON
    ...    Retuns path for Testcase log directory
    ...    If Testcase Log directory does not exist it will created automatically
    ...
    ...    :returns: Path for Testcase log
    ...
    ${P_resultTestDir}=    Get Variable Value    ${testCaseDir}
    Run Keyword If    '${P_resultTestDir}'=='None'
    ...    CB007382_keywords.Create Test Case Folder
    ${P_resultTestDir} =    Get Variable Value   ${testCaseDir}
    #${P_resultTestDir} =    Set Variable If    '${P_resultTestDir}'=='None'
    #...              ${testCaseDir}
    [Return]    ${P_resultTestDir}

Prepare Test Name
    [Documentation]    :Author: Ch SAMSON
    ...    Retuns formated test name
    ...
    ...    :returns: formated test name
    ...
    ${TEST_NAME}=       replace string  ${TEST_NAME}      ${SPACE}        _
    set test variable      ${TEST_NAME}
    [Return]    ${TEST_NAME}

Prepare Logs Directory Path
    [Arguments]    ${resultDir}=None   ${subdir}=${EMPTY}    ${with_timestamp}=${FALSE}
    [Documentation]
    ...    Creates directory for storing logs, based on current execution context.
    ...    An absolute path to created directory is returned.
    [Tags]    PRIVATE
    ${timestamp}=    DateTime.Get Current Date    result_format=%Y%m%d-%H%M%S
    ${subdir}    set variable if    '${with_timestamp}'=='${TRUE}'   ${subdir}_${timestamp}
    ...                                                              ${subdir}
    ${resultDir}=    Run Keyword If    '${resultDir}'=='None'    CB007382_keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${resultDir}
    ${logs_dir}   set variable     ${resultDir}/${subdir}
    OperatingSystem.Create Directory    ${logs_dir}
    [Return]    ${logs_dir}

    #CB007382_Kw_TestSetup.robot
get cellDepType from SCF
    # Get SCF File (SCF.xml) in test setup
    ${current_scf_fullname}    set Variable      ${LOG_PATH}/SCF.xml
    scf.load_scf	 ${current_scf_fullname}
    # MRBTS-1/NRBTS-1/NRCELL-1
    ${cellDepType}	 scf.get_value_from_scf   p_name=cellDepType
    ...              dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    [return]     ${cellDepType}

    #Common
Get Testline Name
    ${ret}    ${testline_name}=    OperatingSystem.Run And Return Rc And Output    hostname|sed 's/-/_/g'
    Dated log     Testline Name: ${testline_name}      console=${True}
    Dated log     Testline init file is /home/ute/testline_configuration/${testline_name}/       console=${True}
    Set Suite Metadata    Testline Name    ${testline_name}
    Set global variable   ${testline_name}
    # add here some info about  UTE TL
    ${reserve_file}=    Set Variable     /opt/ute/reservation.json
    ${file_exist}=    Run Keyword And Return Status    OperatingSystem.file_should_exist    ${reserve_file}
    ${cmd}=   run Keyword if   "${file_exist}"=="True"    Catenate
    ...                                           python -c 'import json;print(json.load(open("${reserve_file}"))["topology"])'
    ${ret}    ${ret_cmd}=       run Keyword if   "${file_exist}"=="True"       OperatingSystem.Run And Return Rc And Output    ${cmd}
    run Keyword if   "${file_exist}"=="True"     Dated log      Topology is ${ret_cmd}       console=${True}
    ${cmd}=   run Keyword if   "${file_exist}"=="True"    Catenate
    ...                                           python -c 'import json;print(json.load(open("${reserve_file}"))["user"])'
    ${ret}    ${ret_cmd}=       run Keyword if   "${file_exist}"=="True"       OperatingSystem.Run And Return Rc And Output    ${cmd}
    run Keyword if   "${file_exist}"=="True"     Dated log      user is ${ret_cmd}       console=${True}
    ${cmd}=   run Keyword if   "${file_exist}"=="True"    Catenate
    ...                                           python -c 'import json;print(json.load(open("${reserve_file}"))["enb_build"])'
    ${ret}    ${ret_cmd}=       run Keyword if   "${file_exist}"=="True"       OperatingSystem.Run And Return Rc And Output    ${cmd}
    run Keyword if   "${file_exist}"=="True"     Dated log      enb_build is ${ret_cmd}       console=${True}
    printLineWithTitle              title=-
    [return]    ${testline_name}

