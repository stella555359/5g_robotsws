Start 5g downlink test flat Load
    [Documentation]    :
    ...    start Downlink test
    ...    [PRIVATE]
    [Arguments]     ${test_mode}
    @{beam_pattern_id_list}         Create List     1
    ${rtId}                         Get Runtime Id
    ${tCellId}                      Set Variable    1
    Start Downlink Test                 oam=${GNB_DU.oam}
    ...                                 cell_dn=/MRBTS-1/RAT-1/RUNTIME_VIEW-${rtId}/MRBTS_R-${rtId}/NRBTS_R-${tCellId}/NRCELL_R-${tCellId}
    ...                                 test_model=TM1_1_ETSI
    ...                                 beam_pattern_id=${beam_pattern_id_list}
    ...                                 polarization=P_plus45_or_0
    ...                                 power_backoff=0                       ru_mode=NR_Only
    ...                                 phys_cell_id=50                       p_max=22
    ...                                 mimo_rank=1                           load_type=${test_mode.load_type}
    ...                                 load_level_flat=${test_mode.load_level_flat}
    ...                                 num_of_ssb_beam_pattern_id=${test_mode.num_of_ssb_beam_pattern_id}
    ...                                 ssb_beam_pattern_id=${test_mode.ssb_beam_pattern_id}

Start 5g downlink test Burst Load
    [Documentation]    :
    ...    start Downlink test
    ...    [PRIVATE]
    [Arguments]     ${test_mode}
    @{beam_pattern_id_list}         Create List     1
    ${rtId}                         Get Runtime Id
    ${tCellId}                      Set Variable    1
    Start Downlink Test                 oam=${GNB_DU.oam}
    ...                                 cell_dn=/MRBTS-1/RAT-1/RUNTIME_VIEW-${rtId}/MRBTS_R-${rtId}/NRBTS_R-${tCellId}/NRCELL_R-${tCellId}
    ...                                 test_model=TM1_1_ETSI
    ...                                 beam_pattern_id=${beam_pattern_id_list}
    ...                                 polarization=P_plus45_or_0
    ...                                 power_backoff=0                       ru_mode=NR_Only
    ...                                 phys_cell_id=50                       p_max=22
    ...                                 mimo_rank=1                           load_type=${test_mode.load_type}
    ...                                 load_level_burst=${test_mode.load_level_burst}

Stop 5g downlink Test
    ${rtId}                         Get Runtime Id
    ${tCellId}                      Set Variable    1
    Stop Downlink Test              oam=${GNB_DU.oam}
    ...         cell_dn=/MRBTS-1/RAT-1/RUNTIME_VIEW-${rtId}/MRBTS_R-${rtId}/NRBTS_R-${tCellId}/NRCELL_R-${tCellId}

Install classicalbts log collector into gNB
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist    {CURDIR}/../scripts/classicalbts_log_collector.sh
