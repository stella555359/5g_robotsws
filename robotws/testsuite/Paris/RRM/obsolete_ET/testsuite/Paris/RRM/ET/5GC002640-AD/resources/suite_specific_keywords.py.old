def set_lcrId(value=4):
    logger_console_info("Set lcrId to {}".format(value))
    if AP_HARDWARE == 'ASIL':
        update_parameter_value(parameter="lcrId", value=value, dist_name="MRBTS-1/NRBTS-1/NRCELL-1/NRREL-1")
    else:
        update_parameter_value(parameter="lcrId", value=value, dist_name="MRBTS-1/NRBTS-1/NRCELL-4/NRREL-1")


def get_drx_config_query(inactivity_timer=None, on_duration_timer=None, retransmission_timer_dl=None,
                         retransmission_timer_ul=None, long_cycle_start_offset=None, slot_offset=None):
    drx_config_template = """
    drx-Config is present
    and
    drx-Config contains
    (
        {}
    )
    """
    checkers_list = []
    if inactivity_timer:
        checkers_list.append("drx-InactivityTimer eq 'ms{}'".format(inactivity_timer))
    if on_duration_timer:
        checkers_list.append("drx-onDurationTimer contains (milliSeconds eq 'ms{}')".format(on_duration_timer))
    if retransmission_timer_dl:
        checkers_list.append("drx-RetransmissionTimerDL eq 'sl{}'".format(retransmission_timer_dl))
    if retransmission_timer_ul:
        checkers_list.append("drx-RetransmissionTimerUL eq 'sl{}'".format(retransmission_timer_ul))
    if long_cycle_start_offset:
        checkers_list.append("drx-LongCycleStartOffset contains (ms{} eq 0)".format(long_cycle_start_offset))
    if slot_offset:
        checkers_list.append("drx-SlotOffset eq 0".format(slot_offset))

    return drx_config_template.format("\n        and\n        ".join(checkers_list))


def get_pucch_resource_ids_in_resource_to_add_mod_list_query(resource_ids):
    pucch_config_template = """
    spCellConfig contains
    (
        pucch-Config contains
        (
            {}
        )
    )
    """
    resource_to_add_mod_list_query_template = """
            resourceToAddModList contains
            (
                pucch-ResourceId eq {}
            )
    """
    resource_ids_elements = [resource_to_add_mod_list_query_template.format(_id) for _id in resource_ids]
    return pucch_config_template.format("\n            and\n            ".join(resource_ids_elements))


def cleanup_logs_dir_at_teardown():
    dest_dir = create_dir_at_output_dir(dir_name=get_test_prefix() + "/ta_messaging_processing")
    log_output_dir = ta5g_interface_tools().get_robot_output_dir()
    files = [file for prefix in ['csv*', 'messaging*', 'PARSED*'] for file in
             glob.glob(os.path.join(log_output_dir, prefix))]
    for file in files:
        logger.info("Move {} to {}".format(file, dest_dir))
        shutil.move(file, dest_dir)


def get_cells_converted_to_phycellid(scells, pcell_id="16388"):
    phycellmap = BuiltIn().get_variable_value("${PHYCELLID_MAP}")
    tdd_scells_filter = BuiltIn().get_variable_value("${TDD_SCELLS}")
    pcell_id = phycellmap[pcell_id]
    scells = [phycellmap[scell] for scell in scells]
    all_cells = [pcell_id] + scells
    tdd_scells = [cell for cell in scells if cell in tdd_scells_filter]
    logger.debug("{} {} {} {}".format(pcell_id, scells, all_cells, tdd_scells))
    return pcell_id, scells, all_cells, tdd_scells


def enable_port_mirroring_for_bips():
    bip_script_path = BuiltIn().get_variable_value("${RESOURCES_DIR}")
    bip_script_name = BuiltIn().get_variable_value("${BIP_SCRIPT}")
    sshpass_cmd = 'sshpass -p "oZPS0POrRieRtu" ssh -o StrictHostKeyChecking=no  -o GlobalKnownHostsFile=/dev/null -o\
     UserKnownHostsFile=/dev/null -q toor4nsn@192.168.255.129  \'{}\''
    upload_files_to_gnb(remote_path="/user/toor4nsn/", files=[os.path.join(bip_script_path, bip_script_name)])
    run_on_gnb('chmod +x {}'.format(bip_script_name))
    subprocess.Popen(sshpass_cmd.format("./{}".format(bip_script_name)), shell=True, stdout=subprocess.PIPE)
    BuiltIn().set_test_variable("${BIP_COLLECTION_RUNNING}", True)


def compress_bip_logs():
    bip_collection_running = BuiltIn().get_variable_value("${BIP_COLLECTION_RUNNING}")
    if bip_collection_running:
        prefix = get_test_prefix()
        log_dirpath = ta5g_interface_tools().get_robot_output_dir()
        file_path = os.path.join(log_dirpath, prefix, "bip_remote_{}.pcap".format(prefix))
        compressed_file_path = file_path + ".tar.gz"
        if os.path.exists(file_path):
            OperatingSystem().run('tar -czvf {} {}'.format(compressed_file_path, file_path))
        if os.path.exists(compressed_file_path) and os.path.getsize(compressed_file_path) > 50:
            OperatingSystem().run("rm -f {}".format(file_path))

        BuiltIn().set_test_variable("${BIP_COLLECTION_RUNNING}", False)


