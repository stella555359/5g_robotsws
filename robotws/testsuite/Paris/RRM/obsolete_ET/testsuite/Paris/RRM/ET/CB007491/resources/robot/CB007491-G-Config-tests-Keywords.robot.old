# Libraries
Library         OperatingSystem
Library         XML    True

# taf Libraries
Library         taf.config.scf                          WITH NAME          scf
Library         taf.sbts.oam.coam.admin                 WITH NAME          coam

# Resources CB007491
Resource     CB007491-Keywords.robot

*** Variables ***

&{5GC001116_0_fs}  frameStructureType=tdLte
    ...     guardPeriodLength=4Symbols
    ...     lteToNrFrameShift=0ms
    ...     tdLteUlDlConfig=tdLteConfig2
    ...     ulDlDataSlotRatio=1/4

&{5GC001116_3_fs}   frameStructureType=tdLte
    ...     guardPeriodLength=4Symbols
    ...     lteToNrFrameShift=3ms
    ...     tdLteUlDlConfig=tdLteConfig2
    ...     ulDlDataSlotRatio=1/4

&{5GC001116_3_Canada_fs}   frameStructureType=tdLte
    ...     guardPeriodLength=4Symbols
    ...     lteToNrFrameShift=3ms
    ...     tdLteUlDlConfig=tdLteConfig2
    ...     ulDlDataSlotRatio=1/4

&{5GC001208_fs}     frameStructureType=semiStatic
    ...     guardPeriodLength=2Symbols
    ...     ulDlDataSlotRatio=1/4

&{5GC001070_fs}      frameStructureType=semiStatic
    ...     guardPeriodLength=2Symbols
    ...     ulDlDataSlotRatio=3/7

&{5GC001116_0_inf_fs}  infFrameStructureType=tdLte
    ...     infGuardPeriodLength=4Symbols
    ...     infLteToNrFrameShift=0ms
    ...     infScs=30 KHz
    ...     infTddFrameMutingBiAgreement=true
    ...     infTdLteUlDlConfig=tdLteConfig2
    ...     infUlDlDataSlotRatio=1/4

&{5GC001116_3_inf_fs}  infFrameStructureType=tdLte
    ...     infGuardPeriodLength=4Symbols
    ...     infLteToNrFrameShift=3ms
    ...     infScs=30 KHz
    ...     infTddFrameMutingBiAgreement=true
    ...     infTdLteUlDlConfig=tdLteConfig2
    ...     infUlDlDataSlotRatio=1/4

&{5GC001208_inf_fs}  infFrameStructureType=semiStatic
    ...     infGuardPeriodLength=2Symbols
    ...     infScs=30 KHz
    ...     infTddFrameMutingBiAgreement=true
    ...     infUlDlDataSlotRatio=1/4

&{cSrs}   10MHz=7
    ...   15MHz=10
    ...   30MHz=20
    ...   40MHz=25
    ...   50MHz=33
    ...   60MHz=42
    ...   70MHz=45
    ...   80MHz=51
    ...   90MHz=56
    ...   100MHz=63

@{nrCellId_9836_List}   1   2   3    4
@{nrCellGrplId}    0   1   2    3

#POSTCONDITIONS
##MANDATORY FLAGS
${actDlMuMimoEnh}          true
${actUlMuMimo}             true
${actSuperCell}            false
${actVoNR}                 true
${actEnhancedVoNR}         false
${targetTotalLoad}         0
${actNonVoNRGbrService}    false
${numOfSubSectors}         0sub-sector

${actBbPoolTddFr1}                  true   #CB008940
${actBbPoolExtensionTddFr1}         true   #CB010513
${actBbPoolTddFr1AlgEnh}            true   #LBT - New Pooling Algo
${actExplicitCsirsPoolSolution}     true   #LBT - CSI-RS Config  ******
${actBbPoolTddFr1Enh}               true   #CB011028
${actTddCsirsAllocOptimization}     false  #CB009836
${actTddCsiRsOpt}                   false  #CB012269
${actSlowPrbPooling}                false
${actSpatialStreamPooling}          false
${actDlSrsBm}                       true
${actBeamforming}                   true
${actCsirsMultiplexing}             true
${actCellCsirsTddOnSsbBf}           false
${actCellCsiRsImTddNonBf}           false
${actNonVoNRGBRService}             false    # actNonVoNRGBRService per Cell
${actAdaptiveReTxResMcs}            false    # actAdaptiveReTxResMcs per Cell, recommended value (not supported by AP)
${actFdmEnhancedScheduling}         true
${actInfTddFrameMuting}             false    # actInfTddFrameMuting per Cell
${frameStructure}                   5GC001208    # 5GC001208 means SemiStatic 1:4
${dist_name}                        MRBTS-1/NRBTS-1
@{bwp0}                             ${dist_name}/BWP_PROFILE-1         ${dist_name}/BWP_PROFILE-1     ${dist_name}/BWP_PROFILE-1
@{bwp1}                             ${dist_name}/BWP_PROFILE-20        ${dist_name}/BWP_PROFILE-20    ${dist_name}/BWP_PROFILE-20
@{prach}                            93      93      93      93
@{beamSet}                          beamSet_6       beamSet_6       beamSet_6    beamSet_6
@{beams}                            6 beams     6 beams     6 beams    6 beams
@{customBeamSetName}                BSR_AEQE_6_H6_ALN60_ARP60_P00_COVERAGE_00424_00001
...                                 BSR_AEQE_6_H6_ALN60_ARP60_P00_COVERAGE_00424_00001
...                                 BSR_AEQE_6_H6_ALN60_ARP60_P00_COVERAGE_00424_00001
...                                 BSR_AEQE_6_H6_ALN60_ARP60_P00_COVERAGE_00424_00001
@{chBw}                             100MHz          100MHz          100MHz    100MHz
@{type0CoresetConfigurationIndex}   10              10              10        10
@{type0SearchSpaceConfigurationIndex}     5          5           5            5
@{csiReportPeriodicity}             slots320        slots320        slots320    slots320
@{nrCellType}                       8DL8UL      8DL8UL      8DL8UL    8DL8UL
@{dlMimoMode}                       8x4 Closed Loop Spatial Multiplexing      8x4 Closed Loop Spatial Multiplexing
...                                 8x4 Closed Loop Spatial Multiplexing      8x4 Closed Loop Spatial Multiplexing
# 70:8x4 Closed Loop Spatial Multiplexing  40:4x4 or 4x2 Closed Loop Spatial Multiplexing
@{msg1FrequencyStart}               23      23      23     23
@{csirsNbWithinReportPeriod_Set1}   1   1   1    1
${rbAllocation}                     BWP   #BWP per Cell
${csirsTrackingPeriod}              80ms
@{maxCsirsNumber}                   4    4    4    4
${actUeCsirsCoexistCellCsirs}       false    # actUeCsirsCoexistCellCsirs per Cell
${actCsirsBeamPowerBalance}         false    # actCsirsBeamPowerBalance per Cell
${actBlankDlSymbBorderCoord}        false    # actBlankDlSymbBorderCoord per Cell
@{actCaWimaxInterferenceAvoidance}  false    false    false    false
@{actPerCsiReportBundlingTddFr1}    true     true     true     true
${mcc}                              311
${mnc}                              489
${mncLength}                        3
${fPdcchMonOccsnPo}                 2
${actUlSrsBm}                       true
${actDlSrsBm}                       true
@{actEnhancedPDSCHSchSplSlot}       false    false     false    false   #CB009007 - PDSCH scheduling in special slot - FR1 TDD

*** Keywords ***

Log config in result file
    [Arguments]    ${config}=None
    ${resultFile}    Set Variable     ${testCaseDir}/resultFile_${TEST NAME[0:30]}.log
    Set Test Variable    ${resultFile}
    Append To File   ${resultFile}  ------------------------------------------------------\n
    Append To File   ${resultFile}   TEST NAME: ${TEST NAME}\n
    Append To File   ${resultFile}   TEST CONFIG: ${config}\n
    Append To File   ${resultFile}  ------------------------------------------------------\n
    Append To File   ${resultFile}   \nactBbPoolTddFr1 (CB008940): ${actBbPoolTddFr1}
    Append To File   ${resultFile}   \nactBbPoolExtensionTddFr1 (CB010513): ${actBbPoolExtensionTddFr1}
    Append To File   ${resultFile}   \nactBbPoolTddFr1AlgEnh (LBT - New Pooling Algo): ${actBbPoolTddFr1AlgEnh}
    Append To File   ${resultFile}   \nactBbPoolTddFr1Enh (CB011028): ${actBbPoolTddFr1Enh}
    Append To File   ${resultFile}   \nactExplicitCsirsPoolSolution: ${actExplicitCsirsPoolSolution}
    # Append To File   ${resultFile}   \nactTddCsirsAllocOptimization (CB009836): ${actTddCsirsAllocOptimizationInVendorFile}
    Append To File   ${resultFile}   \nactTddCsiRsOpt (CB012265): ${actTddCsiRsOpt}
    Append To File   ${resultFile}   \nFrame structure: ${frameStructure}
    Append To File   ${resultFile}   \nBeamset: @{beamSet}
    Append To File   ${resultFile}   \nbeams: @{beams}
    Append To File   ${resultFile}   \ndlMimoMode @{dlMimoMode}
    Append To File   ${resultFile}   \nnrCellType @{nrCellType}
    Append To File   ${resultFile}   \nchBw @{chBw}
    # Append To File   ${resultFile}   \ncSRS @{cSRS}
    FOR     ${i}   IN RANGE  len(${nrCellId_9836_List})
        Append To File   ${resultFile}   \nCellId=@{nrCellId_9836_List}[${i}] srsForBeamMgmt:cSRS=${cSRS['@{chBw}[${i}]']}
    END
    Append To File   ${resultFile}   \nactUeCsirsCoexistCellCsirs ${actUeCsirsCoexistCellCsirs}
    Append To File   ${resultFile}   \nactCsirsBeamPowerBalance ${actCsirsBeamPowerBalance}
    Append To File   ${resultFile}   \ncsiReportPeriodicity: @{csiReportPeriodicity}
    Append To File   ${resultFile}   \ncsirsNumberWithinReportPeriod_Set1 @{csirsNbWithinReportPeriod_Set1}
    Append To File   ${resultFile}   \nmaxCsirsNumber @{maxCsirsNumber}
    Append To File   ${resultFile}   \nrbAllocation ${rbAllocation}
    Append To File   ${resultFile}   \nactCaWimaxInterferenceAvoidance @{actCaWimaxInterferenceAvoidance}
    Append To File   ${resultFile}   \nactEnhancedPDSCHSchSplSlot @{actEnhancedPDSCHSchSplSlot}
    Append To File   ${resultFile}   \nactAdaptiveReTxResMcs ${actAdaptiveReTxResMcs}
    Append To File   ${resultFile}   \nactPerCsiReportBundlingTddFr1 @{actPerCsiReportBundlingTddFr1}
    Append To File   ${resultFile}   \nactBlankDlSymbBorderCoord ${actBlankDlSymbBorderCoord}
    Append To File   ${resultFile}   \nmcc ${mcc}
    Append To File   ${resultFile}   \nmnc ${mnc}
    Append To File   ${resultFile}   \nfPdcchMonOccsnPo ${fPdcchMonOccsnPo}
    Append To File   ${resultFile}   \ntargetTotalLoad ${targetTotalLoad}
    Append To File   ${resultFile}   \nactVoNR ${actVoNR}
    Append To File   ${resultFile}   \nactNonVoNRGbrService ${actNonVoNRGbrService}
    Append To File   ${resultFile}   \nnumOfSubSectors ${numOfSubSectors}\n

Set Frame Structure New
    [Arguments]   ${nrCellId}    ${frameStructure_to_apply}    ${param_list}
    ${tddFrameParam}     convert to String      ${${frameStructure_to_apply}_fs}
    ${tddFrameParam}     Replace String         ${tddFrameParam}           '    "
    ${tddFrameStructure}      Set Variable      NRCELL-${nrCellId}:tddFrameStructure
    Append To List       ${param_list}   delete:${tddFrameStructure}
    Append To List       ${param_list}   add:${tddFrameStructure}
    Append To List       ${param_list}   add:${tddFrameStructure}:${tddFrameParam}
    [return]  ${param_list}

Set Frame Structure
    [Arguments]   ${nrCellId}    ${param_list}
    ${tddFrameParam}     convert to String      ${${frameStructure}_fs}
    ${tddFrameParam}     Replace String         ${tddFrameParam}           '    "
    ${tddFrameStructure}      Set Variable      NRCELL-${nrCellId}:tddFrameStructure
    Append To List       ${param_list}   delete:${tddFrameStructure}
    Append To List       ${param_list}   add:${tddFrameStructure}
    Append To List       ${param_list}   add:${tddFrameStructure}:${tddFrameParam}
    [return]  ${param_list}

Set Interfering Frame Structure
    [Arguments]   ${nrCellId}    ${param_list}
    ${infTddFrameParam}     convert to String      ${${infTddFrameStructure}_inf_fs}
    ${infTddFrameParam}     Replace String         ${infTddFrameParam}           '    "
    ${infTddFrameStructure}      Set Variable      NRCELL-${nrCellId}:infTddFrameStructure
    Append To List       ${param_list}   delete:${infTddFrameStructure}
    Append To List       ${param_list}   add:${infTddFrameStructure}
    Append To List       ${param_list}   add:${infTddFrameStructure}:${infTddFrameParam}
    log to console       \ninfTddFrameStructure : ${infTddFrameStructure}
    log to console       \ninfTddFrameParam: ${infTddFrameParam}

Compare value with current configuration
    [Arguments]  ${xml_root}  ${dist_name}  ${param_name}  ${param_value}
    ${xpath}=  set variable  .//managedObject[@distName="${dist_name}"]/p[@name="${param_name}"]
    ${value}=  XML.Get Element Text  ${xml_root}  ${xpath}
    ${status}=  run keyword and return status  should be equal    ${param_value}   ${value}
    run keyword if   not(${status})
    ...    run keywords   Append To File      ${resultFile}     \n${dist_name}/${param_name} must be set to ${param_value}
    ...      AND          set test variable   ${testCheck}      testNotOK

get SCF
    ${test_scf_file}             COAM Get SCF        local_dir_path=${LOG_PATH}      file=SCF.xml   alias=coam_gnb
    Set Suite Variable           ${test_scf_file}

Mandatory feature activation checks
    [Arguments]    ${scf}
    ${xml_root} =   XML.parse xml   ${scf}
    set test variable  ${testCheck}  testOK
    ${nrCellId_9836_List_length}=    Get Length    ${nrCellId_9836_List}
    dated log      nrCellId_9836_List_length=${nrCellId_9836_List_length}
    FOR  ${cellID}  IN   @{nrCellId_9836_List}
        ${dist_name}=     Set Variable     MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${cellID}
        Compare value with current configuration  ${xml_root}   ${dist_name}   actDlMuMimoEnh  ${actDlMuMimoEnh}
        Compare value with current configuration  ${xml_root}   ${dist_name}   actUlMuMimo  ${actUlMuMimo}
        Compare value with current configuration  ${xml_root}   ${dist_name}   actSuperCell  ${actSuperCell}
        Compare value with current configuration  ${xml_root}   ${dist_name}   actVoNR  ${actVoNR}
        Compare value with current configuration  ${xml_root}   ${dist_name}   actNonVoNRGbrService  ${actNonVoNRGbrService}
        Compare value with current configuration  ${xml_root}   ${dist_name}   targetTotalLoad  ${targetTotalLoad}
        Compare value with current configuration  ${xml_root}   ${dist_name}   actEnhancedVoNR  ${actEnhancedVoNR}
        Compare value with current configuration  ${xml_root}   ${dist_name}   actDlSrsBm  ${actDlSrsBm}
    END
    run keyword if  '${testCheck}' == 'testNotOK'   fail   \nWrong Mandatory Config (UL or DL MIMO)
    Append To File   ${resultFile}   \n\nCheck Mandatory Config--> PASSED\n(UL/DL MIMO, VoNR, no superCell)\n

Activate config
    [Arguments]   ${w_getSCF}=true    ${w_bsr}=true    ${w_cellcsirs}=true    ${w_calculate_delta_scf}=true    ${w_commit}=true
    ...           ${w_WA_ssb_6beams}=false
    ${param_list}    Create List

    run Keyword If    '${w_getSCF}' == 'true'     get SCF
    run Keyword If    '${w_getSCF}' == 'true'     dated log    Activate config using "get SCF" kw first
    ...     ELSE                                  dated log    Activate config using current SCF ${test_scf_file} from previous test step
    OperatingSystem.copy file    ${test_scf_file}      ${testCaseDir}/scf_orig.xml

    run Keyword If    '${w_getSCF}' == 'true'
    ...                  Mandatory feature activation checks    scf=${testCaseDir}/scf_orig.xml

    #Prepare the configuration from preconditions
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actBbPoolTddFr1=${actBbPoolTddFr1}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actBbPoolExtensionTddFr1=${actBbPoolExtensionTddFr1}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actBbPoolTddFr1AlgEnh=${actBbPoolTddFr1AlgEnh}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actSlowPrbPooling$=${actSlowPrbPooling}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actSpatialStreamPooling=${actSpatialStreamPooling}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actExplicitCsirsPoolSolution=${actExplicitCsirsPoolSolution}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actFdmEnhancedScheduling=${actFdmEnhancedScheduling}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actBbPoolTddFr1Enh=${actBbPoolTddFr1Enh}
    # CB009836
    #Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actTddCsirsAllocOptimization=${actTddCsirsAllocOptimization}
    # CB012265
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actTddCsiRsOpt=${actTddCsiRsOpt}

    FOR     ${i}   IN RANGE  len(${nrCellId_9836_List})
        ${param_list}    Set Frame Structure New  @{nrCellId_9836_List}[${i}]   @{frameStructure_List}[${i}]     ${param_list}
		run keyword if   '${actInfTddFrameMuting}' == 'true'   Set Interfering Frame Structure   @{nrCellId_9836_List}[${i}]   ${param_list}
		${name}=         Set Variable     periodicCsiAcquisition:csirsNumberWithinReportPeriod_Set1
		${bsr_file}=     Set Variable If     '${w_bsr}' == 'true'     @{customBeamSetName}[${i}]
		...                                                           ${EMPTY}
		${scf_modifs}    create list
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:cellBwpList:bwpDN=@{bwp0}[${i}]|cellBwpId=0
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:cellBwpList:bwpDN=@{bwp1}[${i}]|cellBwpId=1
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:chBw=@{chBw}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:type0CoresetConfigurationIndex=@{type0CoresetConfigurationIndex}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:prachConfigurationIndex=@{prach}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:basicBeamSet=@{beamset}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actDlSrsBm=${actDlSrsBm}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actBeamforming=${actBeamforming}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actCsirsMultiplexing=${actCsirsMultiplexing}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actCellCsirsTddOnSsbBf=${actCellCsirsTddOnSsbBf}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actCellCsiRsImTddNonBf=${actCellCsiRsImTddNonBf}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actAdaptiveReTxResMcs=${actAdaptiveReTxResMcs}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:nrCellType=@{nrCellType}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:csirsForTracking:rbAllocation=${rbAllocation}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actBlankDlSymbBorderCoord=${actBlankDlSymbBorderCoord}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:msg1FrequencyStart=@{msg1FrequencyStart}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:periodicCsiAcquisition:csiReportPeriodicity=@{csiReportPeriodicity}[${i}]
            ...  modify:NRCELLGRP-@{nrCellGrplId}[${i}]:numberOfTransmittedSsBlocks=@{beams}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:csirsTrackingPeriod=${csirsTrackingPeriod}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:dlMimoMode=@{dlMimoMode}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actInfTddFrameMuting=${actInfTddFrameMuting}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actUeCsirsCoexistCellCsirs=${actUeCsirsCoexistCellCsirs}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actCsirsBeamPowerBalance=${actCsirsBeamPowerBalance}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actCaWimaxInterferenceAvoidance=@{actCaWimaxInterferenceAvoidance}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:numOfSubSectors=${numOfSubSectors}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actUlMuMimo=${actUlMuMimo}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actUlSrsBm=${actUlSrsBm}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actEnhancedPDSCHSchSplSlot=${actEnhancedPDSCHSchSplSlot}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actPerCsiReportBundlingTddFr1=${actPerCsiReportBundlingTddFr1}[${i}]
        Run Keyword If  '${w_bsr}' == 'true'     Append To List    ${scf_modifs}
        ...                        modify:NRCELL-@{nrCellId_9836_List}[${i}]:beamSet:customBeamSetName=@{customBeamSetName}[${i}]
        Run Keyword If  '${actDlSrsBm}' == 'true'   Append To List    ${scf_modifs}
        ...                        modify:NRCELL-@{nrCellId_9836_List}[${i}]:srsForBeamMgmt:cSRS=${cSRS['@{chBw}[${i}]']}
        Run Keyword If  '${w_cellcsirs}' == 'true'   Append To List    ${scf_modifs}
        ...                        modify:NRCELL-@{nrCellId_9836_List}[${i}]:beamSet:nrBtsBeamRefinementP2=false
        ...                        modify:NRCELL-@{nrCellId_9836_List}[${i}]:${name}=@{csirsNbWithinReportPeriod_Set1}[${i}]
        ...                        modify:NRCELL-@{nrCellId_9836_List}[${i}]:periodicCsiAcquisition:maxCsirsNumber=@{maxCsirsNumber}[${i}]
        ...                        modify:NRCELL-@{nrCellId_9836_List}[${i}]:periodicCsiAcquisition:csirsPower=9
        Append To List    ${scf_modifs}
        ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:periodicity=@{periodicityType0A}[${i}]|searchSpaceType=Type0A
        ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:slotOffset=@{slotOffsetType0A}[${i}]|searchSpaceType=Type0A
        ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:duration=@{durationType0A}[${i}]|searchSpaceType=Type0A
        ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:periodicity=@{periodicityType0A}[${i}]|searchSpaceType=Type0A
        ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:slotOffset=@{slotOffsetType0A}[${i}]|searchSpaceType=Type0A
        ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:duration=@{durationType0A}[${i}]|searchSpaceType=Type0A
        ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:periodicity=@{periodicityType2}[${i}]|searchSpaceType=Type2
        ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:slotOffset=@{slotOffsetType2}[${i}]|searchSpaceType=Type2
        ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:duration=@{durationType2}[${i}]|searchSpaceType=Type2
        ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:periodicity=@{periodicityType2}[${i}]|searchSpaceType=Type2
        ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:slotOffset=@{slotOffsetType2}[${i}]|searchSpaceType=Type2
        ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:duration=@{durationType2}[${i}]|searchSpaceType=Type2
        Append To List       ${param_list}     @{scf_modifs}
    END
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:mcc=${mcc}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:mnc=${mnc}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:mncLength=${mncLength}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRPLMN-1:mcc=${mcc}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRPLMN-1:mnc=${mnc}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRPLMN-1:mncLength=${mncLength}

    Dated log   param_list=${param_list}
    #Apply modifications / Reset
    scf.load_scf                    ${testCaseDir}/scf_orig.xml
    Dated log     perform_scf_modification...
    scf.perform_scf_modification    modification_strings=${param_list}
    FOR     ${i}   IN RANGE  len(${nrCellId_9836_List})
        scf.modify_scf_element    ${fPdcchMonOccsnPo}  dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-@{nrCellId_9836_List}[${i}]
        ...                       list_name=fPdcchMonOccsnPo   index=0
    END
    # scf.modify_scf_element          dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}    p_name=actTddCsiRsOpt     value=${actTddCsiRsOpt}
    scf.save_scf                    file_path=${testCaseDir}/scf_modif.xml
    Run Keyword If    '${w_calculate_delta_scf}'=='true'     Dated log     calculate_delta_scf...
    ...    ELSE                                              Dated log     no calculate_delta_scf...
    Run Keyword If    '${w_calculate_delta_scf}'=='true'    scf.calculate_delta_scf
    ...                             target_scf_path=${testCaseDir}/scf_modif.xml
    ...                             actual_scf_path=${testCaseDir}/scf_orig.xml
    ...                             delta_scf_path=${testCaseDir}/scf_delta.xml
    ${all_modifs}    Run Keyword If    '${w_calculate_delta_scf}'=='true'   Run Keywords     OperatingSystem.Get File  ${testCaseDir}/scf_delta.xml
    ...                                                                       AND            Dated log     calculate_delta_scf finished...
    ...                  ELSE                                               Set Variable     ${EMPTY}

    robot_extension.Run Keyword And Warn On Failure       Admin Validate SCF     scf_path_file=${testCaseDir}/scf_modif.xml

    Run Keyword If    '${w_commit}'=='true'     Dated log     perform_commissioning[${testCaseDir}/scf_modif.xml]...
    ${status}  Run Keyword If    '${w_commit}'=='true'    run keyword and return status
    ...      coam.perform_commissioning    bts_id=0    scf_file=${testCaseDir}/scf_modif.xml
    ...              skip_parameter_relation_errors=False    should_activate=True    timeout=300    connection=coam_gnb
    ...     ELSE     Set Variable    ${True}
    run keyword if   not(${status})  run keywords
    ...  Append To File   ${resultFile}    \nCommissioning FAILED\n
    ...  AND     Fail   Commissioning FAILED

    ${test_scf_file}             COAM Get SCF        local_dir_path=${LOG_PATH}      file=SCF.xml   alias=coam_gnb
    Set Suite Variable           ${test_scf_file}

Activate config CB007491-B1
    [Arguments]   ${w_getSCF}=true    ${w_bsr}=true    ${w_cellcsirs}=true    ${w_calculate_delta_scf}=true    ${w_commit}=true
    ${param_list}    Create List

    run Keyword If    '${w_getSCF}' == 'true'     get SCF
    run Keyword If    '${w_getSCF}' == 'true'     dated log    Activate config using "get SCF" kw first
    ...     ELSE                                  dated log    Activate config using current SCF ${test_scf_file} from previous test step
    OperatingSystem.copy file    ${test_scf_file}      ${testCaseDir}/scf_orig.xml

    run Keyword If    '${w_getSCF}' == 'true'
    ...                  Mandatory feature activation checks    scf=${testCaseDir}/scf_orig.xml

    #Prepare the configuration from preconditions
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actBbPoolTddFr1=${actBbPoolTddFr1}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actBbPoolExtensionTddFr1=${actBbPoolExtensionTddFr1}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actBbPoolTddFr1AlgEnh=${actBbPoolTddFr1AlgEnh}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actSlowPrbPooling$=${actSlowPrbPooling}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actSpatialStreamPooling=${actSpatialStreamPooling}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actExplicitCsirsPoolSolution=${actExplicitCsirsPoolSolution}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actFdmEnhancedScheduling=${actFdmEnhancedScheduling}
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actBbPoolTddFr1Enh=${actBbPoolTddFr1Enh}
    # CB009836
    #Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actTddCsirsAllocOptimization=${actTddCsirsAllocOptimization}
    # CB012265
    Append To List       ${param_list}    modify:MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}:actTddCsiRsOpt=${actTddCsiRsOpt}

    FOR     ${i}   IN RANGE  len(${nrCellId_9836_List})
        ${param_list}    Set Frame Structure   @{nrCellId_9836_List}[${i}]   ${param_list}
		run keyword if   '${actInfTddFrameMuting}' == 'true'   Set Interfering Frame Structure   @{nrCellId_9836_List}[${i}]   ${param_list}
		${name}=         Set Variable     periodicCsiAcquisition:csirsNumberWithinReportPeriod_Set1
		${bsr_file}=     Set Variable If     '${w_bsr}' == 'true'     @{customBeamSetName}[${i}]
		...                                                           ${EMPTY}
		${scf_modifs}    create list
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:cellBwpList:bwpDN=@{bwp0}[${i}]|cellBwpId=0
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:cellBwpList:bwpDN=@{bwp1}[${i}]|cellBwpId=1
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:chBw=@{chBw}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:type0CoresetConfigurationIndex=@{type0CoresetConfigurationIndex}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:type0SearchSpaceConfigurationIndex=@{type0SearchSpaceConfigurationIndex}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:prachConfigurationIndex=@{prach}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:basicBeamSet=@{beamset}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actDlSrsBm=${actDlSrsBm}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actBeamforming=${actBeamforming}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actCsirsMultiplexing=${actCsirsMultiplexing}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actCellCsirsTddOnSsbBf=${actCellCsirsTddOnSsbBf}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actCellCsiRsImTddNonBf=${actCellCsiRsImTddNonBf}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actAdaptiveReTxResMcs=${actAdaptiveReTxResMcs}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:nrCellType=@{nrCellType}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:csirsForTracking:rbAllocation=${rbAllocation}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actBlankDlSymbBorderCoord=${actBlankDlSymbBorderCoord}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:msg1FrequencyStart=@{msg1FrequencyStart}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:periodicCsiAcquisition:csiReportPeriodicity=@{csiReportPeriodicity}[${i}]
            ...  modify:NRCELLGRP-@{nrCellGrplId}[${i}]:numberOfTransmittedSsBlocks=@{beams}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:csirsTrackingPeriod=${csirsTrackingPeriod}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:dlMimoMode=@{dlMimoMode}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actInfTddFrameMuting=${actInfTddFrameMuting}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actUeCsirsCoexistCellCsirs=${actUeCsirsCoexistCellCsirs}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actCsirsBeamPowerBalance=${actCsirsBeamPowerBalance}
