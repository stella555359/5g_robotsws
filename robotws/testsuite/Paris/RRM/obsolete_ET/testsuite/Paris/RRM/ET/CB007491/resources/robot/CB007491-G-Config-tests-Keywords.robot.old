    ...                             target_scf_path=${testCaseDir}/scf_modif.xml
    ...                             actual_scf_path=${testCaseDir}/scf_orig.xml
    ...                             delta_scf_path=${testCaseDir}/scf_delta.xml
    ${all_modifs}    Run Keyword If    '${w_calculate_delta_scf}'=='true'   Run Keywords     OperatingSystem.Get File  ${testCaseDir}/scf_delta.xml
    ...                                                                       AND            Dated log     calculate_delta_scf finished...
    ...                  ELSE                                               Set Variable     ${EMPTY}

    robot_extension.Run Keyword And Warn On Failure       Admin Validate SCF     scf_path_file=${testCaseDir}/scf_modif.xml

    Run Keyword If    '${w_commit}'=='true'     Dated log     perform_commissioning[${testCaseDir}/scf_modif.xml]...
    ${status}  Run Keyword If    '${w_commit}'=='true'    run keyword and return status
    ...      coam.perform_commissioning    bts_id=0    scf_file=${testCaseDir}/scf_modif.xml
    ...              skip_parameter_relation_errors=False    should_activate=True    timeout=300    connection=coam_gnb
    ...     ELSE     Set Variable    ${True}
    run keyword if   not(${status})  run keywords
    ...  Append To File   ${resultFile}    \nCommissioning FAILED\n
    ...  AND     Fail   Commissioning FAILED

    ${test_scf_file}             COAM Get SCF        local_dir_path=${LOG_PATH}      file=SCF.xml   alias=coam_gnb
    Set Suite Variable           ${test_scf_file}

