            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actUlSrsBm=${actUlSrsBm}
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:dmrsTypeAPosition=@{dmrsTypeAPosition}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:freqBandIndicatorNR=@{freqBandIndicatorNR}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:gscnOrSsPbchArfcn=@{gscnOrSsPbchArfcn}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:nrarfcn=@{nrarfcn}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actPerCsiReportBundlingTddFr1=${actPerCsiReportBundlingTddFr1}[${i}]
            ...  modify:NRCELL-@{nrCellId_9836_List}[${i}]:actEnhancedPDSCHSchSplSlot=${actEnhancedPDSCHSchSplSlot}[${i}]
            ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:periodicity=@{periodicityType2}[${i}]|searchSpaceType=Type2
            ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:slotOffset=@{slotOffsetType2}[${i}]|searchSpaceType=Type2
            ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:duration=@{durationType2}[${i}]|searchSpaceType=Type2
            ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:periodicity=@{periodicityType2}[${i}]|searchSpaceType=Type2
            ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:slotOffset=@{slotOffsetType2}[${i}]|searchSpaceType=Type2
            ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:duration=@{durationType2}[${i}]|searchSpaceType=Type2
            ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:periodicity=@{periodicityType0A}[${i}]|searchSpaceType=Type0A
            ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:slotOffset=@{slotOffsetType0A}[${i}]|searchSpaceType=Type0A
            ...  modify:@{bwp0}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:duration=@{durationType0A}[${i}]|searchSpaceType=Type0A
            ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:periodicity=@{periodicityType0A}[${i}]|searchSpaceType=Type0A
            ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:slotOffset=@{slotOffsetType0A}[${i}]|searchSpaceType=Type0A
            ...  modify:@{bwp1}[${i}]/PDCCH-1/PDCCH_CONFIG_COMMON-1:searchSpaceCommon:duration=@{durationType0A}[${i}]|searchSpaceType=Type0A
        Run Keyword If  '${w_bsr}' == 'true'     Append To List    ${scf_modifs}
        ...                        modify:NRCELL-@{nrCellId_9836_List}[${i}]:beamSet:customBeamSetName=@{customBeamSetName}[${i}]
        Run Keyword If  '${actDlSrsBm}' == 'true'   Append To List    ${scf_modifs}
        ...                        modify:NRCELL-@{nrCellId_9836_List}[${i}]:srsForBeamMgmt:cSRS=${cSRS['@{chBw}[${i}]']}
        Run Keyword If  '${w_cellcsirs}' == 'true'   Append To List    ${scf_modifs}
        ...                        modify:NRCELL-@{nrCellId_9836_List}[${i}]:beamSet:nrBtsBeamRefinementP2=false
