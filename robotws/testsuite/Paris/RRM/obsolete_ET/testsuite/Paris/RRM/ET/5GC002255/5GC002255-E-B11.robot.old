*** Variables ***
${TestSharkTool}      MC_SHARK

# variable set to ${True} to automatically save SOS report and OAM snapshot
# (by default, these information are saved only if a test is failed)
${ForceDebugDataCollection}    ${False}
#${ForceDebugDataCollection}    ${True}

@{CAslNone}          none
@{CAslFddFr1Tdd}     ca_Fdd_Fr1Tdd
&{B_18}          carrierAggregationSupportList=${CAslNone}
&{B_3}          carrierAggregationSupportList=${CAslFddFr1Tdd}


${SmallThroughput}     1  # rateUnit=kb
${MiddleThroughput}    1  # rateUnit=mb
${HighThroughput}     10  # rateUnit=mb

&{EB11}
...                                 flexibleCAMode=MixedCAMode    #No more needed, in UTe template
...                                 sCellActivationMethod=blind
...                                 actInterNumerologyCa=true
...                                 sCellAdditionMethod=blind
...                                 carrierAggregationSupportList=ca_Fdd_Fr1Tdd_Sa
...                                 pucchModeSelectTDD=longPucch
...                                 pucchModeSelectFDD=longPucch
...                                 maxNumScellsDl=1
...                                 sCellActivationLevel_NRCELL3=1TTI
...                                 sCellActivationLevel_NRCELL2=1TTI
...                                 sCellActivationMinDataThreshold_NRCELL3=6000
...                                 sCellActivationMinDataThreshold_NRCELL2=6000
...                                 sCellDeactivationTimerGNB_NRCELL3=infinity
...                                 sCellDeactivationTimerGNB_NRCELL2=infinity
...                                 primaryPathMaxQueueingDelay_NRCELL3=10
...                                 primaryPathMaxQueueingDelay_NRCELL2=0
...                                 secondaryPathMaxQueueingDelay_NRCELL3=10
...                                 secondaryPathMaxQueueingDelay_NRCELL2=10
...                                 cellDepType_NRCELL3=SA+NSA
...                                 cellDepType_NRCELL2=SA+NSA
...                                 actBeamforming_NRCELL3=false
...                                 actBeamforming_NRCELL2=false
...                                 actFdmScheduling=true
...                                 drxInactivityTimer_CELL3=100ms
...                                 drxLongCycle_CELL3=320
...                                 actCDrx_CELL3=true
...                                 actCDrx_CELL2=true

