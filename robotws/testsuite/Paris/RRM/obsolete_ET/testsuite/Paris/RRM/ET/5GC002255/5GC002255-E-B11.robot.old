*** Keywords ***

Set SCF Context
    [Arguments]                     ${subfeature}=none
    Dated log       ===================
    Dated log       SCF settings for ${subfeature}
    Dated log       ===================

    Copy File                      ${SCF_SETUP_PATH}     ${SCF_SETUP_PATH}.NewDRX
    ${newSCF}            Set Variable     ${SCF_SETUP_PATH}.NewDRX
    Dated log                         ${newSCF}

    SCF StartSession                  scf_file=${newSCF}

    SCF Set element      dist_name=${MRBTS}
    ...                  element_name=btsName
    ...                  element_value=SCFforEB11
    #Param1  #No more needed, in UTe template
    SCF Set element      dist_name=${dist_nameDU}
    ...                  element_name=flexibleCAMode
    ...                  element_value=${param.flexibleCAMode}

    #Param2
    SCF Set element      dist_name=${DU}
    ...                  element_name=sCellActivationMethod
    ...                  element_value=${param.sCellActivationMethod}

    #Param3
    SCF Set element      dist_name=${dist_nameDU}
    ...                  element_name=actInterNumerologyCa
    ...                  element_value=${param.actInterNumerologyCa}

    #Param4
    SCF Set element      dist_name=${Meth_name}
    ...                  element_name=sCellAdditionMethod
    ...                  element_value=${param.sCellAdditionMethod}

    #Param5
    ${casl}             create list     ${param.carrierAggregationSupportList}
    SCF Remove list            dist_name=${dist_nameDU}    list_name=carrierAggregationSupportList
    SCF Add list  dist_name=${dist_nameDU}  list_name=carrierAggregationSupportList
    SCF Add elements to list  dist_name=${dist_nameDU}
    ...                       list_name=carrierAggregationSupportList
    ...                       elements=${casl}

    #Param6
    SCF Set element      dist_name=${dist_name1}
    ...                  element_name=pucchModeSelect
    ...                  element_value=${param.pucchModeSelectTDD}

    #Param7
    SCF Set element      dist_name=${dist_name2}
    ...                  element_name=pucchModeSelect
    ...                  element_value=${param.pucchModeSelectFDD}

    #Param8
    SCF Set element      dist_name=${DU}
    ...                  element_name=maxNumScellsDl
    ...                  element_value=${param.maxNumScellsDl}

    #Param9
    SCF Set element      dist_name=${dist_name1}
    ...                  element_name=sCellActivationLevel
    ...                  element_value=${param.sCellActivationLevel_NRCELL3}

    #Param10
    SCF Set element      dist_name=${dist_name2}
    ...                  element_name=sCellActivationLevel
    ...                  element_value=${param.sCellActivationLevel_NRCELL2}

    #Param11
    SCF Set element      dist_name=${dist_name1}
    ...                  element_name=sCellActivationMinDataThreshold
    ...                  element_value=${param.sCellActivationMinDataThreshold_NRCELL3}

    #Param12
    SCF Set element      dist_name=${dist_name2}
    ...                  element_name=sCellActivationMinDataThreshold
    ...                  element_value=${param.sCellActivationMinDataThreshold_NRCELL2}

    #Param13
    SCF Set element      dist_name=${dist_name1}
    ...                  element_name=sCellDeactivationTimerGNB
    ...                  element_value=${param.sCellDeactivationTimerGNB_NRCELL3}

    #Param14
    SCF Set element      dist_name=${dist_name2}
    ...                  element_name=sCellDeactivationTimerGNB
    ...                  element_value=${param.sCellDeactivationTimerGNB_NRCELL2}

    #Param15
    SCF Set element      dist_name=${dist_name1}
    ...                  element_name=primaryPathMaxQueueingDelay
    ...                  element_value=${param.primaryPathMaxQueueingDelay_NRCELL3}

    #Param16
    SCF Set element      dist_name=${dist_name2}
    ...                  element_name=primaryPathMaxQueueingDelay
    ...                  element_value=${param.primaryPathMaxQueueingDelay_NRCELL2}

    #Param17
    SCF Set element      dist_name=${dist_name1}
    ...                  element_name=secondaryPathMaxQueueingDelay
    ...                  element_value=${param.secondaryPathMaxQueueingDelay_NRCELL3}

    #Param18
    SCF Set element      dist_name=${dist_name2}
    ...                  element_name=secondaryPathMaxQueueingDelay
    ...                  element_value=${param.secondaryPathMaxQueueingDelay_NRCELL2}

    #Param19
    SCF Set element      dist_name=${dist_name1}
