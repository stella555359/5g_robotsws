    Restart.WA Airscale Wait For Ready                  ${GNB_DU}


gNB_Startup_Ok_with_Flags
    [Tags]  RESTART_STARTUP                  _
    Restart.Restart TL


gNB_CellSetup_Ok_with_Flags
    [Tags]  Cell_Setup
    CallSetup.Setup Wtsemu SA


5GC002255_E_B11_1_RRC_Reconf_Req_DRX_drxLongCycle_Sup_80
    [Tags]  Check_DRXConfigInRRCReconf
    Traced sleep    20s  msg=short pause before register
    CallSetup.UE Register           ue=3
    Traced sleep   10s  msg=Pause 10s to avoid initial context setup failure
    CallSetup.Launch PDU Session  ue=3  pdu=3  gw=3
    Traced sleep   10s  msg=Pause to get all messages exchanges
    CallSetup.Empty Buffer For Egate
    Traced sleep   10s  msg=wait 10s for flush
    5GC002255_Keywords.5GC002255_Check_DRX_Mode    LongCycleStart=ms160   InactivityTimer=ms80


5GC002255_E_B11_3_RRC_Reconf_Resp_DRX_drxLongCycle_Sup_80
    Check rrc-transactionId


5GC002255_E_B11_5_Traffic_DL_UL_drxLongCycle_Sup_80
    [Tags]  SlowTraffic
    5GC002255_Keywords.Start Capture BIP ABIO 2slots
    wtsemu.trf_data_start    ue=3    pdu=3    qfi=1    dir=dl    trf_id=1   kbps=${SmallThroughput}
    Traced sleep   60s  msg=SlowTraffic on going, getting traces
    5GC002255_Keywords.Stop Capture L1L2
    Check_PsPeerCtrl_ScellUeSchedulingInd    ${CaptureL1L2.path}
    wtsemu.trf_data_start    ue=3    pdu=3    qfi=1    dir=dl    trf_id=2   mbps=${HighThroughput}
    wtsemu.trf_data_start    ue=3    pdu=3    qfi=1    dir=ul    trf_id=3   mbps=${MiddleThroughput}
    Traced sleep   10s  msg=pause to get the real throughput
    ${traffic_ul}      Get Average Traffic Rate  ue=3  pdu=3  qfi=1  trf_id=3  dir=ul
    ${traffic_dl}      Get Average Traffic Rate  ue=3  pdu=3  qfi=1  trf_id=2  dir=dl
    Dated Log  traffic dl: ${traffic_dl}  ${true}  2
    Dated Log  traffic ul: ${traffic_ul}  ${true}  2
    Should Be True    ${HighThroughput} * 900000 <= ${traffic_dl} <= ${HighThroughput} * 1100000
    Should Be True    ${MiddleThroughput} * 900000  <= ${traffic_ul} <= ${MiddleThroughput} * 1100000
    wtsemu.Trf Data Stop    ue=3  pdu=3  qfi=1  trf_id=2  dir=dl
    wtsemu.Trf Data Stop    ue=3  pdu=3  qfi=1  trf_id=3  dir=ul


5GC002255_E_B11_7_UE_Release_drxLongCycle_Sup_80
    [Tags]  restart traffic
    CallSetup.UE Deregister     id=3
    CallSetup.UE Register           ue=3
    CallSetup.Launch PDU Session  ue=3  pdu=3  gw=3
    5GC002255_Keywords.Start Capture BIP ABIO 2slots
    wtsemu.trf_data_start    ue=3    pdu=3    qfi=1    dir=dl    trf_id=1   mbps=${HighThroughput}
    wtsemu.trf_data_start    ue=3    pdu=3    qfi=1    dir=ul    trf_id=1   mbps=${MiddleThroughput}
    Traced sleep   10s  msg=pause to get the real throughput
    ${traffic_ul}      Get Average Traffic Rate  ue=3  pdu=3  qfi=1  trf_id=3  dir=ul
    ${traffic_dl}      Get Average Traffic Rate  ue=3  pdu=3  qfi=1  trf_id=2  dir=dl
    Dated Log  traffic dl: ${traffic_dl}  ${true}  2
    Dated Log  traffic ul: ${traffic_ul}  ${true}  2
    Should Be True    ${HighThroughput} * 900000 <= ${traffic_dl} <= ${HighThroughput} * 1100000
    Should Be True    ${MiddleThroughput} * 900000  <= ${traffic_ul} <= ${MiddleThroughput}* 1100000
    wtsemu.Trf Data Stop    ue=3  pdu=3  qfi=1  trf_id=2  dir=dl
    wtsemu.Trf Data Stop    ue=3  pdu=3  qfi=1  trf_id=3  dir=ul
    5GC002255_Keywords.Stop Capture L1L2
    Check_PsPeerCtrl_ScellUeSchedulingInd01    ${CaptureL1L2.path}


Check rrc-transactionId
    ${cmd}      Catenate
    ...                      cd ${tl.core.dir_path};
    ...                       grep -i drx-onDurationTimer -A 9 -B 15 egate_console.log
    ...                     | grep rrc-Tran
    ...                     | awk -F "rrc-TransactionIdentifier" '{print $2}'
    ...                     | awk -F "," '{print $1}'
    ...                     | tail -1
    #${rrctransacid-req}   common_frt.Ssh Execute With Timeout   command=${cmd}   connection=lteemu
    ${rrctransacid-req}     Connect.SSH Wait For Connect and Cmd  command=${cmd}  host=${HOST_EPCSIM}

    ${cmd}      Catenate
    ...                      cd ${tl.core.dir_path};
    ...                       grep -i rrcReconfigurationComplete -B 10 egate_console.log
    ...                     | grep rrc-Tran
    ...                     | awk -F "rrc-TransactionIdentifier" '{print $2}'
    ...                     | awk -F "," '{print $1}'
    ...                     | tail -1

    ${rrctransacid-resp}     Connect.SSH Wait For Connect and Cmd  command=${cmd}  host=${HOST_EPCSIM}

    should be equal        ${rrctransacid-req}    ${rrctransacid-resp}


Check_PsPeerCtrl_ScellUeSchedulingInd
   [Arguments]                     ${pcapFile}
    ${pdmlFile}=                    analyzer.pcap_to_pdml           ${pcapFile}
    ${drxon}                        set variable
    ...                             itf_l2_ps_peerctrl_ScellUeSchedulingInd.allocatedPucchList_item_0.isSentDuringDrxOn$
    #Dated Log                       pdmlFile=${pdmlFile}
    analyzer.check_list             pdmlFile=${pdmlFile}
    ...                             packetName=itf_l2_ps_peerctrl_ScellUeSchedulingInd
    ...                             path=${drxon}
    ...                             value=01
    ...                             kind=value
    ...                             test=MATCH


Check_PsPeerCtrl_ScellUeSchedulingInd01
   [Arguments]                     ${pcapFile}
   [Tags]
    ${pdmlFile}=                    analyzer.pcap_to_pdml           ${pcapFile}
    ${drxon}                        set variable
    ...                             itf_l2_ps_peerctrl_ScellUeSchedulingInd.allocatedPucchList_item_0.isSentDuringDrxOn$
    @{list_msg}       analyzer.get_match_from_path
    ...                             pdmlFile=${pdmlFile}
    ...                             packetName=itf_l2_ps_peerctrl_ScellUeSchedulingInd
    ...                             path=${drxon}
    ...                             debugFilter=True
   ${paquet}        set variable    ${list_msg[0]}
   @{listpathfound}   Get Dictionary Keys  ${paquet.fields}
   ${path}          set variable    ${listpathfound[0]}
   ${InitValue}     set variable    ${list_msg[0].fields['${path}'].value}
   ${equal}=         set variable    ${false}
   FOR    ${msg}    IN    @{list_msg}
       ${NewValue}  set variable   ${msg.fields['${path}'].value}
       ${equal}   Set Variable if     "${InitValue}"!="${NewValue}"  ${true}    ${equal}
   END
   Should Be True    ${equal}


Get Average Traffic Rate
    [Documentation]    Get Average Traffic Rate from bearer stat WTS function

    [Arguments]    ${ue}=1    ${pdu}=1    ${qfi}=1    ${trf_id}=1    ${dir}=dl
    ...            ${expected_data_rate}=5    ${deviation_in_percent}=5
    Dated log  Arguments : ${ue} ${pdu} ${qfi} ${trf_id} ${dir}

    wtsemu.Bearer Stats             ue=${ue}
    ...                             dir=${dir}                        trf_id=${trf_id}
    ...                             qfi=${qfi}                        pdu=${pdu}
    ${status}    ${output}     Run Keyword And Ignore Error            wtsemu.read_wtsemu_output_until
    ...                        expected=Average packet interval        timeout=20
    ${output}=                 Get Lines Containing String             ${output}          Average data rate
    ${output}=                 Replace String      ${output}      Average data rate       ${EMPTY}
    @{words}=                  Split String        ${output}      (
    ${average_out}=            Strip String        ${words[0]}
    [Return]    ${average_out}


Teardown 5GC002255_EB11
    [Documentation]    collect Sos Report if a TC is failed or if the user need traces ForceDebugDataCollection
    Dated log                       Teardown for 5GC002255_EB11
    Produce Scout Data
    Run Keyword If                  ${ForceDebugDataCollection}   Get Sos Report
    [Teardown]                      GenericTest.Display diagnosis