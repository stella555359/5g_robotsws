    ...     001105B29BA000000000000000000000000001AAAAA9AAAAA81142E230007104003898000001FE7FFFFFFFFD42E2300070A0003898000005FE7FFFFFFFFD42E2300070
    ...     A0003850000009FE7FFFFFFFFD42E2300070A020385010000DFE7FFFFFFFFC01C046808301320140283902448D0206C93E0448D0206C93E0448D0206C93E0448D0206C
    ...     93E001FFFF00005807C005038180603105806000783A0070300C06000040000600A00C07C02B24000002B24000008B240000100098095809594140264000004B292B20
