Change NR-UE${UE_ID} 3CC CA capabilities to support band combination CA_n41A-n66A-n77A with BR enabled on all cells
    ${ue_nr_3CC_FFT_CA_capabilities}=   Catenate    SEPARATOR=   F5A03C0047D4FFBEFFFFBAF0140782E0203C126BE7FFF6F800609B3CE3FF30C7942C020DC0407E380
    ...     A517C46FF9BCA3BC857C1043E59496201105B29BA01893EB1079127C245116F9F8053FF4FFCA2F831FF37947790AF82087CB292C40220B6537403127D620F224F848A2
    ...     2DF3F00A7FE9FF945F013FE6F28EF215F0410F965258804416CA6E80624FAC41E449F091445BE7E014FFD3FF28BE20FFCDE510857C1043E59496201105B29BA01893EB
