Library     OperatingSystem
Library     ute_fsmaccess
Library     ta_emss
Library     ute_wtssim
Library     ta_messaging
Library     ta5g_pm_counters
Library     ta5g_commissioning
Library     ta5g_cell_operations
Library     ta5g_testline_management
Library     taf.collectors.l2stream3     WITH NAME  tcl
Library     taf.collectors.core          WITH NAME  tcc
Library     taf.converters.eventdecoder  WITH NAME  tce
Library     ../../resources_KRK/python/traffic_handling.py
Resource    ../../resources_KRK/robot/common_keywords.robot

Variables   ta5g_global_var
Library     5GC002640_tti_trace_keywords.py
Library     5GC002640_resources.py
Variables   ta_messaging_filters_FTT.py
Variables   ta_messaging_filters_FFT.py

Library     taf.sw.scout                 WITH NAME    scout

*** Variables ***
${ENABLE_CP_RT_DEBUG_LOGS}=     0x590072=1 #ENABLE CP_RT DEBUG LOGS
${ENABLE_CP_NRT_DEBUG_LOGS}=    0x41001b=1 #ENABLE CP_NRT DEBUG LOGS
@{SWCONFIG_FLAGS_LIST}=         ${ENABLE_CP_RT_DEBUG_LOGS}    ${ENABLE_CP_NRT_DEBUG_LOGS}
${airphone_xml}=  ${CURDIR}/../config/gNB_BOO_AP_KLLL_FDD_TDD_1AEQE_6Cells_SANSA_L1B_3CC_CA_FTT/AirPhone_FDD_TDD_6Cells_L1B_SANSA_3CC_CA.xml
${CFG_DIR}=       ${EXECDIR}/testsuite/Paris/RRM/ET/5GC002640-AA/config

*** Keywords ***
Activate Beamforming on Cell ${NRCELL_ID}
    ${NRCELLGRP_ID}=    Evaluate    ${NRCELL_ID}-1
    Set Enb Parameter Value    nrcell_id    ${NRCELL_ID}
    Set Enb Parameter Value    nrcellgroup_id    ${NRCELLGRP_ID}
    Log to console  Activating Beamforming on Cell ${NRCELL_ID}
    Configure  ${CURDIR}/../config/delta_beamforming_activation.yaml  name=bf_activation_cell${NRCELL_ID}
    Wait for enb on air

Activate Beam Refinement on Cell ${NRCELL_ID}
    Log to console  Activating Beam Refinement on Cell ${NRCELL_ID}
    Configure  {'MOC': 'NRCELL', 'ID':'${NRCELL_ID}', 'beamSet': [{'nrBtsBeamRefinementP2': 'true'}]}  name=br_activation_cell${NRCELL_ID}
    Wait for enb on air

Deactivate Beam Refinement on Cell ${NRCELL_ID}
    Deconfigure    br_activation_cell${NRCELL_ID}

Change to 0 maximum queueing delay for primary path on Cell-${NRCELL_ID}
    Configure  {'MOC': 'NRCELL', 'ID': '${NRCELL_ID}', 'primaryPathMaxQueueingDelay': '0'}

Change to 0 maximum queueing delay for secondary path on Cell-${NRCELL_ID}
    Configure  {'MOC': 'NRCELL', 'ID': '${NRCELL_ID}', 'secondaryPathMaxQueueingDelay': '0'}

Bring back maximum queueing delay
    Deconfigure all

Get eNB SW release
    ${Swversion}=  Get eNB SW Version  alias=gNB2
    ${Swrelese}=  Get Substring  ${Swversion}  0  8
    [Return]    ${Swrelese}

# ------------ Register and Deregister NR-UE ------------
Change NR-UE${UE_ID} 3CC CA capabilities to support band combination CA_n41A-n71A-n77A, CA_n41A-n66A-n71A, CA_n41(2A)-n71A, CA_n41C-n71A
