*** Test Cases ***

[1][1.0] 5GC001248_M_78_maxNumberMIMO-LayersPDSCH capability check case 1
    5GC001248_M_Generic_TC          ue_capas=${UE_CAPA_NO_MIMO_LAYERS}       expected_layers_rrc=1      expected_rank_bip=1

    # Sleep 5 mn in case of GP overlap
    Traced Sleep  ${auto_1248_gp_period} minutes       msg=GP overlap

    # Retrieve counters and compare with a reference
    # Verify Object Counter cumulative values
    ${status}             Run Keyword If        '${auto_1248_check_counters}' == 'True'
    ...                                         Verify Counter Cumulative Values With Margin for 1248_M         TC_name=5GC001248_M_1

[1][1.0] 5GC001248_M_79_maxNumberMIMO-LayersPDSCH capability check case 2
    5GC001248_M_Generic_TC          ue_capas=${UE_CAPA_MIMO_2_LAYERS}       expected_layers_rrc=2      expected_rank_bip=2

    # Sleep 5 mn in case of GP overlap
    Traced Sleep  ${auto_1248_gp_period} minutes       msg=GP overlap

    # Retrieve counters and compare with a reference
    # Verify Object Counter cumulative values
    ${status}             Run Keyword If        '${auto_1248_check_counters}' == 'True'
    ...                                         Verify Counter Cumulative Values With Margin for 1248_M         TC_name=5GC001248_M_2


*** Keywords ***

5GC001248_M_Generic_TC
   [Documentation]            Common KW for 1248 M checks

   [Arguments]                     ${ue_capas}
   ...                             ${expected_layers_rrc}
   ...                             ${expected_rank_bip}

    # Set MIMO layers inside UE capabilities inside UE configuration file
    Modify Field in WtsEmu Cfg File     field=ue_nr_capabilities    value=${ue_capas}
    Modify Field in WtsEmu Cfg File     field=ue_eutra_nr_capabilities    value=${eutra_nr_with_CAClass}

    Restart TL

    ${CaptureBIP}                   Capture L1L2 Set Upon Config             airscale=${GNB_DU}

    WTS Setup

    UE Cell Setup Check

    Run Keyword If                  ${enable_sherpa}==${True}               Sherpa.Activate Sherpa

    # Attach to 5G
    ${CaptureCorePath}              SgNB Addition to ENB            ueSetting=${UE_SIMPLE}

    # Seems not to be useful till now
    Run Keyword If                  '${expected_rank_bip}'=='0x02'
    ...                             Update RI reported values       ueSetting=${UE_SIMPLE}      ri_value=1

    # Check nb of MIMO layers is set to 2 by gNB inside reconfiguration message:
    ${pdmlFile}=                    analyzer.pcap_to_pdml          ${CaptureCorePath}

    analyzer.check_list             pdmlFile=${pdmlFile}
    ...                             packetName=SgNBAdditionRequestAcknowledge
    ...                             path=.*/nr-rrc.pdsch_ServingCellConfig/.*/nr-rrc.maxMIMO_Layers$
    ...                             value=${expected_layers_rrc}

    Capture Init                    ${CaptureBIP}                                   withTN=True
    ${CaptureBIP.filter}            Get Filter For Particular Msgs                  bipMsgList=${bipMsgfilter}

    Traffic UE DL                   throughput=5
    ...                             captureCallback=Callback Capture L1L2
    ...                             capture=${CaptureBIP}
    ...                             duration=60s
    ...                             deviation=5

    # UE Detach
    UE Detach Enb                   ueSetting=${UE_SIMPLE}

    Dated log                       Checking DL rank in BIP messages

    # Filter SIB / MIB message with RNIT = 0xFFFF
    ${filterExp}=                   Set Variable                    (dldata_pdschsendreq)&&!(3gpp.rnti==0xffff)

    ${filterPcap}                   analyzer.filter_pcap            ${CaptureBIP.path}
    ...                             filterName=${filterExp}
    ...                             filterExp=${filterExp}
    ${pdmlFileBIP}=                 analyzer.pcap_to_pdml           ${filterPcap}

    analyzer.check_list             pdmlFile=${pdmlFileBIP}
    ...                             packetName=DlData_PdschGrant
    ...                             path=.numOfLayers$
    ...                             value=${expected_rank_bip}
    ...                             startPacket=${1}
    ...                             endPacket=${10}
