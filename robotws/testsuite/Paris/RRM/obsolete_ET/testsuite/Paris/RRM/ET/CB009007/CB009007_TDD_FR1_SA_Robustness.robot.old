*** Variables ***

@{Cell_Id_1CC}=       1
@{Cell_Id_2CC}=       3    6
@{Cell_Id_inCA}=      1    3    6

#Robustness TC16
${Num_Of_UE}         5
${gNbID}             2
${cellID}            1
${num_iteration}     10


&{1116_1Pdcch_Robustness}
...                                    dir=DL_Max
...                                    throughput=100
...                                    actEnhancedPDSCHSchSplSlot=true     # CB009007 activation
...                                    CA=Off                              # CA option
...                                    frameStructureType=tdLte            # framestructure tdLte > frame structure 1116
...                                    guardPeriodLength=4Symbols          # framestructure
...                                    ulDlDataSlotRatio=4/6               # framestructure
...                                    lteToNrFrameShift=0ms               # framestructure > mandatory tdLte
...                                    tdLteUlDlConfig=tdLteConfig2        # framestructure > mandatory tdLte
...                                    CsiRs=0                             # Add CSI-RS on special slot (0=no 1=yes)
...                                    actCceSplit=true                    # Force 2 Pdcch symbols when set to false
...                                    prachConfigurationIndex=97
...                                    ue_nr_capa=${SA_TDD_DEFAULT}
...                                    sliv=57


