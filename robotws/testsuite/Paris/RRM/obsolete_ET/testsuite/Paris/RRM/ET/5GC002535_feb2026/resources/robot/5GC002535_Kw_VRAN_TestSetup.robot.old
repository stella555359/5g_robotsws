...                   rdEnableFDMPdschDmrs_0x5801a6=1

*** Keywords ***

##################################################################################

add VRAN Param to Modify Param list
   [Arguments]      ${value}    ${dist_name}    ${p_name}    ${nodeType}    ${ListParamterToModify}
   &{params}      Create Dictionary  dist_name=${dist_name}
   ...                               p_name=${p_name}
   ...                               value=${value}
   ...                               nodeType=${nodeType}
   Append To List   ${ListParamterToModify}    ${params}
   # Dated log     ListParamterToModify=${ListParamterToModify}
   [return]    ${ListParamterToModify}

Modify VRAN ListParams to scf
    [Documentation]   Modify List param. report error If not present
    [Arguments]   ${parameters_lists}   ${scf_file_path}     ${scf_file_path_cu}=${EMPTY}
    scf.Load scf    ${scf_file_path}
    run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Load scf    ${scf_file_path_cu}
    FOR    ${item}    IN    @{parameters_lists}
        ${res}    scf.is_element_in_object    dist_name=${item}[dist_name]    p_name=${item}[p_name]   nodeType=${item}[nodeType]
        Run Keyword If    '${res}'=='True'     scf.modify_scf_element    value=${item}[value]   &{item}
        ...      ELSE                          scf.add element to scf
        ...          value=${item}[value]   dist_name=${item}[dist_name]    p_name=${item}[p_name]    nodeType=${item}[nodeType]
    END
    scf.Save scf    ${scf_file_path}      nodeType=Vdu
    run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Save scf    ${scf_file_path_cu}      nodeType=Vcu

add NSA PDCCH 5MHz cellBwpList to SCF
    [Arguments]    ${scf_file_path}     ${scf_file_path_cu}=${EMPTY}
    log to console    Add NSA PDCCH 5MHz cellBwpList to SCF
    scf.Load scf    ${scf_file_path}
    run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Load scf    ${scf_file_path_cu}
    ${dist_name}  set variable  MRBTS-1/NRBTS-1/NRCELL-1
    ${result}  scf.is_list_in_object  dist_name=${dist_name}     list_name=cellBwpList     nodeType=VcuVdu
    run keyword if    ${result}==True    scf.remove_list_from_scf  dist_name=${dist_name}   list_name=cellBwpList    nodeType=VcuVdu
    scf.add list to scf  dist_name=${dist_name}   list_name=cellBwpList    nodeType=VcuVdu
    FOR    ${item}    IN    @{SANSA_5MHZ_LIST_ELEMENTS_PARAMS_TO_ADD}
         scf.add item to list  dist_name=${item}[dist_name]   list_name=${item}[list_name]    elements=${item}[elements]   nodeType=${item}[nodeType]
    END
    scf.Save scf    ${scf_file_path}      nodeType=Vdu
    run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Save scf    ${scf_file_path_cu}      nodeType=Vcu
    [Return]    ${scf_file_path}    ${scf_file_path_cu}

get Vdu Cell summary
   [Documentation]     [PRIVATE]  get Vdu Cell Info
   ${aliasGNB}                     OAM Connect                          ${GNB_DU.oam}
   ${vdu_cells_summary}=    vdu.get_vdu_cells_summary    vdu_connection=${aliasGNB}
   Dated log       vdu_cells_summary=${vdu_cells_summary}
   ${Nbr Cell locked}     set variable     ${vdu_cells_summary['basic_cells_summary']['administrative_state']['locked']}
   ${Nbr Cell unlocked}   set variable     ${vdu_cells_summary['basic_cells_summary']['administrative_state']['unlocked']}
   Dated log      get Vdu Cell summary ----> Nbr Cell locked=${Nbr Cell locked}
   Dated log      get Vdu Cell summary ----> Nbr Cell unlocked=${Nbr Cell unlocked}
   robot_extension.Run Keyword And Warn On Failure    OAM Disconnect                 ${GNB_DU.oam}
   # ${status}   ${message}           run keyword and ignore error       OAM Disconnect                 ${GNB_DU.oam}
   # run Keyword if      '${status}' == 'FAIL'   Log to console    Keyword failed
   [return]   ${Nbr Cell locked}   ${Nbr Cell unlocked}

Test Line Preparation
   [Arguments]       ${testParam}

   Log to Console like Next Step    0    ${SUITE NAME} - ${TEST NAME.replace(" ", "_")}

   PrintTLInformation
   gNB BackupSCF

   # duplexMode not correclty filled => need to force here
   set suite variable     ${duplexMode}       FDD

   ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF_DU.xml      oam=${GNB_DU.oam}
   Set Suite Variable              ${test_scf_file}
   ${test_scf_file_cu}             OAM Get SCF File         dir=${LOG_PATH}      file=SCF_CU.xml      oam=${GNB_CU.oam}
   Set Suite Variable              ${test_scf_file_cu}

   ${cellDepType}=   5GC002535_Kw_TestSetup.get cellDepType from SCF    nodeType=Vdu
   ${testParam.Context.cellDepType}      set variable    ${cellDepType}

   Return From Keyword If    "${testParam.Context.cellDepType}" == "SANSA"

   # Get current  SCF file
   5GC002535_Keywords.Prepare Logs Directory Path    resultDir=${LOG_PATH}    subdir=PDCCH_delete
   ${default_local_scf_file_path_DU}      OAM Get SCF File    dir=${LOG_PATH}/PDCCH_delete/
   ...                                                        file=SCF_used_for_2535_Tests_FirstCommissioning_DU.xml   oam=${GNB_DU.oam}
   ${default_local_scf_file_path_CU}      OAM Get SCF File    dir=${LOG_PATH}/PDCCH_delete/
   ...                                                        file=SCF_used_for_2535_Tests_FirstCommissioning_CU.xml    oam=${GNB_CU.oam}
   Set Suite Variable              ${default_local_scf_file_path_DU}
   Set Suite Variable              ${default_local_scf_file_path_CU}

   # Need to change MRBTS-0/NRBTS-0 or whatever the MRBTS- / NRBTS-  with MRBTS-1 / NRBTS-1
   Dated Log New Line  =====> gNB_ModifySCF NRBTS-${NRBTS_ID_CU} with NRBTS-1 and MRBTS-${MRBTS_ID_CU} with MRBTS-1 [CU and DU SCF]
   Dated Log           =====> gNB_ModifySCFwithNewNRBTS nrbtsID_original=NRBTS-${NRBTS_ID_CU} with nrbtsID_new=NRBTS-1 [DU SCF]
   5GC002535_Kw_TestSetup.gNB_ModifySCFwithNewNRBTS   ${default_local_scf_file_path_DU}    nrbtsID_original=NRBTS-${NRBTS_ID_CU}  nrbtsID_new=NRBTS-1
   Dated Log           =====> gNB_ModifySCFwithNewMRBTS mrbtsID_original=MRBTS-${MRBTS_ID_CU} with mrbtsID_new=MRBTS-1 [DU SCF]
   5GC002535_Kw_TestSetup.gNB_ModifySCFwithNewMRBTS   ${default_local_scf_file_path_DU}    mrbtsID_original=MRBTS-${MRBTS_ID_CU}  mrbtsID_new=MRBTS-1
   Dated Log           =====> gNB_ModifySCFwithNewMRBTS nrbtsID_original=NRBTS-${NRBTS_ID_CU} with nrbtsID_new=NRBTS-1 [CU SCF]
   5GC002535_Kw_TestSetup.gNB_ModifySCFwithNewNRBTS   ${default_local_scf_file_path_CU}    nrbtsID_original=NRBTS-${NRBTS_ID_CU}  nrbtsID_new=NRBTS-1
   Dated Log           =====> gNB_ModifySCFwithNewMRBTS mrbtsID_original=MRBTS-${MRBTS_ID_CU} with mrbtsID_new=MRBTS-1 [CU SCF]
   5GC002535_Kw_TestSetup.gNB_ModifySCFwithNewMRBTS   ${default_local_scf_file_path_CU}    mrbtsID_original=MRBTS-${MRBTS_ID_CU}  mrbtsID_new=MRBTS-1

   # here the reference is MRBTS-1/NRBTS-1
   ${local_path_scf_file_DU}   ${local_path_scf_file_CU}   Delete PDCCH Information If Exist    scf_file_path_du=${default_local_scf_file_path_DU}
   ...                                                                                          scf_file_path_cu=${default_local_scf_file_path_CU}
   ...                                                                                          nodeType=VcuVdu
   Set Suite Variable              ${local_path_scf_file_DU}
   Set Suite Variable              ${local_path_scf_file_CU}

    ${local_path_scf_file_with_pdcch_info_DU}    ${local_path_scf_file_with_pdcch_info_CU}    Add PDCCH information to scf
   ...                                                                            scf_file_path=${local_path_scf_file_DU}
   ...                                                                            scf_file_path_cu=${local_path_scf_file_CU}
   ...                                                                            nodeType=VcuVdu

   Set Suite Variable              ${local_path_scf_file_with_pdcch_info_DU}
   Set Suite Variable              ${local_path_scf_file_with_pdcch_info_CU}

   # NSA case only
   add NSA PDCCH 5MHz cellBwpList to SCF     ${local_path_scf_file_with_pdcch_info_DU}     ${local_path_scf_file_with_pdcch_info_CU}

   Dated Log  =====> gNB_ModifySCF NRBTS-1 with NRBTS-${NRBTS_ID_CU} and MRBTS-1 with MRBTS-${MRBTS_ID_CU} [CU and DU SCF]
   5GC002535_Kw_TestSetup.gNB_ModifySCFwithNewNRBTS   ${local_path_scf_file_with_pdcch_info_DU}    nrbtsID_original=NRBTS-1
   ...                                                                                             nrbtsID_new=NRBTS-${NRBTS_ID_CU}
   5GC002535_Kw_TestSetup.gNB_ModifySCFwithNewMRBTS   ${local_path_scf_file_with_pdcch_info_DU}    mrbtsID_original=MRBTS-1
   ...                                                                                             mrbtsID_new=MRBTS-${MRBTS_ID_CU}
   5GC002535_Kw_TestSetup.gNB_ModifySCFwithNewNRBTS   ${local_path_scf_file_with_pdcch_info_CU}    nrbtsID_original=NRBTS-1
   ...                                                                                             nrbtsID_new=NRBTS-${NRBTS_ID_CU}
   5GC002535_Kw_TestSetup.gNB_ModifySCFwithNewMRBTS   ${local_path_scf_file_with_pdcch_info_CU}    mrbtsID_original=MRBTS-1
   ...                                                                                             mrbtsID_new=MRBTS-${MRBTS_ID_CU}

   # 28/02/2022 : dlDMRSAdditionalPosition and ulDMRSAdditionalPosition are set during full Commissioning
   # Oam set param dont work for dlDMRSAdditionalPosition and ulDMRSAdditionalPosition !!!
   @{ListParamterToModify}=    create list
   ${ListCellParamterToModify}=    add VRAN Param to Modify Param list
   ...    value=${testParam.scfFile.nrcell.dlDMRSAdditionalPosition}
   ...    dist_name=${NRCELL_DIST_NAME}
   ...    p_name=dlDMRSAdditionalPosition
   ...    nodeType=Vdu
   ...    ListParamterToModify=${ListParamterToModify}
   ${ListCellParamterToModify}=    add VRAN Param to Modify Param list
   ...    value=${testParam.scfFile.nrcell.ulDMRSAdditionalPosition}
   ...    dist_name=${NRCELL_DIST_NAME}
   ...    p_name=ulDMRSAdditionalPosition
   ...    nodeType=Vdu
   ...    ListParamterToModify=${ListParamterToModify}
   Dated log  =====> ListParamterToModify=${ListCellParamterToModify}
   Modify VRAN ListParams to scf    ${ListCellParamterToModify}   scf_file_path=${local_path_scf_file_with_pdcch_info_DU}

   # add here lock of CELL2 and RU2 into CU and DU
   @{ListParamterToModify}=    create list
   ${ListCellParamterToModify}=    add VRAN Param to Modify Param list
   ...    value=Locked
   ...    dist_name=MRBTS-${MRBTS_ID_CU}/EQM-1/APEQM-1/RMOD-2
   ...    p_name=administrativeState
   ...    nodeType=Vdu
   ...    ListParamterToModify=${ListParamterToModify}
   ${ListCellParamterToModify}=    add VRAN Param to Modify Param list
   ...    value=Locked
   ...    dist_name=MRBTS-${MRBTS_ID_CU}/NRBTS-${NRBTS_ID_CU}/NRCELL-2
   ...    p_name=administrativeState
   ...    nodeType=VduVcu
   ...    ListParamterToModify=${ListParamterToModify}
   Dated log  =====> ListParamterToModify=${ListCellParamterToModify}
   Modify VRAN ListParams to scf    ${ListCellParamterToModify}
   ...                              scf_file_path=${local_path_scf_file_with_pdcch_info_DU}
   ...                              scf_file_path_cu=${local_path_scf_file_with_pdcch_info_CU}

   # add static route in Scf for TtiTrace if needed
   ${res_cmd}=   VRAN K8s Cmd     k8s=${GNB_CU}    podName=upue-0     containerName=nwmgmt    cmd=ip a show f1u   w_debug=${False}
   # to manage Ipv4/Ipv6 in the furure
   ${ipAddressF1Up_CU}=  Parse Ipv4 Address Only From Content    ${res_cmd}
   # ${ipAddressF1Up_CU}    ${f1u_mask}    Parse Ipv6 Address    ${res_cmd}
   ${destIpAddr}=   set variable   ${GNB_X2_IPV4_GW}
   Dated log  =====> Add Static route for TtiTraces [destIpAddr=${destIpAddr} gateway=${ipAddressF1Up_CU}]
   ${add_route}  ${local_path_scf_file_with_pdcch_info_DU}=   Online Add TTITrace Receiver Route
   ...                                                                             scf_file_path=${local_path_scf_file_with_pdcch_info_DU}
   ...                                                                             destIpAddr=${destIpAddr}
   ...                                                                             ipAddressF1Up_CU=${ipAddressF1Up_CU}
   ...                                                                             nodeType=Vdu
   run Keyword if    '${add_route}'=='PASS'    dated log    add_route in scf=${add_route}
   ...   ELSE                                  dated log    Static Route for TtiTrace already in scf
   dated log    scf_file_with_fullpath_DU=${local_path_scf_file_with_pdcch_info_DU}

   Run Keyword If        '${SHOULD_BE_COMMISSIONED_GNB_FIRST}' == '1'    run Keywords
   ...                                                                       Dated log         =====> Start DU Scf Commissioning...      AND
   ...                                                                       Commissioning SCF      ${local_path_scf_file_with_pdcch_info_DU}
   ...                                                                                             oam=${GNB_DU.oam}
   ...                                                                                             w_TlRestart=False
   ...     ELSE        Dated log     gNB DU not Commissioning because SHOULD_BE_COMMISSIONED_GNB_FIRST==0
   Run Keyword If        '${SHOULD_BE_COMMISSIONED_GNB_FIRST}' == '1'   run Keywords
   ...                                                                       Dated log         =====> Start CU Scf Commissioning...      AND
   ...                                                                       Commissioning SCF      ${local_path_scf_file_with_pdcch_info_CU}
   ...                                                                                             oam=${GNB_CU.oam}
   ...                                                                                             w_TlRestart=False
   ...     ELSE        Dated log     gNB CU not Commissioning because SHOULD_BE_COMMISSIONED_GNB_FIRST==0
   Run Keyword If        '${SHOULD_BE_COMMISSIONED_GNB_FIRST}' == '1'       Get GNB BTS Info

   # get Vdu Cell info and update context
   ${Nbr_Cell_locked}   ${Nbr_Cell_unlocked}=     get Vdu Cell summary
   Update cell state with "${Nbr_Cell_unlocked}" and "${Nbr_Cell_locked}" into "${testParam}"

   # SCF.xml is used by procedure verifyFeatureActivation
   ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
   Set Suite Variable              ${test_scf_file}
   Dated Log                  Current 2535 SCF file stored to ${test_scf_file}

Get BTS ID From vDU SCF
    [Arguments]  ${scf_path}
    [Documentation]   Get BTS ID From vDU SCF
    ...    | Input Parameters | Man. | Description |
    ...    | scf_path | yes | scf file with absolute path, it's vDU scf file. |
    ...    *RETURN VALUE*
    ...    list value, contains [<mrbts_id>, <nrbts_id>, <nrdu_id>]
    ...
    ...    Example
    ...    |  ${mrbts_id}  | ${nrbts_id} | ${nrdu_id} | Get BTS ID From vDU SCF | scf_path=/tmp/a.scf |
    ...
    ${scf_content}   OperatingSystem.Get File   ${scf_path}
    ${result}     Get Regexp Matches    ${scf_content}   .*NRDU"\\s+distName="MRBTS-(\\d+)/NRBTS-(\\d+)/NRDU-(\\d+)"\\s+.*   1  2  3
    ${mrbts_id}  Set Variable If  ${result}   ${result[0][0]}
    ${nrbts_id}  Set Variable If  ${result}   ${result[0][1]}
    ${nrdu_id}   Set Variable If  ${result}   ${result[0][2]}
    [Return]  ${mrbts_id}   ${nrbts_id}  ${nrdu_id}

Online Add TTITrace Receiver Route
    [Arguments]    ${destIpAddr}   ${scf_file_path}=${EMPTY}   ${gnb_index}=0    ${vdu_index}=0   ${ipAddressF1Up_CU}=${EMPTY}  ${nodeType}=Classical
    ${scf_file_with_fullpath}    run Keyword if   '${scf_file_path}'=='${EMPTY}'
    ...                    5GC002535_Keywords.Get Temporary Scf From Current Plan    gnb_index=${gnb_index}   vdu_index=${vdu_index}
    ...  ELSE                    set variable      ${scf_file_path}
    scf.Load_Scf     ${scf_file_with_fullpath}
    ${mrbts_id}   ${nrbts_id}  ${nrdu_id}  Get BTS ID From vDU SCF    scf_path=${scf_file_with_fullpath}
    set test variable    ${mrbts_id}
    set test variable    ${nrbts_id}
    # to improve later with final UTE __init__ file => how to detect ipv4 / ipv6 !!!
    # ${oam_ip}   Get vDU OAM Ip   gnb_index=${gnb_index}   vdu_index=${vdu_index}
    # ${ip_type}   lib.check_ip_type    ${oam_ip}
    ${ip_type}    Set Variable   ipv4
    ${route_name}  Set Variable If  "${ip_type}"=="ipv4"  IPRT  IPRTV6
    # RETURN VALUE of TNL id of given templateType
    ${tnl_id}=   Get vDU TNL ID   scf_path=${scf_file_with_fullpath}    templateType=5GUserPlane   nodeType=${nodeType}
    # ${tnl_id}=     set variable    3
    ${dist}   set variable    MRBTS-${mrbts_id}/TNLSVC-1/TNL-${tnl_id}/IPNO-1/${route_name}-1
    ${add_route}   ${gateway}=   Check TTITrace Receiver Route Exist    ${destIpAddr}    ${dist}   ${scf_file_with_fullpath}   nodeType=${nodeType}
    run keyword if  "${add_route}"=="PASS"    Dated log     Route to TTITrace Receiver is needed, add the route
    ${gateway_f1up_vcu}=    set variable if   '${ipAddressF1Up_CU}'!='${EMPTY}'     ${ipAddressF1Up_CU}
    ...                                                                             ${ipAddressF1Up_CU_DEFAULT}
    ${scf_file_with_fullpath}=   run keyword if  "${add_route}"=="PASS"     Vdu Add Route   ${dist}    ${destIpAddr}  32  ${gateway_f1up_vcu}
    ...                                                                                     scf_file_path=${scf_file_path}
    ...                                                                                     nodeType=${nodeType}
    ...  ELSE                                                               set variable    ${scf_file_with_fullpath}
   [Return]    ${add_route}  ${scf_file_with_fullpath}

Check TTITrace Receiver Route Exist
    [Arguments]    ${destIpAddr}   ${dist}  ${scf_full_path}   ${ip_type}=ipv4   ${nodeType}=Classical
    scf.Load Scf   ${scf_full_path}
    ${route_dstip_name}    Set Variable If  "${ip_type}"=="ipv4"  destIpAddr  destIpv6Addr
    ${route_gateway_name}  Set Variable If  "${ip_type}"=="ipv4"  gateway   gatewayIpv6Addr
    ${res}  ${dest_ip}   Run Keyword And Ignore Error  scf.Get All Values From Scf   dist_name=${dist}
    ...  p_name=${route_dstip_name}    nodeType=${nodeType}
    ${res}  ${gateway}   Run Keyword And Ignore Error  scf.Get All Values From Scf   dist_name=${dist}
    ...  p_name=${route_gateway_name}       nodeType=${nodeType}
    ${res}  ${out}  Run Keyword And Ignore Error   Should Not Contain Match   ${dest_ip[0]}    ${destIpAddr}
    [return]    ${res}    ${gateway[0]}

add staticRoutes to SCF
    [Arguments]    ${scf_file_path}  ${dist_name}='MRBTS-0/TNLSVC-1/TNL-3/IPNO-1/IPRT-1'  ${LIST_ITEMS_PARAMS_TO_ADD}=${EMPTY}  ${nodeType}=Classical
    log to console    Add staticRoutes to SCF
    scf.Load scf    ${scf_file_path}
    ${dist_name_}  set variable  ${dist_name}
    ${result}  scf.is_list_in_object  dist_name=${dist_name_}     list_name=staticRoutes    nodeType=${nodeType}
    run keyword if    ${result}==True    scf.remove_list_from_scf  dist_name=${dist_name_}   list_name=staticRoutes    nodeType=${nodeType}
    scf.add list to scf  dist_name=${dist_name_}   list_name=staticRoutes   nodeType=${nodeType}
    FOR    ${item}    IN    @{LIST_ITEMS_PARAMS_TO_ADD}
        scf.add item to list  dist_name=${item}[dist_name]    list_name=${item}[list_name]   elements=${item}[elements]  nodeType=${item}[nodeType]
    END
    scf.Save scf    ${scf_file_path}    nodeType=${nodeType}
    [Return]    ${scf_file_path}

Vdu Add Route
    [Arguments]   ${dist}   ${destIpAddr}  ${PrefixLength}  ${gateway}  ${preference}=8   ${scf_file_path}=${EMPTY}
    ...               ${gnb_index}=0  ${vdu_index}=0  ${nodeType}=Classical
    [Documentation]    Add static route for vdu
    ...    Add static route for vdu
    ...    | Input Parameters | Man. | Description |
    ...    | dist    | yes | distname to add static route |
    ...    | destIpAddr   | yes | destIpAddr for static route |
    ...    | PrefixLength   | yes | PrefixLength for static route |
    ...    | gateway   | yes | gateway for static route |
    ...    | preference   | no | preference for static route, default is 8 |
    ...
    ...    *RETURN VALUE*
    ...   list of route info  [static route distname,  staticRoutes/index]
    ...

    ${route_list_name}  Set Variable If  ':' in '''${destIpAddr}'''     staticIpv6Routes                staticRoutes
    ${route_dstip_name}  Set Variable If  ':' in '''${destIpAddr}'''    destIpv6Addr                    destIpAddr
    ${route_prefix_name}  Set Variable If  ':' in '''${destIpAddr}'''   destinationIpv6PrefixLength     destinationIpPrefixLength
    ${route_gateway_name}  Set Variable If  ':' in '''${destIpAddr}'''  gatewayIpv6Addr                 gateway

    ${scf_file_with_fullpath}    run Keyword if   '${scf_file_path}'=='${EMPTY}'
    ...                        5GC002535_Keywords.Get Temporary Scf From Current Plan    gnb_index=${gnb_index}   vdu_index=${vdu_index}
    ...   ELSE                 set variable      ${scf_file_path}
    scf.Load Scf   ${scf_file_with_fullpath}
    ${res}  Run Keyword And Ignore Error  scf.Get All Values From Scf   dist_name=${dist}   p_name=${route_gateway_name}   nodeType=${nodeType}
    ${length}   Run Keyword If  '${res[0]}'=='PASS'   Get Length   ${res[1]}
    ...   ELSE                                        Set Variable  0

    &{elt}=     Create Dictionary   ${route_gateway_name}=${gateway}
    ...                             ${route_dstip_name}=${destIpAddr}
    ...                             ${route_prefix_name}=${PrefixLength}
    ...                             preference=${preference}
    # ${dist}    set variable    MRBTS-0/TNLSVC-1/TNL-3/IPNO-1/IPRT-1
    ${param}=   Evaluate  {'dist_name': '${dist}','list_name': '${route_list_name}','elements': &{elt},'nodeType': '${nodeType}'}
    @{params}=   Create List         ${param}

    add staticRoutes to SCF    scf_file_path=${scf_file_with_fullpath}
    ...                        dist_name=${dist}
    ...                        LIST_ITEMS_PARAMS_TO_ADD=${params}
    ...                        nodeType=${nodeType}

    [Return]   ${scf_file_with_fullpath}

VRAN Get Pod
    [Arguments]                     ${k8s}    ${name}
    Dated log                       GET POD[${k8s.name}, name=${name}]
    ${pod}                          K8s Get Pod      k8s=${k8s}             name=${name}
    Dated log                       RESULT=${pod}

VRAN Get Container
    [Arguments]                     ${k8s}    ${name}       ${podName}=${None}
    Dated log                       GET Container[${k8s.name}, name=${name}, podName=${podName}]
    ${container}                    K8s Get Container       k8s=${k8s}       name=${name}    podName=${podName}
    Dated log                       RESULT=${container}

VRAN K8s Cmd
    [Arguments]                     ${k8s}          ${podName}         ${containerName}
    ...                             ${cmd}          ${w_debug}=${False}
    run Keyword if   '${w_debug}'=='${True}'
    ...                        Dated log       K8s cmd:k8s=${k8s.name} POD=${podName} CONT=${containerName} CMD=[${cmd}] DEBUG=${w_debug}
    ${res}                          K8s cmd
    ...                             k8s=${k8s}      podName=${podName}     containerName=${containerName}
    ...                             cmd=${cmd}      debug=${w_debug}
    run Keyword if   '${w_debug}'=='${True}'     Dated log                       K8s cmd:RES=[${res}]
    [Return]                        ${res}

Get Vcu Ip address
    [Arguments]    ${pod_abbr}    ${container}   ${interface}   ${w_debug}=${False}
    [Documentation]    Vcu get ip address for container
    ...    Vcu get ip address for container
    ...    | Input Parameters | Man. | Description |
    ...    | pod_abbr    | yes | pod_abbr for vcu |
    ...    | container   | yes | container name |
    ...    | interface  | yes | interface to check ip address |

    ...    *RETURN VALUE*
    ...   ip address
    ...
    ...    Example
    ...    | ${ip} | Get Vcu Ip address | cpif | cpif |  f1cvlan |

    run Keyword if   '${w_debug}'=='${True}'   Log To Console    Get Vcu Ip address:pod_abbr=${pod_abbr}
    run Keyword if   '${w_debug}'=='${True}'   Log To Console    Get Vcu Ip address:container=${container}
    ${out}=   VRAN K8s Cmd     k8s=${GNB_CU}    podName=${pod_abbr}    containerName=${container}    cmd=ifconfig ${interface}   w_debug=${w_debug}
    Should Contain  ${out}   inet
    ${match_ip}   Get Regexp Matches    ${out}    inet\\s+(\\S+)   1
    [Return]    ${match_ip[0]}

Get Vcu Ipv6 address
    [Arguments]    ${pod_abbr}    ${container}   ${interface}    ${w_debug}=${False}
    [Documentation]    Vcu get ip address for container
    ...    Vcu get ip address for container
    ...    | Input Parameters | Man. | Description |
    ...    | pod_abbr    | yes | pod_abbr for vcu |
    ...    | container   | yes | container name |
    ...    | interface  | yes | interface to check ip address |

    ...    *RETURN VALUE*
    ...   ip address
    ...
    ...    Example
    ...    | ${ip} | Get Vcu Ipv6 address | cpif | cpif |  f1cvlan |

    run Keyword if   '${w_debug}'=='${True}'   Log To Console    LOOP_pod_abbr=${pod_abbr}
    run Keyword if   '${w_debug}'=='${True}'   Log To Console    LOOP_container=${container}
    ${out}=   VRAN K8s Cmd     k8s=${GNB_CU}    podName=${pod_abbr}    containerName=${container}    cmd=ifconfig ${interface}   w_debug=${w_debug}
    Should Contain  ${out}   inet6
    ${match_ip}   Get Regexp Matches    ${out}    inet6\\s+(\\S+).*global   1
    [Return]    ${match_ip[0]}

Parse Ipv4 Address Only From Content
    [Arguments]  ${content}
    [Documentation]    Parse Ipv4 Address Only From Content
    ...    |  Input Parameters | Man. | Description |
    ...    | content       |  yes | content |
    ...
    ...    *RETURN VALUE*
    ...    ip v4 address
    ...
    ...    Example
    ...    keyword succeeds
    ...    | ${ip} | Parse Ipv4 Address Only From Content | abc10.108.227.133def |
    ...    | ${ip} | Parse Ipv4 Address Only From Content | abc 10.108.227.133 def |
    ...
    ...    keyword fails
    ...    | ${ip} | String Should Be An Ip Address | abc10.108.227.abc |
    ...
    ${matches}    Get Regexp Matches    ${content}    [^0-9]*(\\d+\\.\\d+\\.\\d+\\.\\d+).*   1
    Should Be True  ${matches}
    ${ip_addr}    Set Variable If    ${matches}    ${matches[0]}    ${EMPTY}
    [Return]  ${ip_addr}

Parse Ipv6 Address
    [Arguments]  ${content}
    [Documentation]    get ip6 address and mask length from linux command 'ip address show dev eth0'
    ...    | Input Parameters | Man. | Description |
    ...    | content | Yes | content of output by executing 'ip address show dev eth0' |
    ...    *RETURN VALUE*
    ...    IPv6 address and net mask length
    ...
    ...    Example
    ...    | ${out}         | tafssh.execute      | ip address show dev fp0 |
    ...    | ${ip6_addr} | ${ip6_mask_len} | Parse ipv6 address |   ${out} |
    ${matches}    Get Regexp Matches    ${content}    inet6 ([23]\\S+)/([0-9]{1,3}).+scope global   1    2
    ${ip6_addr}    Set Variable If    ${matches}    ${matches[0][0]}    ${EMPTY}
    ${ip6_mask_len}    Set Variable If    ${matches}    ${matches[0][1]}    ${EMPTY}

    Return From Keyword If    ${ip6_addr.__len__()}>0    ${ip6_addr}    ${ip6_mask_len}

    ${matches}    Get Regexp Matches    ${content}    inet6 ([23]\\S+)\\s+prefixlen\\s+(\\d+)\\s+scopeid\\s+   1    2
    ${ip6_addr}    Set Variable If    ${matches}    ${matches[0][0]}    ${EMPTY}
    ${ip6_mask_len}    Set Variable If    ${matches}    ${matches[0][1]}    ${EMPTY}
    [Return]    ${ip6_addr}     ${ip6_mask_len}

Get vDU TNL ID
    [Arguments]  ${scf_path}=${EMPTY}  ${templateType}=OAM   ${gnb_index}=0   ${vdu_index}=0   ${nodeType}=Classical
    [Documentation]   Get vDU TNL ID
    ...    | Input Parameters | Man. | Description |
    ...    | scf_path | yes | scf file with absolute path, it's vDU scf file. |
    ...    | templateType | no | templateType, valid value is OAM, 5GUserPlane, default is OAM |
    ...
    ...    *RETURN VALUE*
    ...    TNL id of given templateType.
    ...
    ...    Example
    ...    |  ${tnl_id}  | Get vDU TNL ID | scf_path=/tmp/a.scf | templateType=OAM |
    ...    |  ${tnl_id}  | Get vDU TNL ID | scf_path=/tmp/a.scf | templateType=5GUserPlane |
    ...
    ${scf_file_with_fullpath}    run Keyword if   '${scf_path}'=='${EMPTY}'
    ...                    5GC002535_Keywords.Get Temporary Scf From Current Plan    gnb_index=${gnb_index}   vdu_index=${vdu_index}
    ...  ELSE                    set variable      ${scf_path}
    ${distName}   Get MO distName    scf_path=${scf_file_with_fullpath}  templateType=${templateType}

    scf.load_scf    ${scf_file_with_fullpath}
    ${tnlDN_val}   scf.get_all_values_from_scf   dist_name=${distName[0]}  p_name=tnlDN   nodeType=${nodeType}

    ${tnlDN_val_}=    set variable    ${tnlDN_val[0]}
    ${result}     Get Regexp Matches     ${tnlDN_val_[0]}   MRBTS-\\d+/TNLSVC-\\d+/TNL-(\\d+)   1
    ${tnl_id}  Set Variable If  ${result}   ${result[0]}
    should be true  ${tnl_id}>=1

    [Return]  ${tnl_id}

Parse Input Parameter According To Seperator
    [Arguments]   ${seperator}    @{para_list}
    [Documentation]    Parse Input Parameter According To Seperator
    ...    *AUTHOR* chris.l.cao
    ...    | Input Parameters | Man. | Description |
    ...    | seperator | yes | seperator, eg, '='  |
    ...    | para_list | yes | dictionary, like 'key=value' pair format  |
    ...    *RETURN VALUE*
    ...    dictionary of parameter
    ...
    ...  Example
    ...  | ${para_list} | Parse Input Parameter According To Seperator | = | key1=value1 | key2=value2 | key3=value3 | ... |
    ...  | ${para_list} | Parse Input Parameter According To Seperator | = | ntpServerList=10.56.126.22 | ntpAlarmingThreshold=500 |
    ...  | ${para_list} | Parse Input Parameter According To Seperator | = | ntpServerList=10.56.126.22 | ntpAlarmingThreshold=5 | distName=TNL-3 |

    @{non_key_value_pair_list}    create list
    &{key_value_dict}    Create Dictionary

    ${len}    Get Length    ${para_list}
    Run Keyword If   ${len}==0   Fail    There is no input parameter while calling this keyword!

    FOR    ${item}    IN    @{para_list}
        ${out}    Split String    ${item}    ${seperator}    1
        ${len}   Get Length   ${out}
        ${first}    Set Variable    ${out[0]}
        ${second}    Set Variable If    ${len}==1    ${EMPTY}
        ...    ${len}>=2 and '${out[1]}'=='${EMPTY}'    ${EMPTY}
        ...    ${len}>=2 and '${out[1]}'!='${EMPTY}'    ${out[1]}
        Run Keyword If   '${second}'=='${EMPTY}'   Append To List   ${non_key_value_pair_list}   ${first}
        Continue For Loop If   '${second}'=='${EMPTY}'
        &{tempdict}    Create Dictionary    ${first}    ${second}
        &{key_value_dict}    Create Dictionary    &{key_value_dict}    &{tempdict}
    END

    [Return]   ${non_key_value_pair_list}   ${key_value_dict}

Create Xpath
    [Arguments]    ${non_key_value_pair_list}   ${key_value_dict}
    ${tmp_non_key_value_pair_list}   Copy List   ${non_key_value_pair_list}
    ${tmp_key_value_dict}   Copy Dictionary   ${key_value_dict}
    ${len1}   Get Length  ${tmp_non_key_value_pair_list}
    ${len2}   Get Length  ${key_value_dict}
    Should Not Be True  ${len1}==0 and ${len2}==0

    ${contain_list}   Create List

    #handle Non_Key_Value_Pair_List
    Run Keyword If   ${len1}>=1   Create Xpath Contain List   ${contain_list}    ${tmp_non_key_value_pair_list}

    #handle Key_Value_Dict
    #@{key_list}   set variable    ${tmp_key_value_dict.keys()}
    @{key_list}   evaluate    list(${tmp_key_value_dict})
    FOR    ${i}   IN     @{key_list}
      Continue For Loop If   '${i}'=='distName'
      ${key}  Set Variable   ${i}
      ${value}   Set Variable   ${key_value_dict["${i}"]}
      Append To List  ${contain_list}  descendant::ns:*[local-name()='p' or local-name()='list'][@name="${key}" and contains(text(),"${value}")]
    END

    #handle 'distName' In Key_Value_Dict
    ${tmp_dict}  evaluate   list(${key_value_dict})
    #Run Keyword If    """distName""" in """${key_value_dict.keys()}"""
    Run Keyword If    """distName""" in """${tmp_dict}"""
    ...      append to list    ${contain_list}   contains(@distName, "${key_value_dict["distName"]}")

    ${xpath}   Catenate   SEPARATOR=${SPACE}and${SPACE}      @{contain_list}
    ${xpath}   Set Variable   .//ns:managedObject[${xpath}]
    [Return]   ${xpath}

Create Xpath Contain List
    [Arguments]     ${contain_list}    ${para_list}
    For   ${i}   IN   @{para_list}
        Append To List    ${contain_list}    descendant::ns:*[local-name()='p' or local-name()='list']/@name="${i}"
    END

Get raml version
    [Arguments]  ${scf_path}
    ${line}   OperatingSystem.Grep File   ${scf_path}   <raml*xmlns=*>
    ${matches}  String.Get Regexp Matches   ${line}   .*\\sxmlns="(\\S+)"[\\s>].*   1
    ${raml_version}   Set Variable   ${matches[0]}

    [Return]  ${raml_version}

Get MO distName
    [Arguments]   @{para_list}
    [Documentation]  Get MO distName.  It supports multi-parameters filtering and distName filtering.
    ...    When using key=value format, the '=' means 'contain',  e.g, distName=TNL-4 means 'distName' contain 'TNL-4',
    ...    sgwIpAddress=10.68  means 'sgwIpAddress' contain '10.68'
    ...    *AUTHOR* chris.l.cao@nokia-sbell.com
    ...
    ...  Change History
    ...  27.9.2021   chris.l.cao@nokia-sbell.com,  add support to scf exported from Netact
    ...
    ...    | Input Parameters | Man. | Description |
    ...    | para_list  | Yes | key=value pair, scf_path key should be included! please see samples |
    ...
    ...    *RETURN VALUE*
    ...    Return distName list that matched the parameters filter and distName filter. Return type is list.
    ...
    ...    Example
    ...    Get distName according to mixed filter
    ...    | ${scf_path} | set variable | /tmp/scf.xml |
    ...    | scf.load_scf | file_path=${scf_path}      |
    ...    | ${distName} | Get MO distName | scf_path=${scf_path} | btsName         |
    ...    | ${value}    | scf.get_all_values_from_scf | dist_name=${distName[0]} |  p_name=btsName |
    ...
    ...    | ${distName} | Get MO distName | scf_path=${scf_path} | templateType=OAM |
    ...    | ${value}    | scf.get_all_values_from_scf | dist_name=${distName[0]} |  p_name=templateType |
    ...    | ${value}    | scf.get_all_values_from_scf | dist_name=${distName[0]} |  p_name=tnlDN |
    ...
    ...    | ${distName} | Get MO distName | scf_path=${scf_path} | distName=IPNO |
    ...    | ${distName} | Get MO distName | scf_path=${scf_path} | distName=IPNO | icmpDscp |
    ...    | ${distName} | Get MO distName | scf_path=${scf_path} | distName=IPNO | icmpDscp=10 |
    ...    | ${distName} | Get MO distName | scf_path=${scf_path} | distName=MRBTS-1234/TNLSVC-1/TNL-1/IPNO | icmpDscp=10 |
    ...    | ${value}    | scf.get_all_values_from_scf | dist_name=${distName[0]} |  p_name=icmpDscp |
    ...    | ${value}    | scf.get_all_values_from_scf | dist_name=${distName[0]} |  p_name=ndMldDscp |
    ...
    ...    | ${distName} | Get MO distName | scf_path=${scf_path} | distName=TNL-4 |  destIpAddr=10.68 |
    ...    | ${distName} | Get MO distName | scf_path=${scf_path} | sgwIpAddress=10.68 | gtpuPathSupint |
    ...    | ${distName} | Get MO distName | scf_path=${scf_path} | sgwIpAddress=10.68 | gtpuPathSupint=60 |
    ...    | ${distName} | Get MO distName | scf_path=${scf_path} | distName=GTPU | sgwIpAddress=10.68 | gtpuPathSupint |
    ...    | ${value}    | scf.get_all_values_from_scf | dist_name=${distName[0]} |  p_name=destIpAddr |
    ...    | ${value}    | scf.get_all_values_from_scf | dist_name=${distName[0]} |  p_name=sgwIpAddress |
    ...    | ${value}    | scf.get_all_values_from_scf | dist_name=${distName[0]} |  p_name=gtpuPathSupint |
    ...
    ${non_key_value_pair_list}   ${key_value_dict}   Parse Input Parameter According To Seperator   =   @{para_list}
    #${key_value_dict_keys}   set variable  ${key_value_dict.keys()}
    ${key_value_dict_keys}   evaluate  list(${key_value_dict})

    Run Keyword If  "scf_path" not in "${key_value_dict_keys}"   Fail  Should give scf_path parameter value!!!
    ${scf_path}     Set Variable  ${key_value_dict["scf_path"]}
    Remove From Dictionary   ${key_value_dict}   scf_path

    Run Keyword If   """distName""" in """${non_key_value_pair_list}"""    Remove Values From List   ${non_key_value_pair_list}   distName

    ${scf_content}   OperatingSystem.Get File   ${scf_path}
    ${xpath}   Create Xpath    ${non_key_value_pair_list}   ${key_value_dict}

    ${raml_version}   Get raml version   ${scf_path}
    ${distName_list}  lib.Get_Multi_DistName_By_Xpath_Filter   ${scf_content}   ${xpath}   ${raml_version}

    [Return]  ${distName_list}

Get vDU OAM Ip
    [Arguments]  ${gnb_index}=0   ${vdu_index}=0
    [Documentation]   Get vDU OAM Ip
    ...    | Input Parameters | Man. | Description |
    ...	   | gnb_index | no | gnb_index, default is 0 |
    ...	   | vdu_index | no | vdu_index, default is 0 |
    ...
    ...    *RETURN VALUE*
    ...    VDU OAM ip
    ...
    ...    Example
    ...    | ${vdu_oam_ip} | Get vDU OAM Ip |
    ...    | ${vcu_oam_http_connection_info} | Get vDU OAM Ip | vdu_index=1 |
    ...

    ${vdu_oam_http_connection_info}   lib.get_vdu_oam_http_connection_info    gnb_index=${gnb_index}   vdu_index=${vdu_index}
    ${vdu_oam_ip}   set variable  ${vdu_oam_http_connection_info["addr"]}

    [Return]  ${vdu_oam_ip}
