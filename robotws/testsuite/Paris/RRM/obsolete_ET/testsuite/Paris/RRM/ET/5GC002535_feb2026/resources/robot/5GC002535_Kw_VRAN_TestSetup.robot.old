...                    nrcellgrp=${NRCELLGRP_VRAN_5MHz}       ipif=${MRBTS_IPIF}     nrbts_trblcadm=${NRBTS_VRAN_TRBLCADM}
...                    nrbts_featcadm=${NRBTS_FEATCADM}       cellBwpList_Item1=${NRCELL_NSA_cellBwpList_Item2}
