&{Scf5MHz_VRAN_DMRS_Auto}   mrbts=${MRBTS5MHz_VRAN_FDM_PDSCH_DMRS}       nrcellfdd=${NRCELL_VRAN_FDD5MHz}      nrcell=${NRCELL5MHz_VRAN_DMRS_Auto}
