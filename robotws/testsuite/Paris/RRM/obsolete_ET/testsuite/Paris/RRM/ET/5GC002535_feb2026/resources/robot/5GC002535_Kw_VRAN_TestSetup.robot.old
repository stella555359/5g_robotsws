...                   rdEnableFDMPdschDmrs_0x5801a6=1
&{Test5Mhz_VRAN_2535_2DMRS_256QAM}       seq=${T1_VRAN}    wtsXmlFile=${wtsXml5MHz_VRAN}   scfFile=${Scf5MHz_VRAN_2DMRS}   Context=${Context_VRAN}
...                   rdEnableFDMPdschDmrs_0x5801a6=1
