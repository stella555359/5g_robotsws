import os
import json
import getopt
import sys
from enum import Enum

# TAF Libraries:
from taf.analyzer.ttitrace_eventdecoder import TtitraceReader as TtitraceReaderEvtDec


def dlDTXOptimData(jsonPathName, State):
    """
    This function returns the number of an dlDTXOptimData state in TTI trace.
    jsonPathName: json file of the TTI trace
    State: CG state to count
    """
    if not os.path.exists(jsonPathName) or os.path.getsize(jsonPathName) <= 24:
        print("TTI trace ERROR: %s doesn't exist or size <= 24" % jsonPathName)
        return 0

    nbDTXEventstate = 0
    print("Python script recherche %s" % (State))

    with open(jsonPathName, 'rb') as file_obj:
        for i, event in enumerate(TtitraceReaderEvtDec(file_obj=file_obj)):
            if event.type == "dlDtxOptimData":
                # print ("un dlDtxOptimData trouve ")
                DTXOptimEvent = event.data["dlDtxOptimEvent"]
                # print ("Un event %s" % (DTXOptimEvent))
                if DTXOptimEvent == State:
                    nbDTXEventstate = nbDTXEventstate+1
                    SFN = event.data["eventHeader"]["sfn"]
                    slot = event.data["eventHeader"]["slot"]
                    print("DTXEventState state %s found at %s/%s" % (State, SFN, slot))
    return nbDTXEventstate
