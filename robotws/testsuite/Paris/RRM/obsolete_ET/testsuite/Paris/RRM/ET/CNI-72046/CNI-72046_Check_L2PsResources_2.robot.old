*** Variables ***

${dl_tput}                      100
${ul_tput}                      50

${RD_RESOURCES_COLLECTOR}       0x590165

*** Test Cases ***

[1][1.0] CNI_72046-Multi UEs attach_Detach with UL_DL medium traffic_FR1
    [Documentation]                 This is the automated TCs related to CNI-72046
    ...                             It performs several calls to resource collector on CPRT node depending
    ...                             if UEs is attached or if traffic is running or not
    ...                             The results related to number of available CRNTI or free HARQ processes
    ...                             are checked accordingly Multi UEs attach dedicated to 2 UEs on cell or Ue attach on each cell .

    # Enable CNI-72046
    ${p_resource_collector}=         Create Dictionary    field=${RD_RESOURCES_COLLECTOR}    value=1
    ${param_list_rad_param}=         Create List          ${p_resource_collector}
    Set Fields in swconfig DU        param_list=${param_list_rad_param}

    # Restart TL anyway because of RAD param updates.
    Restart TL

    WTS Setup           nbUe=2
    # Cellsetup is now done, Sherpa can be enabled if needed
    Run Keyword If                  ${enable_sherpa}==${True}         Activate Sherpa

    ${currentResourceStatus_No_UE}      Get L2PS Resources Usage        0
    Dated Log                           Current L2PS resources are: ${currentResourceStatus_No_UE}
    ${currentResourceStatus_No_UE_1}      Get L2PS Resources Usage        1
    Dated Log                           Current L2PS resources are: ${currentResourceStatus_No_UE_1}


    # UE profile (optional)
    # Put here for example in case attach to another cell is needed.
    &{my_ue_config_1}                     Copy Dictionary     ${UE_NO_PROFILE}
    Set To Dictionary                   ${my_ue_config_1}     target_cells        1
    Set To Dictionary                   ${my_ue_config_1}     ue        1

    &{my_ue_config_2}                     Copy Dictionary     ${UE_NO_PROFILE}
    Set To Dictionary                   ${my_ue_config_2}     target_cells        1
    Set To Dictionary                   ${my_ue_config_2}     ue        2

    # UE attach to 4G+5G (NSA)
    SgNB Addition to ENB                ueSetting=${my_ue_config_1}
    SgNB Addition to ENB                ueSetting=${my_ue_config_2}

    Traced Sleep                        10 seconds
    ${currentResourceStatus_1_UE}       Get L2PS Resources Usage        0
    Dated Log                           Current L2PS resources are: ${currentResourceStatus_1_UE}

    ${delta_Free_Rnti}            Evaluate        ${currentResourceStatus_No_UE}[nbOfFreeCRNTI] - ${currentResourceStatus_1_UE}[nbOfFreeCRNTI]
    Should Be True                  ${delta_Free_Rnti}==2


    #################
    # DL traffic
    #################
    # Don't stop traffic automatically, it will be stopped later
    Traffic UE DL                  ueSetting=${my_ue_config_1}
    ...                            throughput=${dl_tput}
    ...                             shouldBeStop=False
    ...                             shouldBeCheck=False
    ...                             duration=20s

    Traffic UE DL                  ueSetting=${my_ue_config_2}
    ...                            throughput=${dl_tput}
    ...                             shouldBeStop=False
    ...                             shouldBeCheck=False
    ...                             duration=20s

    ${currentResourceStatus_1_UE_with_Dl}       Get L2PS Resources Usage        0
    Dated Log                                   Current L2PS resources are: ${currentResourceStatus_1_UE_with_Dl}

    ${delta_Free_Rnti}              Evaluate
    ...                             ${currentResourceStatus_No_UE}[nbOfFreeCRNTI] - ${currentResourceStatus_1_UE_with_Dl}[nbOfFreeCRNTI]
    Should Be True                  ${delta_Free_Rnti}==2
    # DL traffic but no UL
    Should Be True                  ${currentResourceStatus_1_UE_with_Dl}[DlnbOfHarqPoolFree]<${currentResourceStatus_No_UE}[DlnbOfHarqPoolFree]
    Traced Sleep                    10 seconds

    ${currentResourceStatus_1_UE_with_Dl}       Get L2PS Resources Usage        0
    Dated Log                                   Current L2PS resources are: ${currentResourceStatus_1_UE_with_Dl}
    ${delta_Free_Rnti}              Evaluate
    ...                             ${currentResourceStatus_No_UE}[nbOfFreeCRNTI] - ${currentResourceStatus_1_UE_with_Dl}[nbOfFreeCRNTI]
    Should Be True                  ${delta_Free_Rnti}==2
    # DL traffic but no UL
    Should Be True                  ${currentResourceStatus_1_UE_with_Dl}[DlnbOfHarqPoolFree]<${currentResourceStatus_No_UE}[DlnbOfHarqPoolFree]

    # Stop traffic
    Traffic Stop                    dir=dl      ueSetting=${my_ue_config_2}
    Traffic Stop                    dir=dl      ueSetting=${my_ue_config_1}
    Traced Sleep                    10 seconds

    ${currentResourceStatus_1_UE_no_Dl}     Get L2PS Resources Usage        0
    Dated Log                               Current L2PS resources are: ${currentResourceStatus_1_UE_no_Dl}

    ${delta_Free_Rnti}              Evaluate
    ...                             ${currentResourceStatus_No_UE}[nbOfFreeCRNTI] - ${currentResourceStatus_1_UE_no_Dl}[nbOfFreeCRNTI]
    Should Be True                  ${delta_Free_Rnti}==2

    #################
    # UL traffic
    #################
    # Don't stop traffic automatically, it will be stopped later
    Traffic UE UL                   ueSetting=${my_ue_config_1}
    ...                             throughput=${ul_tput}
    ...                             shouldBeStop=False
    ...                             shouldBeCheck=False
    ...                             duration=20s


    Traffic UE UL                   ueSetting=${my_ue_config_2}
    ...                             throughput=${ul_tput}
    ...                             shouldBeStop=False
    ...                             shouldBeCheck=False
    ...                             duration=20s

    ${currentResourceStatus_1_UE_with_Ul}       Get L2PS Resources Usage        0
    Dated Log                                   Current L2PS resources are: ${currentResourceStatus_1_UE_with_Ul}

    ${delta_Free_Rnti}              Evaluate
    ...                             ${currentResourceStatus_No_UE}[nbOfFreeCRNTI] - ${currentResourceStatus_1_UE_with_Ul}[nbOfFreeCRNTI]
    Should Be True                  ${delta_Free_Rnti}==2
    # UL traffic but no DL
    Should Be True                  ${currentResourceStatus_1_UE_with_Ul}[UlnbOfHarqPoolFree]<${currentResourceStatus_No_UE}[UlnbOfHarqPoolFree]

    Traced Sleep                                10 seconds
    ${currentResourceStatus_1_UE_with_Ul}       Get L2PS Resources Usage        0
    Dated Log                                   Current L2PS resources are: ${currentResourceStatus_1_UE_with_Ul}

    ${delta_Free_Rnti}              Evaluate
    ...                             ${currentResourceStatus_No_UE}[nbOfFreeCRNTI] - ${currentResourceStatus_1_UE_with_Ul}[nbOfFreeCRNTI]
    Should Be True                  ${delta_Free_Rnti}==2
    # UL traffic but no DL
    Should Be True                  ${currentResourceStatus_1_UE_with_Ul}[UlnbOfHarqPoolFree]<${currentResourceStatus_No_UE}[UlnbOfHarqPoolFree]

    # Stop traffic
    Traffic Stop                    dir=ul         ueSetting=${my_ue_config_1}
    Traffic Stop                    dir=ul         ueSetting=${my_ue_config_2}

    # Detach UE
    UE Detach Enb                   ueSetting=${my_ue_config_1}
    UE Detach Enb                   ueSetting=${my_ue_config_2}

    Traced Sleep                                10 seconds
    ${currentResourceStatus_1_UE_Detach}        Get L2PS Resources Usage        0
    Dated Log                                   Current L2PS resources are: ${currentResourceStatus_1_UE_Detach}

    Should Be True                  ${currentResourceStatus_1_UE_Detach}[nbOfFreeCRNTI]==${currentResourceStatus_No_UE}[nbOfFreeCRNTI]
    Should Be True                  ${currentResourceStatus_1_UE_Detach}[DlnbOfHarqPoolFree]<=${currentResourceStatus_No_UE}[DlnbOfHarqPoolFree]
    Should Be True                  ${currentResourceStatus_1_UE_Detach}[UlnbOfHarqPoolFree]<=${currentResourceStatus_No_UE}[UlnbOfHarqPoolFree]


     # UE profile (optional)
    # Put here for example in case attach to another cell is needed.
    &{my_ue_config_1}                     Copy Dictionary     ${UE_NO_PROFILE}
      Set To Dictionary                   ${my_ue_config_1}     target_cells        2
    Set To Dictionary                   ${my_ue_config_1}     ue        1

