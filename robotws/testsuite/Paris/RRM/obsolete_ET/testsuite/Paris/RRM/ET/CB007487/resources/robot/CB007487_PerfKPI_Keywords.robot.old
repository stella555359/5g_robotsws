prepare egate cmd results log to console
    [Documentation]    [PRIVATE]    prepare egate cmd results log to console, remove empty lines, strip lines
    [Arguments]    ${contents}
    @{lines}       Split to lines     ${contents}
    ${contents_output}    set variable  ''

    FOR   ${line}    IN    @{lines}
       ${length}    GetLength    ${line}
       Run Keyword if  ${length} == 0    Continue For Loop
       ${line_wo_blanks}     Strip String     ${line}
       ${length}    GetLength    ${line_wo_blanks}
       Run Keyword if  ${length} == 0    Continue For Loop
       ${contents_output}=   catenate    SEPARATOR=\n   ${contents_output}   ${line_wo_blanks}
    END
    [Return]      ${contents_output}

GET UE
