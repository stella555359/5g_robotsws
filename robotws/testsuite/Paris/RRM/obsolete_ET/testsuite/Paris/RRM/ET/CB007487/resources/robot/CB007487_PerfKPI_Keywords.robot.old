*** Keywords ***
#=======================================================================================================================
# KW to perform checks in pcap files
#=======================================================================================================================

Test Suite Setup for CB007487
    [Documentation]          Test suite setup for all 7487 TCs.
    [arguments]     ${NokeepAllUe}=${True}
    # Call to generic test suite setup KW
    Run Keyword If                  ${NokeepAllUe} == ${True}
    ...                             setup.Suite Setup From Scratch
    ...  ELSE                       setup.Suite Setup From Scratch    keepAllUeDataInCfgFile=${True}
    # listBackupFiles=${FD_ALL}

    Init Trace color

    run Keyword           MyConstants.hello
    CB007487_PerfKPI_Keywords.Create Test Suite Folder
    run keyword and ignore error     CB007487_PerfKPI_Keywords.Get Orignal Configuration 7487

    Dated Log New Line    COLLECT_LOGS if TEST STATUS is FAIL and EXCLUDE_LOGS_IF_FAIL == 0
    Dated Log             COLLECT_LOGS if COLLECT_LOGS == 1
    Dated Log             COLLECT_FULL_LOGS (including SosReport and Snapshot) if ENABLE_TEST_TEARDOWN == 1 and TEST STATUS is FAIL
    Dated log             default_test_strategy : COLLECT_LOGS = ${COLLECT_LOGS}
    Dated log             default_test_strategy : EXCLUDE_LOGS_IF_FAIL = ${EXCLUDE_LOGS_IF_FAIL}
    Dated Log             default_test_strategy : ENABLE_TEST_TEARDOWN = ${ENABLE_TEST_TEARDOWN}
    Dated log             default_test_strategy : WAIT_5G_CELL_ONAIR = ${WAIT_5G_CELL_ONAIR}
    Dated Log             default_test_strategy : ENABLE_CHECK_COUNTERS = ${ENABLE_CHECK_COUNTERS}
    Dated Log             default_test_strategy : WITHOUT_TEST_SUITE_TEARDOWN = ${WITHOUT_TEST_SUITE_TEARDOWN}
    Dated log             default_test_strategy : SharkTool = ${SharkTool}
    Dated log             default_test_strategy : enable_sherpa = ${enable_sherpa}
    Dated log             default_test_strategy : WITH_BTSLOG = ${WITH_BTSLOG}

    Dated Log         First Do install Mirroring scripts in GNB
    CB007487_PerfKPI_Keywords.Get gNB mirroring into local repo
    ${SCRIPTDEF_MIRROR_GNB_FS_ABIP.host}=    set Variable    ${GNB_DU.sys[0].M}
    CB007487_PerfKPI_Keywords.GNB Mirror Script Install     scriptDef=${SCRIPTDEF_MIRROR_GNB_FS_ABIP}
    ...                                                 PathToScriptsRepo=${LOCAL_REPO_DIR}

Test Suite Teardown for CB007487
    [Documentation]          Test suite Teardown for all 7487 TCs.
    run keyword and ignore error   Restore Orignal Configuration 7487
    return from Keyword if      '${WITHOUT_TEST_SUITE_TEARDOWN}'=='1'
    # Call to generic test suite Teardown KW
    setup.Suite Teardown
    CleanBasicFiles    #way to supply SWENG lua files erasement forget

Test Setup for CB007487
    set Suite Variable    ${testCaseDir}    None
    CB007487_PerfKPI_Keywords.Get testcase log directory
    CB007487_PerfKPI_Keywords.Prepare Test Name

Test Teardown for CB007487
    BuiltIn.Log      \nTest ${TEST_NAME} 7487 ending   console=yes
    Produce Scout Data
    teardownP1
    teardownP2
    CleanBasicFiles

teardownP1
    Run Keyword And Ignore Error     Collect EGATE console Logs

    # Save current SCF file used during test cases
    ${current_scf_file}             OAM Get SCF File            dir=${testCaseDir}      file=SCF_used_for_7487_Tests.xml
    Set Suite Variable              ${current_scf_file}
    Dated Log New Line         Current 7487 SCF file stored to ${current_scf_file}

    # Get swconfig file used during 7487 tests
    ${ret}   ${alias_gnb}           Run Keyword And Ignore Error         SSH Wait For Connect                ${GNB_DU.sys[0].M}
    Run Keyword And Ignore Error       csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${testCaseDir}/swconfig_used_for_7487_Tests.txt
    ...                             connection=${alias_gnb}
    Dated Log                  Current 7487 swconfig file stored to ${testCaseDir}/swconfig_used_for_7487_Tests.txt

    # Get EPC file configuration used during 7487 tests
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.download_file               remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${testCaseDir}/basic_wts_used_for_7487_Tests.cfg
    ...                             connection=${alias_epc}

    # Get AP configuration file used during 7487 tests
    ${ap_configfile}                Get XML AirPhoneConfig Path
    run Keyword if      '${ap_configfile}' != '${empty}'     csn.download_file     remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${testCaseDir}/ApOamConfig_used_for_7487_Tests.xml
    ...                             connection=${alias_epc}

    ${msg}=   Catenate    Current 7487 basic file ${tl.core.cfg_filename} stored
    ...                      to ${testCaseDir}/basic_wts_used_for_7487_Tests.cfg
    Dated Log    ${msg}
    Dated Log  Current 7487 ApOamConfig file stored to ${testCaseDir}/ApOamConfig_used_for_7487_Tests.xml

    # get Alarm at the end of the test and store it into a file
    Dated log New Line  OAM Get Active Alarms to Save into file
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}

    ${active_alarms}     OAM Get Active Alarms                   oam=${GNB_DU.oam}       textFormat=${False}
    ${len}    Get Length    ${active_alarms}
    ${alarm_id_list}    Create List
    ${alarm_name_list}    Create List
    ${faultId}=     set variable if    ${isAiC}        fault_id
    ...                                                faultId
    ${faultName}=     set variable if    ${isAiC}      fault_name
    ...                                                faultName

    FOR    ${i}    IN RANGE    ${len}
         ${tmp_id}    Get From Dictionary    ${active_alarms[${i}]}    ${faultId}
         ${tmp_name_id}    Get From Dictionary    ${active_alarms[${i}]}    ${faultName}
         Append To List    ${alarm_id_list}    ${tmp_id}
         Append To List    ${alarm_name_list}    ${tmp_name_id}
    END
    # Dated log     Active alarms: alarm_id_list=${alarm_id_list}
    # Dated log     Active alarms: alarm_name_list=${alarm_name_list}

    Append To File    ${testCaseDir}/OAM_Alarms_After_${TEST_NAME}.txt     Active Alarms Id List:\n${alarm_id_list}\n\n
    Append To File    ${testCaseDir}/OAM_Alarms_After_${TEST_NAME}.txt     Active Alarms Name List:\n${alarm_name_list}\n\n

    OAM Disconnect                          ${GNB_DU.oam}

    Dated Log         Collect /ram/startup_l3.log and egate_console.log from Airphone...
    CB007487_PerfKPI_Keywords.Prepare Logs Directory Path    subdir=airphone
    Run Keyword And Ignore Error      CB007487_PerfKPI_Keywords.Collect EGATE console Logs
    Run keyword and Ignore error      CB007487_PerfKPI_Keywords.Get APL3 log from Airphone        target_dir=${testCaseDir}/airphone

    Dated Log         Collect /ffs/run/simmode/iphy.xml from Airphone...
    Run keyword and Ignore error      CB007487_PerfKPI_Keywords.Get iPhy.xml file from Airphone   target_dir=${testCaseDir}/airphone

    Dated Log         Collect /ffs/run/swconfig.txt from Airphone...
    Run keyword and Ignore error      CB007487_PerfKPI_Keywords.Get SWCONFIG file from Airphone   target_dir=${testCaseDir}/airphone

    # Get EPC file configuration used during 7487 tests
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    ${LuaFileName_generated}=    catenate    SEPARATOR=    ${tl.core.cfg_filename.replace(".cfg",".lua")}
    run keyword and ignore error     csn.download_file          remote_path=${tl.core.dir_path}/${LuaFileName_generated}
    ...                             local_path=${testCaseDir}/basic_wts_used_for_7487_Tests.lua
    ...                             connection=${alias_epc}
    # CleanBasicFiles   => move to End Of Kw "Test Suite Teardown for CB007487"

teardownP2
    Collect Logs if needed

    set Suite Variable    ${testCaseDir}    None

CleanBasicFiles
    [Documentation]         At the end of the test, this KW erase all Sweng adding arround basic cfg/lua
    Dated Log               ERASE LUA FILES from previous test
    ${alias}                SSH Connect           ${HOST_EPCSIM}
    ${myCommand}=           set variable          rm -f /opt/iphy/latest/basic*step2*.*;rm -rf /tmp/ute/
    ${result}=              SSH Exec              command=${myCommand}
    ...                                           alias=${alias}
    Dated Log               result=${result}

Get PDSCH ue_stats_nr
    [arguments]     ${ue_id}=1    ${scell_idx}=8
    # ue_stats_nr id=1 type=pdsch scell=8
    ${Ue_PDSCH_Tput}=  Get PDSCH UE Stats for Given CC WA    ue_id=${ue_id}    scell_idx=${scell_idx}
    ${Ue_Avg_PDSCH_Tput}=  Get AVG DL DATA TRAFFIC For Given CC    ue_id=${ue_id}    scell_idx=${scell_idx}     unit=Mbps
    # Dated Log new line    ue_stats_nr Egate Cmd Resuls =\n${Ue_PDSCH_Tput}
    Dated log     =======> Ue_Avg_PDSCH_Tput=${consTraceColor}${Ue_Avg_PDSCH_Tput}Mbps${defColor} for ue_id=${ue_id}
    [return]   ${Ue_Avg_PDSCH_Tput}

Get PUSCH ue_stats_nr
    [arguments]     ${ue_id}=1    ${scell_idx}=8
    ${Ue_PUSCH_Tput}=  Get PUSCH UE Stats for Given CC WA    ue_id=${ue_id}    scell_idx=${scell_idx}
    ${Ue_Avg_PUSCH_Tput}=  Get AVG UL DATA TRAFFIC For Given CC    ue_id=${ue_id}    scell_idx=${scell_idx}     unit=Mbps
    # Dated Log new line    ue_stats_nr Egate Cmd Resuls =\n${Ue_PUSCH_Tput}
    Dated log     =======> Ue_Avg_PUSCH_Tput=${consTraceColor}${Ue_Avg_PUSCH_Tput}Mbps${defColor} for ue_id=${ue_id}
    [return]   ${Ue_Avg_PUSCH_Tput}


Get PDSCH and PUSCH ue_stats_nr for UEList
   [arguments]     ${UEsList}   ${DLthroughput}=0    ${ULthroughput}=0   ${CallType}=NSA
   FOR    ${UEcurrent}     IN      @{UEsList}
        Dated log   =========> Get PDSCH and PUSCH ue_stats_nr for ue_id=${UEcurrent.ue}
        Get PDSCH and PUSCH ue_stats_nr   ue_id=${UEcurrent.ue}
        ...                               DLthroughput=${DLthroughput}
        ...                               ULthroughput=${ULthroughput}
        ...                               CallType=${CallType}
   END

Get PDSCH and PUSCH ue_stats_nr
   [arguments]     ${ue_id}=1   ${DLthroughput}=0    ${ULthroughput}=0   ${CallType}=NSA
   ${scell_idx}   set variable if    '${CallType}'=='NSA'     8
   ...                                                        0
   ${Ue_Avg_PDSCH_Tput}=    run Keyword if    '${DLthroughput}'!='0'    Get PDSCH ue_stats_nr   ue_id=${ue_id}   scell_idx=${scell_idx}
   ...  ELSE                set variable   0
   ${Ue_Avg_PUSCH_Tput}=    run Keyword if    '${ULthroughput}'!='0'    Get PUSCH ue_stats_nr   ue_id=${ue_id}   scell_idx=${scell_idx}
   ...  ELSE                set variable   0
   [return]     ${Ue_Avg_PDSCH_Tput}    ${Ue_Avg_PUSCH_Tput}

CB007487_Attach_Traffic
    [Documentation]                 Generic KW to attach/detach n UEs, with or without traffic
    ...                             Argument is a dictionary including following keys:
    ...                             loopNb:           number of loops "attach/traffic/detach"
    ...                             UEnb:             number of UEs to "attach/traffic/detach" simultaneously
    ...                             CallType:         NSA or SA (for all UEs)
    ...                             Cell:             Target cell (must be index 1, 2, ...)
    ...                             TrafficDuration:  duration of traffic (0 means no traffic)
    ...                             DLthroughput:     DL throughput
    ...                             ULthroughput:     UL throughput
    ...                             shouldBeStop:     To Stop or not traffic after TrafficDuration
    ...                             shouldBeCheck:    To Check or not traffic after TrafficDuration
    ...                             w_UE_CSI_TM_for_4_4_DL_MIMO:      with Cqi Ri airphone TestMode
    ...                             GetTtiTraceTime:  Time of TtiTrace
    ...                             GetL1L2TraceTime: Time of L1L2 Bip Trace
    ...                             num_of_cells_cellsetup:   Num of cell to check after CellSetup
    ...                             w_ue_detach:              With Or Without Ue Detach
    ...                             NOTE: If both DL and UL throughput are not null,
    ...                                   DL and UL traffic are launched simultaneously
    [Arguments]         ${dictParam}

    ${LoopNb}                  Get From Dictionary     ${dictParam}     loopNb
    ${UEnb}                    Get From Dictionary     ${dictParam}     UEnb
    ${CallType}                Get From Dictionary     ${dictParam}     CallType
    ${Cell}                    Get From Dictionary     ${dictParam}     Cell
    ${TrafficDuration}         Get From Dictionary     ${dictParam}     TrafficDuration
    ${DLthroughput}            Get From Dictionary     ${dictParam}     DLthroughput
    ${ULthroughput}            Get From Dictionary     ${dictParam}     ULthroughput
    ${deviation}               Get From Dictionary     ${dictParam}     deviation
    ${shouldBeStop}            Get From Dictionary     ${dictParam}     shouldBeStop
    ${shouldBeCheck}           Get From Dictionary     ${dictParam}     shouldBeCheck
    ${w_UE_CSI_TM_for_4_4_DL_MIMO}             Get From Dictionary     ${dictParam}     w_UE_CSI_TM_for_4_4_DL_MIMO
    ${GetTtiTraceTime}         Get From Dictionary     ${dictParam}     GetTtiTraceTime
    ${GetL1L2TraceTime}        Get From Dictionary     ${dictParam}     GetL1L2TraceTime
    ${num_of_cells}            Get From Dictionary     ${dictParam}     num_of_cells_cellsetup
    ${w_ue_detach}             Get From Dictionary     ${dictParam}     w_ue_detach

    Init Trace color

    ${CellID}                   set variable            ${NRCELL_ID_LIST[${Cell}-1]}
    ${Expected_UEnb_attached}   Evaluate                ${LoopNb} * ${UEnb}
    ${UEnb_attached}            Evaluate                0

    ${UEsList}                 CB007487 build UEs list             CallType=${CallType}    UEnb=${UEnb}    CellID=${CellID}

    CB007487 cell setup        CallType=${CallType}    UEsList=${UEsList}    num_of_cells=${num_of_cells}

    Run Keyword If             ${enable_sherpa} == ${True}         Activate Sherpa

    FOR    ${loopIND}    IN RANGE    1    ${LoopNb}+1
        Dated Log new line     ${consTraceColor}##### LOOP ${loopIND} / ${LoopNb} ##### ${defColor}
        ${UEsAttached}         CB007487 attach        UEsList=${UEsList}    CallType=${CallType}
        ...                                           w_UE_CSI_TM_for_4_4_DL_MIMO=${w_UE_CSI_TM_for_4_4_DL_MIMO}
        Sleep                  5s
        Run Keyword If         ${TrafficDuration} != 0
        ...                    CB007487 Traffic    UEsList=${UEsAttached}
        ...                    Duration=${TrafficDuration}    DLtput=${DLthroughput}    ULtput=${ULthroughput}   shouldBeStop=${shouldBeStop}
        ...                    shouldBeCheck=${shouldBeCheck}
        Sleep                  5s

        run Keyword if    '${shouldBeStop}' == 'False'     Get PDSCH and PUSCH ue_stats_nr for UEList   ${UEsList}
        ...                                                                                             DLthroughput=${DLthroughput}
        ...                                                                                             ULthroughput=${ULthroughput}
        ...                                                                                             CallType=${CallType}

        run Keyword if    '${w_ue_detach}' == 'True'      CB007487 detach        UEsList=${UEsAttached}    CallType=${CallType}
        ${UE_attached_loop}    get length         ${UEsAttached}
        ${UEnb_attached}       Evaluate           ${UEnb_attached} + ${UE_attached_loop}
    END

    Run Keyword If                  ${enable_sherpa} == ${True}             Sherpa.Deactivate Sherpa and Stop Collect    keep_pcap_file=True

    run Keyword if     '${GetTtiTraceTime}' != '0'       Run Keyword And Ignore Error    Get TTI traces    time=${GetTtiTraceTime}

    # ${L1L2_Pcap_File}=   run Keyword if     '${Getl1l2TraceTime}' != '0'    CB007487_PerfKPI_Keywords.Get L1L2 traces   time=${GetL1L2TraceTime}
    # ...                                                                                                                 prefix=L1L2Bip.wDLULTput
    ${L1L2_Pcap_File}=   run Keyword if     '${Getl1l2TraceTime}' != '0'    CB007487_PerfKPI_Keywords.Get L1L2 traces Version ABIP
    ...                                                                                                                 time=${GetL1L2TraceTime}
    ...                                                                                                                 prefix=L1L2Bip.wDLULTput



    run Keyword if   '${L1L2_Pcap_File}' != 'None'      Run Keywords     Dated log    gzip -f ${L1L2_Pcap_File} ...    AND
    ...                                                                               Run    gzip -f ${L1L2_Pcap_File}

    # for testing purpose
    Return from Keyword if    '${ENABLE_CHECK_COUNTERS}'=='0'

    CB007487 get PM files

    ${Status_Attach}                CB007487 check attach     AttachNb=${Expected_UEnb_attached}    CellID=${CellID}
    ...                                                       CallType=${CallType}
    ${Status_Detach}         Run Keyword if    '${w_ue_detach}' == 'True'     CB007487 check detach     DetachNb=${UEnb_attached}   CellID=${CellID}
    ...   ELSE         set Variable     ${TRUE}
    ${Status_DL}    ${Status_UL}    CB007487 check traffic    UEnb=${UEnb_attached}     CellID=${CellID}    CallType=${CallType}
    ...                                                       Duration=${TrafficDuration}    DLtput=${DLthroughput}    ULtput=${ULthroughput}
    ${Status_DLBLER}    ${Status_ULBLER}    CB007487 check BLER    CellID=${CellID}          Duration=${TrafficDuration}
    ...                                                            DLtput=${DLthroughput}    ULtput=${ULthroughput}

    CB007487 check status      ${Status_Attach}    ${Status_Detach}
    ...                        ${Status_DL}        ${Status_UL}
    ...                        ${Status_DLBLER}    ${Status_ULBLER}


Init Trace color
    ${consTraceColor}               Evaluate                    "${CYAN}"
    ${consTraceColorRed}            Evaluate                    "${RED}"
    ${defColor}                     Evaluate                    "${NORMAL}"
    Set Suite Variable              ${consTraceColor}
    Set Suite Variable              ${consTraceColorRed}
    Set Suite Variable              ${defColor}


CB007487 build UEs list
    [Arguments]                     ${CallType}=NSA    ${UEnb}=1    ${CellID}=1
    ${UEsList}                      Run Keyword If    "${CallType}" == "NSA"
    ...                             CB007487 build UEs list NSA      UEnb=${UEnb}    CellID=${CellID}
	...                             ELSE IF           "${CallType}" == "SA"
    ...                             CB007487 build UEs list SA       UEnb=${UEnb}    CellID=${CellID}
    ...                             ELSE
    ...                             Create List
	[return]                        ${UEsList}


CB007487 build UEs list NSA
    [Arguments]                     ${UEnb}=1    ${CellID}=1
    ${UEsList}                      Create List
    FOR    ${UEid}    IN RANGE    1    ${UEnb}+1
            &{UEcurrent}=                   Copy Dictionary          ${UE_SIMPLE}
            Set To Dictionary               ${UEcurrent}      ue                 ${UEid}
            Set To Dictionary               ${UEcurrent}      target_cells       ${CellID}
            Append To List                  ${UEsList}    ${UEcurrent}
    END
	[return]                        ${UEsList}


CB007487 build UEs list SA
    [Arguments]                     ${UEnb}=1    ${CellID}=1
    ${UEsList}                      Create List
    FOR    ${UEid}    IN RANGE    1    ${UEnb}+1
            &{UEcurrent}=                   Copy Dictionary          ${BASIC_UE_SA}
            Set To Dictionary               ${UEcurrent}      ue                 ${UEid}
            Set To Dictionary               ${UEcurrent}      pdu                ${UEid}
            Set To Dictionary               ${UEcurrent}      target_cells       ${CellID}
            Append To List                  ${UEsList}    ${UEcurrent}
    END
	[return]                        ${UEsList}

CB007487 cell setup
    [Arguments]                     ${CallType}    ${UEsList}   ${num_of_cells}=1   ${isOAMRebooted}=False
    Dated Log new line              ${consTraceColor}=== Restart TL === ${defColor}
    Restart TL                      isOAMRebooted=${isOAMRebooted}    GNBCallback=CB007487 Start Capture After GNB Ready
    Dated Log new line              ${consTraceColor}=== WTS setup === ${defColor}
    ${UEnb}                         get length     ${UEsList}

    Run Keyword If                  "${CallType}" == "NSA"     WTS setup          nbUe=${UEnb}   bypassSIB=${True}
    Run Keyword If                  "${CallType}" == "SA"      Setup Wtsemu SA    nbUe=${UEnb}   nbSaUe=${UEnb}
    ...                                                                           list_of_UE_tobe_created=${UEsList}    shouldUseLua=${True}

    UE Cell Setup Check
    ${num_of_cells}=    Get Cell Number
    Wait gNB cells 5g On air    num_of_cells=${num_of_cells}

    [teardown]   CB007487 Capture Stop           cellSetup


CB007487 Start Capture After GNB Ready
    ${CaptureCPRT_setup}            Capture CPRT Set upon config
    ${CaptureCPRT_setup.filter}     Get Filter For SCTP
    Capture Init                    ${CaptureCPRT_setup}            suffix=_cellsetup

    ${CaptureCore_setup}            Capture CORE Set Upon Config
    Capture Init                    ${CaptureCore_setup}            suffix=_cellsetup

    Capture Start                   ${CaptureCPRT_setup}
    Capture Start                   ${CaptureCore_setup}
    Set Suite Variable              ${CaptureCPRT_setup}
    Set Suite Variable              ${CaptureCore_setup}


CB007487 Capture Stop
    [Arguments]                     ${step}
    Run Keyword If                  "${step}" == "cellSetup"        Run Keywords
    ...                             Capture Stop                    ${CaptureCore_setup}
    ...                             AND
    ...                             Capture Stop                    ${CaptureCPRT_setup}
    Run Keyword If                  "${step}" == "Attach"           Run Keywords
    ...                             Capture Stop                    ${CaptureCore_attach}
    ...                             AND
    ...                             Capture Stop                    ${CaptureCPRT_attach}
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureCore_setup.path}
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${CaptureCore_setup.path}    ${testCaseDir}
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureCPRT_setup.path}
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${CaptureCPRT_setup.path}    ${testCaseDir}


CB007487 attach
    [Arguments]                     ${UEsList}    ${CallType}=NSA
    ...                             ${w_UE_CSI_TM_for_4_4_DL_MIMO}=False
    ...                             ${w_UE_beamControl}=False
    Dated Log new line              ${consTraceColor}===UEsList:${UEsList} / CallType:${CallType}
    Dated Log                       w_UE_CSI_TM_for_4_4_DL_MIMO:${w_UE_CSI_TM_for_4_4_DL_MIMO}
    Dated Log                       w_UE_beamControl:${w_UE_beamControl} === ${defColor}
    ${UEsAttached}                  Run Keyword If    "${CallType}" == "NSA"
    ...                             CB007487 NSA attach    ${UEsList}   ${w_UE_CSI_TM_for_4_4_DL_MIMO}
    ...                                                    ${w_UE_beamControl}
	...                             ELSE IF           "${CallType}" == "SA"
    ...                             CB007487 SA attach     ${UEsList}
    ...                             ELSE
    ...                             Create List
    ${nbUE}                         get length    ${UEsList}
    ${nbUEattached}                 get length    ${UEsAttached}
    Dated Log new line              ${consTraceColor}=== Nb UE attached: ${nbUEattached} / ${nbUE} === ${defColor}
    [Return]                        ${UEsAttached}

# csi_override_testmode_nr profile_id=1 cqi_mode=fixed cqi=15 ri_mode=fixed cqi_min=0 cqi_max=15 ri=3 pmi_mode=fixed pmi=0
# csi_override_testmode_nr profile_id=1 cqi_mode=fixed cqi=15 ri_mode=fixed cqi_min=0 cqi_max=15 ri=3 pmi_mode=fixed pmi=1
# ue_testmode_set_nr id=11 testmode=csi_override action=activate profile_id=1 scell=8

CB007487 NSA attach
    [Arguments]                     ${UEsList}
    ...                             ${w_UE_CSI_TM_for_4_4_DL_MIMO}=False
    ...                             ${w_UE_beamControl}=False
    ${UEsAttached}=                 Create List
    ${nbUE}                         get length    ${UEsList}
    Dated Log new line              ${consTraceColor}===UEsList:${UEsList} / nbUE:${nbUE}
    Dated Log                       w_UE_CSI_TM_for_4_4_DL_MIMO:${w_UE_CSI_TM_for_4_4_DL_MIMO}
    Dated Log                       w_UE_beamControl:${w_UE_beamControl} === ${defColor}
    FOR    ${UEcurrent}     IN      @{UEsList}
        Dated Log new line          ${consTraceColor}- NSA call on cell ${UEcurrent.target_cells}: UE ${UEcurrent.ue} / ${nbUE} ${defColor}
        ${Status}  ${capture_path}=   Run Keyword And Ignore Error
        ...                         CB007487_PerfKPI_Keywords.SgNB Addition to ENB         ueSetting=${UEcurrent}
        ...                                                                                W_ADD_SCELL_RANGE_TO_NSA=${w_UE_CSI_TM_for_4_4_DL_MIMO}
        ...                                                                                w_UE_beamControl=${w_UE_beamControl}
        Run Keyword If              '${Status}'=='PASS'
        ...                         Append to list              ${UEsAttached}        ${UEcurrent}
        # first try , to review later => only 1 profile to apply to UEsList !!!
        Run Keyword If              '${w_UE_CSI_TM_for_4_4_DL_MIMO}'=='True'    Override and Activate UE CSI profile
        ...                                      profile_id=1
        ...                                      UeId=${UEcurrent.ue}
        ...                                      nr_cqi=15
        ...                                      nr_cqi_mode=fixed
        ...                                      cqi_min=1     cqi_max=15
        ...                                      nr_ri=3     nr_ri_mode=fixed
        ...                                      nr_pmi=1    nr_pmi_mode=fixed
        Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${capture_path}
        Run Keyword And Ignore Error    OperatingSystem.Move File    ${capture_path}    ${testCaseDir}
    END
    [Return]                        ${UEsAttached}


CB007487 SA attach
    [Arguments]                     ${UEsList}
    ${UEsAttached}=                Create List
    ${nbUE}                         get length    ${UEsList}
    FOR    ${UEcurrent}    IN      @{UEsList}
        Dated Log new line              ${consTraceColor}- SA call on cell ${UEcurrent.target_cells}: UE ${UEcurrent.ue} / ${nbUE} ${defColor}
        ${RegStatus}=              Run Keyword And Return Status
        ...                        UE Register                ue=${UEcurrent.ue}
        #Verify AP Classical UE attach SA
        ${Status}=                 Run Keyword If    ${RegStatus}
        ...                        Run Keyword And Return Status
        ...                        Launch PDU Session         ue=${UEcurrent.ue}    pdu=${UEcurrent.ue}    gw=${UEcurrent.ue}    nwslice=1
        Run Keyword If             ${Status}
        ...                        Append to list              ${UEsAttached}        ${UEcurrent}
    END
    [Return]                        ${UEsAttached}


CB007487 detach
    [Arguments]                     ${UEsList}    ${CallType}=NSA
    Run Keyword If                  "${CallType}" == "NSA"            CB007487 NSA detach    ${UEsList}
    Run Keyword If                  "${CallType}" == "SA"             CB007487 SA detach     ${UEsList}


CB007487 NSA detach
    [Arguments]                     ${UEsList}
    FOR    ${UEcurrent}     IN      @{UEsList}
        Dated Log new line          ${consTraceColor}- Detach UE ${UEcurrent.ue} ${defColor}
        UE Detach Enb               ueSetting=${UEcurrent}
    END


CB007487 SA detach
    [Arguments]                     ${UEsList}
    FOR    ${UEcurrent}    IN       @{UEsList}
        Dated Log new line          ${consTraceColor}- Detach UE ${UEcurrent.ue} ${defColor}
        UE Deregister               id=${UEcurrent.ue}
    END


CB007487 Traffic
    [Arguments]                     ${UEsList}    ${Duration}=0    ${DLtput}=0    ${ULtput}=0    ${shouldBeStop}=False    ${shouldBeCheck}=False
    ...                             ${dev}=10
    ${nbUE}                         get length    ${UEsList}
    Run Keyword If         ${DLtput} != 0 and ${ULtput} != 0    run keywords
    ...                    Dated Log new line    ${consTraceColor}=== Launch DL/UL traffic on ${nbUE} UE(s) === ${defColor}
    ...                    AND
    ...                    Run Keyword And Ignore Error        Traffic UEs UL DL     ueSettingList=${UEsList}
    ...                                                        dlThroughput=${DLtput}    ulThroughput=${ULtput}
	...                                                        duration=${duration}      deviation=${dev}
	...                                                        shouldBeStop=${shouldBeStop}    shouldBeCheck=${shouldBeCheck}
    ...                    ELSE IF    ${DLtput} != 0    run keywords
    ...                    Dated Log new line    ${consTraceColor}=== Launch DL traffic on ${nbUE} UE(s) === ${defColor}
    ...                    AND
    ...                    Run Keyword And Ignore Error        Traffic UEs DL        ueSettingList=${UEsList}
    ...                                                        throughput=${DLtput}    duration=${duration}    deviation=${dev}
    ...                                                        shouldBeStop=${shouldBeStop}    shouldBeCheck=${shouldBeCheck}
    ...                    ELSE IF    ${ULtput} != 0    run keywords
    ...                    Dated Log new line    ${consTraceColor}=== Launch UL traffic on ${nbUE} UE(s) === ${defColor}
    ...                    AND
    ...                    Run Keyword And Ignore Error        Traffic UEs UL        ueSettingList=${UEsList}
    ...                                                        throughput=${ULtput}    duration=${duration}    deviation=${dev}
    ...                                                        shouldBeStop=${shouldBeStop}    shouldBeCheck=${shouldBeCheck}


CB007487 get PM files
    CB007487 Get Reporting Interval PM
    Traced Sleep                    ${reportingIntervalPm}[0]    msg=waiting PM counter generation
    Traced Sleep                    1min                         msg=latest PM file to be available
    ${pm_path}                      Set Variable                 ${LOG_PATH}/pm_files
    ${pm_latest}                    Collect PM files from BTS    ${pm_path}
    Set Suite Variable              ${pm_path}


CB007487 Get Reporting Interval PM
    ${CURRENT_SCF}                  OAM Get SCF File
    ...                             oam=${GNB_DU.oam}            file=SCF_DU_Current.xml
    SCF StartSession                scf_file=${CURRENT_SCF}
    ${dist_name}                    Set Variable                 MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/PMCADM-1
    ${reportingIntervalPm}          SCF Get Single Value         ${dist_name}           reportingIntervalPm
    SCF StopSession                 scf_file=${CURRENT_SCF}
    Dated Log new line              ${consTraceColor}- ReportingIntervalPm is: ${reportingIntervalPm} ${defColor}
    Set Suite Variable              ${reportingIntervalPm}


CB007487 check attach
    [Arguments]                 ${AttachNb}    ${CellID}    ${CallType}
    Dated Log new line      ${consTraceColor}=== Check attach counters === ${defColor}

    ${counters_List}            Set Variable If     "${CallType}"=="NSA"    ${counters_NSA_attach}    ${counters_SA_attach}
    ${expectedValue}            Evaluate             ${AttachNb}*${CallSuccessRate}/100
    ${expectedValue}            Convert To Number    ${expectedValue}    2

    ${Status}                   Set Variable        ${True}
    FOR    ${counter}    IN    @{counters_List}
        ${value}              Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter}    object_id=${CellID}

        Dated Log new line      ${consTraceColor}- ${counter} : ${value} (expected with success rate ${expectedValue}) ${defColor}
        ${Status}               Set Variable If    ${value} < ${expectedValue}    ${False}    ${Status}
    END
    [Return]                    ${Status}


CB007487 check detach
    [Arguments]                 ${DetachNb}    ${CellID}
    Dated Log new line          ${consTraceColor}=== Check detach counters === ${defColor}

    ${expectedValue}            Evaluate             ${DetachNb}*${CallSuccessRate}/100
    ${expectedValue}            Convert To Number    ${expectedValue}    2

    ${Status}                   Set Variable        ${True}
    FOR    ${counter}    IN    @{counters_detach}
        ${value}                Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                     ${pm_path}    NRCELL    ${counter}    object_id=${CellID}

        Dated Log new line      ${consTraceColor}- ${counter} : ${value} (expected with success rate ${expectedValue}) ${defColor}
        ${Status}               Set Variable If    ${value} < ${expectedValue}    ${False}    ${Status}
    END
    [Return]                    ${Status}


CB007487 check traffic
    [Arguments]                 ${UEnb}        ${CellID}    ${CallType}
    ...                         ${Duration}    ${DLtput}    ${ULtput}

    ${DLStatus}                 Run Keyword If    ${Duration} != 0 and ${DLtput} != 0
    ...                         CB007487 check DL traffic    ${UEnb}    ${CellID}    ${CallType}    ${Duration}    ${DLtput}
	...                         ELSE
	...                         Set Variable    ${None}

    ${ULStatus}                 Run Keyword If    ${Duration} != 0 and ${ULtput} != 0
    ...                         CB007487 check UL traffic    ${UEnb}    ${CellID}    ${CallType}    ${Duration}    ${ULtput}
	...                         ELSE
	...                         Set Variable    ${None}

    [Return]                    ${DLStatus}    ${ULStatus}


CB007487 check DL traffic
    [Arguments]                 ${UEnb}    ${CellID}    ${CallType}    ${Duration}    ${DLtput}
    Dated Log new line          ${consTraceColor}=== Check DL traffic counters === ${defColor}

    ${counter_dataVol}          Set Variable If     "${CallType}"=="NSA"    ${counter_DL_RLCdataPDUvolume_NSA}    ${counter_DL_RLCdataPDUvolume_SA}
    ${data_volume}              Retrieve Counter Sum of Values From Pm Files For Object With Name
    ...                         ${pm_path}     NRCELL    ${counter_dataVol}    object_id=${CellID}

    ${expected_data_volume}                Evaluate       ${DLtput}*1000000*${Duration}*${UEnb}/8
    ${expected_data_volume_with_margin}    Evaluate       ${expected_data_volume} - ${expected_data_volume}*${TputVolMargin}/100

    Dated Log new line          ${consTraceColor}- Expected DL data volume min: ${expected_data_volume_with_margin} ${defColor}
    Dated Log new line          ${consTraceColor}- ${counter_dataVol} : ${data_volume} ${defColor}
    ${Status}                   Set Variable If    ${data_volume} > ${expected_data_volume_with_margin}    ${True}    ${False}
    [Return]                    ${Status}


CB007487 check UL traffic
    [Arguments]                 ${UEnb}    ${CellID}    ${CallType}    ${Duration}    ${ULtput}
    Dated Log new line          ${consTraceColor}=== Check UL traffic counters === ${defColor}

    ${counter_dataVol}          Set Variable If     "${CallType}"=="NSA"    ${counter_UL_RLCdataPDUvolume_NSA}    ${counter_UL_RLCdataPDUvolume_SA}
    ${data_volume}              Retrieve Counter Sum of Values From Pm Files For Object With Name
    ...                         ${pm_path}     NRCELL    ${counter_dataVol}    object_id=${CellID}

    ${expected_data_volume}                Evaluate       ${ULtput}*1000000*${Duration}*${UEnb}/8
    ${expected_data_volume_with_margin}    Evaluate       ${expected_data_volume} - ${expected_data_volume}*${TputVolMargin}/100

    Dated Log new line          ${consTraceColor}- Expected UL data volume min: ${expected_data_volume_with_margin} ${defColor}
    Dated Log new line          ${consTraceColor}- ${counter_dataVol} : ${data_volume} ${defColor}
    ${Status}                   Set Variable If    ${data_volume} > ${expected_data_volume_with_margin}    ${True}    ${False}
    [Return]                    ${Status}


CB007487 check BLER
    [Arguments]                 ${CellID}    ${Duration}    ${DLtput}    ${ULtput}

    ${DLBLERStatus}             Run Keyword If    ${Duration} != 0 and ${DLtput} != 0
    ...                         CB007487 check BLER level    dl_or_ul=DL    CellID=${CellID}
	...                         ELSE
	...                         Set Variable    ${None}

    ${ULBLERStatus}             Run Keyword If    ${Duration} != 0 and ${ULtput} != 0
    ...                         CB007487 check BLER level    dl_or_ul=UL    CellID=${CellID}
	...                         ELSE
	...                         Set Variable    ${None}

    [Return]                    ${DLBLERStatus}    ${ULBLERStatus}


CB007487 check BLER level
    [Arguments]                 ${dl_or_ul}    ${CellID}
    Dated Log new line          ${consTraceColor}=== Check BLER ${dl_or_ul} === ${defColor}

    # 1. Initial transmission
    @{counters_initial_transmission}        Run Keyword If          '${dl_or_ul}'=='DL'
    ...                                     Copy List         ${counters_initial_dl_transmission}
    ...                                     ELSE
    ...                                     Copy List         ${counters_initial_ul_transmission}

    ${num_of_initial_transmission}          Set Variable      0
    FOR    ${counter}    IN    @{counters_initial_transmission}
        ${value}              Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter}    object_id=${CellID}

        ${num_of_initial_transmission}      Evaluate          ${num_of_initial_transmission} + ${value}
    END
    Dated Log new line          ${consTraceColor}- Number of initial ${dl_or_ul} transmission: ${num_of_initial_transmission} ${defColor}

    # 2. Successful transmission
    @{counters_successful_transmission}     Run Keyword If          '${dl_or_ul}'=='DL'
    ...                                     Copy List         ${counters_success_dl_transmission}
    ...                                     ELSE
    ...                                     Copy List         ${counters_success_ul_transmission}

    ${num_of_successful_transmission}       Set Variable      0
    FOR    ${counter}    IN    @{counters_successful_transmission}

        ${value}              Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${pm_path}    NRCELL    ${counter}    object_id=${CellID}

        ${num_of_successful_transmission}     Evaluate        ${num_of_successful_transmission} + ${value}
    END
    Dated Log new line          ${consTraceColor}- Number of successful ${dl_or_ul} transmission: ${num_of_successful_transmission} ${defColor}

    ${bler_level}   Run Keyword If  ${num_of_initial_transmission}!=0
    ...             Evaluate    (${num_of_initial_transmission} - ${num_of_successful_transmission})*100 / ${num_of_initial_transmission}
    ...             ELSE
    ...             Set Variable    100

    Dated Log new line          ${consTraceColor}- BLER ${dl_or_ul}: ${bler_level}% (expected max ${maxBLER}%) ${defColor}
    ${Status}                   Set Variable If    ${bler_level} < ${maxBLER}    ${True}    ${False}
    [Return]                    ${Status}


CB007487 check status
    [Arguments]                 ${AttachStatus}    ${DetachStatus}
    ...                         ${DLtputStatus}    ${ULtputStatus}
    ...                         ${DLBLERStatus}    ${ULBLERStatus}

    Dated Log new line     ${consTraceColor}=== Check result === ${defColor}
    Dated Log new line     ${consTraceColor}=== Attach: ${AttachStatus}, Detach: ${DetachStatus} ${defColor}
    Dated Log new line     ${consTraceColor}=== Traffic: DL ${DLtputStatus}, UL ${ULtputStatus} ${defColor}
    Dated Log new line     ${consTraceColor}=== BLER: DL ${DLBLERStatus}, UL ${ULBLERStatus} ${defColor}

    ${DLStatus}            Evaluate    (${DLtputStatus} and ${DLBLERStatus}) or ${DLtputStatus} == ${None}
    ${ULStatus}            Evaluate    (${ULtputStatus} and ${ULBLERStatus}) or ${ULtputStatus} == ${None}

    Dated Log new line     AttachStatus ${AttachStatus} and DetachStatus ${DetachStatus} and DLStatus ${DLStatus} and ULStatus ${ULStatus}
    Should be True         ${AttachStatus} and ${DetachStatus} and ${DLStatus} and ${ULStatus}

Get Orignal Configuration 7487
   [Arguments]                   ${BACKUP_DIR}=original_config_files

    # Save current  SCF file
    ${file_name}   set variable     SCF_7487_original.xml
    ${original_scf_file}            OAM Get SCF File                file=${file_name}
    Set Suite Variable              ${original_scf_file}
    Run keyword and Ignore error   OperatingSystem.Copy File    ${original_scf_file}
    ...                                                         ${LOG_PATH}/${BACKUP_DIR}/${file_name}
    Dated Log New Line         Original SCF file stored to ${LOG_PATH}/${BACKUP_DIR}/${file_name}

    # Get swconfig file that will be restored during test suite teardown
    ${ret}   ${alias_gnb}          Run keyword and Ignore error          SSH Wait For Connect                ${GNB_DU.sys[0].M}
    ${file_name}   set variable     swconfig_original.txt
    Run keyword and Ignore error    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                                                             local_path=${LOG_PATH}/${file_name}
    ...                                                             connection=${alias_gnb}
    Run keyword and Ignore error   OperatingSystem.Copy File    ${LOG_PATH}/${file_name}
    ...                                                         ${LOG_PATH}/${BACKUP_DIR}/${file_name}
    Dated Log                  Default swconfig file stored to ${LOG_PATH}/${BACKUP_DIR}/${file_name}

    # Get EPC file configuration:
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    ${file_name}   set variable     basic_wts_original.cfg
    csn.download_file               remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${LOG_PATH}/${file_name}
    ...                             connection=${alias_epc}
    Run keyword and Ignore error   OperatingSystem.Copy File    ${LOG_PATH}/${file_name}    ${LOG_PATH}/${BACKUP_DIR}/${file_name}
    Dated Log                  Default basic cfg file stored to ${LOG_PATH}/${BACKUP_DIR}/${file_name}

    ${file_name}   set variable     iphy_original.xml
    Run keyword and Ignore error      CB007487_PerfKPI_Keywords.Get iPhy.xml file from Airphone    target_dir=${LOG_PATH}    file_name=${file_name}
    Run keyword and Ignore error     OperatingSystem.Copy File    ${LOG_PATH}/${file_name}    ${LOG_PATH}/${BACKUP_DIR}/${file_name}
    Dated Log                  Default /ffs/run/simmode/iphy.xml from Airphone stored to ${LOG_PATH}/${BACKUP_DIR}/${file_name}

    # Get AP configuration file
    ${ap_configfile}                Get XML AirPhoneConfig Path
    return from Keyword if     '${ap_configfile}'=='${EMPTY}'
    ${file_name}   set variable     ApOamConfig_to_be_restored.xml
    csn.download_file               remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${LOG_PATH}/${file_name}
    ...                             connection=${alias_epc}
    Run keyword and Ignore error     OperatingSystem.Copy File    ${LOG_PATH}/${file_name}    ${LOG_PATH}/${BACKUP_DIR}/${file_name}
    Dated Log                  Default AP Oam Config file stored to ${LOG_PATH}/${BACKUP_DIR}/${file_name}

Restore Orignal Configuration 7487

   # Get swconfig file that will be restored during test suite teardown
    ${status}    ${alias_gnb}          Run Keyword And Ignore Error        SSH Wait For Connect                ${GNB_DU.sys[0].M}
    Run Keyword And Ignore Error       csn.upload_file                 remote_path=${SWCONFIG_PATH}
    ...                             local_path=${LOG_PATH}/swconfig_original.txt
    ...                             connection=${alias_gnb}

    SSH Exec                        command=crasign ${SWCONFIG_PATH}           alias=${alias_gnb}

    Dated Log                 swconfig file has been restored to default (${LOG_PATH}/swconfig_original.txt)

    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.upload_file                 remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${LOG_PATH}/basic_wts_original.cfg
    ...                             connection=${alias_epc}

    Dated Log                basic cfg file has been restored to default (${LOG_PATH}/basic_wts_original.cfg)

    ${file_name}   set variable     iphy_original.xml
    Run keyword and Ignore error      CB007487_PerfKPI_Keywords.Restore iPhy.xml file to Airphone    local_dir=${LOG_PATH}    file_name=${file_name}
    Dated Log            /ffs/run/simmode/iphy.xml has been restored with default ${LOG_PATH}/${file_name}

    ${ap_configfile}                Get XML AirPhoneConfig Path
    return from Keyword if     '${ap_configfile}'=='${EMPTY}'
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.upload_file                 remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${LOG_PATH}/ApOamConfig_to_be_restored.xml
    ...                             connection=${alias_epc}

    Dated Log            ApOamConfig has been restored to default (${LOG_PATH}/ApOamConfig_to_be_restored.xml)

Restore iPhy.xml file to Airphone
    [Documentation]    :Author: Ch SAMSON
    ...
    ...     :param ue_id:         Id of gnb                       [0.. ]  default=0
    ...     :param comu_id:       Id of Common Unit               [0..1]  default=0
    ...     :param target_dir:    (default None) save swconfig to path
    ...
    ...     :return:   swconfig path for further usage
    ...
    [Arguments]    ${ue_id}=${0}    ${comu_id}=${0}    ${local_dir}=None    ${file_name}=ap_new_iphy.xml
    ${local_dir}=    Run Keyword If    '${local_dir}'=='None'    CB007487_PerfKPI_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${local_dir}
    ${ap_alias}=    CB007487_PerfKPI_Keywords.Connect to Airphone Common Unit    ue_id=${ue_id}    ue_comu_id=${comu_id}
    ${iphy_filename}     set variable    iphy.xml
    ssh.upload File    local_path=${local_dir}/${file_name}    remote_path=/ffs/run/simmode/${iphy_filename}       connection=${ap_alias}
    [Return]    ${local_dir}/${file_name}

Create Test Suite Folder
    [Documentation]    create test suite folder
    [Arguments]    ${with_timestamp}=${FALSE}
    ${timeStamp}    get current date    result_format=%Y%m%d_%H%M%S
    ${SUITE_NAME}    Replace String    ${SUITE_NAME}    ${SPACE}    _
    ${testSuiteDir}    set variable if    '${with_timestamp}'=='${TRUE}'   ${LOG_PATH}/${SUITE_NAME}/${timeStamp}
    ...                                                                    ${LOG_PATH}
    Set Suite Variable    ${testSuiteDir}
    # Set Suite Variable    ${testSuiteDir}    ${LOG_PATH}/${SUITE_NAME}/${timeStamp}
    # Set Suite Variable    ${testSuiteDir}    ${LOG_PATH}
    Run Keyword if    '${with_timestamp}'=='${TRUE}'     create directory    ${testSuiteDir}

Create Test Case Folder
    [Documentation]    create test case folder
    ${testCaseDir}    Replace String    ${TEST_NAME}    ${SPACE}    _
    ${testCaseDir}    nps_7487_tools.filter_non_printable_and_remove_head    ${testCaseDir}
    ${testCaseDir}    Replace String    ${testCaseDir[0:30]}    ${SPACE}    _
    ${testCaseDir}    Replace String    ${testCaseDir}    .    _
    Dated log       Create Test Case Folder ${testSuiteDir}/${testCaseDir}
    Set Suite Variable    ${testCaseDir}    ${testSuiteDir}/${testCaseDir}
    Create Directory    ${testCaseDir}

Create Test Case Folder OLD
    [Documentation]    create test case folder
    ${testCaseDir}    Replace String    ${TEST_NAME[0:30]}    ${SPACE}    _
    ${testCaseDir}    Remove String    ${testCaseDir}    [1]
    ${testCaseDir}    Remove String    ${testCaseDir}    [1.0]_
    ${testCaseDir}    Replace String    ${testCaseDir}    .    _
    Dated log       Create Test Case Folder ${testSuiteDir}/${testCaseDir}
    Set Suite Variable    ${testCaseDir}    ${testSuiteDir}/${testCaseDir}
    Create Directory    ${testCaseDir}

Get testcase log directory
    [Documentation]    :Author: Ch SAMSON
    ...    Retuns path for Testcase log directory
    ...    If Testcase Log directory does not exist it will created automatically
    ...
    ...    :returns: Path for Testcase log
    ...
    ${P_resultTestDir}=    Get Variable Value    ${testCaseDir}
    Run Keyword If    '${P_resultTestDir}'=='None'
    ...    Create Test Case Folder
    ${P_resultTestDir} =    Get Variable Value   ${testCaseDir}
    [Return]    ${P_resultTestDir}

Prepare Test Name
    [Documentation]    :Author: Ch SAMSON
    ...    Retuns formated test name
    ...
    ...    :returns: formated test name
    ...
    ${TEST_NAME}=       replace string  ${TEST_NAME}      ${SPACE}        _
    set test variable      ${TEST_NAME}
    [Return]    ${TEST_NAME}

Prepare Logs Directory Path
    [Arguments]    ${resultDir}=None   ${subdir}=${EMPTY}    ${with_timestamp}=${FALSE}
    [Documentation]
    ...    Creates directory for storing logs, based on current execution context.
    ...    An absolute path to created directory is returned.
    [Tags]    PRIVATE
    ${timestamp}=    DateTime.Get Current Date    result_format=%Y%m%d-%H%M%S
    ${subdir}    set variable if    '${with_timestamp}'=='${TRUE}'   ${subdir}_${timestamp}
    ...                                                              ${subdir}
    ${resultDir}=    Run Keyword If    '${resultDir}'=='None'    CB007487_PerfKPI_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${resultDir}
    ${logs_dir}   set variable     ${resultDir}/${subdir}
    OperatingSystem.Create Directory    ${logs_dir}
    [Return]    ${logs_dir}

Collect EGATE console Logs
    [Documentation]    This keyword is used to collect egate_console.log from the /opt/wts/latest/ folder
    ...                This is collected in the Test Log Folder
    [Arguments]       ${target_dir}=None
    ${local_target_dir}=    Run Keyword If    '${target_dir}'=='None'    CB007487_PerfKPI_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}

    ute_wtssim.setup_egate      egate_port=${tl.core.egate_port}
    ...                         host_ip=${tl.core.default_ssh_connection_details.addr}
    ...                         tool_dir=${tl.core.dir_path}
    ...                         alias=ap_egate
    ...                         ssh_user=ute
    ...                         ssh_pass=ute
    ute_wtssim.execute egate command         cmd=sim_log_set flush  timeout=1s  alias=ap_egate
    ute_wtssim.teardown_egate    alias=ap_egate

    # Connect to LTEEMU   alias=lteemu_alias
    ${alias}        SSH Connect   host=${HOST_EPCSIM}

    Dated Log      Collecting ${tl.core.dir_path}/egate_console.log...
    csn.download_file               remote_path=${tl.core.dir_path}/egate_console.log
    ...                             local_path=${local_target_dir}/egate_console.log
    ...                             connection=${alias}
    Dated Log                  egate_console.log file stored to ${local_target_dir}

Get APL3 log from Airphone TO REMOVE
    [Documentation]    :Author: Ch SAMSON
    ...
    ...     :param ue_id:         Id of gnb                       [0.. ]  default=0
    ...     :param comu_id:       Id of Common Unit               [0..1]  default=0
    ...     :param target_dir:    (default None) save swconfig to path
    ...
    ...     :return:   swconfig path for further usage
    ...
    [Arguments]    ${ue_id}=${0}    ${comu_id}=${0}    ${target_dir}=None
    ${target_dir}=    Run Keyword If    '${target_dir}'=='None'    CB007487_PerfKPI_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}
    ${ap_alias}=    CB007487_PerfKPI_Keywords.Connect to Airphone Common Unit    ue_id=${ue_id}    ue_comu_id=${comu_id}
    ssh.Download File    remote_path=/ram/startup_l3.log    local_path=${target_dir}/ap_APL3.log    connection=${ap_alias}
    [Return]    ${target_dir}/ap_APL3.log

Get APL3 log from Airphone
    [Documentation]    :Author: Ch SAMSON
    ...
    ...     :param ue_id:         Id of gnb                       [0.. ]  default=0
    ...     :param comu_id:       Id of Common Unit               [0..1]  default=0
    ...     :param target_dir:    (default None) save swconfig to path
    ...
    ...     :return:   startup_l3_log for further usage
    ...
    [Arguments]    ${ue_id}=${0}    ${comu_id}=${0}    ${target_dir}=None
    ${target_dir}=    Run Keyword If    '${target_dir}'=='None'    CB007487_PerfKPI_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}
    ${ap_alias}=    CB007487_PerfKPI_Keywords.Connect to Airphone Common Unit    ue_id=${ue_id}    ue_comu_id=${comu_id}
    Dated log                       Check the startup_l3.log file: zipped or not zipped
    ssh.send command    ls -ltr /ram/startup_l3.log.xz   connection=${ap_alias}
    ${output_1}=    ssh.read output   connection=${ap_alias}
    ssh.send command    ls -ltr /ram/startup_l3.log   connection=${ap_alias}
    ${output_2}=    ssh.read output   connection=${ap_alias}
    ${lenght_1}                     Get Length                              ${output_1}
    ${length_2}                     Get Length                              ${output_2}
    Dated log                       AP startup_l3 length_xz:${lenght_1} - lenght_non_xz:${length_2}
    ${APL3_log}=    Set Variable If                 ${lenght_1} != 0                        startup_l3.log.xz
    ...                                             ${length_2} != 0                        startup_l3.log
    ...                                                                                     startup_l3.log
    ssh.Download File    remote_path=/ram/${APL3_log}    local_path=${target_dir}/ap_${APL3_log}    connection=${ap_alias}
    [Return]    ${target_dir}/ap_${APL3_log}

Get iPhy.xml file from Airphone
    [Documentation]    :Author: Ch SAMSON
    ...
    ...     :param ue_id:         Id of gnb                       [0.. ]  default=0
    ...     :param comu_id:       Id of Common Unit               [0..1]  default=0
    ...     :param target_dir:    (default None) save swconfig to path
    ...
    ...     :return:   swconfig path for further usage
    ...
    [Arguments]    ${ue_id}=${0}    ${comu_id}=${0}    ${target_dir}=None    ${file_name}=ap_iphy.xml
    ${target_dir}=    Run Keyword If    '${target_dir}'=='None'    CB007487_PerfKPI_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}
    ${ap_alias}=    CB007487_PerfKPI_Keywords.Connect to Airphone Common Unit    ue_id=${ue_id}    ue_comu_id=${comu_id}
    # WARNING : need to adapt new_iphy.xml  => iphy.xml  for AiC tests !!!
    # ${iphy_filename}     set variable if     ${isAiC}       iphy.xml
    # ...                                                     new_iphy.xml
    ${iphy_filename}     set variable     iphy.xml
    ssh.Download File    remote_path=/ffs/run/simmode/${iphy_filename}    local_path=${target_dir}/${file_name}    connection=${ap_alias}
    [Return]    ${target_dir}/${file_name}

Get SWCONFIG file from Airphone
    [Documentation]    :Author: Ch SAMSON
    ...
    ...     :param ue_id:         Id of gnb                       [0.. ]  default=0
    ...     :param comu_id:       Id of Common Unit               [0..1]  default=0
    ...     :param target_dir:    (default None) save swconfig to path
    ...
    ...     :return:   swconfig path for further usage
    ...
    [Arguments]    ${ue_id}=${0}    ${comu_id}=${0}    ${target_dir}=None    ${file_name}=ap_swconfig.txt
    ${target_dir}=    Run Keyword If    '${target_dir}'=='None'    CB007487_PerfKPI_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}
    ${ap_alias}=    CB007487_PerfKPI_Keywords.Connect to Airphone Common Unit    ue_id=${ue_id}    ue_comu_id=${comu_id}
    ${swconfig_filename}     set variable       swconfig.txt
    ssh.Download File    remote_path=/ffs/run/${swconfig_filename}    local_path=${target_dir}/${file_name}    connection=${ap_alias}
    [Return]    ${target_dir}/${file_name}

Connect to Airphone Common Unit
    [Documentation]    :
    ...     setup ssh connection to Airphone Airscale (ASXX) and returns connection handle/alias
    ...
    ...     :param ue_id:             Id of UE                       [0.. ]  default=0
    ...     :param ue_comu_id:        Id of AP Common Unit           [0..1]  default=0
    ...     :param alias:       (optional) connection alias  !! should not be used
    ...
    ...     :returns alias:     alias for ssh connection to Common Unit
    ...
    ...     **Example:**
    ...
    ...     | ${ap_alias}=   connect.Connect to Airphone Common Unit    ue_id=0  ue_comu_id=0
    ...     | ssh.execute     command=uptime  connection=${ap_alias}
    ...
    [Arguments]    ${ue_id}=${0}    ${ue_comu_id}=${0}  ${alias}=ssh-ap-${ue_id}-${ue_comu_id}
    ssh.Connect_to      hostname=${tl.ues[${ue_id}].l1.common_units[${ue_comu_id}].lmp_connection.addr}
    ...                 username=${tl.ues[${ue_id}].l1.common_units[${ue_comu_id}].lmp_connection.username}
    ...                 password=${tl.ues[${ue_id}].l1.common_units[${ue_comu_id}].lmp_connection.password}
    ...                 alias=${alias}
    ssh.Force Reconnect    connection=${alias}
    [Return]    ${alias}

SgNB Addition to ENB
    [Documentation]          Attach a NSA UE via eNB by using keyword 'UE Attach Enb' (for more details see keyword 'UE Attach Enb').
    ...                      Then trig the SgNB Addition procedure by using keyword 'UE Attach Gnb' (for more details see keyword 'UE Attach Gnb').
    ...                      A SCTP capture is also started during the SgNB addition.
    ...                      Also, another capture (for instance, for BIP messages) may be performed on demand:
    ...                      meaning if a <captureCallback> and its asociated <capture> structure is provided through arguments.
    ...                      Return path of trace capture file.
    ...
    ...                      *Argument details:*
    ...                      - *ueSetting*:        Reference to UE Settings  (default value = UE_NO_PROFILE)
    ...                      - *captureCallback*:  Reference to a KW call back or None  (default value = None)
    ...                      - *capture*:          Associated <Capture> structure if Callback is provided  (default value = None)
    ...                      - *expected_gnb_log*: Msg to validate enb_ue_dc_start (default value = reported successful RA)
    ...                      - *withTN*:           If set to True, Test Name will be part of the pcap file (default value = False)
    [Arguments]                     ${ueSetting}=${UE_NO_PROFILE}
    ...                             ${captureCallback}=None
    ...                             ${capture}=None
    ...                             ${expected_gnb_log}=reported successful RA
    ...                             ${withTN}=${False}
    ...                             ${W_ADD_SCELL_RANGE_TO_NSA}=${False}
    ...                             ${w_UE_beamControl}=False
    Dated Log New Line              Starting GNB attach to ENB
    ${captureCORE}                  Capture CORE Set Upon Config
    Capture Init                    ${captureCORE}
    ...                                 withTN=${WithTN}
    ...                                 suffix=_GNB_ADDITION_UE${ueSetting.ue}
    Capture Start                   ${captureCORE}
    UE Attach Enb                   ueSetting=${ueSetting}
    Run keyword if                  '${W_ADD_SCELL_RANGE_TO_NSA}'=='True'        Add Scell Range To NSA
    Traced Sleep                    duration=5s                    msg=Workaround for pb Attach Gnb
    Run Keyword If              '${w_UE_beamControl}'=='True'    Activate UE beam control profile
    ...                                      profile_id=2
    ...                                      UeId=${ueSetting.ue}
    ...                                      ueBeamIndexInitial=0,1,2,3,4,5
    ...                                      ssbeam_bestbeam=5
    ...                                      ssbeam_rsrp_best=-44
    ...                                      ssbeam_rsrp_avg=-50
    UE Attach Gnb                   ueSetting=${ueSetting}
    ...                             captureCallback=${captureCallback}
    ...                             capture=${capture}
    ...                             expected_gnb_log=${expected_gnb_log}
    Capture Stop                    ${captureCORE}
    [Teardown]                      Run keyword if                          '${KEYWORD_STATUS}'!='PASS'
    ...                             Capture Stop                            ${captureCORE}
    [Return]                        ${captureCORE.path}

# NSA WA for cqi TM
# enb_endc_param id=1 serving_cell_index_range_scg=5:31
Add Scell Range To NSA
    [Arguments]        ${eNBId}=1            ${alias}=default
    Log To Console    add scell range to NSA...
    wtsemu.enb_endc_param    id=${eNBId}    serving_cell_index_range_scg=8:31

# ex
# Override CSI profile
# csi_override_testmode_nr profile_id=1 cqi=15 cqi_mode=fixed ri=1 ri_mode=fixed
# csi_override_testmode_nr profile_id=1' | pass_regexp='csi_override_testmode_nr Parameters
# and activate CSI profile  ( id = UeId)
# ue_testmode_set_nr id=11 scell=5 testmode=csi_override profile_id=1 action=activate

Associate UEs to testmode
    [Documentation]    :
    ...
    ...    :param id:          specified UE ID
    ...    :param scell:       carrier Aggregation serving cell (carrier component, CC). Primary is for scell index 0.
    ...                        Secondary is for scell indexes 1-7.
    ...    :param testmode:    testmode to be used
    ...    :param profile_id:  test profile id
    ...    :param action:      triggers the activation or the deactivation of the test mode (activate or deactivate)
    ...
    [Arguments]    ${id}    ${testmode}    ${profile_id}    ${action}    ${scell}=0       ${alias}=default
    wtsemu.ue_testmode_set_nr   id=${id}  scell=${scell}  testmode=${testmode}  profile_id=${profile_id}  action=${action}
    Sleep    1s    reason=wait command to be executed
    BuiltIn.Log    ${action} testmode ${testmode} for UE=${id} scell=${scell} and profile_id ${profile_id}    console=True


Override and Activate UE CSI profile
    [Arguments]        ${profile_id}=1   ${UeId}=1   ${nr_cqi}=15    ${nr_cqi_mode}=fixed  ${cqi_min}=1     ${cqi_max}=15
    ...                      ${nr_ri}=1    ${nr_ri_mode}=fixed    ${nr_pmi}=0    ${nr_pmi_mode}=fixed    ${alias}=default
    Log To Console    Override and Activate UE CSI profile...
    wtsemu.csi_override_testmode_nr    profile_id=${profile_id}  cqi=${nr_cqi}  cqi_mode=${nr_cqi_mode}  cqi_min=${cqi_min}
    ...                                cqi_max=${cqi_max}  ri=${nr_ri}  ri_mode=${nr_ri_mode}  pmi_mode=${nr_pmi_mode}    pmi=${nr_pmi}
    ${cmd}=   Catenate   csi_override_testmode_nr profile_id=${profile_id}
    ${pattern}     Set Variable        csi_override_testmode_nr Parameters
    ${output}    wtsemu.csi_override_testmode_nr   profile_id=${profile_id}
    ${output}    wtsemu.Read Wtsemu Output Until Re     expected=${pattern}       timeout=5
    ${output}    String.Get Lines Matching Regexp    ${output}    ${pattern}    partial_match=True
    Dated log        ${cmd}
    Log To Console    \n${output}
    BuiltIn.Log     Channel State Information for UE${UeId} is updated with cqi=${nr_cqi} cqi_mode=${nr_cqi_mode} ri=${nr_ri} ri_mode=${nr_ri_mode}
    Log To Console    Associate UE to testmode...
    Associate UEs to testmode    id=${ue_id}    testmode=csi_override    profile_id=${profile_id}    action=activate    scell=8      alias=${alias}
    Log To Console    set_UE_CQI_Testmode_is_ok
    ${cmd}=   Catenate   csi_override_testmode_nr profile_id=${profile_id}
    ${output}    wtsemu.csi_override_testmode_nr   profile_id=${profile_id}
    ${output}    wtsemu.read_wtsemu_output_until_prompt     timeout=5
    Dated log        ${cmd}
    Log To Console    \n${output}


# example beam control test mode
#EGATE> beam_control_testmode_nr profile_id=2 ueBeamIndexInitial=0,1,2,3,4,5
#       ssbeam_bestbeam=5 ssbeam_rsrp_best=-44 ssbeam_rsrp_avg=-50
#EGATE> beam_control_testmode_nr   profile_id=2
#beam_control_testmode_nr Parameters
#====================================================
#Parameter               Value
#----------------------------------------------------
#profile_id              2
#ueBeamIndexInitial      0  1  2  3  4  5  64  64
#l1SsBeamMeasurement     off
#l1CsiRsBeamMeasurement  off
#beamType                0
#ssbeam_bestbeam         5
#ssbeam_rsrp_best        -44.000000
#ssbeam_rsrq_best        0.000000
#ssbeam_sinr_best        0.000000
#ssbeam_rsrp_avg         -50.00
#ssbeam_rsrq_avg         0.00
#ssbeam_sinr_avg         0.00
#csirs_bestbeam
#csirs_rsrp_best
#csirs_rsrq_best
#csirs_sinr_best
#csirs_rsrp_avg          -43.90
#csirs_rsrq_avg          0.00
#csirs_sinr_avg          0.00
#====================================================
Associate UEs to beam_control testmode
    [Documentation]    :
    ...
    ...    :param id:          specified UE ID
    ...    :param testmode:    testmode to be used
    ...    :param profile_id:  test profile id
    ...    :param action:      triggers the activation or the deactivation of the test mode (activate or deactivate)
    ...    :param beamaction:  Beamaction is triggered only during BeamControlTestMode to attach, switch or recovery
    [Arguments]    ${id}    ${testmode}    ${profile_id}    ${action}    ${beamaction}=attach       ${alias}=default
    wtsemu.ue_testmode_set_nr   id=${id}  testmode=${testmode}  profile_id=${profile_id}  action=${action}   beamaction=${beamaction}
    Sleep    1s    reason=wait command to be executed
    BuiltIn.Log    ${action} testmode ${testmode} for UE=${id} and profile_id ${profile_id}    console=True


Activate UE beam control profile
    [Arguments]        ${profile_id}=2   ${UeId}=1   ${ueBeamIndexInitial}=0,1,2,3,4,5
    ...                ${ssbeam_bestbeam}=5   ${ssbeam_rsrp_best}=-44   ${ssbeam_rsrp_avg}=-50   ${alias}=default
    Log To Console    Activate UE beam control profile...
    wtsemu.beam_control_testmode_nr    profile_id=${profile_id}  ueBeamIndexInitial=${ueBeamIndexInitial}
    ...                                ssbeam_bestbeam=${ssbeam_bestbeam}
    ...                                ssbeam_rsrp_best=${ssbeam_rsrp_best}
    ...                                ssbeam_rsrp_avg=${ssbeam_rsrp_avg}
    ${cmd}=   Catenate   beam_control_testmode_nr profile_id=${profile_id}
    ${pattern}     Set Variable        beam_control_testmode_nr Parameters
    ${output}    wtsemu.beam_control_testmode_nr   profile_id=${profile_id}
    ${output}    wtsemu.Read Wtsemu Output Until Re     expected=${pattern}       timeout=5
    ${output}    String.Get Lines Matching Regexp    ${output}    ${pattern}    partial_match=True
    Dated log        ${cmd}
    Log To Console    \n${output}
    BuiltIn.Log     Beam Control for UE${UeId} is updated with ueBeamIndexInitial=${ueBeamIndexInitial} ssbeam_bestbeam=${ssbeam_bestbeam}
    Log To Console    Associate UE to testmode for beam forming...
    Associate UEs to beam_control testmode    id=${ue_id}    testmode=beam_control    profile_id=${profile_id}    action=activate
    ...                                       beamaction=attach      alias=${alias}
    Log To Console    set_UE_Beam_Testmode_is_ok
    ${cmd}=   Catenate   beam_control_testmode_nr profile_id=${profile_id}
    ${output}    wtsemu.beam_control_testmode_nr   profile_id=${profile_id}
    ${output}    wtsemu.read_wtsemu_output_until_prompt     timeout=5
    Dated log        ${cmd}
    Log To Console    \n${output}

Get TTI traces
    [Arguments]     ${time}=1s
    Dated Log         Start TTI Traces in Streaming Mode
    ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traced Sleep    ${time}      msg=Waiting for TTI Traces
    Dated log         Stop TTI Traces in Streaming Mode...
    ${tti_trace_path}=     ttitrace.Stop TTI Traces in Streaming Mode      tti_trace_path=${testCaseDir}
    Dated log         Decode TTI Traces...
    nps_ttitraces_tools.decode_tti_traces_using_TtitraceReaderEvtDec    desired_storage_directory=${testCaseDir}    num_of_events=30000
    Dated log         Convert TTI trace from pcap to excelCsv...
    Run keyword and continue on failure    ttitrace.Convert TTI trace from pcap to excelCsv     input_file_path=${tti_trace_path}
    ...                                                                                         output_file_path=${testCaseDir}

Get TTI traces 2
    [Arguments]     ${suffix}=${EMPTY}   ${time}=1s    ${event_nr_max}=30000   ${w_convert_pcap_to_excelCsv}=True
    ${tm}    Get Current Date
    ${tm}=    Remove String    ${tm.replace(' ','-')}    .
    Dated Log         Start TTI Traces in Streaming Mode
    ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traced Sleep    ${time}      msg=Waiting for TTI Traces
    Dated log         Stop TTI Traces in Streaming Mode...
    ${ttiTraceSubDir}   set Variable    TtiTrace-${time}-${tm}
    ${ttiTraceSubDir}   set Variable if    '${suffix}'!='${EMPTY}'     ${ttiTraceSubDir}-${suffix}
    ...                                                                ${ttiTraceSubDir}
    ${tti_trace_path}=     ttitrace.Stop TTI Traces in Streaming Mode    tti_trace_path=${testCaseDir}/${ttiTraceSubDir}
    Dated log         Decode TTI Traces...
    nps_ttitraces_tools.decode_tti_traces_using_TtitraceReaderEvtDec       desired_storage_directory=${testCaseDir}/${ttiTraceSubDir}
    ...                                                                    num_of_events=${event_nr_max}
    run keyword if   '${w_convert_pcap_to_excelCsv}'=='True'    run keywords
    ...               Dated log    Convert TTI trace from pcap to excelCsv...    AND
    ...               Run keyword and continue on failure     ttitrace.Convert TTI trace from pcap to excelCsv     input_file_path=${tti_trace_path}
    ...                                                                    output_file_path=${testCaseDir}/${ttiTraceSubDir}
    [return]     ${testCaseDir}/${ttiTraceSubDir}

Get L1L2 traces
    [Arguments]     ${time}=1s   ${prefix}=DL_UL_Tput
    Dated Log         Get L1L2 Bip Traces
    ${CaptureBIP}              Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    ${CaptureBIP.prefix}       set Variable   ${prefix}
    ${CaptureBIP.withTN}       set Variable   True
    # ${CaptureBIP.filter}       Get Filter all BIP msgs
    # ${CaptureBIP.filter}       set variable   'ether[18:2]=0x8951'
    Capture Init   ${CaptureBIP}
    Capture start  ${CaptureBIP}
    Traced Sleep   ${time}     msg=take BIP L1L2 traces with ${prefix}
    Capture stop   ${CaptureBIP}
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureBIP.path}
    ${status}  ${path}   Run Keyword And Ignore Error    OperatingSystem.Move File    ${CaptureBIP.path}    ${testCaseDir}
    [Return]    ${path}

Get gNB mirroring into local repo
    ${local_repo}    set variable    repo
    run   command=mkdir ${LOG_PATH}${/}${local_repo}
    set global variable    ${LOCAL_REPO_DIR}    ${LOG_PATH}${/}${local_repo}
    Dated log        cp ${CURDIR}/resources/shell/bip_mirroring_ASIL_wo_tcpdump.sh ${LOCAL_REPO_DIR}
    run   command=cp ${CURDIR}/../shell/bip_mirroring_ASIL_wo_tcpdump.sh ${LOCAL_REPO_DIR}

GNB Mirror Script Install
    [Documentation]                 Install mirroring script on target
    [Arguments]                     ${scriptDef}     ${PathToScriptsRepo}=${LOCAL_REPO_DIR}

    # Install mirroring script on target
    Dated log                       Download scripts for mirroring: ${scriptDef.names}
    ${alias}                        SSH Wait For Connect                    ${scriptDef.host}
    # FOR    ${script}        IN      @{scriptDef.names}
    # SSH Upload Script           alias=${alias}                          scriptFile=${script}    localPath=${PathToScriptsRepo}
    # ...                         remotePath=${scriptDef.remotePath}
    SSH Upload Script           alias=${alias}            scriptFile=${scriptDef.names}    localPath=${PathToScriptsRepo}
    ...                         remotePath=${scriptDef.remotePath}
    # END

    ${mirrorslot}                   Set Variable If                         '${GNB_DU.domainId}'=='1'
    ...                             1                                       5
    # ${OPT_GNB_MIRRORING.bb_slot}                    set Variable     bb_slot_${mirrorslot}
    ${OPT_GNB_MIRRORING.bb_slot}                    set Variable     ${mirrorslot}

Conn.Execute
    [Arguments]     ${cmd}    ${alias}
    ${result}    ssh.execute    command=${cmd}    connection=${alias}
    [return]    ${result}

Conn.DownloadFile
    [Arguments]     ${local_path}    ${remote_path}    ${alias}
    ${result}     ssh.download_file    remote_path=${remote_path}    local_path=${local_path}    connection=${alias}
    [Return]    ${result}

Conn.Disconnect
    [Arguments]    ${alias}
    ssh.disconnect    connection=${alias}

Execute Mirror Script with options
    [Documentation]                 Execute mirroring script on target
    [Arguments]                     ${scriptDef}     ${opt_gnb_mirroring}   ${location}=/ffs/run/config/scripts    ${local_dir}=None

    ${local_target_dir}=    Run Keyword If    '${local_dir}'=='None'    CB007487_PerfKPI_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${local_dir}

    ssh.Connect to    ${GNB_DU.sys[0].M.sshConnection.addr}
    ...               ${GNB_DU.sys[0].M.sshConnection.username}
    ...               ${GNB_DU.sys[0].M.sshConnection.password}
    ...                alias=ALIAS_GNB

    Conn.Execute  cmd=rm -rf ${location}/Launch.gNB*.log   alias=ALIAS_GNB
    ${timestamp}=    DateTime.Get Current Date    result_format=%Y%m%d-%H%M%S
    ${LAUNCH_LOG}   set Variable   Launch.gNB.gnbMirroring.${timestamp}.log
    # ${scriptDef_cmd}   set Variable   bip_mirroring_ASIL_wo_tcpdump.sh
    ${cmd}=   catenate     ${scriptDef.cmd}
    ...                    ${opt_gnb_mirroring.bb_slot}|tee ${location}/${LAUNCH_LOG}
    Dated log      cmd to launch Mirror Script=${cmd}
    Conn.Execute    cmd=${cmd}      alias=ALIAS_GNB
    Conn.DownloadFile  local_path=${local_target_dir}${/}${LAUNCH_LOG}  remote_path=${location}/${LAUNCH_LOG}   alias=ALIAS_GNB
    Conn.Disconnect  alias=ALIAS_GNB

Get L1L2 traces Version ABIP
    [Arguments]     ${time}=1s   ${prefix}=DL_UL_Tput
    Dated Log         Get L1L2 Bip Traces
    ${CaptureBIP}              Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    ${CaptureBIP.prefix}       set Variable   ${prefix}
    ${CaptureBIP.withTN}       set Variable   False
    # Capture Init   ${CaptureBIP}
    #define options of gnbMirroring.sh (BIP only)
    ${OPT_GNB_MIRRORING_ABIP}                 Tools.Dictionary Get              ${OPT_GNB_MIRRORING}
    ${OPT_GNB_MIRRORING_ABIP.mirroring_mode}            set Variable         'manual'
    Set Suite Variable              ${OPT_GNB_MIRRORING_ABIP}
    Execute Mirror Script with options      ${SCRIPTDEF_MIRROR_GNB_FS_ABIP}    ${OPT_GNB_MIRRORING_ABIP}
    Capture start  ${CaptureBIP}
    Traced Sleep   ${time}     msg=take BIP L1L2 traces with DL/UL Tput
    Capture stop   ${CaptureBIP}
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureBIP.path}
    ${status}  ${path}   Run Keyword And Ignore Error    OperatingSystem.Move File    ${CaptureBIP.path}    ${testCaseDir}
    [Return]    ${path}

Get Cell Number
    [Arguments]    ${gnb_index}=0
    # NRCELL_DN_LIST is a global variable provided by AF
    ${status}  ${message}=   Run Keyword And Ignore Error      Variable Should Exist       ${NRCELL_DN_LIST}
    @{defaultList}=   Create List    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    Run Keyword If   "${status}"=="FAIL"     Set Global Variable     ${NRCELL_DN_LIST}   ${defaultList}
    Remove Values from List    ${NRCELL_DN_LIST}    ${None}
    ${cell_number}    Set Variable    ${NRCELL_DN_LIST.__len__()}
    [Return]   ${cell_number}


Verify cell setup with COAM
    [Documentation]     : [PRIVATE]
    ...     Verify Specific Cell status and BTS Cell setup status
    ...
    ...     cell_id:   Id of cell,
    ...     timeout:   Time to wait for positive procedure result
    ...
    [Arguments]     ${oam_alias}    ${cell_id}=0   ${timeout}=30
    ${cells_status}=    coam.get_cells_info    cell_type=nr     timeout=${timeout}    connection=${oam_alias}
    ${bts_status}=     coam.get_bts_statuses    timeout=${timeout}    connection=${oam_alias}
    ${P_internal_cell_dist_id}=  Set Variable   ${cells_status[${cell_id}]['id']['internal']}
    ${cell_status_}=    Set variable  ${cells_status[${cell_id}]['status']}
    ${msg}=   Catenate    ${consTraceColor}Cell ${cell_id}${defColor} [${P_internal_cell_dist_id}]
    Dated log    ${msg}
    ${msg}=   Catenate    operationalState=${cell_status_['operationalState']},
    ...                   proceduralStatus=${cell_status_['proceduralStatus']},
    ...                   administrativeState=${cell_status_['administrativeState']},
    Dated log    ${msg}
    ${msg}=   Catenate    blockingState=${cell_status_['blockingState']}
    Dated log    ${msg}
    Dated log    BTS procedural state is now: ${consTraceColor} ${bts_status['proceduralState']} ${defColor}
    Should be equal    ${cell_status_['operationalState']}         Enabled         ignore_case=true
    Should be equal    ${cell_status_['proceduralStatus']}         configured      ignore_case=true
    Should be equal    ${cell_status_['blockingState']}            Unblocked       ignore_case=true
    # 06-14-2022 : usageState is not present anymore on cell_status !!!
    # Should Contain Any    ${cell_status['usageState']}            Active          ignore_case=true
    Should be equal    ${cell_status_['administrativeState']}      Unlocked        ignore_case=true
    Should be equal    ${bts_status['operationalState']}          Enabled         ignore_case=true
    Should be equal    ${bts_status['proceduralState']}           OnAir     msg=GNB is not on air, Current status is ${bts_status['proceduralState']}
    ...                                                                     ignore_case=true
    Should be equal    ${bts_status['blockingState']}             Unblocked       ignore_case=true
    [Return]  ${P_internal_cell_dist_id}   ${cells_status}

Verify cellId setup with COAM
    [Documentation]     : [PRIVATE]
    ...     Verify Specific Cell status and BTS Cell setup status
    ...
    ...     cell_status:   cell status reported bu cOAM, using get_cells_info
    ...     cell_id:   Id of cell,
    ...     timeout:   Time to wait for positive procedure result
    ...
    [Arguments]    ${oam_alias}    ${cell_status}=None    ${cell_id}=1   ${timeout}=30
    ${P_internal_cell_dist_id}=  Set Variable   ${cell_status['id']['internal']}
    ${cell_status_}=    Set variable  ${cell_status['status']}
    ${bts_status}=     coam.get_bts_statuses    timeout=${timeout}    connection=${oam_alias}
    ${msg}=   Catenate    ${consTraceColor}Cell ${cell_id} ${defColor}[${P_internal_cell_dist_id}]
    Dated log    ${msg}
    ${msg}=   Catenate    operationalState=${cell_status_['operationalState']},
    ...                   proceduralStatus=${cell_status_['proceduralStatus']},
    ...                   administrativeState=${cell_status_['administrativeState']},
    Dated log    ${msg}
    ${msg}=   Catenate    blockingState=${cell_status_['blockingState']}
    Dated log    ${msg}
    Dated log    BTS procedural state is now: ${consTraceColor} ${bts_status['proceduralState']} ${defColor}
    Should be equal    ${cell_status_['operationalState']}         Enabled         ignore_case=true
    Should be equal    ${cell_status_['proceduralStatus']}         configured      ignore_case=true
    Should be equal    ${cell_status_['blockingState']}            Unblocked       ignore_case=true
    # 06-14-2022 : usageState is not present anymore on cell_status !!!
    # Should Contain Any    ${cell_status_['usageState']}            Active          ignore_case=true
    Should be equal    ${cell_status_['administrativeState']}      Unlocked        ignore_case=true
    Should be equal    ${bts_status['operationalState']}          Enabled         ignore_case=true
    Should be equal    ${bts_status['proceduralState']}           OnAir     msg=GNB is not on air, Current status is ${bts_status['proceduralState']}
    ...                                                                     ignore_case=true
    Should be equal    ${bts_status['blockingState']}             Unblocked       ignore_case=true
    [Return]  ${P_internal_cell_dist_id}

Verify that cellId are onair with COAM
    [Documentation]     [PRIVATE]
    [Arguments]      ${oam_alias}   ${globalCellId}=1
    ${output}=    coam.get_cells_info    cell_type=nr     timeout=30    connection=${oam_alias}
    FOR    ${cell}    IN    @{output}
        continue for loop if   '${cell['globalCellId']}' != '${globalCellId}'
        ${_internal_cell_dist_id}=  Verify cellId setup with COAM   oam_alias=${oam_alias}  cell_status=${cell}  cell_id=${globalCellId}
    END

Verify that cells are onair with COAM
    [Documentation]     [PRIVATE]
    [Arguments]      ${oam_alias}   ${num_of_cells}=1
    FOR    ${cell_id}    IN RANGE    ${num_of_cells}
        ${_internal_cell_dist_id}  ${cells_status}=  Verify cell setup with COAM   oam_alias=${oam_alias}   cell_id=${cell_id}
    END
    [return]   ${cells_status}

Wait gNB cells 5g On air
    [Documentation]        [PRIVATE]  Wait gNB cells 5g On air
    [Arguments]     ${num_of_cells}=1
    Return From Keyword If    "${WAIT_5G_CELL_ONAIR}" == "0"
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${cells_status}=   wait until keyword succeeds    5min    20s      Verify that cells are onair with COAM   oam_alias=${GNB_DU.oam.httpAlias}
    ...                                                                                     num_of_cells=${num_of_cells}

    # Dated Log   DBG - cells_status=${cells_status}
    ${dict_cells}=  Create dictionary
    FOR    ${cell_id}    IN RANGE    ${num_of_cells}
        Dated Log New Line  ${consTraceColor}=== cellId ${cell_id} === ${defColor}
        Dated Log           globalCellId=${cells_status[${cell_id}]['globalCellId']}
        Dated Log           configuration=${cells_status[${cell_id}]['id']['configuration']}
        Dated Log           band=${cells_status[${cell_id}]['band']}
        Dated Log           subCellList=${cells_status[${cell_id}]['subCellList']}
        Dated Log           cellName=${cells_status[${cell_id}]['cellName']}
        Dated Log           physicalCellId=${cells_status[${cell_id}]['physicalCellId']}
        Dated Log           technology=${cells_status[${cell_id}]['technology']}
        ${technology}=      set variable    ${cells_status[${cell_id}]['technology']}
        Dated Log           nrCellType=${cells_status[${cell_id}]['nrCellType']}
        Dated Log           cellDepType=${cells_status[${cell_id}]['cellDepType']}
        Dated Log           downlinkMimoMode=${cells_status[${cell_id}]['downlinkMimoMode']}
        Run Keyword if     '${technology}' == 'TDD'      Run Keywords    Dated Log     chBw=${cells_status[${cell_id}]['chBw']}    AND
        ...                                                              Dated Log     nrarfcn=${cells_status[${cell_id}]['nrarfcn']}
        ...   ELSE                                       Run Keywords    Dated Log     chBwUl=${cells_status[${cell_id}]['chBwUl']}    AND
        ...                                                              Dated Log     chBwDl=${cells_status[${cell_id}]['chBwDl']}    AND
        ...                                                              Dated Log     nrarfcnUl=${cells_status[${cell_id}]['nrarfcnUl']}  AND
        ...                                                              Dated Log     nrarfcnDl=${cells_status[${cell_id}]['nrarfcnDl']}

        ${val}  Create list  ${cells_status[${cell_id}]['globalCellId']}   ${cells_status[${cell_id}]['physicalCellId']}
        ...                  ${cells_status[${cell_id}]['nrCellType']}     ${cells_status[${cell_id}]['downlinkMimoMode']}
        ...                  ${cells_status[${cell_id}]['technology']}
        Set To Dictionary    ${dict_cells}    CellId-${cells_status[${cell_id}]['globalCellId']}=${val}
    END
    set suite variable   ${dict_cells}
    Dated log   dict_cells=${dict_cells}
    [Teardown]         OAM Disconnect                  ${GNB_DU.oam}

Wait gNB cell 5g On air
    [Documentation]        [PRIVATE]  Wait gNB cell 5g On air
    [Arguments]     ${globalCellId}=1
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    wait until keyword succeeds    5min    20s      Verify that cellId are onair with COAM   oam_alias=${GNB_DU.oam.httpAlias}
    ...                                                                                      globalCellId=${globalCellId}
    [Teardown]         OAM Disconnect                  ${GNB_DU.oam}

