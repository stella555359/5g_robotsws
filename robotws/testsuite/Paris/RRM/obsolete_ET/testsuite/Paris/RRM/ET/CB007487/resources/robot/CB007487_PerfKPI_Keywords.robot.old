CB007487_Testline_settings
    [Documentation]
    ...                 This KW will help to set 5gnb swconfig file for mcs purpose
    ...                 and call Set_XL_mod to set UL_mod / DL_mod in the scf
    [Arguments]         ${BM_id}=${BM_CB007487_D1}

    #** 5gnb swconfig update
    Dated Log  Settings value ${BM_id}

    #exemple in swconfig
    # 0x58000E=0x1fffffff     #rdSupportedDl64QamMcs
    # 0x58000F=0x1fffffff     #rdSupportedDl256QamMcs
    # 0x580010=0x1fffffff     #rdSupportedUlMCS

    FOR    ${i}    IN RANGE    3    #switch case simulation   for 0 1 2 3 (4 steps)

        Dated Log  DBG BM_id.DL_MCS: ${BM_id.DL_MCS}

        ${mcsVal}    Set Variable if    "${BM_id.DL_MCS}" == "0"        0x01    not0
        Dated Log  DBG mcsval r1: ${mcsVal}
        Exit For Loop If    "${mcsVal}"!="not0"
        ${mcsVal}    Set Variable if    "${BM_id.DL_MCS}" == "3"        0x0F    not3
        Dated Log  DBG mcsval r2: ${mcsVal}
        Exit For Loop If    "${mcsVal}"!="not3"
        ${mcsVal}    Set Variable if    "${BM_id.DL_MCS}" == "5"        0x3F    not5
        Dated Log  DBG mcsval r3: ${mcsVal}
        Exit For Loop If    "${mcsVal}"!="not5"
        ${mcsVal}    Set Variable if    "${BM_id.DL_MCS}" == "Max"      0x1FFFFFFF    notMax
        Dated Log  DBG mcsval r4: ${mcsVal}
        Exit For Loop If    "${mcsVal}"!="notMax"
        Dated Log  Adding ${mcsVal}  NOT FOUND

    END
    Dated Log  mcsval: ${mcsVal}
    #0x58000F rdSupportedDl256QamMcs
    #0x58000E rdSupportedDl64QamMcs
    ${TargetToSetforDL}   Set Variable if      "${BM_id.DL_Mod}" == "256QAM"    0x58000F    0x58000E
    Dated Log  DBG : TargetToSetforDL ${TargetToSetforDL}
    &{Dico1}           Create Dictionary     field=${TargetToSetforDL}    value=${mcsVal}
    &{Dico2}           Create Dictionary     field=0x580010               value=${mcsVal}
    @{Dicolist}        Create List    ${Dico1}    ${Dico2}
    Dated Log  Adding ${Dicolist} in 5gnb-swconfig.txt (+crasign)
    Set Fields in swconfig DU    ${Dicolist}    ${GNB_DU.entryCard[0]}

    #** SCF update
    ${value}    set variable if    '${BM_id.DL_Mod}' == '256QAM'    ${TRUE}    ${FALSE}
    Set_xL_mod    actDl256Qam    ${value}    ${BM_id.CELL}

Set_XL_mod
    [Documentation]
    ...              This KW will help to set actDl256Qam on line
    ...              OAM request is done 1 time with a dictionnary created in a loop
    [Arguments]    ${arg}    ${value}    ${cell}
    Dated Log      "${arg} set ${value}"
    @{modiflist}    Create List
           ${dn}             set variable           MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${cell}
           &{modify_param}   Create Dictionary
                             ...                    parameter=${arg}
                             ...                    dist_name=${dn}
                             ...                    value=${value}

           Dated log                                ${modify_param}
           Append To List     ${modiflist}          ${modify_param}
           Dated log    \n
    OAM Set Params            ${modiflist}            # OAM need a list ....
    Dated Log  on ${modify_param.dist_name}, ${arg} have been modified with value: ${value}

Get actBeamforming from SCF
    [Arguments]          ${nodeType}=Classical  ${CellId}=1
    # Get SCF File (SCF.xml) in test setup
    ${current_scf_fullname}    set Variable      ${test_scf_file}
    scf.load_scf	 ${current_scf_fullname}
    # MRBTS-1/NRBTS-1/NRCELL-1
    ${actBeamforming}	 scf.get_value_from_scf   p_name=actBeamforming
    ...              dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${CellId}
    ...              nodeType=${nodeType}
    [return]     ${actBeamforming}

Get actDl256Qam from SCF
    [Arguments]          ${nodeType}=Classical  ${CellId}=1
    # Get SCF File (SCF.xml) in test setup
    ${current_scf_fullname}    set Variable      ${test_scf_file}
    scf.load_scf	 ${current_scf_fullname}
    # MRBTS-1/NRBTS-1/NRCELL-1
    ${actDl256Qam}	 scf.get_value_from_scf   p_name=actDl256Qam
    ...              dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${CellId}
    ...              nodeType=${nodeType}
    [return]     ${actDl256Qam}

Get Cipher Parameters From gNB
