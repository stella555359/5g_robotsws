*** Test Cases ***

[1]CB007103-VR-TC01_R15ToR16_Pusch_PucchF3QPSK_NotPUCCHR16AlwsOn
    # [Tags]                      CLOUD_5GC_dRNIC_1vDU_P_AP_LO_SWFH, VARIANT_SANSA_FS_ECPRI_CMWV_TDD

    #Special Need for this test

    Set Suite Variable    ${userneed_PCAP}       ${True}
    Set Suite Variable    ${userneed_Btslog}     ${True}
    Set Suite Variable    ${userneed_PM}         ${True}
    Set Suite Variable    ${DodIsSet}            ${True}

    CB007103_mainKW       ${vRAN_C1_TC01}

*** Keywords ***

CB007103_mainKW
    [Documentation]        CB007103-Base-
    [Arguments]            ${param}

    kwmkt_dbg_log          Global variable list DBGlogs: ${DBGlogs}          ##
    kwmkt_dbg_log          info we are on KeepConfig: ${KeepConfig}           # these informative line to bypass Robot 5 new sanity :-)
    kwmkt_dbg_log          info we are on NoSnap: ${NoSnap}                   #
    kwmkt_dbg_log          info we are on egatelogoutput: ${egatelogoutput}   #
    kwmkt_dbg_log          info we are on EnSher: ${EnSher}                   #
    kwmkt_dbg_log          info we are on tti: ${tti}                         #
    kwmkt_dbg_log          info we are on DodIsSet: ${DodIsSet}               #
    kwmkt_dbg_log          recursion_limit: ${recursion_limit}               ##


    Init Sequence          ${param}
    Step                   kwmkt_Create_Test_Suite_Folder

    Critical Step          Set_basic_context_VRAN
    Critical Step          Update gNB Swconfig Vran

    #Critical Step                   Set_SCF_ConfigMarket    ${param.Scfdetails}     (Replaced by below lines)
#RDH-ticket72: call to new sweng services
    OAM Send DU delta commissioning      input_filepath=${CURDIR}/resources/config/scf/scf_UlDftsOfdm_activ_Cell1_Cell2_vDU.json
    OAM Send DU delta commissioning      input_filepath=${CURDIR}/resources/config/scf/scf_ULCL_powerCtrl_Cell1_Cell2_fresh_vDU.json

    Critical Step          Set_SCF_ofTheTest       ${param.Feat7103niddSpecific}
    Critical Step          kwmkt_Cell_setup        ${CellList}

    #L3call
    Run Keyword If         ${userneed_PCAP}         kwmkt_Capture_Start    Attach

#RDH-ticket72: depending the VRAN variant, the .sce file should be adapted
    ${Sce_FilePath}        Set Variable If         'CLOUD_5GC_dRNIC_1vDU_P_AP_LO_DC' in '${TLConfig.topo}'
    ...                                             BC_2UEs_VRAN

    Critical Step          kwmkt_run_script_once   ${CURDIR}/resources/egCmd/${Sce_FilePath}/egCmd_B-C_VRAN_attach_PuschSinr_cellnoise_2UEs.sce

    Traced Sleep           5 minutes                  msg=5 mn sleep to let the feature stabilize
    #TTI for switching from TP OFF to TP ON
    Run Keyword If         ${tti}                  kwmkt_TTI_start_Multi    time=${param.GetTtiTraceTime}

    Run Keyword If         ${tti}                  kwmkt_TTI_stop     suffix=TTI_VRAN_TP_OFF_ON_TM_2UEs
    ...                                                               targpath=${logsDir}/tti
    ...                                                               nm_convert=${True}

    ${PMdod} =	           Run Keyword And Return Status    kwmkt_PM_general
    Dated log              ** PM Dod Status** ${PMdod}
    Append to List         ${DODlist}    ${PMdod}

    #TTI After PHR and Powerboost activation through eGATE commands
    Run Keyword If         ${tti}          kwmkt_TTI_start_Multi    time=${param.GetTtiTraceTime}

    Critical Step          kwmkt_run_script_once    ${CURDIR}/resources/egCmd/${Sce_FilePath}/egCmd_B-C_VRAN_PHR_TM_2UEs.sce
    # Sleep    2s
    Run Keyword If         ${tti}          kwmkt_TTI_stop     suffix=TTI_VRAN_PHR_TM_2UEs
    ...                                                       targpath=${logsDir}/tti
    ...                                                       nm_convert=${True}

    ${PMdod} =	           Run Keyword And Return Status    kwmkt_PM_general
    Dated log              ** PM Dod Status** ${PMdod}
    Append to List         ${DODlist}    ${PMdod}

    Critical Step          kwmkt_run_script_once    ${CURDIR}/resources/egCmd/${Sce_FilePath}/egCmd_B-C_VRAN_TP_ON_OFF_2UEs.sce

    Run Keyword If         ${userneed_PCAP}         kwmkt_Capture_Stop     Attach

    Dated log              DOD_7103: DodIsSet:${DodIsSet} res:${DODlist}
    Run Keyword If         ${DodIsSet}         kwmkt_Check_For_False_In_${NL}    ${DODlist}


