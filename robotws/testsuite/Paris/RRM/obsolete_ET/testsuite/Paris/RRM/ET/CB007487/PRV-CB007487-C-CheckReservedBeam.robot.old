*** Variables ***
${TestSharkTool}        MC_SHARK
${TTIjson}              ttitrace_streaming.json
${BeamID}               5
${BeamUsageTarget}      0.95
${Test Line}           Run Keyword And Ignore Error    OperatingSystem.run      echo \$HOSTNAME|sed 's/-/_/g'
${MRBTS_ID}            1
${NRBTS_ID}            1
${CellId}              1
${test_scf_file}       /home/ute/Downloads/Configuration_scf.xml
${parameterName}       actBeamforming


*** Test Cases ***
Check_Reserved_Beam_in_TTI
    # ${isBeamUsageAboveTarget}           isBeamUsageAboveTarget         jsonPathName=${TTIjson}     
    # ...                                 beamToCheck=${BeamID}    BeamUsageTarget=${BeamUsageTarget}
    # Dated log         BeamID = ${BeamID}
    # Dated log         isBeamUsageAboveTarget = ${isBeamUsageAboveTarget}
    # Dated log         Test Line = ${Test Line}
    # Should Be True    ${isBeamUsageAboveTarget}
    
    Get Parameter from SCF    ${nodeType}=Classical
    ...                       ${dist_name}=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${CellId}
    ...                       ${parameterName}=${parameterName}

*** Keywords ***

Get Parameter from SCF
    [Arguments]          ${nodeType}=Classical  ${dist_name}=noDefault
    ...                  ${parameterName}=noDefault

    # Get SCF File (SCF.xml) in test setup
    scf.load_scf	 ${test_scf_file}
    # MRBTS-1/NRBTS-1/NRCELL-1
    ${parameterValue}	 scf.get_value_from_scf   p_name=${parameterName}
    ...              dist_name=${dist_name}
    ...              nodeType=${nodeType}
    [return]     ${parameterValue}


Get Cipher Parameters From gNB
    ${cipher_params_list}    Create List    nea0    nea1_128    nea2_128    nea3_128
    # Get SCF File (SCF.xml) is performed in test setup
    ${scf_path}    set Variable      ${test_scf_file}
    ${cipher_dict}    nps_7487_tools.get_feature_paramters_from_scf    ${scf_path}    ${cipher_params_list}
    ...    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}    cipherPrefL
    [Return]    ${cipher_dict}


Get actBeamforming from SCF
    [Arguments]          ${nodeType}=Classical  ${CellId}=1
    # Get SCF File (SCF.xml) in test setup
    ${current_scf_fullname}    set Variable      ${test_scf_file}
    scf.load_scf	 ${current_scf_fullname}
    # MRBTS-1/NRBTS-1/NRCELL-1
    ${actBeamforming}	 scf.get_value_from_scf   p_name=actBeamforming
    ...              dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${CellId}
    ...              nodeType=${nodeType}
    [return]     ${actBeamforming}
