*** Variables ***

${gnb_alias}                        gnb_under_test

# RU configuration used to updated IPHY.xml file.
# As there may be several RU withint the same time
# and also several GSCN for the same RU (radio splitted), the simplest solution is to hardcode items
# indexes to update inside IPHY.xml file.
# So, indexes below (e.g.: resourceBuildKey_idx, productCode_idx,...) stands for the indexes
# of the items inside the IPHY.xml file.
# For GSCN, in case there is only one, putting GSCN2=0 will skip second GSCN update.
&{AEHC_config}                      cardName=AEHC
...                                 cardName_idx=1
...                                 resourceBuildKey=LTX_AEHC
...                                 resourceBuildKey_idx=1
...                                 GSCN1=6486
...                                 GSCN1_idx=1
...                                 GSCN2=0
...                                 GSCN2_idx=0
...                                 productCode=475124A
...                                 productCode_idx=1

&{AZHL_config}                      cardName=AZHL
...                                 cardName_idx=1
...                                 resourceBuildKey=LTX_AZHL_E1
...                                 resourceBuildKey_idx=1
...                                 GSCN1=6486
...                                 GSCN1_idx=1
...                                 GSCN2=0
...                                 GSCN2_idx=0
...                                 productCode=475432A
...                                 productCode_idx=1

&{AEHC_config_CA}                   cardName=AEHC
...                                 cardName_idx=4
...                                 resourceBuildKey=LTX_AEHC
...                                 resourceBuildKey_idx=4
...                                 GSCN1=6486
...                                 GSCN1_idx=5
...                                 GSCN2=6624
...                                 GSCN2_idx=6
...                                 productCode=475124A
...                                 productCode_idx=1

&{AEHC_Cell1_D}                     cardName=AEHC
...                                 cardName_idx=1
...                                 resourceBuildKey=LTX_AEHC
...                                 resourceBuildKey_idx=1
...                                 GSCN1=6483
...                                 GSCN1_idx=1
...                                 GSCN2=0
...                                 GSCN2_idx=0
...                                 productCode=475124A
...                                 productCode_idx=1

&{AEHC_Cell2_D}                     cardName=AEHC
...                                 cardName_idx=2
...                                 resourceBuildKey=LTX_AEHC
...                                 resourceBuildKey_idx=2
...                                 GSCN1=6477
...                                 GSCN1_idx=2
...                                 GSCN2=0
...                                 GSCN2_idx=0
...                                 productCode=475124A
...                                 productCode_idx=2

###########

&{RU_list}                          AEHC=${AEHC_config}
...                                 AZHL=${AZHL_config}
...                                 AEHC_CA=${AEHC_config_CA}
...                                 AEHC_Cell1_D=${AEHC_Cell1_D}
...                                 AEHC_Cell2_D=${AEHC_Cell2_D}

