*** Keywords ***

CB009355_Update_SCF
    [Documentation]               Dedicated KW to apply a delta commissioning file.
    ...                           It performs delta commissioning and waits until gNB is up again
    ...                           (in case of RAT reset is needed for example)
    [Arguments]                   ${delta_file}

    # In some cases (CRT), gNB seems not to be ready as the error "Configuration data validation
    # is rejected because CPlane is busy" is raised during commissioing. I don't really know why.
    # So, I have checked gNB is ready before starting commissionning...
    OAM wait available

    # Open connection towards cOAM
    sbts_coam.connect_to          name=${gnb_alias}

    # Apply delta scf
    coam_parameter.perform_scf_delta_commission
    ...                           delta_file=${delta_file}
    ...                           connection=${gnb_alias}
    ...                           timeout=300
    ...                           skip_parameter_relation_errors=True

    OAM wait available

    sbts_coam.teardown            connection=${gnb_alias}

CB009355_Update_iPHY_RU_model
    [Documentation]                 Dedicated KW to update a RU model (HW type, SW version,...).
    ...                             It updates the RU index provided as input parameters with the values
    ...                             retrieved from gNB TargetBD file.
    ...                             ${RU_config_name} = Target RU configuration (e.g.: AEHC)
    ...                             ${RU_idx} = RU index to be updated inside AP iphy.xml file
    ...                             e.g.: CB009355_Update_iPHY_RU_model   AEHC  1
    ...                             => Updates first RU inside iphy.xml with AEHC model

    [Arguments]                     ${RU_name}

    ${ru_config}                    Get From Dictionary     ${RU_list}               ${RU_name}

    GnbXmlTools.Get Data From Gnb TargetBD File             card_name=${ru_config}[resourceBuildKey]

    # Update IPHY GSCN to new value
    WtsXmlConfig.startSession               file=iphy
    WtsXmlConfig.setTextUsingIndex          path=//cardName
    ...                                     val=${ru_config}[cardName]
    ...                                     idx=${ru_config}[cardName_idx]

    WtsXmlConfig.setTextUsingIndex          path=//resourceBuildKey
    ...                                     val=${ru_config}[resourceBuildKey]
    ...                                     idx=${ru_config}[resourceBuildKey_idx]

    WtsXmlConfig.setTextUsingIndex          path=//productCode          val=${ru_config}[productCode]
    ...                                     idx=${ru_config}[productCode_idx]

    WtsXmlConfig.setTextUsingIndex          path=//GSCN                 val=${ru_config}[GSCN1]
    ...                                     idx=${ru_config}[GSCN1_idx]

    Run Keyword If                          ${ru_config}[GSCN2] != 0
    ...                                     WtsXmlConfig.setTextUsingIndex
    ...                                     path=//GSCN
    ...                                     val=${ru_config}[GSCN2]              idx=${ru_config}[GSCN2_idx]

    # update iphy.xml with swVersion and swFileKey values taken from GNB TargetBD_*.xml
    # active and passive parts
    ${first_sw_versions_idx}                Evaluate                ${ru_config}[resourceBuildKey_idx]*2 - 1
    ${second_sw_versions_idx}               Evaluate                ${ru_config}[resourceBuildKey_idx]*2

    WtsXmlConfig.setTextUsingIndex          //version               ${g_resource_swVersion}    idx=${first_sw_versions_idx}
    WtsXmlConfig.setTextUsingIndex          //version               ${g_resource_swVersion}    idx=${second_sw_versions_idx}

    # active and passive parts
    WtsXmlConfig.setTextUsingIndex          ////name                ${g_resource_swFileKey}    idx=${first_sw_versions_idx}
    WtsXmlConfig.setTextUsingIndex          ////name                ${g_resource_swFileKey}    idx=${second_sw_versions_idx}

# Sep-2024: buildversion is now obsolete for all topologies: this code is no more needed
#    # In case of ASOH board, iphy.xml no more contains buildversion tag. Only bldVersion is available.
#    # So, check number of items available before changing it to avoid an error.
#    ${num_buildversion_items}               countElt                //buildversion
#    Run Keyword If                          ${num_buildversion_items} != 0
#    ...                                     WtsXmlConfig.setTextUsingIndex
#    ...                                     //buildversion          ${g_resource_swVersion}
#    ...                                     idx=${ru_config}[resourceBuildKey_idx]

    WtsXmlConfig.setTextUsingIndex          //bldVersion            ${g_resource_swVersion}    idx=${ru_config}[resourceBuildKey_idx]

    WtsXmlConfig.stopSession                file=iphy

CB009355_Update_Wts_config_file
    [Documentation]                 Dedicated KW to update cfg file for 15 MHz BW
    ...                             It updates cfg file according to a list of predefined models
    ...                             put into a dictionary and including GSCN, ARFCN, UE capabilities
    ...                             e.g.: CB009355_Update_Wts_config_file   WTS_CFG_MODEL1  1
    ...                             => Updates WTS config file for cell 1 with parameters inside WTS_CFG_MODEL1

    [Arguments]                     ${cfg_config_model}     ${cell_index}

    # Retrieve values to be updated
    ${cfg_model}                    Get From Dictionary     ${Cfg_config_models}    ${cfg_config_model}

    WtsCfgConfig.startSession

    #Cells string for search and replace inside basic.cfg file
    ${cell_prefix}                      set variable    set_cell id=${cell_index} gnb

    ${oldValue}                         getParam           prefix=${cell_prefix}          param=nr_arfcn
    Log To console                      OldValue is: ${oldValue}
    WtsCfgConfig.replaceValue           prefix=${cell_prefix}
    ...                                 param=nr_arfcn
    ...                                 oldValue=${oldValue}
    ...                                 newValue=${cfg_model}[arfcn]:${cfg_model}[arfcn]
    ...                                 occurrence=1
    ...                                 ignore_comments=False

    ${oldValue}                         getParam           prefix=${cell_prefix}          param=gscn
    WtsCfgConfig.replaceValue           prefix=${cell_prefix}
    ...                                 param=gscn
    ...                                 oldValue=${oldValue}
    ...                                 newValue=${cfg_model}[gscn]
    ...                                 occurrence=1
    ...                                 ignore_comments=False

    # In case of -D IWK.10 test case and ASOE, we need to attach 2 UEs on cell1 and
    # 2 UEs on cell2. However, the basdic.cfg file is provisionned with 1 UE on cell1,
    # 1 UE on cell2, 1 UE on cell3,... So, a dedicated cfg file update is done below to suit
    # those needs. It's a little bit harcoded and dedicated to this TCs but simpler like this...
    Run Keyword If                      "${cfg_model}[UE_Cell_change]" == "update_UEs_cell1"    Run Keywords
    ...                                 WtsCfgConfig.replaceValue
    ...                                 prefix=set_ue simulated id=1
    ...                                 param=cell
    ...                                 oldValue=1
    ...                                 newValue=1
    ...                                 AND
    ...                                 WtsCfgConfig.replaceValue
    ...                                 prefix=set_ue simulated id=2
    ...                                 param=cell
    ...                                 oldValue=2
    ...                                 newValue=1

    Run Keyword If                      "${cfg_model}[UE_Cell_change]" == "update_UEs_cell2"    Run Keywords
    ...                                 WtsCfgConfig.replaceValue
    ...                                 prefix=set_ue simulated id=3
    ...                                 param=cell
    ...                                 oldValue=3
    ...                                 newValue=2
    ...                                 AND
    ...                                 WtsCfgConfig.replaceValue
    ...                                 prefix=set_ue simulated id=4
    ...                                 param=cell
    ...                                 oldValue=4
    ...                                 newValue=2

    WtsCfgConfig.stopSession            rename=modified

    Run Keyword If                      "${cfg_model}[SA_UE_CAPABILITIES_TDD]" != "no_change"
    ...                                 Modify Field in WtsEmu Cfg File
    ...                                 field=SA_UE_CAPABILITIES_TDD    value=${cfg_model}[SA_UE_CAPABILITIES_TDD]

    Run Keyword If                      "${cfg_model}[SA_Capa_Full]" != "no_change"
    ...                                 Modify Field in WtsEmu Cfg File
    ...                                 field=SA_Capa_Full    value=${cfg_model}[SA_Capa_Full]

    Run Keyword If                      "${cfg_model}[Legacy_UE_Capa]" != "no_change"
    ...                                 Modify Field in WtsEmu Cfg File
    ...                                 field=ue_nr_capabilities    value=${cfg_model}[Legacy_UE_Capa]
