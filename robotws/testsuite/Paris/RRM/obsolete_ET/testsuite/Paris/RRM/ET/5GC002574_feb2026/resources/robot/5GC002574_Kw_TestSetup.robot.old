&{T1}                 feature2574=${true}      totalUE=1    loop=1      bandwidth=10MHz    technology=FDD    ul_throughput=30    dl_throughput=90
...                   timeDuration=3s    stopTraffic=${False}  shouldBeCheck=${False}     dirTraffic=ul    CellLTEId=1   CellNRId=2
...                   ULNbrOfPrb=35
