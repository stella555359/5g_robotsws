Verification of Throughput on Cell within Sherpa Dl Stat Report
    [Documentation]
    ...     Conditions:     it is based on the argument ${throughput_req}
    ...     Actions:        it verifies that the downlink throughput on each cell is upper than the requested value exprimed in kb/s
    ...     Checks:         it checks the downlink throughput on each cell within Statistics Report of Sherpa
    ...     Verdict:        downlink throughput is passed but check is disabled because macro__dlStat.csv contains empty line
    [Arguments]             ${throughput_req}

    ${file_path_report}                         Set Variable    macro__dlStat.csv
    # throughput_req
    Dated Log New Line                          ===> check if ${COL_NAME_TPKBS} ${check_operator} ${throughput_req} within ${file_path_report}
    ${verif_result}                             Verify value with operator in csv Files with Prerequisite    CsvName=${file_path_report}
    ...                                                             ColumnName=${COL_NAME_TPKBS}
    ...                                                             valuetocheck=${throughput_req}
    ...                                                             check_operator=<
    ...                                                             directory=${sherpa_output_path}
    ...                                                             colum_prereq=${COL_NAME_BEAMID}
    ...                                                             regex_prereq=ALL
    Run Keyword If    ${verif_result} == True
    ...                 Dated Log               ===> downlink throughput on each cell is upper than the requested value=${throughput_req} kbs
    ...         ELSE    Dated Log               ===> downlink throughput on cell IS LOWER THAN the requested value=${throughput_req} kbs
    #vbo#observation#check is disabled because macro__dlStat.csv contains empty line#Should Be True    ${verif_result} == True
# --------------------------------------------------------------------------------------------------------------------------------------------------
# Counter #
Set Min And Max Values For Counter
    [Documentation]
    ...     Conditions:     it is based on the arguments ${counter_elem} ${counter_value}
    ...     Actions:        it changes the min and the max values of the counter
    ...     Checks:         it checks the initial configured value of a counter before the changing
    ...     Verdict:        the counters values are changed when it is requested
    [Arguments]             ${counter_elem}
    ...                     ${counter_value}

    ${counter_value}                            Convert To String    ${counter_value}
    Run Keyword If    '${counter_elem.min}' == 'auto'    Set To Dictionary    ${counter_elem}    min=${counter_value}
    Run Keyword If    '${counter_elem.max}' == 'auto'    Set To Dictionary    ${counter_elem}    max=${counter_value}


Compute All Counters Values For Checking
    [Documentation]
    ...     Conditions:     it is based on the arguments ${param} ${dict_ues} ${dict_counters}
    ...     Actions:        it computes all the counters values for checking depending on the configuration
    ...     Checks:         it checks the initial configured value of a counter before the changing
    ...     Verdict:        the counters values are changed when it is requested
    [Arguments]             ${param}
    ...                     ${dict_ues}
    ...                     ${dict_counters}

    # Adding dynamically the counters for the cells into the list
    FOR    ${current_id}    IN RANGE    0    ${param.total_nb_cell}
        ${current_cell}=                        Evaluate    ${current_id} + 1
        ${current_cell}                         Convert To String    ${current_cell}
        #M55308C17002
        ${current_counter}=                     Copy Dictionary    ${dict_settings_M55308C17002}
        Set To Dictionary                       ${current_counter}    obj_id    ${current_cell}
        Append To List                          ${dict_counters}    ${current_counter}
        #M55308C10003
        ${current_counter}=                     Copy Dictionary    ${dict_settings_M55308C10003}
        Set To Dictionary                       ${current_counter}    obj_id    ${current_cell}
        Append To List                          ${dict_counters}    ${current_counter}
        #M55308C10005
        ${current_counter}=                     Copy Dictionary    ${dict_settings_M55308C10005}
        Set To Dictionary                       ${current_counter}    obj_id    ${current_cell}
        Append To List                          ${dict_counters}    ${current_counter}
        #M55308C10007
        ${current_counter}=                     Copy Dictionary    ${dict_settings_M55308C10007}
        Set To Dictionary                       ${current_counter}    obj_id    ${current_cell}
        Append To List                          ${dict_counters}    ${current_counter}
        #M55338C01000
        ${current_counter}=                     Copy Dictionary    ${dict_settings_M55338C01000}
        Set To Dictionary                       ${current_counter}    obj_id    ${current_cell}
        Append To List                          ${dict_counters}    ${current_counter}
        #M55338C01001
        ${current_counter}=                     Copy Dictionary    ${dict_settings_M55338C01001}
        Set To Dictionary                       ${current_counter}    obj_id    ${current_cell}
        Append To List                          ${dict_counters}    ${current_counter}
        #M55359C00000
        ${current_counter}=                     Copy Dictionary    ${dict_settings_M55359C00000}
        Set To Dictionary                       ${current_counter}    obj_id    ${current_cell}
        Append To List                          ${dict_counters}    ${current_counter}
        #M55359C00001
        ${current_counter}=                     Copy Dictionary    ${dict_settings_M55359C00001}
        Set To Dictionary                       ${current_counter}    obj_id    ${current_cell}
        Append To List                          ${dict_counters}    ${current_counter}
    END
    ${nb_ue_traffic_gbr}=                       Get Number Of Ue Configured With GBR Traffic    dict_ues=${dict_ues}
    # Computing dynamically the counters value
    FOR    ${current_counter}    IN      @{dict_counters}
        Run Keyword If    '${current_counter.counter}' == 'M55140C00001' or '${current_counter.counter}' == 'M55140C00002'
        ...                                     Set Min And Max Values For Counter    ${current_counter}    ${param.total_nb_ue}
        Run Keyword If    '${current_counter.counter}' == 'M55140C00501'
        ...                                     Set Min And Max Values For Counter    ${current_counter}    ${nb_ue_traffic_gbr}
        Run Keyword If    '${current_counter.obj}' == 'NRBTS' and '${current_counter.obj_id}' == 'auto'
        ...                                     Set To Dictionary    ${current_counter}    obj_id=${TNRBTS_ID[0]}
    END


Retrieve Counter List of Values From Pm Files For Object With Name
    [Documentation]         INTERNAL USAGE
    [Arguments]             ${pm_path}
    ...                     ${object_name}
    ...                     ${counter_name}
    ...                     ${object_id}=1

    Debug Dated Log                             xxx_pm_path:${pm_path}
    Debug Dated Log                             xxx_object_id:${object_id}
    Set Suite Variable                          ${curPmDir}    ${pm_path}/${pmCollectSubDir}
    ${sumCal}=                                  Evaluate    0
    Debug Dated Log                             curPmDir:${curPmDir}
    @{filesList}                                List Directory    ${curPmDir}    *.xml
    ${counter_values}    Extract Counter Different Values From PM Files in dir    ${curPmDir}    ${object_name}    ${counter_name}
    ...                                         ${object_id}
    Debug Dated Log                             counter_values= ${counter_values}
    [Return]    ${counter_values}


Verify Object Counter with ID List Of Values In A Range
    [Documentation]
    ...     Conditions:     it is based on the argument ${vendor_param}
    ...     Actions:        Retrieve all values of a counter defined with object id in all PM xml files and compare them with a range Min and Max
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${pm_path}
    ...                     ${pm_obj_id}
    ...                     &{expected_dict}

    Debug Dated Log                             pm_path= ${pm_path}
    Debug Dated Log                             pm_obj_id= ${pm_obj_id}
    ${objectName}=                              Set Variable    &{expected_dict}[obj]
    ${counterName}=                             Set Variable    &{expected_dict}[counter]
    ${iMin}=                                    Evaluate    &{expected_dict}[min]
    ${iMax}=                                    Evaluate    &{expected_dict}[max]
    ${pm_iteration}                             Evaluate    &{expected_dict}[iteration]
    ${valRetrieved}    Retrieve Counter List of Values From Pm Files For Object With Name    ${pm_path}      ${objectName}    ${counterName}
    ...                                         ${pm_obj_id}
    Debug Dated Log                             valRetrieved= ${valRetrieved} iMin= ${iMin} iMax= ${iMax}
    # Compare ivalue with Min Max     ${valRetrieved}    ${iMin}   ${iMax}
    ${nb_val_found}=                            Set Variable    0
    ${nb_val_elem}=                             get length    ${valRetrieved}
    FOR    ${val_elem}    IN    @{valRetrieved}
        ${result}=                              Run Keyword And Return Status    Compare ivalue with Min Max    ${val_elem}    ${iMin}    ${iMax}
        ${nb_val_found}=    Run Keyword If    ${result} == ${True}    Evaluate    ${nb_val_found} + 1
        ...                             ELSE    Evaluate    ${nb_val_found} + 0
        Debug Dated Log     result= ${result} for the comparison of val_elem= ${val_elem} with iMin= ${iMin} iMax= ${iMax}
    END
    # result is always considered as true when pm_iteration is 0 <=> the comparison is deactivated for this counter
    # result is considered as true when the number of correct found values is upper or equal to the requested one
    # result is considered as true when the pm_iteration is negative only if all the values are correct
    # result is considered as false for the other cases
    ${result}=    Run Keyword If    ${pm_iteration} == 0    Set Variable    ${True}
    ...                       ELSE IF    ${pm_iteration} > 0 and ${nb_val_found} >= ${pm_iteration}    Set Variable    ${True}
    ...                       ELSE IF    ${pm_iteration} < 0 and ${nb_val_found} == ${nb_val_elem}    Set Variable    ${True}
    ...                       ELSE              Set Variable    ${False}
    [Return]    ${result}


Check All Counters From Dict
    [Documentation]
    ...     Conditions:     it is based on the arguments ${path_pm} ${dict_counters}
    ...     Actions:        it checks all the counters values from the dictionary
    ...     Checks:         it checks for all the counters that the value is in the range
    ...     Verdict:        the values are verified
    [Arguments]             ${path_pm}
    ...                     ${dict_counters}

    Dated Log New Line                          ===> counters list is ${dict_counters}
    FOR    ${current_counter}    IN      @{dict_counters}
        Dated Log                               ===> current counter for checking is ${current_counter}
        ${status_counter}                       Verify Object Counter with ID List Of Values In A Range    ${path_pm}    ${current_counter.obj_id}
        ...                                                         &{current_counter}
        Should Be True    '${status_counter}' == 'True'
    END


Sleep Until PM Availability
    [Arguments]             ${pm_granularity_period}=300
    ...                     ${pm_availability_delay}=60

    Dated Log                                   ===> sleep until PM availability is started
    ${time_of_start}                            Evaluate    int(time.time())    time
    ${time_of_next_pm_period}                   Evaluate    (int(${time_of_start} / ${pm_granularity_period}) + 1) * ${pm_granularity_period}
    ${time_of_pm_availability}                  Evaluate    ${time_of_next_pm_period} + ${pm_availability_delay}
    ${duration_until_pm_availability}           Evaluate    ${time_of_pm_availability} - ${time_of_start}
    ${timeout_string}                           Catenate    ${duration_until_pm_availability}  sec
    ${date_of_pm_availability}                  Convert date    ${time_of_pm_availability}
    Dated Log                                   ===> PM should be available in ${timeout_string}, at ${date_of_pm_availability}
    Sleep                                       ${timeout_string}
    Dated Log                                   ===> sleep until PM availability is ended


Check Counter And KPI Constraints
    [Arguments]             ${pm_path}
    ...                     ${test_name}
    ...                     ${localKpiFileName}=${None}
    Dated Log                                   ===> check counter and KPI constraints is started
    ${localKpiFile}=    Run Keyword If    '${localKpiFileName}' == '${None}'    Set Variable   ${None}
    ...                             ELSE        Set Variable   ${CURDIR}/../../config/counter/KPI/${localKpiFileName}
    KPI Evaluate                                pmFile=${pm_path}
    ...                                         constraintsFile=${CURDIR}/../../config/counter/constraint/${test_name}.csv
    ...                                         failOnError=${True}
    ...                                         localKpiFile=${localKpiFile}
    Dated Log                                   ===> check counter and KPI constraints is ended
# --------------------------------------------------------------------------------------------------------------------------------------------------
# TTI Traces #
Get TTI Logs
    # TTI capture configuration
    ${TTIdir}                                   Get TTI Trace Path    dir_suffix=TTI

    # Start TTI capture
    Dated Log New Line                          ===> start TTI traces capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2
    Traced Sleep                                duration=3s    msg=DL TTI traffic capture 3 seconds

    # Stop TTI capture
    Dated Log New Line                          ===> stop TTI traces capture
    ${TTIpcap}                                  Stop TTI Traces in Streaming mode    tti_trace_path=${TTIdir}    tti_trace_filename=TTI_TC

    Dated Log New Line                          ===> convert TTI trace to json and csv
    ${TTIjson}                                  Convert TTI trace from pcap to others    input_file_path=${TTIpcap}
    ${TTIcsv}                                   decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=10000
    set Suite Variable    ${TTIjson}
    [Return]    ${TTIjson}
# --------------------------------------------------------------------------------------------------------------------------------------------------
