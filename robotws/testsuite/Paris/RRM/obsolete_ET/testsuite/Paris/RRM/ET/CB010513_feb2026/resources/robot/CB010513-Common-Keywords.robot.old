*** Variables ***
${TestSharkTool}                                MC_SHARK
${AUTO_SAVE_DEBUG_DATA}                         ${True}
${CELL_SETUP_ONLY}                              ${False}
${SUITE_DEBUG_MODE}                             ${True}
# column names for sherpa
${COL_NAME_BEAMID}                              BEAM ID
${COL_NAME_GBRPRBREQUEST}                       GbrPrbRequest
${COL_NAME_L1SUBPOOLSTREAMPRBCAPACITY}          l1SubPoolStreamPrbCapacity
${COL_NAME_MODE}                                Mode
${COL_NAME_NOGBRPRBREQUEST}                     noGbrPrbRequest
${COL_NAME_NRCELLID}                            NRCellid
${COL_NAME_NUMALLOCSTREAMPRB}                   NumAllocStreamPrb
${COL_NAME_NUMMAXPRBALLOC}                      NumMaxPrbAlloc
${COL_NAME_NUMMINPRBALLOC}                      NumMinPrbAlloc
${COL_NAME_NUMPRBALLOC}                         PrbAllocated
${COL_NAME_POOLID}                              PoolId
${COL_NAME_SUBPOOLID}                           SubPoolId
${COL_NAME_TPKBS}                               TP(kb/s)
${COL_NAME_ZAB}                                 ZAB Privilege
# ID nrcell
${ID_NRCELL_1}                                  0x4001
${ID_NRCELL_2}                                  0x4002
${ID_NRCELL_3}                                  0x4003
# ID pool and subpool
${ID_POOL}                                      10
${ID_SUBPOOL_1}                                 0
${ID_SUBPOOL_2}                                 1

# maximum number of layer PRB by L1 subpool
${NUM_MAX_LAYER_PRB_L1_SP_DEFAULT}              2184
${NUM_MAX_LAYER_PRB_L1_SP}                      1200
# maximum number of stream PRB by L1 subpool
${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT}             2184
${NUM_MAX_STREAM_PRB_L1_SP}                     1200
# maximum number of wideband stream PRB by L1 subpool
${NUM_MAX_WB_STREAM_PRB_L1_SP_DEFAULT}          1092
${NUM_MAX_WB_STREAM_PRB_L1_SP}                  600
# minimum of PRB that can be allocated to one cell
${NUM_MIN_PRB_DEFAULT}                          48
# maximum of PRB that can be allocated to one cell
${NUM_MAX_PRB_DEFAULT}                          273
# maximum of stream that can be distributed in one subpool when interL1subpool is disabled
${NUM_MAX_STREAM_DEFAULT}                       ${NUM_MAX_STREAM_PRB_L1_SP}
# maximum of stream ... when interL1subpool is disabled and in case of only one cell <=> ${NUM_MAX_PRB_DEFAULT} * 4 = 273 * 4 = 1092
${NUM_MAX_STREAM_WHEN_ONLY_1_CELL}              1092
# maximum of PRB that can be allocated by the cells in one subpool <=> in our configuration to ${NUM_MAX_STREAM_DEFAULT} / 4 = 1200 / 4 = 300
# the sum of the allocated PRB for cell-1 and cell-3 as co-located into the same subpool id 0 should be 300
${NUM_MAX_PRB_GLOBAL}                           300

# frameStructureType=semiStatic + ulDlDataSlotRatio=1/4
# basicBeamSet=beamSet_6 w/ nrBtsBeamRefinementP2=true
# chBW=100Mhz + ssBurstSetPeriod=20 + csirsTrackingPeriod=80ms
#  - 12 SSB slots          : 273-32-32=209 PRB or 54-20-28=6 PRB for PDSCH
#  - 12 SIB slots          : 273 or 54 PRB for PDSCH
#  - 32 specific slots     : 273 or 54 PRB for PDSCH
#  - 32 RACH+UL slots      : 0 PRB for PDSCH
#  - 72 full DL slots maxi. or 72-x muted slots for PDSCH if cell is not zab
#  when the cell is not zab then slots are muted for TRS on cells (C0, C1, C2) and/or CSI-RS groups <=> 0 PRB for PDSCH
#
# if cell is zab and BBRM allocates 273 PRB for PDSCH due to inter subpool pooling => cell 1
#        in every 160slots : 12*209+12*273+32*273+72*273=2508+3276+8736+19656=34176
#        in 5 mins : (5*60*1000*2)/160=3750 => 34176*3750=128160000
${NUM_MAX_PRB_COUNT_CELL_ZAB_INTERL1SP}         128160000
#
# if cell is not zab but BBRM allocates 273 PRB for PDSCH due to inter subpool pooling => cell 3
# before activation of CB010513-E then 10 slots were muted: 34176-(10*273)=34176-2730=31446 and 31446*3750=117922500
#  after activation of CB010513-E then 14 slots are muted instead of 10: 34176-(14*273)=34176-3822=30354 and 30354*3750=113827500
${NUM_MAX_PRB_COUNT_CELL_NONZAB_INTERL1SP}      113827500
#
# if cell is not zab but BBRM allocates only 54 PRB for PDSCH due to inter subpool pooling => cell 2
# before activation of CB010513-E then 10 slots were muted:
#        in every 160slots : 12*6+12*54+32*54+(72-10)*54=72+648+1728+3348=5796
#        in 5mins : 5796*3750=21735000
#  after activation of CB010513-E then 14 slots are muted instead of 10: 5796-(14-10*54)=5796-216=5580 and 5580*3750=20925000
${NUM_PRB_COUNT_CELL_NONZAB_INTERL1SP}          20925000
# --------------------------------------------------------------------------------------------------------------------------------------------------
*** Keywords ***
Suite Setup CB010513-Common
    [Documentation]
    ...     Conditions:     it is based on the arguments ${keep_all_data_in_file}
    ...     Actions:        it performs the generic suite setup and backup the configurations files
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        suite setup is passed
    [Arguments]             ${keep_all_data_in_file}=${False}

    Setup.Suite Setup From Scratch              automaticTeardown=${True}    keepAllUeDataInCfgFile=${keep_all_data_in_file}
    Backup Files
    ${scf_suite_setup_backup}                   OAM Get SCF File    file=SCF_Suite_Setup_Backup.xml
    Set Suite Variable                          ${scf_suite_setup_backup}
    Dated Log                                   ===> backup file is ${scf_suite_setup_backup}

Suite Setup CB010513-ABIP
    [Documentation]
    ...     Conditions:     customs configurations scf et basic setup
    ...     Actions:        it performs the generic suite setup and backup the configurations files
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        suite setup is passed
    [Arguments]             ${scfPath}=${EMPTY}
    ...                     ${basiccfgPath}=${EMPTY}

    Setup.Suite Setup From Scratch    keepAllUeDataInCfgFile=${True}        automaticTeardown=${True}
    ...                     scfcPathname=${scfPath}     basicPathname=${basiccfgPath}
    Backup Files
    ${scf_suite_setup_backup}         OAM Get SCF File    file=SCF_Suite_Setup_Backup.xml
    Set Suite Variable      ${scf_suite_setup_backup}
    Dated Log               SCF backup file = ${scf_suite_setup_backup}


Suite Teardown CB010513-Common
    [Documentation]
    ...     Conditions:     it needs no conditions
    ...     Actions:        it restores the files when the test is finished
    ...     Checks:         it needs no checks
    ...     Verdict:        suite teardown is passed

    Restore Files
    ${scf_suite_teardown_restore}=              Get Variable Value    ${scf_suite_setup_backup}    None
    OAM Perform Full Commissioning              scf_file=${scf_suite_teardown_restore}
    OAM wait available
    ${std_output}=                              Run    rm -f ${scf_suite_setup_backup}
    Dated Log                                   ===> ${std_output}
    Dated Log                                   ===> restore file is ${scf_suite_teardown_restore}
# --------------------------------------------------------------------------------------------------------------------------------------------------
# RAD Parameters #
Set RAD Parameters for CB010513
    [Documentation]
    ...     Conditions:     it needs no conditions
    ...     Actions:        it adds or modifies the RAD parameters for CB010513 to activate the CB008941 feature. It will be replaced later by NIDD
    ...     Checks:         it needs no checks
    ...     Verdict:        the setting is passed

    Dated Log New Line                          ===> set RAD parameters
    #
    #0x190297=1#CB008941 BOAM_RUMAG#                                          ${rad_0x190297}=        Create Dictionary    field=0x190297    value=1
    #0x190305=1#CB008941 BOAM_RUMAG UL default enabled#                       ${rad_0x190305}=        Create Dictionary    field=0x190305    value=1
    #0x190306=1#CB008941 BOAM_RUMAG DL default enabled#                       ${rad_0x190306}=        Create Dictionary    field=0x190306    value=1
    #

    ${rad_0x580117}=        Create Dictionary    field=0x580117    value=9    #0x580117=9#CSI-RS Event Sherpa#+ Events 47 and 48#

    #0x58066a=0#CB008940-G InterL1SubPool 0:Disabled - 1:Enabled#             ${rad_0x58066a}=        Create Dictionary    field=0x58066a    value=0
    #...70a=0#rdCellCsiRsPeriodicityBbPoolExtensionTddFr1 L2PS 0:Disabled#    ${rad_0x58070a}=        Create Dictionary    field=0x58070a    value=0
    #
    #0x5901C9=1#CB008941 L3_rdUlUpFragmentationEnable#                        ${rad_0x5901C9}=        Create Dictionary    field=0x5901C9    value=1
	#0x5901dd=0#rdCprt L3 0:Disabled#                                     ${rad_0x5901dd}=        Create Dictionary    field=0x5901dd    value=0
    #0x5901CA=1#CB008941 L3_rdDlUpFragmentationEnable#                        ${rad_0x5901CA}=        Create Dictionary    field=0x5901CA    value=1
    #
    #0x600012=1#CB008941 BOAM_NRTS#                                           ${rad_0x600012}=        Create Dictionary    field=0x600012    value=1
    #0x600013=1#CB008941 WA_FROM_BOAM_NRTS#                                   ${rad_0x600013}=        Create Dictionary    field=0x600013    value=1
    #0x600017=1#CB008941 BOAM_NRTS_rdDlUpFragmentation ---> DL muting#        ${rad_0x600017}=        Create Dictionary    field=0x600017    value=1
    #0x600018=1#CB008941 BOAM_NRTS_rdUlUpFragmentation ---> UL muting#        ${rad_0x600018}=        Create Dictionary    field=0x600018    value=1
    #
    ${list_rad_param}=                          Create List    ${rad_0x580117}
    Dated Log                                   ===> RAD params list is ${list_rad_param}
    SetConfig.Set Fields in swconfig DU         param_list=${list_rad_param}
# --------------------------------------------------------------------------------------------------------------------------------------------------
# Vendor configuration #
Deploy Vendor File Config
    [Documentation]
    ...     Conditions:     it is based on the arguments ${vendor_param} ${is_perform_full_commissioning}
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${vendor_param}
    ...                     ${is_perform_full_commissioning}=${True}

    # OAM Perform Full Commissioning is mandatory to apply vendor configuration
    Update Vendor File Config For bbL1SpPrbInitCapacity    ${vendor_param}
    # Force the full commissioning when it is requested
    Run Keyword if    ${is_perform_full_commissioning}    Run Keywords
    ...                                         OAM Perform Full Commissioning    scf_file=${scf_suite_setup_backup}
    ...    AND                                  Restart Airphone
    ...    AND                                  Wait Airphone Available
    ...    AND                                  OAM wait available    wait_time=300


Update Vendor File Config For bbL1SpPrbInitCapacity
    [Documentation]
    ...     Conditions:     it is based on the argument ${vendor_param}
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${vendor_param}

    ${original_vendor_file}                     ${modified_vendor_file}    SetConfig.Download Vendor File
    Dated Log                                   ===> original vendor file name is ${original_vendor_file}
    Dated Log                                   ===> modified vendor file name will be ${modified_vendor_file}

    ScfVendorOperations.setup reader    ${original_vendor_file}
    ${mo_dict}                                  ScfVendorOperations.get moelements byclass    NRBTS
    # bbL1SpPrbInitCapacity
    # Original value should be related to <!-- 48 CS, only DL -->
    &{original_values}                          Create Dictionary    bbHwVariant=${vendor_param.bb_hw_variant}
    ...                                                             csSize=48
    ...                                                             direction=DL
    ...                                                             l1PoolType=NR_L1_Loki_TDD_FR1_eCPRI_IQF_Asymm
    ...                                                             maxNumLayerPrbL1Sp=${NUM_MAX_LAYER_PRB_L1_SP_DEFAULT}
    ...                                                             maxNumStreamPrbL1Sp=${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT}
    ...                                                             maxNumWbStreamPrbL1Sp=${NUM_MAX_WB_STREAM_PRB_L1_SP_DEFAULT}

    ${vendor_param.max_num_layer_prb_l1_sp}=    Run Keyword If    ${vendor_param.max_num_layer_prb_l1_sp} == None
    ...                                                             Set Variable    ${NUM_MAX_LAYER_PRB_L1_SP_DEFAULT}
    ...                                                     ELSE    Set Variable    ${vendor_param.max_num_layer_prb_l1_sp}

    ${vendor_param.max_num_stream_prb_l1_sp}=    Run Keyword If    ${vendor_param.max_num_stream_prb_l1_sp} == None
    ...                                                             Set Variable    ${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT}
    ...                                                      ELSE    Set Variable    ${vendor_param.max_num_stream_prb_l1_sp}

    ${vendor_param.max_num_wb_stream_prb_l1_sp}=    Run Keyword If    ${vendor_param.max_num_wb_stream_prb_l1_sp} == None
    ...                                                             Set Variable    ${NUM_MAX_WB_STREAM_PRB_L1_SP_DEFAULT}
    ...                                                         ELSE    Set Variable    ${vendor_param.max_num_wb_stream_prb_l1_sp}

    &{new_values}                               Create Dictionary    bbHwVariant=${vendor_param.bb_hw_variant}
    ...                                                             csSize=48
    ...                                                             direction=DL
    ...                                                             l1PoolType=NR_L1_Loki_TDD_FR1_eCPRI_IQF_Asymm
    ...                                                             maxNumLayerPrbL1Sp=${vendor_param.max_num_layer_prb_l1_sp}
    ...                                                             maxNumStreamPrbL1Sp=${vendor_param.max_num_stream_prb_l1_sp}
    ...                                                             maxNumWbStreamPrbL1Sp=${vendor_param.max_num_wb_stream_prb_l1_sp}
    @{original_items_list}=                     Create List    ${original_values}
    @{new_items_list}=                          Create List    ${new_values}
    ${list_name}                                Set Variable    bbL1SpPrbInitCapacity
    ${modified_mo}=    ScfVendorOperations.replace items inList    ${original_items_list}    ${new_items_list}    ${list_name}    ${mo_dict}

    #Modify parameter actTddCsiRsallocationOptimization to false in vendor file
    @{set_9836}=            Create List       actTddCsirsAllocOptimization      false
    @{Param_To_Replace}=    Create List       ${set_9836}
    ${modified_mo}=         ScfVendorOperations.replace params inMo      ${Param_To_Replace}    ${mo_dict}

    ScfVendorOperations.save back toxml    ${modified_vendor_file}
    ${Tmp_file_ls}                              OperatingSystem.run    ls -altr ${modified_vendor_file}
    Dated log                                   Obtained file ${Tmp_file_ls}
    &{args}                                     Create Dictionary    vendor_file="${modified_vendor_file}"
    OAM Run Command                             cmd=set_vendor_file    cmd_args=${args}
# --------------------------------------------------------------------------------------------------------------------------------------------------
# Capture #
Captures Init
    [Documentation]
    ...     Conditions:     it needs no conditions
    ...     Actions:        it configures the parameters to initialize the captures for L1L2, CORE and CPRT
    ...     Checks:         it needs no checks
    ...     Verdict:        the parameters for the captures are initialized

    ${capture_l1l2}                             Capture L1L2 Set Upon Config    airscale=${GNB_DU}
    ${capture_core}    Run Keyword If    ${isAic}
    ...                                         Capture CORE Set Upon Config    airscale=${GNB_CU}
    ...                            ELSE         Capture CORE Set Upon Config    airscale=${GNB_DU}
    ${capture_cprt}                             Capture CPRT Set Upon Config    airscale=${GNB_DU}
    Capture Init                                ${capture_l1l2}    withTN=True
    Capture Init                                ${capture_core}    withTN=True
    Capture Init                                ${capture_cprt}    withTN=True
    Set Suite Variable                          ${capture_l1l2}
    Set Suite Variable                          ${capture_core}
    Set Suite Variable                          ${capture_cprt}


Captures Start
    [Documentation]
    ...     Conditions:     it is based on the arguments ${action_core} ${action_cprt} ${action_l1l2}
    ...     Actions:        it starts the captures for L1L2 and/or CORE and/or CPRT depends on an argument
    ...     Checks:         it needs no checks
    ...     Verdict:        the captures are started
    [Arguments]             ${action_core}=${False}    # Capture CORE is not started by default
    ...                     ${action_cprt}=${False}    # Capture CPRT is not started by default
    ...                     ${action_l1l2}=${False}    # Capture L1L2 is not started by default

    Run Keyword If    ${action_core}    Capture Start    capture=${capture_core}
    Run Keyword If    ${action_cprt}    Capture Start    capture=${capture_cprt}
    Run Keyword If    ${action_l1l2}    Capture Start    capture=${capture_l1l2}


Captures Stop
    [Documentation]
    ...     Conditions:     it is based on the arguments ${action_core} ${action_cprt} ${action_l1l2}
    ...     Actions:        it stops the captures for L1L2 and/or CORE and/or CPRT depending on an argument
    ...     Checks:         it needs no checks
    ...     Verdict:        the captures are stopped
    [Arguments]             ${action_core}=${True}     # Capture CORE is stopped by default
    ...                     ${action_cprt}=${True}     # Capture CPRT is stopped by default
    ...                     ${action_l1l2}=${True}     # Capture L1L2 is stopped by default

    Run Keyword If    ${action_l1l2}    Capture Stop    capture=${capture_l1l2}
    Run Keyword If    ${action_core}    Capture Stop    capture=${capture_core}
    Run Keyword If    ${action_cprt}    Capture Stop    capture=${capture_cprt}
# --------------------------------------------------------------------------------------------------------------------------------------------------
# Traffic #
DL Traffic GBR SA Not Stopped
    [Documentation]
    ...     Conditions:     it is based on the arguments ${param} ${current_ue_setting} ${current_trf_id}
    ...     Actions:        it manages the DL traffic GBR on the UE
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        DL traffic is passed
    [Arguments]             ${param}
    ...                     ${current_ue_setting}=${BASIC_UE_SA}
    ...                     ${current_trf_id}=20

    # Step 1 on qfi=2 with protocol tcp
    Set To Dictionary                           ${current_ue_setting}    trf_id    ${current_trf_id}
    Set To Dictionary                           ${current_ue_setting}    qfi    2
    Traffic UE DL                               ueSetting=${current_ue_setting}
    ...                                         throughput=${current_ue_setting.throughput_gbr}
    ...                                         captureCallback=None
    ...                                         capture=None
    ...                                         captureDuration=0
    ...                                         duration=${param.duration}
    ...                                         shouldBeStop=False
    ...                                         deviation=${param.deviation}
    ...                                         protocol=tcp
    # Step 2 on qfi=3 with protocol udp
    ${current_trf_id}=                          Evaluate    ${current_trf_id} + 1
    Set To Dictionary                           ${current_ue_setting}    trf_id    ${current_trf_id}
    Set To Dictionary                           ${current_ue_setting}    qfi    3
    Traffic UE DL                               ueSetting=${current_ue_setting}
    ...                                         throughput=${current_ue_setting.throughput_gbr}
    ...                                         captureCallback=None
    ...                                         capture=None
    ...                                         captureDuration=0
    ...                                         duration=${param.duration}
    ...                                         shouldBeStop=False
    ...                                         deviation=${param.deviation}
    ...                                         protocol=udp


DL Traffic Not Stopped
