*** Keywords ***

    # Start Keyword for TCs

CB009222_FDD_receiver_test_model
    [Arguments]           ${param}     ${feat}
    [Documentation]       Test Model for uplink

    Set Suite Variable    ${param}
    Init Sequence         ${param}

    Set Suite Variable    ${feat}

    Step                  CB009222-A Test Line Preparation                              argument=${param}

    Critical Step         oam.Activate Test dedicated Mode                   depends=Test Line Preparation
    Step                  Start 5g Uplink test                               depends=Activate Test dedicated Mode
    Step                  Check CpRtCm_StartConformanceTestReq parameters_FDD_G-FR1-A1-4    argument=${CAPTURE_CPRT}
    ...                   depends=Start 5g Uplink test
    Step                  Check CpRtCm_CellSetupRequest parameters_FDD_G-FR1-A1-4    argument=${CAPTURE_CPRT}
    ...                   depends=Check CpRtCm_StartConformanceTestReq parameters_FDD_G-FR1-A1-4
    Step                  Check PuschReceiveReq FR1-A1-4    argument=${CAPTURE_GNB}
    ...                   depends=Check CpRtCm_CellSetupRequest parameters_FDD_G-FR1-A1-4

    [Teardown]            Teardown TC

CB009222_FDD_transmitter_test_model
    [Arguments]           ${param}     ${feat}
    [Documentation]       Test Model for downlink

    Set Suite Variable    ${param}
    Init Sequence         ${param}

    Set Suite Variable    ${feat}

    Step                   CB009222-A Test Line Preparation                              argument=${param}

    Critical Step          oam.Activate Test dedicated Mode                       depends=Test Line Preparation
    Step                   Start 5g downlink test                                 depends=Activate Test dedicated Mode
    Step                   Check CpRtCm_StartConformanceTestReq parameters_FDD_NR-FR1-TM2a    argument=${CAPTURE_CPRT}
    ...                    depends=Start 5g downlink test
    Step                   Check CpRtCm_CellSetupRequest parameters_FDD_NR-FR1-TM2a    argument=${CAPTURE_CPRT}
    ...                    depends=CpRtCm_StartConformanceTestReq parameters_FDD_NR-FR1-TM2a
    Step                   Check pdschsendreq FR1-TM2a    argument=${CAPTURE_GNB}
    ...                    depends=Check CpRtCm_CellSetupRequest pparameters_FDD_NR-FR1-TM2a

    [Teardown]            Teardown TC

Start 5g Uplink test
    [Documentation]         Prepare capture CPRT and gNB, start and stop uplink Test
    ...                     Then analyze CPRT and BIP traces
    [Arguments]

    ${CAPTURE_CPRT.prefix}    Set Variable    Cprt_downlink

    ${CAPTURE_GNB.prefix}     Set Variable    gNB_downlink

    Dated log               Cprt capture prefix: ${CAPTURE_CPRT.prefix} & Gnb capture prefix: ${CAPTURE_GNB.prefix}

    Start Capture CPRT      ${CAPTURE_CPRT}
    Start Capture GNB       ${CAPTURE_GNB}

    @{beam_pattern_id_list}       Create List     1
    ${rtId}                       Get Runtime Id
    ${tCellId}                    Set Variable    1
    ${oam}                        Set Variable   ${GNB_DU.oam}
    ${cell_dn}           Set Variable   /MRBTS-1/RAT-1/RUNTIME_VIEW-${rtId}/MRBTS_R-${rtId}/NRBTS_R-${tCellId}/NRCELL_R-${tCellId}

    ${beam_pattern_id}            Set Variable   ${beam_pattern_id_list}
    ${ru_mode}                    Set Variable   NR_Only
    ${phys_cell_id}               Set Variable   50

    Dated Log                     Start Upnlink test

    ${cmd}                          Set Variable    start_5g_uplink_test

    &{args}                         Create Dictionary
    ...                                 dist_name="${cell_dn}"
    ...                                 frc_index="G_FR1_A1_4"
    ...                                 beam_pattern_id=${beam_pattern_id}
    ...                                 interval=1
    ...                                 prb_offset=0
    ...                                 ru_mode="${ru_mode}"
    ...                                 phys_cell_id=${phys_cell_id}
    ${result}                        SBTS OAM Run Command    oam=${oam}    cmd=${cmd}    cmd_args=${args}
    Traced Sleep   2        msg=CPRT and BIP L1L2 logs capture is ongoing

    Run Keyword And Ignore Error    Stop 5g uplink Test

    Stop Capture            ${CAPTURE_GNB}
    Stop Capture            ${CAPTURE_CPRT}

Stop uplink Test
    [Documentation]
    ...     Stop uplink test
    ...
    ...                             *Argument details:*
    ...                              - oam : Oam identity (ex: ${TGNB_DU[0].oam} or ${TGNB_CU[0].oam})
    ...                              - cell_dn :  cell DN (/MRBTS-1/RAT-1/RUNTIME_VIEW-.../NRCELL_R-1)
    [Arguments]                     ${oam}
    ...                             ${cell_dn}
    Dated Log                       Stop uplink test
    ${cmd}                          Set Variable    stop_5g_uplink_test
    &{args}                         Create Dictionary
    ...                                 dist_name="${cell_dn}"
    ${result}                       SBTS OAM Run Command    oam=${oam}    cmd=${cmd}    cmd_args=${args}
    Log to console                  ${result}

Start 5g Downlink test
    [Documentation]         Prepare capture CPRT and gNB, start and stop uplink Test
    ...                     Then analyze CPRT and BIP traces
    [Arguments]

    ${CAPTURE_CPRT.prefix}    Set Variable    Cprt_downlink
    ${CAPTURE_GNB.prefix}     Set Variable    gNB_downlink
    Dated log               Cprt capture prefix: ${CAPTURE_CPRT.prefix} & Gnb capture prefix: ${CAPTURE_GNB.prefix}
    Start Capture CPRT      ${CAPTURE_CPRT}
    Start Capture GNB       ${CAPTURE_GNB}

    @{beam_pattern_id_list}         Create List     1
    ${rtId}                         Get Runtime Id
    ${tCellId}                      Set Variable    1
    ${oam}                          Set Variable   ${GNB_DU.oam}
    ${cell_dn}                      Set Variable   /MRBTS-1/RAT-1/RUNTIME_VIEW-${rtId}/MRBTS_R-${rtId}/NRBTS_R-${tCellId}/NRCELL_R-${tCellId}
    ${beam_pattern_id}              Set Variable   ${beam_pattern_id_list}
    ${ru_mode}                       Set Variable   NR_Only
    ${phys_cell_id}                  Set Variable   50

    Dated Log                       Start Downnlink test
    ${cmd}                          Set Variable    start_5g_downlink_test
    &{args}                         Create Dictionary
    ...                                 dist_name="${cell_dn}"
    ...                                 test_model="TM2A"
    ...                                 beam_pattern_id=${beam_pattern_id}
    ...                                 polarization="P_plus45_or_0"
    ...                                 power_backoff=0
    ...                                 ru_mode="${ru_mode}"
    ...                                 codebook_2_antports=0
    ...                                 i11_codebook_4_antports=0
    ...                                 i2_codebook_4_antports=0
    ...                                 i13_codebook_4_antports=0
    ...                                 phys_cell_id=${phys_cell_id}
    ...                                 mimo_rank=1


    ${result}                        SBTS OAM Run Command    oam=${oam}    cmd=${cmd}    cmd_args=${args}
    Traced Sleep   2        msg=CPRT and BIP L1L2 logs capture is ongoing

    Run Keyword And Ignore Error    Stop 5g Downlink Test

    Stop Capture            ${CAPTURE_GNB}
    Stop Capture            ${CAPTURE_CPRT}

Stop Downlink Test
    [Documentation]
    ...     Stop 5G downlink test
    ...
    ...                             *Argument details:*
    ...                              - oam : Oam identity (ex: ${TGNB_DU[0].oam} or ${TGNB_CU[0].oam})
    ...                              - cell_dn :  cell DN (/MRBTS-1/RAT-1/RUNTIME_VIEW-.../NRCELL_R-1)
    [Arguments]                     ${oam}
    ...                             ${cell_dn}
    Dated Log                       Stop uplink test
    ${cmd}                          Set Variable    stop_5g_uplink_test
    &{args}                         Create Dictionary
    ...                                 dist_name="${cell_dn}"
    ${result}                       SBTS OAM Run Command    oam=${oam}    cmd=${cmd}    cmd_args=${args}
    Log to console                  ${result}


Check CpRtCm_StartConformanceTestReq parameters_FDD_G-FR1-A1-4
    [Documentation]
    ...     Check CpRtCm_StartConformanceTestReq parameters
    ...    -frcIndex: Indicate which test model for the testing (G_FR1_A1_4)
    ...    -type: receiver for uplink test
    ...    -rumode: NR_Only

    [Arguments]         ${CAPTURE_CPRT}

    ${CB009222_TestModel}    set variable    G_FR1_A1_4

    Dated Log       Capture_CPRT_path ${CAPTURE_CPRT.path}  ${CAPTURE_CPRT}

    ${pdmlFileCprt}     analyzer.pcap_to_pdml       ${CAPTURE_CPRT.path}

    Dated Log       Check CpRtCm_StartConformanceTestReq parameters

    @{msg_field}    Create List     frcIndex
    ...                             type
    ...                             ruMode
    ...                             nrCellIdentity

    @{listPacketMatch}              Get Packet Match List
    ...                             pdmlFile=${pdmlFileCprt}
    ...                             packetName=itf_l2_ps_tm_cell_startconformancetestreq_t
    ...                             pathList=@{msg_field}

    ${packet}                       set variable                  ${listPacketMatch[0]}

    ${frcindex}                    Get Value In Packet Match
    ...                             ${packet}
    ...                             field=frcIndex
    ...                             kind=showname

    Should contain                  ${frcindex}        ${CB009222_TestModel}

    ${type}                Get Value In Packet Match
    ...                             ${packet}
    ...                             field=type
    ...                             kind=showname

    Should contain                  ${type}             Receiver

    ${ruMode}               Get Value In Packet Match
    ...                             ${packet}
    ...                             field=ruMode
    ...                             kind=showname

    Should contain                  ${ruMode}             NR_only

    ${nrCellIdentity}               Get Value In Packet Match
    ...                             ${packet}
    ...                             field=nrCellIdentity
    ...                             kind=showname

    Should contain                  ${nrCellIdentity}             16385

