"""
Module with help functions for connections
"""
import logging
from taf.config.testline import RealEnb


def get_test_pc_for_nodeb(tl, nodeb):
    test_pcs = [test_pc for test_pc in tl.test_pcs for obj in test_pc.connections if obj is nodeb]
    if test_pcs:
        return test_pcs[0]
    else:
        logging.info("test_pcs were not found and connecting to default test_pc")
        return tl.test_pc
