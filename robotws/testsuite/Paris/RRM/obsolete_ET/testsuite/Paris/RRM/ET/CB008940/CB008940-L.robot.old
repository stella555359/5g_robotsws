*** Keywords ***

Set CB008940-L NIDD PARAMETERS with actDtxOptimizedScheduler
    [Arguments]    ${list}=${NIDD_8940_L_W_actDtxOptimizedScheduler_PARAMS}
    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable           ${test_scf_file}
    Set CB008940-L NIDD PARAMETERS VERSION 3     ${list}
    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable           ${test_scf_file}

Check CB008940-L NIDD PARAMETERS with actDtxOptimizedScheduler
   [Arguments]    ${list}=${NIDD_8940_L_W_actDtxOptimizedScheduler_PARAMS}
   Check CB008940 NIDD PARAMETERS VERSION 3     ${list}

Set CB008940-L NIDD PARAMETERS with actSpatialStreamPooling
    [Arguments]    ${list}=${NIDD_8940_L_w_actSpatialStreamPooling_PARAMS}
    Set CB008940-L NIDD PARAMETERS VERSION 3     ${list}
    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable           ${test_scf_file}

Check CB008940-L NIDD PARAMETERS with actSpatialStreamPooling
   [Arguments]    ${list}=${NIDD_8940_L_w_actSpatialStreamPooling_PARAMS}
   Check CB008940 NIDD PARAMETERS VERSION 3     ${list}



