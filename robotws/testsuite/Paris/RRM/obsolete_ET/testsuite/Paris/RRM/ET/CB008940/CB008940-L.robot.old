*** Settings ***
# https://confluence.ext.net.nokia.com/pages/viewpage.action?spaceKey=5GFTPARIS&title=ET+Coding+Rules
# --------------------------------------------------------------------------------------------------------------------------------------------------
Documentation     [SUITE PURPOSE]   CB008940-L Test suite ...
...               Prerequisite : gNB configured with x Cells & RU detected. Physical cells id are 50, 51, etc.
...               Scope : call setup - nGBR and GBR traffic several Ues
...               Test Case Scenario author   : christophe.samson@nokia.com
...               Creation Date               : 03-04-2023
...               Modified Date               : 03-04-2023
...               Last Modified by            : christophe.samson@nokia.com
...               Version   Date          Author                                   Notes
...               0.1       03-04-2023    christophe.samson@nokia.com              Creation
# --------------------------------------------------------------------------------------------------------------------------------------------------

# Libraries
Library      taf.transport.ssh                                   WITH NAME          ssh
Library      taf.sbts.oam.coam.admin.interface
Library      taf.sbts.oam.coam.admin                             WITH NAME          coam
Library      taf.collectors.tcpdump                              WITH NAME          tcpdump
Library      taf.collectors.core                                 WITH NAME          core
Library      ute_wtssim
Library      taf.config.wts                                      WITH NAME          wts

# Libraries SWENG
Library      ../../../resources/SWENG/python/StringTool.py

# Libraries ET
Library      ../resources/python/linux_cmds.py
Library      ../resources/common/TtiTrace/python/ttitrace.py     WITH NAME          nps_ttitraces_tools
Library      ../resources/DSS/python/robot_extension.py          WITH NAME          robot_extension

# Libraries CB008940
Library      resources/python/Constants-CB008940-Q-L.py          WITH NAME          MyConstants
Library      resources/python/avg_dl_data.py
Library      resources/python/avg_ul_data.py
Library      resources/python/tools.py                           WITH NAME          nps_8940_tools
Library      resources/python/CB008940-lib.py

# Resources
Resource     ../../../resources/SWENG/robot/Tools.robot
Resource     ../../../resources/SWENG/robot/Setup.robot
Resource     ../resources/common/TtiTrace/ttitrace.robot

# Resources CB008940
Resource     ./resources/robot/btslog.robot
Resource     ./resources/robot/CB008940-Common-Keywords.robot
Resource     ./resources/robot/CB008940-B-Keywords.robot
Resource     ./resources/robot/CB008940-C-Keywords.robot
Resource     ./resources/robot/CB008940-Q-L-Common-Keywords.robot

Variables    ./resources/python/Constants-CB008940-Q-L.py

# Suites and Tests setup and teardown
Suite Setup       Suite Setup CB008940-Q-L-Common    test_dictParam=${dictParam}
Suite Teardown    Suite Teardown CB008940-Q-L-Common
Test Setup        Test Setup for CB008940-Common
Test Teardown     Test Teardown for CB008940-Common

*** Variables ***

${relative_json_path}                                               ${CURDIR}/CB008940_L_data_tests.json

${TestSharkTool}                                                    MC_SHARK

&{dictParam}                                                        w_Basic_Call_to_Setup_Wtsemu=${True}
...                                                                 w_enable_sherpa_Traces=False
...                                                                 w_check_8940_using_sherpa=False
...                                                                 w_GetTtiTrace=True
...                                                                 w_convert_TtiPcap_to_excelCsv=False
...                                                                 w_GetL1L2Bip=False
...                                                                 w_generic_capture=True
...                                                                 w_CaptureCORE=${False}
...                                                                 w_CaptureL1L2=${False}
...                                                                 w_CaptureCPRT=${True}
...                                                                 w_ue_detach=False
...                                                                 w_GetBtsLog=True
...                                                                 w_DISPLAY_ue_stats_nr_15min=False
...                                                                 w_CB007113_Check=False

# capture Time setting
&{CAPTURE}                                                          GetTtiTraceTime=1s
...                                                                 Getl1l2TraceTime=1s
...                                                                 GetSherpaTraceTime=1s
...                                                                 GetTtiTraceNumOfEvent=5000

&{dictExpectedValues}                                               expected_avg_total_prbs_spool1=546
...                                                                 expected_avg_total_prbs_spool2=78
...                                                                 expected_avg_total_prbsstream_spool1=2100
...                                                                 expected_avg_total_prbsstream_spool2=300

# tests settings
&{C_Cell}                                                           dir=DL
...                                                                 totalNbOfUe=1                 # total number of ue's to configure
...                                                                 totalNbOfCell=3               # total number of cell used for ue's dispatching
...                                                                 targetGnb=2                   # gnb target id
...                                                                 captureDuration=0             # capture duration during traffic starting phase
...                                                                 duration=3                    # traffic duration during declaration phase
...                                                                 deviation=10                  # allowed deviation for throughput

# ue's settings
&{dict_settings_ue_1}                                               originalCell=1                # original cell for call establishment
...                                                                 DL_throughput=150             # throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 DL_throughput_GBR=10          # throughput GBR is not supported
...                                                                 UL_throughput=0               # UL throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 packet_size=1350

&{dict_settings_ue_2}                                               originalCell=2
...                                                                 DL_throughput=100
...                                                                 DL_throughput_GBR=10
...                                                                 UL_throughput=0               # UL throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 packet_size=1350

&{dict_settings_ue_3}                                               originalCell=3
...                                                                 DL_throughput=100
...                                                                 DL_throughput_GBR=10
...                                                                 UL_throughput=0               # UL throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 packet_size=1350

&{dict_settings_ue_default}                                         originalCell=1
...                                                                 DL_throughput=100
...                                                                 DL_throughput_GBR=0           # throughput GBR is not supported
...                                                                 UL_throughput=0
...                                                                 packet_size=1350


@{dict_settings_all_ues}                                            ${dict_settings_ue_1}
...                                                                 ${dict_settings_ue_2}
...                                                                 ${dict_settings_ue_3}

