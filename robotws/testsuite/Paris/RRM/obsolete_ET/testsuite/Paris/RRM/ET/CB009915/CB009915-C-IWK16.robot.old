*** Settings ***
Documentation     [SUITE PURPOSE]   Common keyword of CB009915 feature
...               Prerequisite : gNB configured with 4 Cells & RU detected
...               Scope : CB009915-C-IWK16 (IWK with CB011028)

...               Test Case Scenario author   : adrien.hervat@nokia.com

...               Creation Date               : 27-11-2023
...               Version History    Date           Author                      Notes
...               1.0                22-12-2023     adrien.hervat@nokia.com     First Push
...               0.2                24-09-2024     richard.duthu@nokia.com     Produce Scout data + some RF50 fixes



Variables         ./resources/python/Constants-CB009915-C-IWK16-IWK17.py

Library           ./resources/python/CB009915-C-IWK16-IWK17_Checks.py

Resource          ./resources/robot/CB009915-C-IWK16-Keywords.robot

Library           OperatingSystem
Library           Collections
Library           logging
Library           ArchiveLibrary



Suite Setup                 Suite Setup for CB009915     custom_bsr_update=1

Suite Teardown              Suite Teardown



*** Variables ***

${TestSharkTool}            MC_SHARK

&{params}
...                         duration=5
...                         deviation=50
...                         rad=32       # must be set to 0 to use NIDD parameter repetitionRsType1
...                         timeCapture=2
...                         repetition=r2
...                         explicitCsirs=false
...                         csiReport=slots320
...                         bip=400

&{Vendor_Param}             bbHwVariant=ASOE                                 # bbL1SpPrbInitCapacity
...                         l1PoolType=NR_L1_Loki_TDD_FR1_eCPRI_IQF_Symm     # bbL1SpPrbInitCapacity
...                         maxNumLayerPrbL1Sp=2184                          # bbL1SpPrbInitCapacity DL
...                         maxNumStreamPrbL1Sp=2184                         # bbL1SpPrbInitCapacity DL   default value = 2184
...                         maxNumWbStreamPrbL1Sp=1092                       # bbL1SpPrbInitCapacity DL
...                         ul_maxNumLayerPrbL1Sp=819                        # bbL1SpPrbInitCapacity UL
...                         ul_maxNumStreamPrbL1Sp=1638                      # bbL1SpPrbInitCapacity UL   default value = 1638
...                         ul_maxNumWbStreamPrbL1Sp=1092                    # bbL1SpPrbInitCapacity UL
...                         maxNumScheUePdschL1Pool=None                     # bbPoolCapacity
...                         maxNumScheUePdschL1Sp=None                       # bbPoolCapacity

# ue's parameters
&{dict_settings_ue_1}                 originalCell=1                # original cell for call establishment
...                                   DL_throughput=300             # DL_throughput nonGBR
...                                   DL_throughput_GBR=0           # DL_throughput GBR
...                                   UL_throughput=100             # UL_throughput nonGBR
...                                   ue_nr_capa=${SA_TDD_RANK4}

&{dict_settings_ue_2}                 originalCell=2
...                                   DL_throughput=300
...                                   DL_throughput_GBR=0
...                                   UL_throughput=100
...                                   ue_nr_capa=${SA_TDD_RANK2}

&{dict_settings_ue_3}                 originalCell=3
...                                   DL_throughput=300
...                                   DL_throughput_GBR=0
...                                   UL_throughput=100
...                                   ue_nr_capa=${SA_TDD_RANK4}

&{dict_settings_ue_4}                 originalCell=4
...                                   DL_throughput=300
...                                   DL_throughput_GBR=0
...                                   UL_throughput=100
...                                   ue_nr_capa=${SA_TDD_RANK2}

@{List_UEs}                           ${dict_settings_ue_1}
...                                   ${dict_settings_ue_2}
...                                   ${dict_settings_ue_3}
...                                   ${dict_settings_ue_4}

# Cells parameters
&{Cell1_Conf}
