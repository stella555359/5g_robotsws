# http://5gtables.eecloud.dynamic.nsn-net.net/nrTput.php?code=EogBWkAAAAAEAAAAAAAAAAAA

*** Keywords ***
TC BW
    [Documentation]                 Generic test for several BW
    [Arguments]                     ${param}
    Init Sequence                   ${param}
    Critical Step                   Save Configuration BW
    Critical Step                   Set MRBTSID and NRBTSID
    Critical Step                   Set Context_Element Manager
    Critical Step                   Set Context_AP IPHY              
    Critical Step                   Set Context_WTS XML              
    Critical Step                   Set Context_WTS CFG              
    Critical Step                   Restart TL                       
    #Critical Step                   SA_keywords_2.Setup Wtsemu Environment      timeout=600
    Critical Step                   CallSetup.Setup Wtsemu SA
    Critical Step                   UE Cell Setup Check                                 
    Critical Step                   CallSetup.UE Register                   
    Critical Step                   CallSetup.UE Attach Check      
    Critical Step                   CallSetup.Launch PDU Session                 
    Critical Step                   ${param.dir} Traffic Feature BW                       timeout=8000

    [Teardown]                      GenericTest.Display diagnosis

Teardown BW
    Dated log                       Test ending
    Restore Configuration BW       # SCF parameters

EmbededRestartTL
    #goal is detect if Gnb had rebooted to inform retart TL KW
   ${isOAMRebooted}                SSH Was OAM Rebooted                ${GNB_DU}
   ...                             timeout=120
   Restart TL                      isOAMRebooted=${isOAMRebooted} 

Save Configuration BW
    Dated log                     Previous Configuration Saving before insertion of ${param.chBwUl} BW parameters
   ${original_scf_file}           Oam.OAM Get SCF File         
    Set Suite Variable            ${original_scf_file}
    Backup Files

Restore Configuration BW
    Dated log                          ${param.chBwUl}: Configuration Restoring
    Restore Files
    OAM Perform Full Commissioning     ${original_scf_file}
    Dated log                          sleep for 5 min after commissioning
    sleep  5min
    WA Airscale Wait for Ready      ${GNB_DU}

Set MRBTSID and NRBTSID
    ${dist_name} =              Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ${dist_name_fdd} =          Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1/NRCELL_FDD-1
    ${nrsysinfo_dist_name} =    Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRSYSINFO_PROFILE-1/NRIRFIM-1
    ${nrcelch_dist_name} =      Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELLGRP-0

    Set Suite Variable          ${dist_name}
    Set Suite Variable          ${dist_name_fdd}
    Set Suite Variable          ${nrsysinfo_dist_name}
    Set Suite Variable          ${nrcelch_dist_name}

Set Context_Element Manager
    &{modify_param1}    Create Dictionary
    ...    parameter=freqBandIndicatorNR
    ...    dist_name=${dist_name}
    ...    value=${param.freqBandIndicatorNR}

    &{modify_param2}   Create Dictionary
    ...    parameter=freqBandIndicatorNR
    ...    dist_name=${nrsysinfo_dist_name}
    ...    value=${param.freqBandIndicatorNR}

    &{modify_param3}    Create Dictionary
    ...    parameter=chBwUl
    ...    dist_name=${dist_name_fdd}
    ...    value=${param.chBwUl}

    &{modify_param4}    Create Dictionary
    ...    parameter=chBwDl
    ...    dist_name=${dist_name_fdd}
    ...    value=${param.chBwDl}

    &{modify_param5}    Create Dictionary
    ...    parameter=gscn
    ...    dist_name=${dist_name}
    ...    value=${param.gscn}

    &{modify_param6}    Create Dictionary
    ...    parameter=type0CoresetConfigurationIndex
    ...    dist_name=${dist_name}
    ...    value=${param.type0CoresetConfigurationIndex}

    &{modify_param7}    Create Dictionary
    ...    parameter=actDl256Qam
    ...    dist_name=${dist_name}
    ...    value=${param.actDl256Qam}

    &{modify_param8}    Create Dictionary
    ...    parameter=dlQam256PowerBackoffSub6
    ...    dist_name=${dist_name}
    ...    value=${param.dlQam256PowerBackoffSub6}

    &{modify_param9}    Create Dictionary
    ...    parameter=dllaIniMcs
    ...    dist_name=${dist_name}
    ...    value=${param.dllaIniMcs}

    &{modify_param10}    Create Dictionary
    ...    parameter=ullaIniMcs
    ...    dist_name=${dist_name}
    ...    value=${param.ullaIniMcs}

    &{modify_param11}    Create Dictionary
    ...    parameter=nrarfcnDl
    ...    dist_name=${dist_name_FDD}
    ...    value=${param.nrarfcnDl}

    &{modify_param12}    Create Dictionary
    ...    parameter=nrarfcnUl
    ...    dist_name=${dist_name_FDD}
    ...    value=${param.nrarfcnUl}

    &{modify_param13}    Create Dictionary
    ...    parameter=scs
    ...    dist_name=${nrcelch_dist_name}
    ...    value=${param.scs}

    &{modify_param14}    Create Dictionary
    ...    parameter=ssbScs
    ...    dist_name=${dist_name}
    ...    value=${param.ssbScs}

    &{modify_param15}    Create Dictionary
    ...    parameter=ssbScs
    ...    dist_name=${nrsysinfo_dist_name}
    ...    value=${param.ssbScs}

    @{modify_param}    Create List    ${modify_param1}    ${modify_param2}    ${modify_param3}   ${modify_param4}  
    ...                               ${modify_param5}    ${modify_param6}    ${modify_param7}   ${modify_param8}
    ...                               ${modify_param9}    ${modify_param10}   ${modify_param11}  ${modify_param12}
    ...                               ${modify_param13}   ${modify_param14}   ${modify_param15}  

    OAM Set Params
    ...                 ${modify_param}

Set Context_AP IPHY
    WtsXmlConfig.startSession           file=iphy
    #Need to record actual GSCN value for restaration at the end of the test  !!!!
    #set GSCN
    WtsXmlConfig.setListEltText         //GSCN                          ${param.gscn}
    WtsXmlConfig.stopSession            file=iphy

Set Context WTS XML
    WtsXmlConfig.startSession
    #set Arfcn
    WtsXmlConfig.setListEltText         //dlNrArfcn                        ${param.nrarfcnDl}
    WtsXmlConfig.setListEltText         //ulNrArfcn                        ${param.nrarfcnUl}
    #set gscn
    WtsXmlConfig.setListEltText         //gscn                              ${param.gscn}
    WtsXmlConfig.stopSession

Set Context_WTS CFG
    WtsCfgConfig.startSession
    ${oldValue}          getParam           prefix=set_cell          param=nr_arfcn
    replaceValue         prefix=set_cell
    ...                  param=nr_arfcn
    ...                  oldValue=${oldValue}
    ...                  newValue=${param.nrarfcnUl}:${param.nrarfcnDl}    #UL:DL
    ${oldValue}          getParam           prefix=ue_param          param=ue_nr_capabilities
    replaceValue         prefix=ue_param
    ...                  param=ue_nr_capabilities
    ...                  oldValue=${oldValue}
    ...                  newValue=${param.ue_capas_1}${param.ue_capas_2}${param.ue_capas_3}${param.ue_capas_4}
    WtsCfgConfig.stopSession         rename=modified

UL Traffic Feature BW
    Dated log                       Starting UL Traffic procedure
    #SA_keywords_2.Start Traffic And Check Average Data Rate    rate=2     expected_data_rate=2     dir=ul    duration=60
    Traffic.Traffic UE UL    duration=60    throughput=2    ueSetting=${BASIC_UE_SA}

DL Traffic Feature BW
    Dated log                       Starting DL Traffic procedure
    #SA_keywords_2.Start Traffic And Check Average Data Rate    rate=2     expected_data_rate=2     dir=dl    duration=60
    Traffic.Traffic UE DL    duration=60    throughput=2    ueSetting=${BASIC_UE_SA}

UL_DL Traffic Feature BW
    Dated log                       Starting UL DL Traffic procedure
    # SA_keywords_2.Start Traffic And Check Average Data Rate    rate=2     expected_data_rate=2     dir=ul    duration=300
    # SA_keywords_2.Start Traffic And Check Average Data Rate    rate=2     expected_data_rate=2     dir=dl    duration=300
    Traffic.Traffic UE UL DL    duration=300    throughput=2    ueSetting=${BASIC_UE_SA}

DL_30min Traffic Feature BW
    Dated log                       Starting DL_30min Traffic procedure
    #SA_keywords_2.Start Traffic And Check Average Data Rate    rate=2     expected_data_rate=2     dir=dl    duration=1800
    Traffic.Traffic UE DL    duration=1800    throughput=2    ueSetting=${BASIC_UE_SA}
