Documentation     [SUITE PURPOSE]   CB010513 Test suite for Cloud RAN
...               \nPrerequisite : gNB configured with x Cells & RU detected. Physical cells id are 50, 51, etc.
...               \nAll the configuration is prepared before testing (or applied automatically by using custom configuration).
...               \nScope : Parity testing to introduce dRNIC RINLINE2 on AP_LOO_DC
#
...               \nTest Case Scenario author : vincent.boulet@nokia.com
...               \nCreation Date             : 2024-06-24
...               \nModified Date             : 2024-06-24
#
#                 Version    Date       Author                          Notes
...               \n0.1      FB2412     vincent.boulet@nokia.com        Creation robot and TC for SA
# --------------------------------------------------------------------------------------------------------------------------------------------------

#vbo#debug# ===> temporarily commented out so as not to execute the corresponding command
#vbo#not applicable# ===> code not applicable in case of Cloud RAN or code not used
#vbo#n.a.#

# Libraries
Library           ../CB009915/resources/python/CB009915-B1-TTI.py

# Resources
Resource          ../CB010513/resources/robot/CB010513-Common-Keywords.robot

# Tags
Force Tags        CA_5G_SW_FR-Villarceaux    RRM    PY39    CONFIGURED    5G_RAN    RAN_5G

# Suites
Suite Setup       Suite Setup Cloud RAN    keep_all_data_in_file=${True}
Suite Teardown    Suite Teardown Cloud RAN

*** Variables ***
${AUTO_SAVE_DEBUG_DATA}               ${False}

# tests settings
&{CB010513_CR_basic}                  capture_duration=0            # capture duration during traffic starting phase
...                                   deviation=50                  # default deviation for throughput and double for uplink
...                                   dir=UL+DL                     # direction for supported traffic
...                                   duration=3                    # traffic duration during declaration phase
...                                   pm_waiting_period=1           # number of waiting periods added for observation
...                                   target_gnb=2                  # gnb target id
...                                   test_name=TC_CB010513_CR_TC1_SA
...                                   total_nb_cell=3               # total number of cell used for ue's dispatching
...                                   total_nb_ue=0                 # total number of ue's to configure

# ue's settings # configuration
&{dict_settings_ue_1}                 ue_id=1
...                                   original_cell=1               # original cell for call establishment
...                                   throughput=501                # requested dl throughput nonGBR
...                                   throughput_ul=101             # requested ul throughput nonGBR
&{dict_settings_ue_2}                 ue_id=21    original_cell=2    throughput=121    throughput_ul=21
&{dict_settings_ue_3}                 ue_id=31    original_cell=3    throughput=131    throughput_ul=31
@{dict_settings_basic}                ${dict_settings_ue_1}    ${dict_settings_ue_2}    ${dict_settings_ue_3}
