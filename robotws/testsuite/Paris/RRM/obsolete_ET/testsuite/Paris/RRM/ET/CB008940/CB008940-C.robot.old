Documentation     [SUITE PURPOSE]   CB008940-C Test suite ...
...               Prerequisite : gNB configured with x Cells & RU detected. Physical cells id are 50, 51, etc.
...               Scope : call setup - cell deletion and cell addition during traffic
...
...               Test Case Scenario author   : vincent.boulet@nokia.com
...               Creation Date               : 15-11-2022
...               Modified Date               : 18-01-2023
...               Last Modified by            : vincent.boulet@nokia.com
...               Version    Date      Author                                Notes
...               0.1        FB2223    vincent.boulet@nokia.com              Creation robot and TC CB008940-C_Cell_deletion_cell_addition
...               0.2        FB2224    vincent.boulet@nokia.com              Change for 3 cells configuration
...                                                                          Adding some Force Tags
...                                                                          Adding test case for cell deletion
...               0.3        FB2224    vincent.boulet@nokia.com              Update vendor file configuration w/ specific settings
...               0.4        FB2301    vincent.boulet@nokia.com              Updating path for custom config
...               0.5        FB2302    vincent.boulet@nokia.com              Updating ue's settings to reduce traffic rate
...               0.6        FB2303    ying.yw.wu@nokia.com                  Align TC name with QC testlab colomn "Test"
...               0.7        FB2303    ying.yw.wu@nokia.com                  Add vendor file param maxNumWbStreamPrbL1Sp=1092
...               0.8        FB2322    philippe.daroux@nokia.com             adaptation to new TOPO + VARIANT

# --------------------------------------------------------------------------------------------------------------------------------------------------

# Libraries

# Resources
Resource          ./resources/robot/CB008940-C-Keywords.robot

# Tags
Force Tags        CA_5G_SW_FR-Villarceaux    RRM
...               PY36
...               CLOUD_5G_I_LO_AP_LOOO_SANSA_FS_ECPRI_CMWV_TDD
...               master_classicalbts_all    SBTS00    SBTS23R1    SBTS22R4
#...              CONFIGS_POOLING/CB008940/CB008940_x/custom_config_8940_x.yaml
...               CONFIGURED    5G_RAN    RAN_5G    CRT

# Suites
#Suite Setup       CB008940-Common-Keywords.Suite Setup CB008940-Common
#Suite Teardown    CB008940-Common-Keywords.Suite Teardown CB008940-Common
Suite Setup       CB008940-Common-Keywords.Suite Setup CB008940-Common
...               yamlPathname=${CURDIR}/../../../../../custom-config/POOLING/CB008940/CB008940_C/custom_config_8940_C_SemiStatic.yaml


*** Variables ***
${TestSharkTool}                                                    MC_SHARK
# capture setting
&{CAPTURE_OFF}                                                      isCaptureL1L2=${False}
...                                                                 isCaptureCORE=${False}
...                                                                 isCaptureCPRT=${False}

&{CAPTURE_INVES}                                                    isCaptureL1L2=${False}
...                                                                 isCaptureCORE=${False}
...                                                                 isCaptureCPRT=${False}
# tests settings
&{C_Cell_deletion_cell_addition}                                    dir=DL
...                                                                 totalNbOfUe=0                 # total number of ue's to configure
...                                                                 totalNbOfCell=3               # total number of cell used for ue's dispatching
...                                                                 targetGnb=2                   # gnb target id
...                                                                 captureDuration=0             # capture duration during traffic starting phase
...                                                                 duration=3                    # traffic duration during declaration phase
...                                                                 deviation=10                  # allowed deviation for throughput


# ue's settings
&{dict_settings_ue_1}                                               originalCell=1                # original cell for call establishment
...                                                                 throughput=150                # throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 throughput_GBR=10             # throughput GBR is not supported 

&{dict_settings_ue_2}                                               originalCell=2
...                                                                 throughput=100
...                                                                 throughput_GBR=10

&{dict_settings_ue_3}                                               originalCell=3
...                                                                 throughput=100
...                                                                 throughput_GBR=10

&{dict_settings_ue_default}                                         originalCell=1
...                                                                 throughput=100
...                                                                 throughput_GBR=${NO_THROUGHPUT} # throughput GBR is not supported 

@{dict_settings_all_ues}                                            ${dict_settings_ue_1}
...                                                                 ${dict_settings_ue_2}
...                                                                 ${dict_settings_ue_3}

# vendor's setting
&{VENDOR_CUSTOM_1}                                                  bbHwVariant=ABIO
...                                                                 maxNumScheUePdschL1Pool=None
...                                                                 maxNumScheUePdschL1Sp=None
...                                                                 maxNumWbStreamPrbL1Sp=None
...                                                                 maxNumLayerPrbL1Sp=1200
...                                                                 maxNumStreamPrbL1Sp=1200
# --------------------------------------------------------------------------------------------------------------------------------------------------
*** Test Cases ***
### SA
# CB008940-C_030_[C9A] Cell_Addition_intra_L1_subpool_PRB_Pooling_with_Load-based_algorithm_for_new_BB_cell-sets _on_half_ABIO_dlMiMoMode

[1]CB008940-C_030_[C9A] Cell_Addition_intra_L1_subpool_PRB_Pooling_with_Load-based_algorithm_for_new_BB_cell-sets _on_half_ABIO_dlMiMoMode 8x4
    [Documentation]
    ...     Conditions:     it is based on the configuration ${C_Cell_deletion_cell_addition}
    ...     Actions:        it performs the call setup for multi-ues on different cells with DL traffic then cell addition
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues and PRB pooling are passed 
    
    TC 8940 C_030 Cell Addition Intra L1 Subpool PRB Pooling        ${C_Cell_deletion_cell_addition}
    ...                                                             ${VENDOR_CUSTOM_1}
    ...                                                             ${dict_settings_all_ues}
    ...                                                             ${CAPTURE_OFF}
    ...                                                             nrCell=3
    [Teardown]    Run Keyword If Test Failed    Setup.Test Teardown


