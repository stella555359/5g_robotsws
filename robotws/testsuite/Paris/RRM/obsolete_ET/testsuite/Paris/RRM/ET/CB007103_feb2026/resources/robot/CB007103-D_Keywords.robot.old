# Update configuration #

#Update gNB swconfig
# Update swconfig.txt in gNB
    ${SherpaVector}=        Create Dictionary      field=0x580117     value=7
    ${modSwconfgnb}=           Create List            ${SherpaVector}
    SetConfig.Set Fields in swconfig DU       param_list=${modSwconfgnb}
    Dated log          Rad Parameters modified:\n ${modSwconfgnb}


Update AP and gNB config__movedoncommonKW

    [Arguments]             ${testD}

    Update gNB swconfig_7103

    Run Keyword If    '${testD}' == 'D4'    Run keywords
    ...                    Dated Log    ================> custom config of test D4
    ...         AND           Setup.Apply Custom Config    scfc=${CURDIR}/../config/custom/scf7103D4sansR16dmrs.xml
    ...                    iphy=${CURDIR}/../config/custom/iphy7103D4.xml
    ...                    cfg=${CURDIR}/../config/custom/basic7103D4ModUE6R16BdCombPC2New.cfg
    ...         ELSE IF    '${testD}' == 'D4FromD2'    Run keywords
    ...                    Dated Log    ================> custom config of test D4
    ...         AND           Setup.Apply Custom Config    scfc=${CURDIR}/../config/custom/scf7103D4FromD2.xml
    ...                    iphy=${CURDIR}/../config/custom/iphy7103D4FromD2.xml
    ...                    cfg=${CURDIR}/../config/custom/basic7103D4FromD2.cfg
    ...         ELSE IF    '${testD}' == 'D2'    Run keywords
    ...                    Dated Log    ================> custom config of test D2
    ...         AND           Setup.Apply Custom Config    scfc=${CURDIR}/../config/custom/scf7103D2.xml
    ...                    iphy=${CURDIR}/../config/custom/iphy7103D2.xml
    ...                    cfg=${CURDIR}/../config/custom/basic7103D2.cfg
    ...         ELSE IF    '${testD}' == 'C6_F6_F10_F11'    Run keywords
    ...                    Dated Log    ================> custom config of test C6_F6_F10_F11
    ...         AND           Setup.Apply Custom Config    iphy=${CURDIR}/../config/custom/iphy7103_C6_F6_F10_F11_PR854432.xml

    Airscale Soft Reboot            ${AP_DU}
    Restart.Wait Airphone Available

    Airscale Soft Reboot            ${AP_DU}
    Restart.Wait Airphone Available


Update gNB swconfig_7103
# Update swconfig.txt in gNB
    ${dicthTPon}=             Create Dictionary      field=0x580376     value=5
    ${dicthTPoff}=            Create Dictionary      field=0x580377     value=5
    ${dictPwrBoost}=          Create Dictionary      field=0x58082F     value=30
    ${dicfeatbitmap2}=        Create Dictionary      field=0x58057D     value=786432
    ${dicfeatbitmaplevel}=    Create Dictionary      field=0x58057A     value=4
    #${dicSinrthTPon}=         Create Dictionary      field=0x580832     value=100
    #${dicSinrthTPoff}=        Create Dictionary      field=0x580833     value=100
    #${dicthRank12}=           Create Dictionary      field=0x580830     value=100
    #${dicthRank21}=           Create Dictionary      field=0x580831     value=100
    ${modSwconfgnb}=          Create List            ${dicthTPon}    ${dicthTPoff}
    ...                       ${dictPwrBoost}    ${dicfeatbitmap2}    ${dicfeatbitmaplevel}
    #...                              ${dicSinrthTPon}   ${dicSinrthTPoff}    ${dicthRank12}    ${dicthRank21}
    Set Fields in swconfig DU       param_list=${modSwconfgnb}
    Dated log          RadParams to modify:\n ${modSwconfgnb}


# --------------------------------------------------------------------------------------------------------------------------------------------------
# Capture #
Captures Init
    [Documentation]
    ...     Conditions:     it needs no conditions
    ...     Actions:        it configures the parameters to initialize the captures for L1L2, CORE and CPRT
    ...     Checks:         it needs no checks
    ...     Verdict:        the parameters for the captures are initialized

    ${capture_l1l2}=                            Capture L1L2 Set Upon Config    airscale=${GNB_DU}
    ${capture_core}=    Run Keyword If    ${isAic}
    ...                                         Capture CORE Set Upon Config    airscale=${GNB_CU}
    ...                            ELSE         Capture CORE Set Upon Config    airscale=${GNB_DU}
    ${capture_cprt}=                            Capture CPRT Set Upon Config    airscale=${GNB_DU}
    ${capture_cprt.filter}     Get Filter For SCTP

    Capture Init                                ${capture_l1l2}    #withTN=True
    Capture Init                                ${capture_core}    #withTN=True
    Capture Init                                ${capture_cprt}    #withTN=True
    Set Suite Variable                          ${capture_l1l2}
    Set Suite Variable                          ${capture_core}
    Set Suite Variable                          ${capture_cprt}




Captures Start
    [Documentation]
    ...     Conditions:     it is based on the arguments ${action_core} ${action_cprt} ${action_l1l2}
    ...     Actions:        it starts the captures for L1L2 and/or CORE and/or CPRT depends on an argument
    ...     Checks:         it needs no checks
    ...     Verdict:        the captures are started
    [Arguments]             ${action_core}=${False}    # Capture CORE is not started by default
    ...                     ${action_cprt}=${False}    # Capture CPRT is not started by default
    ...                     ${action_l1l2}=${False}    # Capture L1L2 is not started by default

    Run Keyword If    ${action_core}            Capture Start    capture=${capture_core}
    Run Keyword If    ${action_cprt}            Capture Start    capture=${capture_cprt}
    Run Keyword If    ${action_l1l2}            Capture Start    capture=${capture_l1l2}


Captures Stop
    [Documentation]
    ...     Conditions:     it is based on the arguments ${action_core} ${action_cprt} ${action_l1l2}
    ...     Actions:        it stops the captures for L1L2 and/or CORE and/or CPRT depending on an argument
    ...     Checks:         it needs no checks
    ...     Verdict:        the captures are stopped
    [Arguments]             ${action_core}=${True}     # Capture CORE is stopped by default
    ...                     ${action_cprt}=${True}     # Capture CPRT is stopped by default
    ...                     ${action_l1l2}=${True}     # Capture L1L2 is stopped by default

    Run Keyword If    ${action_l1l2}    Run Keywords    Capture Stop    capture=${capture_l1l2}
    ...    AND                                  Dated Log           capture_l1l2= ${capture_l1l2}
    Run Keyword If    ${action_core}            Capture Stop    capture=${capture_core}
    Run Keyword If    ${action_cprt}            Capture Stop    capture=${capture_cprt}

# --------------------------------------------------------------------------------------------------------------------------------------------------


Update Subcellid 7103
    [Documentation]
    ...     Conditions:
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${listCrit}    ${pcap_path}    ${firstcell}    ${secondcell}

    ${listPhycells}=        Create List      50     51    52    53    55    56    57
#    ${dicPhycells}=        Create Dictionary      first=50     second=51    third=52    fourth=53    fifth=55    sixth=56    seventh=57

    #Build csv file for cprt filtered
    set test variable                 ${filteredFile}           cprtsetupFiltered.csv
    set test variable                 ${csvPath}      ${LOG_PATH}/${filteredFile}

    ${cmd_mcshark}      Catenate    tshark -r
    ...                 ${pcap_path}
    ...                 -T fields -Y "ulcell_setupreq" -e _ws.col.Info
    ...                 -e 3gpp.subcellid
    ...                 -e UlCell_SetupReq_t.physCellId
    ...                 -E header=y -E separator=';' > ${csvPath}
    Run                 ${cmd_mcshark}

    Run      command=sed -i -e 's/ //g' ${csvPath}

    ${subcells}              getSubcellCsv    csvPathName=${csvPath}    phycells=${listPhycells}

    ${idfirst}    Evaluate    ${firstcell} - 1
    ${idsecond}    Evaluate    ${secondcell} - 1

    FOR    ${dic}    IN      @{listCrit}
        ${dic.subcell_id}    Run Keyword If    ${dic.subcell_id} == ${idfirst}
        ...    Set Variable    ${subcells[${idfirst}]}
        ...    ELSE IF    ${dic.subcell_id} == ${idsecond}
        ...    Set Variable    ${subcells[${idsecond}]}
        Dated Log     ===> nrcell_id = ${dic.subcell_id}
    END

    ${listSubcellsTest}          Create List            ${subcells[${idfirst}]}    ${subcells[${idsecond}]}

    [Return]    ${listSubcellsTest}

