# --------------------------------------------------------------------------------------------------------------------------------------------------
# TTI Traces #
Start TTI Logs
    [Arguments]             ${listCell}=${EMPTY}
    Dated Log                                   ===> configuration and get TTI is started
    # TTI capture configuration
    ${TTIdir}=                                  Get TTI Trace Path
    # Run Keyword If          '${listCell}' != '${EMPTY}'
    Start TTI Traces in Streaming mode    cell_distid=${listCell}    src_ip=10.0.1.2
    #...    ELSE             Start TTI Traces in Streaming mode    src_ip=10.0.1.2
    Set Suite Variable                          ${TTIdir}

    ${capture_core}=    Run Keyword If    ${isAic}
    ...                                         Capture CORE Set Upon Config    airscale=${GNB_CU}
    ...                            ELSE         Capture CORE Set Upon Config    airscale=${GNB_DU}


Get Cell DN To Test
    [Arguments]             ${cell}=2

    @{cellIdList}                 Create List
    @{cellsNr}                    OAM Get Cells Nr    oam=${GNB_DU.oam}
    FOR    ${currentCell}    IN    @{cellsNr}
           Dated Log     contenu de cellsNr ${currentCell['id']['internal']}
           Append to List                ${cellIdList}     ${currentCell['id']['internal']}
    END
    ${cellDnToChange}    Set Variable    "${cellsNr[0]['id']['internal']}"

    ${cellDnRad}        getcelldnrad    ${cellsNr[0]['id']['internal']}
    # ${cellDnSplit}    ${cellDnToChange}.rsplit("-",1)
    Dated Log     CellDnRad ${cellDnRad}
    ${cellDnToTest}    Set Variable    ${cellDnRad}-${cell}
    Dated Log     CellDnToTest ${cellDnToTest}

    #${cellDnToChange}    Set Variable    ${cellsNr[0]['id']['internal']}
    #Dated Log     CellDnToChange ${cellDnToChange}
    #${cellDnToTest}    Substring    ${cellDnToChange}    0    59
    #Dated Log     radical CellDnToTest ${cellDnToChange}

    #${premiers_caracteres}=    Substring    ${ma_chaine}    0    10

    [Return]    ${cellDnToTest}



Stop and Get TTI Logs
    [Arguments]             ${trace_name}=TTI

    Dated Log                                   ===> stop and get TTI Logs is started
    ${TTIpcap}=                                 Stop TTI Traces in Streaming mode    tti_trace_path=${TTIdir}    tti_trace_filename=${trace_name}
    #Dated Log                                   ===> convert TTI to json and csv is started


