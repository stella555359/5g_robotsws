# --------------------------------------------------------------------------------------------------------------------------------------------------
# TC CB007103_D02/TC CB007103_D04

K_CB007103_D
    [Documentation]
    ...     Conditions:     it is based on the arguments ${config_blanking} ${dict_ues} ${is_capture} ${param} ${test_name}
    ...     Actions:        it performs the call setup for multi-ues with traffic on different cells
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues with traffic and PRB blanking are passed
    [Arguments]             ${dict_ues}
    ...                     ${is_capture}
    ...                     ${param}
    ...                     ${test_name}

    Init Sequence                               ${param}
    Dated Log New Line                          ===> test name is ${test_name}
    # Step                                        kwmkt_Create_Test_Suite_Folder
    Run Keyword If    ${SUITE_DEBUG_MODE}       Set Debug Mode

    Set Suite Variable    ${userneed_PM}         ${True}

    # THQ a remettre Restart TL ou laisser dans kw de modif config ???
    # Critical Step                               Restart TL     # THQ A decommenter
    # Restart.Wait Airphone Available
    # OAM wait available    wait_time=300

    # Configure new ue's dynamically
    ${initial_nb_ue}=                           get length    ${dict_ues}
    Run Keyword If    ${initial_nb_ue} < ${param.total_nb_ue}    Configure New Ues    ${dict_ues}
    ...                                                             ${initial_nb_ue}
    ...                                                             ${param.total_nb_ue}
    ...                                                             ${dict_settings_ue_default}
    # Configure the current setting for all the ue's
    ${param.total_nb_ue}=                       get length    ${dict_ues}
    Dated Log New Line                          ===> configure the setting for all the ${param.total_nb_ue} ue's
    @{list_ue}=                                 Create List
    FOR    ${current_id}    IN RANGE    0    ${param.total_nb_ue}
        ${current_ue}=                          Evaluate                ${current_id} + 1
        Dated Log                               current_ue:  ${current_ue}     # THQ pour sanity
        ${current_ue_setting}=                  Copy Dictionary         ${BASIC_UE_SA}
        #id for a sa ue starts at 1 into basic_setup.cfg#
        Set To Dictionary                       ${current_ue_setting}    ue    ${dict_ues[${current_id}].ueid}
        Set To Dictionary                       ${current_ue_setting}    trf_id    1
        Set To Dictionary                       ${current_ue_setting}    pdu    1
        Set To Dictionary                       ${current_ue_setting}    target_gnb    ${param.target_gnb}

        # Dispatching the ue on the requested original cell for the call establishment
        Set To Dictionary                       ${current_ue_setting}    target_cells    ${dict_ues[${current_id}].original_cell}
        # Set the correct requested throughput per ue
        Set To Dictionary                       ${current_ue_setting}    throughput    ${dict_ues[${current_id}].throughput}
        Set To Dictionary                       ${current_ue_setting}    throughput_gbr    ${dict_ues[${current_id}].throughput_gbr}
        Set To Dictionary                       ${current_ue_setting}    throughput_ul    ${dict_ues[${current_id}].throughput_ul}
        Append To List                          ${list_ue}    ${current_ue_setting}
    END
    Dated Log New Line                          ===> ue's list is ${list_ue}
    Check Multi Ues Setting In List             list_multi_ue=${list_ue}
    Traced Sleep                                duration=15s    msg=Wtsemu system start-up to give radio modules time to start up

    # Start traces capture during cell setup
    ${syslog}=                                  SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_cell_setup
    Dated Log                                   GNB_DU.sys[0].M = ${GNB_DU.sys[0].M}

    Run Keywords                               Captures Init
    ...    AND    Step                         Captures Start    action_core=${is_capture.is_capture_core}
    ...                                                          action_cprt=${is_capture.is_capture_cprt}
    ...                                                          action_l1l2=${is_capture.is_capture_l1l2}

    # Setup wtsemu SA for all the ue's
    Step                                        CallSetup.Setup Wtsemu SA    nbUe=${param.total_nb_ue}
    ...                                                             nbCell=${0}
    ...                                                             nbSaUe=${param.total_nb_ue}
    ...                                                             shouldUseLua=${False}
    ...                                                             list_of_UE_tobe_created=${list_ue}
    ...                                                             time_to_wait=10min

    ${syslog_path_cell_setup}                    SYSLOG Stop    syslog=${syslog}
    Dated Log                                   syslog_path_cell_setup:  ${syslog_path_cell_setup}    # THQ pour sanity

    Step                          Captures Stop    action_core=${is_capture.is_capture_core}
    ...                                                  action_cprt=${is_capture.is_capture_cprt}
    ...                                                  action_l1l2=${is_capture.is_capture_l1l2}
    Run    mv ${capture_l1l2.path} ${LOG_PATH}/L1L2_${test_name}_cell_setup.pcap

    # subcells
    ${listSubcellsTest}            Update subcellid 7103    ${param.dod}    ${capture_cprt.path}
    ...                            ${list_ue[0].target_cells}    ${list_ue[1].target_cells}
    Run    mv ${capture_cprt.path} ${LOG_PATH}/CPRT_${test_name}_cell_setup.pcap

    # WA to avoid degradation on cells in SANSA
    # Traced Sleep                                duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    # Step                                        CallSetup.WTS Set X2 Link


    # Start SYSLOG capture during call setup
    ${syslog}=                                  SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_call_setup

    # Start Capture CPRT before call setup
    # Captures Start to avoid exceeded traffic - Capture L1L2 before traffic for verification
    Step                                        Captures Start    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${is_capture.is_capture_cprt}
    ...                                                             action_l1l2=${is_capture.is_capture_l1l2}

    # Capture TTI traces during call setup and traffic
    Start TTI Logs




    # Register and launch PDU for all the ue's

    FOR    ${current_elem}    IN    @{list_ue}
        ${activUE}    Set Variable    ${notCrt} or ${current_elem.ue}==${list_ue[1].ue}
        Run Keyword if    ${activUE}    Run Keywords
        ...    Step                             CallSetup.UE Register    ue=${current_elem.ue}
        ...                                     depends=CallSetup.Setup Wtsemu SA
        ...    AND   Step                       CallSetup.Launch PDU Session    ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         gw=${current_elem.ue}
        ...                                     depends=CallSetup.UE Register
        Run Keyword If    ${current_elem.throughput} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY} and ${activUE}
        ...    Step                             ${param.dir} Traffic Not Stopped    param=${param}    current_ue_setting=${current_elem}
        ...                                     depends=CallSetup.Launch PDU Session
    END

    #Step                                        Stop and Get TTI Logs    trace_name=${test_name}_callTraffic
    ${TTIpcapcallTraffic}    Stop TTI Traces in Streaming mode    tti_trace_path=${TTIdir}
    ...                            tti_trace_filename=${test_name}_callTraffic
    Step                                        Captures Stop    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${is_capture.is_capture_cprt}
    ...                                                             action_l1l2=${is_capture.is_capture_l1l2}
    Run    mv ${capture_l1l2.path} ${LOG_PATH}/L1L2_${test_name}_callTraffic.pcap
    Run    mv ${capture_cprt.path} ${LOG_PATH}/CPRT_${test_name}_callTraffic.pcap
    Step                                        SYSLOG Stop    syslog=${syslog}


    Traced Sleep    duration=10s    msg=stable traffic

    # Start SYSLOG capture for traffic with radio degradation
    ${syslog}=    Run Keyword If    not ${CALL_SETUP_ONLY}    SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_noisePathlossPHR

        ${ptls}                                     Evaluate             120
        # Step                          Captures Init     # THQ a commenter si deja fait
        Step                          Captures Start    action_core=${is_capture.is_capture_core}
        ...                                             action_cprt=${is_capture.is_capture_cprt}
        ...                                             action_l1l2=${is_capture.is_capture_l1l2}
        Step                          wtsemu.ul_cell_noise_testmode_nr    profile_id=2    noise_pusch=-650    noise_pucch=-550
        Step                          Start TTI Logs
        Step                          wtsemu.cell_testmode_set_nr    cell_id=${list_ue[0].target_cells}     gnb=2     testmode=ul_cell_noise
        ...                           profile_id=2     action=activate
        Step                          wtsemu.cell_testmode_set_nr    cell_id=${list_ue[1].target_cells}     gnb=2     testmode=ul_cell_noise
        ...                           profile_id=2     action=activate
        Sleep    2s
        #Step                          Stop and Get TTI Logs    trace_name=${test_name}_Noise
        ${TTIpcapNoise}    Stop TTI Traces in Streaming mode    tti_trace_path=${TTIdir}
        ...                            tti_trace_filename=${test_name}_Noise
        Step                          Captures Stop    action_core=${is_capture.is_capture_core}
        ...                                                  action_cprt=${False}
        ...                                                  action_l1l2=${is_capture.is_capture_l1l2}
        Run    mv ${capture_l1l2.path} ${LOG_PATH}/L1L2_${test_name}_Noise.pcap

        # THQ CELUI CI ajout pour TTI sur 1 cell => pas utile car besoin TTI sur plusieurs cells
        #${cellDnToTest}               Get Cell DN To Test    cell=${list_ue[1].target_cells}
        #@{listCellDnToTest}           Create List       ${cellDnToTest}
        # Fin THQ ajout pour TTI sur 1 cell

        #@{cellIdList}                 Create List
        #@{cellsNr}                    OAM Get Cells Nr    oam=${GNB_DU.oam}
        #FOR    ${currentCell}    IN    @{cellsNr}
        #       Dated Log     contenu de cellsNr ${currentCell['id']['internal']}
        #       Append to List                ${cellIdList}     ${currentCell['id']['internal']}
        #END

        #@{listCellDnToTest}               Create List       /MRBTS-1/RAT-1/RUNTIME_VIEW-4/MRBTS_R-4/NRBTS_R-1/NRCELL_R-${list_ue[1].target_cells}

        Step                          Captures Start    action_core=${is_capture.is_capture_core}
        ...                                             action_cprt=${False}
        ...                                             action_l1l2=${is_capture.is_capture_l1l2}
        Step                          wtsemu.ul_sinr_testmode_nr    profile_id=1     pathloss=${ptls}
        #Step                          Start TTI Logs    listCell=${listCellDnToTest}    # THQ cas particulier
        ${TTIdir}=                                  Get TTI Trace Path     # THQ Ajout pour cas particulier
        Step                         Start TTI Traces in Streaming mode    filter_bitmap2=0x0    src_ip=10.0.1.2     # THQ reduire taille des TTI
        Run keyword If    ${notCrt}    Step                          wtsemu.ue_testmode_set_nr    id=${list_ue[0].ue}    testmode=ul_sinr
        ...                              action=activate    profile_id=1    scell=${list_ue[0].target_cells}
        Step                          wtsemu.ue_testmode_set_nr    id=${list_ue[1].ue}    testmode=ul_sinr
        ...                              action=activate    profile_id=1    scell=${list_ue[1].target_cells}
        Sleep    2s
        #Step                          Stop and Get TTI Logs    trace_name=${test_name}_NoisePathloss
        ${TTIpcapNoisePathloss}    Stop TTI Traces in Streaming mode    tti_trace_path=${TTIdir}
        ...                            tti_trace_filename=${test_name}_NoisePathloss
        Step                          Captures Stop    action_core=${is_capture.is_capture_core}
        ...                                                  action_cprt=${False}
        ...                                                  action_l1l2=${is_capture.is_capture_l1l2}
        Run    mv ${capture_l1l2.path} ${LOG_PATH}/L1L2_${test_name}_NoisePathloss.pcap

        Step                          Captures Start    action_core=${is_capture.is_capture_core}
        ...                                             action_cprt=${False}
        ...                                             action_l1l2=${is_capture.is_capture_l1l2}
        Step                          wtsemu.phr_override_testmode_nr    profile_id=3    phr_mode=Fixed    phr_start=3    pc_max=23
        Step                          Start TTI Logs
        Run keyword If    ${notCrt}    Step    wtsemu.ue_testmode_set_nr    id=${list_ue[0].ue}    testmode=phr_override
        ...                                    profile_id=3    action=activate
        Step                          wtsemu.ue_testmode_set_nr    id=${list_ue[1].ue}    testmode=phr_override    profile_id=3    action=activate
        Traced Sleep    duration=2s    msg=call with traffic pathloss ${ptls}
        #Step                          Stop and Get TTI Logs    trace_name=${test_name}_NoisePathlossPHR
        Stop TTI Traces in Streaming mode    tti_trace_path=${TTIdir}
        ...                            tti_trace_filename=${test_name}_NoisePathlossPHR
        Step                          Captures Stop    action_core=${is_capture.is_capture_core}
        ...                                                  action_cprt=${is_capture.is_capture_cprt}
        ...                                                  action_l1l2=${is_capture.is_capture_l1l2}
        Run    mv ${capture_l1l2.path} ${LOG_PATH}/L1L2_${test_name}_NoisePathlossPHR.pcap
        Run    mv ${capture_cprt.path} ${LOG_PATH}/CPRT_${test_name}_NoisePathlossPHR.pcap


    # Capture Sherpa during traffic with redio degradation for verification
    ${enable_sherpa}=                           Set Variable        ${SHERPA_TRACE}
        Run Keyword If    ${enable_sherpa} == ${True}    Step    Activate Sherpa
        Sleep    20s
        # Stop Capture Sherpa
        Run Keyword If    ${enable_sherpa} == ${True}    Step    Deactivate Sherpa and Stop Collect
        Run Keyword And Ignore error    Step    Upload and decode sherpa pcap files    Sherpa_logs_local_path=${LOG_PATH}    duration=0



    # Stop syslog and check counters
    Run Keyword If    not ${CALL_SETUP_ONLY}    Step    SYSLOG Stop    syslog=${syslog}

    Flush Egate Console Buffer    time_to_wait=2s


    Set Suite Variable            ${logsDir}    ${LOG_PATH}    # THQ fait dans kwmkt_Create_Test_Suite_Folder
    ${Pmdod} =	                  Run Keyword And Return Status    kwmkt_PM_general
    Dated log                     PM: ${PMdod}
    Append to List                ${DODlist}    ${PMdod}

    Step                          Captures Start    action_core=${is_capture.is_capture_core}
    ...                                             action_cprt=${is_capture.is_capture_cprt}
    ...                                             action_l1l2=${is_capture.is_capture_l1l2}
    Step                          Start TTI Logs
    Run keyword If    ${notCrt}    Run Keywords
    ...    Step                   wtsemu.ue_testmode_set_nr    id=${list_ue[0].ue}    testmode=phr_override
    ...                                    profile_id=3    action=deactivate
    ...    AND    Step            wtsemu.ue_testmode_set_nr    id=${list_ue[0].ue}    testmode=ul_sinr
    ...                              action=deactivate    profile_id=1    scell=${list_ue[0].target_cells}
    Step                          wtsemu.ue_testmode_set_nr    id=${list_ue[1].ue}    testmode=phr_override    profile_id=3    action=deactivate
    Step                          wtsemu.cell_testmode_set_nr    cell_id=${list_ue[0].target_cells}     gnb=2     testmode=ul_cell_noise
    ...                           profile_id=2     action=deactivate
    Step                          wtsemu.cell_testmode_set_nr    cell_id=${list_ue[1].target_cells}     gnb=2     testmode=ul_cell_noise
    ...                           profile_id=2     action=deactivate
    #Step                          wtsemu.ue_testmode_set_nr    id=${list_ue[0].ue}    testmode=ul_sinr
    #...                              action=deactivate    profile_id=1    scell=${list_ue[0].target_cells}
    Step                          wtsemu.ue_testmode_set_nr    id=${list_ue[1].ue}    testmode=ul_sinr
    ...                              action=deactivate    profile_id=1    scell=${list_ue[1].target_cells}
    Sleep    2s
    FOR    ${current_elem}    IN    @{list_ue}
        ${activUE}    Set Variable    ${notCrt} or ${current_elem.ue}==${list_ue[1].ue}
        Run Keyword if    ${activUE}
        ...    Step                                    CallSetup.UE Deregister    id=${current_elem.ue}
        ...                                                         ue_deregister_type=switch_off
        ...                                                         by=ue
        ...                                     depends=CallSetup.UE Register
    END
    Sleep    1s

    Stop TTI Traces in Streaming mode    tti_trace_path=${TTIdir}    tti_trace_filename=${test_name}_TPOFFDereg
    #Step                          Stop and Get TTI Logs    trace_name=${test_name}_TPOFFDereg
    Step                          Captures Stop    action_core=${is_capture.is_capture_core}
    ...                                                  action_cprt=${is_capture.is_capture_cprt}
    ...                                                  action_l1l2=${is_capture.is_capture_l1l2}


    Run    mv ${capture_l1l2.path} ${LOG_PATH}/L1L2_${test_name}_TPOFFDereg.pcap
    Run    mv ${capture_cprt.path} ${LOG_PATH}/CPRT_${test_name}_TPOFFDereg.pcap


    Flush Egate Console Buffer    time_to_wait=2s


    #L1L2 check
    ${pcappa}    Set Variable    ${LOG_PATH}/L1L2_${test_name}_NoisePathlossPHR.pcap
    pcap2csv                        PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
# /!\  elemRank help to choose info when tshark result return several information elemRank=0 => first elem of the list
    #${resSub0}                      Check_in_pcap            PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
    #...                                                      SbcId=0          elemRank=0
    #                                                                     #on WireShark in case of multiple ue, all information are in the same item
    #                                                                     #so we need to specify the range of the item to check [0] is item 1 so UE1
    #                                                                     #If we focus on UE_id=2 the range may be [3] for UE2 depending to csv file

    ${resSub}                       Check_in_pcap           PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
    ...                                                      SbcId=${listSubcellsTest[1]}          elemRank=0
    #on WireShark in case of multiple ue, all information are in the same item
                                                                         #so we need to specify the range of the item to check [0] is item 1 so UE1
                                                                         #If we focus on UE_id=2 the range may be [3] for UE2 depending to csv file

    # Dated log    dod global vision: PM:${pcappa}
    #Dated log    dod global vision: resSub0:${resSub0}
    Dated log    dod global vision: resSub1:${resSub}
    Append to List                  ${DODlist}    ${resSub}          # ${resSub0}    ${resSub1}




    # THQ ANCIEN Decode TTI
    # Dated Log            ===> convert TTI to json and csv is started
    #${TTIjson}=    Convert TTI trace from pcap to others    input_file_path=${TTIpcapNoisePathloss}
    #${TTIcsv}=       decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=100000   #10000
    #Dated Log        TTIcsv:  ${TTIcsv}     # THQ pour sanity
    #Set Suite Variable                          ${TTIjson}
    # THQ FIN ANCIEN Decode TTI


    #Build TTI excelCSV    compfilename=${test_name}_NoisePathloss   inputpath=${TTIdir}    event_nr_max=100000    # THQ CELUI-CI
    #THQ  fichier resultat = ${test_name}_NoisePathloss_dl_and_ul.csv dans ${TTIdir}

    #${TTIcsv}=    Build TTI excelCSVAL    compfilename=${test_name}_NoisePathloss   inputpath=${TTIdir}    event_nr_max=100000
    #THQ  fichier resultat = ${test_name}_NoisePathloss_dl.csv dans ${TTIdir}
    #THQ  fichier resultat = ${test_name}_NoisePathloss_ul.csv dans ${TTIdir}

    #${TTIcsv}=    Build TTI legacyCSV    compfilename=${test_name}_NoisePathloss   inputpath=${TTIdir}    event_nr_max=100000
    # THQ  fichier resultat = ${test_name}_NoisePathloss.dl.csv dans ${TTIdir}
    # THQ  fichier resultat = ${test_name}_NoisePathloss.ul.csv dans ${TTIdir}
    # THQ  fichier resultat = ${test_name}_NoisePathloss.dlAndul.csv dans ${TTIdir}



    #${test_name}_NoisePathlossDec=     decode_tti_traces_using_TtitraceReaderEvtDec            desired_storage_directory=${TTIdir}
    #...                               desired_file_name=${test_name}_NoisePathloss            num_of_events=100000   #10000
    #Dated log    Convert TTI trace from pcap to excelCsv
    #Run keyword and continue on failure     ttitrace.Convert TTI trace from pcap to excelCsv
    #...        input_file_path=${test_name}_NoisePathlossDec    output_file_path=${test_name}_NoisePathlossDec_dl_and_ul.csv



    # Deactivate the testmodes
    #Step                          wtsemu.ue_testmode_set_nr    id=${list_ue[1].ue}    testmode=phr_override    profile_id=3    action=deactivate
    #Traced Sleep    duration=6s    msg=call with traffic pathloss ${ptls}
    #Step                          wtsemu.ue_testmode_set_nr    id=${list_ue[1].ue}    testmode=ul_sinr
    #...                              action=deactivate    profile_id=2    scell=${list_ue[1].target_cells}
    #Step                          wtsemu.cell_testmode_set_nr    cell_id=${list_ue[1].target_cells}     gnb=2     testmode=ul_cell_noise
    #...                           profile_id=1     action=deactivate

    # Deregister all the ue's
    #Step                                        Traced Sleep    duration=3s    msg=deregistering    depends=CallSetup.UE Register
    #Step                                        CallSetup.UE Deregister    id=${list_ue[1].ue}
    #...                                                         ue_deregister_type=switch_off
    #...                                                         by=ue
    #...                                         depends=CallSetup.UE Register



    ${indx}    Evaluate    ${list_ue[1].target_cells} - 1
    ${physCellToCheck}    Set Variable    ${TDD_Cell_list[${indx}].physCellId}
    Dated Log    physCellToCheck = ${physCellToCheck}


    # ex nom fichier ${LOG_PATH}/TTITraces/${test_name}_NoisePathloss.csv
    # THQ appel ds cas excelCSV de Valentin Hirzel fichier resultat = ${test_name}_NoisePathloss_dl_and_ul.csv dans ${TTIdir}   # THQ CELUI-CI
    #${first_pair}  ${last_pair}    find_sfn_slot_pairs_ForAValue_WOrnti    file_path=${TTIdir}/${test_name}_NoisePathloss_dl_and_ul.csv
    #...                            search_value=UL_00_FORCE    physCellId=${physCellToCheck}


    # THQ appel ds cas excelCSVAL (AL pour Alina) : 1 fichier dl et 1 fichier ul séparés
    #${first_pair}  ${last_pair}    find_sfn_slot_pairs_ForAValue_WOrnti    file_path=${TTIdir}/${test_name}_NoisePathloss_ul.csv
    #...                            search_value=UL_00_FORCE    physCellId=${physCellToCheck}


    # THQ appel ds cas legacyCSVAL (AL pour Alina) : 1 fichier dl et 1 fichier ul séparés et 1 fichiher TC_CB007103_D04_NoisePathloss.dlAndUl.csv
    #${first_pair}  ${last_pair}    find_sfn_slot_pairs_ForAValue_WOrnti    file_path=${TTIdir}/${test_name}_NoisePathloss.ul.csv
    #...                            search_value=UL_00_FORCE    physCellId=${physCellToCheck}

    #${first_pair}  ${last_pair}    find_sfn_slot_pairs_ForAValue_WOrnti    file_path= ${TTIcsv}    # THQ A REMETTRE
    #...                            search_value=UL_00_FORCE    physCellId=${physCellToCheck}


    ${sfnMarg}    Evaluate    ${param.sfnMarg} + 0
    ${sfnSlot}    Evaluate    ${param.slotMarg} + 0
    #${new_pair}    shift_sfn_slot_pair    pair=${first_pair}    sfnMarg=${sfnMarg}    slotMarg=${sfnSlot}    # THQ A REMETTRE
#
    #Dated Log    first_pair = ${first_pair}
    #Dated Log    new_pair = ${new_pair}
    #Dated Log    Last_pair = ${last_pair}

    # THQ appel ds cas excelCSV de Valentin Hirzel : 1 fichier dl et 1 fichier ul mélangés    # THQ CELUI-CI
    #${status}                      check_DL_10_or_DL_11_between_pairs    file_path=${TTIdir}/${test_name}_NoisePathloss_dl_and_ul.csv
    #...                                                                  start_pair=${new_pair}
    #...                                                                  end_pair=${last_pair}
    #...                                                                  physCellId=${physCellToCheck}

    # THQ appel ds cas excelCSVAL (AL pour Alina): 1 fichier dl et 1 fichier ul séparés
    #${status}                      check_DL_10_or_DL_11_between_pairs    file_path=${TTIdir}/${test_name}_NoisePathloss_dl.csv
    #...                                                                  start_pair=${new_pair}
    #...                                                                  end_pair=${last_pair}
    #...                                                                  physCellId=${physCellToCheck}

    # THQ appel ds cas legacyCSVAL (AL pour Alina): 1 fichier dl et 1 fichier ul séparés et 1 fichiher TC_CB007103_D04_NoisePathloss.dlAndUl.csv
    #${status}                      check_DL_10_or_DL_11_between_pairs    file_path=${test_name}_NoisePathloss.dl.csv
    #...                                                                  start_pair=${new_pair}
    #...                                                                  end_pair=${last_pair}
    #...                                                                  physCellId=${physCellToCheck}

    #Dated Log                      status:${status}

    Dated log                                           DOD_7103: DodIsSet:${DodIsSet} res:${DODlist}
    Run Keyword If                  ${DodIsSet}         kwmkt_Check_For_False_In_${NL}    ${DODlist}


    [Teardown]      Display diagnosis    # THQ a decommenter
