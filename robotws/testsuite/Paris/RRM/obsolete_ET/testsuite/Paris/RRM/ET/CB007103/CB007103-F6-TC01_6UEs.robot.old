*** Settings ***
Documentation      [SUITE PURPOSE]  Test based on Template of Test cases CB007103 feature
...                Test Case Scenario author   : anne.enyih@nokia.com
...                Test Case Scenario author   : francois.tourlonnias@nokia.com
...                Test Case IWK 8662 Adaptative Retransmission : martial.hummel@nokia.com - marie-Laurence.le_borgne@nokia.com
...                This Template need your attention on following part of this common database
...                Please modify as you need data value between # Modification block / # END Modification block

Resource           ./resources/robot/CB007103_keywords_common.robot
Variables          ./resources/python/Constants.py

Suite Setup        CB007103_keywords_common.Suite Setup 7103
Suite Teardown     CB007103_keywords_common.Suite Teardown 7103
Test Teardown      kwmkt_Test Teardown

*** Variables ***
${recursion_limit}   1000   # 1000 is the default value
${NL}                Nested_List


${expected_PuschDmrsSeqType_cell1}    0    # either 0/TYPE_1 or 1/TYPE_2
${expected_PuschDmrsSeqType_cell2}    1    # either 0/TYPE_1 or 1/TYPE_2

&{F6_TC06}
...     Scfdetails=${ScfComposition}
...     Feat7103niddSpecific=${FeatureParameterSheet}
...     ListOfUeEngaged=${uelist}
...     rad_param=${radList}
...     PMdod=testsuite/Paris/RRM/ET/CB007103/resources/config/PM/CB007103_Constraints_F6_TC01.csv
...     GetTtiTraceTime=2
...     dod=${AcceptanceCriteriaL1L2}

# Modification block ==================================================================================================
# Cells important for the test check SIB arrival only on following cell

${KeepConfig}    ${True}   # This setting will help you in case you use the script only for configuration purpose / or stay on last config known
@{CellList}      1    2

# SCF delivery  ====== This part help to dertemine how iso level need to be done ======================================
&{ScfComposition}
...     BeamForming=True
...     ULCloseLoopPowerControl=True
...     UlDftSOfdm=True

#SCF parameters of the test ===========================================================================================
@{FeatureParameterSheet}
...         ${actRel16DmrsForPucchF3_C1}     ${actRel16DmrsForPusch_C1}    ${pucchF3Rel16Pi2BpskAlwaysOn_C1}    ${pucchF3ModulationScheme_C1}
...         ${actAdaptiveReTxResMcs_C1}           ${minPctResourceReservedMcsDl_C1}
...         ${minPctResourceReservedMcsUl_C1}     ${targetPctResourceReservedMcsDl_C1}     ${targetPctResourceReservedMcsUl_C1}
...         ${ulTransPrecodeOnSinrThresh_C1}      ${ulTransPrecodeOffSinrThresh_C1}
...         ${miNrUlSignalQuality2}               ${flexibleCAMode}        ${targetSinr}                        ${tIntervalSinrUpd}
...         ${miNrResourceUtilizationPerCell}     ${miNrUlHarqOne}
...         ${actRel16DmrsForPucchF3_C2}     ${actRel16DmrsForPusch_C2}    ${pucchF3Rel16Pi2BpskAlwaysOn_C2}    ${pucchF3ModulationScheme_C2}
...         ${actAdaptiveReTxResMcs_C2}           ${minPctResourceReservedMcsDl_C2}
...         ${minPctResourceReservedMcsUl_C2}     ${targetPctResourceReservedMcsDl_C2}     ${targetPctResourceReservedMcsUl_C2}
...         ${ulTransPrecodeOnSinrThresh_C2}      ${ulTransPrecodeOffSinrThresh_C2}

&{miNrUlSignalQuality2}                 dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1               param=miNrUlSignalQuality2               value=5min
&{miNrResourceUtilizationPerCell}       dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1               param=miNrResourceUtilizationPerCell     value=5min
&{miNrUlHarqOne}                        dist_name=MRBTS-1/NRBTS-1/NRPMRNL-1               param=miNrUlHarqOne                      value=5min
&{flexibleCAMode}                       dist_name=MRBTS-1/NRBTS-1/NRDU-1                  param=flexibleCAMode                     value=BasicCAMode
&{targetSinr}                           dist_name=MRBTS-1/NRBTS-1/NRULCLPC_PROFILE-0      param=targetSinr                         value=19
&{tIntervalSinrUpd}                     dist_name=MRBTS-1/NRBTS-1/NRULCLPC_PROFILE-0      param=tIntervalSinrUpd                   value=10
&{actRel16DmrsForPucchF3_C1}            dist_name=MRBTS-1/NRBTS-1/NRCELL-1                param=actRel16DmrsForPucchF3             value=false
&{actRel16DmrsForPusch_C1}              dist_name=MRBTS-1/NRBTS-1/NRCELL-1                param=actRel16DmrsForPusch               value=false
&{pucchF3Rel16Pi2BpskAlwaysOn_C1}       dist_name=MRBTS-1/NRBTS-1/NRCELL-1                param=pucchF3Rel16Pi2BpskAlwaysOn        value=false
&{pucchF3ModulationScheme_C1}           dist_name=MRBTS-1/NRBTS-1/NRCELL-1                param=pucchF3ModulationScheme            value=qpsk_4psk
&{actAdaptiveReTxResMcs_C1}             dist_name=MRBTS-1/NRBTS-1/NRCELL-1                param=actAdaptiveReTxResMcs              value=true
&{minPctResourceReservedMcsDl_C1}       dist_name=MRBTS-1/NRBTS-1/NRCELL-1                param=minPctResourceReservedMcsDl        value=50
&{minPctResourceReservedMcsUl_C1}       dist_name=MRBTS-1/NRBTS-1/NRCELL-1                param=minPctResourceReservedMcsUl        value=50
&{targetPctResourceReservedMcsDl_C1}    dist_name=MRBTS-1/NRBTS-1/NRCELL-1                param=targetPctResourceReservedMcsDl     value=75
&{targetPctResourceReservedMcsUl_C1}    dist_name=MRBTS-1/NRBTS-1/NRCELL-1                param=targetPctResourceReservedMcsUl     value=75
&{ulTransPrecodeOnSinrThresh_C1}        dist_name=MRBTS-1/NRBTS-1/NRCELL-1                param=ulTransPrecodeOnSinrThresh         value=140
&{ulTransPrecodeOffSinrThresh_C1}       dist_name=MRBTS-1/NRBTS-1/NRCELL-1                param=ulTransPrecodeOffSinrThresh        value=170
&{actRel16DmrsForPucchF3_C2}            dist_name=MRBTS-1/NRBTS-1/NRCELL-2                param=actRel16DmrsForPucchF3             value=true
&{actRel16DmrsForPusch_C2}              dist_name=MRBTS-1/NRBTS-1/NRCELL-2                param=actRel16DmrsForPusch               value=true
&{pucchF3Rel16Pi2BpskAlwaysOn_C2}       dist_name=MRBTS-1/NRBTS-1/NRCELL-2                param=pucchF3Rel16Pi2BpskAlwaysOn        value=false
&{pucchF3ModulationScheme_C2}           dist_name=MRBTS-1/NRBTS-1/NRCELL-2                param=pucchF3ModulationScheme            value=qpsk_4psk
&{actAdaptiveReTxResMcs_C2}             dist_name=MRBTS-1/NRBTS-1/NRCELL-2                param=actAdaptiveReTxResMcs              value=true
&{minPctResourceReservedMcsDl_C2}       dist_name=MRBTS-1/NRBTS-1/NRCELL-2                param=minPctResourceReservedMcsDl        value=50
&{minPctResourceReservedMcsUl_C2}       dist_name=MRBTS-1/NRBTS-1/NRCELL-2                param=minPctResourceReservedMcsUl        value=50
&{targetPctResourceReservedMcsDl_C2}    dist_name=MRBTS-1/NRBTS-1/NRCELL-2                param=targetPctResourceReservedMcsDl     value=75
&{targetPctResourceReservedMcsUl_C2}    dist_name=MRBTS-1/NRBTS-1/NRCELL-2                param=targetPctResourceReservedMcsUl     value=75
&{ulTransPrecodeOnSinrThresh_C2}        dist_name=MRBTS-1/NRBTS-1/NRCELL-2                param=ulTransPrecodeOnSinrThresh         value=140
&{ulTransPrecodeOffSinrThresh_C2}       dist_name=MRBTS-1/NRBTS-1/NRCELL-2                param=ulTransPrecodeOffSinrThresh        value=170

# END SCF parameters of the test ======================================================================================

#swconfig Rad Parameters

#@{radList}    ${radDic_580832}     ${radDic_580833}    ${radDic_58082F}    ${radDic_580376}    ${radDic_580377}
#...           ${radDic_580831}     ${radDic_580830}    ${radDic_58057A}    ${radDic_58057D}    ${radDic_4B000F}
#...           ${radDic_580650}     ${radDic_580010}    ${radDic_5806BA}

@{radList}    ${radDic_58082F}    ${radDic_580376}    ${radDic_580377}
...           ${radDic_58057A}    ${radDic_58057D}    ${radDic_4B000F}
...           ${radDic_580650}    ${radDic_580010}    ${radDic_5806BA}

#&{radDic_580832}     field=0x580832    value=100          #${EMPTY}     #rdUlTransPrecodeOnSinrThreshR16DmrsOffset
#&{radDic_580833}     field=0x580833    value=100          #${EMPTY}     #rdUlTransPrecodeOffSinrThreshR16DmrsOffset
&{radDic_58082F}     field=0x58082F    value=30           #${EMPTY}     #rdPmaxBoost
&{radDic_580376}     field=0x580376    value=5            #${EMPTY}     #rdTransPrecodeHystThresh
&{radDic_580377}     field=0x580377    value=2            #${EMPTY}     #rdTransPrecodeBufferThresh
#&{radDic_580831}     field=0x580831    value=100          #${EMPTY}     #rdUlRank2to1ThreshR16DmrsOffset
#&{radDic_580830}     field=0x580830    value=100          #${EMPTY}     #rdUlRank1to2ThreshR16DmrsOffset
&{radDic_58057A}     field=0x58057A    value=${EMPTY}     #rdFeatureFlagBitmapLevel
&{radDic_58057D}     field=0x58057D    value=${EMPTY}     #rdFeatureFlagBitmap2
&{radDic_4B000F}     field=0x4B000F    value=1            # RF_SW_Version_check_disabled
&{radDic_580650}     field=0x580650    value=130          #rdMaxCrReTransmissionUL
&{radDic_580010}     field=0x580010    value=1            #rdSupportedUlMCS
&{radDic_5806BA}     field=0x5806BA    value=0            #rdEnableAdaptiveReTxBpskWa

#UE corner
&{UE_1_SA_TDD_UE_R15_PC3}
...     ueid=1
...     ue_nr_capabilities=${SA_TDD_UE_R15_PC3}
...     ue_release=${EMPTY}    #${EMPTY} => basic already tuned correctly
...     Target_cell=1          #${EMPTY} => basic already tuned correctly


&{UE_2_SA_TDD_UE_R15_PC3}
...     ueid=2
...     ue_nr_capabilities=${SA_TDD_UE_R15_PC3}
...     ue_release=${EMPTY}    #${EMPTY} => basic already tuned correctly
...     Target_cell=1          #${EMPTY} => basic already tuned correctly

&{UE_3_SA_TDD_UE_R15_PC3}
...     ueid=3
...     ue_nr_capabilities=${SA_TDD_UE_R15_PC3}
...     ue_release=${EMPTY}    #${EMPTY} => basic already tuned correctly
...     Target_cell=1          #${EMPTY} => basic already tuned correctly

&{UE_4_SA_TDD_UE_R16}
...     ueid=4
...     ue_nr_capabilities=${SA_TDD_UE_R16}
...     ue_release=16   #${EMPTY} => basic already tuned correctly
...     Target_cell=2   #${EMPTY} => basic already tuned correctly

&{UE_5_SA_TDD_UE_R16}
...     ueid=5
...     ue_nr_capabilities=${SA_TDD_UE_R16}
...     ue_release=16   #${EMPTY} => basic already tuned correctly
...     Target_cell=2   #${EMPTY} => basic already tuned correctly

&{UE_6_SA_TDD_UE_R16}
...     ueid=6
...     ue_nr_capabilities=${SA_TDD_UE_R16}
...     ue_release=16   #${EMPTY} => basic already tuned correctly
...     Target_cell=2   #${EMPTY} => basic already tuned correctly

@{uelist}    ${UE_1_SA_TDD_UE_R15_PC3}     ${UE_2_SA_TDD_UE_R15_PC3}     ${UE_3_SA_TDD_UE_R15_PC3}
...          ${UE_4_SA_TDD_UE_R16}         ${UE_5_SA_TDD_UE_R16}         ${UE_6_SA_TDD_UE_R16}

#DOD Corner
@{DODlist}      # list empty for now will contain all DOD corner

#DOD Corner L1L2
# Focusing on Cell 1 for MULTI UE setup
@{AcceptanceCriteriaL1L2}    ${AC1_1}    ${AC2_1}    ${AC3_1}    ${AC4_1}    ${AC5_1}    ${AC7_1}    ${AC8_1}
...                          ${AC1_0}    ${AC3_0}    ${AC7_0}    ${AC8_0}
...                          ${F6_0_0}    ${F6_0_1}    ${F6_1_1}


# Trace Type | subcell_id | Message in Trace (Filter) | IE description | Requested Value
# Note: subcell_id0=Cell1

# Case 1 UE for 7103-A:
# UE DMRS_SEQ_TYPE_1 or DMRS_SEQ_TYPE_2 for 7103-A on subcell_id=1:

&{AC1_1}     PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.puschTransformPrecoderFlag
...          value=1             dodtype=DisplayAverage    PercentTol=20
# If UlData_puschReceiveReqGrant_t.puschTransformPrecoderFlag<> 1/enabled  Then KO else OK
# Case one occurrence <> 1 then KO

&{AC2_1}     PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.mcs
...          value=Display             dodtype=PercentOfEachCase    PercentTol=20
# If UlData_puschReceiveReqGrant_t.mcs<>0 or 1          Then KO else OK
# Case one occurrence > 1 then KO

&{AC3_1}     PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.dmrsSequenceType
...          value=${expected_PuschDmrsSeqType_cell2}  dodtype=DisplayAverage    PercentTol=20
# Variable "expected_PuschDmrsSeqType" : either 0/TYPE_1 or 1/TYPE_2
# If UlData_puschReceiveReqGrant_t.dmrsSequenceType <> expected_PuschDmrsSeqType     Then KO else OK
# Case one occurrence <> expected_PuschDmrsSeqType then KO

&{AC4_1}     PcapType=L1L2        subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.modulationOrder
...          value=1              dodtype=DisplayAverage    PercentTol=20
# If UlData_puschReceiveReqGrant_t.modulationOrder<>1/Order1              Then KO else OK
# Case one occurrence <> 1 then KO

&{AC5_1}     PcapType=L1L2        subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.mcsTable
...          value=0              dodtype=DisplayAverage    PercentTol=20
# If UlData_puschReceiveReqGrant_t.mcsTable<>0/max64QAM                   Then KO else OK
# Case one occurrence <> 0 then KO

&{AC7_1}     PcapType=L1L2        subcell_id=1     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.crc
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- CRC OK/0 or CRC KO/1
# Count nb of  "UlData_UePuschReceiveRespHarqU_t.crc" occurrences
# Count nb of UlData_UePuschReceiveRespHarqU_t.crc=NOK/1
# Gives percentSubcellId1PuschCRCKO CRC NOK
# Display ONLY

&{AC8_1}     PcapType=L1L2        subcell_id=1     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.dtx
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- NON_DTX/0 or DTX/1
# Count nb of  "UlData_UePuschReceiveRespHarqU_t.dtx" occurrences
# Count nb of UlData_UePuschReceiveRespHarqU_t.dtx=DTX/1
# Gives percentSubcellId1DTX DTX DTX
# Display ONLY

# Case 2 UES for 7103-A:
# Case 1 UE DMRS_SEQ_TYPE_1 on subcell_id=0 and 1 UE DMRS_SEQ_TYPE_2 on subcell_id=1 for 7103-A:

&{AC1_0}     PcapType=L1L2       subcell_id=0     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.puschTransformPrecoderFlag
...          value=1             dodtype=DisplayAverage    PercentTol=20
# If UlData_puschReceiveReqGrant_t.puschTransformPrecoderFlag<> 1/enabled  Then KO else OK
# Case one occurrence <> 1 then KO

&{AC3_0}     PcapType=L1L2       subcell_id=0     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.dmrsSequenceType
...          value=${expected_PuschDmrsSeqType_cell1}   dodtype=DisplayAverage    PercentTol=20
# Variable "expected_PuschDmrsSeqType" : either 0/TYPE_1 or 1/TYPE_2
# If UlData_puschReceiveReqGrant_t.dmrsSequenceType <> expected_PuschDmrsSeqType     Then KO else OK
# Case one occurrence <> expected_PuschDmrsSeqType then KO

&{AC7_0}     PcapType=L1L2        subcell_id=0     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.crc
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- CRC OK/0 or CRC KO/1
# Count nb of  "UlData_UePuschReceiveRespHarqU_t.crc" occurrences
# Count nb of UlData_UePuschReceiveRespHarqU_t.crc=NOK/1
# Gives percentSubcellId1PuschCRCKO CRC NOK
# Display ONLY
# If percentSubcellId1PuschCRCKO > percentSubcellId0PuschCRCKO                   Then KO else OK

&{AC8_0}     PcapType=L1L2        subcell_id=0     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.dtx
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- NON_DTX/0 or DTX/1
# Count nb of  "UlData_UePuschReceiveRespHarqU_t.dtx" occurrences
# Count nb of UlData_UePuschReceiveRespHarqU_t.dtx=DTX/1
# Gives percentSubcellId1DTX DTX DTX
# Display ONLY


# Used for 7103-F6_IWK_8662 with 6 UES
# Case 6 UES for 7103-F6:
# 3 UES DMRS_SEQ_TYPE_1 on subcell_id=0 and 3 UEs DMRS_SEQ_TYPE_2 on subcell_id=1 for 7103-F6:

&{F6_0_0}    PcapType=L1L2       subcell_id=0     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.mcs
...          value=Display        dodtype=DisplayAverage    PercentTol=20
# MLLB_MH    If UlData_puschReceiveReqGrant_t.mcs= 28       increment count8662subcellId0Mcs28
#            if count8662subcellId0Mcs28 <> 0 then OK else KO and give the number of count8662subcellId0Mcs28
#            Case one occurrence = 28 then OK

&{F6_0_1}    PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.mcs
...          value=Display        dodtype=DisplayAverage    PercentTol=20
# MLLB_MH    If UlData_puschReceiveReqGrant_t.mcs= 28       increment count8662subcellId1Mcs28
#            if count8662subcellId1Mcs28 <> 0 then OK else KO and give the number of count8662subcellId1Mcs28
#            Case one occurrence = 28 then OK

&{F6_1_1}    PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.rvIndex
...          value=Display        dodtype=DisplayAverage    PercentTol=20
# MLLB_MH    If (UlData_puschReceiveReqGrant_t.mcs= 28  AND UlData_puschReceiveReqGrant_t.rvIndex = 0 ) then     KO else OK


# END Modification block ==============================================================================================



*** Test Cases ***

[1]CB007103-F6-TC01_IWK_AdaptRetrans_CB008662
    # [Tags]                      CLOUD_5G_I_MP_AP_LO, SANSA_FS_ECPRI_CMWV_TDD
    # [Tags]                      CLOUD_5G_I_LO_AP_LO, SANSA_FS_CPRI_CMWV_FDD+ECPRI_CMWV_TDD_AEQE

    #Special Need for this test

    Set Suite Variable    ${userneed_PCAP}       ${True}
    Set Suite Variable    ${userneed_TTI}        ${True}
    Set Suite Variable    ${userneed_Btslog}     ${True}
    Set Suite Variable    ${userneed_PM}         ${True}
    Set Suite Variable    ${DodIsSet}            ${True}

    CB007103_mainKW       ${F6_TC06}

*** Keywords ***

CB007103_mainKW
    [Documentation]                 CB007103-Base-
    [Arguments]                     ${param}

    kwmkt_dbg_log                   Global variable list DBGlogs: ${DBGlogs}          ##
    kwmkt_dbg_log                   info we are on KeepConfig: ${KeepConfig}           # these informative line to bypass Robot 5 new sanity :-)
    kwmkt_dbg_log                   info we are on NoSnap: ${NoSnap}                   #
    kwmkt_dbg_log                   info we are on egatelogoutput: ${egatelogoutput}   #
    kwmkt_dbg_log                   info we are on tti: ${tti}                         #
    kwmkt_dbg_log                   info we are on DodIsSet: ${DodIsSet}               #
    kwmkt_dbg_log                   recursion_limit: ${recursion_limit}                #
    kwmkt_dbg_log                   print to be used (sanity RF5 5 )                  ##

    Init Sequence                   ${param}
    Step                            kwmkt_Create_Test_Suite_Folder

    Critical Step                   Set_basic_context
    Critical Step                   Set_RadParameters
    Critical Step                   Set_SCF_ConfigMarket     ${param.Scfdetails}
    Critical Step                   Set_SCF_ofTheTest        ${param.Feat7103niddSpecific}

    Critical Step                   kwmkt_Cell_setup         ${CellList}

    #L3call with 6 UES max UL traffic
    Run Keyword If                  ${userneed_PCAP}         kwmkt_Capture_Start    Attach

    Critical Step                   kwmkt_run_script_once    ${CURDIR}/resources/egCmd/F6/egCmd_F6_attach_PuschSinr_6UEs.sce

    #6 UES move to DTF-S-OFDM
    Critical Step                   kwmkt_run_script_once    ${CURDIR}/resources/egCmd/F6/egCmd_F6_TP_OFF_ON_6UEs.sce

    #BIP L1L2
    Dated log                                                1s L1L2 Bip collection
    kwmkt_Capture_Start                                      Traff
    Sleep    1s     #5ms
    #${pcappa}    kwmkt_Capture_Stop                          Traff
    #kwmkt_Capture_Stop                                       Traff
    ${pcappa}                       kwmkt_Capture_Stop      Traff
    Dated log                       pcap path: ${pcappa}

    #TTI TP ON
    #Run Keyword If                  ${userneed_TTI}          kwmkt_TTI_start    time=${param.GetTtiTraceTime}
    #Run Keyword If                  ${userneed_TTI}          kwmkt_TTI_stop     suffix=TTI_TP_ON_6UEs
    #...                                                                         targpath=${logsDir}/tti

    #PM counters
    ${PMdod} =	                    Run Keyword And Return Status    kwmkt_PM_general
    kwmkt_dbg_log                   ${PMdod}
    Append to List                  ${DODlist}    ${PMdod}
    # testmodes deactivation so UEs move to TP off and then deregister the 6 UEs
    Critical Step                   kwmkt_run_script_once    ${CURDIR}/resources/egCmd/F6/egCmd_F6_TP_ON_OFF_6UEs.sce


    Run Keyword If                  ${userneed_PCAP}         kwmkt_Capture_Stop     Attach

    #L1L2 check
    pcap2csv                        PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
# /!\  elemRank help to choose info when tshark result return several information elemRank=0 => first elem of the list
    ${resSub0}                      Check_in_pcap            PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
    ...                                                      SbcId=0          elemRank=0
                                                                         #on WireShark in case of multiple ue, all information are in the same item
                                                                         #so we need to specify the range of the item to check [0] is item 1 so UE1
                                                                         #If we focus on UE_id=2 the range may be [3] for UE2 depending to csv file

    ${resSub1}                       Check_in_pcap           PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
    ...                                                      SbcId=1          elemRank=0
    #on WireShark in case of multiple ue, all information are in the same item
                                                                         #so we need to specify the range of the item to check [0] is item 1 so UE1
                                                                         #If we focus on UE_id=2 the range may be [3] for UE2 depending to csv file

    # Dated log    dod global vision: PM:${pcappa}
    Dated log    dod global vision: resSub0:${resSub0}
    Dated log    dod global vision: resSub1:${resSub1}
    Append to List                  ${DODlist}    ${resSub0}    ${resSub1}

    Dated log                                           DOD_7103: DodIsSet:${DodIsSet} res:${DODlist}
    Run Keyword If                  ${DodIsSet}         kwmkt_Check_For_False_In_${NL}    ${DODlist}
