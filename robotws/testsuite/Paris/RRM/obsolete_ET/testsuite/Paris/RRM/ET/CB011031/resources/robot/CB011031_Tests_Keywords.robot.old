Resource                            ./CB011031_Keywords.robot
Resource                            ../../../resources/common/TtiTrace/ttitrace.robot


# *** Variables ***

*** Keywords ***

TC_CB011031-SA
    [Documentation]             CB011031 SA Basic Call then traffic, capture traces and analyze
    [Arguments]                 ${params}         ${dict_ues}             ${arfcn_iphy}
    Set Suite Variable          ${params}
    Init Sequence               ${params}

    Step                        Update arfcn and gscn in Basic_Setup and iphy           arfcn_iphy=${arfcn_iphy}
    Step                        Set RAD Params for 11031
    Step                        Set 11031 Context TDD
    Step                        Restart.F1 Wait Link Classical

    ${listOfUes}                Build UEs list SA Multi UEs         dict_ues=${dict_ues}
    Step                        Cell Setup for CB011031             nbCell=${params.nbCell}

    Dated Log New Line          ${trcColor}=== Attach SA UE ${listOfUes[0]} ${defColor}
    Step                        CB011031 Attach SA                  ueSetting=${listOfUes[0]}         CPRTcapture=${True}

    Dated Log New Line          ${trcColor}=== Send UE ${listOfUes[0]} UL DL udp data Traffic ${defColor}
    Critical Step               Start DL Traffic Not Stopped      ueSetting=${listOfUes[0]}         ueTrafficSetting=${dict_ues[0]}
    Critical Step               Start UL Traffic Not Stopped      ueSetting=${listOfUes[0]}         ueTrafficSetting=${dict_ues[0]}

    Step                        Get TTI Logs
    Step                        Get L1L2 Logs
    Step                        Get Snaphot Sos Report
    Sleep                       60s

    Dated Log New Line          ${trcColor}=== Stop UE ${listOfUes[0]} UL DL udp data Traffic ${defColor}
    Step                        Traffic Stop                      ueSetting=${listOfUes[0]}              dir=dl
    Step                        Traffic Stop                      ueSetting=${listOfUes[0]}              dir=ul

    Dated Log New Line          ${trcColor}=== SA DeRegister UE1 ${defColor}
    Step                        UE Deregister

    Dated Log New Line          ${trcColor}=== VERDICT - CHECKS ${defColor}
    Step                        Check SSBlock in L1L2 Logs
    Step                        Check SSBlock and 5GC002534 IWK in L1L2 Logs
    Step                        Check SSBlock and 5GC002538 IWK in L1L2 Logs

    Dated Log New Line          ${trcColor}=== Counters Data volume checks between
    ...                         Cell1 with CB011031 activated and Cell2 with CB011031 deactivated ${defColor}
    FOR    ${current_elem}    IN    @{listOfUes}
        Dated Log New Line          ${trcColor}=== Attach SA UE ${current_elem.ue} on cell ${current_elem.target_cells} ${defColor}
        Step                        CB011031 Attach SA                ueSetting=${current_elem}         CPRTcapture=${True}
        Dated Log New Line          ${trcColor}=== Send UE ${current_elem.ue} UL DL udp data Traffic ${defColor}
        Critical Step               Start DL Traffic Not Stopped      ueSetting=${current_elem}         ueTrafficSetting=${current_elem}
        Critical Step               Start UL Traffic Not Stopped      ueSetting=${current_elem}         ueTrafficSetting=${current_elem}
    END

    Step                        CB011031 get PM files

    FOR    ${current_elem}    IN    @{listOfUes}
        Dated Log New Line          ${trcColor}=== Stop UE ${current_elem.ue} UL DL udp data Traffic ${defColor}
        Step                        Traffic Stop                      ueSetting=${current_elem}              dir=dl
        Step                        Traffic Stop                      ueSetting=${current_elem}              dir=ul
        Dated Log New Line          ${trcColor}=== SA DeRegister UE ${current_elem.ue} ${defColor}
        Step                        UE Deregister                     id=${current_elem.ue}
    END

    Step                        Check CB011031 PM Data volume Counters

    [Teardown]             Display diagnosis


TC_CB011031-SA_master
    [Documentation]             CB011031 SA Basic Call then traffic, capture traces and analyze
    [Arguments]                 ${params}         ${dict_ues}             ${arfcn_iphy}
    Set Suite Variable          ${params}
    Init Sequence               ${params}

    Step                        Update arfcn and gscn in Basic_Setup and iphy           arfcn_iphy=${arfcn_iphy}
    Step                        Set RAD Params for 11031
    Step                        Set 11031 Context TDD
    Step                        Restart.F1 Wait Link Classical

    ${listOfUes}                Build UEs list SA Multi UEs         dict_ues=${dict_ues}
    Step                        Cell Setup for CB011031             nbCell=${params.nbCell}

    Dated Log New Line          ${trcColor}=== Attach SA UE ${listOfUes[0]} ${defColor}
    Step                        CB011031 Attach SA                  ueSetting=${listOfUes[0]}         CPRTcapture=${True}

    Dated Log New Line          ${trcColor}=== Send UE ${listOfUes[0]} UL DL udp data Traffic ${defColor}
    Critical Step               Start DL Traffic Not Stopped      ueSetting=${listOfUes[0]}         ueTrafficSetting=${dict_ues[0]}
    Critical Step               Start UL Traffic Not Stopped      ueSetting=${listOfUes[0]}         ueTrafficSetting=${dict_ues[0]}

    Step                        Get TTI Logs
    Step                        Get L1L2 Logs master
    Step                        Get Snaphot Sos Report
    Sleep                       60s

    Dated Log New Line          ${trcColor}=== Stop UE ${listOfUes[0]} UL DL udp data Traffic ${defColor}
    Step                        Traffic Stop                      ueSetting=${listOfUes[0]}              dir=dl
    Step                        Traffic Stop                      ueSetting=${listOfUes[0]}              dir=ul

    Dated Log New Line          ${trcColor}=== SA DeRegister UE1 ${defColor}
    Step                        UE Deregister

    Dated Log New Line          ${trcColor}=== VERDICT - CHECKS ${defColor}
    Step                        Check SSBlock in L1L2 Logs master
    Step                        Check SSBlock and 5GC002534 IWK in L1L2 Logs master
    Step                        Check SSBlock and 5GC002538 IWK in L1L2 Logs master

    Dated Log New Line          ${trcColor}=== Counters Data volume checks between
    ...                         Cell1 with CB011031 activated and Cell2 with CB011031 deactivated ${defColor}
    FOR    ${current_elem}    IN    @{listOfUes}
        Dated Log New Line          ${trcColor}=== Attach SA UE ${current_elem.ue} on cell ${current_elem.target_cells} ${defColor}
        Step                        CB011031 Attach SA                ueSetting=${current_elem}         CPRTcapture=${True}
        Dated Log New Line          ${trcColor}=== Send UE ${current_elem.ue} UL DL udp data Traffic ${defColor}
        Critical Step               Start DL Traffic Not Stopped      ueSetting=${current_elem}         ueTrafficSetting=${current_elem}
        Critical Step               Start UL Traffic Not Stopped      ueSetting=${current_elem}         ueTrafficSetting=${current_elem}
    END

    Step                        CB011031 get PM files

    FOR    ${current_elem}    IN    @{listOfUes}
        Dated Log New Line          ${trcColor}=== Stop UE ${current_elem.ue} UL DL udp data Traffic ${defColor}
        Step                        Traffic Stop                      ueSetting=${current_elem}              dir=dl
        Step                        Traffic Stop                      ueSetting=${current_elem}              dir=ul
        Dated Log New Line          ${trcColor}=== SA DeRegister UE ${current_elem.ue} ${defColor}
        Step                        UE Deregister                     id=${current_elem.ue}
    END

    Step                        Check CB011031 PM Data volume Counters

    [Teardown]             Display diagnosis