# prepare the test line and set scf param not BW dependant...
TestLine_preparation
    [Tags]    FULL_RUN    15MHZ    1586D
	...       CRT
    [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    ...                       common_Dss_Keywords.Get testcase log directory
    5GC001586_Kw_TestSetup.Test Line Preparation for NSA Only    ${TestDSS15Mhz_1586_M1}
    5GC001586_Kw_TestSetup.Test Line Preparation    ${TestDSS15Mhz_1586_M1}
    5GC001586_Kw_TestSetup.Test Line Preparation for scf    ${TestDSS15Mhz_1586_M1}

[1][1.0] 5GC001586_D_TC_01_5GC001586-D_NSA_Verify_Cell_Setup_updates_SB1_for_15Mhz
    [Tags]    FULL_RUN    FULL_CALL   15MHZ   1586D
	...       CRT
    [Documentation]   Dss CellSetup, 5g Attach, Check ssbpos on l2_cell_group_setupreq, rrcReconf and DL load indication - BW = 15MHZ
    [Setup]    Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    ...                        common_Dss_Keywords.Get testcase log directory    AND
    ...                        5GC001586_Keywords.Clean Up Env                   AND
    ...                        common_Dss_Keywords.Prepare Test Name             AND
    ...                        5GC001586_Keywords.Create Header Csv Test result  AND
    ...                        common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp    AND
    ...                        robot_extension.Run Keyword And Warn On Failure   apUDPlog.Start To Capture Iphy Udplog
    ...                                                                                  target_dir=${testCaseDir}/ap_udpsyslogs
    ${tc_name}    Set variable    TestLine_preparation
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if     '${tc_status}'!='PASS'        run keywords
    ...                          robot_extension.Run Keyword And Warn On Failure   Extract L2-PS/src/sgnl/psCell/CellSetupLogger from Syslogs   AND
    ...                          5GC001586_Kw_TestSetup.Test Line Preparation for NSA Only    ${TestDSS15Mhz_1586_M1}   AND
    ...                          5GC001586_Kw_TestSetup.Test Line Preparation    ${TestDSS15Mhz_1586_M1}    AND
    ...                          5GC001586_Kw_TestSetup.Test Line Preparation for scf    ${TestDSS15Mhz_1586_M1}
    5GC001586_Kw_TestSetup.Test Setup 1586 M    ${TestDSS15Mhz_1586_M1}
    5GC001586_D_keywords.TC Verify_Cell_Setup_updates_SSB_Position        ${TestDSS15Mhz_1586_M1}      alias_TC01_TestDSS15Mhz
    [Teardown]         Run Keywords
    ...        common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
    ...        robot_extension.Run Keyword And Warn On Failure   apUDPlog.Stop Capture Iphy Udplog           AND
    ...        Teardown 1586          alias_TC01_TestDSS15Mhz

