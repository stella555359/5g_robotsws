import csv
import logging
import io

from testsuite.Paris.RRM.ET.CB009915.resources.python.tti_analyzer_framework import pandas_gate
from testsuite.Paris.RRM.ET.CB009915.resources.python.tti_analysis.ue_cell_identification import identify_cells_and_ues


class AutoDict(dict):
    def __missing__(self, k):
        self[k] = AutoDict()
        return self[k]


def check_rnti_bwpid(csv_file, rnti, pattern='dlFdSchedData.ueBwpId'):
    dummy = AutoDict()
    with io.open(csv_file, 'rt', encoding="utf-8") as csvfile:
        csv_reader = csv.DictReader(csvfile, delimiter=';')
        for line in csv_reader:
            # logging.info("line = %s" % line)
            try:
                dummy[line['rnti']].append(int(float(line[pattern])))
            except Exception:
                dummy[line['rnti']] = [int(float(line[pattern]))]
    logging.info("dummy = %s" % dummy)
    Check = True
    for key in rnti:
        # logging.info("rnti key = %s" % key)
        try:
            # logging.info("key1 = %s" % key)
            cellbwp = list(set(dummy.get(key)))
            # logging.info("cellbwp1 = %s" % cellbwp)
            if len(cellbwp) != 1:
                Check = False
            elif cellbwp[0] != int(rnti[key]):
                print("BwpId for rnti:", key, rnti[key], "is not matching with ueBwpId", cellbwp[0])
                Check = False
            elif cellbwp[0] == int(rnti[key]):
                print("BwpId for rnti:", key, rnti[key], "is matching with ueBwpId", cellbwp[0])
        except Exception:
            # logging.info("dummy = %s" % dummy)
            # logging.info("key = %s" % key)
            rntikey = dummy.keys()
            # logging.info("rntikey = %s" % rntikey)
            for i in rntikey:
                # logging.info("i = %s" % i)
                if i == str(65535) or key != int(float(i)):
                    continue
                cellbwp = list(set(dummy.get(i)))
                # logging.info("cellbwp = %s" % cellbwp)
                if len(cellbwp) != 1:
                    Check = False
                elif cellbwp[0] != int(rnti[key]):
                    print("BwpId for rnti:", int(float(i)), rnti[key], "is not matching with ueBwpId", cellbwp[0])
                    Check = False
                elif cellbwp[0] == int(rnti[key]):
                    print("BwpId for rnti:", int(float(i)), "is matching with ueBwpId", cellbwp[0])
    return Check


def load_dataframe(path_to_pickle):
    global pd
    pd = pandas_gate.install_and_import_pandas()
    df = pd.read_pickle(path_to_pickle)
    return df


