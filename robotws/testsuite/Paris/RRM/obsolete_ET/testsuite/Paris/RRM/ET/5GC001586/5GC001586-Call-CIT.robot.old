# prepare the test line
TestLine_preparation
    [Tags]    FULL_RUN    Cellsetup   10MHZ
    ...       CIT
    5GC001586_Kw_TestSetup.Test Line Preparation for NSA Only    ${TestDSS10Mhz_1586_M1}
    5GC001586_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_1586_M1}

TestLine_1586_Test_setup
    [Tags]    FULL_RUN    Cellsetup   FULL_CALL  10MHZ
    ...       CIT
    [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    ...                       common_Dss_Keywords.Get testcase log directory
    5GC001586_Kw_TestSetup.Test Setup 1586 M    ${TestDSS10Mhz_1586_M1}

# TC covered under New feature
# [1]5GC001586_C_TC_20_ Check DSS UL PM counters
# [1]5GC001586_C_TC_21_ Check DSS DL PM counters
[1][1.0] CNI57031_20_5GC001586_C_Check_DSS_DL_And_UL_PM_counters
    [Tags]    FULL_RUN     PMCounters    10MHZ    1586C
	...       CIT
    [Documentation]   M55332C00001, M55332C00002, M55332C00003, M55332C01001, M55332C01002, M55332C01003, M55332C02001, M55332C02002 - BW=10MHZ
    [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    ...       common_Dss_Keywords.Get testcase log directory    AND
    ...       5GC001586_Keywords.Clean Up Env                   AND
    ...       common_Dss_Keywords.Prepare Test Name             AND
    ...       common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp     AND
    ...       depends  TestLine_1586_Test_setup
    ${tc_name}    Set variable    TestLine_preparation
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if     '${tc_status}'!='PASS'        run keywords
    ...           Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0                                AND
    ...           5GC001586_Kw_TestSetup.Test Line Preparation for NSA Only    ${TestDSS10Mhz_1586_M1}   AND
    ...           5GC001586_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_1586_M1}
    ${tc_name}    Set variable    TestLine_1586_Test_setup
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'
    ...           5GC001586_Kw_TestSetup.Test Setup 1586 M    ${TestDSS10Mhz_1586_M1}
    ${TestDSS10Mhz_PMCounters.Context.cellDepType}   set variable     ${TestDSS10Mhz_1586_M1.Context.cellDepType}
    # eNBid = 2 and gNBId = 1 if SANSA
    # BEWARE : ${WITH_UPLOAD_1586_CONFIGURATION} should be 0 in case of cellDepType == SANSA => add warning !!!
    Run Keyword If   '${TestDSS10Mhz_PMCounters.Context.cellDepType}' == 'SA+NSA'
    ...                                        5GC001586_Kw_TestSetup.update eNBId and gNBId In Context  ${TestDSS10Mhz_PMCounters}   2   1
    ${TestDSS10Mhz_PMCounters.scfFile.nrdsslte.eNodeBId}          set variable      ${TestDSS10Mhz_PMCounters.Context.eNBId}
    5GC001586_C_Keywords.TC 1586-C_NSA_Check DSS DL And UL PM counters      ${TestDSS10Mhz_PMCounters}

    [Teardown]       run Keywords       common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
    ...                                 Run Keyword And Ignore Error    Get L1L2 traces       AND
    ...                                 Run Keyword And Ignore Error    Get TTI traces       AND
    ...                                 Teardown 1586          tc_counters


*** Keywords ***
