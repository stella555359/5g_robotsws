# TC covered under New feature
# [1]5GC001586_C_TC_17_5GC001586-C_NSA_Check_dynamic_UL_(outer_&_inner_PRBs)_basic_behaviour
[1][1.0] 5GC001586_C_TC_17_5GC001586-C_NSA_Check_dynamic_UL_outer_and_inner_PRBs_basic_behaviour
    [Tags]    FULL_RUN   UL_TRAFFIC  DL_TRAFFIC   10MHZ     1586C
	...       CIT
    [Documentation]     Check DSS UL & DL Traffic - BW=10MHZ
    # [Setup]     Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    # ...          common_Dss_Keywords.Get testcase log directory    AND
    # ...          5GC001586_Keywords.Clean Up Env                   AND
    # ...          common_Dss_Keywords.Prepare Test Name             AND
    # ...          5GC001586_Keywords.Create Header Csv Test result  AND
    # ...          common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp     AND
    # ...          robot_extension.Run Keyword And Warn On Failure   btslog.Start Btslog     AND
    # ...          robot_extension.Run Keyword And Warn On Failure   apUDPlog.Start To Capture Iphy Udplog
    # ...                                                                    target_dir=${testCaseDir}/ap_udpsyslogs     AND
    # ...          depends  TestLine_preparation
    ${tc_name}    Set variable    TestLine_preparation
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if     '${tc_status}'!='PASS'        run keywords
    ...           5GC001586_Kw_TestSetup.Test Line Preparation for NSA Only    ${TestDSS10Mhz_1586_M1}   AND
    ...           5GC001586_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_1586_M1}                AND
    ...           5GC001586_Kw_TestSetup.Test Setup 1586 M        ${TestDSS10Mhz_1586_M1}
    Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0
    5GC001586_Keywords.TC 1586-CellSetup            ${TestDSS10Mhz_1586_M1}
    5GC001586_Keywords.TC 1586-5gCall               ${TestDSS10Mhz_1586_M1}
    TC 1586-DL_UL_Tput              ${TestDSS10Mhz_1586_M1}
    [Teardown]          Run Keywords
    ...        robot_extension.Run Keyword And Warn On Failure   Extract L2-PS/src/sgnl/psCell/CellSetupLogger from Syslogs    AND
    ...        robot_extension.Run Keyword And Warn On Failure   btslog.Stop Btslog    target_dir=${testCaseDir}  AND
    ...        robot_extension.Run Keyword And Warn On Failure   apUDPlog.Stop Capture Iphy Udplog           AND
    ...        common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
    ...        Teardown 1586      alias=default

Prepare TL for TTITraces
    [Documentation]    :
    ...    This keyword helps to download and install MULTI packages needed for TTITraces
    ...
    nps_ttitraces_tools.install_multidynamic_if_needed

Get L1L2 traces
    [Arguments]     ${time}=1s
    Dated Log         Get L1L2 Bip Traces
    ${CaptureBIP}              Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    ${CaptureBIP.prefix}       set Variable   DL_UL_Tput
    ${CaptureBIP.withTN}       set Variable   True
    # Initialize Capture       ${CaptureBIP}
    Capture init   ${CaptureBIP}
    Capture start  ${CaptureBIP}
    Traced Sleep   ${time}     msg=take BIP L1L2 traces with DL/UL Tput
    Capture stop   ${CaptureBIP}
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureBIP.path}     AND
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${CaptureBIP.path}    ${testCaseDir}

Get TTI traces
    Dated Log         Start TTI Traces in Streaming Mode
    ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traced Sleep    1s      msg=Waiting for TTI Traces
    Dated log         Stop TTI Traces in Streaming Mode...
    ${tti_trace_path}=     ttitrace.Stop TTI Traces in Streaming Mode    tti_trace_path=${testCaseDir}
    Dated log         Decode TTI Traces...
    # nps_ttitraces_tools.decode tti traces     desired_storage_directory=${testCaseDir}    num_of_events=10000
    nps_ttitraces_tools.decode_tti_traces_using_TtitraceReaderEvtDec    desired_storage_directory=${testCaseDir}   num_of_events=10000
    Dated log         Convert TTI trace from pcap to excelCsv...
    Run keyword and continue on failure      ttitrace.Convert TTI trace from pcap to excelCsv     input_file_path=${tti_trace_path}
    ...                                                                                           output_file_path=${testCaseDir}

Check BTS status in WEM for cOAM
    [Documentation]   This keyword is used to Check BTS status in WEM for cOAM.
    ...    author: Ch SAMSON
    [Arguments]     ${cell_id}=0
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=    coam.get_bts_statuses    timeout=30    connection=${GNB_DU.oam.httpAlias}
    Dated log      =======> Current bts status is ${bts_status}
    should Contain Any       ${bts_status['operationalState']}   Enabled   Disabled         ignore_case=true
    should Contain Any       ${bts_status['proceduralState']}    configured    OnAir       msg=ENB is not on air, Current status is ${bts_status}
    ...                                                                                    ignore_case=true
    should be equal    ${bts_status['blockingState']}       Unblocked            ignore_case=true

    ${cell_info}=    coam.get_cells_info    cell_type=nr    timeout=30    connection=${GNB_DU.oam.httpAlias}
    Dated log      =======> Current cell(s) info is ${cell_info}
    FOR    ${elem}    IN    @{cell_info}
#    ${cell_info}=    set variable   ${cell_info[${cell_id}]['status']}
        should Contain Any    ${elem['status']['operationalState']}    Enabled   Disabled    ignore_case=true
        should Contain Any    ${elem['status']['proceduralStatus']}    not initialized   configured   OnAir    ignore_case=true
        Should be equal    ${elem['status']['administrativeState']}    Unlocked    ignore_case=true
    END

    OAM Disconnect                  ${GNB_DU.oam}

Restart TL wo WTS clear
    [Documentation]                 Entry point for the restart of a TL, Classical only , without WTS clear
    [Arguments]                     ${GNBCallback}=None                     ${APCallback}=None
    ...                             ${isOAMRebooted}=False
    Dated Log                       Start Restart TL ${TLConfig.configName}. Is GNB Cloud: ${TLConfig.isGnbCloud}
    ...                             first=True
    Private Restart Gnb Classical           GNBCallback=${GNBCallback}          APCallback=${APCallback}
    ...                             isOAMRebooted=${isOAMRebooted}


reset TL if BTS not OnAir
    [Arguments]  ${connection}=${GNB_DU.oam}
    ${aliasGNB}                     OAM Connect                             ${connection}
    ${bts_status}=  coam.get_bts_statuses   connection=${connection.httpAlias}
    OAM Disconnect                  ${GNB_DU.oam}
    Dated log     BTS procedural state is now: ${bts_status["proceduralState"]}
    ${gnb_status}=     evaluate    '${bts_status["proceduralState"]}'.lower()
    Run Keyword If  '${gnb_status}'!='OnAir'.lower() and '${gnb_status}'!='Configured'.lower()
    ...          Run Keywords       Log To Console  \n BTS procedural state is now: ${bts_status["proceduralState"]} ==> Reset TL     AND
    ...                             Restart TL wo WTS clear     AND
    ...                             run keyword and ignore error        5GC001586_Kw_TestSetup.Upload 1586 Configuration          AND
    ...                             run keyword and ignore error        common_Dss_Keywords.Start WTS        egate_alias_default   AND
    ...                             run keyword and ignore error        common_Dss_command.X2Ap link Setup     egate_alias_default


Get gNB cell 5g On air
    [Documentation]       get gNB 5g cell On air
    Return From Keyword If    "${WAIT_5G_CELL_ONAIR}" == "0"
    common_Dss_Keywords.Log to Console like Next Step     0     Get gNB 5g cell OnAir
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=  coam.get_bts_statuses   connection=${GNB_DU.oam.httpAlias}
    OAM Disconnect                  ${GNB_DU.oam}
    Log To Console  \n BTS procedural state is now: ${bts_status["proceduralState"]}
    ${gnb_status}=     evaluate    '${bts_status["proceduralState"]}'.lower()
    Return From Keyword If    '${gnb_status}'=='OnAir'.lower() or '${gnb_status}'=='Configured'.lower()
    run keyword and ignore error        5GC001586_Kw_TestSetup.Upload 1586 Configuration
    run keyword and ignore error        common_Dss_Keywords.Start WTS        egate_alias_default
    run keyword and ignore error        common_Dss_command.X2Ap link Setup     egate_alias_default
    run keyword and ignore error        wait until keyword succeeds    2min    30s      Check BTS status in WEM for cOAM
    Dated log new line         =======> Restart TL if needed to get Cell Is OnAir/Configured
    run keyword and ignore error        reset TL if BTS not OnAir
    run keyword and ignore error        wait until keyword succeeds    5min    30s      Check BTS status in WEM for cOAM

Print My Constants version
    [Documentation]   Print to Console Constants.py version
    run Keyword    MyConstants.hello

