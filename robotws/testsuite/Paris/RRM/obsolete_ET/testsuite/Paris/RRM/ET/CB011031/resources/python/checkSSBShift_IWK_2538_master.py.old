import csv


def CheckFileIWK2538master(csvPathName):
    """
    """
    iwk2538occurslot1 = 0
    iwk2538occurslot2 = 0
    iwk2538issueslot1occur = 0
    iwk2538issueslot2occur = 0

    ssblocktable = []
    pdsch2534table = []
    csirs2538table = []

    with open(csvPathName) as csvfile:
        reader = csv.DictReader(csvfile, delimiter=';')
        for row in reader:
            if row['_ws.col.info'] == "DlData_SsBlockSendReqL1sw,MIB":
                ssblocktable.append(row)
            if row['_ws.col.info'] == "DlData_PdschPayloadTbSendReqL1sw":
                pdsch2534table.append(row)
            if row['_ws.col.info'] == "DlData_CsiRsSendReqL1sw":
                csirs2538table.append(row)

    # Count the occurrences where SsBlockSendReq is sent on the same SFN that PdschPayloadTbSendReq
    # on subcellid0 and slot1
    for pdsch in pdsch2534table:
        if pdsch['3gpp.subcellid'] == "0" and pdsch['3gpp.slot'] == "1":
            for ssb in ssblocktable:
                if ssb['3gpp.subcellid'] == "0" and ssb['3gpp.slot'] == "1":
                    for csirs in csirs2538table:
                        if csirs['3gpp.subcellid'] == "0" and csirs['3gpp.slot'] == "1":
                            if ssb['3gpp.sfn'] == csirs['3gpp.sfn'] == pdsch['3gpp.sfn']:
                                print('ssb_sfn', ssb['3gpp.sfn'])
                                print('csirs_sfn_slot1', csirs['3gpp.sfn'])
                                iwk2538occurslot1 += 1
                        if csirs['3gpp.subcellid'] == "0" and csirs['3gpp.slot'] == "2" and\
                                csirs['DlData_CsiRsResourceL1sw_t.startSymbol'] == "6,10,13":
                            if ssb['3gpp.sfn'] == csirs['3gpp.sfn'] == pdsch['3gpp.sfn']:
                                print('ssb_sfn', ssb['3gpp.sfn'])
                                print('csirs_sfn_slot2', csirs['3gpp.sfn'])
                                iwk2538occurslot2 += 1

    for csirs in csirs2538table:
        if csirs['3gpp.subcellid'] == "0" and csirs['3gpp.slot'] == "1" and\
                csirs['DlData_CsiRsResourceL1sw_t.startSymbol'] != "6,10":
            iwk2538issueslot1occur += 1

    for csirs in csirs2538table:
        if csirs['3gpp.subcellid'] == "0" and csirs['3gpp.slot'] == "2" and\
                (csirs['DlData_CsiRsResourceL1sw_t.startSymbol'] != "13" and
                    csirs['DlData_CsiRsResourceL1sw_t.startSymbol'] != "6,10,13"):
            print('DlData_CsiRsResourceL1sw_t.startSymbol', csirs['DlData_CsiRsResourceL1sw_t.startSymbol'])
            iwk2538issueslot2occur += 1

    results = {"iwk2538occurslot1": iwk2538occurslot1,
               "iwk2538occurslot2": iwk2538occurslot2,
               "iwk2538issueslot1occur": iwk2538issueslot1occur,
               "iwk2538issueslot2occur": iwk2538issueslot2occur}

    return results
