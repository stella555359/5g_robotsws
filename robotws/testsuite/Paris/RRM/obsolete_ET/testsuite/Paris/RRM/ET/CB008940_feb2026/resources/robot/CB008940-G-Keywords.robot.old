${COL_NAME_SUBPOOLID}                                               SubPoolId
${COL_NAME_NRCELLID}                                                NRCellid
${COL_NAME_NUMPRBALLOC}                                             PrbAllocated
${l1SubPoolStreamPrbCapa_100MHz}                                    1200
# maximum of stream that can be distributed in one subpool when only one cell <=> ${NUM_MAX_PRB_DEFAULT} * 4 = 273 * 4 = 1092
${NUM_MAX_STREAM_WHEN_ONLY_1_CELL}                                  1092
${NUMAllocStreamPrb_L1SP0}                                          2184
${NUMAllocStreamPrb_L1SP1}                                          216
${max_capa}                                                         2400
${index_SP0}                                                        0
${index_SP1}                                                        1

*** Keywords ***

TC 8940 check loadBased Algo with inter L1SP
    [Arguments]            ${param}        ${vendor_custom}
    Init Sequence          ${param}
    Step                   Set RAD Params Of 8940-G
    Critical Step          Deploy Vendor File Config               vendor_param=${vendor_custom}           is_perform_full_commissioning=${True}
    Dated Log New Line     ${vendor_custom}
    Step                   Multi Cells Setup 8940                 argument=${param.nbCell}
    Step                   SA Call DL Traffic With UE Profile      argument=${Profile_UE_1}
    Step                   sleep    2s
    Step                   SA Call DL Traffic With UE Profile      argument=${Profile_UE_2}
    Step                   sleep    2s
    Step                   SA Call DL Traffic With UE Profile      argument=${Profile_UE_3}
    Step                   sleep    2s
    Step                   Activate Sherpa On All Cells
    Step                   sleep    10s
    Step                   Stop Sherpa Collection
    Step                   Calling Panda Extract Csv function
    Step                   Verification of BB Pooling Mode within PRB Pooling Allocation Report    pool_id=10
    Step                   Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4001    subpool_id=0
    Step                   Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4002    subpool_id=1
    Step                   Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4003    subpool_id=0
    Step                   Verification of BB Pooling Mode within PRB Pooling Allocation Report      pool_id=10
    Step                   Check Min and MAX PRB values
