# --------------------------------------------------------------------------------------------------------------------------------------------------
*** Keywords ***
Suite Setup ASOH
    [Documentation]
    ...     Conditions:     it is based on the arguments ${keep_all_data_in_file}
    ...     Actions:        it performs the generic suite setup and backup the configurations files
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        suite setup is passed
    [Arguments]             ${keep_all_data_in_file}=${False}

    ${timestamp_suite_setup}=         DateTime.Get Current Date    result_format=%Y%m%d-%H%M%S
    Set Suite Variable                ${timestamp_suite_setup}
    Setup.Suite Setup From Scratch    automaticTeardown=${True}    keepAllUeDataInCfgFile=${keep_all_data_in_file}
    Backup.Backup Files
    ${scf_suite_setup_backup}=        OAM Get SCF File    file=SCF_DU_Backup.xml
    Set Suite Variable                ${scf_suite_setup_backup}
    Dated Log                         ===> backup file is ${scf_suite_setup_backup}


Suite Teardown ASOH
    [Documentation]
    ...     Conditions:     it needs no conditions
    ...     Actions:        it restores the files when the test is finished
    ...     Checks:         it needs no checks
    ...     Verdict:        suite teardown is passed

    Restore Files

    Run Keyword If    ${AUTO_SAVE_DEBUG_DATA}    Run Keywords    Run    cp -f /opt/wts/latest/egate_console.log ${LOG_PATH}
    ...    AND                        Dated Log    ===> save the egate_console.log because AUTO_SAVE_DEBUG_DATA mode is set
    # Saving snapshots for debugging if AUTO_SAVE_DEBUG_DATA mode is set
    Dated Log                         ===> get snapshot just if requested and not already generated after failure...
    ${snapshot_path}=                 Set Variable    ${LOG_PATH}/SNAPSHOT_GNB*.zip
    ${status}   ${ret}   Run Keyword And Ignore Error    OperatingSystem.File Should Exist    ${snapshot_path}
    Run Keyword If   '${status}' == 'PASS'    Dated Log    ===> ${snapshot_path} is already present
    ...         ELSE IF    ${AUTO_SAVE_DEBUG_DATA}    Setup.Get Snapshot
    # Restoring backups scf
    ${scf_suite_teardown_restore}=    Get Variable Value    ${scf_suite_setup_backup}    None
    OAM Perform Full Commissioning    scf_file=${scf_suite_teardown_restore}    oam=${GNB_DU.oam}
    OAM wait available
    # Cleaning-up debugging files if AUTO_SAVE_DEBUG_DATA mode is not set
    Run Keyword If    not ${AUTO_SAVE_DEBUG_DATA}    Run Keywords    Run    rm -f ${LOG_PATH}/*.pdml
    ...    AND                        Dated Log    ===> remove the generated pdml files because AUTO_SAVE_DEBUG_DATA mode is not set
    ...    AND                        Run    rm -f ${LOG_PATH}/*._*.pcap
    ...    AND                        Dated Log    ===> remove the intermediate pcap files because AUTO_SAVE_DEBUG_DATA mode is not set
    ...    AND                        Run    rm -f ${scf_suite_setup_backup}
    ...    AND                        Dated Log    ===> remove the scf_suite_setup_backup because AUTO_SAVE_DEBUG_DATA mode is not set
    Run    rm -f ${LOG_PATH}/SCF.xml
    ${timestamp_suite_teardown}=      DateTime.Get Current Date    result_format=%Y%m%d-%H%M%S
    Set Suite Variable                ${timestamp_suite_teardown}
    Dated Log New Line                ===> RUNTIME: ${timestamp_suite_setup} -> ${timestamp_suite_teardown}
# --------------------------------------------------------------------------------------------------------------------------------------------------
# TTI data analysis functions #
Start TTI Logs ASOH
    [Arguments]             ${cell_id_list}
    Dated Log                         ===> configuration and get TTI is started
    # TTI capture configuration
    ${TTIdir}=                        Get TTI Trace Path
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2    cell_distid=${cell_id_list}
    Set Suite Variable                ${TTIdir}


Stop and Get TTI Logs
    [Arguments]             ${trace_name}=TTI

    Dated Log                         ===> stop and get TTI Logs is started
    ${TTIpcap}=                       Stop TTI Traces in Streaming mode    tti_trace_path=${TTIdir}    tti_trace_filename=${trace_name}
    Dated Log                         ===> convert TTI to json and csv is started
    ${TTIjson}=                       Convert TTI trace from pcap to others    input_file_path=${TTIpcap}
    ${TTIcsv}=                        decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=50000
    Set Suite Variable                ${TTIjson}
    [Return]    ${TTIjson}


Check l1SubPoolStreamPrb Consistency within TTI trace
    [Documentation]
    ...     Conditions:     it is based on the arguments ${json_file} ${pool_id} ${pool_max_num_stream_prb} ${packet_name} ${number_packet_to_check}
    ...                     ${mode_debug}
    ...     Actions:        it verifies the consistency of the streams into TTI trace
    ...     Checks:         it compares the current_stream sum, calculated_stream sum to the maximum
    ...     Verdict:        the checks are passed
    [Arguments]             ${json_file}
    ...                     ${pool_id}
    ...                     ${pool_max_num_stream_prb}=${POOL_MAX_NUM_STREAM_PRB}
    ...                     ${packet_name}=dlInterL1SubpoolReconfData
    ...                     ${number_packet_to_check}=25000
    ...                     ${mode_debug}=${False}

    Dated Log New Line    ===> Check l1SubPoolStreamPrb Consistency in packet=${packet_name} for pool_id=${pool_id}
    Dated Log                                   ===> from ${json_file}

    ${check_result}=                            check_l1SubPoolStreamPrb_consistency    _json_path=${json_file}
    ...                                                         _event_type=${packet_name}
    ...                                                         _pool_id=${pool_id}
    ...                                                         _pool_max_num_stream_prb=${pool_max_num_stream_prb}
    ...                                                         _number_packet_to_check=${number_packet_to_check}
    ...                                                         _mode_debug=${mode_debug}
    Run Keyword If    not ${check_result}
    ...    Dated Log    ===> failure is detected because constraints on Check l1SubPoolStreamPrb Consistency are not verified
    Should Be True                              ${check_result}
    Dated Log    ===> Check l1SubPoolStreamPrb Consistency within TTI trace is passed on the first ${number_packet_to_check} packets analyzed
    Dated Log    ===> pool_id=${pool_id} and pool_max_num_stream_prb=${pool_max_num_stream_prb}


Check l1SubPoolStreamPrbCapacity within TTI trace
    [Documentation]
    ...     Conditions:     it is based on the arguments ${json_file} ${pool_id} ${sub_pool_id} ${pool_max_num_stream_prb} ${check_operator}
    ...                     ${default_stream} ${current_stream} ${calculated_stream} ${packet_name} ${number_packet_to_check} ${mode_debug}
    ...     Actions:        it verifies the stream information of a sub_pool_id into TTI trace
    ...     Checks:         it checks default_stream, current_stream, calculated_stream if not None
    ...     Verdict:        the checks are passed
    [Arguments]             ${json_file}
    ...                     ${pool_id}
    ...                     ${sub_pool_id}
    ...                     ${pool_max_num_stream_prb}=${POOL_MAX_NUM_STREAM_PRB}
    ...                     ${check_operator}===                    # ==:0, >:1 and <:2
    ...                     ${default_stream}=${None}
    ...                     ${current_stream}=${None}
    ...                     ${calculated_stream}=${None}
    ...                     ${packet_name}=dlInterL1SubpoolReconfData
    ...                     ${number_packet_to_check}=25000
    ...                     ${mode_debug}=${False}

    Dated Log New Line    ===> Check l1SubPoolStreamPrbCapacity in packet=${packet_name} for pool_id=${pool_id} and sub_pool_id=${sub_pool_id}
    Dated Log                                   ===> from ${json_file}

    ${operator_value}=                          Run Keyword If    '${check_operator}' == '=='    Set Variable    0
    ...                                                     ELSE IF    '${check_operator}' == '>'    Set Variable    1
    ...                                                     ELSE IF    '${check_operator}' == '<'    Set Variable    2
    ...                                                     ELSE       Set Variable    3
    ${check_result}=                            check_l1SubPoolStreamPrbCapacity    _json_path=${json_file}
    ...                                                         _event_type=${packet_name}
    ...                                                         _pool_id=${pool_id}
    ...                                                         _pool_max_num_stream_prb=${pool_max_num_stream_prb}
    ...                                                         _sub_pool_id=${sub_pool_id}
    ...                                                         _operator_value=${operator_value}
    ...                                                         _default_stream=${default_stream}
    ...                                                         _current_stream=${current_stream}
    ...                                                         _calculated_stream=${calculated_stream}
    ...                                                         _number_packet_to_check=${number_packet_to_check}
    ...                                                         _mode_debug=${mode_debug}
    Run Keyword If    not ${check_result}
    ...    Dated Log    ===> failure is detected because constraints on Check l1SubPoolStreamPrbCapacity are not verified
    Should Be True                              ${check_result}
    Dated Log    ===> Check l1SubPoolStreamPrbCapacity within TTI trace is passed on the first ${number_packet_to_check} packets analyzed
    Dated Log    ===> pool_id=${pool_id} and for sub_pool_id=${sub_pool_id} and operation is ${check_operator}
    Dated Log    ===> default_stream=${default_stream}, current_stream=${current_stream} or default_stream, calculated_stream=${calculated_stream}


Check Number Of PRB Allocated within TTI trace
    [Documentation]
    ...     Conditions:     it is based on the arguments ${json_file} ${phys_cell_id} ${check_operator} ${stream_prb_gbr_alloc}
    ...                     ${stream_prb_non_gbr_alloc} ${num_alloc_prb} ${bbrm_usable_cell_prb} ${zab_privilege} ${packet_name}
    ...                     ${number_packet_to_check} ${mode_debug}
    ...     Actions:        it verifies the information of a cell into TTI trace
    ...     Checks:         it checks stream_prb_gbr_alloc, stream_prb_non_gbr_alloc, num_alloc_prb, bbrm_usable_cell_prb, zab_privilege if not None
    ...     Verdict:        the checks are passed
    [Arguments]             ${json_file}
    ...                     ${phys_cell_id}
    ...                     ${check_operator}===                    # ==:0, >:1 and <:2
    ...                     ${stream_prb_gbr_alloc}=${None}
    ...                     ${stream_prb_non_gbr_alloc}=${None}
    ...                     ${num_alloc_prb}=${None}
    ...                     ${bbrm_usable_cell_prb}=${None}
    ...                     ${zab_privilege}=${None}
    ...                     ${packet_name}=dlAllocatedPooledResourcesData
    ...                     ${number_packet_to_check}=25000
    ...                     ${mode_debug}=${False}

    Dated Log New Line    ===> Check Number Of PRB Allocated in packet=${packet_name} for phys_cell_id=${phys_cell_id}
    Dated Log                                   ===> from ${json_file}

    ${operator_value}=                          Run Keyword If    '${check_operator}' == '=='    Set Variable    0
    ...                                                     ELSE IF    '${check_operator}' == '>'    Set Variable    1
    ...                                                     ELSE IF    '${check_operator}' == '<'    Set Variable    2
    ...                                                     ELSE       Set Variable    3
    ${check_result}=                            check_number_prb_allocated    _json_path=${json_file}
    ...                                                         _event_type=${packet_name}
    ...                                                         _phys_cell_id=${phys_cell_id}
    ...                                                         _operator_value=${operator_value}
    ...                                                         _stream_prb_gbr_alloc=${stream_prb_gbr_alloc}
    ...                                                         _stream_prb_non_gbr_alloc=${stream_prb_non_gbr_alloc}
    ...                                                         _num_alloc_prb=${num_alloc_prb}
    ...                                                         _bbrm_usable_cell_prb=${bbrm_usable_cell_prb}
    ...                                                         _zab_privilege=${zab_privilege}
    ...                                                         _number_packet_to_check=${number_packet_to_check}
    ...                                                         _mode_debug=${mode_debug}
    Run Keyword If    not ${check_result}
    ...    Dated Log    ===> failure is detected because constraints on Check Number Of PRB Allocated are not verified
#    Should Be True                              ${check_result}
    Dated Log    ===> Check Number Of PRB Allocated within TTI trace is passed on the first ${number_packet_to_check} packets analyzed
    Dated Log    ===> phys_cell_id=${phys_cell_id} and operation is ${check_operator}
    Dated Log    ===> stream_prb_gbr_alloc=${stream_prb_gbr_alloc}, stream_prb_non_gbr_alloc=${stream_prb_non_gbr_alloc}
    Dated Log    ===> num_alloc_prb=${num_alloc_prb}, bbrm_usable_cell_prb=${bbrm_usable_cell_prb}, zab_privilege=${zab_privilege}


Is Global Cell Id Retained For Streaming
    [Arguments]             ${global_cell_id}
    ...                     ${cell_list}

    ${result_global_cell}=           Set Variable    ${False}
    FOR    ${current_cell}    IN    @{cell_list}
        #for debugging only#Dated Log    global cell id ${global_cell_id} vs. current cell ${current_cell}
        #for debugging only#Run Keyword If    ${result_global_cell} or ${global_cell_id}==${current_cell}
        ###...    Dated Log    ===> true    ELSE    Dated Log    ===> false
        ${result_global_cell}=    Run Keyword If    ${result_global_cell} or ${global_cell_id}==${current_cell}    Set Variable    ${True}
        ...                                   ELSE                                                                 Set Variable    ${False}
    END
    #for debugging only#Dated Log    final result returned is ${result_global_cell}
    [Return]    ${result_global_cell}
# --------------------------------------------------------------------------------------------------------------------------------------------------
UL+DL Traffic Not Stopped ASOH
    [Documentation]
    ...     Conditions:     it is based on the arguments ${param} ${current_ue_setting} ${current_trf_id}
    ...     Actions:        it manages the DL traffic on the UE
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        DL traffic is passed
    [Arguments]             ${param}
    ...                     ${current_ue_setting}
    ...                     ${current_trf_id}=1

    Set To Dictionary                           ${current_ue_setting}    trf_id    ${current_trf_id}
    Traffic UE DL                               ueSetting=${current_ue_setting}
    ...                                         throughput=${current_ue_setting.throughput}
    ...                                         captureCallback=None
    ...                                         capture=None
    ...                                         captureDuration=0
    ...                                         duration=${param.duration}
    ...                                         shouldBeStop=False
    ...                                         deviation=${param.deviation}

    ${current_trf_id}=                          Evaluate    ${current_trf_id} + 9
    Set To Dictionary                           ${current_ue_setting}    trf_id    ${current_trf_id}
    Traffic UE UL                               ueSetting=${current_ue_setting}
    ...                                         throughput=${current_ue_setting.throughput_ul}
    ...                                         captureCallback=None
    ...                                         capture=None
    ...                                         captureDuration=0
    ...                                         duration=${param.duration}
    ...                                         shouldBeStop=False
    ###...                                         shouldBeCheck=False
    ...                                         deviation=90        #vbo#deviation for traffic ul#
# --------------------------------------------------------------------------------------------------------------------------------------------------
Check Counter And KPI Constraints ASOH
    [Arguments]             ${pm_path}
    ...                     ${test_name}
    ...                     ${localKpiFileName}=${None}
    Dated Log                                   ===> check counter and KPI constraints is started
    ${localKpiFile}=    Run Keyword If    '${localKpiFileName}' == '${None}'    Set Variable   ${None}
    ...                             ELSE        Set Variable   ${CURDIR}/config/counter/KPI/${localKpiFileName}
    KPI Evaluate                                pmFile=${pm_path}
    ...                                         constraintsFile=${CURDIR}/config/counter/constraint/${test_name}.csv
    ...                                         failOnError=${True}
    ...                                         localKpiFile=${localKpiFile}
    Dated Log                                   ===> check counter and KPI constraints is ended
# --------------------------------------------------------------------------------------------------------------------------------------------------
# Vendor configuration #
Deploy Vendor File Config ASOH
    [Documentation]
    ...     Conditions:     it is based on the arguments ${vendor_param} ${is_perform_full_commissioning}
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${vendor_param}
    ...                     ${is_perform_full_commissioning}=${True}

    # OAM Perform Full Commissioning is mandatory to apply vendor configuration
    ${scf_vendor_config}=        OAM Get SCF File    file=SCF_DU_vendor_config.xml

    ${original_vendor_file}           ${modified_vendor_file}    SetConfig.Download Vendor File
    Dated Log                         ===> original vendor file name is ${original_vendor_file}
    Dated Log                         ===> modified vendor file name will be ${modified_vendor_file}

    ScfVendorOperations.setup reader    ${original_vendor_file}
    # bbL1SpPrbInitCapacity
    # Original value should be related to <!-- 48 CS, only DL -->
    ${mo_dict}=                       ScfVendorOperations.get moelements byclass    NRBTS
    &{original_values}=               Create Dictionary    bbHwVariant=${vendor_param.bb_hw_variant}
    ...                                                             csSize=48
    ...                                                             direction=DL
    ...                                                             l1PoolType=${vendor_param.l1_Pool_Type}
    ...                                                             maxNumLayerPrbL1Sp=${NUM_MAX_LAYER_PRB_L1_SP_DEFAULT}
    ...                                                             maxNumStreamPrbL1Sp=${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT}
    ...                                                             maxNumWbStreamPrbL1Sp=${NUM_MAX_WB_STREAM_PRB_L1_SP_DEFAULT}

    ${vendor_param.max_num_layer_prb_l1_sp}=    Run Keyword If    ${vendor_param.max_num_layer_prb_l1_sp} == None
    ...                                                             Set Variable    ${NUM_MAX_LAYER_PRB_L1_SP_DEFAULT}
    ...                                                     ELSE    Set Variable    ${vendor_param.max_num_layer_prb_l1_sp}

    ${vendor_param.max_num_stream_prb_l1_sp}=    Run Keyword If    ${vendor_param.max_num_stream_prb_l1_sp} == None
    ...                                                             Set Variable    ${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT}
    ...                                                      ELSE    Set Variable    ${vendor_param.max_num_stream_prb_l1_sp}

    ${vendor_param.max_num_wb_stream_prb_l1_sp}=    Run Keyword If    ${vendor_param.max_num_wb_stream_prb_l1_sp} == None
    ...                                                             Set Variable    ${NUM_MAX_WB_STREAM_PRB_L1_SP_DEFAULT}
    ...                                                         ELSE    Set Variable    ${vendor_param.max_num_wb_stream_prb_l1_sp}

    &{new_values}=                    Create Dictionary    bbHwVariant=${vendor_param.bb_hw_variant}
    ...                                                             csSize=48
    ...                                                             direction=DL
    ...                                                             l1PoolType=${vendor_param.l1_Pool_Type}
    ...                                                             maxNumLayerPrbL1Sp=${vendor_param.max_num_layer_prb_l1_sp}
    ...                                                             maxNumStreamPrbL1Sp=${vendor_param.max_num_stream_prb_l1_sp}
    ...                                                             maxNumWbStreamPrbL1Sp=${vendor_param.max_num_wb_stream_prb_l1_sp}
    @{original_items_list}=           Create List    ${original_values}
    @{new_items_list}=                Create List    ${new_values}
    ${list_name}=                     Set Variable    bbL1SpPrbInitCapacity
    ${modified_mo}=    ScfVendorOperations.replace items inList    ${original_items_list}    ${new_items_list}    ${list_name}    ${mo_dict}

    # Original value should be related to <!-- 48 CS, only UL -->
    &{original_values_ul}=            Create Dictionary    bbHwVariant=${vendor_param.bb_hw_variant}
    ...                                                             csSize=48
    ...                                                             direction=UL
    ...                                                             l1PoolType=${vendor_param.l1_Pool_Type}
    ...                                                             maxNumLayerPrbL1Sp=${NUM_MAX_LAYER_PRB_L1_SP_DEFAULT_UL}
    ...                                                             maxNumStreamPrbL1Sp=${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT_UL}
    ...                                                             maxNumWbStreamPrbL1Sp=${NUM_MAX_WB_STREAM_PRB_L1_SP_DEFAULT_UL}

    ${vendor_param.max_num_layer_prb_l1_sp_ul}=    Run Keyword If    ${vendor_param.max_num_layer_prb_l1_sp_ul} == None
    ...                                                             Set Variable    ${NUM_MAX_LAYER_PRB_L1_SP_DEFAULT_UL}
    ...                                                        ELSE    Set Variable    ${vendor_param.max_num_layer_prb_l1_sp_ul}

    ${vendor_param.max_num_stream_prb_l1_sp_ul}=    Run Keyword If    ${vendor_param.max_num_stream_prb_l1_sp_ul} == None
    ...                                                             Set Variable    ${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT_UL}
    ...                                                         ELSE    Set Variable    ${vendor_param.max_num_stream_prb_l1_sp_ul}

    ${vendor_param.max_num_wb_stream_prb_l1_sp_ul}=    Run Keyword If    ${vendor_param.max_num_wb_stream_prb_l1_sp_ul} == None
    ...                                                             Set Variable    ${NUM_MAX_WB_STREAM_PRB_L1_SP_DEFAULT_UL}
    ...                                                            ELSE    Set Variable    ${vendor_param.max_num_wb_stream_prb_l1_sp_ul}

    &{new_values_ul}=                 Create Dictionary    bbHwVariant=${vendor_param.bb_hw_variant}
    ...                                                             csSize=48
    ...                                                             direction=UL
    ...                                                             l1PoolType=${vendor_param.l1_Pool_Type}
    ...                                                             maxNumLayerPrbL1Sp=${vendor_param.max_num_layer_prb_l1_sp_ul}
    ...                                                             maxNumStreamPrbL1Sp=${vendor_param.max_num_stream_prb_l1_sp_ul}
    ...                                                             maxNumWbStreamPrbL1Sp=${vendor_param.max_num_wb_stream_prb_l1_sp_ul}
    @{original_items_list_ul}=        Create List    ${original_values_ul}
    @{new_items_list_ul}=             Create List    ${new_values_ul}
    ${modified_mo_all}=    ScfVendorOperations.replace items inList    ${original_items_list_ul}
    ...                                                             ${new_items_list_ul}    ${list_name}    ${modified_mo}

    ScfVendorOperations.save back toxml    ${modified_vendor_file}
    ${Tmp_file_ls}=                   OperatingSystem.run    ls -altr ${modified_vendor_file}
    Dated log                         Obtained file ${Tmp_file_ls}
    &{args}=                          Create Dictionary    vendor_file="${modified_vendor_file}"
    OAM Run Command                   cmd=set_vendor_file    cmd_args=${args}

    # Force the full commissioning when it is requested
    Run Keyword if    ${is_perform_full_commissioning}    Run Keywords
    ...                               OAM Perform Full Commissioning    scf_file=${scf_vendor_config}
    ###...    AND                        Restart Airphone
    ...    AND                        Wait Airphone Available
    ...    AND                        OAM wait available    wait_time=300
# --------------------------------------------------------------------------------------------------------------------------------------------------
*** Test Cases ***
[1] CB010513_ASOH_TC1_SA
    [Documentation]
    ...     Conditions:     it is based on the configuration ${CB010513_ASOH_basic}
    ...     Actions:        it performs the call setup for multi ue's on different cells
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues with traffic are passed
    [Tags]                  CLOUD_5G_O_H_AP_LOO    VARIANT_SANSA_FS_CPRI_CMWV_FDD+ECPRI_CMWV_TDD    SBTS00

    Apply Custom Config               scfc=${CURDIR}/config/customcfg/scf_o_h_3T_4DL4UL_b6_actBbPool_3F_03.xml
    ...                               iphy=${CURDIR}/config/customcfg/ap_iphy_3T_3F_01.xml
    ...                               cfg=${CURDIR}/config/customcfg/basic_setup_3T_3F_02.cfg
    ...                               rad_params=${EMPTY}
    ...                               vendor_params=${EMPTY}

    Init Sequence                     param=${CB010513_ASOH_basic}
    Dated Log New Line                ===> test name is ${param.test_name}

    #for debugging only#@{internalDNs}                    Create List    /MRBTS-1/RAT-1/RUNTIME_VIEW-1/MRBTS_R-1/NRBTS_R-1/NRCELL_R-1
    ###...                                              /MRBTS-1/RAT-1/RUNTIME_VIEW-1/MRBTS_R-1/NRBTS_R-1/NRCELL_R-2
    ###...                                              /MRBTS-1/RAT-1/RUNTIME_VIEW-1/MRBTS_R-1/NRBTS_R-1/NRCELL_R-3
    ###...                                              /MRBTS-1/RAT-1/RUNTIME_VIEW-1/MRBTS_R-1/NRBTS_R-1/NRCELL_R-4
    ###...                                              /MRBTS-1/RAT-1/RUNTIME_VIEW-1/MRBTS_R-1/NRBTS_R-1/NRCELL_R-5
    ###...                                              /MRBTS-1/RAT-1/RUNTIME_VIEW-1/MRBTS_R-1/NRBTS_R-1/NRCELL_R-6
    ###Dated Log New Line                ===> Distname id of the cells list for TTI streaming is ${internalDNs}
    #### cas 1 when cell_id_list is empty
    ###${cell_id_list}                   Set Variable    ${EMPTY}
    ###Dated Log    ===> cas 1 empty - cell_distrib= ${cell_id_list}
    ###${cell_id_list}=  Set Variable if    "${cell_id_list}"=="${EMPTY}"       ${internalDNs}     ${cell_id_list}
    ###Dated Log    ===> cas 1 result - cell_distrib= ${cell_id_list}
    #### cas 2 when cell_id_list is not empty
    ###@{cell_id_list}                    Create List   /MRBTS-1/RAT-1/RUNTIME_VIEW-1/MRBTS_R-1/NRBTS_R-1/NRCELL_R-1
    ###...                                              /MRBTS-1/RAT-1/RUNTIME_VIEW-1/MRBTS_R-1/NRBTS_R-1/NRCELL_R-2
    ###...                                              /MRBTS-1/RAT-1/RUNTIME_VIEW-1/MRBTS_R-1/NRBTS_R-1/NRCELL_R-5
    ###Dated Log    ===> cas 2 not empty - cell_distrib= ${cell_id_list}
    ###${cell_id_list}=  Set Variable if    "${cell_id_list}"=="${EMPTY}"       ${internalDNs}     ${cell_id_list}
    ###Dated Log    ===> cas 2 result - cell_distrib= ${cell_id_list}

   # Critical Step                     Deploy Vendor File Config ASOH    vendor_param=${VENDOR_CUSTOM_1}    is_perform_full_commissioning=${true}
    ###Critical Step                     Restart TL

    # Configure the current setting for all the ue's
    ${param.total_nb_ue}=             get length    ${dict_settings_basic}
    Dated Log New Line                ===> configure the setting for all the ${param.total_nb_ue} ue's
    @{list_ue}=                       Create List
    @{cell_id_for_streaming}=         Create List
    FOR    ${current_id}    IN RANGE    0    ${param.total_nb_ue}
        ${current_ue_setting}=        Copy Dictionary     ${BASIC_UE_SA}
        Set To Dictionary             ${current_ue_setting}    ue    ${dict_settings_basic[${current_id}].ue_id}
        Set To Dictionary             ${current_ue_setting}    trf_id    1
        Set To Dictionary             ${current_ue_setting}    pdu    1
        Set To Dictionary             ${current_ue_setting}    target_gnb    ${param.target_gnb}
        # Dispatching the ue on the requested original cell for the call establishment
        Set To Dictionary             ${current_ue_setting}    target_cells    ${dict_settings_basic[${current_id}].original_cell}
        Append To List                ${cell_id_for_streaming}    ${current_ue_setting.target_cells}
        # Set the correct requested throughput per ue
        Set To Dictionary             ${current_ue_setting}    throughput    ${dict_settings_basic[${current_id}].throughput}
        Set To Dictionary             ${current_ue_setting}    throughput_ul    ${dict_settings_basic[${current_id}].throughput_ul}
        Append To List                ${list_ue}    ${current_ue_setting}
    END
    Dated Log New Line                ===> ue's list is ${list_ue}
    Dated Log New Line                ===> cell's list for TTI streaming is ${cell_id_for_streaming}

    # Setup wtsemu SA for all the ue's
    Critical Step                     CallSetup.Setup Wtsemu SA     nbUe=${param.total_nb_ue}
    ...                                                             nbSaUe=${param.total_nb_ue}
    ...                                                             shouldUseLua=${False}
    ...                                                             nbCell=${param.total_nb_cell}
    ...                                                             list_of_UE_tobe_created=${list_ue}

    @{cell_id_list}                   Create List
    @{cellsNr}                        OAM Get Cells Nr    oam=${GNB_DU.oam}
    #for debugging only#Dated Log     ===> cellsNr=@{cellsNr}
    FOR    ${current_cell}    IN    @{cellsNr}
        #for debugging only#Dated Log    cell NR is ${current_cell}
        #for debugging only#Dated Log                     internal distname ${current_cell['id']['internal']}
        ${cell_status_}=              Set variable  ${current_cell['status']}
        ${operationalState}=          Set Variable   ${cell_status_['operationalState']}
        #for debugging only#Dated Log                     operationalState for DN [${current_cell['id']['internal']}] is ${operationalState}
        ${globalCellId}=              Set Variable   ${current_cell['globalCellId']}
        ${is_global_cell_id}=    Is Global Cell Id Retained For Streaming    global_cell_id=${globalCellId}    cell_list=${cell_id_for_streaming}
        Run Keyword If    ${is_global_cell_id}    Append to List    ${cell_id_list}    ${current_cell['id']['internal']}
    END
    Dated Log New Line                ===> distname list of the cells retained for TTI streaming ${cell_id_list}

    # Capture TTI traces during call setup
    Start TTI Logs ASOH    cell_id_list=${cell_id_list}

    # WA to avoid alarm on cells
    Traced Sleep                      duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    Step                              CallSetup.WTS Set X2 Link

    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                          CallSetup.UE Register    ue=${current_elem.ue}    depends=CallSetup.Setup Wtsemu SA
        Step                          CallSetup.Launch PDU Session    ue=${current_elem.ue}    pdu=${current_elem.pdu}    gw=${current_elem.ue}
        ...                           depends=CallSetup.UE Register
    END

    Step                              Stop and Get TTI Logs    trace_name=TTI_${param.test_name}_call_setup
    ${capture_tti_output}=            Set Variable    ${LOG_PATH}/TTITraces/TTI_${param.test_name}_call_setup.json
    #
    ${num_stream_cell_dl_float}=      Evaluate    (${NUM_MAX_STREAM_PRB_L1_SP} * 2) / 3           # two l1sp and because 3 cells
    ${num_stream_cell_dl_int}=        Convert To Integer    ${num_stream_cell_dl_float}
    ${num_stream_cell_dl_string}=     Convert To String    ${num_stream_cell_dl_int}
    ${num_stream_two_cells_dl_int}=    Evaluate    ${num_stream_cell_dl_int} * 2
    ${num_stream_two_cells_dl_string}=    Convert To String    ${num_stream_two_cells_dl_int}
    Should Be True    ${num_stream_cell_dl_int} == ${CURRENT_NUM_STREAM_PRB_L1_SP1}
    Should Be True    ${num_stream_two_cells_dl_int} == ${CURRENT_NUM_STREAM_PRB_L1_SP0}
    ${num_stream_cell_ul_float}=      Evaluate    (${NUM_MAX_STREAM_PRB_L1_SP_UL} * 2) / 3        # two l1sp and because 3 cells
    ${num_stream_cell_ul_int}=        Convert To Integer    ${num_stream_cell_ul_float}
    ${num_stream_cell_ul_string}=     Convert To String    ${num_stream_cell_ul_int}
    ${num_stream_two_cells_ul_int}=    Evaluate    ${num_stream_cell_ul_int} * 2
    ${num_stream_two_cells_ul_string}=    Convert To String    ${num_stream_two_cells_ul_int}
    Should Be True    ${num_stream_cell_ul_int} == ${CURRENT_NUM_STREAM_PRB_L1_SP1_UL}
    Should Be True    ${num_stream_two_cells_ul_int} == ${CURRENT_NUM_STREAM_PRB_L1_SP0_UL}
    #
    # Check l1SubPoolStreamPrb Consistency on dl during call setup
    Step                              Check l1SubPoolStreamPrb Consistency within TTI trace    json_file=${capture_tti_output}    pool_id=${ID_POOL}
    ...                                                             pool_max_num_stream_prb=${POOL_MAX_NUM_STREAM_PRB_DEFAULT}
    ...                                                             mode_debug=${True}
    #
    # Check l1SubPoolStreamPrbCapacity on dl during call setup both sub_pool_id
    Step                              Check l1SubPoolStreamPrbCapacity within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             sub_pool_id=${ID_SUBPOOL_1}
    ...                                                             pool_max_num_stream_prb=${POOL_MAX_NUM_STREAM_PRB_DEFAULT}
    ...                                                             default_stream=${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT}
    ...                                                             current_stream=${CURRENT_NUM_STREAM_PRB_L1_SP0_DEFAULT}
    ...                                                             calculated_stream=${CURRENT_NUM_STREAM_PRB_L1_SP0_DEFAULT}
    #...                                                            number_packet_to_check=128
    ...                                                             mode_debug=${True}
    #
    Step                              Check l1SubPoolStreamPrbCapacity within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             sub_pool_id=${ID_SUBPOOL_2}
    ...                                                             pool_max_num_stream_prb=${POOL_MAX_NUM_STREAM_PRB_DEFAULT}
    ...                                                             default_stream=${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT}
    ...                                                             current_stream=${CURRENT_NUM_STREAM_PRB_L1_SP1_DEFAULT}
    ...                                                             calculated_stream=${CURRENT_NUM_STREAM_PRB_L1_SP1_DEFAULT}
    #...                                                            number_packet_to_check=128
    ...                                                             mode_debug=${True}
    #
    # Check l1SubPoolStreamPrb Consistency on ul during call setup
    Step                              Check l1SubPoolStreamPrb Consistency within TTI trace    json_file=${capture_tti_output}    pool_id=${ID_POOL}
    ...                                                             pool_max_num_stream_prb=${POOL_MAX_NUM_STREAM_PRB_UL_DEFAULT}
    ...                                                             packet_name=ulInterL1SubpoolReconfData
    ...                                                             mode_debug=${True}
    #
    # Check l1SubPoolStreamPrbCapacity on ul during call setup both sub_pool_id
    Step                              Check l1SubPoolStreamPrbCapacity within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             sub_pool_id=${ID_SUBPOOL_1}
    ...                                                             pool_max_num_stream_prb=${POOL_MAX_NUM_STREAM_PRB_UL_DEFAULT}
    ...                                                             packet_name=ulInterL1SubpoolReconfData
    ...                                                             default_stream=${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT_UL}
    ...                                                             current_stream=${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT}
    ...                                                             calculated_stream=${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT}
    #...                                                            number_packet_to_check=128
    ...                                                             mode_debug=${True}
    #
    Step                              Check l1SubPoolStreamPrbCapacity within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             sub_pool_id=${ID_SUBPOOL_2}
    ...                                                             pool_max_num_stream_prb=${POOL_MAX_NUM_STREAM_PRB_UL_DEFAULT}
    ...                                                             packet_name=ulInterL1SubpoolReconfData
    ...                                                             default_stream=${NUM_MAX_STREAM_PRB_L1_SP_DEFAULT_UL}
    ...                                                             current_stream=${NUM_MAX_WB_STREAM_PRB_L1_SP_DEFAULT_UL}
    ...                                                             calculated_stream=${NUM_MAX_WB_STREAM_PRB_L1_SP_DEFAULT_UL}
    #...                                                            number_packet_to_check=128
    ...                                                             mode_debug=${True}

    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput} > ${NO_THROUGHPUT}
        ...    Step                   ${param.dir} Traffic Not Stopped ASOH    param=${param}    current_ue_setting=${current_elem}
        ...                           depends=CallSetup.Launch PDU Session
    END

    # Capture TTI traces during traffic
    Start TTI Logs ASOH    cell_id_list=${cell_id_list}
    Traced Sleep    duration=8s    msg=call with traffic for TTI trace
    Step                              Stop and Get TTI Logs    trace_name=TTI_${param.test_name}_traffic
    ${capture_tti_output}=            Set Variable    ${LOG_PATH}/TTITraces/TTI_${param.test_name}_traffic.json
    #
    # Check Number Of PRB Allocated on dl per cell
    Step                              Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=50
    ...                                                             check_operator=>
    ...                                                             stream_prb_gbr_alloc=0
    ...                                                             stream_prb_non_gbr_alloc=330
    ...                                                             num_alloc_prb=272
    ...                                                             bbrm_usable_cell_prb=273
    ...                                                             packet_name=dlAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${True}
    Step                              Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=51
    ...                                                             check_operator=<
    ...                                                             stream_prb_gbr_alloc=0
    ...                                                             stream_prb_non_gbr_alloc=200
    ...                                                             num_alloc_prb=200
    ...                                                             bbrm_usable_cell_prb=273
    ...                                                             packet_name=dlAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${True}
    Step                              Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=54
    ...                                                             check_operator=<
    ...                                                             stream_prb_gbr_alloc=0
    ...                                                             stream_prb_non_gbr_alloc=200
    ...                                                             num_alloc_prb=200
    ...                                                             bbrm_usable_cell_prb=273
    ...                                                             packet_name=dlAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${True}
    # Check Number Of PRB Allocated on ul per cell
    Step                              Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=50
    ...                                                             check_operator=>
    ...                                                             stream_prb_gbr_alloc=0
    ...                                                             stream_prb_non_gbr_alloc=400
    ...                                                             num_alloc_prb=256
    ...                                                             bbrm_usable_cell_prb=273
    ...                                                             packet_name=ulAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${True}
    Step                              Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=51
    ...                                                             check_operator=<
    ...                                                             stream_prb_gbr_alloc=0
    ...                                                             stream_prb_non_gbr_alloc=200
    ...                                                             num_alloc_prb=200
    ...                                                             bbrm_usable_cell_prb=273
    ...                                                             packet_name=ulAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${True}
    Step                              Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=54
    ...                                                             check_operator=<
    ...                                                             stream_prb_gbr_alloc=0
    ...                                                             stream_prb_non_gbr_alloc=200
    ...                                                             num_alloc_prb=260
    ...                                                             bbrm_usable_cell_prb=273
    ...                                                             packet_name=ulAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${True}

    Wait PM availability    pmPeriodSec=300                         #pmAvailDelay=60 #Sleep Until PM Availability

    # Waiting time added for observation and allow generation of multiple count periods
    FOR    ${iteration_pm}    IN RANGE    0    ${param.pm_waiting_period}
        Wait PM availability    pmPeriodSec=300                     #pmAvailDelay=60 #Sleep Until PM Availability
        ${pm_path}=                   Counters.Collect PM files from BTS    ${LOG_PATH}/PM
        Step                          Check Counter And KPI Constraints ASOH    pm_path=${pm_path}    test_name=${param.test_name}
    END

    # Deregister all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                          CallSetup.UE Deregister    id=${current_elem.ue}    ue_deregister_type=switch_off    by=ue
        ...                           depends=CallSetup.UE Register
    END

    Produce Scout Data
    [Teardown]    Display diagnosis
# --------------------------------------------------------------------------------------------------------------------------------------------------
