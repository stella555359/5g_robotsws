def adjust_parameters_using_delta(delta):
    common_gnb.perform_recomissioning_with_delta(path_to_delta=json.dumps(delta))


def copy_default_wts_config_from_current_deployment():
    wts_config_filename = "wts_{}.cfg".format(get_test_prefix())
    wts_config_path = os.path.join(EPCSIM_DIR_PATH, wts_config_filename)
    OperatingSystem().copy_file(source=DEFAULT_WTS_CONFIG_PATH, destination=wts_config_path)
    BuiltIn().set_test_variable("${WTS_CONFIG_PATH}", wts_config_path)
    return wts_config_path


def copy_wts_cfg_file_to_output_dir(wts_config_path=None, subdir="wts/"):
    output_dir = BuiltIn().get_variable_value("${OUTPUT_DIR}")
    if not wts_config_path:
        wts_config_path = BuiltIn().get_variable_value("${WTS_CONFIG_PATH}")
    if not subdir.endswith('/'):
        subdir += '/'
    OperatingSystem().copy_file(source=wts_config_path, destination=os.path.join(output_dir, subdir))


def prepare_environment(sib1_reception_dict, wts_config_path=None, skip_reset=False):
    if wts_config_path:
        OperatingSystem().copy_file(source=wts_config_path, destination=EPCSIM_DIR_PATH)
    else:
        wts_config_path = copy_default_wts_config_from_current_deployment()

    copy_wts_cfg_file_to_output_dir(wts_config_path, get_test_prefix())
    common_gnb.delete_localhost_ssh_key_from_known_hosts()
    add_nsa_specific_addresses()
    add_additional_specific_addresses()
    ta5g_testline_management().wait_for_testline_icmp_echo_replies_and_ssh_services()
    ensure_gnb_files_flags_are_in_order()
    common_gnb.log_gnb_build()
    log_airphone_build()
    ru_tries = mib_sib_tries = 0
    ru_tries_max = mib_sib_tries_max = 4
    while ru_tries < ru_tries_max and mib_sib_tries < mib_sib_tries_max:
        if ru_tries != 0 or mib_sib_tries != 0:
            utilities.logger_console_info("I will restart environment preparation")
        try:
            common_gnb.reset_units_and_wait_for_radio_head_online(skip_reset=skip_reset)
            start_wts_and_wait_for_ready_state(
                wts_config_filename=wts_config_path,
                sib_reception_dict=sib1_reception_dict,
                edaemon_port=22222,
                timeout=720
            )
        except common_gnb.RadioHeadTimeoutException:
            utilities.logger_warning("RadioHeadTimeoutException occurred")
            ru_tries += 1
        except (ValueError, ExecutionFailed) as e:
            utilities.logger_warning("MibSibAcquisitionFailed exception occurred")
            ta5g_egate_instance = BuiltIn().get_library_instance('ta5g_egate')
            ta5g_egate_instance._ute_wtssim_instance.teardown_all_aliases_for_wts()
            mib_sib_tries += 1
        else:
            break

        if skip_reset is True:
            if ru_tries > 0:
                raise common_gnb.RadioHeadTimeoutException("RadioHeadTimeoutException occurred")
            if mib_sib_tries > 0:
                raise common_gnb.MibSibAcquisitionFailed("MIB-SIB Acquisition failed")

        if ru_tries >= ru_tries_max:
            raise common_gnb.RadioHeadTimeoutException("RadioHeadTimeoutException occurred over {} times".format(
                ru_tries_max))
        elif mib_sib_tries >= mib_sib_tries_max:
            raise common_gnb.MibSibAcquisitionFailed("MIB-SIB Acquisition failed over {} retries".format(
                mib_sib_tries))


def start_collecting_logs(prefix=""):
    log_dirpath = ta5g_interface_tools().get_robot_output_dir()
    if not prefix:
        prefix = get_test_prefix()

    common_gnb.collect_scf_file(prefix="before", subdir=prefix, name=prefix)
    ta5g_syslog = BuiltIn().get_library_instance('ta5g_syslog')
    ta5g_tshark = BuiltIn().get_library_instance('ta5g_tshark')
    ta5g_syslog.start_syslog_for_enb(logs_dirpath=log_dirpath + '/' + prefix,
                                     log_filename_prefix="syslog_gnb_{}_".format(prefix))
    ta5g_tshark.start_tshark(alias=BuiltIn().get_variable_value("${ALIAS_TSHARK_WTS}"),
                             log_filename="tcpdump_WTS_" + prefix + ".pcap",
                             log_dirpath=log_dirpath + "/" + prefix,
                             capture_filter="sctp",
                             eth_interface='any')
    ta5g_tshark.start_tcpdump_on_remote_interface(log_filename_prefix="tcpdump_GNB_" + prefix,
                                                  log_dirpath=log_dirpath + "/" + prefix)
    sleep(2)


def prepare_env_and_start_collecting_logs(wts_config_filename=None, sib1_reception_dict=None):
    prepare_environment(wts_config_filename, sib1_reception_dict)
    start_collecting_logs()


def teardown_collecting_logs():
    log_dirpath = ta5g_interface_tools().get_robot_output_dir()
    ta5g_tshark = BuiltIn().get_library_instance('ta5g_tshark')
    ta5g_syslog = BuiltIn().get_library_instance('ta5g_syslog')
    ute_tshark = BuiltIn().get_library_instance('ute_tshark')
    ta5g_egate = BuiltIn().get_library_instance("ta5g_egate")
    ta5g_tshark.stop_tcpdump_on_remote_interface()
    ute_tshark.teardown_all_aliases_for_tshark()
    ta5g_syslog.collect_syslog_results()
    ta5g_syslog.teardown_all_aliases_for_syslog()
    ta5g_egate._ute_wtssim_instance.teardown_all_aliases_for_wts()
    test_prefix = get_test_prefix()
    copy_egate_console_log_to_specified_dir(subdirectory=test_prefix, prefix=test_prefix)
    common_gnb.collect_scf_file(prefix="after", subdir=test_prefix, name=test_prefix)


def cleanup_logs_dir_at_teardown():
    dest_dir = create_dir_at_output_dir(dir_name=get_test_prefix() + "/ta_messaging_processing")
    log_output_dir = ta5g_interface_tools().get_robot_output_dir()
    files = [file for prefix in ['csv*', 'messaging*', 'PARSED*'] for file in
             glob.glob(os.path.join(log_output_dir, prefix))]
    for file in files:
        logger.info("Move {} to {}".format(file, dest_dir))
        shutil.move(file, dest_dir)


