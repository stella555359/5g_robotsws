from variables import *


class UnhandledVariableAssignmentForUnit(Exception):
    pass


def set_variables_based_on_deployment_and_release():
    capacity_unit = common_gnb.get_capability_unit_name()
    release = common_gnb.get_gnb_build_release(convert_to_trunk=True)
    release_no_conv = common_gnb.get_gnb_build_release(convert_to_trunk=False)
    pm_interval = pm_counters.get_measurement_period_from_scf()
    pm_interval = int(pm_interval.replace('min', ''))
    BuiltIn().set_suite_variable("${PM_PERIOD}", pm_interval)
    BuiltIn().set_suite_variable("${UNIT_NAME}", capacity_unit)
    BuiltIn().set_suite_variable("${RELEASE}", release)
    BuiltIn().set_suite_variable("${RELEASE_NO_CONV}", release_no_conv)


def get_test_prefix():
    tc_name = ta5g_interface_tools().get_robot_test_name()
    match = re.search(r'CB00(?P<feature>8204)_(?P<fsplit>\w)(?P<tc>\d+)_.*', tc_name)
    prefix = "{}_{}{}".format(match.group("feature"), match.group("fsplit"), match.group("tc")) if match else tc_name
    BuiltIn().set_test_variable("${TEST_PREFIX}", prefix)
    return prefix


def ensure_gnb_files_flags_are_in_order():
    common_gnb.ensure_syslog_flags_existence_in_swconfig()
    common_gnb.ensure_cplane_flags_existence_in_swconfig()
    common_gnb.ensure_cp_runtime_ini_has_LoggingSeverity_set_on_trace()
    GnbSwconfigManager().log_swconfig_contents()


