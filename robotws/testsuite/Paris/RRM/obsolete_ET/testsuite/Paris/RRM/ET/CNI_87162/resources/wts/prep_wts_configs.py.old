def create_wts_config_for_lo_nsa():
    new_wts_config_name = "wts_CNI_87162_LO_NSA.cfg"
    wts_conf_instance = _load_default_wts_config()
    wts_conf_instance.modify(command="enb_endc_param id=1", modification="serving_cell_index_range_scg=8:14")
    wts_conf_instance.modify(command="set_cell id=1 gnb=2", modification="nr_arfcn=640000:640000 gscn=7915")
    wts_conf_instance.modify(command="set_cell id=2 gnb=2", modification="nr_arfcn=650000:650000 gscn=8019")
    wts_conf_instance.modify(
        command="ue_param id=101",
        modification="ue_nr_capabilities={} dual_conn=eutra_nr ue_eutra_nr_capabilities={}".format(
            UE_CAPABILITIES_CA, UE_CAPABILITIES_NSA_CA_EUTRA)
    )

    new_config_path = _get_and_set_new_wts_config_path(new_wts_config_name)
    wts_conf_instance.save_wts_cfg(new_config_path)


