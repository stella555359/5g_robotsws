def create_wts_config_for_mu_mimo_sc1_sc2():
    new_wts_config_name = "wts_CNI_87162_LO_SC1_SC2_MU-MIMO.cfg"
    wts_conf_instance = _load_default_wts_config()
    wts_conf_instance.insert(command="set UE_Capa_CA={}".format(UE_CAPABILITIES_CA),
                             location="BEFORE",
                             reference="set_ue simulated id=1")
    wts_conf_instance.modify(command="set_cell id=1 gnb=2", modification="nr_arfcn=640000:640000 gscn=7915 tac=0")
    wts_conf_instance.modify(command="set_cell id=2 gnb=2", modification="nr_arfcn=650000:650000 gscn=8019 tac=0 ")
    wts_conf_instance.modify(command="set_ue simulated id=1", modification="nia=null+zuc nea=null+zuc cell=1")
    wts_conf_instance.modify(command="set_ue simulated id=2", modification="nia=null+zuc nea=null+zuc cell=1")
    wts_conf_instance.modify(command="ue_param id=1", modification="ue_nr_capabilities=$UE_Capa_CA")
    wts_conf_instance.modify(command="ue_param id=2", modification="ue_nr_capabilities=$UE_Capa_CA")
    wts_conf_instance.modify(command="set_pdu_gateway id=2", modification="ue_nat_ip=72.24.0.1")

    wts_conf_instance.delete(command="set_cell id=3 gnb=2")
    wts_conf_instance.delete(command="set_cell id=4 gnb=2")
    for cell_3_ue in range(51, 61):
        wts_conf_instance.delete(command=f"set_ue simulated id={str(cell_3_ue)}")
        wts_conf_instance.delete(command=f"ue_param id={str(cell_3_ue)}")
    for cell_4_ue in range(71, 81):
        wts_conf_instance.delete(command=f"set_ue simulated id={str(cell_4_ue)}")
        wts_conf_instance.delete(command=f"ue_param id={str(cell_4_ue)}")
    new_config_path = _get_and_set_new_wts_config_path(new_wts_config_name)
    wts_conf_instance.save_wts_cfg(new_config_path)


