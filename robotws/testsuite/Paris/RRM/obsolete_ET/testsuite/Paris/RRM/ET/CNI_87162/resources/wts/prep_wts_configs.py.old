import logging
from robot.libraries.OperatingSystem import OperatingSystem
from robot.libraries.BuiltIn import BuiltIn
from taf.config.wts import wts as wts_config
import os
from ue_caps_vars import *


def _load_default_wts_config(path=None):
    if path is None:
        default_wts_config_path = BuiltIn().get_variable_value("${DEFAULT_WTS_CONFIG_PATH}")
    else:
        default_wts_config_path = path
    wts_conf_instance = wts_config()
    wts_conf_instance.load_wts_cfg(default_wts_config_path)
    return wts_conf_instance


def _get_and_set_new_wts_config_path(wts_config_filename):
    new_config_path = os.path.join(BuiltIn().get_variable_value("${EPCSIM_DIR_PATH}"), wts_config_filename)
    logging.info(new_config_path)
    BuiltIn().set_test_variable("${WTS_CONFIG_PATH}", new_config_path)
    return new_config_path


def create_wts_config_for_boo_basic():
    new_wts_config_name = "wts_CNI_87162_BOO_BASIC.cfg"
    wts_conf_instance = _load_default_wts_config()
    old_uecaps = wts_conf_instance.get_parameter(command="set", parameter="SA_Capa_Full")
    wts_conf_instance.modify(command="set SA_Capa_Full={}".format(old_uecaps),
                             modification="SA_Capa_Full={}".format(UE_CAPABILITIES_BOO_BASIC))

    new_config_path = _get_and_set_new_wts_config_path(new_wts_config_name)
    wts_conf_instance.save_wts_cfg(new_config_path)


def create_wts_config_for_dss():
    new_wts_config_name = "wts_CNI_87162_DSS.cfg"
    wts_conf_instance = _load_default_wts_config()

    wts_conf_instance.insert(command="set UE_Capa_CA={}".format(UE_CAPABILITIES_CA), location="BEFORE",
                             reference="set_enb id=1")
    wts_conf_instance.insert(command="set UE_Capa_Common={}".format(UE_CAPABILITIES_WITHOUT_CA), location="BEFORE",
                             reference="set_enb id=1")
    wts_conf_instance.insert(command="set SA_Capa_DSS={}".format(UE_CAPABILITIES_DSS_CA), location="BEFORE",
                             reference="set_enb id=1")
    wts_conf_instance.insert(command="set UE_CAPA_4CC={}".format(UE_CAPABILITIES_4CC), location="BEFORE",
                             reference="set_enb id=1")

    wts_conf_instance.modify(command="set_cell id=1 gnb=2", modification="nr_arfcn=640000:640000 gscn=7915")
    wts_conf_instance.modify(command="set_cell id=2 gnb=2", modification="nr_arfcn=650000:650000 gscn=8019")
    wts_conf_instance.modify(command="set_cell id=3 gnb=2", modification="nr_arfcn=349000:431000 gscn=5386")
    wts_conf_instance.modify(command="ue_param id=1", modification="ue_nr_capabilities=$UE_Capa_CA")
    wts_conf_instance.modify(command="ue_param id=71", modification="ue_nr_capabilities=$SA_Capa_DSS")
    wts_conf_instance.modify(command="ue_param id=72", modification="ue_nr_capabilities=$UE_CAPA_4CC")

    wts_conf_instance.modify(command="set_enb id=1", modification="id=2 enb_id_macro=0x00001 xp_management=on "
                             "xp=$ENB1_X2_ADDR:32742 xpu=$ENB1_X2_ADDR x2=$ENB1_X2_ADDR")
    wts_conf_instance.modify(command="enb_param id=1", modification="id=2")
    wts_conf_instance.delete(command="set_cell id=1 enb=1")
    wts_conf_instance.insert(command="set_cell id=1 enb=2 bw=20MHz eci=0x0000101 pci=3:2 tac=222 "
                             "proxy=$DAEMON_IP:12219|$DAEMON_IP:8889 earfcn=68735:133280 mandatory_for_activation=off",
                             location="AFTER", reference="enb_param id=2")
    wts_conf_instance.modify(command="enb_endc_param id=1", modification="id=2 serving_cell_index_range_scg=8:14")
    wts_conf_instance.modify(command="set_gnb id=2",
                             modification="id=1 xp_management=on xp=10.0.1.2:32742 xpu=10.0.1.2:32742")
    set_cell_cmds = wts_conf_instance.find_all("set_cell gnb=2")
    for cmd in set_cell_cmds:
        wts_conf_instance.modify(command=cmd, modification="gnb=1")
    set_ue_cmds = wts_conf_instance.find_all("set_ue simulated enb=2")
    for cmd in set_ue_cmds:
        wts_conf_instance.modify(command=cmd, modification="enb=1")
    wts_conf_instance.modify(command="trace enb=1", modification="enb=2")

    new_config_path = _get_and_set_new_wts_config_path(new_wts_config_name)
    wts_conf_instance.save_wts_cfg(new_config_path)


