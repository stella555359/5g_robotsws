# --------------------------------------------------------------------------------------------------------------------------------------------------
Documentation     [SUITE PURPOSE]   CB008375-H-UPD002 Test suite
...               \nPrerequisite : gNB configured with x Cells T+F & RU detected
#                   Scope        :
#
...               \nTest Case Scenario author : vincent.boulet@nokia.com
...               \nCreation Date             : 2024-09-26
...               \nModified Date             : 2025-06-09
#
#                 Version    Date       Author                          Notes
#                   0.1      FB2420     vincent.boulet@nokia.com        Creation robot and TC for SA
#                   0.2      FB2420     vincent.boulet@nokia.com        Test Teardown is introduced with KW Procedure Scout Data
#                   1.0      FB2504     vincent.boulet@nokia.com        Updates to parameter settings and results verification
#                   1.1      FB2507     vincent.boulet@nokia.com        Update of the results check because SYSLOG parameter names have changed
#                   1.2      FB2511     vincent.boulet@nokia.com        Update of the results check because SYSLOG message has changed
...               \n2.0      FB2512     vincent.boulet@nokia.com        Parameter name change for actPdcpRlcBufCongestionMechsm since SBTS25R3
# --------------------------------------------------------------------------------------------------------------------------------------------------

#vbo#stop#        > code to stop test execution by forcing an error:    Should Be True    ${True} == ${False}    or    Return From Keyword
#vbo#debug#       >> temporarily commented out so as not to execute the corresponding debugging command

# Libraries

# Resources
Resource                              ./resources/robot/CB008375-C-Keywords.robot

# Tags
#vbo#n/a#Force Tags                   CA_5G_SW_FR-Villarceaux    RRM    PY39    CONFIGURED    5G_RAN    RAN_5G

# Suites
Suite Setup                           Suite Setup Common Private    keep_all_data_in_file=${True}
Suite Teardown                        Suite Teardown
Test Teardown                         Test Teardown Common Private

*** Variables ***
# tests settings
&{CB008375_H_UPD002_basic}            capture_duration=0            # capture duration during traffic starting phase
...                                   deviation=25                  # default deviation for throughput and double for uplink
...                                   dir=DL+UL                     # direction for supported traffic
...                                   duration=3                    # traffic duration during declaration phase
...                                   pm_waiting_period=0           # number of waiting periods added for observation
...                                   target_gnb=2                  # gnb target id
...                                   test_name=TC_CB008375_H_UPD002_SA
...                                   total_nb_cell=4               # total number of cell used for ue's dispatching
...                                   total_nb_ue=4                 # total number of ue's to configure

# ue's settings # configuration
&{dict_settings_H_UPD002_ue_1}        ue_id=1                       # FIRST_SA_UE_ID TDD cell 1 or ${Dict_1st_SA_UE_Id[NRCELL-1]}
...                                   original_cell=1               # original cell for call establishment
...                                   throughput=5                  # dl throughput nonGBR
...                                   throughput_ul=2               # ul throughput nonGBR

&{dict_settings_H_UPD002_ue_2}        ue_id=21                      # FIRST_SA_UE_ID TDD cell 2
...                                   original_cell=2               # original cell for call establishment
...                                   throughput=5                  # dl throughput nonGBR
...                                   throughput_ul=2               # ul throughput nonGBR

&{dict_settings_H_UPD002_ue_3}        ue_id=51                      # FIRST_SA_UE_ID FDD cell 3
...                                   original_cell=3               # original cell for call establishment
...                                   throughput=5                  # dl throughput nonGBR
...                                   throughput_ul=2               # ul throughput nonGBR

&{dict_settings_H_UPD002_ue_4}        ue_id=71                      # FIRST_SA_UE_ID FDD cell 4
...                                   original_cell=4               # original cell for call establishment
...                                   throughput=5                  # dl throughput nonGBR
...                                   throughput_ul=2               # ul throughput nonGBR

@{dict_settings_H_UPD002_ues}         ${dict_settings_H_UPD002_ue_1}
...                                   ${dict_settings_H_UPD002_ue_2}
...                                   ${dict_settings_H_UPD002_ue_3}
...                                   ${dict_settings_H_UPD002_ue_4}
# --------------------------------------------------------------------------------------------------------------------------------------------------
*** Keywords ***
Set SCF CB008375-H-UPD002 Parameters
    [Arguments]             ${dist_name_nrbts}
    ...                     ${val_actPdcpRlcBufCongestionMechsm}=${None}
    ...                     ${val_bopNumPdcpSduDiscard}=${None}
    ...                     ${val_bopThNonCriticalTraffic}=${None}
    ...                     ${val_bopNumRlcSduDiscard}=${None}
    ...                     ${scf_suffix}=x

    @{list_nidd_param}=               Create List
    # NRBTS.actPdcpRlcBufCongestionMechsm or NRBTS.actPdcpRlcBufCongOvlMech #
    &{dico_buf_congestion_mechsm}=    Run Keyword If    "${val_actPdcpRlcBufCongestionMechsm}" != "${None}" and "${branch_version}" == "SBTS00"
    ...                               Create Dictionary    parameter=actPdcpRlcBufCongOvlMech    dist_name=${dist_name_nrbts}
    ...                               value=${val_actPdcpRlcBufCongestionMechsm}
    ...                               ELSE IF    "${val_actPdcpRlcBufCongestionMechsm}" != "${None}" and "${branch_version}" == "SBTS25R3"
    ...                               Create Dictionary    parameter=actPdcpRlcBufCongestionMechsm    dist_name=${dist_name_nrbts}
    ...                               value=${val_actPdcpRlcBufCongestionMechsm}
    ...                               ELSE
    ...                               Create Dictionary    parameter=actPdcpRlcBufCongestionMechsm    dist_name=${dist_name_nrbts}
    ...                               value=${val_actPdcpRlcBufCongestionMechsm}
    Run Keyword If    "${val_actPdcpRlcBufCongestionMechsm}" != "${None}"    Append To List    ${list_nidd_param}    ${dico_buf_congestion_mechsm}
    # NRBTS.bopNumPdcpSduDiscard #
    &{dico_bop_num_pdcp_sdu_discard}=    Run Keyword If    "${val_bopNumPdcpSduDiscard}" != "${None}"    Create Dictionary
    ...                                                             parameter=bopNumPdcpSduDiscard
    ...                                                             dist_name=${dist_name_nrbts}    value=${val_bopNumPdcpSduDiscard}
    Run Keyword If    "${val_bopNumPdcpSduDiscard}" != "${None}"    Append To List    ${list_nidd_param}    ${dico_bop_num_pdcp_sdu_discard}
    # NRBTS.bopThNonCriticalTraffic #
    &{dico_bop_th_non_crit_traffic}=    Run Keyword If    "${val_bopThNonCriticalTraffic}" != "${None}"    Create Dictionary
    ...                                                             parameter=bopThNonCriticalTraffic
    ...                                                             dist_name=${dist_name_nrbts}    value=${val_bopThNonCriticalTraffic}
    Run Keyword If    "${val_bopThNonCriticalTraffic}" != "${None}"    Append To List    ${list_nidd_param}    ${dico_bop_th_non_crit_traffic}
    # NRBTS.bopNumRlcSduDiscard #
    &{dico_bop_num_rlc_sdu_discard}=    Run Keyword If    "${val_bopNumRlcSduDiscard}" != "${None}"    Create Dictionary
    ...                                                             parameter=bopNumRlcSduDiscard
    ...                                                             dist_name=${dist_name_nrbts}    value=${val_bopNumRlcSduDiscard}
    Run Keyword If    "${val_bopNumRlcSduDiscard}" != "${None}"    Append To List    ${list_nidd_param}    ${dico_bop_num_rlc_sdu_discard}

    ${current_date}=                  DateTime.Get Current Date    result_format=%Y%m%d
    Run Keyword If    "${list_nidd_param}" != "${EMPTY}" and not ${isAic}
    ...                               Oam.OAM Set Params    oam=${GNB_DU.oam}    modify_param=${list_nidd_param}    timeout=600
    Oam.OAM Get SCF File              oam=${GNB_DU.oam}    file=SCF_DU_set_parameters_${scf_suffix}.xml
    Run                               command=rm -f ${LOG_PATH}/scf_${current_date}*.xml
    Run                               command=rm -f ${LOG_PATH}/update_${current_date}*.json
# --------------------------------------------------------------------------------------------------------------------------------------------------
*** Test Cases ***
[1] CB008375-SR-H-UPD002_B05_GTPU_overload_control_configuration_on_line_modifiable
# --------------------------------------------------------------------------------------------------------------------------------------------------
    #vbo#n/a#[Tags]    CLOUD_5G_I_LO_AP_LO    VARIANT_SANSA_FS_CPRI_CMWV_FDD+ECPRI_CMWV_TDD_AEQE_GMC    SBTS00

    Dated Log                         ----Test initialization-------------------------------------------------------
    GenericTest.Init Sequence         param=${CB008375_H_UPD002_basic}
    ${branch_version}=                Set Variable    ${TLConfig.topo.getBranchName()}
    Set Suite Variable                ${branch_version}
    Dated Log New Line                > Test name is ${param.test_name}
    ${dict_settings_basic}=           Set Variable    @{dict_settings_H_UPD002_ues}

    # definition of the dist_name objects
    ${dist_name_mrbts}=               Set Variable    MRBTS-${TMRBTS_ID[0]}
    #vbo#debug#Dated log              >> dist_name_mrbts is ${dist_name_mrbts}
    ${dist_name_nrbts}=               Set Variable    ${dist_name_mrbts}/NRBTS-${TNRBTS_ID[0]}
    Dated log                         > dist_name_nrbts is ${dist_name_nrbts}

    Dated Log                         ----Get Parameters From Any Of SCF: default values---
    ${def_actPdcpRlcBufCongestionMechsm}=    Run Keyword If    "${branch_version}" == "SBTS00" or "${branch_version}" == "SBTS25R3"
    ...                               Oam.OAM Get Param From Any Of SCF    param=actPdcpRlcBufCongOvlMech    dist_name=${dist_name_nrbts}
    ...                               current_scf=${scf_suite_setup_backup}
    ...                               ELSE
    ...                               Oam.OAM Get Param From Any Of SCF    param=actPdcpRlcBufCongestionMechsm    dist_name=${dist_name_nrbts}
    ...                               current_scf=${scf_suite_setup_backup}
    Run Keyword If    "${branch_version}" == "SBTS00" or "${branch_version}" == "SBTS25R3"
    ...    Dated log                  > default actPdcpRlcBufCongOvlMech= ${def_actPdcpRlcBufCongestionMechsm}
    ...                               ELSE
    ...    Dated log                  > default actPdcpRlcBufCongestionMechsm= ${def_actPdcpRlcBufCongestionMechsm}
    ${def_pdcpBufUsageThreshold}=     Oam.OAM Get Param From Any Of SCF    param=pdcpBufUsageThreshold
    ...                                                             dist_name=${dist_name_nrbts}    current_scf=${scf_suite_setup_backup}
    Dated log                         > default pdcpBufUsageThreshold= ${def_pdcpBufUsageThreshold}
    ${def_bopNumPdcpSduDiscard}=      Oam.OAM Get Param From Any Of SCF    param=bopNumPdcpSduDiscard
    ...                                                             dist_name=${dist_name_nrbts}    current_scf=${scf_suite_setup_backup}
    Dated log                         > default bopNumPdcpSduDiscard= ${def_bopNumPdcpSduDiscard}
    ${def_rlcBufUsageThreshold}=      Oam.OAM Get Param From Any Of SCF    param=rlcBufUsageThreshold
    ...                                                             dist_name=${dist_name_nrbts}    current_scf=${scf_suite_setup_backup}
    Dated log                         > default rlcBufUsageThreshold= ${def_rlcBufUsageThreshold}
    ${def_bopThNonCriticalTraffic}=    Oam.OAM Get Param From Any Of SCF    param=bopThNonCriticalTraffic
    ...                                                             dist_name=${dist_name_nrbts}    current_scf=${scf_suite_setup_backup}
    Dated log                         > default bopThNonCriticalTraffic= ${def_bopThNonCriticalTraffic}
    ${def_bopNumRlcSduDiscard}=       Oam.OAM Get Param From Any Of SCF    param=bopNumRlcSduDiscard
    ...                                                             dist_name=${dist_name_nrbts}    current_scf=${scf_suite_setup_backup}
    Dated log                         > default bopNumRlcSduDiscard= ${def_bopNumRlcSduDiscard}

    # Definition of the 3 NRBTS.bop parameters to be reconfigured to verify online changes. Values must be different from default values
    Dated Log                         ----Preliminary checks of parameter values before modifications---
    ${val_bopNumPdcpSduDiscard}=      Set Variable    8
    Should Be True                    "${def_bopNumPdcpSduDiscard}" != "${val_bopNumPdcpSduDiscard}"
    ${val_bopThNonCriticalTraffic}=   Set Variable    80
    Should Be True                    "${def_bopThNonCriticalTraffic}" != "${val_bopThNonCriticalTraffic}"
    ${val_bopNumRlcSduDiscard}=       Set Variable    10
    Should Be True                    "${def_bopNumRlcSduDiscard}" != "${val_bopNumRlcSduDiscard}"

    Run Keyword If    "${branch_version}" == "SBTS00" or "${branch_version}" == "SBTS25R3"    Run Keywords
    ...    Dated Log                  ----Set SCF NRBTS.actPdcpRlcBufCongOvlMech to bufferOverflow---
    ...    AND    Critical Step       Set SCF CB008375-H-UPD002 Parameters    dist_name_nrbts=${dist_name_nrbts}
    ...                               val_actPdcpRlcBufCongestionMechsm=11    scf_suffix=0
    ...                               ELSE    Run Keywords
    ...    Dated Log                  ----Set SCF NRBTS.actPdcpRlcBufCongestionMechsm to bufferOverflowProtection---
    ...    AND    Critical Step       Set SCF CB008375-H-UPD002 Parameters    dist_name_nrbts=${dist_name_nrbts}
    ...                               val_actPdcpRlcBufCongestionMechsm=bufferOverflowProtection    scf_suffix=0
    #vbo#Critical Step                Restart.Restart TL

    # Configure the current setting for all the ue's
    ${param.total_nb_ue}=    Run Keyword If    ${CALL_ENABLED}    Get Length    ${dict_settings_basic}
    ...                                  ELSE    Set Variable    0
    Dated Log                         ----Configure the settings of all the ue's------------------------------------
    @{list_ue}=                       Create List
    @{cell_id_for_streaming}=         Create List
    FOR    ${current_id}    IN RANGE    0    ${param.total_nb_ue}
        ${current_ue_setting}=        Copy Dictionary     ${BASIC_UE_SA}
        Set To Dictionary             ${current_ue_setting}    ue    ${dict_settings_basic[${current_id}].ue_id}
        Set To Dictionary             ${current_ue_setting}    trf_id    1
        Set To Dictionary             ${current_ue_setting}    pdu    1
        Set To Dictionary             ${current_ue_setting}    target_gnb    ${param.target_gnb}
        # Dispatching the ue on the requested original cell for the call establishment
        Set To Dictionary             ${current_ue_setting}    target_cells    ${dict_settings_basic[${current_id}].original_cell}
        # Disabling TTI #Append To List                ${cell_id_for_streaming}    ${current_ue_setting.target_cells}
        # Set the correct requested throughput per ue
        Set To Dictionary             ${current_ue_setting}    throughput    ${dict_settings_basic[${current_id}].throughput}
        Set To Dictionary             ${current_ue_setting}    throughput_ul    ${dict_settings_basic[${current_id}].throughput_ul}
        Append To List                ${list_ue}    ${current_ue_setting}
    END
    Dated Log                         > UE's list is ${list_ue}
    Dated Log                         > Cells list for TTI streaming is ${cell_id_for_streaming}
    ${length_list_for_streaming}=     Get Length    ${cell_id_for_streaming}

    # Start SYSLOG capture during call setup
    ${syslog}=    Run Keyword If    ${AUTO_SAVE_DEBUG_DATA} and not ${isAic}
    ...                               Syslogs.SYSLOG Start    host=${GNB_DU.sys[0].M}    name=_call_setup

    # Setup wtsemu SA for all the ue's
    Critical Step                     CallSetup.Setup Wtsemu SA     nbUe=${param.total_nb_ue}
    ...                                                             nbSaUe=${param.total_nb_ue}
    ...                                                             shouldUseLua=${False}
    ...                                                             nbCell=${param.total_nb_cell}
    ...                                                             list_of_UE_tobe_created=${list_ue}

    # WA to avoid alarm on cells
    Traced Sleep                      duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    Step                              CallSetup.WTS Set X2 Link

    @{cell_id_list}=    Run Keyword If    not ${isAic}    Create List    ELSE    Set Variable    ${cell_id_for_streaming}
    @{cellsNr}=         Run Keyword If    not ${isAic}    Oam.OAM Get Cells Nr    oam=${GNB_DU.oam}    ELSE    Create List
    #vbo#debug#Dated Log              >> CellsNr=@{cellsNr}
    FOR    ${current_cell}    IN    @{cellsNr}
        #vbo#debug#Dated Log          >> cell NR is ${current_cell}
        #vbo#debug#Dated Log          >> internal distname ${current_cell['id']['internal']}
        ${cell_status_}=              Set variable  ${current_cell['status']}
        ${operationalState}=          Set Variable   ${cell_status_['operationalState']}
        #vbo#debug#Dated Log          >> operationalState for DN [${current_cell['id']['internal']}] is ${operationalState}
        ${globalCellId}=              Set Variable   ${current_cell['globalCellId']}
        ${is_global_cell_id}=    Is Global Cell Id Retained For Streaming    global_cell_id=${globalCellId}    cell_list=${cell_id_for_streaming}
        Run Keyword If    ${is_global_cell_id}    Append to List    ${cell_id_list}    ${current_cell['id']['internal']}
    END
    Dated Log                         > Distname list of the cells retained for TTI streaming ${cell_id_list}

    # Capture TTI traces during call setup
    Run Keyword If    ${length_list_for_streaming} > 0    Start TTI Logs Common    cell_id_list=${cell_id_list}

    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                          CallSetup.UE Register    ue=${current_elem.ue}    depends=CallSetup.Setup Wtsemu SA
        Step                          CallSetup.Launch PDU Session    ue=${current_elem.ue}    pdu=${current_elem.pdu}    gw=${current_elem.ue}
        ...                           depends=CallSetup.UE Register
    END

    Run Keyword If    ${length_list_for_streaming} > 0    Step    Stop and Get TTI Logs Common    trace_name=TTI_call_setup
    ${capture_tti_output}=            Set Variable    ${LOG_PATH}/TTITraces/TTI_call_setup.json
    Run Keyword If    ${AUTO_SAVE_DEBUG_DATA} and not ${isAic}    Step    Syslogs.SYSLOG Stop    syslog=${syslog}

    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput} > ${NO_THROUGHPUT}
        ...    Step                   ${param.dir} Traffic Not Stopped Common    param=${param}    current_ue_setting=${current_elem}
        ...                           depends=CallSetup.Launch PDU Session
    END

    # Capture TTI traces during traffic
    Run Keyword If    ${length_list_for_streaming} > 0    Run Keywords    Start TTI Logs Common    cell_id_list=${cell_id_list}
    ...    AND                        Traced Sleep    duration=8s    msg=call with traffic for TTI trace
    ...    AND                        Step    Stop and Get TTI Logs Common    trace_name=TTI_traffic
    ${capture_tti_output}=            Set Variable    ${LOG_PATH}/TTITraces/TTI_traffic.json

    Run Keyword If    ${param.pm_waiting_period} > 0    Wait PM availability    pmPeriodSec=300    #pmAvailDelay=60 #Sleep Until PM Availability

    Dated Log                         ----Get number of actives alarms during calls with traffic----
    ${initial_number_of_alarm}=       Get Number Of Alarm

    # case 1. NRBTS.bopNumPdcpSduDiscard modification
    ${syslog_log}=                    Set Variable    ${LOG_PATH}/SYSLOG/*_on_line_modif_1.log
    ${syslog}=    Run Keyword If    not ${isAic}    Syslogs.SYSLOG Start    host=${GNB_DU.sys[0].M}    name=_on_line_modif_1
    Dated Log                         ----Case 1. set SCF NRBTS.bopNumPdcpSduDiscard to ${val_bopNumPdcpSduDiscard}----
    Critical Step                     Set SCF CB008375-H-UPD002 Parameters    dist_name_nrbts=${dist_name_nrbts}
    ...                                                             val_bopNumPdcpSduDiscard=${val_bopNumPdcpSduDiscard}    scf_suffix=1
    Dated Log                         ----Get actives alarms after modifications case 1----
    Sleep                             5s
    @{case_1_alarms}=                 Oam.OAM Get Active Alarms    oam=${GNB_DU.oam}
    ${case_1_number_of_alarm}=        Get Length    ${case_1_alarms}
    FOR    ${i}    IN RANGE    0    ${case_1_number_of_alarm}
        Dated Log                     > GNB_DU_OAM_ALARM[${i}]=${case_1_alarms}[${i}]
    END
    Run Keyword If    not ${isAic}    Step    Syslogs.SYSLOG Stop    syslog=${syslog}
    ${expression}=    Run Keyword If    "${branch_version}" == "SBTS00" or "${branch_version}" == "SBTS25R3"
    ...                               Catenate    "received.*bufferCongestionDiscardMechanism.*
    ...                                                             bufferDiscardTrigger.*
    ...                                                             numSduDiscardForOvf.*${val_bopNumPdcpSduDiscard}.*
    ...                                                             bufferCongDiscardThreshold.*${def_pdcpBufUsageThreshold}"
    ...                           ELSE
    ...                               Catenate    "received.*bufferCongestionDiscardMechanism:.*
    ...                                                             bufferDiscardTrigger.*
    ...                                                             bufferDiscardThreshold.*${def_pdcpBufUsageThreshold}.*
    ...                                                             numSduDiscard.*${val_bopNumPdcpSduDiscard}"
    ${expression}=                    String.Replace string    ${expression}    ${SPACE}    ${EMPTY}
    ${cmd}=                           Catenate    grep -c ${expression} ${syslog_log}
    Dated Log                         >> ${cmd}
    ${result}=                        Execute Command And Check Content    command=${cmd}
    Dated Log                         > check is passed because SYSLOG result case 1= ${result} and > 0
    Should Be True                    ${initial_number_of_alarm} == ${case_1_number_of_alarm}

    # case 2. NRBTS.ThNonCriticalTraffic + NRBTS.bopNumRlcSduDiscard modifications
    ${syslog_log}=                    Set Variable    ${LOG_PATH}/SYSLOG/*_on_line_modif_2.log
    ${syslog}=    Run Keyword If    not ${isAic}    Syslogs.SYSLOG Start    host=${GNB_DU.sys[0].M}    name=_on_line_modif_2
    Dated Log                         ----Case 2. set SCF NRBTS.ThNonCriticalTraffic to ${val_bopThNonCriticalTraffic}----
    Dated Log                         ----and NRBTS.bopNumRlcSduDiscard to ${val_bopNumRlcSduDiscard}----
    Critical Step                     Set SCF CB008375-H-UPD002 Parameters    dist_name_nrbts=${dist_name_nrbts}
    ...                                                             val_bopThNonCriticalTraffic=${val_bopThNonCriticalTraffic}
    ...                                                             val_bopNumRlcSduDiscard=${val_bopNumRlcSduDiscard}    scf_suffix=2
    Dated Log                         ----Get actives alarms after modifications case 2----
    Sleep                             5s
    @{case_2_alarms}=                 Oam.OAM Get Active Alarms    oam=${GNB_DU.oam}
    ${case_2_number_of_alarm}=        Get Length    ${case_2_alarms}
    FOR    ${i}    IN RANGE    0    ${case_2_number_of_alarm}
        Dated Log                     > GNB_DU_OAM_ALARM[${i}]=${case_2_alarms}[${i}]
    END
    Run Keyword If    not ${isAic}    Step    Syslogs.SYSLOG Stop    syslog=${syslog}
    ${expression}=    Run Keyword If    "${branch_version}" == "SBTS00" or "${branch_version}" == "SBTS25R3"
    ...                               Catenate    "received.*bufferCongestionDiscardMechanism.*commonBufferCongestionDiscardMechanism.*
    ...                                                             bufferDiscardTrigger.*
    ...                                                             numSduDiscardForOvf.*${val_bopNumRlcSduDiscard}.*
    ...                                                             bopThNonCriticalTraffic.*${val_bopThNonCriticalTraffic}"
    ...                           ELSE
    ...                               Catenate    "received.*duBufferCongestionDiscardMechanism.*commonBufferCongestionDiscardMechanism.*
    ...                                                             bufferDiscardTrigger.*
    ...                                                             numSduDiscard.*${val_bopNumRlcSduDiscard}.*
    ...                                                             bopThNonCriticalTraffic.*${val_bopThNonCriticalTraffic}"
    ${expression}=                    String.Replace string    ${expression}    ${SPACE}    ${EMPTY}
    ${cmd}=                           Catenate    grep -c ${expression} ${syslog_log}
    Dated Log                         >> ${cmd}
    ${result}=                        Execute Command And Check Content    command=${cmd}
    Dated Log                         > check is passed because SYSLOG result case 2= ${result} and > 0
    Should Be True                    ${initial_number_of_alarm} == ${case_2_number_of_alarm}

    # Waiting time added for observation and allow generation of multiple count periods
    FOR    ${iteration_pm}    IN RANGE    0    ${param.pm_waiting_period}
        Wait PM availability    pmPeriodSec=300    #pmAvailDelay=60
        ${pm_path}=    Run Keyword If    not ${isAic}    Counters.Collect PM files from BTS    ${LOG_PATH}/PM
        Run Keyword If    not ${isAic}    Step    Check Counter And KPI Constraints Common    pm_path=${pm_path}    test_name=${param.test_name}
    END

    # Deregister all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                          CallSetup.UE Deregister    id=${current_elem.ue}    ue_deregister_type=switch_off    by=ue
        ...                           depends=CallSetup.UE Register
    END

    #[Teardown]    # Reserved to internal testing usage
# --------------------------------------------------------------------------------------------------------------------------------------------------
