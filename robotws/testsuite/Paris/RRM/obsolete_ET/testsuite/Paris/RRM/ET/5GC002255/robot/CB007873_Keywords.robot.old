*** Keywords ***

setup 7873
    ${yamlPath}    Set Variable    ${CURDIR}/../../../../../../custom-config/IBCA/5GC002255/SBTS00/custom_config_2255_BOOAPLOO.yaml
    Suite Setup from scratch        yamlPathname=${yamlPath}
    ...                             listBackupFiles=${FD_ALL}
    ...                             keepAllUeDataInCfgFile=${True}


teardown 7873
    CallSetup.Empty Buffer For Egate
    Traced sleep   10s  msg=wait 10s for flush
    CB007873_Keywords.Collect EGATE console Logs
	Setup.Suite Teardown       reset_ap=${True}


Cell_Setup_SA_2_Cells_1FDD_1TDD
    [Documentation]    Play SA Cell_setup with 2 cells 1 FDD + 1 TDD
    [Tags]  Cell_Setup

    ${timerEachCell}       Set Variable      10s
    ${nb}                  Set Variable      2
    CallSetup.Setup Wtsemu SA    nbCell=${nb}


Cell_Setup_NSA_2_Cells_1FDD_1TDD
    [Documentation]    Play SA Cell_setup with 2 cells 1 FDD + 1 TDD
    [Tags]  Cell_Setup

    ${timerEachCell}       Set Variable      10s
    ${nb}                  Set Variable      2
	${shouldUseLua}        Set Variable      False
    CallSetup.WTS Setup    nbCell=${nb}    shouldUseLua=${shouldUseLua}


UE_register_FDD_CA_Capable
    [Documentation]    start a set of ue_register done in parameter

    Dated log  Ue_id ${param.ue} is Registering
    CallSetup.UE Register  ue=${param.ue}


PDU_Session_FDD_CA_Capable
    [Documentation]    start a set of PDU_Session done in parameter

    Dated log  Ue_id ${param.ue} PDU session establishment on going
    CallSetup.Launch PDU Session  ue=${param.ue}  pdu=${param.ue}  gw=${param.ue}
    sleep   2s


4G_Attach_FDD_CA_Capable
    [Documentation]    start the 4G UE attach Procedure

    Dated log  Ue_id ${param.ue} 4G Attach on going
    Callsetup.UE Attach Enb  ueSetting=${param}
    sleep   5s


SG_Attach_FDD_CA_Capable
