	Dated log  Ue_id ${param.ue} sGNB Addition and 5G Attach on going
    Callsetup.UE Attach Gnb  ueSetting=${param}
    sleep   5s


Check_sCellToAddModList_onegateLogs
    [Documentation]    Check_sCellToAddModList_onegateLogs

    ${output}        SSH Wait For Connect and Cmd
    ...              command=grep "sCellToAddModList" ${tl.core.dir_path}/egate_console.log
    ...              host=${HOST_EPCSIM}
