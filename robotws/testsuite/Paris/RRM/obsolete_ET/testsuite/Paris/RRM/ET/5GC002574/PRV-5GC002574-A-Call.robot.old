Library           taf.sbts.oam.coam.admin            WITH NAME               coam
Library           ute_wtssim                        WITH NAME               wts
Library           ../resources/python/luashark_tools.py
Library           ../../../resources/SWENG/python/StringTool.py
Library           resources/python/Constants.py                WITH NAME               MyConstants
Library           ../resources/DSS/python/dss_tools.py         WITH NAME               nps_dss_tools
Library           resources/python/tools.py                    WITH NAME               nps_2574_tools
Library           ../resources/common/TtiTrace/python/ttitrace.py   WITH NAME          nps_ttitraces_tools

# SWENG resources
Resource          ../../../resources/SWENG/robot/GenericTest.robot

# TTI Traces resource
Resource          ../resources/common/TtiTrace/ttitrace.robot

# DSS common
Resource          ../resources/DSS/robot/common_Dss_Keywords.robot
Resource          ../resources/DSS/robot/common_Dss_command.robot
Resource          ../resources/DSS/robot/common_Dss_SA_NSA.robot

# 2574 specific
Resource            resources/robot/5GC002574_Kw_TestSetup.robot
Resource            resources/robot/5GC002574_keywords.robot

Variables           resources/python/Constants.py

Suite Setup         Run keywords
...                                MyConstants.hello           AND
...                                Test Suite Setup for 2574   AND
...                                Get gNB cell 5g On air      AND
...                                Prepare TL for TTITraces
Suite Teardown      Test suite teardown for 2574


*** Variables ***

${PATTERN_DL_70_SA_OK}       0001100010-0111101110-0011100010-0111101110-0011100010-0111101110-0011100010-0111101110
${PATTERN_DL_100_SA_OK}      1011110011-1111111111-1011110011-1111111111-1011110011-1111111111-1011110011-1111111111

*** Test Cases ***

TestLine_preparation
   [Tags]    FULL_RUN    Cellsetup     10MHZ
   5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A1}


TestLine_2574_Test_setup_10Mhz
   [Tags]    FULL_RUN    Cellsetup   FULL_CALL  10MHZ
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory
   5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A1}


# TC covered under New Feature
# [1]5GC002574-A3_TC11_NSA_CallSetup_SANSA_10MHz_DL_ratio_max_70_Check_Counters
[1]5GC002574-A3_TC_11_10MHz_5gCall_with_Traffic_NSA_Mode_DL_ratio_max_70_Check_Counters
   [Tags]    FULL_RUN     10MHZ    2574   2574_A3
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 70%, NSA 5g Call , DL Tput
   ...                 Check counter PRBs used for PDSCH (M55308C10001)
   ...                 Check counter PRBs available for PDSCH (M55308C10003)
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None                                 AND
   ...       set Suite Variable    ${dl_expect_tput_value}           50                                   AND
   ...       set Suite Variable    ${ul_expect_tput_value}           30                                   AND
   #         deviation need to take into account crm ul settings
   ...       set Suite Variable    ${deviation}                      10                                   AND
   ...       common_Dss_Keywords.Get testcase log directory                                               AND
   ...       Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0                                      AND
   ...       depends   TestLine_2574_Test_setup_10Mhz

   ${tc_name}        Set variable    TestLine_preparation
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...               5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A3_Counters}
   ${tc_name}        Set variable    TestLine_2574_Test_setup_10Mhz
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A3_Counters}

   ${msg}   Catenate   "5GC002574-A3_TC_10_5gCall_with_Traffic_NSA_Mode: sw release used [${convert_version}], Cellsetup Dss phase 3, BW= 10MHz,
   ...                DL RATIO = 70%, , NSA 5g Call , DL Tput\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                 Check counter PRBs used for PDSCH (M55308C10001)\n
   ...                 Check counter PRBs available for PDSCH (M55308C10003)"
   common_Dss_Keywords.Log Test description   ${msg}

   # Specific Setting for this test...
   # desactivate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS10Mhz_2574_A3_Counters}"

   # modification DL Ratio into the test param Ctx
   Update DSS DL pattern with     ${TestDSS10Mhz_2574_A3_Counters}     ${PATTERN_DL_70_SA_OK}
   Dated log       DL pattern into TestParam is ${TestDSS10Mhz_2574_A3_Counters.seq.dl_allocated_normal_subframes}

   # update CatM data with CatMinfo_10MHz_CatMData_CatMPaging_CatMSib1Br in Context
   Update CatMinfo with ${CatMinfo_10MHz_CatMData_CatMPaging_CatMSib1Br_DLRATIO_70} into "${TestDSS10Mhz_2574_A3_Counters}"

   # w/o superfast_allocation for the moment
   # Update DSS qos load meas timer with     ${TestDSS10Mhz_2574_A3}    ${dl_qos_load_meas_timer}=10    ${ul_qos_load_meas_timer}=30
   # Update DSS dl qos load meas timer "${10}" ms and ul qos load meas timer "${30}" ms into "${TestDSS10Mhz_2574_A1}"
   # Dated log       DL qos_load_meas_timer into TestParam is ${TestDSS10Mhz_2574_A1.seq.dl_qos_load_meas_timer} ms
   # Dated log       UL qos_load_meas_timer into TestParam is ${TestDSS10Mhz_2574_A1.seq.ul_qos_load_meas_timer} ms

   common_Dss_Keywords.Start Tcpdump on TestPc       interface=eth3    option=-s0 sctp or icmp
   TC 2574 NSA CellSetup                             ${TestDSS10Mhz_2574_A3_Counters}    egate_5GC002574_A3_TC11
   # add here the DL Pattern list to add to CRMSim and active it ....
   # => nothing

   TC 2574 5g NSA Call                                  ${TestDSS10Mhz_2574_A3_Counters}    egate_5GC002574_A3_TC11
   common_Dss_Keywords.Stop Tcpdump on TestPc           interface=eth3    target_dir=${testCaseDir}
   TC 2574 DL Tput NSA Mode wo Stopping dl Tput         ${TestDSS10Mhz_2574_A3_Counters}
   ...                                                  ul_rate=${ul_expect_tput_value}
   ...                                                  dl_rate=${dl_expect_tput_value}
   ...                                                  alias=egate_5GC002574_A3_TC11

   ${L1L2_Pcap_File}=   5GC002574_keywords.Get L1L2 traces    time=12s   prefix=L1L2Bip.wDLTput
   ${sum_prb}   ${sum_prb_5min}  ${dl_ratio}=    Sum NbrOfPrb pdschsendreq from L1L2 Pcap    ${TestDSS10Mhz_2574_A3_Counters}
   ...                                                                                       ${testCaseDir}/${L1L2_Pcap_File.name}.pcap
   # computed dl ratio not in line with Qos Dl Load Ind !!! Why ?
   ${dl_ratio}=   set variable    95

    # Sleep 15 mn in case of GP overlap - Traffic is still ongoing
    Traced Sleep   15 minutes     msg=counters GP overlap

    # Collect PM
    Run Keyword If        '${check_counters}' == '1'    run keywords   Dated log     =========> Collect PM Counters File    AND
    ...                                                                common_Dss_Keywords.Collect PM Counters File
    Run Keyword If        '${check_counters}' == '1'    run keywords   Dated log     =========> Check 2574 Counters         AND
    ...                                                                5GC002574_Keywords.Check 2574 Counters      sum_prb_over_5min=${sum_prb_5min}

    Check Tput over all period

    ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
    should contain	                ${output}	                            passed

    [Teardown]     Run Keywords       common_Dss_Keywords.Collect PM Counters file coam   target_dir=${testCaseDir}     AND
    ...                               Teardown 2574     alias=egate_5GC002574_A3_TC11                                   AND
    ...                               set Suite Variable  ${testCaseDir}  None


# TC covered under New Feature
# for 2574-A5
[1]5GC002574_A_TC_03_5gCall_with_Traffic_SA_Mode
   [Tags]    FULL_RUN     10MHZ    2574   2574_A3
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%, Fast DL Allocation, NSA 5g Call , DL/UL Tput
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None                                 AND
   ...       set Suite Variable    ${dl_expect_tput_value}           90                                   AND
   ...       set Suite Variable    ${ul_expect_tput_value}           30                                   AND
   #         as each 20ms Prb used  is flickering from 35 to 20, the check need to be done using following ul TP value
   ...       set Suite Variable    ${dl_expect_tput_value_for_TC03}  62                                   AND
   #         deviation need to take into account crm ul settings
   ...       set Suite Variable    ${deviation}                       10                                  AND
   ...       common_Dss_Keywords.Get testcase log directory                                               AND
   ...       common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp     AND
   ...       Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0                                      AND
   ...       depends   TestLine_7838_Test_setup


   ${tc_name}    Set variable    TestLine_preparation
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...                          5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A3}
   ${tc_name}    Set variable    TestLine_2574_Test_setup
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A3}

   # modification DL Ratio into the test param Ctx
   Update DSS DL pattern with     ${TestDSS10Mhz_2574_A3}     ${PATTERN_DL_100_SA_OK}
   Dated log       DL pattern into TestParam is ${TestDSS10Mhz_2574_A3.seq.dl_allocated_normal_subframes}
   # Update DSS qos load meas timer with     ${TestDSS10Mhz_2574_A3}    ${dl_qos_load_meas_timer}=10    ${ul_qos_load_meas_timer}=30
   Update DSS dl qos load meas timer "${10}" ms and ul qos load meas timer "${30}" ms into "${TestDSS10Mhz_2574_A3}"
   Dated log       DL qos_load_meas_timer into TestParam is ${TestDSS10Mhz_2574_A3.seq.dl_qos_load_meas_timer} ms
   Dated log       UL qos_load_meas_timer into TestParam is ${TestDSS10Mhz_2574_A3.seq.ul_qos_load_meas_timer} ms

   5GC002574_Kw_TestSetup.Update DSS superfast_allocation with "on" into "${TestDSS10Mhz_2574_A3}"
   Dated log       superfast_allocation into TestParam is ${TestDSS10Mhz_2574_A3.Context.superfast_allocation}

   # Specific Setting for this test
   # actRateMatchedCsiIm is mandatoy to setup 5GC002574-A
   Set 2574 Specifc Scf Param actRateMatchedCsiIm with "false" value

   5GC002574_keywords.TC DSS Phase3 CellSetup         ${TestDSS10Mhz_2574_A3}    egate_TC3
   # add here the DL Pattern list to add to CRMSim and active it ....
   DSS_5g_Periodic_DL_Fast_Allocation           ${TestDSS10Mhz_2574_A3}    egate_TC3

   TC 2574 5g SA Call                           ${TestDSS10Mhz_2574_A3}    egate_TC3
   common_Dss_SA_NSA.DSS_5g_SA_UL_DL_Traffic      ${TestDSS10Mhz_2574_A3}
   ...                                             ul_rate=${ul_expect_tput_value}
   ...                                             dl_rate=${dl_expect_tput_value}
   ...                                             alias=egate_TC3

   Traced Sleep    5s      msg=Waiting for UL/DL Tput

   Start capture Backhaul XP for DSS
   Traced Sleep    1s      msg=Waiting for Xp pcap traces
   Dated log             Point AF_PATH and ENB_BUILD to local luashark XP package
   Point AF_PATH to local luashark XP package
   Point ENB_BUILD to local luashark XP package
   ${XpPdmlFile}    Stop capture Backhaul XP for DSS

   Dated log             Point AF_PATH and ENB_BUILD to local luashark XP package
   Point AF_PATH to local luashark XP package
   Point ENB_BUILD to local luashark XP package
   Dated log     =========> Check UL and DL Qos Load Indication MeasuredNgbrNnbrLoad ...
   ${status}     ${avg_ul_MeasuredNgbrNnbrLoad}=  Run Keyword and Ignore Error  common_Dss_Keywords.Check UL Qos Load Indication MeasuredNgbrNnbrLoad
   ...                                                                                              ${XpPdmlFile}
   ...                                                                                              value=64
   ...                                                                                              with_verdict=False
   Run Keyword and Ignore Error      common_Dss_Keywords.Check DL Qos Load Indication MeasuredNgbrNnbrLoad       ${XpPdmlFile}

   Dated log     =========> get dl and ul throughput for ue (0x${TestDSS10Mhz_2574_A3.Context.UeId1})


   ${ul_throughput_for_ue1}=  nps_dss_tools.get_bearer_stats_SA   ue=${TestDSS10Mhz_2574_A3.Context.UeId1}
   ...                                                             pdu=1   qfi=1    direction=ul  alias=egate_TC3
   dated log     ul throughput for ue1 is ${ul_throughput_for_ue1} Mbps

   ${dl_throughput_for_ue1}=  nps_dss_tools.get_bearer_stats_SA   ue=${TestDSS10Mhz_2574_A3.Context.UeId1}
   ...                                                             pdu=1   qfi=1    direction=dl  alias=egate_TC3
   dated log     dl throughput for ue1 is ${dl_throughput_for_ue1} Mbps

   Dated log     =========> Test if Expected dl throughput is reached [expected=${dl_expect_tput_value_for_TC03}Mbps]
   ${dl_target_tput}=         Evaluate    float(${dl_expect_tput_value_for_TC03})
   ${DL_tput_ok}              Verify xL tput     dir=DL    tput_value=${dl_throughput_for_ue1}
   ...                                           expect_tput_value=${dl_target_tput}    tput_deviation=${deviation}
   # following tested is moved from the KW to be sure if failed it is really reported
   should be true    '${DL_tput_ok}'=='True'    Tput is not as expected!

   [Teardown]     Run Keywords       common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
   ...                               Teardown 2574     alias=egate_TC3           AND
   ...                               set Suite Variable  ${testCaseDir}  None


TestLine_2574_Test_setup_20MHz
   [Tags]    FULL_RUN    Cellsetup   FULL_CALL  20MHZ
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory
   5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS20Mhz_2574_A}

# Test
#    common_Dss_Keywords.Get testcase log directory
#    ${sum_prb}   ${sum_prb_5min}=      Sum NbrOfPrb Info from L1L2 Pcap    ${TestDSS10Mhz_2574_A1}
