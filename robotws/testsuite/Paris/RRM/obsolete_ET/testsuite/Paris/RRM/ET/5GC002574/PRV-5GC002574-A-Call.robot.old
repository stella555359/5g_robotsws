*** Keywords ***

TC 2574 5g SA Call
   [Documentation]                Test purpose is to test 5g DSS SA Call
   [Arguments]                    ${param}    ${alias}=default
   Init Sequence                  ${param}
   Step           Start capture Bip and Xp for 2574
   Step           common_Dss_SA_NSA.DSS_5g_Call_SA           argument=${alias}
   Step           Stop capture Bip and Xp for 2574       depends=Start capture Bip and Xp for 2574
   [Teardown]                      GenericTest.Display diagnosis

TC 2574 NSA CellSetup
   [Documentation]                Generic test for 2574: test purpose is to setup X2, Xp and DSS CellSetup Phase3
   [Arguments]                    ${param}     ${alias}=default
   Init Sequence                  ${param}
   common_Dss_Keywords.Restart     OwnTLReset=${False}     GNBCallback=common_Dss_Keywords.Set Reset Loop Counter
   Step                           Start capture Backhaul XP for DSS       depends=common_Dss_Keywords.Restart
   Step                           5GC002574_keywords.Start WTS For NSA              argument=${alias}
   Step                           Xp link Setup                 argument=${alias}        depends=5GC002574_keywords.Start WTS For NSA
   Step                           X2Ap link Setup               argument=${alias}        depends=5GC002574_keywords.Start WTS For NSA
   Step                           common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3    argument=${alias}     depends=Xp link Setup
   ${pdmlFile}                    Stop capture Backhaul XP for DSS
   Run Keyword if       '${CELLSETUP_SHOULD_BE_CHECK}' == '1'
   ...                    Step        Check DSS CellSetup Phase3      argument=${pdmlFile}   depends=common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3
   Critical Step                  common_Dss_CellSetup.Verify AP Classical Cell Setup
   [Teardown]               GenericTest.Display diagnosis

TC 2574 5g NSA Call
   [Documentation]                Test purpose is to test 5g DSS NSA Call
   [Arguments]                    ${param}     ${alias}=default
   BuiltIn.log                    alias is ${alias}
   Init Sequence                  ${param}
   Critical Step                  common_Dss_SA_NSA.Test SgNB Addition PRACH
   [Teardown]               GenericTest.Display diagnosis

TC 2574 DL Tput NSA Mode
    [Documentation]                Generic test for 2574: test purpose is to test DL Tput NSA mode
    [Arguments]                    ${param}      ${ul_rate}=15      ${dl_rate}=80      ${alias}=default
    BuiltIn.log                    ul_rate=${ul_rate} and dl_rate=${dl_rate}
    Init Sequence                  ${param}
    # Dated log             Point AF_PATH to local luashark XP package
    # Point AF_PATH to local luashark XP package
    # Point ENB_BUILD to local luashark XP package
    Dated log     SSH on ${GNB_DU.sys[0].M.sshId}
    ${aliasGNB_M}         SSH Wait For Connect                    ${GNB_DU.sys[0].M}
    ${tput_log_file_path_gnb}      Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'    Start tput log capture    gnb_index=0
    ...                                                                                                          asik_alias=${aliasGNB_M}
    Dated log     =========> NSA Start DL Traffic on ue_id=${UE_SIMPLE_CellDSS.ue} with ${dl_rate}M
    Step       NSA Start Generating "${dl_rate}"mbps DL Traffic for Ue "${param.Context.UeId1}" on NSA using alias "${alias}"
    Traced Sleep   5s     msg=DL Traffic to test Tput
    Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'      Dated log         Calculate DL and UL throughput on gnb L2Lo case ...
    # Run Keyword And Ignore Error    Check UL DL Throughput
    Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'   Check Throughput from aasyslog   asik_alias=${aliasGNB_M}
    ...                                                                                   tput_log_file_path_gnb_combined=${tput_log_file_path_gnb}

    ${L1L2_Pcap_File}=   5GC002574_keywords.Get L1L2 traces    time=12s   prefix=L1L2Bip.wDLTput
    ${sum_prb}   ${sum_prb_5min}   ${dl_ratio}=    Sum NbrOfPrb pdschsendreq from L1L2 Pcap wo Step    ${param}
    ...                                                                                                ${testCaseDir}/${L1L2_Pcap_File.name}.pcap
    # computed dl ratio not in line with Qos Dl Load Ind !!! Why ?
    ${dl_ratio}=   set variable    95

    Step                Start capture Backhaul XP for DSS     argument=XP.BH.wDLTput
    Traced Sleep   3s     msg=DL Traffic to test DL Qos load Indication
    ${pdmlFile}         Stop capture Backhaul XP for DSS
    Dated log     =========> Check DL Qos Load Indication MeasuredNgbrNnbrLoad ...
    # Step              common_Dss_Keywords.Check DL Qos Load Indication MeasuredNgbrNnbrLoad   depends=common_Dss_Keywords.Stop capture for DSS
    # ...                            argument=${pdmlFile}
    common_Dss_Keywords.Check DL Qos Load Indication MeasuredNgbrNnbrLoad   ${pdmlFile}    value=${dl_ratio}
    Step              Start capture Bip and Xp for 2574          argument=BIPL1L2.BH.wDLTput
    Traced Sleep   2s     msg=take BIPL1L2 and BH pcap traces with DL Tput
    Step              Stop capture Bip and Xp for 2574              depends=5GC001586_Keywords.Start capture Bip and Xp for 1586
    Dated log     =========> get throughput for ue (0x${UE_SIMPLE_CellDSS.ue})
    ${ul_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=ul  alias=${alias}
    dated log     ul throughput for ue is ${ul_throughput_for_ue1} Mbps
    ${dl_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=dl  alias=${alias}
    dated log     dl throughput for ue is ${dl_throughput_for_ue1} Mbps
    Step          common_Dss_SA_NSA.Display Ue NSA Statistics       argument=${alias}
    Run Keyword And Ignore Error    5GC002574_keywords.Get TTI traces
    common_Dss_SA_NSA.Stop Generating Traffic         ue=${UE_SIMPLE_CellDSS.ue}
    ...                                           bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                           alias=${alias}
    [Teardown]           GenericTest.Display diagnosis

TC 2574 DL Tput NSA Mode wo Stopping dl Tput
    [Documentation]                Generic test for 2574: test purpose is to test DL Tput NSA mode
    [Arguments]                    ${param}      ${ul_rate}=15      ${dl_rate}=80      ${alias}=default
    BuiltIn.log                    ul_rate=${ul_rate} and dl_rate=${dl_rate}
    Init Sequence                  ${param}
    # Dated log             Point AF_PATH to local luashark XP package
    # Point AF_PATH to local luashark XP package
    # Point ENB_BUILD to local luashark XP package
    Dated log     SSH on ${GNB_DU.sys[0].M.sshId}
    ${aliasGNB_M}         SSH Wait For Connect                    ${GNB_DU.sys[0].M}
    ${tput_log_file_path_gnb}      Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'    Start tput log capture    gnb_index=0
    ...                                                                                                          asik_alias=${aliasGNB_M}
    Dated log     =========> NSA Start DL Traffic on ue_id=${UE_SIMPLE_CellDSS.ue} with ${dl_rate}M
    Step       NSA Start Generating "${dl_rate}"mbps DL Traffic for Ue "${param.Context.UeId1}" on NSA using alias "${alias}"
    Traced Sleep   5s     msg=DL Traffic to test Tput
    Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'      Dated log         Calculate DL and UL throughput on gnb L2Lo case ...
    # Run Keyword And Ignore Error    Check UL DL Throughput
    Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'   Check Throughput from aasyslog   asik_alias=${aliasGNB_M}
    ...                                                                                   tput_log_file_path_gnb_combined=${tput_log_file_path_gnb}
    # Point AF_PATH to local luashark XP package
    # Point ENB_BUILD to local luashark XP package
    Step                Start capture Backhaul XP for DSS     argument=XP.BH.wDLTput
    Traced Sleep   3s     msg=DL Traffic to test DL Qos load Indication
    ${pdmlFile}         Stop capture Backhaul XP for DSS
    Dated log     =========> Check DL Qos Load Indication MeasuredNgbrNnbrLoad ...
    Step              common_Dss_Keywords.Check DL Qos Load Indication MeasuredNgbrNnbrLoad   depends=common_Dss_Keywords.Stop capture for DSS
    ...                            argument=${pdmlFile}
    Step              Start capture Bip and Xp for 2574          argument=BIPL1L2.BH.wDLTput
    Traced Sleep   2s     msg=take BIPL1L2 and BH pcap traces with DL Tput
    Step              Stop capture Bip and Xp for 2574              depends=5GC001586_Keywords.Start capture Bip and Xp for 1586
    Dated log     =========> get throughput for ue (0x${UE_SIMPLE_CellDSS.ue})
    ${ul_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=ul  alias=${alias}
    dated log     ul throughput for ue is ${ul_throughput_for_ue1} Mbps
    ${dl_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=dl  alias=${alias}
    dated log     dl throughput for ue is ${dl_throughput_for_ue1} Mbps
    Step          common_Dss_SA_NSA.Display Ue NSA Statistics       argument=${alias}
    # Run Keyword And Ignore Error    5GC002574_keywords.Get TTI traces
    [Teardown]           GenericTest.Display diagnosis

TC 2574 DL UL Tput NSA Mode
    [Documentation]                Generic test for 2574: test purpose is to test DL/UL Tput NSA mode
    [Arguments]                    ${param}      ${ul_rate}=15      ${dl_rate}=80      ${alias}=default
    BuiltIn.log                    ul_rate=${ul_rate} and dl_rate=${dl_rate}
    Init Sequence                  ${param}
    Dated log             Point AF_PATH to local luashark XP package
    Point AF_PATH to local luashark XP package
    Point ENB_BUILD to local luashark XP package
    Dated log     SSH on ${GNB_DU.sys[0].M.sshId}
    ${aliasGNB_M}         SSH Wait For Connect                    ${GNB_DU.sys[0].M}
    ${tput_log_file_path_gnb}      Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'    Start tput log capture    gnb_index=0
    ...                                                                                                          asik_alias=${aliasGNB_M}
    Dated log     =========> NSA Start UL/DL Traffic on ue_id=${UE_SIMPLE_CellDSS.ue} with ${ul_rate}M/${dl_rate}M
    Start Generating "${ul_rate}"mbps UL and "${dl_rate}"mbps DL Traffic for Ue "${param.Context.UeId1}" on NSA using alias "${alias}"
    Traced Sleep   5s     msg=DL/UL Traffic to test Tput
    Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'      Dated log         Calculate DL and UL throughput on gnb L2Lo case ...
    # Run Keyword And Ignore Error    Check UL DL Throughput
    Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'   Check Throughput from aasyslog   asik_alias=${aliasGNB_M}
    ...                                                                                   tput_log_file_path_gnb_combined=${tput_log_file_path_gnb}
    Point AF_PATH to local luashark XP package
    Point ENB_BUILD to local luashark XP package
    Step                Start capture Backhaul XP for DSS
    Traced Sleep   3s     msg=DL/UL Traffic to test DL/UL Qos load Indication
    ${pdmlFile}         Stop capture Backhaul XP for DSS
    Dated log     =========> Check UL and DL Qos Load Indication MeasuredNgbrNnbrLoad ...
    ${status}    ${avg_ul_MeasuredNgbrNnbrLoad}=  Run Keyword and Ignore Error  common_Dss_Keywords.Check UL Qos Load Indication MeasuredNgbrNnbrLoad
   ...                                                                                              ${pdmlFile}
   ...                                                                                              value=64
   ...                                                                                              with_verdict=False
    Step              common_Dss_Keywords.Check DL Qos Load Indication MeasuredNgbrNnbrLoad   depends=common_Dss_Keywords.Stop capture for DSS
    ...                            argument=${pdmlFile}
    Step              Start capture Bip and Xp for 2574          argument=BIP_L1L2_BH_w_DLULTput_${alias}
    Traced Sleep   2s     msg=take BIP L1L2 and BH pcap traces with DL/UL Tput
    Step              Stop capture Bip and Xp for 2574              depends=5GC001586_Keywords.Start capture Bip and Xp for 1586
    Dated log     =========> get ul/dl throughput for ue (0x${UE_SIMPLE_CellDSS.ue})
    ${ul_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=ul  alias=${alias}
    dated log     ul throughput for ue is ${ul_throughput_for_ue1} Mbps
    ${dl_throughput_for_ue1}=    nps_dss_tools.get_bearer_stats   ue=0x${UE_SIMPLE_CellDSS.ue}   bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                                         direction=dl  alias=${alias}
    dated log     dl throughput for ue is ${dl_throughput_for_ue1} Mbps
    Step          common_Dss_SA_NSA.Display Ue NSA Statistics       argument=${alias}
    common_Dss_SA_NSA.Stop Generating Traffic         ue=${UE_SIMPLE_CellDSS.ue}
    ...                                           bearer=${UE_SIMPLE_CellDSS.bearer}
    ...                                           alias=${alias}
    [Teardown]           GenericTest.Display diagnosis

DSS_5g_Periodic_DL_Fast_Allocation
   [Documentation]     DL Pattern list to add to CRMSim and active it
   [Arguments]         ${param}     ${alias}=default
   Init Sequence       ${param}
   Step      common_Dss_CellSetup.Periodic DL Fast Allocation      argument=${alias}
   [Teardown]                      GenericTest.Display diagnosis

DSS_5g_Periodic_UL_Fast_Allocation
   [Documentation]     UL Pattern list to add to CRMSim and active it
   [Arguments]         ${param}     ${alias}=default
   Init Sequence       ${param}
   Step      common_Dss_CellSetup.Periodic UL Fast Allocation      argument=${alias}
   [Teardown]                      GenericTest.Display diagnosis


Check Tput over all period
    [Documentation]    Computes and checks the Tput UL and DL between start_per_time and end_per_time
    ...                Tputs should be equal to maximum Tputs all along the test, with 5% margin
    [Arguments]    ${nb_cell}=1    ${dl_tput}=550    ${ul_tput}=100

    BuiltIn.log                    nb_cell=${nb_cell}
    BuiltIn.log                    ul_rate=${ul_tput} and dl_rate=${dl_tput}

    #M55319C00001: MEAS_PERIOD_NR_PDCP_REPORT1
    #M55319C0200x : DL_VOL_TX_NSA_QOS_GRP_0x: DL PDCP SDU volume transmitted for NSA Bearer - QoS Group 0x: nbre de bytes
    #M55319C02009 : Tput PDCP DL en bytes sur QoS 9
    #M55319C0600x: UL PDCP SDU volume received for NSA Bearer - QoS Group 0x: nbre de bytes
    #M55319C06009: Tput PDCP UL en bytes sur QoS 9

    #M55304C00001: Duration of the measurement period for the NR MAC PDU throughput
    # les compteurs suivants sont en bytes
    #M55304C01001 a 28: Initial transmission volume on PDSCH with 64QAM MCS table using MCS x, i.e Cell PDSCH without retrans Tput
    #M55304C02001 a 28: Initial and retransmission volume on PDSCH with 64QAM MCS table using MCS x, i.e Cell PDSCH with retrans Tput
    #M55304C03001 a 28: Initial transmissions volume on PUSCH with CP-OFDM and 64QAM MCS table using MCS x, i.e Cell PUSCH without retrans Tput
    #M55304C04001 a 28: Initial and retransmission volume on PUSCH with CP-OFDM and 64QAM MCS table using MCS x, i.e Cell PUSCH with retrans Tput
    #M55304C05001 a 28: Initial transmission volume on PDSCH with 256QAM MCS table using MCS x, i.e Cell PDSCH without retrans Tput
    #M55304C06001 a 28: Initial and retransmission volume on PDSCH with 256QAM MCS table using MCS x, i.e Cell PDSCH with retrans Tput

    ${NRCELL_ID}                       set variable       1
    # ${counter_values_M55319C02009}  Retrieve Latest Single Counter Value From Pm File with CellID    ${LATEST_FILE}    M55319C02009   ${NRCELL_ID}
    # ${counter_values_M55319C00001}  Retrieve Latest Single Counter Value From Pm File with CellID    ${LATEST_FILE}    M55319C00001   ${NRCELL_ID}
    ${counter_values_M55319C02009}     Retrieve Latest Single Counter Value From Pm File    ${LATEST_FILE}    M55319C02009
    ${counter_values_M55319C00001}     Retrieve Latest Single Counter Value From Pm File    ${LATEST_FILE}    M55319C00001
    BuiltIn.Log     ***DL PDCP SDU volume transmitted for NSA Bearer - QoS Group 09 (M55319C02009) = ${counter_values_M55319C02009}   console=yes
    BuiltIn.Log     ***Duration of the measurement period for the PDCP Report 1 (M55319C00001) = ${counter_values_M55319C00001}       console=yes

    ${Tput_PDCP_DL}                    set variable        ${counter_values_M55319C02009}
    ${MEAS_PERIOD_NR_PDCP_REPORT1}     set variable        ${counter_values_M55319C00001}

    ${tputDL}=              evaluate        8 * ${Tput_PDCP_DL} / (1000 * ${MEAS_PERIOD_NR_PDCP_REPORT1})
    Dated log          TPUT PDCP DL = ${tputDL} Mbps

    ${counter_values_M55319C06009}     Retrieve Latest Single Counter Value From Pm File     ${LATEST_FILE}   M55319C06009
    BuiltIn.Log     ***UL PDCP SDU volume received for NSA Bearer - QoS Group 09 (M55319C02009) = ${counter_values_M55319C06009}   console=yes
    ${Tput_PDCP_UL}                    set variable        ${counter_values_M55319C06009}

    ${tputUL}=              evaluate        8 * ${Tput_PDCP_UL} / (1000 * ${MEAS_PERIOD_NR_PDCP_REPORT1})
    Dated log          TPUT PDCP uL = ${tputUL} Mbps

    # ${dl_min_tput}           evaluate    ${dl_tput} * 0.9
    # ${ul_min_tput}           evaluate    ${ul_tput} * 0.9

    # Should be true    ${tputDL} >= ${dl_min_tput}
    # Should be true    ${tputUL} >= ${ul_min_tput}






