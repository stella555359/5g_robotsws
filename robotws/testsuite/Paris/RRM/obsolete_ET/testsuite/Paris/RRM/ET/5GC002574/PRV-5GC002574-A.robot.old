*** Settings ***
Force Tags    PY36

Documentation     [SUITE PURPOSE]  tests for DSS feature 2574-A
...                                actRateMatchedCsiIm is mandatoy to setup 5GC002574-A
...                                actLteNrDssFastAlloc is false by default and activated by test if needed
...                                actLteNrDssLteCatM is activated by default
...               Test Case Scenario author   : christophe.samson@nokia.com
...               Test Case Scenario contact  : christophe.samson@nokia.com
...               Test Case automation author :
...               Test Case automation contact:
...               Creation Date               : September 23 2021
...               Modified Date               : October 13 2021
...               Last Modified by            : christophe.samson@nokia.com
#-------------------------------------------------------------------------------------------------------[150 characters]

Library           taf.sbts.oam.coam.admin            WITH NAME               coam
Library           ute_wtssim                        WITH NAME               wts
Library           ../resources/python/luashark_tools.py
Library           ../../../resources/SWENG/python/StringTool.py
Library           resources/python/Constants.py                WITH NAME               MyConstants
Library           ../resources/DSS/python/dss_tools.py         WITH NAME               nps_dss_tools
Library           resources/python/tools.py                    WITH NAME               nps_2574_tools
Library           ../resources/common/TtiTrace/python/ttitrace.py   WITH NAME          nps_ttitraces_tools

# SWENG resources
Resource          ../../../resources/SWENG/robot/GenericTest.robot

# TTI Traces resource
Resource          ../resources/common/TtiTrace/ttitrace.robot

# DSS common
Resource          ../resources/DSS/robot/common_Dss_Keywords.robot
Resource          ../resources/DSS/robot/common_Dss_command.robot
Resource          ../resources/DSS/robot/common_Dss_SA_NSA.robot
Resource          ../resources/DSS/robot/btslog.robot

# 2574 specific
Resource            resources/robot/5GC002574_Kw_TestSetup.robot
Resource            resources/robot/5GC002574_keywords.robot

Variables           resources/python/Constants.py



Suite Setup         Run keywords
...                                MyConstants.hello                                AND
...                                Test Suite Setup for 2574                        AND
...                                btslog.Create cplane runtime file to gnb         AND
...                                Get gNB cell 5g On air                           AND
...                                Prepare TL for TTITraces
Suite Teardown      Test suite teardown for 2574


*** Variables ***

${PATTERN_DL_70_SA_OK}      0011100010-0111101110-0011100010-0111101110-0011100010-0111101110-0011100010-0111101110
${PATTERN_DL_100_SA_OK}      1011110011-1111111111-1011110011-1111111111-1011110011-1111111111-1011110011-1111111111


*** Test Cases ***

TestLine_preparation
   [Tags]    FULL_RUN    Cellsetup     10MHZ    MYCRT
   5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A1}


TestLine_2574_Test_setup_10Mhz
   [Tags]    FULL_RUN    Cellsetup   FULL_CALL  10MHZ   MYCRT
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory
   5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A1}


[1]5GC002574_A_TC_01_Cellsetup_w_Coord_Req_Rsp_10MHz_DL_ratio_max_70_95
   [Tags]    FULL_RUN    Cellsetup     10MHZ    2574   2574_A1
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory
   ${tc_name}    Set variable    TestLine_preparation
   ${tc_status}    getTcStatusByName    name=${tc_name}
   ${msg}   Catenate   "2574_DSS_Cellsetup: sw release used [${convert_version}], Cellsetup Dss phase 3
   ...          BW= 10MHz, DL RATIO = 100%"
   common_Dss_Keywords.Log Test description   ${msg}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A1}
   ${tc_name}    Set variable    TestLine_2574_Test_setup_10Mhz
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A1}

   # desactivate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS10Mhz_2574_A1}"

   # Specific Setting for this test
   # actRateMatchedCsiIm is mandatoy to setup 5GC002574-A
   # Set 2574 Specifc Scf Param actRateMatchedCsiIm with "true" value
   Set 2574 Specifc Scf Param actLteNrDssLteCatM with "false" value and update into "${TestDSS10Mhz_2574_A1}"
   5GC002574_keywords.TC DSS Phase3 CellSetup      ${TestDSS10Mhz_2574_A1}   egate_TC1
   [Teardown]      Run Keywords    Set 2574 Specifc Scf Param actLteNrDssLteCatM with "true" value and update into "${TestDSS10Mhz_2574_A1}"    AND
   ...                             Teardown 2574      alias=egate_TC1     AND
   ...                             set Suite Variable  ${testCaseDir}  None


# TC covered under New Feature
# [1]5GC002574-A1_TC2_Cellsetup_SANSA_10MHz_DL_ratio_max_70_95_Coord_Indication_Update_Procedure
[1]5GC002574_A_TC_02_Cellsetup_w_Coord_Update_Ind_10MHz_DL_ratio_max_70_95_Check_Xp
   [Tags]    FULL_RUN    Cellsetup     10MHZ    2574   2574_A1    MYCRT
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%, CellSetup with CatM activated
   ...                 DL Coordination Req/Rsp and DL Coordination Update Ind test scenario case
   ...                 Check CatM capabilities and CatMinfo during Coordination procedure
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory
   ${tc_name}    Set variable    TestLine_preparation
   ${tc_status}    getTcStatusByName    name=${tc_name}
   ${msg}   Catenate   "2574_DSS_Cellsetup: sw release used [${convert_version}], Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%,\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                Check CatM capabilities and CatMinfo during Coordination procedure"
   common_Dss_Keywords.Log Test description   ${msg}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A1}
   ${tc_name}    Set variable    TestLine_2574_Test_setup_10Mhz
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A1}

   # desactivate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS10Mhz_2574_A1}"

   5GC002574_keywords.TC 2574 CellSetup         ${TestDSS10Mhz_2574_A1}   egate_TC2

   ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
   should contain	                ${output}	                            passed

   [Teardown]      Run Keywords    Teardown 2574      alias=egate_TC2    AND
   ...                             set Suite Variable  ${testCaseDir}  None

# TC covered under New Feature
# [1]5GC002574-A1_TC2_Cellsetup_SANSA_10MHz_DL_ratio_max_70_95_Coord_Indication_Update_Procedure
[1]5GC002574_A_TC_03_Cellsetup_w_Coord_Update_Ind_10MHz_DL_ratio_max_70_95_Check_Cprt
   [Tags]    FULL_RUN    Cellsetup     10MHZ    2574   2574_A1      MYCRT
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%, CellSetup with CatM activated
   ...                 DL Coordination Req/Rsp and DL Coordination Update Ind test scenario case
   ...                 Check CPRT CatM activation
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory
   ${tc_name}    Set variable    TestLine_preparation
   ${tc_status}    getTcStatusByName    name=${tc_name}
   ${msg}   Catenate   "2574_DSS_Cellsetup: sw release used [${convert_version}], Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%,\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                Check CPRT CatM activation"
   common_Dss_Keywords.Log Test description   ${msg}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A1}
   ${tc_name}    Set variable    TestLine_2574_Test_setup_10Mhz
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A1}

   # desactivate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS10Mhz_2574_A1}"

   ${cellsetup_shouldBe_checked_previously}   set variable   ${CELLSETUP_SHOULD_BE_CHECK}
   Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0

   # update CatM data with CatMinfo_10MHz_CatMData_CatMPaging_CatMSib1Br in Context
   Update CatMinfo with ${CatMinfo_10MHz_CatMData_CatMPaging_CatMSib1Br_DLRATIO_70} into "${TestDSS10Mhz_2574_A1}"

   # 5GC002574_keywords.TC 2574 CellSetup to check CPRT CatM activation         ${TestDSS10Mhz_2574_A1}   egate_TC3
   5GC002574_keywords.TC 2574 CellSetup         ${TestDSS10Mhz_2574_A1}   egate_TC3

   Update CatMinfo with ${CatMinfo_10MHz} into "${TestDSS10Mhz_2574_A1}"

   ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
   should contain	                ${output}	                            passed

   [Teardown]      Run Keywords    Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}    ${cellsetup_shouldBe_checked_previously}      AND
   ...                             Teardown 2574      alias=egate_TC3    AND
   ...                             set Suite Variable  ${testCaseDir}  None


