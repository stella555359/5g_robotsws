   ${tc_status}    getTcStatusByName    name=${tc_name}
   ${msg}   Catenate   "2574_DSS_Cellsetup: sw release used [${convert_version}], Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%,\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                Check CatM capabilities and CatMinfo during Coordination procedure"
   common_Dss_Keywords.Log Test description   ${msg}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS20Mhz_2574_A}
   ${tc_name}    Set variable    TestLine_2574_Test_setup_20MHz
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS20Mhz_2574_A}

   # desactivate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS20Mhz_2574_A}"

   # DSS Cellsetup with only PRB_area_A_B_SIB1_BR provided by CRMSim
   # Test is executed on 20MHz BW and as PRB_area_C_D_SIB1_BR are missing => DL Allocation Req Failure case
   ${cellsetup_shouldBe_checked_previously}   set variable   ${CELLSETUP_SHOULD_BE_CHECK}
   Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0
   # update wts waiting pattern with Received DSS DL Resource Area Allocation Failure in this case
   Update pattern "Received DSS DL Resource Area Allocation Failure" into "${TestDSS20Mhz_2574_A}" Context
   5GC002574_keywords.TC 2574 CellSetup         ${TestDSS20Mhz_2574_A}   egate_TC7_Bis

   # go back to default value
   Update pattern "Received DSS DL Resource Area Allocation Response" into "${TestDSS20Mhz_2574_A}" Context

   ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
   should contain	                ${output}	                            passed

   [Teardown]      Run Keywords    Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}    ${cellsetup_shouldBe_checked_previously}      AND
   ...                             Teardown 2574      alias=egate_TC7_Bis    AND
   ...                             set Suite Variable  ${testCaseDir}  None

