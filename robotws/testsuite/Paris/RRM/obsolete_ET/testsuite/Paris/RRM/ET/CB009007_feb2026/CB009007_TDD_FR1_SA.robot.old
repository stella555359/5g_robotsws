*** Test Cases ***
[1][1.0] CB009007_5G_A_13_Interworking with CB008662_ReTxn_SA
  [Tags]     CLOUD_5G_I_LO_AP_LO_SANSA_FS_ECPRI_CMWV_TDD
  TC 9007 ReTxn              ${1116_2Pdcch_1CsiRs_ReTxn}
  [Teardown]                 Setup.Test Teardown



*** Keywords ***

Set Call info
    [Arguments]           ${id}    ${deviation}
    ${idInTest}           set variable        ${id}
    ${tputDeviation}      set variable        ${deviation}
    Set Suite Variable    ${idInTest}
    Set Suite Variable    ${tputDeviation}


TC 9007 TDD SA
    [Arguments]         ${param}    ${TCname}
    Init Sequence       ${param}
    Critical Step                                      Set UE_Capa Context_WTS CFG    ue_id=${FIRST_SA_UE_ID}
    Critical Step                                      Set Context TDD SA
    Critical Step                                      CallSetup.Setup Wtsemu SA
    ${TTIdir}                                          Get TTI Trace Path    dir_suffix=${TCname}
    Step                                               Captures Init
    Step                                               Captures Start
    Critical Step                                      CallSetup.UE Register
    Critical Step                                      CallSetup.Launch PDU Session
    Step                                               Captures Stop
    Step                                               Check Sliv in RRC Setup
    Step                                               Traffic UE DL    ueSetting=${BASIC_UE_SA}
    ...                                                                 throughput=${param.throughput}
    ...                                                                 shouldBeStop=False
    ...                                                                 shouldBeCheck=False
    ...                                                                 deviation=20
    ...                                                                 captureCallback=Callback Capture L1L2
    ...                                                                 capture=${CaptureL1L2}

    Run Keyword If     not ${isAic}                    Step    Start TTI Traces in Streaming mode    src_ip=10.0.1.2
    ...       ELSE                                     Step    Start To Collect TTI Trace On AIC

    Step                                               Traced Sleep    60 seconds    msg=TTI capture

    # stop TTI capture
    Dated Log New Line                                 ==> Stop TTItraces capture
    ${TTIpcap}                                         Stop TTI Traces in Streaming mode
    ...                                                                 tti_trace_path=${TTIdir}
    ...                                                                 tti_trace_filename=TTITrace_${TCname}

    Step                                               Traffic Stop    ueSetting=${BASIC_UE_SA}    dir=dl

    Dated Log New Line                                 ==> Convert TTItrace to json
    ${TTIjson}                                         Convert TTItrace from pcap to others    input_file_path=${TTIpcap}
    Dated Log New Line                                 ==> Convert TTItrace to csv to analyse in case of failed
    ${TTIcsv}                                          decode_tti_traces_json_using_TtitraceReaderEvtDec
    ...                                                                 jsonPathName=${TTIjson}    num_of_events=100000

    ${nbCheck}                                         CheckSLIVinSpecialSlotsInTTI    jsonPathName=${TTIjson}
    ...                                                                 SLIVlist=${param.sliv}    SlotList=${param.specialSlots}

    Should Be True                ${nbCheck}>0
    [Teardown]         Display diagnosis


TC 9007 Max throughput

    [Arguments]         ${param}
    Init Sequence       ${param}
    Run Keyword If      '${param.CA}'=='Off'           Set Call info    1    20
    ...   ELSE IF       '${param.CA}'=='On'            Set Call info    3    40
    Critical Step                                      Set UE_Capa Context_WTS CFG    ${idInTest}
    Critical Step                                      Set Context TDD SA
    FOR    ${i}    IN RANGE         1       2
        Critical Step                                  CallSetup.Setup Wtsemu SA
        Critical Step                                  CallSetup.UE Register    ${idInTest}
        Critical Step                                  CallSetup.Launch PDU Session    ${idInTest}  ${idInTest}  ${idInTest}
        Step                                           ${param.dir} Traffic SA_NO_BIP    ${idInTest}
        Critical Step                                  Check Counters Data Slot and DL Data Slot With PDSCH    ON
        Critical Step                                  Deactivate CB009007
        Critical Step                                  Restart TL
        Critical Step                                  CallSetup.Setup Wtsemu SA
        Critical Step                                  CallSetup.UE Register    ${idInTest}
        Critical Step                                  CallSetup.Launch PDU Session    ${idInTest}  ${idInTest}  ${idInTest}
        ${tputDeviation}                               Evaluate    ${tputDeviation} + 5
        Step                                           ${param.dir} Traffic SA_NO_BIP    ${idInTest}
        Critical Step                                  Check Counters Data Slot and DL Data Slot With PDSCH    OFF
       #Step                                           Activate CB009007
       #Step                                           Restart TL
    END
    Step                                               Restore Original SCF

   [Teardown]         Display diagnosis



TC 9007 ReTxn

    [Arguments]         ${param}
    Init Sequence       ${param}
    Critical Step                                      Set UE_Capa Context_WTS CFG
    Critical Step                                      Set CsiRs in Sherpa ON
    Critical Step                                      Set HARQ Incremental Redundancy DL ON and set Adaptative ReTxn Nack Count
    Critical Step                                      Set Context TDD SA
    Critical Step                                      CallSetup.Setup Wtsemu SA
    Critical Step                                      CallSetup.UE Register
    Critical Step                                      CallSetup.Launch PDU Session
    Critical Step                                      Set test Mode and start traffic with TTI capture
    Step                                               Restore Original SCF

   [Teardown]         Display diagnosis


