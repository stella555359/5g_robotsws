*** Variables ***

${enable_sherpa_test}    True

@{frame 1116}=        3    13
@{frame 1116 3ms}=    7    17

@{Pci_1CC}=    50.0
@{Pci_2CC}=    52.0   55.0

# In following SLIV lists, first SLIV must be the expected one in RRC pdsch_Config startSymbolAndLength field
@{SLIV_57}=       57
@{SLIV_44}=       44
@{SLIV_57_30}=    57   30

@{Cell_Id_1CC}=       1
@{Cell_Id_2CC}=       3    6
@{Cell_Id_inCA}=      1    3    6


# Counter references TC12 TC15
${M55308C00001_Ref_ON}       461250
${M55308C00005_Ref_ON}       461250
${M55308C10001_Ref_ON}       130074375
${M55308C03001_Ref_ON}       5746875
${M55308C00001_Ref_OFF}      401250
${M55308C00005_Ref_OFF}      401250
${M55308C10001_Ref_OFF}      113694375
${M55308C03001_Ref_OFF}      5446875
${M55308C10001_Ref_CA_ON}    76920000    # Reference for TDD cell in CA with feature activated
${M55308C03001_Ref_CA_ON}    5730000     # Reference for TDD cell in CA with feature activated
${M55308C10001_Ref_CA_OFF}   67200000    # Reference for TDD cell in CA with feature deactivated
${M55308C03001_Ref_CA_OFF}   5460000     # Reference for TDD cell in CA with feature deactivated


# ReTxn TC 13
${rdAdaptiveReTxNackCount}       0
${MaxAdaptiveReTxErrorRatio}     3


&{1116_1Pdcch}
