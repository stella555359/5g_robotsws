*** Test Cases ***

[1]CNI-103538_L2PS_Crash_Analysis
    [Documentation]        CNI-103538_L2PS_Crash_Analysis
    [Tags]                 SBTS00
    ...                    CLOUD_5G_I_LO_AP_LO,VARIANT_SANSA_FS_CPRI_CMWV_FDD_TEMP
    ...                    CLOUD_5G_I_BLLL_AP_LOO,VARIANT_SANSA_FS_ECPRI_CMWV_FDD+TDD
    Init Sequence          _
    FOR     ${iteration}   IN RANGE    0    3
        Dated log          Start iteration ${iteration}
        Step               Step_Check_Crash_Via_Dedicated_Test_Mode    crash_type=CD #SIGADDR
     END
    # Step                   Step_Postlude
    [Teardown]             Run Keywords     Produce Scout Data      AND
    ...                                     GenericTest.Display diagnosis

