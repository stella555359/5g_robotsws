...                startSymbol=2
...                numOfPdschSymbols=12
...                startPrb=0
...                numOfPrb=3
...                modulationOrder=${QPSKvalue}

&{PuschReceiveReq_checkValue_G_FR1_A2_4}
...                startPrb=1
...                numOfPrb=106
...                modulationOrder=${16QAMvalue}
...                mcs=16
...                tbSize_bits=38936


*** Keywords ***
Suite Setup CB011017
    [Documentation]
    ...     Conditions:    it needs no conditions
    ...     Actions:       it performs the generic suite setup and backup the configurations files
    ...     Checks:        it checks nothing more than already done on lib.
    ...     Verdict:       suite setup is passed
    [Arguments]            ${scfcPathname}=${EMPTY}
    ...                    ${iphyPathname}=${EMPTY}

    Setup.Suite Setup From Scratch
    ...                    keepAllUeDataInCfgFile=${True}
    ...                    automaticTeardown=${True}
    ...                    scfcPathname=${scfcPathname}
    ...                    iphyPathname=${iphyPathname}
    
    Backup Files
    ${scf_suite_setup_backup}        OAM Get SCF File           file=SCF_Suite_Setup_Backup.xml
    Set Suite Variable               ${scf_suite_setup_backup}
    Dated Log                        SCF backup file = ${scf_suite_setup_backup}




CB011017_Transmitter_test_model_50MHz_FDD_NR-FR1-TM1_1
    Init Sequence      "CB011017_A1"
    Dated Log      Check dldata_pdschsendreq parameters

    
    Critical Step      oam.Activate Test dedicated Mode

	Step               CB011017 setup Mirroring for BIP capture    prefix=CB011017_A1_NR_Downlink
    ...                   depends=Activate Test dedicated Mode
	Step               CB011017 Start Capture CPRT
    ...                   depends=CB011017 setup Mirroring for BIP capture
	Step               CB011017 Start Capture L1L2
    ...                   depends=CB011017 setup Mirroring for BIP capture
    Step               CB011017 Start 5g test NR Downlink       ${param_NR_Downlink_FR1_TM1_1}
    ...                   depends=Activate Test dedicated Mode
    Traced Sleep       2    msg=CPRT and BIP L1L2 logs capture ongoing
	Step               Capture Stop         capture=${CAPTURE_L1L2}
    ...                   depends=CB011017 Start Capture L1L2
	Step               Capture Stop         capture=${CAPTURE_CPRT}
    ...                   depends=CB011017 Start Capture CPRT
	Step               CB011017 Stop downlink Test Model
    ...                   depends=CB011017 Start 5g test NR Downlink
    Step               CB011017 Check CellSetupRequest                   ${CAPTURE_CPRT}    ${CellSetupRequest_checkShowName_BW50MHz}
    ...                   depends=CB011017 Start 5g test NR Downlink
    Step               CB011017 Check StartConformanceTestReq            ${CAPTURE_CPRT}    ${StartConformanceTestReq_checkShowName_NR_FR1_TM1_1}
    ...                   depends=CB011017 Start 5g test NR Downlink
    Step               CB011017 Check StartConformanceTestResp status    ${CAPTURE_CPRT}
    ...                   depends=CB011017 Start 5g test NR Downlinkq
    Step               CB011017 Check pdschsendreq NR_FR1_TM1_1         ${CAPTURE_L1L2}
    ...                   depends=CB011017 Start 5g test NR Downlink

CB011017_Receiver_test_model_50MHz_FDD_NR-G-FR1-A2-4
    Init Sequence      "CB011017-A2"
    Dated Log      Check uldata_PuschReceiveReq parameters

    Critical Step      oam.Activate Test dedicated Mode
    
	Step               CB011017 setup Mirroring for BIP capture    prefix=CB011017_A2_NR_Uplink
    ...                   depends=Activate Test dedicated Mode
	Step               CB011017 Start Capture CPRT
    ...                   depends=CB011017 setup Mirroring for BIP capture
	Step               CB011017 Start Capture L1L2
    ...                   depends=CB011017 setup Mirroring for BIP capture
    Step               CB011017 Start 5g test NR Uplink       ${param_NR_Uplink_G_FR1_A2_4}
    ...                   depends=Activate Test dedicated Mode
    Traced Sleep       2    msg=CPRT and BIP L1L2 logs capture ongoing
	Step               Capture Stop         capture=${CAPTURE_L1L2}
    ...                   depends=CB011017 Start Capture L1L2
	Step               Capture Stop         capture=${CAPTURE_CPRT}
    ...                   depends=CB011017 Start Capture CPRT
	Step               CB011017 Stop uplink Test Model
    ...                   depends=CB011017 Start 5g test NR Uplink
    Step               CB011017 Check CellSetupRequest                   ${CAPTURE_CPRT}    ${CellSetupRequest_checkShowName_BW50MHz}
    ...                   depends=CB011017 Start 5g test NR Uplink
    Step               CB011017 Check StartConformanceTestReq            ${CAPTURE_CPRT}    ${StartConformanceTestReq_checkShowName_G_FR1_A2_4}
    ...                   depends=CB011017 Start 5g test NR Uplink
    Step               CB011017 Check StartConformanceTestResp status    ${CAPTURE_CPRT}
    ...                   depends=CB011017 Start 5g test NR Uplink
    Step               CB011017-A_keywords.CB011017 Check PuschReceiveReq                  ${CAPTURE_L1L2}    ${PuschReceiveReq_checkValue_G_FR1_A2_4}
    ...                   depends=CB011017 Start 5g test NR Uplink


########################  CB011017-A KWs  ########################
CB011017 Check pdschsendreq NR_FR1_TM1_1
    [Arguments]    ${BIP_L1L2}
    Dated Log      Check dldata_pdschsendreq parameters

    ${pcapFiltered}    analyzer.filter_pcap
    ...                pcapInFile=${BIP_L1L2.path}
    ...                filterName=dldata_pdschsendreq
    ...                filterExp=dldata_pdschsendreq

    ${pdml}=           analyzer.pcap_to_pdml    ${pcapFiltered}

    CB011017 Check PdschSendReq IEs RNTI
    ...                PDML_L1L2=${pdml}
    ...                RNTI=0
    ...                FieldValue=${PdschSendreqReq_checkValue_NR_FR1_TM1_1_RNTI0}

    CB011017 Check PdschSendReq IEs RNTI
    ...                PDML_L1L2=${pdml}
    ...                RNTI=2
    ...                FieldValue=${PdschSendreqReq_checkValue_NR_FR1_TM1_1_RNTI2}

CB011017 Check PdschSendReq IEs RNTI
    [Arguments]    ${PDML_L1L2}    ${RNTI}    ${FieldValue}
    Dated Log      With RNTI ${RNTI}:

    ${msg_field}    Set Variable    @{FieldValue.keys()}

    @{listPacketMatch}    Get Packet Match List
    ...           pdmlFile=${PDML_L1L2}
    ...           packetName=dldata_pdschsendreq
    ...           pathList=@{msg_field}
    ...           startPacket=${1}
    ...           endPacket=${10}
    ...           filter='rnti$'==${RNTI}

    ${lenPdschSendReq}    get length    ${listPacketMatch}
    Dated Log             Number of pdschsendreq msgs with RNTI ${RNTI}: ${lenPdschSendReq}
    should be true        ${lenPdschSendReq}!=0

    ${packet}             set variable    ${listPacketMatch[0]}
    CB011017 Check PdschSendReq IEs    ${packet}    ${FieldValue}

CB011017 Check PdschSendReq IEs
    [Arguments]    ${packet}    ${FieldValue}

    FOR   ${Field}   IN   @{FieldValue.keys()}
        ${ParamValue}     Get Value In Packet Match
        ...               ${packet}
        ...               field=${Field}

        ${Value}          set variable    ${FieldValue["${Field}"]}
        Dated Log         --- Check ${Field} = ${Value}
        should be true    ${ParamValue} ==${Value}
    END

CB011017 Check PuschReceiveReq
    [Arguments]    ${BIP_L1L2}    ${FieldValue}
    Dated Log      Check uldata_puschreceivereq parameters

    ${pcapFiltered}    analyzer.filter_pcap
    ...                pcapInFile=${BIP_L1L2.path}
    ...                filterName=uldata_puschreceivereq
    ...                filterExp=uldata_puschreceivereq

    ${pdml}=           analyzer.pcap_to_pdml    ${pcapFiltered}

    ${msg_field}       Set Variable    @{FieldValue.keys()}

    FOR   ${slot}  IN RANGE   0  10
        @{listPacketMatch}    Get Packet Match List
        ...                   pdmlFile=${pdml}
        ...                   packetName=uldata_puschreceivereq
        ...                   pathList=@{msg_field}
        ...                   startPacket=${1}
        ...                   endPacket=${20}
        ...                   filter='slot$'== ${slot}

        ${lenPuschSendReq}    get length    ${listPacketMatch}
        Dated Log             Number of PdcchSendReq msgs with slot ${slot}: ${lenPuschSendReq}
        should be true        ${lenPuschSendReq}!=0

        ${packet}             set variable    ${listPacketMatch[0]}
        CB011017 Check PuschReceiveReq IEs    ${packet}    ${FieldValue}
    END

CB011017 Check PuschReceiveReq IEs
    [Arguments]    ${packet}    ${FieldValue}

    FOR   ${Field}   IN   @{FieldValue.keys()}
        ${ParamValue}     Get Value In Packet Match
        ...               ${packet}
        ...               field=${Field}

        ${Value}          set variable    ${FieldValue["${Field}"]}
        Dated Log         --- Check ${Field} = ${Value}
        should be true    ${ParamValue} ==${Value}
    END
