...                startSymbol=0
...                numOfPdschSymbols=14
...                startPrb=3
...                numOfPrb=267
...                modulationOrder=${QPSKvalue}

&{PdschSendreqReq_checkValue_NR_FR1_TM1_1_RNTI2}
