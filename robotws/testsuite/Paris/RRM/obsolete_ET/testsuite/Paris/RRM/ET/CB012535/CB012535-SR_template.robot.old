#UE corner
&{UE_1_SA_TDD_UE_R15_PC3}
...     ueid=1
...     ue_nr_capabilities=${SA_TDD_UE_R15_PC3}
...     ue_release=${EMPTY}    #${EMPTY} => basic already tuned correctly
...     Target_cell=1          #${EMPTY} => basic already tuned correctly

&{UE_2_SA_TDD_UE_R16}
...     ueid=2
...     ue_nr_capabilities=${SA_TDD_UE_R16}
...     ue_release=16   #${EMPTY} => basic already tuned correctly
...     Target_cell=2   #${EMPTY} => basic already tuned correctly

# @{uelist}    ${UE_1_SA_TDD_UE_R15_PC3}    ${UE_2_SA_TDD_UE_R16}
@{uelist}    ${UE_1_SA_TDD_UE_R15_PC3}    ${UE_2_SA_TDD_UE_R16}

#DOD Corner
@{DODlist}      # list empty for now will contain all DOD corner

&{AC1}       PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.puschTransformPrecoderFlag
...          value=1             dodtype=ExactValueForall    PercentTol=20

&{AC2}       PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.mcs
...          value=1             dodtype=InfEgalValueFarll    PercentTol=20

# &{AC3}       PcapType=L1L2       subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.dmrsSequenceType
# ...          value=${expected_PuschDmrsSeqType}   dodtype=ExactValueForall    PercentTol=20

&{AC4}       PcapType=L1L2        subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.modulationOrder
...          value=1              dodtype=ExactValueForall    PercentTol=20

&{AC5}       PcapType=L1L2        subcell_id=1     msg=uldata_puschreceivereq	      field=UlData_puschReceiveReqGrant_t.mcsTable
...          value=0              dodtype=ExactValueForall    PercentTol=20

&{AC6}       PcapType=L1L2        subcell_id=1     msg=uldata_puschreceiverespps	  field=UlData_UePuschReceiveRespPs_t.sinr_item
...          value=Display        dodtype=DisplayAverage    PercentTol=20

&{AC7}       PcapType=L1L2        subcell_id=1     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.crc
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- CRC OK/0 or CRC KO/1

&{AC8}       PcapType=L1L2        subcell_id=1     msg=uldata_puschreceiverespharqu   field=UlData_UePuschReceiveRespHarqU_t.dtx
...          value=Display        dodtype=PercentOfEachCase    PercentTol=20  # -- NON_DTX/0 or DTX/1

# @{AcceptanceCriteriaL1L2}    ${AC1}    ${AC2}    ${AC3}    ${AC4}    ${AC5}    ${AC6}    ${AC7}    ${AC8}
@{AcceptanceCriteriaL1L2}    ${AC1}    ${AC2}    ${AC4}    ${AC5}    ${AC6}    ${AC7}    ${AC8}

# END Modification block ==============================================================================================



*** Test Cases ***

[1]CB012535-Ax-TCyy_TestGeneric_template_QC_Name
    # [Tags]                      CLOUD_5G_I_LO_AP_LO, SANSA_FS_CPRI_CMWV_FDD+ECPRI_CMWV_TDD_AEQE

    #Special Need for this test

    Set Suite Variable    ${userneed_PCAP}       ${True}
    Set Suite Variable    ${userneed_Btslog}     ${True}
    Set Suite Variable    ${userneed_PM}         ${True}
    Set Suite Variable    ${DodIsSet}            ${True}

    CB012535_mainKW       ${A1}

*** Keywords ***

CB012535_mainKW
    [Documentation]                 CB012535-Base-
    [Arguments]                     ${param}
    kwmkt_dbg_log                   Global variable list DBGlogs: ${DBGlogs}          ##
    kwmkt_dbg_log                   info we are on KeepConfig: ${KeepConfig}           # these informative line to bypass Robot 5 new sanity :-)
    kwmkt_dbg_log                   info we are on NoSnap: ${NoSnap}                   #
    kwmkt_dbg_log                   info we are on egatelogoutput: ${egatelogoutput}   #
    kwmkt_dbg_log                   info we are on EnSher: ${EnSher}                   #
    kwmkt_dbg_log                   info we are on tti: ${tti}                         #
    kwmkt_dbg_log                   info we are on DodIsSet: ${DodIsSet}               #
    kwmkt_dbg_log                   recursion_limit: ${recursion_limit}               ##

    Init Sequence                   ${param}
    Step                            kwmkt_Create_Test_Suite_Folder

    Critical Step                   Set_basic_context
    # Critical Step                   Set_RadParameters
    Critical Step                   Set_SCF_ConfigMarket     ${param.Scfdetails}
    Critical Step                   Restart TL
    # Critical Step                   Set_SCF_ofTheTest        ${param.Feat12535niddSpecific}

    BuiltIn.sleep                   20    #to avoid capture issue at cell_setup time
    Critical Step                   kwmkt_Cell_setup         ${CellList}
    Run Keyword If                  not ${tti} and ${EnSher}                Activate Sherpa

    Critical Step                   kwmkt_run_script_once    ${CURDIR}/resources/egCmd/egCmd_reteInterferenceOnVictime.sce

    ${alarm}=                       kwmkt_Alarmslist         interference_ON
    Dated log                       DOD_12535: Alarm:${alarm}
    Run Keyword And Continue On Failure  should contain                  ${alarm}    ${RI_alarm}

    #L3call
    Run Keyword If                  ${userneed_PCAP}         kwmkt_Capture_Start    Attach
    Critical Step                   kwmkt_run_script_once    ${CURDIR}/resources/egCmd/egCmd_L3call_1ue_DL2_UL140.sce
    Run Keyword If                  ${userneed_PCAP}         kwmkt_Capture_Stop     Attach

    Critical Step                   kwmkt_run_script_once    ${CURDIR}/resources/egCmd/egCmd_Pathloss2setAttachedUEinMiddleOfCell.sce
    Critical Step                   kwmkt_run_script_once    ${CURDIR}/resources/egCmd/egCmd_10PcentULBlerOnFirstTrans_and_FirsRetrans.sce

    ${alarm}=                       kwmkt_Alarmslist         interference_ON
    Dated log                       DOD_12535: Alarm:${alarm}
    Run Keyword And Continue On Failure  should contain                  ${alarm}    ${RI_alarm}

    #TTI
    Run Keyword If                  ${tti} and not ${EnSher}    kwmkt_TTI_capt    ${param.GetTtiTraceTime}

    #BIP L1L2
    Dated log                       1s L1L2 Bip collection
    kwmkt_Capture_Start             Traff
    BuiltIn.sleep    1     #5ms
    ${pcappa}                       kwmkt_Capture_Stop      Traff
    Dated log                       pcap path: ${pcappa}

    Check_in_pcap                   PcapType=L1L2     PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
    #PM counters
    ${PMdod} =	                    Run Keyword And Return Status    kwmkt_PM_general
    kwmkt_dbg_log                   ${PMdod}
    Append to List                  ${DODlist}    ${PMdod}

    #L1L2 check
    pcap2csv                        PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}

    # /!\  elemRank help to chose info when tshark result return several information elemRank=0 => first elem of the list
    ${resSub0}                      Check_in_pcap            PcapType=L1L2    PcapLocation=${pcappa}    ParamItemValue_list=${param.dod}
    ...                                                      SbcId=1          elemRank=0
    Append to List                  ${DODlist}    ${resSub0}

    Dated log                                           DOD_12535: DodIsSet:${DodIsSet} res:${DODlist}
    Run Keyword If                  ${DodIsSet}         kwmkt_Check_For_False_In_${NL}    ${DODlist}
