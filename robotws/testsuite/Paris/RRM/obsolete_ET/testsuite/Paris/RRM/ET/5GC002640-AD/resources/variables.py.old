from robot.libraries.BuiltIn import BuiltIn
import os


def get_builtin_value(param_name, default=None):
    return BuiltIn().get_variable_value('${{{}}}'.format(param_name), default)


tl = get_builtin_value(param_name="tl")

# AP Hardware
AP_HARDWARE = tl.ues[0].l1.common_units[0].hardware_type

# PDU
PDU_MODEL = tl.gnbs[0].dus[0].airscale.common_units[0].pdu_port.pdu.__class__.__name__
GNB_PORT = tl.gnbs[0].dus[0].airscale.common_units[0].pdu_port
AP_PORT = tl.ues[0].l1.common_units[0].pdu_port
SWITCH_IP = tl.gnbs[0].dus[0].airscale.common_units[0].pdu_port.pdu.addr

# General vars
WEBEM_USERNAME = tl.gnbs[0].cu.oam_http_connection_details.username
WEBEM_PASSWORD = tl.gnbs[0].cu.oam_http_connection_details.password
NOKIA_USERNAME = tl.gnbs[0].cu.oam_ssh_connection_details.username
NOKIA_PASS = tl.gnbs[0].cu.oam_ssh_connection_details.password
GNB_IP = tl.gnbs[0].cu.oam_ssh_connection_details.addr
AP_IP = tl.ues[0].l1.common_units[0].lmp_connection.addr
AP_PASSWD = tl.ues[0].l1.common_units[0].lmp_connection.password
IPHY_DIR_PATH = '/opt/iphy'
EPCSIM_DIR_PATH = '{}/latest'.format(IPHY_DIR_PATH)
RESOURCES_WTS_CFGS_DIR = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'wts')

RESOURCES_DIR = os.path.join(os.path.dirname(os.path.realpath(__file__)))
BIP_SCRIPT = 'bip_script.sh'
BIP_COLLECTION_RUNNING = False
COLLECT_SNAPSHOT = 'False'
SUITE_SETUP_PASSED = False

DL_MBPS = 500
DL_MBPS_B = 100
UL_MBPS = 100

CELLS_6xREAL = {2: [1, 2, 3, 4, 5, 6]}
SYSLOG_ALIAS = "default"
ALIAS_TSHARK_WTS = "ALIAS_TSHARK_WTS"
PM_PERIOD = 5
SCELLS_FTT = ("16387", "16390")
PCELL_ID_8533 = "16385"
SCELLS_8533 = ("16387", "16388", "16390")
TDD_SCELLS = ("52", "55")
NRCELLIDENTIFICATION_MAP = {"16385": 1, "16386": 2, "16387": 3, "16388": 4, "16389": 5, "16390": 6}
PHYCELLID_MAP = {"16385": "50", "16386": "51", "16387": "52", "16388": "53", "16389": "54", "16390": "55"}
PHYSCELLID_UE_MAP = {"50": 6, "52": 4, "53": 5, "55": 3}

CELLID_MAP_KL = {"NRCELL-4": "4", "NRCELL-2": "2"}
CELLID_MAP_LO = {"NRCELL-4": "1", "NRCELL-2": "4"}

DEBUG_MCTRL_ENABLED = False


def get_real_cell_value(key):  # Helper function to modify deltas
    if AP_HARDWARE == "ASIL":
        return CELLID_MAP_LO[key]
    else:
        return CELLID_MAP_KL[key]


def get_weight_for_scell_selection_parameter_delta(value):
    return {"parameterName": "weightForSCellSelection", "value": str(value), "operation": "update"}


def get_drxprofile_parameter_delta(profile_id, drx_inactivity_timer, drx_long_cycle,
                                   drx_on_duration_timer, drx_retrans_timer_dl, drx_retrans_timer_ul,
                                   drx_harq_rtt_timer_dl, drx_harq_rtt_timer_ul):
    return {
        "parameterName": "drxProfile{}".format(profile_id),
        "operation": "update",
        "value": [{
            "drxInactivityTimer": "{}ms".format(drx_inactivity_timer),
            "drxLongCycle": "{}ms".format(drx_long_cycle),
            "drxOnDurationTimer": "{}ms".format(drx_on_duration_timer),
            "drxRetransTimerDl": "{}slot".format(drx_retrans_timer_dl),
            "drxRetransTimerUl": "{}slot".format(drx_retrans_timer_ul),
            "drxHarqRttTimerDl": "{}symbols".format(drx_harq_rtt_timer_dl),
            "drxHarqRttTimerUl": "{}symbols".format(drx_harq_rtt_timer_ul)
        }]
    }


