

def get_cleaned_airtti_csv(airTtiColumnCsv, mgrp):
    treatedAirTtiList = []
    for airtti in airTtiColumnCsv:
        sfn_slot = airtti.split(".")
        sfnmodulo = int(sfn_slot[0]) % (int(int(mgrp) / 10))
        treatedAirTtiList.append("{}.{}".format(sfnmodulo, int(sfn_slot[1])))
    return treatedAirTtiList
