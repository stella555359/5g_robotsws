def airphone_pdu_session_modify(ue_id, pdu_id, qosflows_to_add, by):
    ta5g_ue_mobility = BuiltIn().get_library_instance('ta5g_ue_mobility')
    ta5g_ue_mobility.modify_pdu_session(ue_id=ue_id, pdu_id=pdu_id, qos_to_add=qosflows_to_add, by=by, timeout=10)


def ue_stats(id=1, type='pdsch'):
    command = "ue_stats_nr id={} type={}".format(id, type)
    run_egate_command(command)


def bearer_stats(*args, **kwargs):
    arguments = kwargs
    parser_instance = BuiltIn().get_library_instance('ta_egate_cmd_parser')
    parser_instance.run_command("bearer_stats", egate_id=0, **arguments)


def set_bearer_param(ue, id_, scg_ul_dist_percent):
    command = "bearer_ue_param ue={} id={} scg_ul_dist_percent={}".format(ue, id_, scg_ul_dist_percent)
    run_egate_command(command)


def bearer_inject_gtpu_error_ind(by="sgw", device_id=1, bearer=3, ue=11, *args, **kwargs):
    command = "bearer_inject_gtpu_error_ind by={} device_id={} bearer={} ue={}".format(by, device_id, bearer, ue)
    for key, value in kwargs.items():
        command += " {}={}".format(key, value)
    run_egate_command(command)


def prepare_internal_traffic_generator(ue_id=1, pdu_id=1):
    logger_console("Set internal traffic generator for SA")
    run_egate_command('set_pdu_param ue={} pdu={} trf_type=internal'.format(ue_id, pdu_id))


def get_sent_bytes_from_bearer_statistics_on_egate(id, ue, dir="ul", trf_id=2):
    parser_instance = BuiltIn().get_library_instance('ta_egate_cmd_parser')
    bearer_stats = parser_instance.get_command("bearer_stats")
    data = bearer_stats(id=id, ue=ue, dir=dir, trf_id=trf_id).execute_and_parse()
    bytes_sent = data['Bytes sent']['Value']
    logger_console("Bytes sent (on egate): {}".format(bytes_sent))
    return int(bytes_sent)


def handling_rlc_cl_packets(profile_id, lcid, nr_of_time_to_drop, sn, *args, **kwargs):
    command = "dl_rlc_drop_testmode_nr profile_id={} lcid={} number_of_times_to_drop={} sn={}".format(
        profile_id, lcid, nr_of_time_to_drop, sn
    )
    for key, value in kwargs.items():
        command += " {}={}".format(key, value)
    run_egate_command(command, sec=2)


def check_in_egate_that_ca_is_working(*args, **kwargs):
    arguments = kwargs

    parser_instance = BuiltIn().get_library_instance('ta_egate_cmd_parser')
    ue_stats_nr = parser_instance.get_command("ue_stats_nr")
    data = ue_stats_nr(**arguments).execute_and_parse()
    for cellidx in data:
        if cellidx.startswith('CellIndex-'):
            value_raw = data[cellidx]["Average"]["value"]
            unit_raw = data[cellidx]["Average"]["unit"]
            value = float(value_raw)
            unit = "" if unit_raw is None else unit_raw.lower()
            assert value > 0, "Average tput for {} is {}{} which is no more than 0".format(cellidx, value, unit)


def prepare_additional_bearer_setup_for_VoNR(id, qosflow):
    logger_console("Set additional bearer setup for VoNR")
    run_egate_command('smf_param id={} additional_qosflows_to_activate={}'.format(id, qosflow))


def set_ue_to_testmode(_id, testmode, profile_id, *args, **kwargs):
    command = "ue_testmode_set_nr id={} testmode={} profile_id={}".format(_id, testmode, profile_id)
    for key, value in kwargs.items():
        command += " {}={}".format(key, value)
    run_egate_command(command, sec=2)


