from testsuite.Paris.RRM.ET.resources_KRK.python.utilities import (
    logger_console, logger_warning, logger_console_info
)
from robot.libraries.BuiltIn import BuiltIn
import time


def run_egate_command(cmd, sec=2):
    BuiltIn().get_library_instance('ta5g_egate')._ute_wtssim_instance.execute_egate_command(cmd)
    time.sleep(sec)


def set_ue_capabilities(ue_param_id, ue_nr_capabilities=None, ue_eutra_nr_capabilities=None):
    cmd = "ue_param id={}".format(ue_param_id)
    if ue_nr_capabilities:
        cmd += " ue_nr_capabilities={}".format(ue_nr_capabilities)
    if ue_eutra_nr_capabilities:
        cmd += " ue_eutra_nr_capabilities={}".format(ue_eutra_nr_capabilities)
    run_egate_command(cmd)


def set_ue_testmode(profile_id, ue_p_delay_initial, ue_speed, nb_reps_ta_sim, ue_p_delay_max, ue_p_delay_min):
    run_egate_command("ue_ta_nr profile_id={} ue_p_delay_initial={} ue_speed={} "
                      "nb_reps_ta_sim={} ue_p_delay_max={} ue_p_delay_min={}".format(profile_id, ue_p_delay_initial,
                                                                                     ue_speed, nb_reps_ta_sim,
                                                                                     ue_p_delay_max, ue_p_delay_min))


def set_ue_testmode_nr(ue_id, profile_id, testmode="ta", action="activate"):
    run_egate_command(
        "ue_testmode_set_nr id={} testmode={} profile_id={} action={}".format(ue_id, testmode, profile_id, action))


def set_discard_packets_on_pdcp(ue_id, start_discard, finish_discard):
    run_egate_command("ue_param id={} pdcp_sn_discard={}:{} ".format(ue_id, start_discard, finish_discard))


def set_phr_testmode():
    run_egate_command("phr_override_testmode_nr profile_id=1 phr_start=-23 phr_min=-23 phr_max=40 phr_step_size=-63 "
                      "phr_period=1 pc_max=33 phr_mode=Fixed")


def set_phr_testmode_wrong_conditions():
    run_egate_command("phr_override_testmode_nr profile_id=2 phr_start=40 phr_min=40 phr_max=40 phr_step_size=63 "
                      "phr_period=1 pc_max=33 phr_mode=Fixed")


def update_online_dual_connectivity_params():
    run_egate_command("enb_endc_param id=1 serving_cell_index_range_scg=5:31")


def start_traffic_stream(ue, dir, trf_id=2, *args, **kwargs):
    command = "trf_data_start ue={} dir={} trf_id={}".format(ue, dir, trf_id)
    for key, value in kwargs.items():
        command += " {}={}".format(key, value)
    run_egate_command(command, sec=2)


def start_traffic_CA_stream():
    run_egate_command("trf_data_start ue=1 pdu=1 qfi=1 dir=dl trf_id=1 mbps=100")


def start_traffic_CA_stream_with_packets():
    run_egate_command("trf_data_start ue=1 pdu=1 qfi=1 dir=ul trf_id=2 mbps=50 packets=50000")


def stop_traffic_stream(ue, trf_id, *args, **kwargs):
    command = "trf_data_stop ue={} trf_id={}".format(ue, trf_id)
    for key, value in kwargs.items():
        command += " {}={}".format(key, value)
    run_egate_command(command, sec=2)


def trigger_radio_link_outage(ue_id, profile_id=1):
    run_egate_command("ue_testmode_set_nr id={} testmode=phr_override action=activate profile_id={} scell=5".format(
        ue_id, profile_id)
    )


def ue_change_location(id=2, enb=2, cell=1):
    ta5g_ue_mobility = BuiltIn().get_library_instance('ta5g_ue_mobility')
    ta5g_ue_mobility.change_ue_location(ue_id=id, dst_enb=enb, dst_cell=cell)


