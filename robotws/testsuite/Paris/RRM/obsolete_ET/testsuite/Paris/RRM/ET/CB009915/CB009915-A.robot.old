...                                             ${dict_settings_ue_2}
...                                             ${dict_settings_ue_1}
...                                             ${dict_settings_ue_2}

# configuration chBW=80MHz wo/ PRB blanking:
#    throughput - Direction L1 Values - Downlink 569.4 Mbps - Uplink 150.0 Mbps #vbo#X Y and PRBs PUSCH#
#    number of PRBs in DL: 217
#    number of PRBs in UL: 217
#    RBG Size: 16 & number of RBGs: 14
#    size for RBG 0 : 16
#    size for RBG 1 : 16
#    size for RBG 2 : 16
#    size for RBG 3 : 16
#    size for RBG 4 : 16
#    size for RBG 5 : 16
#    size for RBG 6 : 16
#    size for RBG 7 : 16
#    size for RBG 8 : 16
#    size for RBG 9 : 16
#    size for RBG 10 : 16
#    size for RBG 11 : 16
#    size for RBG 12 : 16
#    size for RBG 13 : 9
#    PRB Pooling: PRB reduction dataDLnumberOfPrbs=217, dataULnumberOfPrbs=217
# for chBW=80MHz + frameStructureType=semiStatic + ulDlDataSlotRatio=1/4 + basicBeamSet=beamSet_1 + ssBurstSetPeriod=20 + csirsTrackingPeriod=80ms
#    DL: every 8 SFNs <=> every 160 slots: DL= 2 SIB1 + 32 Specific + 89 DL= 123 slots and 123* 217= 26691 PRBs for PDSCH
#        every 5 min (pm counter interval) coeff.= (5*60*1000*2)/160=3750 <=> 23691* 3750= 100091250 PRBs for PDSCH  => M55308C10003= 100091250
#    UL: every 8 SFNs <=> every 160 slots <=> 24 UL + 8 RA slots w/ PRBs for PUSCH
#        every 5 min <=> ((24* X)+ (8* Y))* coeff.= 23160000 PRBs for PUSCH                       => M55308C10004= 23160000 #vbo#X Y and PRBs PUSCH#

${REQ_MIN_NUM_PUSCH_PRB_80MHZ_MAXI}             197    # limitation on NRCELL.reqMinNumPuschPrb for chBW=80MHz
${REQ_MIN_NUM_PUSCH_PRB_80MHZ_DEFAULT}          197    # default value defined into MIND for our configuration or maxi as not well defined
# configuration chBW=80MHz with PRB blanking:
&{CONFIG_BLANKING_A_80MHZ_default}              chBW=80MHz
...                                             type0CoresetConfigIndex=12
...                                             reqMinNumPuschPrb_maxi=${REQ_MIN_NUM_PUSCH_PRB_80MHZ_MAXI}
...                                             reqMinNumPuschPrb_default=${REQ_MIN_NUM_PUSCH_PRB_80MHZ_DEFAULT}

### nbBlankedPRBsHighEdge=15:
#    throughput - Direction L1 Values - Downlink 504.6 Mbps - Uplink 139.4 Mbps #vbo#X Y and PRBs PUSCH#
#    => estimated throughput reduction for DL= ((569-504)/569)*100= 11% and for UL= ((150-139)/150)*100= 7%
${THROUGHPUT_DL_HIGH15_BLANKED_80MHZ}           504
${THROUGHPUT_UL_HIGH15_BLANKED_80MHZ}           139
#    DL: blank RBGs 13+ 12 to have nbBlankedPRBsHighEdge=15 <= 9+ 16= 25 then nb_prbs= 217- 25= 192
#        every 5 min <=> 123* 192* coeff.= 23616* 3750= 88560000 PRBs for PDSCH                   => M55308C10003= 88560000
#    UL: (RBG not applicable) blank 15 PRBs then nb_prbs= 217- 15= 202 (<=> numOfNoneBlankedUlPrbs)
#        every 5 min <=> ((24* X)+ (8* Y))* coeff.= 21360000 PRBs for PUSCH                       => M55308C10004= 21360000 #vbo#X Y and PRBs PUSCH#
#        from TTI traces ulFdSchedData longPucchNumPuschPrbDedicatedBwp: X: ((24* X)+ (8* Y))* coeff. => M55308C10002
### nbBlankedPRBsLowEdge=5:
#    throughput - Direction L1 Values - Downlink 526 Mbps - Uplink 147 Mbps #vbo#X Y and PRBs PUSCH#
#    => estimated throughput reduction for DL= ((569-526)/569)*100= 7% and for UL= ((150-147)/150)*100= 2%
${THROUGHPUT_DL_LOW5_BLANKED_80MHZ}             526
${THROUGHPUT_UL_LOW5_BLANKED_80MHZ}             147
#    DL: blank RBG 0 to have nbBlankedPRBsLowEdge=5 <= 16 then nb_prbs= 217- 16= 201
#        every 5 min <=> 123* 201* coeff.= 24723* 3750= 92711250 PRBs for PDSCH                   => M55308C10003= 92711250
#    UL: (RBG not applicable) blank 5 PRBs then nb_prbs= 217- 5= 212 (<=> numOfNoneBlankedUlPrbs)
#        every 5 min <=> ((24* X)+ (8* Y))* coeff.= 22560000 PRBs for PUSCH                       => M55308C10004= 22560000 #vbo#X Y and PRBs PUSCH#
#        from TTI traces ulFdSchedData longPucchNumPuschPrbDedicatedBwp: X: ((24* X)+ (8* Y))* coeff. => M55308C10002
### nbBlankedPRBsLowEdge=14 and nbBlankedPRBsHighEdge=12:
#    throughput - Direction L1 Values - Downlink 460 Mbps - Uplink 132 Mbps #vbo#X Y and PRBs PUSCH#
#    => estimated throughput reduction for DL= ((569-460)/569)*100= 19% and for UL= ((150-132)/150)*100= 12%
${THROUGHPUT_DL_HIGH12_LOW14_BLANKED_80MHZ}     460
${THROUGHPUT_UL_HIGH12_LOW14_BLANKED_80MHZ}     132
#    DL: blank RBGs 13+ 12+ 0 to have nbBlankedPRBsHighEdge+nbBlankedPRBsLowEdge=12+ 14 <= 9+ 16+ 16= 41 then nb_prbs= 217- 41= 176
#        every 5 min <=> 123* 176* coeff.= 21648* 3750= 81180000 PRBs for PDSCH                   => M55308C10003= 81180000
#    UL: (RBG not applicable) blank 12+ 14= 26 PRBs then nb_prbs= 217- 26= 191 (<=> numOfNoneBlankedUlPrbs)
#        every 5 min <=> ((24* X)+ (8* Y))* coeff.= 20040000 PRBs for PUSCH                       => M55308C10004= 20040000 #vbo#X Y and PRBs PUSCH#
#        from TTI traces ulFdSchedData longPucchNumPuschPrbDedicatedBwp: X: ((24* X)+ (8* Y))* coeff. => M55308C10002

# configuration chBW=100MHz wo/ PRB blanking:
#    throughput - Direction L1 Values - Downlink 1337 Mbps - Uplink 196.0 Mbps #vbo#X Y and PRBs PUSCH#
#    number of PRBs in DL: 273
#    number of PRBs in UL: 273
#    RBG Size: 16 & number of RBGs: 18
#    size for RBG 0 : 16
#    size for RBG 1 : 16
#    size for RBG 2 : 16
#    size for RBG n : 16
#    size for RBG 17: 1
#    PRB Pooling: PRB reduction dataDLnumberOfPrbs=273, dataULnumberOfPrbs=273
# for chBW=100MHz + frameStructureType=semiStatic + ulDlDataSlotRatio=1/4 + basicBeamSet=beamSet_6 + ssBurstSetPeriod=20 + csirsTrackingPeriod=80ms
#    + actPdschAtSsbSlots=false
#    DL: every 8 SFNs <=> every 160 slots: DL= 12 SIB1 + 32 Specific + 70 DL= 114 slots and 114* 273= 31122 PRBs for PDSCH
#        every 5 min (pm counter interval) coeff.= (5*60*1000*2)/160=3750 <=> 31122* 3750= 116707500 PRBs for PDSCH  => M55308C10003= 116707500
#    UL: every 8 SFNs <=> every 160 slots <=> 26 UL + 6 RA slots w/ PRBs for PUSCH
#        every 5 min <=> ((26* X)+ (6* Y))* coeff.= ??? PRBs for PUSCH                       => M55308C10004= 30000000      #vbo#X Y and PRBs PUSCH#

${REQ_MIN_NUM_PUSCH_PRB_100MHZ_MAXI}            253    # limitation on NRCELL.reqMinNumPuschPrb for chBW=100MHz
${REQ_MIN_NUM_PUSCH_PRB_100MHZ_DEFAULT}         213    # default value defined into MIND for our configuration or maxi as not well defined
# configuration chBW=100MHz with PRB blanking:
&{CONFIG_BLANKING_A_100MHZ_default}             chBW=100MHz
...                                             type0CoresetConfigIndex=10
...                                             reqMinNumPuschPrb_maxi=${REQ_MIN_NUM_PUSCH_PRB_100MHZ_MAXI}
...                                             reqMinNumPuschPrb_default=${REQ_MIN_NUM_PUSCH_PRB_100MHZ_DEFAULT}
### nbBlankedPRBsHighEdge=0 and nbBlankedPRBsLowEdge=5:
${THROUGHPUT_DL_LOW5_BLANKED_100MHZ}            500    #vbo#throughput not maxi but used for A-9 testing#
${THROUGHPUT_UL_LOW5_BLANKED_100MHZ}            190    #vbo#throughput not maxi but used for A-9 testing#
### nbBlankedPRBsHighEdge=22 and nbBlankedPRBsLowEdge=0:
${THROUGHPUT_DL_HIGH22_BLANKED_100MHZ}          500    #vbo#throughput not maxi but used for A-9 testing#
${THROUGHPUT_UL_HIGH22_BLANKED_100MHZ}          190    #vbo#throughput not maxi but used for A-9 testing#
### nbBlankedPRBsHighEdge=13 and nbBlankedPRBsLowEdge=14:
${THROUGHPUT_DL_HIGH13_LOW14_BLANKED_100MHZ}    500    #vbo#throughput not maxi but used for A-9 testing#
${THROUGHPUT_UL_HIGH13_LOW14_BLANKED_100MHZ}    190    #vbo#throughput not maxi but used for A-9 testing#
