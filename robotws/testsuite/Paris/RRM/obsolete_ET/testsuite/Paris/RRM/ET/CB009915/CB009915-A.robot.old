[1]CB009915-A-9-Check_Physical_channels_and_signals_scheduling_Low_high_both_edges_blanked_100Mhz_NSA    #vbo#for internal debugging only#
    [Documentation]
    ...     Conditions:     it is based on the configuration ${CB009915-A_9}
    ...     Actions:        it performs the call setup for multi ue's on different cells
    ...     Checks:         it checks nothing more than already done on lib
    ...     Verdict:        the constraints on counters and KPIs are passed
    [Tags]                  CLOUD_5G_I_LO_AP_LO    VARIANT_SANSA_FS_ECPRI_CMWV_TDD_TEMP    master_classicalbts_all    SBTS00

    ${CB009915-A.act_blanking}=                 Set Variable    ${True}
    ${CB009915-A.act_commissioning}=            Set Variable    ${False}
    ${CONFIG_BLANKING_A_100MHZ_default.nbBlankedPRBsHighEdge}=      Create List         0    22    13
    ${CONFIG_BLANKING_A_100MHZ_default.nbBlankedPRBsLowEdge}=       Create List         5    0     14
    #vbo#requested throughput values are divided by the number of UEs present on the cell#
    ${dict_settings_A_9[0].throughput}=                             Evaluate    ${THROUGHPUT_DL_LOW5_BLANKED_100MHZ} / 2
    ${dict_settings_A_9[0].throughput_ul}=                          Evaluate    ${THROUGHPUT_UL_LOW5_BLANKED_100MHZ} / 2
    ${dict_settings_A_9[1].throughput}=                             Evaluate    ${THROUGHPUT_DL_HIGH22_BLANKED_100MHZ} / 2
    ${dict_settings_A_9[1].throughput_ul}=                          Evaluate    ${THROUGHPUT_UL_HIGH22_BLANKED_100MHZ} / 2
    ${dict_settings_A_9[2].throughput}=                             Evaluate    ${THROUGHPUT_DL_HIGH13_LOW14_BLANKED_100MHZ} / 2
    ${dict_settings_A_9[2].throughput_ul}=                          Evaluate    ${THROUGHPUT_UL_HIGH13_LOW14_BLANKED_100MHZ} / 2
    ${dict_settings_A_9[0].throughput}=        Convert To Integer    ${dict_settings_A_9[0].throughput}
    ${dict_settings_A_9[0].throughput_ul}=     Convert To Integer    ${dict_settings_A_9[0].throughput_ul}
    ${dict_settings_A_9[1].throughput}=        Convert To Integer    ${dict_settings_A_9[1].throughput}
    ${dict_settings_A_9[1].throughput_ul}=     Convert To Integer    ${dict_settings_A_9[1].throughput_ul}
    ${dict_settings_A_9[2].throughput}=        Convert To Integer    ${dict_settings_A_9[2].throughput}
    ${dict_settings_A_9[2].throughput_ul}=     Convert To Integer    ${dict_settings_A_9[2].throughput_ul}
    ${dict_settings_A_9[3].throughput}=                             Evaluate    ${THROUGHPUT_DL_LOW5_BLANKED_100MHZ} / 2
    ${dict_settings_A_9[3].throughput_ul}=                          Evaluate    ${THROUGHPUT_UL_LOW5_BLANKED_100MHZ} / 2
    ${dict_settings_A_9[4].throughput}=                             Evaluate    ${THROUGHPUT_DL_HIGH22_BLANKED_100MHZ} / 2
    ${dict_settings_A_9[4].throughput_ul}=                          Evaluate    ${THROUGHPUT_UL_HIGH22_BLANKED_100MHZ} / 2
    ${dict_settings_A_9[5].throughput}=                             Evaluate    ${THROUGHPUT_DL_HIGH13_LOW14_BLANKED_100MHZ} / 2
    ${dict_settings_A_9[5].throughput_ul}=                          Evaluate    ${THROUGHPUT_UL_HIGH13_LOW14_BLANKED_100MHZ} / 2
