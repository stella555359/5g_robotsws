Suite Setup    CB009915-Common-Keywords.Suite Setup CB009915-Common    keep_all_data_in_file=${True}    #vbo#debug#in some cases#
Suite Teardown                                  CB009915-Common-Keywords.Suite Teardown CB009915-Common    #vbo#debug#

*** Variables ***
# Hardware Variables
${isASOH}                                       ${False}
# capture setting
&{CAPTURE_L1L2}                                 is_capture_core=${False}
...                                             is_capture_cprt=${False}
...                                             is_capture_l1l2=${True}

# tests settings
&{CB009915-A}                                   act_blanking=${True}                    # blanking treatment is requested if parameter is true
...                                             act_commissioning=${True}               # commissioning is performed if parameter is true
...                                             capture_duration=0                      # capture duration during traffic starting phase
...                                             deviation=10                            # default deviation for throughput and double for uplink
...                                             dir=UL+DL
...                                             duration=3                              # traffic duration during declaration phase
...                                             pm_waiting_period=2                     # number of waiting periods added for observation
...                                             target_gnb=2                            # gnb target id
...                                             total_nb_cell=2                         # total number of cell used for ue's dispatching
...                                             total_nb_ue=0                           # total number of ue's to configure

# tests settings
&{CB009915-A_9}                                 act_blanking=${True}                    # blanking treatment is requested if parameter is true
...                                             act_commissioning=${False}              # commissioning is performed if parameter is true
...                                             capture_duration=0                      # capture duration during traffic starting phase
...                                             deviation=99                            # default deviation for throughput and double for uplink
...                                             dir=UL+DL
...                                             duration=3                              # traffic duration during declaration phase
...                                             pm_waiting_period=2                     # number of waiting periods added for observation
...                                             target_gnb=2                            # gnb target id
...                                             total_nb_cell=3                         # total number of cell used for ue's dispatching
...                                             total_nb_ue=0                           # total number of ue's to configure

# ue's settings # configuration based chBW=80MHz wo/ blanking
&{dict_settings_ue_1}                           nsa_bearer=2
...                                             original_cell=1                         # original cell for call establishment
...                                             throughput=569                          # dl throughput nonGBR max for ue in chBW=80MHz wo/ blanking
...                                             throughput_gbr=${NO_THROUGHPUT}         # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                             throughput_ul=150                       # ul throughput nonGBR max for ue in chBW=80MHz wo/ blanking

&{dict_settings_ue_2}                           nsa_bearer=2
...                                             original_cell=2
...                                             throughput=569
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=150

# ue's settings # configuration based chBW=100MHz wo/ blanking
&{dict_settings_ue_9_1}                         nsa_bearer=2
...                                             original_cell=1                         # original cell for call establishment
...                                             throughput=251                          # dl throughput nonGBR max for ue in chBW=100MHz wo/blanking
...                                             throughput_gbr=${NO_THROUGHPUT}         # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                             throughput_ul=81                        # ul throughput nonGBR max for ue in chBW=100MHz wo/blanking

&{dict_settings_ue_9_2}                         nsa_bearer=3
...                                             original_cell=2
...                                             throughput=252
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=82

&{dict_settings_ue_9_3}                         nsa_bearer=4
