*** Test Cases ***

[1]CB009915-A-6-Check_Physical_channels_and_signals_scheduling_High_ edge_blanked_80Mhz_NSA
    [Documentation]
    ...     Conditions:     it is based on the configuration ${CB009915-A}
    ...     Actions:        it performs the call setup for single ue on cell1
    ...     Checks:         it checks nothing more than already done on lib
    ...     Verdict:        the constraints on counters and KPIs are passed
    [Tags]                  CLOUD_5G_I_LO_AP_LO    VARIANT_SANSA_FS_ECPRI_CMWV_TDD_TEMP    master_classicalbts_all    SBTS00

    ${CB009915-A.act_blanking}=                 Set Variable    ${True}
    ${CB009915-A.act_commissioning}=            Set Variable    ${True}
    ${CONFIG_BLANKING_A_80MHZ_default.nbBlankedPRBsHighEdge}=       Create List         15    0
    ${CONFIG_BLANKING_A_80MHZ_default.nbBlankedPRBsLowEdge}=        Create List         0     0
    ${dict_settings_single_ue[0].throughput}=                       Evaluate    ${THROUGHPUT_DL_HIGH15_BLANKED_80MHZ}
    ${dict_settings_single_ue[0].throughput_ul}=                    Evaluate    ${THROUGHPUT_UL_HIGH15_BLANKED_80MHZ}
    Dated Log New Line                          ===> after throughput correction then dict_settings= ${dict_settings_single_ue}
    CB009915_A_6_NSA                            config_blanking=${CONFIG_BLANKING_A_80MHZ_default}
    ...                                         dict_ues=${dict_settings_single_ue}
    ...                                         is_capture=${CAPTURE_L1L2}
    ...                                         param=${CB009915-A}
    ...                                         test_name=TC_CB009915_A_6_NSA
    [Teardown]                                  Setup.Test Teardown


