*** Variables ***

${gnb_alias}                      gnb_under_test

&{FIELDS_cell_Powerbackoff}
...              actDynamicPowerBackoff=2
...              lowerMcsPowerBackoff=14
...              upperMcsPowerBackoff=18

&{FIELDS_modif_Powerbackoff}
...              actDynamicPowerBackoff=1
...              lowerMcsPowerBackoff=0
...              upperMcsPowerBackoff=27

&{dict_settings_ue_1}                                                ue=21
...                                                                  pdu=1
...                                                                  throughput_dl=175
...                                                                  deviation_dl=10     # Allowed % deviation for DL throughput
...                                                                  throughput_ul=100
...                                                                  deviation_ul=10     # Allowed % deviation for UL throughput
...                                                                  originalCell=2

@{dict_settings_all_ues}                                            ${dict_settings_ue_1}


*** Keywords ***

CB012533_B_B1_2
    [Documentation]        Test to check that modification NIDD parameter on line is done
    ...                    CPRT-L2 Interface, No drop
    [Arguments]            ${param}

    Init Sequence        ${param}
    STEP                 CB012533 Setup Mirroring     prefix=CB012533_B_PowerBackoff
    STEP                 CB012533 Start Capture CPRT
    STEP                 Cell Setup
    STEP                 CB012533 Stop Capture CPRT
    STEP                 Check PowerBackoff parameter      ${CAPTURE_CPRT}    ${FIELDS_cell_Powerbackoff}
    ${listOfUes}         Build UEs list SA Multi UEs
    STEP                 SA Attach and Start Traffic Multi UEs       ${param}    ${listOfUes}
    STEP                 CB012533 Setup Mirroring     prefix=CB012533_B_PowerBackoff_modifonline
    STEP                 CB012533 Start Capture CPRT
    STEP                 Modification on line PowerBackoff parameter
    STEP                 CB012533 Stop Capture CPRT
    STEP                 Check Modification on line PowerBackoff parameter   ${CAPTURE_CPRT}    ${FIELDS_modif_Powerbackoff}
    [Teardown]           Run Keywords       Produce Scout data      AND
    ...                                     GenericTest.Display diagnosis

Check PowerBackoff parameter
    [Documentation]
    ...     Actions:        Take trace CPRT-L2PS
    ...     Checks:         Check in message l2_ps_cell_cellsetup_req the field actDynamicPowerBackoff,
    ...                     lowerMcsPowerBackoff and upperMcsPowerBackoff
    ...     Verdict:        Check the value configured after the cell setup
    [Arguments]    ${CAPTURE_CPRT}    ${FieldShowName}
    Dated Log    [Checking PowerBackoff parameters]
    Dated Log    ----> convert pcap to pdml with filter itf_l2_ps_cell_cellsetupreq
    Dated Log    ----> pcap file : ${CAPTURE_CPRT}

    ${pdml}                     analyzer.pcap_to_pdml      ${CAPTURE_CPRT.path}

    ${msg_field}       Set Variable    @{FieldShowName.keys()}

    Dated Log    ---->  Getting some captured value in itf_l2_ps_cell_cellsetupreq

    Dated log new line                 for Cell 2 NRcellIdentity
    FOR    ${Field}   IN           @{msg_field}
            ${Value}          set variable    ${FieldShowName["${Field}"]}
            Dated Log         --- Check ${Field} = ${Value}
            analyzer.check_exists_once     pdmlFile=${pdml}
            ...                            packetName=itf_l2_ps_cell_cellsetupreq
            ...                            path=${Field}
            ...                            value=${Value}
            ...                            kind=showname
            ...                            test=MATCH
    END
    [return]    ${pdml}

Modification on line PowerBackoff parameter
    [Documentation]
     ...     Actions:        Modify parameter on line actDynamicPowerBackoff,
     ...                     lowerMcsPowerBackoff and upperMcsPowerBackoff
     ...     Checks:         No check
     ...     Verdict:        Nothing
    Dated Log    Modify on line

    sbts_coam.connect_to          name=${gnb_alias}
    Run Keywords                  coam_parameter.perform_scf_delta_commission
    ...                           delta_file=${delta_scf_PowerBackoff_modif}
    ...                           connection=${gnb_alias}
    # Wait end of commissioning
    ...                           AND
    ...                           OAM wait available
    sbts_coam.teardown            connection=${gnb_alias}


Check Modification on line PowerBackoff parameter
    [Documentation]
    ...     Actions:        Take trace CPRT-L2PS
    ...     Checks:         Check in message l2_ps_cell_cellreconfigurationreq the field actDynamicPowerBackoff,
    ...                    lowerMcsPowerBackoff and upperMcsPowerBackoff
    ...     Verdict:        Check the new value configured after the on line modification
    [Arguments]    ${CAPTURE_CPRT}    ${FieldShowName}
    Dated Log    [Checking dlla modif on line parameters]
    Dated Log    ----> convert pcap to pdml with filter itf_l2_ps_cell_cellreconfigurationreq
    Dated Log    ----> pcap file : ${CAPTURE_CPRT}

    ${pdml}                     analyzer.pcap_to_pdml      ${CAPTURE_CPRT.path}
    ${msg_field}       Set Variable    @{FieldShowName.keys()}

    Dated Log    ---->  Getting some captured value in itf_l2_ps_cell_cellreconfigurationreq
    Dated log new line                 for Cell 2 NRcellIdentity
    FOR     ${Field}   IN           @{msg_field}
            ${Value}          set variable    ${FieldShowName["${Field}"]}
            Dated Log         --- Check ${Field} = ${Value}
            analyzer.check_exists_once     pdmlFile=${pdml}
            ...                            packetName=itf_l2_ps_cell_cellreconfigurationreq
            ...                            path=${Field}
            ...                            value=${Value}
            ...                            kind=showname
            ...                            test=MATCH
    END
    [return]    ${pdml}

