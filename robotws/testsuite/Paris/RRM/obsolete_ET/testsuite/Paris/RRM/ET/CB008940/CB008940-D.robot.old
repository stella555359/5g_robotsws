# Libraries

# Resources
Resource          ./resources/robot/CB008940-D-Keywords.robot

# Tags
Force Tags        CA_5G_SW_FR-Villarceaux    RRM
...               PY36
...               CLOUD_5G_I_LO_AP_LOOO_SANSA_FS_ECPRI_CMWV_TDD
...               master_classicalbts_all    SBTS00    SBTS23R1    SBTS22R4
#...              CONFIGS_POOLING/CB008940/CB008940_x/custom_config_8940_x.yaml
...               CONFIGURED    5G_RAN    RAN_5G    CRT

# Suites
#Suite Setup       CB008940-Common-Keywords.Suite Setup CB008940-Common
#Suite Teardown    CB008940-Common-Keywords.Suite Teardown CB008940-Common
Suite Setup       CB008940-Common-Keywords.Suite Setup CB008940-Common
...               yamlPathname=${CURDIR}/../../../../../custom-config/POOLING/CB008940/CB008940_C/custom_config_8940_C_SemiStatic.yaml


*** Variables ***
${TestSharkTool}                                                    MC_SHARK
# capture setting
&{CAPTURE_OFF}                                                      isCaptureL1L2=${False}
...                                                                 isCaptureCORE=${False}
...                                                                 isCaptureCPRT=${False}

&{CAPTURE_INVES}                                                    isCaptureL1L2=${False}
...                                                                 isCaptureCORE=${False}
...                                                                 isCaptureCPRT=${False}
# tests settings
&{D_3-ET1D}                                                         dir=DL
...                                                                 totalNbOfUe=0                 # total number of ue's to configure
...                                                                 totalNbOfCell=3               # total number of cell used for ue's dispatching
...                                                                 targetGnb=2                   # gnb target id
...                                                                 captureDuration=0             # capture duration during traffic starting phase
...                                                                 duration=3                    # traffic duration during declaration phase
...                                                                 deviation=10                  # allowed deviation for throughput
...                                                                 NbOfHo=1                      # number of Ho ping-pong and 0 is to disable it
...                                                                 mcc=311                       # default mcc for PLMN
...                                                                 mnc=489                       # default mnc for PLMN

&{D_7ues_noHO}                                                      dir=DL
...                                                                 totalNbOfUe=7
...                                                                 totalNbOfCell=3
...                                                                 targetGnb=2
...                                                                 captureDuration=0
...                                                                 duration=3
...                                                                 deviation=10
...                                                                 NbOfHo=0
...                                                                 mcc=311
...                                                                 mnc=489

# ue's settings
&{dict_settings_ue_1}                                               originalCell=1                # original cell for call establishment
...                                                                 throughput=100                # throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 throughput_GBR=${NO_THROUGHPUT}  # throughput GBR for ue or ${NO_THROUGHPUT} 
...                                                                 requestForHo=${False}         # ho is requested if flag is True
...                                                                 targetCellForHo=2             # target cell for Ho - different as original cell
...                                                                 delayPostHo=5s                # delay to wait after Ho

&{dict_settings_ue_2}                                               originalCell=2
...                                                                 throughput=400
...                                                                 throughput_GBR=${NO_THROUGHPUT}
...                                                                 requestForHo=${True}
...                                                                 targetCellForHo=3
...                                                                 delayPostHo=10s

&{dict_settings_ue_3}                                               originalCell=3
...                                                                 throughput=25
...                                                                 throughput_GBR=${NO_THROUGHPUT}
...                                                                 requestForHo=${False}
...                                                                 targetCellForHo=2
...                                                                 delayPostHo=5s

&{dict_settings_ue_default}                                         originalCell=1
...                                                                 throughput=1
...                                                                 throughput_GBR=${NO_THROUGHPUT}
...                                                                 requestForHo=${False}
...                                                                 targetCellForHo=2
...                                                                 delayPostHo=3s

@{dict_settings_all_ues}                                            ${dict_settings_ue_1}
...                                                                 ${dict_settings_ue_2}
...                                                                 ${dict_settings_ue_3}

&{dict_settings_ue_cell1}                                           originalCell=1                # original cell for call establishment
...                                                                 throughput=90                 # throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 throughput_GBR=${NO_THROUGHPUT}  # throughput GBR for ue or ${NO_THROUGHPUT} 
...                                                                 requestForHo=${False}         # ho is requested if flag is True
...                                                                 targetCellForHo=2             # target cell for Ho - different as original cell
...                                                                 delayPostHo=5s                # delay to wait after Ho

&{dict_settings_ue_cell2}                                           originalCell=2
...                                                                 throughput=90
...                                                                 throughput_GBR=${NO_THROUGHPUT}
...                                                                 requestForHo=${False}
...                                                                 targetCellForHo=3
...                                                                 delayPostHo=5s

&{dict_settings_ue_cell3}                                          originalCell=3
...                                                                 throughput=90
...                                                                 throughput_GBR=${NO_THROUGHPUT}
...                                                                 requestForHo=${False}
...                                                                 targetCellForHo=2
...                                                                 delayPostHo=5s

&{dict_settings_ue_gbr_cell1}                                       originalCell=1
...                                                                 throughput=${NO_THROUGHPUT}
...                                                                 throughput_GBR=10
...                                                                 requestForHo=${False}
...                                                                 targetCellForHo=2
...                                                                 delayPostHo=5s

&{dict_settings_ue_gbr_cell2}                                       originalCell=2
...                                                                 throughput=${NO_THROUGHPUT}
...                                                                 throughput_GBR=10
...                                                                 requestForHo=${False}
...                                                                 targetCellForHo=3
...                                                                 delayPostHo=5s

&{dict_settings_ue_gbr_cell3}                                       originalCell=3
...                                                                 throughput=${NO_THROUGHPUT}
...                                                                 throughput_GBR=10
...                                                                 requestForHo=${False}
...                                                                 targetCellForHo=2
...                                                                 delayPostHo=5s

@{dict_settings_8_ues}                                              ${dict_settings_ue_gbr_cell1}
...                                                                 ${dict_settings_ue_gbr_cell2}
...                                                                 ${dict_settings_ue_gbr_cell3}
...                                                                 ${dict_settings_ue_cell1}
...                                                                 ${dict_settings_ue_cell2}
...                                                                 ${dict_settings_ue_cell3}
...                                                                 ${dict_settings_ue_cell3}
...                                                                 ${dict_settings_ue_cell3}

# vendor's setting
&{VENDOR_CUSTOM_1}                                                  bbHwVariant=ABIO
...                                                                 maxNumScheUePdschL1Pool=None
...                                                                 maxNumScheUePdschL1Sp=None
