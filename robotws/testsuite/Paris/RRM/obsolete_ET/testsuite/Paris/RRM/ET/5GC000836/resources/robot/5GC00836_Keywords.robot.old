TC 836N
    [Documentation]                 Generic test for 5GC00836_xxx tests
    [Arguments]                     ${param}
    Init Sequence                   ${param}
    Critical Step                   Set MRBTSID and NRBTSID
    Critical Step                   Set Context_Element Manager with PDCCH Config 5MHz
    Step                            Set Context_AP IPHY
    Step                            Set Context_WTS CFG
    Critical Step                   Restart TL          isOAMRebooted=True
    Step                            5GC00836_Keywords.WTS Setup                 depends=Restart TL
    Critical Step                   UE Cell Setup Check
    Critical Step                   5GC00836_Keywords.SgNB Addition to ENB
    Critical Step                   UE Attach Check
    Step                            DL_Traffic Feature 836
    Step                            UL_Traffic Feature 836
    [Teardown]                      Teardown 836

Teardown 836
    Dated log                       Test ending
    Produce Scout Data
    [Teardown]                      GenericTest.Display diagnosis

WTS Setup
    CallSetup.WTS Setup             shouldUseLua=${False}           nbCell=2

SgNB Addition to ENB
    CallSetup.SgNB Addition to ENB          ueSetting=${UE_SIMPLE}

Set MRBTSID and NRBTSID
    ${dist_name_nrbts}                   Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ${dist_name_nrcell1}                 Set Variable    ${dist_name_nrbts}/NRCELL-${FDD_Cell_list[0].nrCellId}
    ${ch_dist_name_nrcell1}              Set Variable    ${dist_name_nrcell1}/NRCELL_FDD-1
    ${dist_name_nrcell2}                 Set Variable    ${dist_name_nrbts}/NRCELL-${FDD_Cell_list[1].nrCellId}
    ${ch_dist_name_nrcell2}              Set Variable    ${dist_name_nrcell2}/NRCELL_FDD-1
    ${dist_name_nrsysinfoprofile}        Set Variable    ${dist_name_nrbts}/NRSYSINFO_PROFILE-1
    ${dist_name_bwp33pdcchcommon}        Set Variable    ${dist_name_nrbts}/BWP_PROFILE-33/PDCCH-1/PDCCH_CONFIG_COMMON-1
    ${dist_name_bwp33pdcchdedicated}     Set Variable    ${dist_name_nrbts}/BWP_PROFILE-33/PDCCH-1/PDCCH_CONFIG_DEDICATED-1
    ${dist_name_bwp4}                    Set Variable    ${dist_name_nrbts}/BWP_PROFILE-4/
    ${dist_name_bwp4pdcchcommon}         Set Variable    ${dist_name_nrbts}/BWP_PROFILE-4/PDCCH-1/PDCCH_CONFIG_COMMON-1

    Set Suite Variable              ${dist_name_nrbts}
    Set Suite Variable              ${dist_name_nrcell1}
    Set Suite Variable              ${ch_dist_name_nrcell1}
    Set Suite Variable              ${dist_name_nrcell2}
    Set Suite Variable              ${ch_dist_name_nrcell2}
    Set Suite Variable              ${dist_name_nrsysinfoprofile}
    Set Suite Variable              ${dist_name_bwp33pdcchcommon}
    Set Suite Variable              ${dist_name_bwp33pdcchdedicated}
    Set Suite Variable              ${dist_name_bwp4}
    Set Suite Variable              ${dist_name_bwp4pdcchcommon}

Set Context_Element Manager
#    ${SCF_PATH_836_DU}              Run Keyword If                  ${isAic}
#    ...                             OAM Get SCF File                oam=${GNB_DU.oam}          file=SCF_Setup_836_DU.xml
#    ${SCF_PATH_836_CU}              Run Keyword If                  ${isAic}
#    ...                             OAM Get SCF File                oam=${GNB_CU.oam}          file=SCF_Setup_836_CU.xml
#    ${SCF_PATH_836}                 Run Keyword If                  not ${isAic}
#    ...                             OAM Get SCF File                file=SCF_Setup_836.xml
#
#    Run Keyword If                  ${isAic}
#    ...                             Run Keywords
#    ...                             Set Suite Variable              ${SCF_PATH_836_DU}
#    ...    AND                      Set Suite Variable              ${SCF_PATH_836_CU}
#    ...    AND                      SCF StartSession                scf_file=${SCF_PATH_836_DU}
#    ...                             scf_file_CU=${SCF_PATH_836_CU}
#
#    Run Keyword If                  not ${isAic}
#    ...                             Run Keywords
#    ...                             Set Suite Variable              ${SCF_PATH_836}
#    ...    AND                      SCF StartSession                scf_file=${SCF_PATH_836}

    ${SCF_PATH_836_DU}              OAM Get SCF File                oam=${GNB_DU.oam}        file=SCF_Setup_836_DU.xml
    ${SCF_PATH_836_CU}              OAM Get CU SCF File             file=SCF_Setup_836_CU.xml

    Set Suite Variable              ${SCF_PATH_836_DU}
    Set Suite Variable              ${SCF_PATH_836_CU}
    SCF StartSession                scf_file=${SCF_PATH_836_DU}     second_scf_file=${SCF_PATH_836_CU}

    SCF Set element                 dist_name=${dist_name_nrbts}
    ...                             element_name=actGeneralConnectivitySilver
    ...                             element_value=${param.actGeneralConnectivitySilver}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${dist_name_nrcell1}
    ...                             element_name=gscnOrSsPbchArfcn
    ...                             element_value=${param.gscnOrSsPbchArfcn}
