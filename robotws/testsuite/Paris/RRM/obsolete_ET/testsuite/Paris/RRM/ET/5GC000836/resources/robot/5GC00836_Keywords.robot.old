*** Keywords ***
TC 836
    [Documentation]                 Generic test for 5GC00836_xxx tests
    [Arguments]                     ${param}
    Init Sequence                   ${param}
    Critical Step                   Set MRBTSID and NRBTSID
    Critical Step                   Set Context_Element Manager
    Step                            Set Context_AP IPHY
    Step                            Set Context_WTS CFG
    Critical Step                   Restart TL          isOAMRebooted=True
    Step                            5GC00836_Keywords.WTS Setup                 depends=Restart TL
    Critical Step                   UE Cell Setup Check
#    Step                            Activate Sherpa
    Critical Step                   5GC00836_Keywords.SgNB Addition to ENB
    Critical Step                   UE Attach Check
#    Critical Step                   ${param.dir} Traffic Feature 836            timeout=10800s
    Step                            DL_Traffic Feature 836
    Step                            UL_Traffic Feature 836
    [Teardown]                      Teardown 836

TC 836 VRAN Band 71
    [Documentation]                 Generic test for 5GC00836_xxx tests
    [Arguments]                     ${param}
    Init Sequence                   ${param}
    Step                            Set MRBTSID and NRBTSID
    Step                            Set Context_AP IPHY
    Step                            Set Context_WTS CFG Band 71
    Critical Step                   Set Context_Element Manager Band 71
    Critical Step                   Restart TL          isOAMRebooted=False
    # Configure the ue setting for a NSA call establishment on 1st FDD cell
    @{list_ue}=                     Create List
    ${1st_FDD_cell_id}              Set Variable    ${FDD_Cell_list[0].nrCellId}
    ${1st_FDD_cell_NSA_ue_param_id}    Set Variable    151
    ${ue_setting_nsa_1st_fdd_cell}=    Copy Dictionary          ${UE_SIMPLE}
    Set To Dictionary               ${ue_setting_nsa_1st_fdd_cell}    ue    ${1st_FDD_cell_NSA_ue_param_id}
    # Dispatching the ue on the requested original cell for the call establishment
    Set To Dictionary               ${ue_setting_nsa_1st_fdd_cell}    target_cells    ${1st_FDD_cell_id}
    Append To List                  ${list_ue}    ${ue_setting_nsa_1st_fdd_cell}
    Dated Log New Line              ===> ue setting is ${list_ue}
    #
    Critical Step                   CallSetup.WTS Setup    nbUe=1    shouldUseLua=${False}    list_of_UE_tobe_created=${list_ue}
    Critical Step                   CallSetup.SgNB Addition to ENB    ueSetting=${list_ue[0]}
    #vbo#checking Ue attach is now part of attach procedure.This KW is now deprecated#Critical Step                   UE Attach Check
    Step                            DL Traffic Feature 836    current_ue_setting=${list_ue[0]}
    Step                            UL Traffic Feature 836    current_ue_setting=${list_ue[0]}
    [Teardown]                      Teardown 836

