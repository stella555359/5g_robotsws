#    Run Keyword If                  ${isAic}
#    ...                             Run Keywords
#    ...                             SCF StopSession                 scf_file=${SCF_PATH_836_DU}     nodeType=vdu
#    ...    AND                      SCF StopSession                 scf_file=${SCF_PATH_836_CU}     nodeType=vcu
#    ...    AND                      Dated Log                       Modifications completed.\n
#    ...    AND                      Oam.OAM Perform Full Commissioning    scf_file=${SCF_PATH_836_DU}
#    ...    AND                      Oam.OAM Perform Full Commissioning    scf_file=${SCF_PATH_836_CU}    oam=${GNB_CU.oam}
#
#    Run Keyword If                  not ${isAic}
#    ...                             Run Keywords
#    ...                             SCF StopSession                         scf_file=${SCF_PATH_836}
#    ...    AND                      Dated Log                               Modifications completed.\n
#    ...    AND                      Oam.OAM Perform Full Commissioning      scf_file=${SCF_PATH_836}
#
#    Run keyword if                  ${isAic}
#    ...                             Wait Vcu And Vdu Available
#    Run Keyword If                  not ${isAic}
#    ...                             WA Airscale Wait For Ready              ${GNB_DU}

    SCF StopSession                 scf_file=${SCF_PATH_836_DU}     second_scf_file=${SCF_PATH_836_CU}
    Dated Log                         Modifications completed.\n
    Oam.OAM Perform Full Commissioning          scf_file=${SCF_PATH_836_DU}
    Run Keyword If                 ${isAic}
    ...                            Oam.OAM Perform Full Commissioning    scf_file=${SCF_PATH_836_CU}    oam=${GNB_CU.oam}

    Run keyword if                  ${isAic}
    ...                             Wait Vcu And Vdu Available

    Run Keyword If                  not ${isAic}
    ...                             WA Airscale Wait For Ready              ${GNB_DU}

