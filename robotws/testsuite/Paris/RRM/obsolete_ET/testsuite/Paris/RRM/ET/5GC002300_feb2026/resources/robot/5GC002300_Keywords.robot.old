5GC002300_PMCounterCheck_Expected_Value
    [Arguments]         ${Counter_Id}           ${Expected_Value}
    &{expected_dict}    Create Dictionary       counter=${Counter_Id}   obj=NRCELL    objId=${NRCELL_ID}
    # ClassicalBTS case:
    ${Counter_Value}=   Run Keyword If          not ${isAiC}    Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                                                         ${LATEST_FILE}      ${Counter_Id}    ${NRCELL_ID}
    Run Keyword If      not ${isAiC}            Run Keywords
    ...                                         BuiltIn.Log     The last value of PM counter ${Counter_Id} is : ${Counter_Value}
    ...                                         AND
    ...                                         should be equal as integers     ${Expected_Value}    ${Counter_Value}
    # VRAN2.0 case:
    ${mycomparison}=    Set Variable            '=='
    Run Keyword If      ${isAic}                Traced Sleep    duration=5min
    ...                                                         msg=VRAN as it needs sometime more time
    ${foundOrNot}       Run Keyword If          ${isAic}
    ...                 Counters.Check At Least One Value Is In Criteria From Pm Files For Object With ID on vDU
    ...                 ${Expected_Value}       ${mycomparison}         &{expected_dict}
    Run Keyword If      ${isAiC}                should be true          ${foundOrNot}


5GC002300_PMCounterCheck_greater_than_Expected_Value
    [Arguments]         ${Counter_Id}    ${Expected_Value}
    BuiltIn.Log         Eirp Control Segment Check in latest pm file: ${LATEST_FILE} the value of ${Counter_Id}
    ${Counter_Value}=   Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                 ${LATEST_FILE}      ${Counter_Id}    ${NRCELL_ID}
    BuiltIn.Log         The last value of PM counter : ${Counter_Id} is : ${Counter_Value}
    should be true      ${Counter_Value} > ${Expected_Value}


5GC002300_PMCounterCheck_greater_than_and_equal_to
    [Arguments]         ${Counter_Id_1}    ${Counter_Id_2}
    BuiltIn.Log         Eirp Control Segment Check in latest pm file: ${LATEST_FILE} the value of ${Counter_Id_1}
    ${PM_Counter_1_Value}=    Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                       ${LATEST_FILE}      ${Counter_Id_1}    ${NRCELL_ID}
    BuiltIn.Log         The last value of PM counter : ${Counter_Id_1} is : ${PM_Counter_1_Value}
    ${PM_Counter_2_Value}=    Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                       ${LATEST_FILE}       ${Counter_Id_2}    ${NRCELL_ID}
    BuiltIn.Log         The last value of PM counter : ${Counter_Id_2} is : ${PM_Counter_2_Value}
    should be true      ${PM_Counter_1_Value} >= ${PM_Counter_2_Value}


5GC002300_PMCounterCheck_Compare_Counters
    [Arguments]         ${Counter_Id_1}    ${Counter_Id_2}
    BuiltIn.Log         Eirp Control Segment Check in latest pm file: ${LATEST_FILE} the value of ${Counter_Id_1}
    ${PM_Counter_1_Value}=    Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                       ${LATEST_FILE}      ${Counter_Id_1}    ${NRCELL_ID}
    BuiltIn.Log         The last value of PM counter : ${Counter_Id_1} is : ${PM_Counter_1_Value}
    ${PM_Counter_2_Value}=      Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                         ${LATEST_FILE}      ${Counter_Id_2}     ${NRCELL_ID}
    BuiltIn.Log         The last value of PM counter : ${Counter_Id_2} is : ${PM_Counter_2_Value}
    run keyword if      '${Counter_Id_2}'=='M55324C00705'
    ...                     should be true      ${PM_Counter_1_Value} >= ${PM_Counter_2_Value}/3000
    ...     ELSE IF     '${Counter_Id_2}'=='M55324C00802'
    ...                     should be true      ${PM_Counter_1_Value} >= ${PM_Counter_2_Value}/3000
    ...     ELSE        should be true          ${PM_Counter_1_Value} == ${PM_Counter_2_Value}


5GC002300_PMCounterCheck_Compare_Counters_Average
    [Arguments]     ${Counter_Id_1}    ${Counter_Id_2}  ${Counter_Id_3}
    BuiltIn.Log     Eirp Control Segment Check in latest pm file: ${LATEST_FILE} the value of ${Counter_Id_1}
    ${PM_Counter_1_Value}=    Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                       ${LATEST_FILE}      ${Counter_Id_1}    ${NRCELL_ID}
    BuiltIn.Log     The last value of PM counter : ${Counter_Id_1} is : ${PM_Counter_1_Value}
    ${PM_Counter_2_Value}=    Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                       ${LATEST_FILE}       ${Counter_Id_2}    ${NRCELL_ID}
    BuiltIn.Log     The last value of PM counter : ${Counter_Id_2} is : ${PM_Counter_2_Value}
    ${PM_Counter_3_Value}=    Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                       ${LATEST_FILE}       ${Counter_Id_3}    ${NRCELL_ID}
    BuiltIn.Log     The last value of PM counter : ${Counter_Id_3} is : ${PM_Counter_3_Value}
    ${ave_1}=       Evaluate  ${PM_Counter_1_Value}/${PM_Counter_3_Value}
    ${ave_2}=       Evaluate  ${PM_Counter_2_Value}/${PM_Counter_3_Value}
    ${diff}=        Evaluate  ${ave_1} - ${ave_2}
    BuiltIn.log     The diff between the two averraged values : ${diff}
    should be true  -2 <= ${diff}/1000 <= 2


