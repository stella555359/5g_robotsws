Set MRBTSID and NRBTSID
    coam.connect to     bts_host=${tl.gnbs[0].cu.oam_http_connection_details.addr}   name=coam_admin
    &{bts_info}         coam.Get Bts Info       connection=coam_admin
    ${mrbtsID} =        Get From Dictionary     ${bts_info}     mrbtsID
    Run                 echo ${bts_info} >/tmp/bts_info.txt
    ${nrbtsID}          Run    grep -oE "NRBTS-[0-9]+" /tmp/bts_info.txt | awk -F '-' '{print $2}' | awk 'NR==1'
    ${dist_name} =      Set Variable    MRBTS-${mrbtsID}/NRBTS-${nrbtsID}/NRCELL-1
    ${ch_dist_name} =   Set Variable    MRBTS-${mrbtsID}/NRBTS-${nrbtsID}/NRCELL-1/NRCELL_FDD-1
    Set Suite Variable  ${dist_name}
    Dated log           ${dist_name}
    Set Suite Variable  ${ch_dist_name}


Set Cell Grid
    [Documentation]     Set Parameters of Cell grid to be changed
    [Arguments]         ${param}
    &{parametersCell}   Create Dictionary   segmentAzimuthEdge0=${param.segmentAzimuthEdge0}
    ...                                     segmentAzimuthEdge1=${param.segmentAzimuthEdge1}
    ...                                     segmentAzimuthEdge2=${param.segmentAzimuthEdge2}
    ...                                     numOfSegmentAzimuthEdges=${param.numOfSegmentAzimuthEdges}
    &{eirpcontrolstructure1}    Evaluate    {'dist_name': '${dist_name2}','parameter': 'eirpControl','value':[&{parametersCell}]}
    &{parametersListPRB}    Create Dictionary
    ...                                 dist_name=${dist_name2}
    ...                                 parameter=eirpControlPowerReductionFactorList
    ...                                 value=${param.eirpControlPowerReductionFactorList}
    @{param_list}       Create List     ${eirpcontrolstructure1}   ${parametersListPRB}   #${parametersListPRB}
    Dated log           Parameters to modify:\n ${param_list}
    OAM Set Params      ${param_list}


Set Context_Element Manager
