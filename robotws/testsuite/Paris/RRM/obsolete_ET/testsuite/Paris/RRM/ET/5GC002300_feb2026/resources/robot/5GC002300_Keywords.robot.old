    ...    parameter=eirpControlPowerReductionFactorList
    ...    dist_name=${dist_name2}
    ...    value=${param.eirpControlPowerReductionFactorList}
    @{modify_param}     Create List     #${modify_param1}
    ...                                 ${modify_param2}   ${modify_param3}
    Dated log           Parameters to modify:\n ${modify_param}
    OAM Set Params      ${modify_param}


