    ...    dist_name=${dist_name}
    ...    p_name=externalAntennaGain
    ...    nodeType=Vdu
    ...    ListParamterToModify=${ListParamterToModify}
    ${ListCellParamterToModify}=        add Param to Modify Param list
    ...    value=1
    ...    dist_name=${dist_name}
    ...    p_name=eirpControlTimeAveragingWindow
    ...    nodeType=Vdu
    ...    ListParamterToModify=${ListParamterToModify}
    ${ListCellParamterToModify}=        add Param to Modify Param list
    ...    value=1
    ...    dist_name=${dist_name}
    ...    p_name=mcsIndexForArtificialLoad
    ...    nodeType=Vdu
    ...    ListParamterToModify=${ListParamterToModify}
    ${ListCellParamterToModify}=        add Param to Modify Param list
    ...    value=320
    ...    dist_name=${dist_name}
    ...    p_name=pMax
    ...    nodeType=Vdu
    ...    ListParamterToModify=${ListParamterToModify}
