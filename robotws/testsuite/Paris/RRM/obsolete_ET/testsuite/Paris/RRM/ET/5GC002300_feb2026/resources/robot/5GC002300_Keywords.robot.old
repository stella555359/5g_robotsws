Check Cell on Air
    coam.connect to     bts_host=${tl.gnbs[0].cu.oam_http_connection_details.addr}   name=coam_admin
    &{bts_info}         coam.Get Bts Statuses    connection=coam_admin
    Should Be Equal     ${bts_info['proceduralState']}    onAir    ignore_case=true


logout OAM
    [Arguments]         ${alias}=${GNB_DU.oam}
    ${status}           ${message}      run keyword and ignore error    OAM Disconnect      ${alias}
    run Keyword if      '${status}' == 'FAIL'   Log to console    Keyword logout OAM ${alias} failed


Get VDU Cell Number
    [Arguments]         ${vdu_index}=0    ${gnb_index}=0
    # NRCELL_DN_LIST_DU is a global variable provided by AF
    ${status}           ${message}=     Run Keyword And Ignore Error    Variable Should Exist    ${NRCELL_DN_LIST_DU}
    @{defaultList}=     Create List     MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    Run Keyword If      "${status}"=="FAIL"     Set Global Variable     ${NRCELL_DN_LIST_DU}   ${defaultList}
    ${cell_number}      Set Variable            ${NRCELL_DN_LIST_DU.__len__()}
    [Return]            ${cell_number}


vDU Check All Cells Status Should Be Onair
    [Arguments]         ${vdu_index}=0    ${gnb_index}=0
    [Documentation]     vDU Verify Cells Status Should Be Onair With Expected Cell Number
    ...    | Input Parameters | Man. | Description |
    ...    | vdu_index | No. | specify which vdu needs to be check if the testline configed multi vdus |
    ...    | gnb_index | No. | specify which vdu needs to be check if the testline configed multi vdus |
    ...
    ...    | Return Value | Description |
    ...    | None | NA |
    ...
    ...    Example
    ...    | vDU Verify Cells Status Should Be Onair With Expected Cell Number |
    ...
    ${cell_number}      Get VDU Cell Number     gnb_index=${gnb_index}
    ${aliasGNB}         OAM Connect             ${GNB_DU.oam}
    ${vdu_cells_summary}=    vdu.get_vdu_cells_summary    vdu_connection=${aliasGNB}
    Dated log           vdu_cells_summary=${vdu_cells_summary}
    ${msg}=             set variable   Check All Cells Status Should Be Onair Failed
    ${msg_err}=         Catenate    ${msg} => vDU_disabled_cell_amount=${vdu_cells_summary['basic_cells_summary']['operational_state']['disabled']}
    Should Be Equal As Numbers      ${vdu_cells_summary['basic_cells_summary']['operational_state']['disabled']}  0  msg=${msg_err}  values=False
    ${msg_err}=         Catenate    ${msg} => vDU_locked_cell_amount=${vdu_cells_summary['basic_cells_summary']['administrative_state']['locked']}
    Should Be Equal As Numbers      ${vdu_cells_summary['basic_cells_summary']['administrative_state']['locked']}  0  msg=${msg_err}  values=False
    ${msg_err}=         Catenate    SEPARATOR=   ${msg} => vDU_shutting_down_cell_amount=
    ...                             ${vdu_cells_summary['basic_cells_summary']['administrative_state']['shutting_down']}
    Should Be Equal As Numbers  ${vdu_cells_summary['basic_cells_summary']['administrative_state']['shutting_down']}  0  msg=${msg_err}  values=False
    ${msg_err}=         Catenate    ${msg} => vDU_on_line_cell_amount=${vdu_cells_summary['availability_status']['on_line']}
    ${on_line}          set variable    ${vdu_cells_summary['availability_status']['on_line']}
    should be true      ${on_line}==${cell_number}   ${msg_err}
    [Teardown]          logout OAM      alias=${GNB_DU.oam}


Check ASP L2PS
    [Arguments]             ${Pattern}
    KWTest_FRT_Cloud_l1ByPass.Connect to DU
    KWTest_FRT_Cloud_l1ByPass.Connect to gNB ABIL MASTER
    ${output}               csn.execute     ls -lrt /tmp | grep ASP-123A_startup.zip    connection=gNB_ABIL_MASTER
    ${len}                  Get Length      ${output}
    Run Keyword If          ${len} != 0     csn.execute
    ...                                     unzip -o -d /tmp /tmp/ASP-123A_startup.zip  connection=gNB_ABIL_MASTER
    ${output}               common_frt.Ssh Execute With Timeout
    ...                         grep "${Pattern}" /tmp/ASP-123A_startup.log    connection=gNB_ABIL_MASTER
    Should Not Be Empty     ${output}


Check ASP L2PS for 1329
    ${LogL2RT}              Container.Get Log                       name=L2RT
    #RDH - Aug-2022 : Code put in comment until issue is fixed
    #    ${alias}                SSH Connect                             ${LogL2RT.node.host}
    #    ${ZipLog}               Set variable                            ${LogL2RT.path.replace('.log','.zip')}
    #RDH - Aug-2022 : Workaround to be removed as soon as issue is fixed
    ${alias}                SSH Connect                             ${GNB_DU.bb[0].M}
    Dated log               Hardcoded alias is : ${alias}
    ${ZipLog}               Set variable                            /tmp/node_L2RT20/tmp/ASP-2730_startup.zip
    ${StdLog}               Set variable                            /tmp/node_L2RT20/tmp/ASP-2730_startup.log
    Dated log               Hardcoded Stdlog is : ${StdLog}
    Dated log               Hardcoded Ziplog is : ${ZipLog}
    #RDH - Aug-2022 : End of Workaround

    Dated log               Check ASP:ZIPLOG=${ZipLog}
    ${output}               SSH Cmd
    ...                     ls -lrt ${ZipLog}                       alias=${alias}
    ${len}                  Get Length                              ${output}
    Run Keyword If          ${len} != 0
    ...                     SSH Cmd
    ...                     unzip -o -d $(dirname ${ZipLog}) ${ZipLog}      alias=${alias}
    #YW - FB2217 : traces in 22R4 branch 
    ${output_1}             SSH Cmd
    #...                     grep "transmittedPowerMaxBeam:[1-2]00" ${StdLog}
	...                     grep "transmittedPowerMaxBeam:" ${StdLog}
    ...                     alias=${alias}
    ${len_1}                Get Length                              ${output_1}
    Dated Log       output_1 : ${output_1}
    #YW - FB2217 : traces in trunk
    ${output_2}             SSH Cmd
    #...                     grep "maxTxPowerPerCCmW:[1-2]00" ${StdLog}
	...                     grep "maxTxPowerPerCCmW:" ${StdLog}
    ...                     alias=${alias}
    ${len_2}                Get Length                              ${output_2}
    Dated Log       output_2 : ${output_2}
    Should Be True          (${len_1} != 0) or (${len_2} != 0)       
    # Should Not Be Empty     ${output}


