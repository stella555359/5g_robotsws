    ...    value=6
    ...    dist_name=${dist_name}
    ...    p_name=ssPbchBlockPower
    ...    nodeType=Vdu
    ...    ListParamterToModify=${ListParamterToModify}
    ${ListCellParamterToModify}=        add Param to Modify Param list
    ...    value=30
    ...    dist_name=${dist_name}
    ...    p_name=antennaMechanicalDowntilt
    ...    nodeType=Vdu
    ...    ListParamterToModify=${ListParamterToModify}
    ${ListCellParamterToModify}=        add Param to Modify Param list
    ...    value=100
    ...    dist_name=${dist_name}
    ...    p_name=targetTotalLoad
    ...    nodeType=Vdu
    ...    ListParamterToModify=${ListParamterToModify}
    ${dist_name}        Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/${NRCELL_GRP}
    ${ListCellParamterToModify}=        add Param to Modify Param list
    ...    value=20
    ...    dist_name=${dist_name}
    ...    p_name=ssBurstSetPeriod
    ...    nodeType=Vdu
    ...    ListParamterToModify=${ListParamterToModify}
    ${dist_name}        Set Variable    MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/PMCADM-1
    ${ListCellParamterToModify}=        add Param to Modify Param list
    ...    value=5min
    ...    dist_name=${dist_name}
    ...    p_name=reportingIntervalPm
    ...    nodeType=VcuVdu
    ...    ListParamterToModify=${ListParamterToModify}
    ${dist_name}        Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRPMRNL-1
    ${ListCellParamterToModify}=        add Param to Modify Param list
    ...    value=5min
    ...    dist_name=${dist_name}
    ...    p_name=miNrCellAvailability
    ...    nodeType=VcuVdu
