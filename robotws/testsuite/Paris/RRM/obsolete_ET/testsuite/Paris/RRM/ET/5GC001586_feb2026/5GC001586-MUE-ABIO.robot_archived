    [Documentation]   This keyword is used to Check BTS status in WEM for cOAM.
    ...    author: Ch SAMSON
    [Arguments]     ${cell_id}=0
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=    coam.get_bts_statuses    timeout=30    connection=${GNB_DU.oam.httpAlias}
    Dated log      =======> Current bts status is ${bts_status}
    should be equal         ${bts_status['operationalState']}     Enabled         ignore_case=true
    Should Contain Any      ${bts_status['proceduralState']}      OnAir     msg=ENB is not on air, Current status is ${bts_status['proceduralState']}
    ...                                                                     ignore_case=true
    should be equal         ${bts_status['blockingState']}        Unblocked       ignore_case=true

    ${cell_full_info}=    coam.get_cells_info    cell_type=nr    timeout=30    connection=${GNB_DU.oam.httpAlias}
    ${cell_info}=    set variable   ${cell_full_info[${cell_id}]['status']}
    Dated log      =======> Current cell(s) info is ${cell_info}
    Should be equal    ${cell_info['operationalState']}     Enabled      ignore_case=true
    Should be equal    ${cell_info['proceduralStatus']}     configured   ignore_case=true
    Should be equal    ${cell_info['administrativeState']}  Unlocked     ignore_case=true

    OAM Disconnect                  ${GNB_DU.oam}
    ${msg}=   Catenate    Cell${cell_id} operationalState=${cell_info['operationalState']}, proceduralStatus=${cell_info['proceduralStatus']}
    ...                   administrativeState=${cell_info['administrativeState']}
    Dated log    ${msg}

Verify cell setup with COAM to remove
    [Documentation]     : [PRIVATE]
    ...     Verify Specific Cell status and BTS Cell setup status
    ...
    ...     cell_id:   Id of cell,
    ...     timeout:   Time to wait for positive procedure result
    ...
    [Arguments]     ${oam_alias}    ${cell_id}=0   ${timeout}=30
    ${cell_status}=    coam.get_cells_info    cell_type=nr     timeout=${timeout}    connection=${oam_alias}
    ${P_internal_cell_dist_id}=  Set Variable   ${cell_status[${cell_id}]['id']['internal']}
    ${cell_status}=    Set variable  ${cell_status[${cell_id}]['status']}
    Should be equal    ${cell_status['operationalState']}         Enabled         ignore_case=true
    Should be equal    ${cell_status['proceduralStatus']}         configured      ignore_case=true
    Should be equal    ${cell_status['blockingState']}            Unblocked       ignore_case=true
    Should Contain Any    ${cell_status['usageState']}            Active          ignore_case=true
    Should be equal    ${cell_status['administrativeState']}      Unlocked        ignore_case=true
    ${bts_status}=     coam.get_bts_statuses    timeout=${timeout}    connection=${oam_alias}
    Should be equal    ${bts_status['operationalState']}          Enabled         ignore_case=true
    Should be equal    ${bts_status['proceduralState']}           OnAir     msg=GNB is not on air, Current status is ${bts_status['proceduralState']}
    ...                                                                     ignore_case=true
    Should be equal    ${bts_status['blockingState']}             Unblocked       ignore_case=true

    ${msg}=   Catenate    Cell ${cell_id} [${P_internal_cell_dist_id}], operationalState=${cell_status['operationalState']},
    ...                   proceduralStatus=${cell_status['proceduralStatus']},
    ...                   administrativeState=${cell_status['administrativeState']},
    ...                   blockingState=${cell_status['blockingState']},
    ...                   usageState=${cell_status['usageState']}
    Dated log    ${msg}
    Dated log    BTS procedural state is now: ${bts_status['proceduralState']}
    [Return]  ${P_internal_cell_dist_id}

Verify that cells are onair with COAM to remove
    [Documentation]     [PRIVATE]
    [Arguments]      ${oam_alias}   ${num_of_cells}=1
    FOR    ${cell_id}    IN RANGE    ${num_of_cells}
        ${_internal_cell_dist_id}=  Verify cell setup with COAM   oam_alias=${oam_alias}   cell_id=${cell_id}
        Append to list  ${P_INTERNAL_CELL_DIST_ID}     ${_internal_cell_dist_id}
    END

Wait gNB cell 5g On air to remove
