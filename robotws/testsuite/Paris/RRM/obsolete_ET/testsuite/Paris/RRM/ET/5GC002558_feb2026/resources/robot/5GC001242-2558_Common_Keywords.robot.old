    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${local_path_log}/Conf_files/gnb_swconfig_tested.txt
    ...                             connection=${alias_gnb}
    Dated Log    ------> Getting tested AP swconfig
    ${alias_ap}                     SSH Wait For Connect                ${AP_DU.sys[0].M}
    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${local_path_log}/Conf_files/ap_swconfig_tested.txt
