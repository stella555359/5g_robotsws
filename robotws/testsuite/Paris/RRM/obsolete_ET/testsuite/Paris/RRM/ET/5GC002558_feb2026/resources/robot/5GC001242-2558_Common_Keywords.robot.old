*** Variables ***

@{listFieldCsi}                startSymbol    startPrb    numOfPrb
@{listFieldPdsch}              startPrb    numOfPrb
@{listFieldPucch}              startPrb    numOfPrb
@{listFieldSrsRcvReq}          srsBandwidthConfig    freqDomainPosition    freqDomainShift
@{listFieldSrsRcvResp}         ulRank    ulPmiRank1Sinr    ulPmiRank2     ulPmiRank2Sinr_item.*    snr

#Script for collecting journal logs
${script_path}           ../script
${script_journal_gnb}    get_journal_gNB.sh
${script_journal_ap}     get_journal_AP.sh

#Filter for pcap
@{filter_L1L2_attach_gnb}     UlData_PrachReceiveReq    UlData_PrachReceiveInd     DlData_PdcchSendReq     DlData_PdschSendReq
...                           UlData_PuschReceiveReq    UlData_PucchReceiveReq    UlData_PuschReceiveRespLo    UlData_PuschReceiveRespPs
...                           DlData_CsiRsSendReq    UlData_PucchReceiveRespHarqD    UlData_PuschReceiveRespHarqU   DlData_PdschPayloadTbSendReq
@{filter_L1L2_traffic_gnb}    DlData_PdcchSendReq     DlData_PdschSendReq    UlData_PuschReceiveReq    UlData_PuschReceiveRespPs
...                           UlData_PucchReceiveRespHarqD
${filter_L2L1_AP}             not arp and not sctp and ether[16:2]!=0x0806 and ether[24:2]!=0xf33d and ether[24:2]!=0xf1ff
...                           and ether[24:2]!=0x9403 and ether[24:2]!=0xff02 and ether[24:2]!=0x0122 and ether[24:2]!=0xe101
...                           and ether[24:2]!=0x9400 and ether[24:2]!=0xe103 and ether[24:2]!=0x0133 and ether[24:2]!=0x0108
...                           and ether[24:2]!=0xe105 and ether[24:2]!=0x8014 and ether[24:2]!=0xf321 and ether[24:2]!=0xf322
@{filter_protocol}            ARP    UDP   ICMP   TCP

*** Keywords ***

#************************** Keywords for saving configuration *********************

Get Current Config file
    Dated Log    ----------------- Getting current configuration files --------------------
    # Get basic.cfg file configuration:
    Dated Log    -----> Getting current basic.cfg config
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.download_file               remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${LOG_PATH}/basic_wts_to_be_restored.cfg
    ...                             connection=${alias_epc}
    # Get APConfig.xml configuration file
    Dated Log    -----> Getting current APConfig.xml config
    ${ap_configfile}                Get XML AirPhoneConfig Path
    run Keyword if      '${ap_configfile}' != '${empty}'    csn.download_file     remote_path=${tl.core.dir_path}${ap_configfile}
    ...                             local_path=${LOG_PATH}/ApOamConfig_to_be_restored.xml
    ...                             connection=${alias_epc}
    # Get swconfig file that will be restored during test suite teardown
    Dated Log    -----> Getting current gNB swconfig.txt config
    ${alias_gnb}                    SSH Wait For Connect                ${GNB_DU.sys[0].M}
    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${LOG_PATH}/gnb_swconfig_to_be_restored.txt
    ...                             connection=${alias_gnb}
    Dated Log New Line         Default SCF file stored to ${SCF_SETUP_PATH}\n
    Dated Log                  Default swconfig file stored to ${LOG_PATH}/gnb_swconfig_to_be_restored.txt\n
    Dated Log                  Default basic cfg file stored to ${LOG_PATH}/basic_wts_to_be_restored.cfg\n
    Dated Log                  Default AP Oam Config file stored to ${LOG_PATH}/ApOamConfig_to_be_restored.xml\n

Save Current Configuration
    Dated log     \n------------------- Configuration Saving ---------------------------
    ${original_scf_file}           Get Current SCF File            ${LOG_PATH}
    Dated log     Current configuration is saved under ${original_scf_file}.\n
    Set Suite Variable             ${original_scf_file}
    Dated log     \n------------------- Configuration Saving Completed ---------------------------

Restore Configuration
    Dated log     -------------------- Configuration Restoring ---------------------------
    OAM Perform Full Commissioning     ${original_scf_file}
    Dated log     -------------------- Configuration Restoring completed------------------

Restore Original Configuration
    # Get swconfig file that will be restored during test suite teardown
    ${alias_gnb}                    SSH Wait For Connect                ${GNB_DU.sys[0].M}
    csn.upload_file                 remote_path=${SWCONFIG_PATH}
    ...                             local_path=${LOG_PATH}/gnb_swconfig_to_be_restored.txt
    ...                             connection=${alias_gnb}
    SSH Exec                        command=crasign ${SWCONFIG_PATH}           alias=${alias_gnb}
    Dated Log                 swconfig file has been restored to default (${LOG_PATH}/swconfig_to_be_restored.txt)
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.upload_file                 remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${LOG_PATH}/basic_wts_to_be_restored.cfg
    ...                             connection=${alias_epc}
    Dated Log                basic cfg file has been restored to default (${LOG_PATH}/basic_wts_to_be_restored.cfg)
    ${ap_configfile}                Get XML AirPhoneConfig Path
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    run Keyword if      '${ap_configfile}' != '${empty}'    csn.upload_file     remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${LOG_PATH}/ApOamConfig_to_be_restored.xml
    ...                             connection=${alias_epc}
    Dated Log            ApOamConfig has been restored to default (${LOG_PATH}/ApOamConfig_to_be_restored.xml)
    OAM Perform Full Commissioning     ${SCF_SETUP_PATH}

#************************** Keywords for SCF manipulations*****************************

Modify NRBTSID In SCF
    [Arguments]    ${scf_path}    ${gnbID}=NRBTS-1
    Dated Log    [Changing NRBTSID In SCF]
    run    command=sed -i 's|NRBTS-${NRBTS_ID}|${gnbID}|g' ${scf_path}
    #run    command=sed -i 's|NRBTS-1|${gnbID}|g' ${scf_path}
    Dated Log    ----> Modifications completed.\n

#************************** Keywords for setting parameters in config*****************************

Set Initial Bwp Profile Location
    [Documentation]   To set the cRbStart and size of the location of the Initial BandwidthDl and BandwidthUl.
    [Arguments]     ${crb_size_dl}=coreset0    ${crb_start_dl}=coreset0
    Dated Log     -----> [Dynamic PDCCH: setting initial BWP profil location]
    ${total_prb_bw}   Set Variable If      '${param.chBwDl}' == '5MHz'     25
    ...                                    '${param.chBwDl}' == '10MHz'    52
    ...                                    '${param.chBwDl}' == '15MHz'    79
    ...                                    '${param.chBwDl}' == '20MHz'    106
    Dated Log    -----> Bandwidth is ${param.chBwDl} and the number of PRB available is ${total_prb_bw}.\n
    ${crb_size_ul}     Evaluate    ${total_prb_bw}-${param.nbrOfBlankedPRBsLowEdgeUL}-${param.nbrOfBlankedPRBsHighEdgeUL}-1
    ${crb_start_ul}    Evaluate    ${param.nbrOfBlankedPRBsLowEdgeUL}+1
    #For locationAndBandwidthDl
    &{param_dl}    Create Dictionary    cRbSizeDl=${crb_size_dl}  cRbStartDl=${crb_start_dl}
    &{framestructure_dl}    Evaluate    {'dist_name': '${bwp_initial_dist_name}','parameter': 'locationAndBandwidthDl','value':[&{param_dl}]}
    #For locationAndBandwidthUl
    &{param_ul}    Create Dictionary    cRbSizeUl=n${crb_size_ul}  cRbStartUl=crb${crb_start_ul}
    &{framestructure_ul}    Evaluate    {'dist_name': '${bwp_initial_dist_name}','parameter': 'locationAndBandwidthUl','value':[&{param_ul}]}
    @{modify_param_list}     Create List     ${framestructure_dl}    ${framestructure_ul}
    [Return]   ${modify_param_list}

#****************************** Generic Keywords for pcap ***************************************

Generate Pdml From Pcap
    [Arguments]     ${pcap_file}
    Dated Log     PCAP to PDML ongoing....
    ${pdml_file}=                    analyzer.pcap_to_pdml           ${pcap_file}
    Dated Log     PDML generated.
    [Return]    ${pdml_file}

Filter Pcap
    [Arguments]     ${pcap_file}
    ...             ${messages}
    ...             ${name}=filtered
    Dated Log    PCAP filtering ongoing...
    ${pcapFile_filtered}=      analyzer.filter_pcap
    ...                        pcapInFile=${pcapFile}
    ...			       filterName=${name}
    ...			       filterExp=${messages}
    Dated Log    PCAP filtering completed.
    [Return]    ${pcapFile_filtered}


#****************************** Keywords for testing steps ***************************************
Check Attach Is Ok In APL3
    ${output}           SSH Wait For Connect and Cmd
	...                 command=grep 'Sm User Ue Connection' /tmp/startup_l3.log
	...                 host=${AP_DU.sys[0].M}
    Should Contain	    ${output}	 Sm User Ue Connection Established Ind message status OK

Establish X2 Link
    CallSetup.WTS Setup              shouldUseLua=${False}    nbCell=1

SgNB Addition And 5G Attach
    CallSetup.SgNB Addition to ENB          ueSetting=${UE_SIMPLE}

Check AP Cell Setup Is Completed
    [Documentation]              Check in AP that cell setup is OK
    Check AP Cell Setup          host=${AP_DU.sys[0].M}            file=/tmp/startup_l3.log
    ...                          pattern=Cell Setup completed

#****************************** Keywords for capture traces***************************************

Check AP Cell Setup
    [Documentation]                 Check in AP that cell setup is OK.
    [Arguments]                     ${host}                                 ${file}
    ...                             ${pattern}
    Dated log                       Check on ${host.alias}:file ${file} contain pattern [${pattern}]
    ${alias}                        SSH Connect                             ${host}
    ${output}                       SSH Cmd
    ...                                 grep ${pattern} ${file}
    ...                                 alias=${alias}
    should contain                  ${output}                               ${pattern}

Start Mirroring And Traces gNB
    # ${capture_gnb_x2}      Capture CORE Set Upon Config
    ${capture_gnb_l1l2}    Capture L1L2 Set Upon Config
    # ${capture_gnb_l3l2}    Capture CPRT Set Upon Config

    # ADT - add filter for capture_gnb_x2
    # ${filter F1AP}                  Get Filter For F1AP                     ${capture_gnb_x2}
    # ${filter X2AP}                  Get Filter For X2AP                     ${capture_gnb_x2}
    # ${capture_gnb_x2.filter}        set variable                            ${filter F1AP} or ${filter X2AP}

    # ${capture_gnb_l3l2.filter}       Get Filter To Exclude protocols    capture=${capture_gnb_l3l2}    protocolList=${filter_protocol}

    # ${capture_gnb_l3l2.filter}       Get Filter To Exclude protocols    capture=${capture_gnb_l3l2}    protocolList=${filter_protocol}
    ${capture_gnb_l1l2.filter}       Get Filter To Exclude protocols    capture=${capture_gnb_l1l2}    protocolList=${filter_protocol}

    # Capture Init         ${capture_gnb_x2}        suffix=_X2_backhaul
    Capture Init         ${capture_gnb_l1l2}      suffix=_filter_protocol
    # Capture Init         ${capture_gnb_l3l2}      suffix=_L3L2_filter_protocol

    # Set Suite Variable    ${capture_gnb_x2}
    Set Suite Variable    ${capture_gnb_l1l2}
    # Set Suite Variable    ${capture_gnb_l3l2}
    # Dated Log    -----> Starting capture X2 in gNB.\n
    # Capture Start         ${capture_gnb_x2}
    Dated Log    -----> Starting capture L2L1 in gNB.\n
    Capture Start         ${capture_gnb_l1l2}
    # Dated Log    -----> Starting capture L3L2 in gNB.\n
    # Capture Start         ${capture_gnb_l3l2}

Stop Mirroring And Traces gNB
    Dated Log    [Stopping Mirroring And Traces gNB]
    Capture Stop    ${capture_gnb_l1l2}
    Dated Log    -----> Traces L2L1 saved under ${capture_gnb_l1l2.path}\n
    # Capture Stop    ${capture_gnb_x2}
    # Dated Log    -----> Traces X2 saved under ${capture_gnb_x2.path}\n
    # Capture Stop    ${capture_gnb_l3l2}
    # Dated Log    -----> Traces L2L3 saved under ${capture_gnb_l3l2.path}\n

Start Mirroring And Traces AP
    Dated Log    [Starting Mirroring And Traces Airphone]
    ${capture_ap_l1l2}    Capture L1L2 Set Upon Config    ${AP_DU}
    ${capture_ap_l1l2.filter}      Get Filter To Exclude protocols   capture=${capture_ap_l1l2}
    ...                                                              protocolList=${filter_protocol}
    Capture Init         ${capture_ap_l1l2}     suffix=_filter_protocol
    Set Suite Variable    ${capture_ap_l1l2}
    Dated Log    -----> Starting capture L2L1 in Airphone.\n
    Capture Start         ${capture_ap_l1l2}

Stop Mirroring And Traces AP
    Dated Log    [Stopping Mirroring And Traces Airphone]
    Capture Stop    ${capture_ap_l1l2}
    Dated Log    -----> Airpone L2L1 traces saved under ${capture_ap_l1l2.path}\n

Get WTS logs
    [Documentation]     Collect the WTS logs: uec, end, amf etc..
    [Arguments]      ${local_path_logs}=${LOCAL_LOG_PATH_WTS}
    Dated Log     [Collecting WTS logs]
    Dated Log     ----> Connecting to WTS...
    ${alias}      SSH Connect        host=${HOST_EPCSIM}
    # Connect to LTEEMU    alias=lteemu_alias
    Dated Log     ----> Downloading WTS logs..
    csn.download_file               remote_path=${tl.core.dir_path}/uec_1.log
    ...                             local_path=${local_path_logs}/uec_1.log
    ...                             connection=${alias}
    Sleep   1s
    csn.download_file               remote_path=${tl.core.dir_path}/egate_console.log
    ...                             local_path=${local_path_logs}/egate_console.log
    ...                             connection=${alias}
    Dated Log     LOGS: WTS logs saved under ${local_path_logs}.\n

#****************************** Keywords for log collection ***************************************

Creation Directory For Logs
    [Documentation]       Create the directory needed to save the logs.
    Dated Log New Line    [Creating directory for all logs]
    #Creating directory for logs
    ${timestamp}=    DateTime.Get Current Date    result_format=%Y-%m-%d-%H%M
    run    command=mkdir ${LOG_PATH}/LOGS_${timestamp}
    Set Suite Variable     ${LOCAL_LOG_PATH_gNB_AP}      ${LOG_PATH}/LOGS_${timestamp}
    #Directory for conf files
    Dated Log    -----> Creating directory for configuration files.
    run    command=mkdir ${LOCAL_LOG_PATH_gNB_AP}/Conf_files
    #Directory for WTS logs
    Dated Log    -----> Creating directory for wts logs.
    run    command=mkdir ${LOCAL_LOG_PATH_gNB_AP}/Logs_WTS
    Set Suite Variable     ${LOCAL_LOG_PATH_WTS}         ${LOCAL_LOG_PATH_gNB_AP}/Logs_WTS
    Dated Log    Directory creation completed: Logs will be saved under ${LOCAL_LOG_PATH_gNB_AP}\n

Save Tested Configuration
    [Arguments]    ${local_path_log}=${LOCAL_LOG_PATH_gNB_AP}
    Dated Log    [Getting tested SCF config]
    ${scf_tested}    OAM Get SCF File
    ...              file=${local_path_log}/Conf_files/Configuration_SCF_${param.cellDepType}_${param.chBwDl}.xml
    # Get basic.cfg file configuration:
