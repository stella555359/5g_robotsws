    ...                             path=${field_to_check}
    ...                             value=${value_to_check}
    ...                             startPacket=${1}
    ...                             endPacket=${1}
    Dated Log    -----> Analysis in dldata_pdcchsendreq msg2 for ${field_to_check} completed.

#FROM 2558
Check In L2L1 Pdcch Attach Configuration NSA SA
    Dated Log    [Checking In L2L1 Pdcch Attach Configuration]
    ${pcap_filtered}    Filter Pcap     pcap_file=${capture_gnb_l1l2.path}     messages=dldata_pdcchsendreq   name=pdcch_only
    ${pdml_pdcch}=     Generate Pdml From Pcap    pcap_file=${pcap_filtered}
    Run Keyword If    '${param.cellDepType}' == 'SA'     Check In Pdcch CoresetFreqDomain SA     pdcch_pdml=${pdml_pdcch}
    ...               coreset_0_value=${l1l2_coreset0}
    Run Keyword If    '${param.cellDepType}' == 'NSA' and '${IsOverlapping}' == 'True'
    ...               Check In Pdcch CoresetFreqDomain NSA    pdcch_pdml=${pdml_pdcch}
    ...               coreset_init_value=${l1l2_coreset_overlap}    coreset_dedi_value=${l1l2_coreset_overlap}
    Run Keyword If    '${param.cellDepType}' == 'NSA' and '${IsOverlapping}' == 'False'
    ...               Check In Pdcch CoresetFreqDomain NSA    pdcch_pdml=${pdml_pdcch}
    ...               coreset_init_value=${l1l2_coreset0}    coreset_dedi_value=${l1l2_coreset0}

Check In L2L1 Pdsch Attach Configuration NSA
    Dated Log    [Checking In L2L1 Pdsch Attach Configuration]
    ${pcap_filtered}    Filter Pcap     pcap_file=${capture_gnb_l1l2.path}    messages=dldata_pdschsendreq   name=pdsch_only
    ${pdml_pdsch}    Generate Pdml From Pcap    pcap_file=${pcap_filtered}
    Check Msg2 Pdsch Rat1 Allocation Attach       pdsch_pdml=${pdml_pdsch}

Check In L2L1 Pusch Attach Configuration NSA SA
    Dated Log    [Checking In L2L1 Pusch configuration]
    ${pcap_filtered}    Filter Pcap     pcap_file=${capture_gnb_l1l2.path}     messages=uldata_puschreceivereq   name=pusch_only
    ${pdml_pusch}    Generate Pdml From Pcap    pcap_file=${pcap_filtered}
    Check Msg3 Rat1 Allocation Attach       pusch_pdml=${pdml_pusch}

Check In L2L1 Pucch Attach Configuration NSA SA
    Dated Log    [Checking In L2L1 Pucch Attach Configuration]
    ${pcap_filtered}    Filter Pcap     pcap_file=${capture_gnb_l1l2.path}     messages=uldata_pucchreceivereq   name=pucch_only
    ${pdml_pucch}=    Generate Pdml From Pcap    pcap_file=${pcap_filtered}
    Check Pucch Allocation Attach   pucch_pdml=${pdml_pucch}

Check In Pdcch CoresetFreqDomain NSA
    [Documentation]     The bitmap of CoresetFreqDomain shall be configured outside the blanked area.
    [Arguments]    ${pdcch_pdml}     ${coreset_init_value}=0x0000000000000000    ${coreset_dedi_value}=0x0000000000000000
    Dated Log    [Checking the configuration of initial and dedicated CoresetFreqDomain in pdcch...
    FOR    ${item}   IN RANGE    1    ${nbr_prach}
         #Coreset (Initial BWP)
         Dated Log     Pdcch Packet${item}:Initial coresetFreqDomain shall be equal to ${coreset_init_value}
         analyzer.check_list             pdmlFile=${pdcch_pdml}
         ...                            packetName=dldata_pdcchsendreq
         ...                            kind=show
         ...                            path=coresetFreqDomain$
         ...                            value=${coreset_init_value}
         ...                            startPacket=${${item}}
         ...                            endPacket=${${item}}
         Run Keyword If    '${IsOverlapping}' == 'False'     analyzer.check_list    pdmlFile=${pdcch_pdml}
         ...                                                packetName=dldata_pdcchsendreq
         ...                                                kind=value
         ...                                                test=>=
         ...                                                path=coresetFreqDomainRbShift$
         ...                                                value=${l1l2_coreset0_rb_shift}
         ...                                                startPacket=${${item}}
         ...                                                endPacket=${${item}}
         #Coreset (Dedicated BWP)
         ${item_dedi}     Evaluate     ${item}+1
         Dated Log     Pdcch Packet${item_dedi}:Dedicated coresetFreqDomain shall be equal to ${coreset_dedi_value}
         analyzer.check_list             pdmlFile=${pdcch_pdml}
         ...                            packetName=dldata_pdcchsendreq
         ...                            kind=show
         ...                            path=coresetFreqDomain$
         ...                            value=${coreset_dedi_value}
         ...                            startPacket=${${item_dedi}}
         ...                            endPacket=${${item_dedi}}
         Run Keyword If    '${IsOverlapping}' == 'False'     analyzer.check_list    pdmlFile=${pdcch_pdml}
         ...                                                packetName=dldata_pdcchsendreq
         ...                                                kind=value
         ...                                                test=>=
         ...                                                path=coresetFreqDomainRbShift$
         ...                                                value=${l1l2_coreset0_rb_shift}
         ...                                                startPacket=${${item_dedi}}
         ...                                                endPacket=${${item_dedi}}
    END
    Dated Log    -----> Check completed.\n

Check In L2L1 Reference Signal Attach Configuration NSA SA
    [Documentation]    Check the configuration of Reference Signal: CSI for measurment, and TRS for tracking.
    ...                If trs muting is enabled, TRS PRB allocation shall not ocupied the whole BW.
    Dated Log    [Checking In L2L1 Reference Signal Attach Configuration]
    ${pcap_filtered}    Filter Pcap     pcap_file=${capture_gnb_l1l2.path}    messages=dldata_csirssendreq   name=csirs_only
    ${pdml_csirs}     Generate Pdml From Pcap    pcap_file=${pcap_filtered}
    Check In L2L1 CSI RS Measurment Allocation    pdml_file=${pdml_csirs}
    ...                                           start=${param.nbrOfBlankedPRBsLowEdgeDL}
    ...                                           end=${csi_rs_size}
    Check In L2L1 CSI RS Tracking Allocation     pdml_file=${pdml_csirs}

Check In L2L1 Traffic DL NSA SA
    Dated Log    [Checking Traffic DL]
    ${pcap_filtered}    Filter Pcap     pcap_file=${capture_gnb_l1l2.path}    messages=dldata_pdschsendreq   name=pdsch_only
    ${pdml_pdsch}       Generate Pdml From Pcap    pcap_file=${pcap_filtered}
    Check In L2L1 Rat0 Allocation Pdsch Traffic DL     ${pdml_pdsch}

Check In L2L1 Rat0 Allocation Pdsch Traffic DL
    [Documentation]    This tests check the PRB allocation of all pdsch messages. (~1h)
    [Arguments]    ${pdsch_pdml}
    Dated Log    [Checking In L2L1 Pdsch Attach Configuration]
    Dated Log    -----> Starting check Rat0 PDSCH allocation (test duration is around 1 hour)...
    Dated Log    -----> Rat0 allocation of PDSCH shall be outside blanked PRB: startPrB >= ${rat0_start} and crb_end <= ${rat0_end}
    Dated Log    -----> 10 packets to checks. Please wait...(~15min)
    FOR    ${packet}   IN RANGE   1000   1011
        Verify Allocation In L2L1    pdml_file=${pdsch_pdml}
        ...                          packet_name=dldata_pdschsendreq
        ...                          xpath_start=.*/DlData_PdschSendReq.grants_item_.*.startPrb$
        ...                          xpath_size=.*/DlData_PdschSendReq.grants_item_.*.numOfPrb$
        ...                          limit_start=${rat0_start}
        ...                          test_size=<=
        ...                          limit_size=${rat0_end}
        ...                          packet_start=${packet}
        ...                          packet_end=${packet}

    END

Check In L2L1 Traffic UL NSA SA
    Dated Log    [Checking Traffic UL]
    ${pcap_filtered}    Filter Pcap     pcap_file=${capture_gnb_l1l2.path}    messages=uldata_puschreceivereq   name=pusch_only
    ${pdml_pusch}       Generate Pdml From Pcap    pcap_file=${pcap_filtered}
    Check In L2L1 Rat1 Allocation Pusch Traffic UL 2558-C    ${pdml_pusch}

# Keyword updated to fit MCShark pdml
Check Pucch Allocation Attach
    [Arguments]    ${pucch_pdml}
    Dated Log    [Checking Pucch f0 and f2 allocation in L2L1]
    Dated Log    StartPrb shall greater or equal to ${param.nbrOfBlankedPRBsLowEdgeDL}
    Dated Log    crb end location shall be less than ${blanking_area_crb_high}
	${resource_item}                set Variable                           ${0}
	
	FOR    ${packet_num}            IN RANGE    1     16
       Dated Log New Line           Checking packet ${packet_num}/15
       ${packetsMatch}              Get Packet Match List
       ...                              pdmlFile=${pucch_pdml}
       ...                              packetName=nr_l1ul_l2ps_uldata_pucchreceivereqpucchresource_t
       ...                              pathList=${listFieldPucch}
       ...                              startPacket=${${packet_num}}
       ...                              endPacket=${${packet_num}}
	   ${packetMatch}               set variable                           ${packetsMatch[0]}
	
	   @{listPathStart}             Get Paths matching Field
       ...                             packetMatch=${packetMatch}          field=startPrb
       ${path}                      set variable                           ${listPathStart[${resource_item}]}
	   ${startPrb}                  set variable                           ${packetMatch.fields['${path}'].show}
       Dated log                    \t\tItem${resource_item}:startPrb=${startPrb} PATH=${path}

       @{listPathNum}               Get Paths matching Field
       ...                              packetMatch=${packetMatch}         field=numOfPrb
       ${path}                      set variable                           ${listPathNum[${resource_item}]}
	   ${numOfPrb}                  set variable                           ${packetMatch.fields['${path}'].show}	
       Dated log                    \t\tItem${resource_item}:numOfPrb=${numOfPrb} PATH=${path}
	
       Verify Allocation In L2L1    start_rb_hex=${startPrb}
       ...                          nr_of_prb_hex=${numOfPrb}
       ...                          limit_start=${param.nbrOfBlankedPRBsLowEdgeDL}
       ...                          limit_size=${blanking_area_crb_high}
    END	   
    Dated Log    -----> Check of Pucch allocation completed

Check Msg3 Rat1 Allocation Attach
    [Arguments]    ${pusch_pdml}
    Dated Log    [Checking Msg3 pusch RAT1 allocation]
    Dated Log    StartPrb shall greater or equal to ${param.nbrOfBlankedPRBsLowEdgeDL}
    Dated Log    crb end location shall be less than ${blanking_area_crb_high}
    ${range}      Evaluate  ${nbr_prach}+1
    FOR    ${packet}   IN RANGE   1   ${range}
        Verify Allocation In L2L1    pdml_file=${pusch_pdml}
        ...                          packet_name=uldata_puschreceivereq
        ...                          xpath_start=.*/UlData_PuschReceiveReq.grants_item_.*.startPrb$
        ...                          xpath_size=.*/UlData_PuschReceiveReq.grants_item_.*.numOfPrb$
        ...                          limit_start=${param.nbrOfBlankedPRBsLowEdgeDL}
        ...                          limit_size=${blanking_area_crb_high}
        ...                          packet_start=${packet}
        ...                          packet_end=${packet}
    END
    Dated Log    Check of msg3 allocation completed.\n

Check Msg2 Pdsch Rat1 Allocation Attach
    [Arguments]    ${pdsch_pdml}
    Dated Log    [Checking Msg2 pdsch rat1 allocation]
    ${range}      Evaluate  ${nbr_prach}+1
    FOR    ${packet}   IN RANGE   1   ${range}
        Verify Allocation In L2L1    pdml_file=${pdsch_pdml}
        ...                          packet_name=dldata_pdschsendreq
        ...                          xpath_start=.*/DlData_PdschSendReq.grants_item_.*.startPrb$
        ...                          xpath_size=.*/DlData_PdschSendReq.grants_item_.*.numOfPrb$
        ...                          limit_start=${param.nbrOfBlankedPRBsLowEdgeDL}
        ...                          limit_size=${blanking_area_crb_high}
        ...                          packet_start=${packet}
        ...                          packet_end=${packet}
    END
    Dated Log    Check of msg2 Pdsch allocation completed.\n

# Keyword updated to fit MCShark pdml
Verify Allocation In L2L1
    [Arguments]  ${start_rb_hex}    ${nr_of_prb_hex}
    ...          ${limit_start}    ${limit_size}    ${packet_start}=1    ${test_size}=<
    ${start_rb_int}=       Convert To Integer       ${start_rb_hex}
    ${nr_of_prb_int}=      Convert To Integer       ${nr_of_prb_hex}
    ${check_crb_end}    Evaluate   ${start_rb_int}+${nr_of_prb_int}-1
    Dated Log    -----> Packet ${packet_start}:[startPrb:${start_rb_int} ; numOfPrb:${nr_of_prb_int} ; crb_end:${check_crb_end}]
    Should Be True     ${start_rb_int} >= ${limit_start}
    Should Be True     ${check_crb_end} ${test_size} ${limit_size}	


Verify Allocation In RRC
    [Arguments]  ${pdml_file_x2}     ${xpath_start}      ${xpath_size}
    ...          ${limit_start}    ${limit_size}    ${packet_start}=1
    ...          ${packet_end}=1   ${test_size}=<
    ${start_rb_int}=    get_unique    pdmlFile=${pdml_file_x2}
    ...                               packetName=SgNBAdditionRequestAcknowledge
    ...                               path=${xpath_start}
    ...                               kind=show
    ...                               startPacket=${${packet_start}}
    ...                               endPacket=${${packet_end}}
    ${nr_of_prb_int}=      get_unique    pdmlFile=${pdml_file_x2}
    ...                                  packetName=SgNBAdditionRequestAcknowledge
    ...                                  path=${xpath_size}
    ...                                  kind=show
    ...                                  startPacket=${${packet_start}}
    ...                                  endPacket=${${packet_end}}
    ${check_crb_end}    Evaluate   ${start_rb_int}+${nr_of_prb_int}-1
    Dated Log    -----> Allocation:[startingPRB:${start_rb_int} ; nrOfPrb:${nr_of_prb_int} ; crb_end:${check_crb_end}]
    Should Be True     ${start_rb_int} >= ${limit_start}
    Should Be True     ${check_crb_end} ${test_size} ${limit_size}

Get Number Prach Attempt In L2L1
    Dated Log    -----> Checking in L2L1 whether there are several attempts of prach from UE
    ${pcap_filtered}      Filter Pcap     ${capture_gnb_l1l2.path}     messages=uldata_prachreceiveind   name=msg1_only
    ${pdml_file_msg1}     Generate Pdml From Pcap    ${pcap_filtered}
    ${l2l1_nbr_prach}     count_path       pdmlFile=${pdml_file_msg1}
    ...                                    packetName=uldata_prachreceiveind
    ...                                    path=.*/UlData_PrachReceiveInd.detectedPrachPreambles_item_.*.prachPreambleIndex$
    ...                                    startPacket=${1}
    ...                                    endPacket=${-1}
    Dated Log    -----> There is/are ${l2l1_nbr_prach} prach attempt(s) from UE\n
    [Return]    ${l2l1_nbr_prach}

Get Paths matching Field
    [Arguments]                     ${packetMatch}                          ${field}
    @{listPath}                     Get Dictionary Keys                     ${packetMatch.fields}
    @{listPathMatching}             Create List
    FOR    ${path}         IN      @{listPath}
        # Run Keyword if              ${path.endswith('${field}')}
        Run Keyword if              ${path.find('${field}')}!=${-1}
        ...                         Append to list              ${listPathMatching}             ${path}
    END
    [Return]                        ${listPathMatching}