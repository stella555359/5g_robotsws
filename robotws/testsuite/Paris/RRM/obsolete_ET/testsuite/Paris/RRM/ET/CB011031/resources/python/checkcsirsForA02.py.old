import csv


def CheckCsirsCsv(csvPathName, expSlot0, expSlot1, expStartSymb, expStartPrb):
    """
    """
    nbcsirs = 0
    nbExpSlot0 = 0
    nbExpSlot1 = 0
    nbOtherSlot = 0
    nbExpStartSymb = 0
    nbOtherStartSymb = 0
    nbExpStartPrb = 0
    nbOtherStartPrb = 0

    print('explSlot0', expSlot0)
    print('explSlot1', expSlot1)
    print('expStartSymb', expStartSymb)
    print('expStartPrb', expStartPrb)

    csirsList = []

    with open(csvPathName) as csvfile:
        reader = csv.DictReader(csvfile, delimiter=';')
        for row in reader:
            csirsList.append(row)

    for csirs in csirsList:
        nbcsirs += 1
        if csirs['3gpp.slot'] == expSlot0 or csirs['3gpp.slot'] == expSlot1:
            if csirs['3gpp.slot'] == expSlot0:
                nbExpSlot0 += 1
            else:
                nbExpSlot1 += 1
            if csirs['DlData_CsiRsResourceL1sw_t.startSymbol'] == expStartSymb:
                nbExpStartSymb += 1
            else:
                nbOtherStartSymb += 1
            if csirs['DlData_CsiRsResourceL1sw_t.startPrb'] == expStartPrb:
                nbExpStartPrb += 1
            else:
                nbOtherStartPrb += 1
        else:
            nbOtherSlot += 1

    results = {"nbcsirs": nbcsirs,
               "nbExpSlot0": nbExpSlot0,
               "nbExpSlot1": nbExpSlot1,
               "nbOtherSlot": nbOtherSlot,
               "nbExpStartSymb": nbExpStartSymb,
               "nbOtherStartSymb": nbOtherStartSymb,
               "nbExpStartPrb": nbExpStartPrb,
               "nbOtherStartPrb": nbOtherStartPrb}

    return results
