*** Test Cases ***

TestLine_preparation
   [Tags]    FULL_RUN    Cellsetup     10MHZ   2574_A6
   ...       CRT
   5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A1}


TestLine_2574_Test_setup_10Mhz
   [Tags]    FULL_RUN    Cellsetup   FULL_CALL  10MHZ   2574_A6
   ...       CRT
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory
   5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A1}


# TC covered under New Feature
# [1]5GC002574-A6_TC20_SA_CallSetup_SANSA_10MHz_DL_ratio_max_95
[1][1.0] PRV-5GC002574-A6_TC20_SA_CallSetup_SANSA_10MHz_DL_ratio_max_95
   [Tags]    FULL_RUN     10MHZ    2574   2574_A6
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%, superfast_allocation disable, SA 5g Call , DL Tput
   ...                 Check numOfPrb / startSymbol / rat0Bitmap in ICOM_5G/DlData_PdschSendReq based on CatMInfo received by CRM
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None                                 AND
   ...                       update Get Mem Usage Variable                                                AND
   ...                       set Suite Variable    ${dl_expect_tput_value}           70                   AND
   ...                       set Suite Variable    ${ul_expect_tput_value}           30                   AND
   #         deviation need to take into account crm ul settings
   ...                       set Suite Variable    ${deviation}                      10                   AND
   ...                       common_Dss_Keywords.Get testcase log directory                               AND
   ...                       common_Dss_Keywords.Prepare Test Name                                        AND
   ...                       Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0                      AND
   ...                       depends   TestLine_2574_Test_setup_10Mhz

   ${tc_name}        Set variable    TestLine_preparation
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...               5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A5}
   ${tc_name}        Set variable    TestLine_2574_Test_setup_10Mhz
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A5}

   # Update nrCellType into Context for CellId=1
   Update nrCellType into "${TestDSS10Mhz_2574_A5}" for cellID "1"

   ${msg}   Catenate   "5GC002574-A6_TC20_SA_CallSetup_SANSA_10MHz_DL_ratio_max_95: sw release used [${convert_version}],
   ...                Cellsetup Dss phase 3, BW= 10MHz,
   ...                DL RATIO = 100%, , SA 5g Call , DL Tput\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                Check numOfPrb / startSymbol / rat0Bitmap in ICOM_5G/DlData_PdschSendReq based on CatMInfo received by CRM"
   common_Dss_Keywords.Log Test description   ${msg}

   # Specific Setting for this test...
   Update assigned_dl_maximum_share_to_nr with "100" into "${TestDSS10Mhz_2574_A5}"
   # desactivate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS10Mhz_2574_A5}"

   # modification DL Ratio into the test param Ctx
   5GC002574_keywords.Update DSS DL pattern with     ${TestDSS10Mhz_2574_A5}     ${PATTERN_DL_100_SA_OK}
   Dated log       DL pattern into TestParam is ${TestDSS10Mhz_2574_A5.seq.dl_allocated_normal_subframes}

   # update CatM data with CatMinfo_10MHz_CatMData_CatMPaging_CatMSib1Br_mPBCH_DLRATIO_100 in Context
   Update CatMinfo with ${CatMinfo_10MHz_CatMData_CatMPaging_CatMSib1Br_mPBCH_DLRATIO_100} into "${TestDSS10Mhz_2574_A5}"

   common_Dss_Keywords.Start Tcpdump on TestPc       interface=eth3    option=-s0 sctp or icmp
   TC 2574 SA CellSetup                              ${TestDSS10Mhz_2574_A5}    egate_5GC002574_A5_TC20
   TC 2574 5g SA Call                                ${TestDSS10Mhz_2574_A5}    egate_5GC002574_A5_TC20
   common_Dss_Keywords.Stop Tcpdump on TestPc        interface=eth3    target_dir=${testCaseDir}
   TC 2574 DL Tput SA Mode                             ${TestDSS10Mhz_2574_A5}
   ...                                                 ul_rate=${ul_expect_tput_value}
   ...                                                 dl_rate=${dl_expect_tput_value}
   ...                                                 forced_expected_dl_ratio=100
   ...                                                 alias=egate_5GC002574_A5_TC20

   5GC002574_keywords.Check CatM Info from L1L2 Pcap    ${TestDSS10Mhz_2574_A5}    ${testCaseDir}/${L1L2_Pcap_File.name}.pcap

   ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
   should contain	                ${output}	                            passed

   [Teardown]     Run Keywords       Update assigned_dl_maximum_share_to_nr with   ${TestDSS10Mhz_2574_A5}   70    AND
   ...                               Get Gnb Snapshot if TestCase Failed                                           AND
   ...                               Teardown 2574     alias=egate_5GC002574_A5_TC20           AND
   ...                               set Suite Variable  ${testCaseDir}  None


# TC covered under New Feature
[1][1.0] PRV-5GC002574-A6_TC23_SA_CallSetup_SANSA_10MHz_DL_ratio_max_95_w_fast_allocation
   [Tags]    FULL_RUN     10MHZ    2574   2574_A6
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%, superfast_allocation enable, SA 5g Call , DL Tput
   ...                 Check numOfPrb / startSymbol / rat0Bitmap in ICOM_5G/DlData_PdschSendReq based on CatMInfo received by CRM
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None                                 AND
   ...       update Get Mem Usage Variable                                                                AND
   ...       set Suite Variable    ${dl_expect_tput_value}           70                                   AND
   ...       set Suite Variable    ${ul_expect_tput_value}           30                                   AND
   #         deviation need to take into account crm ul settings
   ...       set Suite Variable    ${deviation}                      10                                   AND
   ...       common_Dss_Keywords.Get testcase log directory                                               AND
   ...       common_Dss_Keywords.Prepare Test Name                                                        AND
   ...       Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0                                      AND
   ...       depends   TestLine_2574_Test_setup_10Mhz

   ${tc_name}        Set variable    TestLine_preparation
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...               5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A5}
   ${tc_name}        Set variable    TestLine_2574_Test_setup_10Mhz
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A5}

   # Update nrCellType into Context for CellId=1
   Update nrCellType into "${TestDSS10Mhz_2574_A5}" for cellID "1"

   ${msg}   Catenate   "5GC002574-A6_TC23_SA_CallSetup_SANSA_10MHz_DL_ratio_max_95_w_fast_allocation: sw release used [${convert_version}],
   ...                Cellsetup Dss phase 3, BW= 10MHz,
   ...                DL RATIO = 100%, , SA 5g Call , DL Tput\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                Check numOfPrb / startSymbol / rat0Bitmap in ICOM_5G/DlData_PdschSendReq based on CatMInfo received by CRM"
   common_Dss_Keywords.Log Test description   ${msg}

   # Specific Setting for this test...
   Update assigned_dl_maximum_share_to_nr with "100" into "${TestDSS10Mhz_2574_A5}"
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "true" value and update into "${TestDSS10Mhz_2574_A5}"

   # modification DL Ratio into the test param Ctx
   5GC002574_keywords.Update DSS DL pattern with     ${TestDSS10Mhz_2574_A5}     ${PATTERN_DL_100_SA_OK}
   Dated log       DL pattern into TestParam is ${TestDSS10Mhz_2574_A5.seq.dl_allocated_normal_subframes}

   # update CatM data with CatMinfo_10MHz_CatMData_CatMPaging_CatMSib1Br_mPBCH_DLRATIO_100 in Context
   Update CatMinfo with ${CatMinfo_10MHz_CatMData_CatMPaging_CatMSib1Br_mPBCH_DLRATIO_100} into "${TestDSS10Mhz_2574_A5}"

   # w superfast_allocation for the moment
   5GC002574_keywords.Update DSS dl qos load meas timer "${10}" ms and ul qos load meas timer "${30}" ms into "${TestDSS10Mhz_2574_A5}"
   Dated log       DL qos_load_meas_timer into TestParam is ${TestDSS10Mhz_2574_A5.seq.dl_qos_load_meas_timer} ms
   Dated log       UL qos_load_meas_timer into TestParam is ${TestDSS10Mhz_2574_A5.seq.ul_qos_load_meas_timer} ms

   common_Dss_Keywords.Start Tcpdump on TestPc       interface=eth3    option=-s0 sctp or icmp
   TC 2574 SA CellSetup                              ${TestDSS10Mhz_2574_A5}    egate_5GC002574_A6_TC23

   # add here the DL Pattern list to add to CRMSim and active it .... in case of superfast_allocation activated
   DSS_5g_Periodic_DL_Fast_Allocation           ${TestDSS10Mhz_2574_A5}    egate_5GC002574_A6_TC23

   TC 2574 5g SA Call                                ${TestDSS10Mhz_2574_A5}    egate_5GC002574_A6_TC23
   common_Dss_Keywords.Stop Tcpdump on TestPc        interface=eth3    target_dir=${testCaseDir}
   TC 2574 DL Tput SA Mode                             ${TestDSS10Mhz_2574_A5}
   ...                                                 ul_rate=${ul_expect_tput_value}
   ...                                                 dl_rate=${dl_expect_tput_value}
   ...                                                 forced_expected_dl_ratio=100
   ...                                                 alias=egate_5GC002574_A6_TC23

   5GC002574_keywords.Check CatM Info from L1L2 Pcap    ${TestDSS10Mhz_2574_A5}    ${testCaseDir}/${L1L2_Pcap_File.name}.pcap

   ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
   should contain	                ${output}	                            passed

   [Teardown]     Run Keywords       Run Keywords       Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value    AND
   ...                               5GC002574_Kw_TestSetup.Update DSS superfast_allocation with    ${TestDSS10Mhz_2574_A5}    false     AND
   ...                               Update assigned_dl_maximum_share_to_nr with   ${TestDSS10Mhz_2574_A5}   70    AND
   ...                               Get Gnb Snapshot if TestCase Failed                                           AND
   ...                               Teardown 2574     alias=egate_5GC002574_A6_TC23           AND
   ...                               set Suite Variable  ${testCaseDir}  None


