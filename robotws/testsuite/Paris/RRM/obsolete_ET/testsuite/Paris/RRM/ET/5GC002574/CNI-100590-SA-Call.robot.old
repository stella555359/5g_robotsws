# TC covered under New Feature
# [1]5GC002574-A6_TC22_SA_CallSetup_SANSA_20MHz_DL_ratio_max_95
[1][1.0] 5GC002574-A6_TC22_SA_CallSetup_SANSA_20MHz_DL_ratio_max_95
   [Tags]    FULL_RUN     20MHZ    2574   2574_A6
   ...       CRT     	CLOUD_5G_I_MP_AP_LO
   [Documentation]     Cellsetup Dss phase 3, BW= 20MHz, DL RATIO = 100%, superfast_allocation disable, SA 5g Call , DL Tput
   ...                 Check numOfPrb / startSymbol / rat0Bitmap in ICOM_5G/DlData_PdschSendReq based on CatMInfo received by CRM
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None                        AND
   ...                       update Get Mem Usage Variable                                       AND
   # for 4DL4UL celltype case
   ...                       set Suite Variable    ${dl_expect_tput_value}           280         AND
   # for 2DL2UL celltype case
   # ...                     set Suite Variable    ${dl_expect_tput_value}           140         AND
   ...                       set Suite Variable    ${ul_expect_tput_value}           30          AND
   #         deviation need to take into account crm ul settings
   ...                       set Suite Variable    ${deviation}                      10          AND
   ...                       common_Dss_Keywords.Get testcase log directory                      AND
   ...                       common_Dss_Keywords.Prepare Test Name                               AND
   ...                       Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0             AND
   ...                       robot_extension.Run Keyword And Warn On Failure    btslog.Start Btslog     AND
   ...                       depends   TestLine_2574_Test_setup_20Mhz

   Get Mem Usage for 2574    period=before

   ${tc_name}        Set variable    TestLine_preparation
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...               5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS20Mhz_2574_A5}
   ${tc_name}        Set variable    TestLine_2574_Test_setup_20Mhz
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS20Mhz_2574_A5}
   ${nrCellType}=    coam_parameter.get_single_value_from_scf_file
   ...                                            parameter=nrCellType
   ...                                            dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
   ...                                            connection=coam_gnb
   Dated Log         nrCellType for CELL1 is set to ${nrCellType}
   Run Keyword If  '${nrCellType}' == '4DL4UL'  set Suite Variable    ${dl_expect_tput_value}           280
   ...    ELSE                                  set Suite Variable    ${dl_expect_tput_value}           140

   ${actSlowPrbPoolingFddFr1Enh}          coam_parameter.get_single_value_from_scf_file
   ...                                            parameter=actSlowPrbPoolingFddFr1Enh
   ...                                            dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
   ...                                            connection=coam_gnb
   Dated Log         actSlowPrbPoolingFddFr1Enh is set to ${actSlowPrbPoolingFddFr1Enh} => perform delta Commissioning If Needed
   ${cond}=    Evaluate     '${actSlowPrbPoolingFddFr1Enh}'=='true'
   Run Keyword If     ${cond} and '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'
   ...       Run Keywords        dated log      => performing scf delta commission to update PDCCH Profile...
   ...         AND               coam_parameter.perform_scf_delta_commission
   ...                              delta_file=${PDCCHProfile_20MHz_actSlowPrbPoolingFddFr1Enh_delta_file_cell1}
   ...                              connection=coam_gnb
   # Wait end of commissioning
   ...         AND               OAM wait available
   ...     ELSE        Dated log     =====> gNB no Delta Commissioning performed because SHOULD_UPDATE_SCF_AND_RAD==0

   # Update nrCellType into Context for CellId=1
   Update nrCellType into "${TestDSS20Mhz_2574_A5}" for cellID "1"

   ${msg}   Catenate   "5GC002574-A6_TC22_SA_CallSetup_SANSA_20MHz_DL_ratio_max_95: sw release used [${convert_version}],
   ...                Cellsetup Dss phase 3, BW= 20MHz,
   ...                DL RATIO = 100%, SA 5g Call , DL Tput\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                Check numOfPrb / startSymbol / rat0Bitmap in ICOM_5G/DlData_PdschSendReq based on CatMInfo received by CRM"
   common_Dss_Keywords.Log Test description   ${msg}

   # Specific Setting for this test...
   Update assigned_dl_maximum_share_to_nr with "100" into "${TestDSS20Mhz_2574_A5}"
   # deactivate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS20Mhz_2574_A5}"

   # modification DL Ratio into the test param Ctx
   5GC002574_keywords.Update DSS DL pattern with     ${TestDSS20Mhz_2574_A5}     ${PATTERN_DL_100_SA_OK}
   Dated log       DL pattern into TestParam is ${TestDSS20Mhz_2574_A5.seq.dl_allocated_normal_subframes}

   # update CatM data with CatMinfo_20MHz_CatMData_CatMPaging_CatMSib1Br_mPBCH_DLRATIO_100_CatMData_HighEdge in Context
   Update CatMinfo with ${CatMinfo_20MHz_CatMData_CatMPaging_CatMSib1Br_mPBCH_DLRATIO_100_CatMData_HighEdge} into "${TestDSS20Mhz_2574_A5}"

   common_Dss_Keywords.Start Tcpdump on TestPc         interface=eth3    option=-s0 sctp or icmp
   TC 2574 SA CellSetup                                ${TestDSS20Mhz_2574_A5}    egate_5GC002574_A5_TC22
   TC 2574 5g SA Call                                  ${TestDSS20Mhz_2574_A5}    egate_5GC002574_A5_TC22

   Get Mem Usage for 2574    period=after_SA_Call

   common_Dss_Keywords.Stop Tcpdump on TestPc          interface=eth3    target_dir=${testCaseDir}
   ${forced_expected_dl_ratio}=    Set Variable If    '${actSlowPrbPoolingFddFr1Enh}'=='true'     80
   ...                                                                                            100
   TC 2574 DL Tput SA Mode                             ${TestDSS20Mhz_2574_A5}
   ...                                                 ul_rate=${ul_expect_tput_value}
   ...                                                 dl_rate=${dl_expect_tput_value}
   ...                                                 forced_expected_dl_ratio=${forced_expected_dl_ratio}
   ...                                                 alias=egate_5GC002574_A5_TC22

   Get Mem Usage for 2574    period=after_DL_Tput_SA_Mode

   5GC002574_keywords.Check 20MHz CatM Info from L1L2 Pcap    ${TestDSS20Mhz_2574_A5}    ${testCaseDir}/${L1L2_Pcap_File.name}.pcap

   ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
   should contain	                ${output}	                            passed

   [Teardown]     Run Keywords       robot_extension.Run Keyword And Warn On Failure    btslog.Stop Btslog    target_dir=${testCaseDir}      AND
   ...                               robot_extension.Run Keyword And Warn On Failure    Get Mem Usage for 2574  period=Teardown              AND
   ...                               Update assigned_dl_maximum_share_to_nr with   ${TestDSS20Mhz_2574_A5}   70             AND
   ...                               Get Gnb Snapshot if TestCase Failed                                                    AND
   ...                               Teardown 2574     alias=egate_5GC002574_A5_TC22                                        AND
   ...                               set Suite Variable  ${testCaseDir}  None

# PRV TC tp cover CNI-100590
# [1]5GC002574-A6_TC22_SA_CallSetup_SANSA_20MHz_DL_ratio_max_95
[1]PRV_CNI100590_TC22_SA_CallSetup_SANSA_20MHz_DL_ratio_max_95
   [Tags]    FULL_RUN     20MHZ    CNI100590
   ...       CRT     	CLOUD_5G_I_LO_AP_LO
   [Documentation]     Cellsetup Dss phase 3, BW= 20MHz, DL RATIO = 100%, superfast_allocation enable, SA 5g Call , DL Tput
   ...                 Check numOfPrb / startSymbol / rat0Bitmap in ICOM_5G/DlData_PdschSendReq based on CatMInfo received by CRM
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None                        AND
   ...                       update Get Mem Usage Variable                                       AND
   # for 4DL4UL celltype case
   ...                       set Suite Variable    ${dl_expect_tput_value}           280         AND
   # for 2DL2UL celltype case
   # ...                     set Suite Variable    ${dl_expect_tput_value}           140         AND
   ...                       set Suite Variable    ${ul_expect_tput_value}           30          AND
   #         deviation need to take into account crm ul settings
   ...                       set Suite Variable    ${deviation}                      10          AND
   ...                       common_Dss_Keywords.Get testcase log directory                      AND
   ...                       common_Dss_Keywords.Prepare Test Name                               AND
   ...                       Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0             AND
   ...                       robot_extension.Run Keyword And Warn On Failure    btslog.Start Btslog     AND
   ...                       Create Header Csv Test result                                       AND
   ...                       depends   TestLine_2574_Test_setup_20Mhz

   ${resultFile}    Set Variable     ${testCaseDir}/resultFile_${TEST NAME[0:30]}.log
   Set Test Variable    ${resultFile}
   ${resultFileCRM}    Set Variable     ${testCaseDir}/resultFileCRM_${TEST NAME[0:30]}.log
   Set Test Variable    ${resultFileCRM}

   set Test variable      ${rdMeaningfulDlLoadMeasurementDifference}    20
   set Test variable      ${rdMeaningfulUlLoadMeasurementDifference}    20
   Set RAD Params Of CNI100590    rdMeaningfulDlLoadMeasurementDifference=${rdMeaningfulDlLoadMeasurementDifference}
   ...                            rdMeaningfulUlLoadMeasurementDifference=${rdMeaningfulUlLoadMeasurementDifference}

   ${tc_name}        Set variable    TestLine_preparation
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...               5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS20Mhz_2574_A5}
   ${tc_name}        Set variable    TestLine_2574_Test_setup_20Mhz
   ${tc_status}      getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS20Mhz_2574_A5}
   ${nrCellType}=    coam_parameter.get_single_value_from_scf_file
   ...                                            parameter=nrCellType
   ...                                            dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
   ...                                            connection=coam_gnb
   Dated Log         nrCellType for CELL1 is set to ${nrCellType}
   Run Keyword If  '${nrCellType}' == '4DL4UL'  set Suite Variable    ${dl_expect_tput_value}           280
   ...    ELSE                                  set Suite Variable    ${dl_expect_tput_value}           140

   ${actSlowPrbPoolingFddFr1Enh}          coam_parameter.get_single_value_from_scf_file
   ...                                            parameter=actSlowPrbPoolingFddFr1Enh
   ...                                            dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
   ...                                            connection=coam_gnb
   Dated Log         actSlowPrbPoolingFddFr1Enh is set to ${actSlowPrbPoolingFddFr1Enh} => perform delta Commissioning If Needed
   ${cond}=    Evaluate     '${actSlowPrbPoolingFddFr1Enh}'=='true'
   Run Keyword If     ${cond} and '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'
   ...       Run Keywords        dated log      => performing scf delta commission to update PDCCH Profile...
   ...         AND               coam_parameter.perform_scf_delta_commission
   ...                              delta_file=${PDCCHProfile_20MHz_actSlowPrbPoolingFddFr1Enh_delta_file_cell1}
   ...                              connection=coam_gnb
   # Wait end of commissioning
   ...         AND               OAM wait available
   ...     ELSE        Dated log     =====> gNB no Delta Commissioning performed because SHOULD_UPDATE_SCF_AND_RAD==0

   # Update nrCellType into Context for CellId=1
   Update nrCellType into "${TestDSS20Mhz_2574_A5}" for cellID "1"

   ${msg}   Catenate   "5GC002574-A6_TC22_SA_CallSetup_SANSA_20MHz_DL_ratio_max_95: sw release used [${convert_version}],
   ...                Cellsetup Dss phase 3, BW= 20MHz,
   ...                DL RATIO = 100%, SA 5g Call , DL Tput\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                Check numOfPrb / startSymbol / rat0Bitmap in ICOM_5G/DlData_PdschSendReq based on CatMInfo received by CRM"
   common_Dss_Keywords.Log Test description   ${msg}

   # Specific Setting for this test...
   Update assigned_dl_maximum_share_to_nr with "100" into "${TestDSS20Mhz_2574_A5}"

   # activate superfast_allocation in scf and Param context (used during CellSetup)
   # Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "true" value and update into "${TestDSS20Mhz_2574_A5}"
   # Dated log       superfast_allocation into TestParam is ${TestDSS20Mhz_2574_A5.scfFile.nrdsslte.actLteNrDssFastAlloc}
   # activate superfast_allocation enh in scf and Param context (used during CellSetup)
   # Set 2574 Specifc Scf Param lteNrDssFastAllocPerfEnh with "exc_msg_reduction_static" value and update into "${TestDSS20Mhz_2574_A5}"
   # Dated log       lteNrDssFastAllocPerfEnh into TestParam is ${TestDSS20Mhz_2574_A5.scfFile.nrdsslte.lteNrDssFastAllocPerfEnh}
   # deactivate CATM
   # Set 2574 Specifc Scf Param actLteNrDssLteCatM with "false" value and update into "${TestDSS20Mhz_2574_A5}"

   import variables        ${CURDIR}/resources/python/CNI100590-Variables.py
   Set CNI100590 NIDD PARAMETERS    ${TestDSS20Mhz_2574_A5}    ${NIDD_100590_PARAMS_TESTS}

   # modification DL Ratio into the test param Ctx
   5GC002574_keywords.Update DSS DL pattern with     ${TestDSS20Mhz_2574_A5}     ${PATTERN_DL_100_SA_OK}
   Dated log       DL pattern into TestParam is ${TestDSS20Mhz_2574_A5.seq.dl_allocated_normal_subframes}

   # update CatM data with CatMinfo_20MHz_CatMData_CatMPaging_CatMSib1Br_mPBCH_DLRATIO_100_CatMData_HighEdge in Context
   Update CatMinfo with ${CatMinfo_20MHz_CatMData_CatMPaging_CatMSib1Br_mPBCH_DLRATIO_100_CatMData_HighEdge} into "${TestDSS20Mhz_2574_A5}"

   common_Dss_Keywords.Start Tcpdump on TestPc         interface=eth3    option=-s0 sctp or icmp
   TC 2574 SA CellSetup                                ${TestDSS20Mhz_2574_A5}    egate_5GC002574_A5_TC22
   # dump the CRM/ENB configuration
   common_Dss_CellSetup.get CRM and ENB Status         ${TestDSS20Mhz_2574_A5}    ${resultFileCRM}    egate_5GC002574_A5_TC22
   TC 2574 5g SA Call                                  ${TestDSS20Mhz_2574_A5}    egate_5GC002574_A5_TC22

   common_Dss_Keywords.Stop Tcpdump on TestPc          interface=eth3    target_dir=${testCaseDir}
   ${forced_expected_dl_ratio}=    Set Variable If    '${actSlowPrbPoolingFddFr1Enh}'=='true'     80
   ...                                                                                            100
   TC CNI100590 DL Tput SA Mode                        ${TestDSS20Mhz_2574_A5}
   ...                                                 ul_rate=${ul_expect_tput_value}
   ...                                                 dl_rate=${dl_expect_tput_value}
   ...                                                 forced_expected_dl_ratio=${forced_expected_dl_ratio}
   ...                                                 alias=egate_5GC002574_A5_TC22

   [Teardown]     Run Keywords
   ...    robot_extension.Run Keyword And Warn On Failure    btslog.Stop Btslog    target_dir=${testCaseDir}      AND
   ...    Update assigned_dl_maximum_share_to_nr with   ${TestDSS20Mhz_2574_A5}   70             AND
   ...    Get Gnb Snapshot if TestCase Failed                                                    AND
   ...    Teardow check Tests Kw                                                                 AND
   ...    robot_extension.Run Keyword And Warn On Failure   Extract egate_command    dir=${tl.core.dir_path}  egate_console=egate_console.log   AND
   ...    Teardown 2574     alias=egate_5GC002574_A5_TC22                                        AND
   ...    set Suite Variable  ${testCaseDir}  None


[1]PRV_TC1_20MHz_DL90_20_UL30_20_CNI100590_TC_03_5gCall_with_Traffic_SA_Mode
   [Tags]    FULL_RUN     20MHZ    CNI100590
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%, Fast DL Allocation, NSA 5g Call , DL/UL Tput
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None                                 AND
   ...       set Suite Variable    ${dl_expect_tput_value}           90                                   AND
   ...       set Suite Variable    ${ul_expect_tput_value}           30                                   AND
   #         as each 20ms Prb used  is flickering from 35 to 20, the check need to be done using following ul TP value
   ...       set Suite Variable    ${dl_expect_tput_value_for_TC03}  90                                   AND
   #         deviation need to take into account crm ul settings
   ...       set Suite Variable    ${deviation}                       10                                  AND
   ...       common_Dss_Keywords.Get testcase log directory                                               AND
   ...       common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp     AND
   ...       Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0                                      AND
   ...       robot_extension.Run Keyword And Warn On Failure    btslog.Start Btslog     AND
   ...       Create Header Csv Test result                                              AND
   ...       depends   TestLine_2574_Test_setup

   ${resultFile}    Set Variable     ${testCaseDir}/resultFile_${TEST NAME[0:30]}.log
   Set Test Variable    ${resultFile}
   ${resultFileCRM}    Set Variable     ${testCaseDir}/resultFileCRM_${TEST NAME[0:30]}.log
   Set Test Variable    ${resultFileCRM}

   set Test variable      ${rdMeaningfulDlLoadMeasurementDifference}    20
   set Test variable      ${rdMeaningfulUlLoadMeasurementDifference}    20
   ${name}=   Catenate      SEPARATOR=    20MHz_DL${dl_expect_tput_value}_${rdMeaningfulDlLoadMeasurementDifference}_
   ...                    UL${ul_expect_tput_value}_${rdMeaningfulUlLoadMeasurementDifference}
   Set Test Variable    ${name}
   Set RAD Params Of CNI100590    rdMeaningfulDlLoadMeasurementDifference=${rdMeaningfulDlLoadMeasurementDifference}
   ...                            rdMeaningfulUlLoadMeasurementDifference=${rdMeaningfulUlLoadMeasurementDifference}

   ${tc_name}    Set variable    TestLine_preparation
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...                          5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS20Mhz_2574_A5}
   ${tc_name}    Set variable    TestLine_2574_Test_setup
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS20Mhz_2574_A5}

   # modification DL Ratio into the test param Ctx
   Update DSS DL pattern with     ${TestDSS20Mhz_2574_A5}     ${PATTERN_DL_100_SA_OK}
   Dated log       DL pattern into TestParam is ${TestDSS20Mhz_2574_A5.seq.dl_allocated_normal_subframes}
   # Update DSS qos load meas timer with     ${TestDSS10Mhz_2574_A3}    ${dl_qos_load_meas_timer}=10    ${ul_qos_load_meas_timer}=30
   Update DSS dl qos load meas timer "${10}" ms and ul qos load meas timer "${10}" ms into "${TestDSS20Mhz_2574_A5}"
   Dated log       DL qos_load_meas_timer into TestParam is ${TestDSS20Mhz_2574_A5.seq.dl_qos_load_meas_timer} ms
   Dated log       UL qos_load_meas_timer into TestParam is ${TestDSS20Mhz_2574_A5.seq.ul_qos_load_meas_timer} ms

   import variables        ${CURDIR}/resources/python/CNI100590-Variables.py
   Set CNI100590 NIDD PARAMETERS    ${TestDSS20Mhz_2574_A5}    ${NIDD_100590_PARAMS_TESTS}

   5GC002574_keywords.TC DSS Phase3 CellSetup         ${TestDSS20Mhz_2574_A5}    egate_TC3
   # add here the DL Pattern list to add to CRMSim and active it ....
   # DSS_5g_Periodic_DL_Fast_Allocation           ${TestDSS20Mhz_2574_A5}    egate_TC3

   # dump the CRM/ENB configuration
   common_Dss_CellSetup.get CRM and ENB Status    ${TestDSS20Mhz_2574_A5}    ${resultFileCRM}    egate_TC3

   # add here check of NIDD configuration
   # Run keyword and continue on failure     common_Dss_Keywords.Admin Validate SCF     scf_path_file=${test_scf_file}
   robot_extension.Run Keyword And Warn On Failure    common_Dss_Keywords.Admin Validate SCF     scf_path_file=${test_scf_file}

   TC 2574 5g SA Call                           ${TestDSS20Mhz_2574_A5}    egate_TC3
   common_Dss_SA_NSA.DSS_5g_SA_UL_DL_Traffic      ${TestDSS20Mhz_2574_A5}
   ...                                             ul_rate=${ul_expect_tput_value}
   ...                                             dl_rate=${dl_expect_tput_value}
   ...                                             alias=egate_TC3

   Traced Sleep    5s      msg=Waiting for UL/DL Tput

   Start capture Backhaul XP for DSS    prefix=BH.XP.1s.wULDLTput
   Traced Sleep    1s      msg=Waiting for Xp pcap traces
   Dated log             Point AF_PATH and ENB_BUILD to local luashark XP package
   Point AF_PATH to local luashark XP package
   Point ENB_BUILD to local luashark XP package
   ${XpPdmlFile}    Stop capture Backhaul XP for DSS

   ${ret}   ${tti_trace_path}    Omit when TtiTrace deactivated
   ...                          Run Keyword And Ignore Error   Get TTI traces And Decode    suffix=wDlAndUlTput
   ...                                                                                      time=1s
   ${TtifileName}   set Variable    ttitrace_streaming.pcap
   Omit when TtiTrace deactivated    Append To File   ${resultFile}   \ntti_trace_path: ${tti_trace_path}
   Omit when TtiTrace deactivated    Append To File   ${resultFile}   \ntti_trace_file: ${TtifileName}
   Omit when TtiTrace deactivated    Append To File   ${resultFile}   \n

   set_pandas.init_pandas
   ${dl_csvFile}    Extract xp_dss_endssdlqosloadmeasurement Usefull info from Pcap    File=${testCaseDir}/${capture_BH_GNB.name}.pcap
   ${fileName}   nps_2574_tools.return_basename    ${dl_csvFile}
   pcap_dataframe.load_csv    csv_file_name=${fileName}    folder_path=${testCaseDir}
   ...                        csv_file_name_analysis=dl_analysis_${name}.csv    threshold=${rdMeaningfulDlLoadMeasurementDifference}
   ...                        direction=DL

   Append To File   ${resultFile}   \nxp_dss_endssdlqosloadmeasurement Input file: ${capture_BH_GNB.name}.pcap
   Append To File   ${resultFile}   \nResult file: dl_analysis_${name}.csv
   Append To File   ${resultFile}   \n

   ${ul_csvFile}    Extract xp_dss_endssulqosloadmeasurement Usefull info from Pcap    File=${testCaseDir}/${capture_BH_GNB.name}.pcap
   ${fileName}   nps_2574_tools.return_basename    ${ul_csvFile}
   pcap_dataframe.load_csv    csv_file_name=${fileName}    folder_path=${testCaseDir}
   ...                        csv_file_name_analysis=ul_analysis_${name}.csv    threshold=${rdMeaningfulUlLoadMeasurementDifference}
   ...                        direction=UL

   Append To File   ${resultFile}   \nxp_dss_endssulqosloadmeasurement Input file: ${capture_BH_GNB.name}.pcap
   Append To File   ${resultFile}   \nResult file: ul_analysis_${name}.csv
   Append To File   ${resultFile}   \n

   Dated log             Point AF_PATH and ENB_BUILD to local luashark XP package
   Point AF_PATH to local luashark XP package
   Point ENB_BUILD to local luashark XP package
   Dated log     =========> Check UL and DL Qos Load Indication MeasuredNgbrNnbrLoad ...
   ${status}     ${avg_ul_MeasuredNgbrNnbrLoad}=  Run Keyword and Ignore Error  common_Dss_Keywords.Check UL Qos Load Indication MeasuredNgbrNnbrLoad
   ...                                                                                              ${XpPdmlFile}
   ...                                                                                              value=64
   ...                                                                                              with_verdict=False
   Run Keyword and Ignore Error      common_Dss_Keywords.Check DL Qos Load Indication MeasuredNgbrNnbrLoad       ${XpPdmlFile}

   Dated log     =========> get dl and ul throughput for ue (0x${TestDSS20Mhz_2574_A5.Context.UeId1})


   ${ul_throughput_for_ue1}=  nps_dss_tools.get_bearer_stats_SA   ue=${TestDSS20Mhz_2574_A5.Context.UeId1}
   ...                                                             pdu=1   qfi=1    direction=ul  alias=egate_TC3
   dated log     ul throughput for ue1 is ${ul_throughput_for_ue1} Mbps

   ${dl_throughput_for_ue1}=  nps_dss_tools.get_bearer_stats_SA   ue=${TestDSS20Mhz_2574_A5.Context.UeId1}
   ...                                                             pdu=1   qfi=1    direction=dl  alias=egate_TC3
   dated log     dl throughput for ue1 is ${dl_throughput_for_ue1} Mbps

   Dated log     =========> Test if Expected dl throughput is reached [expected=${dl_expect_tput_value}Mbps]
   ${dl_target_tput}=         Evaluate    float(${dl_expect_tput_value})
   ${DL_tput_ok}              Verify xL tput     dir=DL    tput_value=${dl_throughput_for_ue1}
   ...                                           expect_tput_value=${dl_target_tput}    tput_deviation=${deviation}
   # following test is moved from the KW to be sure if failed it is really reported
   should be true    '${DL_tput_ok}'=='True'    Tput is not as expected!

   [Teardown]     Run Keywords
   ...    common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}               AND
   ...    robot_extension.Run Keyword And Warn On Failure    btslog.Stop Btslog    target_dir=${testCaseDir}      AND
   ...    Teardow check Tests Kw                                                                                  AND
   ...    robot_extension.Run Keyword And Warn On Failure   Extract egate_command    dir=${tl.core.dir_path}  egate_console=egate_console.log   AND
   ...    Teardown 2574     alias=egate_TC3           AND
   ...    set Suite Variable  ${testCaseDir}  None

