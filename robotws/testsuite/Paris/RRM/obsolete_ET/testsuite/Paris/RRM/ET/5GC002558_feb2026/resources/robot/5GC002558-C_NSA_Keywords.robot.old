*** Keywords ***

TC 2558-C NSA Attach
    [Documentation]     Generic test for NSA attach with PRB blanking
    [Arguments]         ${param}

    Init Sequence                ${param} 

    Critical Step                Commission SCF From Config Folder 
    Critical Step                Restart TL
	Run Keyword If       not ${isAic} 
    ...		 Step                Lock_Unused_Cells 
    # Critical Step                Start Mirroring And Traces AP
    Critical Step                Start Mirroring And Traces gNB
    Critical Step                Establish X2 Link
    Critical Step                Check AP Cell Setup Is Completed
    Critical Step                SgNB Addition And 5G Attach
    Critical Step                Stop Mirroring And Traces gNB
    # Critical Step                Stop Mirroring And Traces AP
    # Critical Step                Validation RRC Setup 2558-C NSA Attach
    Critical Step                Validation L2L1 2558-C NSA Attach

TC 2558-C NSA Traffic DL UL
    [Documentation]     Generic test for NSA traffic with PRB blanking
    [Arguments]         ${param}

    Init Sequence       ${param}

    Critical Step                Commission SCF From Config Folder 
    Critical Step                Restart TL
    Run Keyword If               not ${isAic} 
    ...		 Step                Lock_Unused_Cells 
    Critical Step                Establish X2 Link
    Critical Step                Check AP Cell Setup Is Completed
    Critical Step                SgNB Addition And 5G Attach
    # Critical Step                Start Mirroring And Traces AP
    Critical Step                Start Mirroring And Traces gNB
    Critical Step                Traffic DL NSA
    Critical Step                Traffic UL NSA
    Critical Step                Stop Mirroring And Traces gNB
    # Critical Step                Stop Mirroring And Traces AP
    Critical Step                Validation L2L1 2558-C If TRS Muting NSA

TC 2558-C NSA 15MHz SRS Traffic UL
    [Documentation]     Generic test for NSA traffic with PRB blanking
    [Arguments]         ${param}

    Init Sequence                ${param}

    Critical Step                Commission SCF From Config Folder 
    Critical Step                Restart TL
	Run Keyword If       not ${isAic} 
    ...		 Step                Lock_Unused_Cells 
    Critical Step                Set UE_Capa SRS
    Critical Step                Establish X2 Link
    Critical Step                Check AP Cell Setup Is Completed
    Critical Step                SgNB Addition And 5G Attach
    # Critical Step                Start Mirroring And Traces AP
    Critical Step                Start Mirroring And Traces gNB
    # Need to run DL+UL traffic as if with UL traffic only the datarate = 0
    # Critical Step              Traffic UL NSA SRS
    Critical Step                Traffic DL NSA
    Critical Step                Traffic UL NSA
    Critical Step                Stop Mirroring And Traces gNB
    # Critical Step                Stop Mirroring And Traces AP
    Critical Step                Validation L2L1 2558-C NSA SRS Traffic UL

Set UE_Capa SRS
    WtsCfgConfig.startSession
    ${oldValue}          getParam           prefix=ue_param id=11         param=ue_nr_capabilities
    replaceValue         prefix=ue_param
    ...                  param=ue_nr_capabilities
    ...                  oldValue=${oldValue}
    ...                  newValue=${param.ue_nr_capa}
    WtsCfgConfig.stopSession

Initialisation Variables 2558-C NSA 10MHz Low Edge Overlapping
    [Documentation]   All global variables needed for the checks in L2L1. Variables are set according to the number of blanking PRB configuration.
    ...    nbrOfBlankedPRBsHighEdgeDL=0
    ...    nbrOfBlankedPRBsHighEdgeUL=0
    ...    nbrOfBlankedPRBsLowEdgeDL=16
    ...    nbrOfBlankedPRBsLowEdgeUL=16
    [Arguments]    ${param}
    Dated Log New Line     [Initialisation Variables for TC: 2558-C NSA 1OMHz Low Edge Overlapping]
    #SCF to be used
    #Set Suite Variable    ${scf_to_be_tested}      ${scf_20B_nsa_10MHz_overlap} 
    #Total PRB available in BW before blanking
    ${total_prb_bw}   Set Variable If      '${param.chBwDl}' == '10MHz'    52
    ...                                    '${param.chBwDl}' == '15MHz'    79
    ...                                    '${param.chBwDl}' == '20MHz'    106
    Set Suite Variable    ${total_prb_bw}
    Dated Log    -----> Bandwidth is ${param.chBwDl} and the total of PRB available in BW is ${total_prb_bw}.\n
    #Blanking area acording location to nbrOfBlankedPRBsLowEdge and nbrOfBlankedPRBsHighEdge
    ${blanking_area_crb_low}       Evaluate      ${param.nbrOfBlankedPRBsLowEdgeDL}-1
    ${blanking_area_crb_high}      Evaluate      ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeDL}
    Set Suite Variable     ${blanking_area_crb_low}
    Set Suite Variable     ${blanking_area_crb_high}
    Dated Log    -----> Blanking area: [crb0<xxxx>crb${blanking_area_crb_low}<--BW-->crb${blanking_area_crb_high}<xxxx>crb${total_prb_bw}].
    #Overlapping TC or not
    Set Suite Variable     ${IsOverlapping}     True
    # For CSI RS for measurment and tracking (TRS)
    # From SPEC : set to 4*ROUNDUP(offsetPrbDl/4). For OffsetPrbDl see [5G_RAN_CP_36783]
    # From SPEC see [5G_RAN_CP_11056] 
    ${csi_rs_size}        Set Variable If     '${param.chBwDl}' == '10MHz'    52
    ...                                       '${param.chBwDl}' == '15MHz'    80
    ...                                       '${param.chBwDl}' == '20MHz'    108
    Set Suite Variable    ${csi_rs_size}
    ${trs_size}    Set Variable If    
    ...            '${param.trsMutingInBlankedPRBsEnabled}' == 'true'     ${blanking_area_crb_high}
    ...            '${param.trsMutingInBlankedPRBsEnabled}' == 'false'    ${csi_rs_size}           
    Set Suite Variable   ${trs_size}
    #Msg1
    Set Suite Variable    ${prach_prb_offset}    ${param.msg1FrequencyStart}
    Set Suite Variable    ${rrc_prach_prb_offset}   16
    #RAT0 allocation for PDSCH
    #From SPEC: In case of blanking. All RBGs containing at least one blanked PRB are excluded from PDSCH scheduling 
    Set Suite Variable    ${rat0_start}     ${16}
    Set Suite Variable    ${rat0_end}       ${51}
    Set Suite Variable    ${rat0_size}      ${36}
    #RAT1 allocation for PUSCH and pdsch for msg2.
    #From SPEC: Blanked PRB are excluded from PUSCH scheduling
    Set Suite Variable        ${rat1_start}     ${param.nbrOfBlankedPRBsLowEdgeUL}  
    ${rat1_end}    Evaluate   ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeUL}-1 
    Set Suite Variable        ${rat1_end}
    #PDCCH
    #Coreset0
    Set Suite Variable    ${l1l2_coreset0}             0xff00000000000000
    Set Suite Variable    ${l1l2_coreset0_rb_shift}    04
    Set Suite Variable    ${rrc_coreset0}              ff0000000000
    #Coreset config if coreset0 is overlapped
    Set Suite Variable    ${l1l2_coreset_overlap}      0x1f00000000000000
    Set Suite Variable    ${rrc_coreset_overlap}       1f0000000000

    #SRS Configuration : 5G_RAN_CP_36175
    ${available_ul_prb}    Evaluate             ${total_prb_bw}-${param.nbrOfBlankedPRBsLowEdgeUL}-${param.nbrOfBlankedPRBsHighEdgeUL}
    ${c_srs}               Set Variable If     ${available_ul_prb} < ${24}    1
    ...                                        ${available_ul_prb} >= ${24} and ${available_ul_prb} < ${32}     7
    ...                                        ${available_ul_prb} >= ${32} and ${available_ul_prb} < ${52}     9
    ...                                        ${available_ul_prb} >= ${52} and ${available_ul_prb} < ${79}     14
    ...                                        ${available_ul_prb} >= ${79} and ${available_ul_prb} < ${106}    20
    ...                                        ${available_ul_prb} == ${106}    9
    Set Suite Variable    ${freq_pos}     0
    Set Suite Variable    ${freq_shift}   ${param.nbrOfBlankedPRBsLowEdgeUL}
    Set Suite Variable    ${c_srs}        
    Set Suite Variable    ${b_srs}        0
    Set Suite Variable    ${b_hop}        0
    Dated Log    -----> All variables are initialised.

Initialisation Variables 2558-C NSA 15MHz Both Edge Not Overlapping
    [Documentation]   All global variables needed for the checks in L2L1. Variables are set according to the number of blanking PRB configuration.
    ...    nbrOfBlankedPRBsHighEdgeDL=17
    ...    nbrOfBlankedPRBsHighEdgeUL=17
    ...    nbrOfBlankedPRBsLowEdgeDL=9
    ...    nbrOfBlankedPRBsLowEdgeUL=9
    [Arguments]    ${param}
    Dated Log New Line     [Initialisation Variables for TC: 2558-C NSA 15MHz Both Edge Not Overlapping]
    #Total PRB available in BW before blanking
    ${total_prb_bw}   Set Variable If      '${param.chBwDl}' == '10MHz'    52
    ...                                    '${param.chBwDl}' == '15MHz'    79
    ...                                    '${param.chBwDl}' == '20MHz'    106
    Set Suite Variable    ${total_prb_bw}
    Dated Log    -----> Bandwidth is ${param.chBwDl} and the total of PRB available in BW is ${total_prb_bw}.\n
    #Blanking area acording location to nbrOfBlankedPRBsLowEdge and nbrOfBlankedPRBsHighEdge
    ${blanking_area_crb_low}       Evaluate      ${param.nbrOfBlankedPRBsLowEdgeDL}-1
    ${blanking_area_crb_high}      Evaluate      ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeDL}
    Set Suite Variable     ${blanking_area_crb_low}
    Set Suite Variable     ${blanking_area_crb_high}
    Dated Log    -----> Blanking area: [crb0<xxxx>${blanking_area_crb_low}<--BW-->crb${blanking_area_crb_high}<xxxx>crb${total_prb_bw}].
    #Overlapping TC or not
    Set Suite Variable     ${IsOverlapping}     False
    # For CSI RS for measurment and tracking (TRS)
    # From SPEC : set to 4*ROUNDUP(offsetPrbDl/4). For OffsetPrbDl see [5G_RAN_CP_36783]
    # From SPEC see [5G_RAN_CP_11056] 
    ${csi_rs_size}        Set Variable If     '${param.chBwDl}' == '10MHz'    52
    ...                                       '${param.chBwDl}' == '15MHz'    80
    ...                                       '${param.chBwDl}' == '20MHz'    108
    Set Suite Variable    ${csi_rs_size}
    ${trs_size}    Set Variable If    
    ...            '${param.trsMutingInBlankedPRBsEnabled}' == 'true'     ${blanking_area_crb_high}
    ...            '${param.trsMutingInBlankedPRBsEnabled}' == 'false'    ${csi_rs_size}           
    Set Suite Variable   ${trs_size}
    #Msg1
    Set Suite Variable    ${prach_prb_offset}     ${param.msg1FrequencyStart} 
    Set Suite Variable    ${rrc_prach_prb_offset}   9
    #RAT0 allocation for PDSCH
    #From SPEC: In case of blanking. All RBGs containing at least one blanked PRB are excluded from PDSCH scheduling 
    Set Suite Variable    ${rat0_start}     ${16}
    Set Suite Variable    ${rat0_end}       ${55}
    Set Suite Variable    ${rat0_size}      ${40}
    #RAT1 allocation for PUSCH and pdsch for msg2.
    #From SPEC: Blanked PRB are excluded from PUSCH scheduling
    Set Suite Variable        ${rat1_start}     ${param.nbrOfBlankedPRBsLowEdgeUL}  
    ${rat1_end}    Evaluate   ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeUL}-1 
    Set Suite Variable        ${rat1_end}
    #PDCCH
    #coreset0
    Set Suite Variable    ${l1l2_coreset0}             0x3fc0000000000000
    Set Suite Variable    ${l1l2_coreset0_rb_shift}    02
    Set Suite Variable    ${rrc_coreset0}              3fc000000000           
    #SRS Configuration : 5G_RAN_CP_36175
    ${available_ul_prb}    Evaluate             ${total_prb_bw}-${param.nbrOfBlankedPRBsLowEdgeUL}-${param.nbrOfBlankedPRBsHighEdgeUL}
    ${c_srs}               Set Variable If     ${available_ul_prb} < ${24}    1
    ...                                        ${available_ul_prb} >= ${24} and ${available_ul_prb} < ${32}     7
    ...                                        ${available_ul_prb} >= ${32} and ${available_ul_prb} < ${52}     9
    ...                                        ${available_ul_prb} >= ${52} and ${available_ul_prb} < ${79}     14
    ...                                        ${available_ul_prb} >= ${79} and ${available_ul_prb} < ${106}    20
    ...                                        ${available_ul_prb} == ${106}    9
    Set Suite Variable    ${freq_pos}     0
    Set Suite Variable    ${freq_shift}   ${param.nbrOfBlankedPRBsLowEdgeUL}
    Set Suite Variable    ${c_srs}        
    Set Suite Variable    ${b_srs}        0
    Set Suite Variable    ${b_hop}        0
    Dated Log    -----> All variables are initialised.

Validation RRC Setup 2558-C NSA Attach
    [Documentation]    Validation RRC Setup 
    ${x2_pdml_file}    Generate Pdml From Pcap        ${capture_gnb_x2.path}
    Dated Log     ****************[Validation of RRC setup configuration]*************
    Check In X2 RRC Reconfiguration Is Completed      pdml_file=${x2_pdml_file}
    Check In RRC Setup msg1FrequencyStart             pdml_file=${x2_pdml_file}     
    ...                                               msg1_initialBWP=0   
    ...                                               msg1_bwpCommon=${rrc_prach_prb_offset}
    Run Keyword IF    '${IsOverlapping}' == 'True'    Check In RRC Setup Coreset Configuration NSA Overlapping    
    ...                                               pdml_file=${x2_pdml_file}     coresetID_frequdomain=${rrc_coreset_overlap}
    ...                ELSE                           Check In RRC Setup Coreset Configuration NSA Not Overlapping 
    ...                                               pdml_file=${x2_pdml_file}
    Check In RRC Setup Pucch Allocation         pdml_file=${x2_pdml_file}  
    Check In RRC Setup SRS configuration            pdml_file=${x2_pdml_file}
    ...    value_shift=${freq_shift} 
    ...    value_pos=${freq_pos}   
    ...    value_csrs=${c_srs}      
    ...    value_bsrs=${b_srs}    
    ...    value_bhop=${b_hop}
    Check In RRC Setup CSI RS Measurment Allocation     pdml_file=${x2_pdml_file}
    Dated Log     ****************[Validation of RRC setup completed]*************

Validation L2L1 2558-C NSA Attach
