Variables    ./resources/python/Constants-CB008940-Q-L.py

Variables    ./resources/python/Constants-CB008940-H.py

# Suites and Tests setup and teardown
Suite Setup       Suite Setup CB008940-Q-L-Common    test_dictParam=${dictParam}
Suite Teardown    Suite Teardown CB008940-Q-L-Common
Test Setup        Test Setup for CB008940-Common
Test Teardown     Test Teardown for CB008940-Common

