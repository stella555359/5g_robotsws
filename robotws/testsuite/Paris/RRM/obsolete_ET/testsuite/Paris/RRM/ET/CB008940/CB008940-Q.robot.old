*** Test Cases ***
### SA

[1]CB008940-Q_3_Interaction_with_CB007113_UL_DL_traffic_1x8DL8UL_2x8DL4UL
    [Documentation]
    ...     Conditions:     it is based on the configuration ${C_Cell}
    ...                         actDlSrsBm is activated
    ...                         srsForBeamMgmt at Cell level
    ...                              <list name="srsForBeamMgmt">
    ...                                   <item>
    ...                                   <p name="bSRS">2</p>
    ...                                   <p name="cSRS">63</p>
    ...                                   <p name="srsPowerThresholdForDlBm">-1200</p>
    ...                                   <p name="srsTypeAllocForDlBm">antenna switching or codebook</p>
    ...                                   <p name="srsUePeriodicity">slots40</p>
    ...                                   </item>
    ...                              </list>
    ...                        actUeCsirsCoexistCellCsirs = TRUE
    ...                    In egate, you need to activate the Srs mode : cfg file modified by KW
    ...                                                       "Update Basic Configuration File for actDlSrsBm Test Mode"
    ...                      cell_srs_beam_pos_nr profile_id=1 num_of_ue_positions=4 azimuth=-40,-13,13,40
    ...                      cell_testmode_set_nr cell_id=1 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
    ...                      cell_testmode_set_nr cell_id=2 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
    ...                      cell_testmode_set_nr cell_id=3 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
    ...     Actions:        it performs the call setup for multi-ues on different cells with DL traffic
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues and PRB pooling are passed
    [Tags]   CRT
    TC CB008940  ${C_Cell}    ${dictParam}    ${Vendor_IWK_CB8940-Q_CB7113}    ${dict_settings_all_ues_8940_Q_CB007113}    nrCell=3
    ...          kw Set RAD Params=Set RAD Params for 8940-Q
    ...          kw NIDD Set=Set CB008940-Q NIDD PARAMETERS
    ...          kw NIDD Check=Check CB008940-Q NIDD PARAMETERS
    ...          kw Set TestMode=Update Basic Configuration File for actDlSrsBm Test Mode
    ...          NIDD_8940_PARAMS=${NIDD_8940_Q_W_CB007113_PARAMS}
    # ...          Kw TestLine Preparation=TL_Preparation_CB008940_Q_TC3_SCF
    ...          Kw TestLine Preparation=TL_Preparation_CB008940_Q_TC3_SCF_TRY

[1]CB008940-Q_6_Parity with 1cell_8DL8UL and 2 cells_8DL4UL_DL_MU_MIMO_4layers_CB008305
    TL_Preparation_CB008940_Q_TC3_SCF    output_scf=${test_scf_file}
    TC_8940-Q_06    paramsQ06=${params_Q06}       vendor_param=${Vendor_Q06}        dict_ues=${dict_settings_Q06_all_ues}
    [Teardown]     Run Keywords       Set global variable    ${EXCLUDE_LOGS_IF_FAIL}   1
    ...               AND             Test Teardown for CB008940-Common
    ...               AND             Run Keyword If Test Failed          Setup.Test Teardown


*** Keywords ***

TL_Preparation_CB008940_Q_TC3_SCF
    [Arguments]    ${output_scf}
    ${Current_btsName}=   set Variable   ${Host Name}
    ${PartOfBtsName}=    set Variable   DL CL MIMO 8x8 1Cell 8x4 2Cells BeamSet_6
    ${FullbtsName}=      set Variable   CB008940 - ${Current_btsName} - ${PartOfBtsName}
    ${test_scf_file}           COAM Get SCF      file=SCF.xml    w_setup_admin=False   alias=coam_gnb
    ${current_scf_fullname}    set Variable      ${test_scf_file}
    ${CsvFilename}      Remove String      ${current_scf_fullname}     .xml
    ${output_scf}       set Variable       ${CsvFilename}_modified_for_CB008940.xml
    ${scf_update_8940}    SCF Enable CB008940 Q TC3   input_scf=${current_scf_fullname}    output_scf=${output_scf}
    ...                                               btsName=${FullbtsName[0:78]}
    dated log   TL_Preparation_CB008940_Q_TC3_SCF Kw : SCF To commit ${scf_update_8940}
    set suite variable     ${test_scf_file}   ${scf_update_8940}
    [Return]     ${scf_update_8940}

SCF Enable CB008940 Q TC3
    [Arguments]    ${input_scf}    ${output_scf}   ${btsName}=${Host Name}
    ${ret}    ${testline_name}=    OperatingSystem.Run And Return Rc And Output    hostname|sed 's/-/_/g'
    ${PartOfBtsName}=          set Variable   DL CL MIMO 8x8 1Cell 8x4 2Cells BeamSet_6
    ${FullbtsName}=            set Variable   CB008940 - ${testline_name} - ${PartOfBtsName}
    set global Variable    ${SCF_btsName}   ${FullbtsName[0:78]}
    import variables    ${CURDIR}/resources/python/CB008940_nidd_modify.py
    scf.load scf    ${input_scf}
    FOR    ${item}    IN    @{Beamset_LIST_NAME_PARAMS_TO_Remove}
        ${list_exist}=            scf.is_list_in_object     dist_name=&{item}[dist_name]         list_name=&{item}[list_name]
        Run Keyword IF            ${list_exist}
        ...                       scf.remove list from scf    dist_name=&{item}[dist_name]    list_name=&{item}[list_name]
    END
    FOR    ${item}    IN    @{CB008940_ELEMENT_PARAMS_TO_ADD}
        Set Element     dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    FOR    ${item}    IN    @{CB008940_LIST_NAME_PARAMS_TO_ADD}
        Set List     dist_name=&{item}[dist_name]    list_name=&{item}[list_name]
    END
    FOR    ${item}    IN    @{CB008940_LIST_ITEMS_PARAMS_TO_ADD}
        Set Item To List      dist_name=&{item}[dist_name]    list_name=&{item}[list_name]    elements=&{item}[elements]
    END
    FOR    ${item}    IN    @{CB008940_LIST_ELEMENTS_PARAMS_TO_ADD}
         Set Element To List      dist_name=&{item}[dist_name]    list_name=&{item}[list_name]    elements=&{item}[elements]
    END
    FOR   ${item}    IN    @{MODIFY_SCF_8940_BASE}
        Set Element    dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    FOR   ${item}    IN    @{MODIFY_SCF_BF_BASE}
        Set Element    dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    FOR   ${item}    IN    @{MODIFY_SCF_DL_MIMO_8_4_BASE}
        Set Element    dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    FOR   ${item}    IN    @{MODIFY_SCF_DL_MIMO_8_8_BASE}
        Set Element    dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    FOR   ${item}    IN    @{MODIFY_SCF_PAGING_BASE}
        Set Element    dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    Modify Channels to support 8DL8UL nrCellType    CellId=1
    Modify Channels to support 8DL4UL nrCellType    CellId=2
    Modify Channels to support 8DL4UL nrCellType    CellId=3
    scf.save scf    ${output_scf}
    [Return]     ${output_scf}

TL_Preparation_CB008940_Q_TC3_SCF_TRY
    [Arguments]    ${output_scf}
    ${Current_btsName}=   set Variable   ${Host Name}
    ${PartOfBtsName}=    set Variable   DL CL MIMO 8x8 1Cell 8x4 2Cells BeamSet_6
    ${FullbtsName}=      set Variable   CB008940 - ${Current_btsName} - ${PartOfBtsName}
    ${test_scf_file}           COAM Get SCF      file=SCF.xml    w_setup_admin=False   alias=coam_gnb
    ${current_scf_fullname}    set Variable      ${test_scf_file}
    ${CsvFilename}      Remove String      ${current_scf_fullname}     .xml
    ${output_scf}       set Variable       ${CsvFilename}_modified_for_CB008940.xml
    ${scf_update_8940}    SCF Enable CB008940 Q TC3 TRY   input_scf=${current_scf_fullname}    output_scf=${output_scf}
    ...                                               btsName=${FullbtsName[0:78]}
    dated log   TL_Preparation_CB008940_Q_TC3_SCF_TRY Kw : SCF To commit ${scf_update_8940}
    set suite variable     ${test_scf_file}   ${scf_update_8940}
    [Return]     ${scf_update_8940}

SCF Enable CB008940 Q TC3 TRY
    [Arguments]    ${input_scf}    ${output_scf}   ${btsName}=${Host Name}
    ${ret}    ${testline_name}=    OperatingSystem.Run And Return Rc And Output    hostname|sed 's/-/_/g'
    ${PartOfBtsName}=          set Variable   DL CL MIMO 8x8 3Cells BeamSet_6
    ${FullbtsName}=            set Variable   CB008940 - ${testline_name} - ${PartOfBtsName}
    set global Variable    ${SCF_btsName}   ${FullbtsName[0:78]}
    import variables    ${CURDIR}/resources/python/CB008940_nidd_modify.py
    scf.load scf    ${input_scf}
    FOR    ${item}    IN    @{Beamset_LIST_NAME_PARAMS_TO_Remove}
        ${list_exist}=            scf.is_list_in_object     dist_name=&{item}[dist_name]         list_name=&{item}[list_name]
        Run Keyword IF            ${list_exist}
        ...                       scf.remove list from scf    dist_name=&{item}[dist_name]    list_name=&{item}[list_name]
    END
    FOR    ${item}    IN    @{CB008940_ELEMENT_PARAMS_TO_ADD}
        Set Element     dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    FOR    ${item}    IN    @{CB008940_LIST_NAME_PARAMS_TO_ADD}
        Set List     dist_name=&{item}[dist_name]    list_name=&{item}[list_name]
    END
    FOR    ${item}    IN    @{CB008940_LIST_ITEMS_PARAMS_TO_ADD}
        Set Item To List      dist_name=&{item}[dist_name]    list_name=&{item}[list_name]    elements=&{item}[elements]
    END
    FOR    ${item}    IN    @{CB008940_LIST_ELEMENTS_PARAMS_TO_ADD}
         Set Element To List      dist_name=&{item}[dist_name]    list_name=&{item}[list_name]    elements=&{item}[elements]
    END
    FOR   ${item}    IN    @{MODIFY_SCF_8940_BASE}
        Set Element    dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    FOR   ${item}    IN    @{MODIFY_SCF_BF_BASE}
        Set Element    dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    FOR   ${item}    IN    @{MODIFY_SCF_DL_MIMO_8_4_BASE}
        Set Element    dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    FOR   ${item}    IN    @{MODIFY_SCF_DL_MIMO_8_8_TRY_BASE}
        Set Element    dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    FOR   ${item}    IN    @{MODIFY_SCF_PAGING_BASE}
        Set Element    dist_name=&{item}[dist_name]    p_name=&{item}[p_name]    value=&{item}[value]
    END
    Modify Channels to support 8DL8UL nrCellType    CellId=1
    Modify Channels to support 8DL8UL nrCellType    CellId=2
    Modify Channels to support 8DL8UL nrCellType    CellId=3
    scf.save scf    ${output_scf}
    [Return]     ${output_scf}
