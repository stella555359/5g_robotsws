# DlData_PdschSendReq.PdschSendReq.sfn
# DlData_PdschSendReq.PdschSendReq.slot
# DlData_PdschSendReq.grants_item_0.rnti
# DlData_PdschSendReq.grants_item_0.startSymbol
# DlData_PdschSendReq.grants_item_0.numOfPdschSymbols
# DlData_PdschSendReq.grants_item_0.mcs
# DlData_PdschSendReq.grants_item_0.startPrb
# DlData_PdschSendReq.grants_item_0.numOfPrb
# DlData_PdschSendReq.grants_item_0.rbgSize
# DlData_PdschSendReq.grants_item_0.rbgSizeFirst
# DlData_PdschSendReq.grants_item_0.rat0Bitmap
# DlData_PdschSendReq.grants_item_0.modulationOrder
# DlData_PdschSendReq.grants_item_0.tbSize_bits

# Info;sfn;slot;rnti;startSymbol;numOfPdschSymbols;mcs;startPrb;numOfPrb;rbgSize;rbgSizeFirst;rat0Bitmap;rvIndex;rateMatchingOption
Extract Usefull info from _5g_l1_dl_l2_ps_dldata_pdschsendreq_t Pcap
    [Arguments]                     ${File}
    [Documentation]                 Extract _5g_l1_dl_l2_ps_dldata_pdschsendreq_t info from Pcap

    Dated log                   Extract _5g_l1_dl_l2_ps_dldata_pdschsendreq_t info from PCAP file [${File}]

    set test variable   ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq}    pcapprocessed_Extract_pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq.txt
    set test variable   ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}  ${testCaseDir}/${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq}
    ${cmd1}=    Set Variable If   '${mcshark_present}'=='${False}'   tshark -X lua_script:/opt/luashark/generated_luashark/luashark.lua
    ...                                                              tshark
    # ${branch} is a test suite variable intialized during test suite setup Kw
    ${l1l2ItfVersion}=   Run Keyword And Return Status   Should Match Regexp     ${branch}     ^SBTS25R[2-9]|SBTS00$
    ${pattern}=    Run Keyword If    ${l1l2ItfVersion}   set variable     dldata_pdschsendreql1sw
    ...               ELSE                               set variable     dldata_pdschsendreq
    ${pattern_DlGrant}=    Run Keyword If    ${l1l2ItfVersion}   set variable     DlData_PdschGrantL1sw
    ...                       ELSE                               set variable     DlData_PdschGrant
    ${waiting_pattern}=    Run Keyword If    ${l1l2ItfVersion}   set variable     DlData_PdschSendReqL1sw
    ...                       ELSE                               set variable     DlData_PdschSendReq
    ${cmd}    catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e DlData_PdschSendReq.PdschSendReq.sfn
    ...           -e DlData_PdschSendReq.PdschSendReq.slot
    ...           -e DlData_PdschSendReq.grants_item_0.rnti
    ...           -e DlData_PdschSendReq.grants_item_0.startSymbol
    ...           -e DlData_PdschSendReq.grants_item_0.numOfPdschSymbols
    ...           -e DlData_PdschSendReq.grants_item_0.mcs
    ...           -e DlData_PdschSendReq.grants_item_0.startPrb
    ...           -e DlData_PdschSendReq.grants_item_0.numOfPrb
    ...           -e DlData_PdschSendReq.grants_item_0.rbgSize
    ...           -e DlData_PdschSendReq.grants_item_0.rbgSizeFirst
    ...           -e DlData_PdschSendReq.grants_item_0.rat0Bitmap
    ...           -e DlData_PdschSendReq.grants_item_0.rvIndex
    ...           -e DlData_PdschSendReq.grants_item_0.rateMatchingOption
    ...           -E header=y -E separator=';' > ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}
    ${cmd_mcshark}    Catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "${pattern}" -e _ws.col.Info
    ...           -e 3gpp.sfn
    ...           -e 3gpp.slot
    ...           -e 3gpp.rnti
    ...           -e ${pattern_DlGrant}.startSymbol
    ...           -e ${pattern_DlGrant}.numOfPdschSymbols
    ...           -e ${pattern_DlGrant}.mcs
    ...           -e ${pattern_DlGrant}.startPrb
    ...           -e ${pattern_DlGrant}.numOfPrb
    ...           -e ${pattern_DlGrant}.rbgSize
    ...           -e ${pattern_DlGrant}.rbgSizeFirst
    ...           -e ${pattern_DlGrant}.rat0Bitmap
    ...           -e ${pattern_DlGrant}.rvIndex
    ...           -e ${pattern_DlGrant}.rateMatchingOption
    ...           -E header=y -E separator=';' > ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}
    run Keyword if    '${mcshark_present}'=='${False}'   Run       ${cmd}
    ...  ELSE                                            Run       ${cmd_mcshark}
    # remove space if present
    Run      command=sed -i -e 's/ //g' ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}

    ${extract_col_info}   OperatingSystem.grep file        ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}   _ws.col.Info
    # ;0x00000001 means 1 CatM record  => catMInfo-Length == 0x00000001
    ${pattern}=     set variable if   '${mcshark_present}'=='${False}'    ICOM_5G/DlData_PdschSendReq
    ...                                                                   ${waiting_pattern}
    ${extract}  OperatingSystem.grep file  ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}
    ...                                    ${pattern}
    run keyword if  len($extract)==0     fail   ${pattern} not found
    OperatingSystem.copy file     ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}    ${testCaseDir}/msg_DlData_PdschSendReq_pcap.csv

# Info;sfn;slot;rnti;startSymbol;numOfPdschSymbols;mcs;startPrb;numOfPrb;rbgSize;rbgSizeFirst;rat0Bitmap;rvIndex;
#   rateMatchingOption;modulationOrder;tbSize_bits
Extract Usefull info for Special MCS from _5g_l1_dl_l2_ps_dldata_pdschsendreq_t Pcap
    [Arguments]                     ${File}
    [Documentation]                 Extract _5g_l1_dl_l2_ps_dldata_pdschsendreq_t info from Pcap

    Dated log                   Extract _5g_l1_dl_l2_ps_dldata_pdschsendreq_t info from PCAP file [${File}]

    # ${branch} is a test suite variable intialized during test suite setup Kw
    ${l1l2ItfVersion}=   Run Keyword And Return Status   Should Match Regexp     ${branch}     ^SBTS25R[2-9]|SBTS00$
    ${pattern}=    Run Keyword If    ${l1l2ItfVersion}   set variable     dldata_pdschsendreql1sw
    ...               ELSE                               set variable     dldata_pdschsendreq
    ${pattern_DlGrant}=    Run Keyword If    ${l1l2ItfVersion}   set variable     DlData_PdschGrantL1sw
    ...                       ELSE                               set variable     DlData_PdschGrant
    ${waiting_pattern}=    Run Keyword If    ${l1l2ItfVersion}   set variable     DlData_PdschSendReqL1sw
    ...                       ELSE                               set variable     DlData_PdschSendReq
    set test variable   ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq}
    ...                             pcapprocessed_Extract_pcapprocessed_special_mcs_l1_dl_l2_ps_dldata_pdschsendreq.txt
    set test variable   ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}  ${testCaseDir}/${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq}
    ${cmd1}=    Set Variable If   '${mcshark_present}'=='${False}'   tshark -X lua_script:/opt/luashark/generated_luashark/luashark.lua
    ...                                                              tshark
    ${cmd}    catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e DlData_PdschSendReq.PdschSendReq.sfn
    ...           -e DlData_PdschSendReq.PdschSendReq.slot
    ...           -e DlData_PdschSendReq.grants_item_0.rnti
    ...           -e DlData_PdschSendReq.grants_item_0.startSymbol
    ...           -e DlData_PdschSendReq.grants_item_0.numOfPdschSymbols
    ...           -e DlData_PdschSendReq.grants_item_0.mcs
    ...           -e DlData_PdschSendReq.grants_item_0.startPrb
    ...           -e DlData_PdschSendReq.grants_item_0.numOfPrb
    ...           -e DlData_PdschSendReq.grants_item_0.rbgSize
    ...           -e DlData_PdschSendReq.grants_item_0.rbgSizeFirst
    ...           -e DlData_PdschSendReq.grants_item_0.rat0Bitmap
    ...           -e DlData_PdschSendReq.grants_item_0.rvIndex
    ...           -e DlData_PdschSendReq.grants_item_0.rateMatchingOption
    ...           -e DlData_PdschSendReq.grants_item_0.modulationOrder
    ...           -e DlData_PdschSendReq.grants_item_0.tbSize_bits
    ...           -E header=y -E separator=';' > ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}
    ${cmd_mcshark}    Catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "${pattern}" -e _ws.col.Info
    ...           -e 3gpp.sfn
    ...           -e 3gpp.slot
    ...           -e 3gpp.rnti
    ...           -e ${pattern_DlGrant}.startSymbol
    ...           -e ${pattern_DlGrant}.numOfPdschSymbols
    ...           -e ${pattern_DlGrant}.mcs
    ...           -e ${pattern_DlGrant}.startPrb
    ...           -e ${pattern_DlGrant}.numOfPrb
    ...           -e ${pattern_DlGrant}.rbgSize
    ...           -e ${pattern_DlGrant}.rbgSizeFirst
    ...           -e ${pattern_DlGrant}.rat0Bitmap
    ...           -e ${pattern_DlGrant}.rvIndex
    ...           -e ${pattern_DlGrant}.rateMatchingOption
    ...           -e ${pattern_DlGrant}.modulationOrder
    ...           -e ${pattern_DlGrant}.tbSize_bits
    ...           -E header=y -E separator=';' > ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}
    run Keyword if    '${mcshark_present}'=='${False}'   Run       ${cmd}
    ...  ELSE                                            Run       ${cmd_mcshark}
    # remove space if present
    Run      command=sed -i -e 's/ //g' ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}

    ${extract_col_info}   OperatingSystem.grep file        ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}   _ws.col.Info
    # ;0x00000001 means 1 CatM record  => catMInfo-Length == 0x00000001
    ${pattern}=     set variable if   '${mcshark_present}'=='${False}'    ICOM_5G/DlData_PdschSendReq
    ...                                                                   ${waiting_pattern}
    ${extract}  OperatingSystem.grep file  ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}
    ...                                    ${pattern}
    run keyword if  len($extract)==0     fail   ${pattern} not found
    OperatingSystem.copy file    ${pcapprocessed_l1_dl_l2_ps_dldata_pdschsendreq_path}   ${testCaseDir}/msg_DlData_PdschSendReq_pcap_MCS_Special.csv

