    robot_extension.Run Keyword And Warn On Failure     Check if FaultID IncorrectCellParameterSettingAI present in Syslogs
    robot_extension.Run Keyword And Warn On Failure     Check if MaxRlcRetransmission exceeded present in Syslogs
    robot_extension.Run Keyword And Warn On Failure     Check if ERR/.uplane/L2-PS present in Syslogs
    robot_extension.Run Keyword And Warn On Failure     Check if ERR/L2-PS present in Syslogs
    robot_extension.Run Keyword And Warn On Failure     Check if resource allocation failed present in Syslogs
    robot_extension.Run Keyword And Warn On Failure     Extract L2-PS/src/sgnl/psCell/CellSetupLogger from Syslogs
    robot_extension.Run Keyword And Warn On Failure     Kw Check errors in Syslog


Check if ESTATUS5G_NOTOK present in Syslogs
   ${commandToRun}     Catenate     cd /tmp/btslog2; find . -name "*.LOG" -type f | sort | sed -e 's/^\\.\\///g'
   ${ret}    ${syslogfiles}     Run Keyword And Ignore Error    Run   ${commandToRun}
   ${all_sysLog_files}    Split String    ${syslogfiles}    separator=\n
   FOR    ${syslog}    IN    @{all_sysLog_files}
         dated log    Computing syslog File ${consTraceColor}${syslog}${defColor}...
         ${contains_no_Syslogs}=     Run Keyword And Return Status       Should Not Contain     ${syslog}     ${EMPTY}
         # ${contains_no_Syslogs}==True   => Syslog are not present !!!
         Run Keyword if   '${contains_no_Syslogs}' == 'False'  robot_extension.Run Keyword And Warn On Failure  Check ESTATUS5G_NOTOK
         ...                                                                                                                       syslog=${syslog}
         ...    ELSE                                           dated log    ${consTraceColorRed}syslog are not present !!!${defColor}
         Run Keyword if   '${contains_no_Syslogs}' == 'False'  robot_extension.Run Keyword And Warn On Failure   Check GnbOamCellUpdateFailed
         ...                                                                                                                       syslog=${syslog}
         ...    ELSE                                           dated log    ${consTraceColorRed}syslog are not present !!!${defColor}
   END

