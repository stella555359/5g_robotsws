Check CatM based on pcap traces
    [Arguments]                    ${param}
    BuiltIn.log     bandwidth is ${param.seq.bandwidth}
    Dated log     ==========> verify_5GC002574_CatM_Info from DlData_PdschSendReq pcap file
    # ${branch} is a test suite variable intialized during test suite setup Kw
    ${l1l2ItfVersion}=   Run Keyword And Return Status   Should Match Regexp     ${branch}     ^SBTS25R[2-9]|SBTS00$
    ${pattern}=    Run Keyword If    ${l1l2ItfVersion}   set variable     DlData_PdschSendReqL1sw
    ...               ELSE                               set variable     DlData_PdschSendReq
    ${SharkTool}=   set variable if   '${mcshark_present}'=='${False}'    LUA_SHARK
    ...                                                                   MC_SHARK
    ${output}  ${elt_to_display}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_CatM_Info   pattern=${pattern}  SharkTool=${SharkTool}
    Dated log     ==========> Display numOfPrb / startSymbol / rat0Bitmap
    FOR   ${value}    IN  @{elt_to_display}
        Dated log      ${value}
    END
    [return]    ${output}

