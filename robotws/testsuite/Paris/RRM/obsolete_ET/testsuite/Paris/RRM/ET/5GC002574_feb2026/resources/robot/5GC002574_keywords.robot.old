# DlData_PdschSendReq.PdschSendReq.sfn
# DlData_PdschSendReq.PdschSendReq.slot
# DlData_PdschSendReq.grants_item_0.rnti
# DlData_PdschSendReq.grants_item_0.startSymbol
# DlData_PdschSendReq.grants_item_0.numOfPdschSymbols
# DlData_PdschSendReq.grants_item_0.mcs
# DlData_PdschSendReq.grants_item_0.startPrb
# DlData_PdschSendReq.grants_item_0.numOfPrb
# DlData_PdschSendReq.grants_item_0.rbgSize
# DlData_PdschSendReq.grants_item_0.rbgSizeFirst
# DlData_PdschSendReq.grants_item_0.rat0Bitmap
# DlData_PdschSendReq.grants_item_0.rvIndex

# Info;sfn;slot;rnti;startSymbol;numOfPdschSymbols;mcs;startPrb;numOfPrb;rbgSize;rbgSizeFirst;rat0Bitmap;rvIndex;rateMatchingOption
Extract sfn, slot And nbOfPrb from _5g_l1_dl_l2_ps_dldata_pdschsendreq_t Pcap
    [Arguments]                     ${File}
    [Documentation]                 Extract sfn slot and nbOfPrb _5g_l1_dl_l2_ps_dldata_pdschsendreq_t info from Pcap

    Dated log                   Extract sfn, slot and nbOfPrb _5g_l1_dl_l2_ps_dldata_pdschsendreq_t info from PCAP file    ${File}

    set test variable   ${pcapprocessed_nbOfPrb_l1_dl_l2_ps_dldata_pdschsendreq}    pcapprocessed_Extract_nbOfPrb_l1_dl_l2_ps_dldata_pdschsendreq.txt
    set test variable   ${pcapprocessed_nbOfPrb_l1_dl_l2_ps_dldata_pdschsendreq_path}
    ...                                 ${testCaseDir}/${pcapprocessed_nbOfPrb_l1_dl_l2_ps_dldata_pdschsendreq}
    ${cmd1}=    Set Variable If   '${mcshark_present}'=='${False}'   tshark -X lua_script:/opt/luashark/generated_luashark/luashark.lua
    ...                                                              tshark
    ${cmd}    catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e DlData_PdschSendReq.PdschSendReq.sfn
    ...           -e DlData_PdschSendReq.PdschSendReq.slot
    ...           -e DlData_PdschSendReq.grants_item_0.rnti
    ...           -e DlData_PdschSendReq.grants_item_0.numOfPrb
    ...           -e DlData_PdschSendReq.grants_item_0.rvIndex
    ...           -E header=y -E separator=';' > ${pcapprocessed_nbOfPrb_l1_dl_l2_ps_dldata_pdschsendreq_path}
    # ${branch} is a test suite variable intialized during test suite setup Kw
    ${l1l2ItfVersion}=   Run Keyword And Return Status   Should Match Regexp     ${branch}     ^SBTS25R[2-9]|SBTS00$
    ${pattern}=    Run Keyword If    ${l1l2ItfVersion}   set variable     dldata_pdschsendreql1sw
    ...               ELSE                               set variable     dldata_pdschsendreq
    ${pattern_DlGrant}=    Run Keyword If    ${l1l2ItfVersion}   set variable     DlData_PdschGrantL1sw
    ...                       ELSE                               set variable     DlData_PdschGrant
    ${waiting_pattern}=    Run Keyword If    ${l1l2ItfVersion}   set variable     DlData_PdschSendReqL1sw
    ...                       ELSE                               set variable     DlData_PdschSendReq
    ${cmd_mcshark}    Catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "${pattern}" -e _ws.col.Info
    ...           -e 3gpp.sfn
    ...           -e 3gpp.slot
    ...           -e 3gpp.rnti
    ...           -e ${pattern_DlGrant}.numOfPrb
    ...           -e ${pattern_DlGrant}.rvIndex
    ...           -E header=y -E separator=';' > ${pcapprocessed_nbOfPrb_l1_dl_l2_ps_dldata_pdschsendreq_path}
    run Keyword if    '${mcshark_present}'=='${False}'   Run       ${cmd}
    ...  ELSE                                            Run       ${cmd_mcshark}
    # remove space if present
    Run      command=sed -i -e 's/ //g' ${pcapprocessed_nbOfPrb_l1_dl_l2_ps_dldata_pdschsendreq_path}

    ${extract_col_info}   OperatingSystem.grep file        ${pcapprocessed_nbOfPrb_l1_dl_l2_ps_dldata_pdschsendreq_path}   _ws.col.Info
    # ;0x00000001 means 1 CatM record  => catMInfo-Length == 0x00000001
    ${pattern}=     set variable if   '${mcshark_present}'=='${False}'    ICOM_5G/DlData_PdschSendReq
    ...                                                                   ${waiting_pattern}
    ${extract}  OperatingSystem.grep file  ${pcapprocessed_nbOfPrb_l1_dl_l2_ps_dldata_pdschsendreq_path}    ${pattern}
    run keyword if  len($extract)==0     fail   ${pattern} not found
    OperatingSystem.copy file    ${pcapprocessed_nbOfPrb_l1_dl_l2_ps_dldata_pdschsendreq_path}
    ...                          ${testCaseDir}/msg_nbOfPrb_DlData_PdschSendReq_pcap.csv

################ for traces purposes ##############

Get L1L2 traces
    [Arguments]     ${time}=1s   ${prefix}=DL_UL_Tput
    Dated Log         Get L1L2 Bip Traces
    ${CaptureBIP}              Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    ${testCase}    Replace String    ${TEST_NAME[0:30]}    ${SPACE}    _
    ${testCase}    Replace String    ${testCase}    .    _
    ${testCase}    Remove String     ${testCase}    [1]
    ${testCase}    Remove String     ${testCase}    [1.0]
    ${testCase}    Remove String     ${testCase}    [2.0]
    ${testCase}    Remove String     ${testCase}    [
    ${testCase}    Remove String     ${testCase}    ]
    # ${CaptureBIP.prefix}       set Variable   ${prefix}.${testCase}
    ${CaptureBIP.prefix}       set Variable   ${prefix}
    ${CaptureBIP.withTN}       set Variable   False
    # ${CaptureBIP.filter}       Get Filter all BIP msgs
    # 12/20/2022 : with load SBTS00_ENB_9999_221215_000002; ether[16:2]==0x8951 BIP filter for ABIN/ABIO works
    # but not ABIL ether[12:2]==0x8951 !!!! why !!!
    # ${CaptureBIP.filter}       set Variable If   '${GNB_DU.bb[0].M.boardType}'!='ABIP'    ether[16:2]==0x8951
    # ...                                                                                   Get Filter all BIP msgs
    # dated log     CaptureBIP.filter=${CaptureBIP.filter} before changes
    # solution1
    # ${CaptureBIP.filter}       run Keyword if   '${GNB_DU.bb[0].M.boardType}'=='ABIP'     Get Filter all BIP msgs
    # ...                           ELSE                                                    set variable   ${EMPTY}
    # solution2
    # to manage the case vlan218 encapsulated within vlan305 (seen with ABIO / ABIP) and the case vlan218 only (seen with ABIP & ABIL)
    # ${CaptureBIP.filter}       set variable   ether[12:2]=0x8951 or ether[16:2]=0x8951
    # ${CaptureBIP.filter}       set variable   vlan

    Capture Init   ${CaptureBIP}
    #define options of gnbMirroring.sh (BIP only)
    # ${OPT_GNB_MIRRORING_DSS}                 Tools.Dictionary Get              ${OPT_GNB_MIRRORING}
    # ${OPT_GNB_MIRRORING_DSS.mirroring_mode}            set Variable         'manual'
    # ${OPT_GNB_MIRRORING_DSS.l2_l1_bip}                 set Variable         'true'
    # ${OPT_GNB_MIRRORING_DSS.backhaul_mirroring}        set Variable         'false'
    # Set Suite Variable              ${OPT_GNB_MIRRORING_DSS}
    # Execute Mirror Script with options for DSS      ${CaptureBIP.scriptDef}    ${OPT_GNB_MIRRORING_DSS}
    Capture start  ${CaptureBIP}
    Traced Sleep   ${time}     msg=take BIP L1L2 traces with DL/UL Tput
    Capture stop   ${CaptureBIP}
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureBIP.path}
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${CaptureBIP.path}    ${testCaseDir}
    [Return]    ${CaptureBIP}

Get TTI traces And Decode
    [Arguments]     ${suffix}=${EMPTY}   ${time}=1s    ${event_nr_max}=30000   ${w_convert_pcap_to_excelCsv}=False
    Dated Log         ======> Get TTI traces
    ${tm}    Get Current Date
    ${tm}=    Remove String    ${tm.replace(' ','-')}    .
    Dated Log         Start TTI Traces in Streaming Mode
    ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traced Sleep    ${time}      msg=Waiting for TTI Traces
    Dated log         Stop TTI Traces in Streaming Mode...
    ${ttiTraceSubDir}   set Variable    TtiTrace-${time}-${tm}
    ${ttiTraceSubDir}   set Variable if    '${suffix}'!='${EMPTY}'     ${ttiTraceSubDir}-${suffix}
    ...                                                                ${ttiTraceSubDir}
    ${tti_trace_path}=     ttitrace.Stop TTI Traces in Streaming Mode    tti_trace_path=${testCaseDir}/${ttiTraceSubDir}
    Dated log         Decode TTI Traces...
    nps_ttitraces_tools.decode_tti_traces_using_TtitraceReaderEvtDec       desired_storage_directory=${testCaseDir}/${ttiTraceSubDir}
    ...                                                                    num_of_events=${event_nr_max}
    Run Keyword And Ignore Error   OperatingSystem.Run
    ...                                 cp ${testCaseDir}/${ttiTraceSubDir}/msg_all.csv ${testCaseDir}/${ttiTraceSubDir}/msg-all-${time}-${tm}.csv
    run keyword if   '${w_convert_pcap_to_excelCsv}'=='True'    run keywords
    ...               Dated log    Convert TTI trace from pcap to excelCsv...    AND
    ...               Run keyword and continue on failure     ttitrace.Convert TTI trace from pcap to excelCsv     input_file_path=${tti_trace_path}
    ...                                                                    output_file_path=${testCaseDir}/${ttiTraceSubDir}
    [return]     ${testCaseDir}/${ttiTraceSubDir}

Start Backhaul Traces
    [Arguments]  ${bh_trace_collector_name}
    Return from keyword if    '${logs_and_traces_flags['BackhaulTrace']}'=='False'
    Run keyword and ignore error  Start Collection of gNB BH Traces  bh_trace_collector_name=${bh_trace_collector_name}

