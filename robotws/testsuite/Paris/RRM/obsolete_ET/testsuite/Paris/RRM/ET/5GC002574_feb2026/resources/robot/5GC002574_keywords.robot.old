Display DSS and CatM Info from cellSetup Pcap
    [Arguments]                     ${File}
    [Documentation]                 Display CatMInfo from CPRT -> L2PS in GNB_CPRT_NODE Pcap

    Dated log                   Display DSS and CatM Info from PCAP file    ${File}

    set test variable    ${pcapprocessed_Display_CatMInfo_CPRT}    pcapprocessed_Display_CatMInfo_itf_l2_ps_cell_CellSetupReq_CPRT.txt
    set test variable    ${pcapprocessed_Display_CatMInfo_CPRT_path}    ${LOG_PATH}/${pcapprocessed_Display_CatMInfo_CPRT}
    ${cmd1}=    Set Variable If   '${mcshark_present}'=='${False}'   tshark -X lua_script:/opt/luashark/generated_luashark/luashark.lua
    ...                                                              tshark
    ${cmd}    catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e itf_l2_ps_cell_CellSetupReq.dss.actLteNrDssFastAlloc -e itf_l2_ps_cell_CellSetupReq.dss.isLteFlexibleRateMatchingEnabled
    ...           -e itf_l2_ps_cell_CellSetupReq.dss.isLteFlexibleRateMatchingAltModeEnabled -e itf_l2_ps_cell_CellSetupReq.dss.actRateMatchedCsiIm
    ...           -e itf_l2_ps_cell_CellSetupReq.dss.actLteNrDssLteCatM
    ...           -E header=y -E separator=';' > ${pcapprocessed_Display_CatMInfo_CPRT_path}
    ${cmd_mcshark}    Catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e itf_l2_ps_DynamicSpectrumSharing.actLteNrDssFastAlloc -e itf_l2_ps_DynamicSpectrumSharing.isLteFlexibleRateMatchingEnabled
    ...           -e itf_l2_ps_DynamicSpectrumSharing.isLteFlexibleRateMatchingAltModeEnabled -e itf_l2_ps_DynamicSpectrumSharing.actRateMatchedCsiIm
    ...           -e itf_l2_ps_DynamicSpectrumSharing.actLteNrDssLteCatM
    ...           -E header=y -E separator=';' > ${pcapprocessed_Display_CatMInfo_CPRT_path}
    run Keyword if    '${mcshark_present}'=='${False}'   Run       ${cmd}
    ...  ELSE                                            Run       ${cmd_mcshark}

    ${extract_col_info}   OperatingSystem.grep file        ${pcapprocessed_Display_CatMInfo_CPRT_path}   _ws.col.Info
    ${pattern}=     set variable if   '${mcshark_present}'=='${False}'    ICOM_5G/itf_l2_ps_cell_CellSetupReq
    ...                                                                   itf_l2_ps_cell_CellSetupReq
    ${extract}   OperatingSystem.grep file        ${pcapprocessed_Display_CatMInfo_CPRT_path}   ${pattern}
    run keyword if  len($extract)==0     fail   ${pattern} not found

    @{extract_col_info_formated}=    String.Split String      ${extract_col_info}   ;
    @{extract_formated}=    String.Split String    ${extract}    ;
    ${length}=    Get Length    ${extract_col_info_formated}
    FOR    ${i}    IN RANGE    ${length}
        Dated log                   --- ${extract_col_info_formated}[${i}] = ${extract_formated}[${i}]
    END

Display DSS and CatM Info from itf_l2_ps_cell_DssCellCrmClientCfgReq Pcap
    [Arguments]                     ${File}
    [Documentation]                 Display CatMInfo from CPRT -> L2PS in GNB_CPRT_NODE Pcap

    Dated log                   Display DSS and CatM Info from itf_l2_ps_cell_DssCellCrmClientCfgReq PCAP file    ${File}

    set test variable   ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT}    pcapprocessed_Display_CatMInfo_DssCellCrmClientCfgReq_CPRT.txt
    set test variable   ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT_path}  ${LOG_PATH}/${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT}
    ${cmd}    catenate      tshark -X lua_script:/opt/luashark/generated_luashark/luashark.lua -r
    ...        ${File} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.catMInfo-Length
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.dataCatMAreaList_item_0.startPrb
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.dataCatMAreaList_item_0.numOfPrb
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.dataCatMAreaList_item_0.startSymbol
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.dataCatMAreaList_item_0.numOfSymbol
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.catMInfo_item_0.repeatedMPBCH
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.pagingCatMAreaList_item_0.startPrb
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.pagingCatMAreaList_item_0.numOfPrb
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.pagingCatMAreaList_item_0.startSymbol
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.pagingCatMAreaList_item_0.numOfSymbol
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.pagingCatMAreaList_item_1.startPrb
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.pagingCatMAreaList_item_1.numOfPrb
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.pagingCatMAreaList_item_1.startSymbol
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.pagingCatMAreaList_item_1.numOfSymbol
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.sib1CatMAreaList_item_0.startPrb
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.sib1CatMAreaList_item_0.numOfPrb
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.sib1CatMAreaList_item_0.startSymbol
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.sib1CatMAreaList_item_0.numOfSymbol
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.sib1CatMAreaList_item_1.startPrb
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.sib1CatMAreaList_item_1.numOfPrb
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.sib1CatMAreaList_item_1.startSymbol
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.sib1CatMAreaList_item_1.numOfSymbol
    ...           -e itf_l2_ps_cell_DssCellCrmClientCfgReq.catMInfo_item_0.csiReportingSubbandSize
    # ...           -e _ws.lua.text
    ...           -E header=y -E separator=';' > ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT_path}
    Run       ${cmd}

    ${extract_col_info}   OperatingSystem.grep file        ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT_path}   _ws.col.Info
    # ;0x00000001 means 1 CatM record  => catMInfo-Length == 0x00000001
    ${extract}  OperatingSystem.grep file  ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT_path}
    ...                                    ICOM_5G/itf_l2_ps_cell_DssCellCrmClientCfgReq;0x00000001
    run keyword if  len($extract)==0     fail   itf_l2_ps_cell_DssCellCrmClientCfgReq not found

    @{extract_col_info_formated}=    String.Split String      ${extract_col_info}   ;
    @{extract_formated}=    String.Split String    ${extract}    ;
    ${length}=    Get Length    ${extract_col_info_formated}
    FOR    ${i}    IN RANGE    ${length}
        Dated log                   --- ${extract_col_info_formated}[${i}] = ${extract_formated}[${i}]
    END

Display DSS and CatM Info from itf_l2_ps_cell_DssCellCrmClientCfgReq Pcap Using McShark
    [Arguments]                     ${File}
    [Documentation]                 Display CatMInfo from CPRT -> L2PS in GNB_CPRT_NODE Pcap

    return from Keyword if   not ${mcshark_present}

    Dated log                   Display DSS and CatM Info from itf_l2_ps_cell_DssCellCrmClientCfgReq PCAP file    ${File}

    set test variable   ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT}    pcapprocessed_Display_CatMInfo_DssCellCrmClientCfgReq_CPRT.txt
    set test variable   ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT_path}  ${LOG_PATH}/${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT}
    # field Length sould be itf_l2_ps_cell_DssCellCrmClientCfgReq   1;2;2
    # 1 record CatMdata + 2 record CatM SibBr + 2 record CatM Paging
    ${cmd}    catenate      tshark -r
    ...        ${File} -T fields -Y "icom_5g&&itf_l2_ps_cell_prbarea" -e _ws.col.Info
    ...           -e itf_l2_ps_cell_CatMInfo.dataCatMAreaList.Length
    ...           -e itf_l2_ps_cell_CatMInfo.pagingCatMAreaList.Length
    ...           -e itf_l2_ps_cell_CatMInfo.sib1CatMAreaList.Length
    ...           -e itf_l2_ps_cell_CatMInfo.repeatedMPBCH
    ...           -e itf_l2_ps_cell_PrbArea.startPrb
    ...           -e itf_l2_ps_cell_PrbArea.numOfPrb
    ...           -e itf_l2_ps_cell_PrbArea.startSymbol
    ...           -e itf_l2_ps_cell_PrbArea.numOfSymbol
    ...           -e itf_l2_ps_cell_CatMInfo.csiReportingSubbandSize
    ...           -E header=y -E separator=';' > ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT_path}
    Run       ${cmd}

    ${extract_col_info}   OperatingSystem.grep file        ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT_path}   _ws.col.Info
    # ;1;2;2 means 1 CatM record  => 1 record CatMdata + 2 record CatM SibBr + 2 record CatM Paging
    ${extract}  OperatingSystem.grep file  ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT_path}
    ...                                    itf_l2_ps_cell_DssCellCrmClientCfgReq ;1;2;2
    run keyword if  len($extract)==0     fail   itf_l2_ps_cell_DssCellCrmClientCfgReq not found

    @{extract_col_info_formated}=    String.Split String      ${extract_col_info}   ;
    @{extract_formated}=    String.Split String    ${extract}    ;
    ${length}=    Get Length    ${extract_col_info_formated}
    Dated log    INFO : itf_l2_ps_cell_CatMInfo : 1 record CatMdata + 2 records CatM SibBr + 2 records CatM Paging
    FOR    ${i}    IN RANGE    ${length}
        Dated log                   --- ${extract_col_info_formated}[${i}] = ${extract_formated}[${i}]
    END

Check CatM Info from itf_l2_ps_cell_DssCellCrmClientCfgReq Pcap
    [Arguments]                     ${File}
    [Documentation]                 Display CatMInfo from CPRT -> L2PS in GNB_CPRT_NODE Pcap

    Dated log                   Check CatM Info from itf_l2_ps_cell_DssCellCrmClientCfgReq PCAP file    ${File}

    ${extract}   OperatingSystem.grep file        ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT_path}
    ...                                           ICOM_5G/itf_l2_ps_cell_DssCellCrmClientCfgReq;0x00000001
    run keyword if  len($extract)==0     fail   itf_l2_ps_cell_DssCellCrmClientCfgReq not found
    # itf_l2_ps_cell_DssCellCrmClientCfgReq.dataCatMAreaList_item_0.startPrb
    # ${ValueToCheckIn_DssCellCrmClientCfgReq}=    Catenate    SEPARATOR=    ICOM_5G/itf_l2_ps_cell_DssCellCrmClientCfgReq;0x00000001;0x00000005;
    # ...       0x00000006;0x00000003;0x0000000b;0x00000000;0x0000002c;0x00000007;0x00000003;0x0000000b;0x0000002c;0x00000007;0x00000003;
    # ...       0x0000000b;0x0000002c;0x00000007;0x00000003;0x0000000b;0x0000002c;0x00000007;0x00000003;0x0000000b;0
    # 2022-06-01 : csamson, Need to change itf value to check
    # ${ValueToCheckIn_DssCellCrmClientCfgReq}=    Catenate    SEPARATOR=    ICOM_5G/itf_l2_ps_cell_DssCellCrmClientCfgReq;0x00000001;0x00000005;
    # ...       0x00000006;0x00000003;0x0000000b;0x00000000;0x0000002c;0x00000007;0x00000003;0x0000000b;0x0000002c;0x00000007;0x00000003;
    # ...       0x0000000b;0x0000000e;0x00000006;0x00000003;0x0000000b;0x0000002c;0x00000007;0x00000003;0x0000000b;0
    ${ValueToCheckIn_DssCellCrmClientCfgReq}=    Catenate    SEPARATOR=    ICOM_5G/itf_l2_ps_cell_DssCellCrmClientCfgReq;0x00000001;0x0005;
    ...       0x0006;0x03;0x0b;0x00;0x002c;0x0007;0x03;0x0b;0x002c;0x0007;0x03;
    ...       0x0b;0x000e;0x0006;0x03;0x0b;0x002c;0x0007;0x03;0x0b;0

    ${cmd}=   Catenate    cat ${pcapprocessed_CatMInfo_DssCellCrmClientCfgReq_CPRT_path} | grep ICOM_5G/itf_l2_ps_cell_DssCellCrmClientCfgReq
    ...                      | grep -o "${ValueToCheckIn_DssCellCrmClientCfgReq}" | wc -l
    ${CatM_count}       Run    ${cmd}
    ${msgError}=  Catenate     catMInfo / dataCatMAreaList / repeatedMPBCH / pagingCatMAreaList / sib1CatMAreaList not PRESENT in
    ...                         itf_l2_ps_cell_DssCellCrmClientCfgReq as expected
    Should Be Equal As Integers    ${CatM_count}    ${1}     ${msgError}

    # repeated_mpbch=${Param.seq.CatMinfo.repeated_mpbch}
    # start_symbol=${Param.seq.CatMinfo.start_symbol}
    # catm_dl_data_index=${Param.seq.CatMinfo.catm_dl_data_index}
    # paging_starting_index=${Param.seq.CatMinfo.paging_starting_index}
    # num_of_catm_paging_records=${Param.seq.CatMinfo.num_of_catm_paging_records}
    # sib1br_starting_index=${Param.seq.CatMinfo.sib1br_starting_index}
    # num_of_catm_sib1br_records=${Param.seq.CatMinfo.num_of_catm_sib1br_records}
    # ${result} =  Convert To HeX      ${Param.seq.CatMinfo.repeated_mpbch}    prefix=0x    length=8   lowercase=${True}

