        Should Be Equal    ${result list}[${i}]    ${expected}[${i}]
    END

Check actLteNrDssLteCatM in cellSetupreq Pcap
    [Arguments]                     ${File}
    [Documentation]                 Check actLteNrDssLteCatM from CPRT -> L2PS in GNB_CPRT_NODE Pcap

    Dated log                   Checking actLteNrDssLteCatM inside PCAP file    ${File}
    Dated log                   ---Checking actLteNrDssLteCatM in itf_l2_ps_cell_cellsetupreq
    # 2022-06-01 : csamson, Need to change itf value to check
    # ${ValueToCheckIn_cellsetupreq}=   Set Variable If   "${param.scfFile.nrdsslte.actLteNrDssLteCatM}"=="true"     0x00000001    0x00000000
    ${ValueToCheckIn_cellsetupreq}=   Set Variable If   "${param.scfFile.nrdsslte.actLteNrDssLteCatM}"=="true"     0x01    0x00
    ${ValueToCheckIn_cellsetupreq_mcshark}=   Set Variable If   "${param.scfFile.nrdsslte.actLteNrDssLteCatM}"=="true"   1    0
    ${ValueToCheckIn_cellsetupreq}=    Set Variable If   '${mcshark_present}'=='${True}'   ${ValueToCheckIn_cellsetupreq_mcshark}
    ...                                                                                    ${ValueToCheckIn_cellsetupreq}
    set test variable    ${pcapprocessed_CatMInfo_CPRT}    pcapprocessed_CatMInfo_CPRT.txt
    set test variable    ${pcapprocessed_CatMInfo_CPRT_path}    ${LOG_PATH}/${pcapprocessed_CatMInfo_CPRT}
    ${cmd1}=    Set Variable If   '${mcshark_present}'=='${False}'   tshark -X lua_script:/opt/luashark/generated_luashark/luashark.lua
    ...                                                              tshark
    ${cmd}    Catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e itf_l2_ps_cell_CellSetupReq.dss.actLteNrDssLteCatM -e itf_l2_ps_cell_CellSetupReq.dss.actRateMatchedCsiIm
    ...           -E header=y -E separator=';' > ${pcapprocessed_CatMInfo_CPRT_path}
     ${cmd_mcshark}    Catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e itf_l2_ps_DynamicSpectrumSharing.actLteNrDssLteCatM -e itf_l2_ps_DynamicSpectrumSharing.actRateMatchedCsiIm
    ...           -E header=y -E separator=';' > ${pcapprocessed_CatMInfo_CPRT_path}

    run Keyword if    '${mcshark_present}'=='${False}'   Run       ${cmd}
    ...  ELSE                                            Run       ${cmd_mcshark}

    ${pattern}=     set variable if   '${mcshark_present}'=='${False}'    ICOM_5G/itf_l2_ps_cell_CellSetupReq
    ...                                                                   itf_l2_ps_cell_CellSetupReq
    ${extract}   OperatingSystem.grep file        ${pcapprocessed_CatMInfo_CPRT_path}    ${pattern}
    run keyword if  len($extract)==0     fail   ${pattern} not found
    ${cmd}=   Catenate    cat ${pcapprocessed_CatMInfo_CPRT_path} | grep ${pattern} | grep -o ${ValueToCheckIn_cellsetupreq}
    ...                                                          | wc -l
    ${cmd_mcshark}=   Catenate    cat ${pcapprocessed_CatMInfo_CPRT_path} | grep itf_l2_ps_cell_CellSetupReq |
    ...                              grep -o ${ValueToCheckIn_cellsetupreq_mcshark} | wc -l

    ${CatM_count}=   Run    ${cmd}
    Should Be Equal As Integers    ${CatM_count}    ${2}
    ...                                         actLteNrDssLteCatM or actRateMatchedCsiIm not activated in itf_l2_ps_cell_CellSetupReq as expected


Check actLteNrDssFastAlloc in cellSetupreq Pcap
    [Arguments]                     ${pcapFile}
    [Documentation]                 Check actLteNrDssFastAlloc from CPRT -> L2PS in GNB_CPRT_NODE Pcap

    Dated log                   Checking actLteNrDssFastAlloc inside PCAP file    ${pcapFile}
    Dated log                   ---Checking actLteNrDssFastAlloc in itf_l2_ps_cell_cellsetupreq
    # 2022-06-01 : csamson, need to change itf value to check
    # ${ValueToCheckIn_cellsetupreq}=   Set Variable If   "${param.scfFile.nrdsslte.actLteNrDssFastAlloc}"=="true"     0x00000001    0x00000000
    ${ValueToCheckIn_cellsetupreq}=   Set Variable If   "${param.scfFile.nrdsslte.actLteNrDssFastAlloc}"=="true"     0x01    0x00
    ${ValueToCheckIn_cellsetupreq_mcshark}=   Set Variable If   "${param.scfFile.nrdsslte.actLteNrDssFastAlloc}"=="true"   1    0
    ${ValueToCheckIn_cellsetupreq}=    Set Variable If   '${mcshark_present}'=='${True}'   ${ValueToCheckIn_cellsetupreq_mcshark}
    ...                                                                                    ${ValueToCheckIn_cellsetupreq}

    set test variable    ${pcapprocessed_DssFastAlloc_CPRT}    pcapprocessed_DssFastAlloc_CPRT.txt
    set test variable    ${pcapprocessed_DssFastAlloc_CPRT_path}    ${LOG_PATH}/${pcapprocessed_DssFastAlloc_CPRT}
    ${cmd1}=    Set Variable If   '${mcshark_present}'=='${False}'   tshark -X lua_script:/opt/luashark/generated_luashark/luashark.lua
    ...                                                              tshark
    ${cmd}    catenate      ${cmd1} -r
    ...        ${pcapFile} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e itf_l2_ps_cell_CellSetupReq.dss.actLteNrDssFastAlloc
    ...           -E header=y -E separator=';' > ${pcapprocessed_DssFastAlloc_CPRT_path}
    ${cmd_mcshark}    Catenate      ${cmd1} -r
    ...        ${pcapFile} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e itf_l2_ps_DynamicSpectrumSharing.actLteNrDssFastAlloc
    ...           -E header=y -E separator=';' > ${pcapprocessed_DssFastAlloc_CPRT_path}
    run Keyword if    '${mcshark_present}'=='${False}'   Run       ${cmd}
    ...  ELSE                                            Run       ${cmd_mcshark}

    ${pattern}=     set variable if   '${mcshark_present}'=='${False}'    ICOM_5G/itf_l2_ps_cell_CellSetupReq
    ...                                                                   itf_l2_ps_cell_CellSetupReq
    ${extract}   OperatingSystem.grep file        ${pcapprocessed_DssFastAlloc_CPRT_path}   ${pattern}
    run keyword if  len($extract)==0     fail   ${pattern} not found
    ${cmd}=   Catenate    cat ${pcapprocessed_DssFastAlloc_CPRT_path} | grep ${pattern}
    ...                             | grep -o ${ValueToCheckIn_cellsetupreq} | wc -l
    ${DssFastAlloc_count}       Run    ${cmd}
    Should Be Equal As Integers    ${DssFastAlloc_count}    ${1}
    ...                                         actLteNrDssFastAlloc not activated in itf_l2_ps_cell_CellSetupReq as expected


Check actLteNrDssFastAlloc in cellSetupreq Pcap from Pdml
    [Arguments]                     ${pdmlFile}
    [Documentation]                 Check actLteNrDssFastAlloc from CPRT -> L2PS in GNB_CPRT_NODE Pcap

    Dated log                   Checking actLteNrDssFastAlloc inside PDML file    ${pdmlFile}
    Dated log                   ---Checking actLteNrDssFastAlloc in itf_l2_ps_cell_cellsetupreq
    # 2022-06-01 : csamson, Need to change itf value to check
    # ${ValueToCheckIn_cellsetupreq}=   Set Variable If   "${param.scfFile.nrdsslte.actLteNrDssFastAlloc}"=="true"     0x00000001    0x00000000
    ${ValueToCheckIn_cellsetupreq}=   Set Variable If   "${param.scfFile.nrdsslte.actLteNrDssFastAlloc}"=="true"     0x01    0x00
    analyzer.check_exists_once             pdmlFile=${pdmlFile}
    ...                             packetName=itf_l2_ps_cell_cellsetupreq
    ...                             path=.*actLteNrDssFastAlloc$
    ...                             value=${ValueToCheckIn_cellsetupreq}
    Dated log                   ---Checking dlResourceSharingAlgo in itf_l2_ps_cell_dsscellcrmclientcfgreq
    ${ValueToCheckIn_dsscellcrmclientcfgreq}=  Set Variable If  "${param.scfFile.lteNrDssDlRatio.dlResourceSharingAlgo}"=="DL buffer level based"
    ...                                                                                                                          01   02
    analyzer.check_exists_once             pdmlFile=${pdmlFile}
    ...                             packetName=itf_l2_ps_cell_dsscellcrmclientcfgreq
    ...                             path=.*dlResourceSharingAlgo$
    ...                             kind="value"
    ...                             value=${ValueToCheckIn_dsscellcrmclientcfgreq}
    ...                             startPacket=${1}
    ...                             endPacket=${-1}

