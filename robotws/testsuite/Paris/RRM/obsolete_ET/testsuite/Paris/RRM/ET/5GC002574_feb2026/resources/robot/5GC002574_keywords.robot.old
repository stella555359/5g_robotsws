Stop Backhaul trace capture
    [Arguments]  ${s1x2_logs_collector_name}
    ${path_to_tcpdump}=    run Keyword  tcpdump.Stop Tcpdump on TestPc with options
    ...  collector=${backhaul_collector}
    ...  target_dir=${testCaseDir}/${s1x2_logs_collector_name}


Stop Backhaul gNB trace capture
    [Arguments]  ${bh_trace_collector_name}
    ${path_to_tcpdump}=    run Keyword  tcpdump.Stop Tcpdump on TestPc with options
    ...  collector=${backhaul_gnb_collector}
    ...  target_dir=${testCaseDir}/${bh_trace_collector_name}


Start/Stop BIP/backaul Traces
    [Arguments]  ${call_location}  ${collector_name}
    ${status}  ${message}=   Run Keyword And Ignore Error      Variable Should Exist     ${collector_name}
    ${collector_name}=      set Variable if    '${status}'=='FAIL'    FDD_DSS_default_scenario    ${collector_name}
    ${bip_start_point}=     set variable      ${start_end_trace_point['get_biptrace_start_point']}
    ${bip_stop_point}=      set variable      ${start_end_trace_point['get_biptrace_stop_point']}
    ${backaul_start_point}=  set variable     ${start_end_trace_point['get_backhaul_start_point']}
    ${backaul_stop_point}=   set variable     ${start_end_trace_point['get_backhaul_stop_point']}
    ${bip_trace_collector_name}=  Set Variable  l1_l2_${collector_name}
    ${bip_trace_stop_points}=  Create List  failed_attach  ${bip_stop_point}
    ${backaul_stop_point}=  Create List  failed_attach  ${backaul_stop_point}
    ${bh_trace_collector_name}=  Set Variable  backhaul_${collector_name}
    Run Keyword if  "${call_location}"=="${backaul_start_point}"
    ...      5GC002574_keywords.Start Backhaul Traces  bh_trace_collector_name=${bh_trace_collector_name}
    Run Keyword if  "${call_location}"=="${bip_start_point}"
    ...      5GC002574_keywords.Start L1_L2 Traces  bip_trace_collector_name=${bip_trace_collector_name}
    ${STOP_BIP_TRACES}=  Run Keyword and return status
    ...  List Should Contain Value  ${bip_trace_stop_points}  ${call_location}
    ${STOP_BH_TRACES}=  Run Keyword and return status
    ...  List Should Contain Value  ${backaul_stop_point}  ${call_location}
    5GC002574_keywords.Stop BIP Traces  ${STOP_BIP_TRACES}   ${bip_trace_collector_name}    ${0}  ${0}
    5GC002574_keywords.Stop BH Traces  ${STOP_BH_TRACES}  ${bh_trace_collector_name}

Get TTI traces
    [Arguments]     ${time}=1s
    Dated Log         Start TTI Traces in Streaming Mode
    ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traced Sleep    ${time}      msg=Waiting for TTI Traces
    Dated log         Stop TTI Traces in Streaming Mode...
    ${tti_trace_path}=     ttitrace.Stop TTI Traces in Streaming Mode      tti_trace_path=${testCaseDir}
    Dated log         Decode TTI Traces...
    nps_ttitraces_tools.decode_tti_traces_using_TtitraceReaderEvtDec    desired_storage_directory=${testCaseDir}    num_of_events=10000
    Dated log         Convert TTI trace from pcap to excelCsv...
    Run keyword and continue on failure    ttitrace.Convert TTI trace from pcap to excelCsv     input_file_path=${tti_trace_path}
    ...                                                                                         output_file_path=${testCaseDir}

Get TTI traces wo decoding
    [Arguments]     ${time}=1s
    Dated Log         Start TTI Traces in Streaming Mode
    ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traced Sleep    ${time}      msg=Waiting for TTI Traces
    Dated log         Stop TTI Traces in Streaming Mode...
    ${tti_trace_path}=     ttitrace.Stop TTI Traces in Streaming Mode     tti_trace_path=${testCaseDir}
    [Return]      ${tti_trace_path}

Decode TTI traces
    [Arguments]     ${tti_trace_path}     ${event_nr_max}=10000
    Dated log         Decode TTI Traces...
    # nps_ttitraces_tools.decode tti traces       desired_storage_directory=${testCaseDir}     num_of_events=${event_nr_max}
    nps_ttitraces_tools.decode_tti_traces_using_TtitraceReaderEvtDec    desired_storage_directory=${testCaseDir}    num_of_events=${event_nr_max}
    Dated log         Convert TTI trace from pcap to excelCsv...
    Run keyword and continue on failure    ttitrace.Convert TTI trace from pcap to excelCsv     input_file_path=${tti_trace_path}
    ...                                                                                         output_file_path=${testCaseDir}

################ END for traces purposes ##############

