#################################################################################################################################################
# 5g Call Setup
#################################################################################################################################################

DSS_5g_SA_UL_DL_Traffic to remove
   [Arguments]         ${param}      ${ul_rate}=15      ${dl_rate}=80    ${alias}=default
   Init Sequence       ${param}

   Step       5GC001586_Keywords.Start capture Bip and Xp for 1586     argument=ULDL_TPUT_BH_L1L2_BIP
   Step       Start Generating "${ul_rate}"mbps UL and "${dl_rate}"mbps DL Traffic for Ue="${Param.Context.UeId1}" on SA using alias "${alias}"
   Step       5GC001586_Keywords.Stop capture Bip and Xp for 1586      depends=5GC001586_Keywords.Start capture Bip and Xp for 1586
   Step       Display Ue Statistics       argument=${alias}

  #FTS this Display diagnosis lead to a failure => please keep in touch with AF team as Stepings rules are not used as usual
  #[Teardown]                      GenericTest.Display diagnosis

DSS_5g_Call_SA to remove
    [Arguments]                 ${alias}=default

    ${UeId}   set variable     ${Param.Context.UeId1}
    ${msg}=   Catenate    ***DSS ${Param.Context.DSS_Phase} 5gCAll SA [BW=${Param.seq.bandwidth},UeId=${UeId}] with alias=${alias}***
    Log to console   \n${blue}${msg} ${normal}

    5GC001586_Keywords.Set UE Parameters Before Register    ue_id=${UeId}    alias=${alias}
    5GC001586_Keywords.UE Register To GNB                   ue_id=${UeId}    alias=${alias}
    5GC001586_Keywords.UE PDU Session Setup                 ue_id=${UeId}    alias=${alias}

    log to console   \n${blue}***DSS SA 5gCall BW=${Param.seq.bandwidth} completed*** ${normal}

Set UE Parameters Before Register to remove
  [Arguments]  ${ue_id}=1  ${pdu}=1  ${alias}=default
  ${cmd}=    Catenate    set_pdu_param ue=${ue_id} pdu=${pdu} trf_type=internal
  Dated Log New Line       ${cmd}
  # csamson ; ${wtsObj} instead of wts
  # wts.execute egate command     cmd=${cmd}      alias=${alias}
  Call Method     ${wtsObj}   execute_egate_command     cmd=${cmd}      alias=${alias}

UE Register To GNB to remove
  [Arguments]  ${ue_id}=1  ${alias}=default
  # ${pattern}    Set Variable    UE now in NG RM Registered state
  ${pattern}    Set Variable    UE now in NG RM Registered
  ${ue_nr_capabilities}=   Catenate    SEPARATOR=   E1201000014F5E0302C003044009041B38987C283809B0083FF30C7942C0E09804062280C0298C00283E236B0C6D1D
  ...      262A08FE594932814105B260901831E31FF9863CA160703878089C02700040000000000841808DC9A1F00E41000000A41000002A41000004A494000069807C0DBCA9BC0
  ...      CADD200A0800004B29202000032CA480800014B29202000072CA4A0800024B292120000AA5949005D038BA551740E269544D2A88AEC40700F0034020100000010
  ${cmd}=    Catenate    ue_register id=${ue_id} ue_nr_capabilities=${ue_nr_capabilities}
  Dated Log New Line       ${cmd}
  # ${wtsObj.execute_egate_command_and_wait_for_data}     cmd=${cmd}   pass_regexp=${pattern}    timeout=30     alias=${alias}
  ${output}     Call Method     ${wtsObj}    execute_egate_command_and_wait_for_data     cmd=${cmd}   pass_regexp=${pattern}
  ...                                                                                    timeout=30     alias=${alias}
  # ${output}     wts.execute egate command And Wait For Data    cmd=${cmd}
  # ...                     pass_regexp=${pattern}    timeout=30     alias=${alias}
  ${output}    String.Get Lines Matching Regexp    ${output}    ${pattern}    partial_match=True
  Log To Console    \n${output}

UE PDU Session Setup to remove
  # [Arguments]  ${ue_id}=1  ${pdu}=1  ${gw}=1  ${fiveQi}=5  ${alias}=default
  [Arguments]  ${ue_id}=1  ${pdu}=1  ${gw}=1  ${fiveQi}=6  ${alias}=default
  ${pattern}    Set Variable    Initial Context Setup Successful for
  ${cmd}=    Catenate    ue_pdu_session_setup pdu=${pdu} ue=${ue_id} nwslice=1 gw=${gw}
  Dated Log New Line       ${cmd}
  ${output}    wts.execute egate command    cmd=${cmd}    pass_regexp=${pattern}    timeout=30     alias=${alias}
  ${output1}    String.Get Lines Matching Regexp    ${output}    ${pattern}    partial_match=True
  Log To Console    \n${output1}

# Start Generating ${ul_rate} mbps UL and ${dl_rate} mbps DL Traffic for Ue ${ue} on SA using alias ${alias}
#  Keyword with embedded arguments
Start tp remove Generating "${ul_rate}"mbps UL and "${dl_rate}"mbps DL Traffic for Ue="${Param.Context.UeId1}" on SA using alias "${alias}"
    # [Arguments]    ${dl_rate}=1    ${ul_rate}=1    ${ue}=1    ${bearer}=2
    # [Arguments]    ${alias}=default
    [Documentation]
    ...   Start generating Traffic for one UE. It is required to have attached UE and setup choosen bearer before.
    ...
    ...    :param dl_rate:  the volume of downlink traffic in megabits per second. Default value is 1mbit/s.
    ...    :param ul_rate:  the volume of uplink traffic in megabits per second. Default value is 1mbit/s.
    ...    :param ue: UE id
    ...
    ${pattern}    Set Variable    UDP DL TRF
    ${cmd}=     Catenate         trf_data_start ue=${Param.Context.UeId1} pdu=1 qfi=1 trf_id=1 mbps=${dl_rate} dir=dl
    ${output}      wts.execute egate command        cmd=${cmd}    pass_regexp=${pattern}    timeout=30    alias=${alias}
    ${output}         Get Lines Matching Regexp    ${output}     ${pattern}    partial_match=True
    Log to Console    ${output}
    ${pattern}    Set Variable    UDP UL TRF:
    ${cmd}=     Catenate         trf_data_start ue=${Param.Context.UeId1} pdu=1 qfi=1 trf_id=1 mbps=${ul_rate} dir=ul
    ${output}      wts.execute egate command        cmd=${cmd}    pass_regexp=${pattern}     timeout=30    alias=${alias}
    ${output}         Get Lines Matching Regexp    ${output}     ${pattern}    partial_match=True
    Log to Console    ${output}
    Log to Console     Started DL + UL Traffic for UE=${Param.Context.UeId1}

Stop Generating Traffic to remove
    [Arguments]    ${ue}=1    ${bearer}=2
    [Documentation]    Stop generating traffic for one UE
    ...    :param ue: UE id
    ...    :param bearer: configured bearer
    ...
    Log to Console    Stopping DL + UL Traffic...
    ${output}      wts.execute egate command        cmd=trf_data_stop ue=${ue} id=${bearer}
    # ${output}   wts.read_wtsemu_output_until_re    expected=Traffic was stopped   timeout=10
    # ${output}         Get Lines Matching Regexp    ${output}    Traffic was stopped   partial_match=${TRUE}

Display Qfi stats to remove
    [Arguments]    ${ue_id}=1     ${pdu_id}=1     ${qfi_id}=1    ${alias}=default
    ${cmd}=   Catenate       qfi_stats ue=${ue_id} pdu=${pdu_id} qfi=${qfi_id} trf_id=1 dir=bi
    ${output}    wts.execute egate command And Wait For Data     cmd=${cmd}    alias=${alias}
    Log to Console    ${output}

Display Ue Statistics to remove
    # [Arguments]     ${ue_id}=1     ${pdu_id}=1     ${qfi_id}=1     ${alias}=default
    [Arguments]     ${alias}=default
    Display Qfi stats    ue_id=${Param.Context.UeId1}    alias=${alias}
    ${cmd}=   Catenate     uec_stats display type=cell_data_pdcp enb=${Param.Context.gNBId} cell=1 format=short
    ${output}    wts.execute egate command And Wait For Data     cmd=${cmd}      alias=${alias}
    Log to Console    ${output}

Test SgNB Addition PRACH
    ${capture_path}      CallSetup.SgNB Addition to ENB          ueSetting=${UE_SIMPLE_CellDSS}
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${capture_path}
    Run Keyword And Ignore Error    OperatingSystem.Copy File    ${capture_path}    ${testCaseDir}
    Run Keyword And Ignore Error    common_Dss_SA_NSA.Read WTS Output For Pattern And Print matching Lines    ${UE_attach_pattern}   ${Timeout_NSA}

Check numOfPrb on uldata_pushreceivereq for DSS

    [Documentation]                 Retrieve from pdml value of numOfPrb
    ...                            from message uldata_puschreceivereq and check prb allocation conditions.
    [Arguments]                     ${pdmlFile}       ${NbrOfPRBToCheck}=0x00000023

    # 0x00000023 (35 PRBs) is for UL ratio = 70 % with DSS BW=10MHz
    ${NbOK}                    Evaluate     0
    ${NbKO}                    Evaluate     0
    Set Suite Variable              ${NbOK}
    Set Suite Variable              ${NbKO}

    # 1 - Retrieve from pdml all pucchReceiveReq
    Dated log                       \tGetting all uldata_puschreceivereq
    @{listAllPuschReq}              analyzer.get_match_from_paths
    ...                             pdmlFile=${pdmlFile}
    ...                             packetName=uldata_puschreceivereq
    ...                             pathList=${FIELDS_PUSCHreceivereq}
    ${lenPuschReq}                  get length                          ${listAllPuschReq}
    Dated log                       \tNB of uldata_puschreceivereq:${lenPuschReq}
    # 2 - For each puschReq, find corresponding puschResp (same numOfPrb)
    FOR    ${packet}       IN          @{listAllPuschReq}

    #       Retrieve numOfPrb  for current pucchReq
             ${numOfPrb}            Get Value In Packet Match
             ...                    packetMatch=${packet}
             ...                    field=numOfPrb
     # \       Dated log                 numOfPrb:${numOfPrb}
         ${comp}                     compareInDecimal   ${numOfPrb}   ${NbrOfPRBToCheck}
          Run Keyword If    ('${comp}'!='True')
          ...   New Case KO
    # \    Run Keyword If   ('${numOfPrb}'!='${NbrOfPRBToCheck}' )          #35 PRBs

    END
    ${PASSED_1}    Evaluate        (round(${NbKO})*100)/round(${lenPuschReq})

    ${PASSED}             Convert to Number        ${PASSED_1}      2
    Dated log              \t%nrOf_KO [numOfPrb!=${NbrOfPRBToCheck}]:${PASSED}%
    # Should Be Equal    ${PASSED}          ${0}
    # adaptaion needed because of long PUCCH activated by default
    # for ex : for  10MHz with DL pattern allocation received from CRM with StartPRB=4 and NbrPRB=35 for 70% DL ratio, startPrb=12 and so NbrPRB=27
    # with slot period=30ms because of long PUCCH
    # Criteria should be : NbrPRB_CRM  - (startPrb_uldata_puschreceivereq - StartPRB_CRM) == NbrPRB_uldata_puschreceivereq for every slots
    ${is_nbr_KO_as_expected}    evaluate    ${0.0} <= ${PASSED_1} <= ${10.0}
    Run Keyword If                  '${is_nbr_KO_as_expected}'=='True'
    ...    Log to Console            \t${green} Average Nbr numOfPrb!=${NbrOfPRBToCheck} REACHED: expected = 0 % , current = ${PASSED} % ${normal}
    ...    ELSE
    ...    Log to Console            \t${red} Average Nbr numOfPrb!=${NbrOfPRBToCheck} NOT REACHED: expected = 0 %, current = ${PASSED} % ${normal}
    should be true    '${is_nbr_KO_as_expected}'=='True'    nrOf_KO is not as expected!


Check startPrb on uldata_pushreceivereq for DSS

    [Documentation]                 Retrieve from pdml value of startPrb
     ...                            from message uldata_puschreceivereq and check prb allocation conditions.
    [Arguments]                     ${pdmlFile}       ${startPrbToCheck}=0x00000004

    # 0x00000004 as msg1StartFrequency = 4 into scf
    ${NbOK}                  Evaluate    0
    ${NbKO}                  Evaluate    0
    Set Suite Variable              ${NbOK}
    Set Suite Variable              ${NbKO}

    # 1 - Retrieve from pdml all pucchReceiveReq
    Dated log                       \tGetting all uldata_puschreceivereq
    @{listAllPuschReq}              analyzer.get_match_from_paths
    ...                             pdmlFile=${pdmlFile}
    ...                             packetName=uldata_puschreceivereq
    ...                             pathList=${FIELDS_PUSCHreceivereq}
    ${lenPuschReq}                  get length                          ${listAllPuschReq}
    Dated log                       \tNB of uldata_puschreceivereq:${lenPuschReq}
    # 2 - For each puschReq, find corresponding puschResp (same startPrb)
    FOR    ${packet}       IN          @{listAllPuschReq}

    #       Retrieve startPrb  for current pucchReq
             ${startPrb}            Get Value In Packet Match
             ...                    packetMatch=${packet}
             ...                    field=startPrb
    #  \       Dated log                 startPrb:${startPrb}
         ${comp}                     compareInDecimal   ${startPrb}   ${startPrbToCheck}
          Run Keyword If    ('${comp}'!='True')
          ...   New Case KO
    #  \    Run Keyword If   ('${startPrb}'!='${startPrbToCheck}' )          #4
    END
    ${PASSED_1}    Evaluate        (round(${NbKO})*100)/round(${lenPuschReq})
    ${PASSED}             Convert to Number        ${PASSED_1}      2
    Dated log              \t%nrOf_KO [startPrb!=${startPrbToCheck}]:${PASSED}%
    # Should Be Equal    ${PASSED}          ${0}
    # adaptaion needed because of long PUCCH activated by default
    # for ex : for  10MHz with DL pattern allocation received from CRM with StartPRB=4 and NbrPRB=35 for 70% DL ratio, startPrb=12 and so NbrPRB=27
    # with slot period=30ms because of long PUCCH
    # Criteria should be : NbrPRB_CRM  - (startPrb_uldata_puschreceivereq - StartPRB_CRM) == NbrPRB_uldata_puschreceivereq for every slots
    ${is_nbr_KO_as_expected}    evaluate    ${0.0} <= ${PASSED_1} <= ${10.0}
    Run Keyword If                  '${is_nbr_KO_as_expected}'=='True'
    ...    Log to Console            \t${green} Average startPrb!=${startPrbToCheck} REACHED: expected = 0 % , current = ${PASSED} % ${normal}
    ...    ELSE
    ...    Log to Console            \t${red} Average startPrb!=${startPrbToCheck} NOT REACHED: expected = 0 %, current = ${PASSED} % ${normal}
    should be true    '${is_nbr_KO_as_expected}'=='True'    nrOf_KO is not as expected!

DTX calcul for DSS
    [Documentation]                 Find the corresponding uldata_pucchreceiverespharqd
    ...                             check the format and dtx
    ...                             calculate the ratio of dtx in function of total number of uldata_pucchreceiverespharqd msgs
    [Arguments]                         ${pucchFormatInput}
    ...                                 ${pdmlFile}
    # 1 - Retrieve from pdml all uldata_pucchreceiverespharqd
    Dated log new line                  Getting all uldata_pucchreceiverespharqd
    @{listAllPucchRespHarqD}            analyzer.get_match_from_paths
    ...                                 pdmlFile=${pdmlFile}
    ...                                 packetName=uldata_pucchreceiverespharqd
    ...                                 pathList=${FIELDS_DTX}
    ${lenPucchRespHarqD}                get length                                          ${listAllPucchRespHarqD}
    Dated Log New Line                  Total number of PucchRespHarqD msgs: ${lenPucchRespHarqD}
    ${counterDtx}                       Set Variable                                        ${0}
    FOR    ${packet}   IN              @{listAllPucchRespHarqD}
    #       Retrieve pucchFormat and dtx for current PucchRespHarqD
                ${pucchFormat}              Get Value In Packet Match
                ...                         packetMatch=${packet}
                ...                         field=pucchFormat
                ${dtx}                      Get Value In Packet Match
                ...                         packetMatch=${packet}
                ...                         field=dtx
                Run Keyword If              ('${pucchFormat}'=='${pucchFormatInput}' and '${dtx}'!='0')
                ...                         Increment counter for dtx                       counterDtx=${counterDtx}
    END
    Dated log                           pucchFormat:${pucchFormatInput}                          number of DTX:${counterDtx}
    ${nonDtx}                           evaluate                                            (${lenPucchRespHarqD}-${counterDtx})
    Dated log                           number of NON-DTX:${nonDtx}
    ${ratioOfDtx}                       Run Keyword if                      ${lenPucchRespHarqD} > 0
    ...                                 Percentage DTX                  ${lenPucchRespHarqD}     ${counterDtx}
    ...                                 ELSE
    ...                                 Dated log                THERE IS NO TRAFFIC !!!!
    Run keyword if                      ${ratioOfDtx}==${0}                                 New Case OK
    [Return]                            ${ratioOfDtx}

Percentage DTX for DSS
    [Arguments]                         ${totalPucchRespHarqD}
    ...                                 ${totalDtx}
    ${ratioOfDtx}                       Evaluate                                            (round(${totalDtx})/round(${totalPucchRespHarqD}))*100
    ${ratioOfDtx}=                      convert to number                                   ${ratioOfDtx}       1
    ${totalPercentage}                  Set Variable                                        100
    ${rationNonTdx}                     Evaluate                                            ${totalPercentage}-${ratioOfDtx}
    Dated log                           DTX=${ratioOfDtx}%    NonDtx=
    [Return]                            ${ratioOfDtx}


Increment counter for dtx
    [Arguments]                         ${counterDtx}
    ${counterDtx}                       evaluate                                            ${counterDtx}+1
    set suite variable                  ${counterDtx}

New Case OK
    ${NbOK}                         Evaluate                            ${NbOK}+1
    Set Suite Variable              ${NbOK}

New Case KO
    ${NbKO}                         Evaluate                            ${NbKO}+1
    Set Suite Variable              ${NbKO}

New Case NONE
    ${NbNone}                       Evaluate                            ${NbNone}+1
    Set Suite Variable              ${NbNone}

Check UL Qos Load Indication MeasuredNgbrNnbrLoad
    [Arguments]    ${pdmlFile}   ${value}=00    ${remove_zero_value}=True   ${with_verdict}=True

    ${ul_ratio_to_check_hex}=    Convert to Hex     ${value}
    ${cmd}=    Catenate     cat ${pdmlFile} | grep -i 'enDssUlQosLoadMeasurement.MeasuredNgbrNnbrLoad' |
    ...                grep 'MeasuredNgbrNnbrLoad (Uint8)' | awk '{print $9}' | sed -e 's/value="//g' | sed -e 's/"/ /g' | awk '{print $1}'
    ${MeasuredNgbrNnbrLoad}=    OperatingSystem.Run    ${cmd}
    @{lines}    Split To Lines    ${MeasuredNgbrNnbrLoad}
    Run Keyword If   '${remove_zero_value}' == 'True'       Remove Values From List     ${lines}     00
    ${length}=    get length     ${lines}
    @{MeasuredNgbrNnbrLoad}    Evaluate    map(lambda x: int(x, 16), @{lines})
    Dated log   UL Qos MeasuredNgbrNnbrLoad = @{MeasuredNgbrNnbrLoad} and length = ${length}
    ${avg_ul_MeasuredNgbrNnbrLoad}    Evaluate    round(round(sum(@{MeasuredNgbrNnbrLoad}), 1)/round(${length}, 1), 1)

    Log many          [DATA TRANSFER] enDssUlQosLoadMeasurement MeasuredNgbrNnbrLoad average: ${avg_ul_MeasuredNgbrNnbrLoad}
    Log To Console    \t\t\tUplink enDssUlQosLoadMeasurement.MeasuredNgbrNnbrLoad Avg:\t\t ${avg_ul_MeasuredNgbrNnbrLoad} %

    # 2 % tolerance
    ${min}=                         Evaluate                                ${value} * (100 - 2) / 100
    ${max}=                         Evaluate                                ${value} * (100 + 2) / 100
    ${status}=                      Evaluate                                ${min} <= ${avg_ul_MeasuredNgbrNnbrLoad} <= ${max}
    Run Keyword If                  '${status}'=='True'
    ...    Dated Log                Average UL DSS Ratio REACHED: expected = ${value} % , current = ${avg_ul_MeasuredNgbrNnbrLoad}
    ...    ELSE
    ...    Dated Log                Average UL DSS RATIO NOT REACHED: expected = ${value} %, current = ${avg_ul_MeasuredNgbrNnbrLoad}
    Run Keyword If                  '${status}'!='True' and '${with_verdict}'=='True'                     Fail    UL DSS Ratio

    ${cmd}=    Catenate    grep -n -i enDssUlQosLoadMeasurement.MeasuredNgbrNnbrLoad ${pdmlFile} |
    ...                      grep -n -i 'value="${ul_ratio_to_check_hex}"' |
    ...                      wc -l > ${LOG_PATH}/nbr_enDssUlQosLoadIndMeasuredNgbrNnbrLoad_parsed_${TEST_NAME}.txt
    OperatingSystem.Run     ${cmd}
    ${output_ul}    OperatingSystem.Run     cat ${LOG_PATH}/nbr_enDssUlQosLoadIndMeasuredNgbrNnbrLoad_parsed_${TEST_NAME}.txt
    # Run Keyword If     '${with_verdict}'=='True'      Should Be True    (${output_ul}>20)
    [Return]     ${avg_ul_MeasuredNgbrNnbrLoad}

