Collect gNB Logs
    Log many     collect all log ${TEST NAME}
    ${tm}    Get Current Date
    ${tm}=    Remove String    ${tm.replace(' ','-')}    .    :
    ${gNB_logName}=    catenate    SEPARATOR=_    ${TEST NAME[0:30].replace(" ", "_").replace("(", "").replace(")", "")}   gNB-${tm}.log
    Run Keyword And Ignore Error    5GC001586_Keywords.LogCollector   ${gNB_logName}
    # 29/07/2021 : dont reset cache here (before teardown), if not , stop the wtsemu process fails
    # Conn.ResetCache

Collect AirPhone Logs
    return from Keyword if   '${GNB_DU.sys[0].M.boardType}'!='ASIK'
    Log many     collect all log ${TEST NAME}
    ${tm}    Get Current Date
    ${tm}=    Remove String    ${tm.replace(' ','-')}    .    :
    ${AirP_logName}=    catenate    SEPARATOR=_    ${TEST NAME[0:30].replace(" ", "_").replace("(", "").replace(")", "")}   AirP-${tm}.log
    Run Keyword And Ignore Error    5GC001586_Keywords.Airphone LogCollector   ${AirP_logName}
    # 29/07/2021 : dont reset cache here (before teardown), if not , stop the wtsemu process fails
    # Conn.ResetCache

Collect gNB snapshot via Aashell
   [Arguments]    ${location}=/ram   ${target_dir}=None

   ${local_target_dir}=    Run Keyword If    '${target_dir}'=='None'    common_Dss_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}

    ssh.Connect to    ${GNB_DU.sys[0].M.sshConnection.addr}
    ...               ${GNB_DU.sys[0].M.sshConnection.username}
    ...               ${GNB_DU.sys[0].M.sshConnection.password}
    ...                alias=ALIAS_GNB

# (echo "log -a -z snapshot.zip";sleep 50)|telnet 0 15007
# (echo "log -a -z snapshot.zip")|telnet 0 15007
    Conn.Execute  cmd=rm -f /ram/snapshot_gnb*.zip   alias=ALIAS_GNB
    # Conn.Execute  cmd=(echo "log -a -c full -z snapshot_gnb.zip"; sleep 50; echo "quit")|telnet 0 15007   alias=ALIAS_GNB
    Conn.Execute  cmd=echo "log -a -z /ram/snapshot_gnb.zip" | nc 0 15007   alias=ALIAS_GNB
    ${reply}    Conn.ReceiveUntil  match=AaShell>   alias=ALIAS_GNB
    # AaSysComUserDeregister succeed!
    ${timestamp}=    DateTime.Get Current Date    result_format=%Y%m%d-%H%M%S
    Conn.DownloadFile  local_path=${local_target_dir}/Aashell_snapshot_gnb_${timestamp}.zip
    ...                 remote_path=/ram/snapshot_gnb.zip   alias=ALIAS_GNB
    Conn.Disconnect  alias=ALIAS_GNB

LogCollector
    [Arguments]    ${logName}=gNB.log    ${location}=/ffs/run/logs    ${target_dir}=None
    return from keyword if    ${isAiC}
    ${local_target_dir}=    Run Keyword If    '${target_dir}'=='None'    common_Dss_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}

    ssh.Connect to    ${GNB_DU.sys[0].M.sshConnection.addr}
    ...               ${GNB_DU.sys[0].M.sshConnection.username}
    ...               ${GNB_DU.sys[0].M.sshConnection.password}
    ...                alias=ALIAS_GNB

    # /opt/trs/bin/trs-xpif-d execute dumpconfig
    Conn.Execute  cmd=rm -f /tmp/xpif.dump   alias=ALIAS_GNB
    Conn.Execute  cmd=/opt/trs/bin/trs-xpif-d execute dumpconfig     alias=ALIAS_GNB
    Conn.DownloadFile  local_path=${local_target_dir}/xpif.dump   remote_path=/tmp/xpif.dump   alias=ALIAS_GNB
    Run Keyword if   '${GNB_DU.sys[0].M.boardType}'!='ASIK'     Conn.Disconnect  alias=ALIAS_GNB
    return from Keyword if   '${GNB_DU.sys[0].M.boardType}'!='ASIK'
    Conn.Execute  cmd=rm -rf ${location}/*gNB*.log   alias=ALIAS_GNB
    Conn.Execute  cmd=rm -rf ${location}/*gNB*.log.tgz   alias=ALIAS_GNB
    Conn.Execute  cmd=/ffs/run/config/scripts/classicalbts_log_collector.sh -o ${location}/${logName}   alias=ALIAS_GNB
    Conn.Execute  cmd=tar czvf ${location}/${logName}.tgz ${location}/${logName}/  alias=ALIAS_GNB
    Conn.DownloadFile  local_path=${local_target_dir}${/}${logName}.tgz  remote_path=${location}/${logName}.tgz   alias=ALIAS_GNB
    Conn.Disconnect  alias=ALIAS_GNB

Airphone LogCollector
    [Arguments]    ${logName}=AirP.log    ${location}=/ffs/run/logs    ${target_dir}=None

    ${local_target_dir}=    Run Keyword If    '${target_dir}'=='None'    common_Dss_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}

    ssh.Connect to    ${AP_DU.sys[0].M.sshConnection.addr}
    ...               ${AP_DU.sys[0].M.sshConnection.username}
    ...               ${AP_DU.sys[0].M.sshConnection.password}
    ...                alias=ALIAS_GNB
    Conn.Execute  cmd=rm -rf ${location}/*AirP*.log   alias=ALIAS_GNB
    Conn.Execute  cmd=rm -rf ${location}/*AirP*.log.tgz   alias=ALIAS_GNB
    Conn.Execute  cmd=/ffs/run/config/scripts/classicalbts_log_collector.sh -o ${location}/${logName}   alias=ALIAS_GNB
    Conn.Execute  cmd=tar czvf ${location}/${logName}.tgz ${location}/${logName}/  alias=ALIAS_GNB
    Conn.DownloadFile  local_path=${local_target_dir}${/}${logName}.tgz  remote_path=${location}/${logName}.tgz   alias=ALIAS_GNB
    Conn.Disconnect  alias=ALIAS_GNB

Collect all logs
    [Documentation]      Get GNB Logs from Coam. Files are put inside testCaseDir directory
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    ${timestamp}=    DateTime.Get Current Date    result_format=%Y%m%d-%H%M%S
    ${scf}=    set variable  SCF_GNB_${timestamp}_${SUITE_NAME}_${TEST_NAME}_${TEST STATUS}.xml
    ${swconfig}=    set variable  swconfig_GNB_${timestamp}_${SUITE_NAME}_${TEST_NAME}_${TEST STATUS}.txt

    # Save current SCF file used during test cases
    ${current_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=${scf}
    Set Suite Variable              ${current_scf_file}
    Dated Log         Current 1586 SCF file stored to ${current_scf_file}
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${current_scf_file}    ${testCaseDir}

    # Get swconfig file that will be used during 1586 tests
    ${alias_gnb}                    SSH Wait For Connect                ${GNB_DU.sys[0].M}
    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${LOG_PATH}/${swconfig}
    ...                             connection=${alias_gnb}
    Dated Log                  Current 1586 swconfig file stored to ${LOG_PATH}/${swconfig}
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${LOG_PATH}/${swconfig}    ${testCaseDir}

    Run keyword if      "${TEST STATUS}" == "FAIL"    Dated Log          Collect AirPhone snapshot via Aashell...
    Run keyword if      "${TEST STATUS}" == "FAIL"    Collect AirPhone snapshot via Aashell

    Dated Log         Collect /ram/startup_l3.log from Airphone...
    Run keyword and Ignore error      5GC001586_Keywords.Get APL3 log from Airphone

    ${COLLECT_LOGS}           Set Variable if
    ...                       "${TEST STATUS}" == "FAIL" and "${EXCLUDE_LOGS_IF_FAIL}" == "0"
    ...                       1    ${COLLECT_LOGS}

    Return From Keyword If    "${COLLECT_LOGS}" == "0"

    # BTS snapshot.
    # defined into /ebs/xxxxxx/my_virtual_env/robotws5g/resources/sites/NPS/SWENG/robot/coam_gnb_classical.robot
    Dated Log New Line         Get gNB snapshot...
    ${status}   ${snapshot_path}    Run Keyword if  '${get_snapshot}' == '1'       5GC001586_Keywords.Get GNB Logs from Coam
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${snapshot_path}
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${snapshot_path}    ${testCaseDir}
    Dated Log     gNB snapshot ${snapshot_path} generated and copied into ${testCaseDir}

    Dated Log         Collect WTS logs...
    5GC001586_Keywords.Collect edaemon log files
    5GC001586_Keywords.Collect egate log files

    Dated Log         Collect Current swconfig from Airphone...
    5GC001586_Keywords.Store Current swconfig from Airphone

    Dated Log          Collect gNB Logs...
    5GC001586_Keywords.Collect gNB Logs

    Dated Log          Collect gNB snapshot via Aashell...
    5GC001586_Keywords.Collect gNB snapshot via Aashell

    Dated Log          Collect Airphone Logs...
    5GC001586_Keywords.Collect AirPhone Logs

Collect Logs
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}
    Run Keyword And Ignore Error         common_Dss_Keywords.Get testcase log directory
    Run Keyword And Ignore Error         common_Dss_Keywords.Collect all logs     ${alias}

Software Converter
    [Documentation]    Compatibility with KW: Check Current Software Version
    ...   param: ${input_version} put full or short software version name with dots or commas
    ...   param: ${manipulator} can increace or decrease number of software version
    [Arguments]    ${input_version}    ${manipulator}=0
    ${manipulator}    convert to integer    ${manipulator}
    ${input_version}    replace string   ${input_version}    .    _
    @{string_split}   split string    ${input_version}    _
    # to manage sw knife like 5G20A_GNB_0009_001800_000744_182cc_  ;  5G20A_GNB_0009_001800_000668_0ilsj_
    ${string_split2}     set variable    ${string_split[:5]}
    dated log         swversion split result=${string_split2}
    ${length_list}   get length    ${string_split2}
    @{sw_version}    create list
    @{reverse_list}    Evaluate    list(range(${length_list}-1, ${length_list}-4, -1))
    FOR    ${i}    IN    @{reverse_list}
         ${trunk}    get from list    ${string_split2}    ${i}
         ${trunk}    convert to integer    ${trunk}
         append to list    ${sw_version}    ${trunk}
    END
    ${master}    get from list    ${sw_version}    2
    ${stream}    get from list    ${sw_version}    1
    ${version}    get from list    ${sw_version}    0
    Set Suite Variable     ${convert_version}    ${master}.${stream}.${version+${manipulator}}
    Set Suite Variable     ${master_version}     ${master}
    [Return]    ${convert_version}   ${master_version}

Get Orignal Configuration 1586
   [Arguments]                   ${BACKUP_DIR}=original_config_files

    # Save current  SCF file
    ${file_name}   set variable     SCF_1586.xml
    ${original_scf_file}            OAM Get SCF File                file=${file_name}
    Set Suite Variable              ${original_scf_file}
    Dated Log New Line         Original SCF file stored to ${original_scf_file}
    Run keyword and Ignore error   OperatingSystem.Copy File    ${LOG_PATH}/${file_name}   ${LOG_PATH}/${BACKUP_DIR}/${file_name}

    # Get swconfig file that will be restored during test suite teardown
    ${status}    ${alias_gnb}        Run keyword and Ignore error        SSH Wait For Connect                ${GNB_DU.sys[0].M}
    Run keyword and Ignore error     csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${LOG_PATH}/swconfig_to_be_restored.txt
    ...                             connection=${alias_gnb}
    Dated Log                  Default swconfig file stored to ${LOG_PATH}/swconfig_to_be_restored.txt
    Run keyword and Ignore error   OperatingSystem.Copy File    ${LOG_PATH}/swconfig_to_be_restored.txt
    ...                                                         ${LOG_PATH}/${BACKUP_DIR}/swconfig_to_be_restored.txt

    # Get EPC file configuration:
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.download_file               remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${LOG_PATH}/basic_wts_to_be_restored.cfg
    ...                             connection=${alias_epc}
    Dated Log                  Default basic cfg file stored to ${LOG_PATH}/basic_wts_to_be_restored.cfg
    Run keyword and Ignore error    OperatingSystem.Copy File    ${LOG_PATH}/basic_wts_to_be_restored.cfg
    ...                                                          ${LOG_PATH}/${BACKUP_DIR}/basic_wts_to_be_restored.cfg

    ${file_name}   set variable     new_iphy_to_be_restored.xml
    Run keyword and Ignore error      Get iPhy.xml file from Airphone    target_dir=${LOG_PATH}    file_name=${file_name}
    Dated Log                  Default /ffs/run/simmode/new_iphy.xml from Airphone stored to ${LOG_PATH}/${file_name}
    Run keyword and Ignore error    OperatingSystem.Copy File    ${LOG_PATH}/${file_name}
    ...                                                          ${LOG_PATH}/${BACKUP_DIR}/${file_name}

    # Get AP configuration file
    ${ap_configfile}                Get XML AirPhoneConfig Path
    run Keyword if      '${ap_configfile}' != '${empty}'     csn.download_file          remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${LOG_PATH}/ApOamConfig_to_be_restored.xml
    ...                             connection=${alias_epc}
    Dated Log                  Default AP Oam Config file stored to ${LOG_PATH}/ApOamConfig_to_be_restored.xml
    Run keyword and Ignore error    OperatingSystem.Copy File    ${LOG_PATH}/ApOamConfig_to_be_restored.xml
    ...                                                          ${LOG_PATH}/${BACKUP_DIR}/ApOamConfig_to_be_restored.xml

Restore Orignal Configuration 1586

   # Get swconfig file that will be restored during test suite teardown
    ${status}   ${alias_gnb}       Run keyword and Ignore error         SSH Wait For Connect                ${GNB_DU.sys[0].M}
    Run keyword and Ignore error   csn.upload_file                 remote_path=${SWCONFIG_PATH}
    ...                                                            local_path=${LOG_PATH}/swconfig_to_be_restored.txt
    ...                                                            connection=${alias_gnb}

    Run keyword and Ignore error     SSH Exec                   command=crasign ${SWCONFIG_PATH}           alias=${alias_gnb}

    Dated Log                 swconfig file has been restored to default (${LOG_PATH}/swconfig_to_be_restored.txt)

    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.upload_file                 remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${LOG_PATH}/basic_wts_to_be_restored.cfg
    ...                             connection=${alias_epc}

    Dated Log                basic cfg file has been restored to default (${LOG_PATH}/basic_wts_to_be_restored.cfg)

    ${file_name}   set variable     new_iphy_to_be_restored.xml
    Run keyword and Ignore error      common_Dss_Keywords.Restore iPhy.xml file to Airphone    local_dir=${LOG_PATH}    file_name=${file_name}
    Dated Log            /ffs/run/simmode/new_iphy.xml has been restored with default ${LOG_PATH}/${file_name}

    ${ap_configfile}                Get XML AirPhoneConfig Path
    return from Keyword if     '${ap_configfile}'=='${EMPTY}'
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    run Keyword if      '${ap_configfile}' != '${empty}'     csn.upload_file         remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${LOG_PATH}/ApOamConfig_to_be_restored.xml
    ...                             connection=${alias_epc}

    Dated Log            ApOamConfig has been restored to default (${LOG_PATH}/ApOamConfig_to_be_restored.xml)

Install MCShark if Needed
    [Arguments]               ${current_sw_version}=None
    ${mcshark_present}  ${MCShark}=    pcap.Check MCShark if present
    ${logs_dir}=    run Keyword if   "${mcshark_present}"=="False"
    ...                        common_Dss_Keywords.Prepare Logs Directory Path   resultDir=${LOG_PATH}   subdir=install_Logs    with_timestamp=True
    ...   ELSE                 set variable    None
    run Keyword if   "${mcshark_present}"=="False"    pcap.Install wslte plugins for MCShark    sw_version=${current_sw_version}
    ...                                                                                         local_dir=${logs_dir}
    ...   ELSE     Dated log    wslte plugins for MCShark ${MCShark} already installed
    # update variable
    ${mcshark_present}   ${MCShark}=      pcap.Check MCShark if present
    ${msg}=   run Keyword if   "${mcshark_present}"=="True"    StringTool.getHeaderLine    MCShark plugin   ${MCShark}
    ...   ELSE                                        StringTool.getHeaderLine    MCShark plugin     Not installed
    run Keyword if   "${msg}"!="${EMPTY}"      Dated log      ${msg}
    set suite variable    ${mcshark_present}

set WS preference
    ${pref_items}=  set Variable   decode_as_entry: tcp.port,29211,(none),SYSCOM
    ${profile_name}=   pcap.wireshark.CreatePersonalConfProfile   pref_items=${pref_items}
    ...                                        profie_path=/home/ute/.config/wireshark/profiles
    ...                                        profile_name=customized_profile
    ...                                        filename=decode_as_entries
    Dated log    ${profile_name} created or updated with ${pref_items} ...
    ${profile_name}=   pcap.wireshark.CreatePersonalConfProfile   pref_items=${pref_items}
    ...                                        profie_path=/home/ute/.config
    ...                                        profile_name=wireshark
    ...                                        filename=decode_as_entries
    Dated log    ${profile_name} created or updated with ${pref_items} ...

Test Suite Setup for 1586
    [Documentation]          Test suite setup for all 1586 TCs.
    ...                      It calls Test Suite Setup common KW and:
    ...                      Saves existing configuration files (swconfig + WTS)
    ...                      Configure common SCF parameters
    ...                      Configure common swconfig parameters
    ...                      Configure common WTS parameters
    [Arguments]               ${default_mcs}=0

    # Call to generic test suite setup KW
    setup.Suite Setup

    # 5GC001586_Keywords.Initialize Colors

    MyConstants.hello
    ${mcshark_present}   ${MCShark}=      pcap.Check MCShark if present
    ${msg}=   run Keyword if   "${mcshark_present}"=="True"    StringTool.getHeaderLine    MCShark plugin   ${MCShark}
    ...   ELSE                                        StringTool.getHeaderLine    MCShark plugin     Not installed
    run Keyword if   "${msg}"!="${EMPTY}"      Dated log      ${msg}
    set suite variable    ${mcshark_present}
    Dated Log New Line    COLLECT_LOGS if TEST STATUS is FAIL and EXCLUDE_LOGS_IF_FAIL == 0
    Dated Log             COLLECT_LOGS if COLLECT_LOGS == 1
    Dated log             default_test_strategy : WAIT_5G_CELL_ONAIR = ${WAIT_5G_CELL_ONAIR}
    Dated log             default_test_strategy : W_AP_UDPLOG = ${W_AP_UDPLOG}
    Dated Log             default_test_strategy : SHOULD_BE_COMMISSIONED_GNB_FIRST = ${SHOULD_BE_COMMISSIONED_GNB_FIRST}
    Dated log             default_test_strategy : SHOULD_UPDATE_SCF_AND_RAD = ${SHOULD_UPDATE_SCF_AND_RAD}
    Dated log             default_test_strategy : SHOULD_UPDATE_RAD = ${SHOULD_UPDATE_RAD}
    Dated log             default_test_strategy : CELLSETUP_SHOULD_BE_CHECK = ${CELLSETUP_SHOULD_BE_CHECK}
    Dated log             default_test_strategy : UL_TPUT_SHOULD_BE_CHECK = ${UL_TPUT_SHOULD_BE_CHECK}
    Dated log             default_test_strategy : SHOULD_BE_RECOMMISSIONED_GNB = ${SHOULD_BE_RECOMMISSIONED_GNB}
    Dated log             default_test_strategy : COLLECT_LOGS = ${COLLECT_LOGS}
    Dated log             default_test_strategy : EXCLUDE_LOGS_IF_FAIL = ${EXCLUDE_LOGS_IF_FAIL}
    Dated log             default_test_strategy : PCAP_XP_BIP_L1L2_ATTACH = ${PCAP_XP_BIP_L1L2_ATTACH}
    Dated log             default_test_strategy : REMOVE_PDML_FILE_END_TEST_SUITE = ${REMOVE_PDML_FILE_END_TEST_SUITE}
    Dated log             default_test_strategy : TRAFFIC_DL_RATE = ${TRAFFIC_DL_RATE}
    Dated log             default_test_strategy : TRAFFIC_UL_RATE = ${TRAFFIC_UL_RATE}
    Dated log             default_test_strategy : UL_DL_TPUT_CHECK_BASED_AASYSLOG = ${UL_DL_TPUT_CHECK_BASED_AASYSLOG}
    Dated log             default_test_strategy : UL_TPUT_CHECK_BASED_TTITRACE = ${UL_TPUT_CHECK_BASED_TTITRACE}
    Dated log             default_test_strategy : WITH_UPLOAD_1586_CONFIGURATION = ${WITH_UPLOAD_1586_CONFIGURATION}
    Dated log             default_test_strategy : WITH_MCSHARK_INSTALLATION = ${WITH_MCSHARK}
    Dated log             default_test_strategy : SharkTool = ${SharkTool}

    common_Dss_Keywords.gNB BackupSCF
    common_Dss_Keywords.Create Test Suite Folder
    common_Dss_Keywords.Clean Old WTS Logs
    common_Dss_Keywords.Get Testline Name
    run keyword and ignore error     5GC001586_Keywords.Get Orignal Configuration 1586
    robot_extension.Run Keyword And Warn On Failure    5GC001586_Keywords.Init Trace color
    common_Dss_Keywords.Connect to COAM ADMIN

    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable              ${test_scf_file}
    ${nodeType}=     set variable if   ${isAic}     Vdu
    ...                                             Classical
    ${cellDepType}=   5GC001586_Kw_TestSetup.get cellDepType from SCF    nodeType=${nodeType}
    ${TestDSS10Mhz_1586_M1.Context.cellDepType}      set variable    ${cellDepType}
    # the scope of 1586 is NSA gNB configuration
    # run Keyword if    '${TestDSS10Mhz_1586_M1.Context.cellDepType}' == 'SA+NSA'
    # ...                                         5GC001586_Kw_TestSetup.update eNbId and gNBId In Context   ${TestDSS10Mhz_1586_M1}   2   1
    # manage only NSA gNB configuration case for the moment => the scope of 1586 is NSA gNB configuration
    # => update here needed to update UE_SIMPLE_CellDSS above, BEWARE that at this moment , cellDepType is still SA+NSA configured
    # the SCF modifications from SA+NSA to NSA is managed in Kw "Test Line Preparation for NSA Only" which is called later !!!
    5GC001586_Kw_TestSetup.update eNbId and gNBId In Context   ${TestDSS10Mhz_1586_M1}   1   2
    ${TestDSS10Mhz_1586_M1.scfFile.nrdsslte.eNodeBId}    set variable     ${TestDSS10Mhz_1586_M1.Context.eNBId}

    # SCF.xml is used by procedure verifyFeatureActivation
    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable              ${test_scf_file}
    Dated Log                  Current 1586 SCF file stored to ${test_scf_file}

    Run Keyword If   '${WITH_UPLOAD_1586_CONFIGURATION}' == '0'     run Keyword
    ...            5GC001586_Kw_TestSetup.Update SpecificParameters to setup DSS configuration In WTS Cfg File    ${TestDSS10Mhz_1586_M1}

    # &{UE_SIMPLE_CellDSS}                ue=1                                    profile=1
    # ...                                 bearer=2                                testMode=False
    # ...                                 trf_id=1                                burst=${None}
    # ...                                 throughput=${DEFAUT_THROUGHPUT}         testModeValue=csi_report_override
    # ...                                 target_gnb=2                            target_cells=1

    #define UE profile for Mono-Ue tests (cell-2.1)
    ${UE_SIMPLE_CellDSS}                 Tools.Dictionary Get              ${UE_SIMPLE}
    ${UE_SIMPLE_CellDSS.target_gnb}      set Variable          ${TestDSS10Mhz_1586_M1.Context.gNBId}
    ${UE_SIMPLE_CellDSS.target_cells}    set Variable          1
    ${UE_SIMPLE_CellDSS.ue}              set Variable          ${TestDSS10Mhz_1586_M1.Context.UeId1}
    Set Suite Variable              ${UE_SIMPLE_CellDSS}

    #define UE profiles for MUE tests
    ${UE_PROFILE1}         Tools.Dictionary Get       ${UE_SIMPLE}
    ${UE_PROFILE1.target_gnb}        set Variable      ${TestDSS10Mhz_1586_M1.Context.gNBId}
    ${UE_PROFILE1.target_cells}      set Variable      1
    Set To Dictionary     ${UE_PROFILE1}      ue       ${TestDSS10Mhz_1586_M1.Context.UeId1}
    ${UE_PROFILE2}         Tools.Dictionary Get        ${UE_SIMPLE}
    ${UE_PROFILE2.target_gnb}        set Variable      ${TestDSS10Mhz_1586_M1.Context.gNBId}
    ${UE_PROFILE2.target_cells}      set Variable      1
    Set To Dictionary     ${UE_PROFILE2}      ue       ${TestDSS10Mhz_1586_M1.Context.UeId2}
    ${UE_PROFILE3}         Tools.Dictionary Get        ${UE_SIMPLE}
    ${UE_PROFILE3.target_gnb}        set Variable      ${TestDSS10Mhz_1586_M1.Context.gNBId}
    ${UE_PROFILE3.target_cells}      set Variable      1
    Set To Dictionary     ${UE_PROFILE3}      ue       ${TestDSS10Mhz_1586_M1.Context.UeId3}
    ${UE_PROFILE4}         Tools.Dictionary Get        ${UE_SIMPLE}
    ${UE_PROFILE4.target_gnb}        set Variable      ${TestDSS10Mhz_1586_M1.Context.gNBId}
    ${UE_PROFILE4.target_cells}      set Variable      1
    Set To Dictionary     ${UE_PROFILE4}      ue       ${TestDSS10Mhz_1586_M1.Context.UeId4}
    ${UE_PROFILE5}         Tools.Dictionary Get        ${UE_SIMPLE}
    ${UE_PROFILE5.target_gnb}        set Variable      ${TestDSS10Mhz_1586_M1.Context.gNBId}
    ${UE_PROFILE5.target_cells}      set Variable      1
    Set To Dictionary     ${UE_PROFILE5}      ue       ${TestDSS10Mhz_1586_M1.Context.UeId5}
    Set Suite Variable    ${UE_PROFILE1}
    Set Suite Variable    ${UE_PROFILE2}
    Set Suite Variable    ${UE_PROFILE3}
    Set Suite Variable    ${UE_PROFILE4}
    Set Suite Variable    ${UE_PROFILE5}

    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS}                Capture L1L2 Set Upon Config
    Set Suite Variable              ${CAPTURE_L1L2_GNB_FS_ASIK_DSS}

    Dated log                       Get SW Version from OAM
    ${sw_version}=    Fetch common OAM SW version
    Set Suite Variable              ${my_sw_version}                           ${sw_version}
    Set Suite Metadata    gNB sw    ${sw_version}

    ${ap_version}=    robot_extension.Run Keyword And Warn On Failure       common_DSS_Keywords.Get Airphone SW version

    5GC001586_Keywords.Software Converter    ${my_sw_version}    0
    ${sw_version_list}     Split String   ${my_sw_version}   _
    Set Suite Variable     ${trunk}     False
    Set Suite Variable     ${branch}     None
    Run Keyword If                  '${master_version}' == '0'        Set Suite Variable     ${trunk}     False
    Run Keyword If                  '${master_version}' == '9999'     Set Suite Variable     ${trunk}     True
    ${branch}              Get From List    ${sw_version_list}    0
    Dated log                       \tGNB_SW_VERSION=${my_sw_version}
    Dated log                       \tconvert_version=${convert_version}
    Dated log                       \tmaster_version=${master_version}
    Dated log                       \ttrunk=${trunk}
    Dated log                       \tbranch=${branch}
    set suite variable     ${branch}

    ${sw_version}=       pcap.Get Software Version
    Set Suite Variable     ${current_sw_version_for_lua_gNB}     ${my_sw_version}
    Dated log      sw version for lua gNB is ${current_sw_version_for_lua_gNB}

    run Keyword if    '${trunk}' == 'True'         set WS preference
    run Keyword if    '${WITH_MCSHARK}' == '1'     Install MCShark if Needed     current_sw_version=${current_sw_version_for_lua_gNB}

    # needed to install only once
    run Keyword if    not ${isAiC}     Dated Log         First Do install Mirroring scripts in gNB
    run Keyword if    not ${isAiC}     common_Dss_Keywords.Get gNB mirroring into local repo  scriptDef=${CAPTURE_L1L2_GNB_FS_ASIK_DSS.scriptDef}
    run Keyword if    not ${isAiC}     common_Dss_Keywords.Mirror Script Install for DSS      scriptDef=${CAPTURE_L1L2_GNB_FS_ASIK_DSS.scriptDef}
    ...                                                                                       PathToScriptsRepo=${LOCAL_REPO_DIR}

    ${the var}=    Get Variable Value    ${AF_PATH}
    ${AF_PATH is set}=      Set Variable If    """${the var}""" != 'None'    ${True}    ${False}
    Dated log     AF_PATH is set to ${AF_PATH is set} => set it to empty if False
    set suite variable    ${AF_PATH is set}
    run Keyword if   "${AF_PATH is set}"=="False"      set suite variable   ${AF_PATH}     ${empty}
    ${the var}=    Get Variable Value    ${ENB_BUILD}
    ${ENB_BUILD is set}=      Set Variable If    """${the var}""" != 'None'    ${True}    ${False}
    Dated log     ENB_BUILD is set to ${ENB_BUILD is set} => set it to empty if False
    set suite variable     ${ENB_BUILD is set}
    run Keyword if   "${ENB_BUILD is set}"=="False"      set suite variable   ${ENB_BUILD}     ${empty}
    Dated log    AF_PATH is ${AF_PATH}
    Dated log    ENB_BUILD is ${ENB_BUILD}

    Dated Log    First Do install Xp LuaShark
    # make implode  => zip src dir to generated_luashark-9.1800.330.zip if needed
    ${output}=   run   command= ls ${CURDIR}/../9.1800.330/generated_luashark-9.1800.330.zip
    log many     ${output}
    ${contains}=    Run Keyword And Return Status    Should Contain    ${output}     No such file or directory
    run keyword if    "${contains}"=="${True}"     run    command=cd ${CURDIR}/../9.1800.330 && make implode
    Do install Xp LuaShark into home     ${CURDIR}/../9.1800.330/generated_luashark-9.1800.330.zip

    run Keyword if   "${mcshark_present}"=="False"    Dated log             Point AF_PATH and ENB_BUILD to local luashark XP package
    run Keyword if   "${mcshark_present}"=="False"    Point AF_PATH to local luashark XP package
    run Keyword if   "${mcshark_present}"=="False"    Point ENB_BUILD to local luashark XP package

    Run Keyword if    '${AP_DU.sys[0].M.boardType}'=='ASIK'    run Keywords     Dated log    Install classicalbts log collector into Airphone   AND
    ...                                                                         5GC001586_Keywords.Install classicalbts log collector into Airphone


Test suite teardown for 1586
    [Documentation]          Test suite teardown for all 1586 TCs.
    ...                      Restores existing configuration files

    run keyword and ignore error     5GC001586_Keywords.Restore Orignal Configuration 1586
    Run Keyword If     '${REMOVE_PDML_FILE_END_TEST_SUITE}' == '1'   OperatingSystem.Remove File    ${LOG_PATH}/*.pdml
    Run Keyword If     '${SHOULD_BE_RECOMMISSIONED_GNB}' == '1'   Dated Log              Recommissioning gNB with original SCF file
    Run Keyword If     '${SHOULD_BE_RECOMMISSIONED_GNB}' == '1'   Run Keyword and Ignore Error  OAM Perform Full Commissioning   ${original_scf_file}
    ${isOAMRebooted}      Run Keyword If        '${SHOULD_BE_RECOMMISSIONED_GNB}' == '1'      SSH Was OAM Rebooted         ${GNB_DU}
    ...                             timeout=60
    # If gNB was rebooted after re-commissioning, wait until it's ready again.
    Run Keyword If   '${SHOULD_BE_RECOMMISSIONED_GNB}' == '1'  Run Keyword If  '${isOAMRebooted}' == 'True'  Airscale Wait for Ready  ${GNB_DU}
    common_Dss_Keywords.Conn.ResetCache


7738_DSS_CRM_Cell_Setup_Phase3 to remove
#     [Arguments]                 ${testParam}=Param    ${alias}=default
     [Arguments]                 ${alias}=default

    Log to console   \n${blue}***DSS ${Param.Context.DSS_Phase} CRM CellSetup BW=${Param.seq.bandwidth} with alias=${alias}*** ${normal}

    wts.execute egate command    cmd=enb_dss_param id=${Param.Context.eNBId} feature_flag=on message_sets=V1,DMS3    alias=${alias}
    Sleep   2
    wts.execute egate command    cmd=enb_cell_param enb=${Param.Context.eNBId} id=1 lte_nr_dss_mode=DSS_PHASE_3 antenna_ports_num=2    alias=${alias}
    Sleep   2
    wts.execute egate command    cmd=enb_cell_dss_feature enb=${Param.Context.eNBId} id=1 nr_dl_peak_rate_increase=on    alias=${alias}
    Sleep   2
    wts.execute egate command    cmd=enb_cell_dss_feature enb=${Param.Context.eNBId} id=1 superfast_allocation=on    alias=${alias}
    Sleep   2

    ${cmd}    Catenate          enb_dss_cell_param enb=${Param.Context.eNBId} id=1 dl_resource_sharing_algo=${Param.seq.wtsDlResourceSharingAlgo}
    wts.execute egate command    cmd=${cmd}    alias=${alias}
    Sleep   2
    wts.execute egate command    cmd=enb_dss_configure_partnership enb=${Param.Context.eNBId} cell=1 dss_peer=${Param.Context.gNBId}:1
    ...                                    alias=${alias}
    sleep   2

    ${cmd}    Catenate    enb_crm_cell_resource_reservation enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1
    ...         assigned_dl_minimum_share_to_nr=15 assigned_dl_maximum_share_to_nr=70 assigned_dl_minimum_share_to_lte=15
    ...         assigned_dl_maximum_share_to_lte=70 assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=70

    wts.execute egate command      cmd=${cmd}    alias=${alias}

    # to simulate the EN DSS UL QoS LOAD INDICATION Timer = 80ms sent into DL coord rsp
    ${cmd}    Catenate    enb_crm_param id=${Param.Context.eNBId} ul_qos_load_meas_timer=${Param.seq.ul_qos_load_meas_timer}
    ...                                      dl_qos_load_meas_timer=${Param.seq.dl_qos_load_meas_timer}
    Dated Log New Line       ${cmd}
    wts.execute egate command      cmd=${cmd}      alias=${alias}

    sleep    30
    # wts.execute egate command   cmd=enb_dss_establish_partnership enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1
    # ...                                         alias=${alias}
    ${pattern}    Set Variable    EN DSS UL Cell Subcarrier Resource Coordination success on remote NE
    ${cmd}      Catenate       enb_dss_establish_partnership enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1
    ${output}    wts.Execute Egate Command And Wait For Data    cmd=${cmd}
    ...    pass_regexp=${pattern}    timeout=30     alias=${alias}
    ${output}    String.Get Lines Matching Regexp    ${output}    ${pattern}    partial_match=True
    Log To Console    \n${output}

    sleep   10

    5GC001586_Keywords.Reset DL Reservation    alias=${alias}
    Sleep    2s    reason=make sure the cmd take affect
    5GC001586_Keywords.Reset UL Reservation    alias=${alias}
    Sleep    2s    reason=make sure the cmd take affect

    ${cmd}    Catenate    enb_dss_dl_resource_cell_reservation cell=1 enb=${Param.Context.eNBId}
    ...                                           prb_area_reservation_list=0,0,0-10-none+0,0,5-10-none+0,0,9-10-none
    Dated Log New Line       ${cmd}
    wts.execute egate command      cmd=${cmd}      alias=${alias}

    ${cmd}    Catenate    enb_dss_dl_resource_cell_reservation cell=1 enb=${Param.Context.eNBId}
    ...                     reserved_fixed_normal_subframes=0000000000-0000000000-0000000000-0000000000-0000000000-0000000000-0000000000-0000000000
    Dated Log New Line       ${cmd}
    wts.execute egate command      cmd=${cmd}      alias=${alias}

    ${cmd}    Catenate    enb_dss_dl_resource_cell_reservation cell=1 enb=${Param.Context.eNBId} min_lte_nr_dss_ratio=30 max_lte_nr_dss_ratio=70
    Dated Log New Line       ${cmd}
    wts.execute egate command      cmd=${cmd}      alias=${alias}

    ${cmd}    Catenate    enb_dss_cell_resource_coordination enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1 dir=DL
    Dated Log New Line       ${cmd}
    wts.execute egate command      cmd=${cmd}      alias=${alias}

    ${cmd}    Catenate    enb_dss_ul_resource_cell_reservation cell=1 enb=${Param.Context.eNBId} minimum_prb_share=30 maximum_prb_share=70
    Dated Log New Line       ${cmd}
    wts.execute egate command      cmd=${cmd}      alias=${alias}

    ${cmd}    Catenate    enb_dss_cell_resource_coordination enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1 dir=UL
    Dated Log New Line       ${cmd}
    wts.execute egate command      cmd=${cmd}      alias=${alias}

    Sleep    2s    reason=make sure the cmd take affect

    ${output}    wts.execute egate command and wait for data      cmd=enb_crm_status enb=${Param.Context.eNBId} cell=1       alias=${alias}
    Log To Console    \n${output}

    Sleep    2s    reason=make sure the cmd take affect

    ${dl_prb_area_allocation_list}=    Catenate    SEPARATOR=    0:0,28+1:0,0+2:0,52+3:0,52+4:0,52+5:0,28+6:0,52+7:0,52+8:0,52+9:0,52+10:0,28+11:0,
    ...    52+12:0,52+13:0,52+14:0,52+15:0,28+16:0,52+17:0,52+18:0,52+19:0,52+20:0,28+21:0,0+22:0,52+23:0,52+24:0,52+25:0,28+26:0,52+27:0,52+28:0,
    ...    52+29:0,52+30:0,28+31:0,52+32:0,52+33:0,52+34:0,52+35:0,28+36:0,52+37:0,52+38:0,52+39:0,52+40:0,28+41:0,0+42:0,52+43:0,52+44:0,52+45:0,
    ...    28+46:0,52+47:0,52+48:0,52+49:0,52+50:0,28+51:0,52+52:0,52+53:0,52+54:0,52+55:0,28+56:0,52+57:0,52+58:0,52+59:0,52+60:0,28+61:0,0+62:0,
    ...    52+63:0,52+64:0,52+65:0,28+66:0,52+67:0,52+68:0,52+69:0,52+70:0,28+71:0,52+72:0,52+73:0,52+74:0,52+75:0,28+76:0,52+77:0,52+78:0,52+79:0,52

    # ${dl_pattern}=      Catenate       1011111111-1111111111-1011111111-1111111111-1011111111-1111111111-1011111111-1111111111
    ${dl_pattern}=      Catenate       ${Param.seq.dl_allocated_normal_subframes}
    5GC001586_Keywords.DSS DL Cell Resource Allocation Phase3   dl_allocated_normal_subframes=${dl_pattern}
    ...                                                         dl_prb_area_allocation_list=${dl_prb_area_allocation_list}
    ...                                                         alias=${alias}

    # Param variable is visible under the test suite
    # 5GC001586_Keywords.DSS UL Cell Resource Allocation Phase3     35    1   ${alias}
    5GC001586_Keywords.DSS UL Cell Resource Allocation Phase3     ${Param.seq.ULNbrOfPrb}    1    immediate   ${alias}

    sleep    2s    reason=make sure the cmd take affect

    log to console   \n${blue}***DSS CRM CELLSETUP BW=${Param.seq.bandwidth} completed*** ${normal}

    ${output}    wts.execute egate command and wait for data      cmd=enb_crm_status enb=${Param.Context.eNBId} cell=1       alias=${alias}
    Log To Console    \n*** enb_crm_status enb=${Param.Context.eNBId} cell=1
    Log To Console    \n${output}

Sum NbrOfPrb based on pcap puschreceivereq traces
    [Arguments]                    ${param}
    Dated log     ==========> SumOfPrb from UlData_PuschReceiveReq pcap file
    # 70 % UL Ratio case
    # based on pcap analysis for 10MHz , NbrOfPrb = 4470 over 20 sfn
    # so, NbrOfPrb over 1024 sfn = 228864
    # based on pcap analysis for 15MHz , NbrOfPrb = 6680 over 20 sfn
    # so, NbrOfPrb over 1024 sfn = 342016
    # based on pcap analysis for 20MHz , NbrOfPrb = 9020 over 20 sfn
    # so, NbrOfPrb over 1024 sfn = 461824
    ${sum_ul_prb_allocated_to_nr_over_1024_sfn}    set variable if
    ...                            '${param.seq.bandwidth}'=='10MHz'       228864
    ...                            '${param.seq.bandwidth}'=='15MHz'       342016
    ...                                                                    461824
    ${pattern}=     set variable if   '${mcshark_present}'=='${False}'    ICOM_5G/UlData_PuschReceiveReq
    ...                                                                   UlData_PuschReceiveReq
    ${SharkTool}=   set variable if   '${mcshark_present}'=='${False}'    LUA_SHARK
    ...                                                                   MC_SHARK
    ${sum_prb}  ${cpt_sfn}   ${sum_prb_5min}   ${ul_ratio}  ${sum_ul_prb_allocated_to_nr}=   nps_1586_tools.SumOfPrb_UlData_PuschReceiveReq
    ...                                                                                                 ${param.seq.ULNbrOfPrb}
    ...                                                                                                 ${sum_ul_prb_allocated_to_nr_over_1024_sfn}
    ...                                                                                                 ${pattern}
    ...                                                                                                 ${SharkTool}
    [return]    ${sum_prb}   ${cpt_sfn}   ${sum_prb_5min}   ${ul_ratio}   ${sum_ul_prb_allocated_to_nr}

Sum NbrOfPrb Info from L1L2 uldata_puschreceivereq_t Pcap
    [Documentation]                Generic test for 1586: test purpose is to UL Qos Ind from L1L2 pcap
    [Arguments]                    ${param}   ${capture}
    Dated log     ==========> Extract sfn, slot And nbOfPrb from _5g_l1_ul_l2_ps_uldata_puschreceivereq_t Pcap
    Extract sfn, slot And nbOfPrb from _5g_l1_ul_l2_ps_uldata_puschreceivereq_t Pcap        ${capture}
    ${sum_prb}  ${cpt_sfn}  ${sum_prb_5min}  ${ul_ratio}  ${sum_ul_prb_allocated_to_nr}=  Sum NbrOfPrb based on pcap puschreceivereq traces  ${param}
    Dated log                      SumOfPrb puschreceivereq over 1024 sfn = ${sum_prb}
    Dated log                      SumOfPrb puschreceivereq over 5min = ${sum_prb_5min}
    Dated log                      SumOfPrb allocated to nr over 1024 sfn = ${sum_ul_prb_allocated_to_nr}
    Dated log                      UL Ratio [used for acceptance criteria] = ${ul_ratio} %
    [return]     ${sum_prb}   ${sum_prb_5min}    ${ul_ratio}   ${sum_ul_prb_allocated_to_nr}

# UlData_PuschReceiveReq.PuschReceiveReq.sfn
# UlData_PuschReceiveReq.PuschReceiveReq.slot
# UlData_PuschReceiveReq.grants_item_0.rnti
# UlData_PuschReceiveReq.grants_item_0.startPrb
# UlData_PuschReceiveReq.grants_item_0.numOfPrb

# Info;sfn;slot;rnti;startPrb;numOfPrb
Extract sfn, slot And nbOfPrb from _5g_l1_ul_l2_ps_uldata_puschreceivereq_t Pcap
    [Arguments]                     ${File}
    [Documentation]                 Extract sfn slot and nbOfPrb _5g_l1_ul_l2_ps_uldata_puschreceivereq_t info from Pcap

    Dated log                   Extract sfn, slot and nbOfPrb uldata_puschreceivereq info from PCAP file    ${File}

    set test variable   ${pcapprocessed_nbOfPrb_l1_ul_l2_ps_uldata_puschreceivereq}
    ...                                 pcapprocessed_Extract_nbOfPrb_l1_ul_l2_ps_uldata_puschreceivereq.txt
    set test variable   ${pcapprocessed_nbOfPrb_l1_ul_l2_ps_uldata_puschreceivereq_path}
    ...                                 ${testCaseDir}/${pcapprocessed_nbOfPrb_l1_ul_l2_ps_uldata_puschreceivereq}
    ${cmd1}=    Set Variable If   '${mcshark_present}'=='${False}'   tshark -X lua_script:/opt/luashark/generated_luashark/luashark.lua
    ...                                                              tshark
    ${cmd}    catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e UlData_PuschReceiveReq.PuschReceiveReq.sfn
    ...           -e UlData_PuschReceiveReq.PuschReceiveReq.slot
    ...           -e UlData_PuschReceiveReq.grants_item_0.rnti
    ...           -e UlData_PuschReceiveReq.grants_item_0.numOfPrb
    ...           -E header=y -E separator=';' > ${pcapprocessed_nbOfPrb_l1_ul_l2_ps_uldata_puschreceivereq_path}
    ${cmd_mcshark}    Catenate      ${cmd1} -r
    ...        ${File} -T fields -Y "uldata_puschreceivereq" -e _ws.col.Info
    ...           -e 3gpp.sfn
    ...           -e 3gpp.slot
    ...           -e 3gpp.rnti
    ...           -e UlData_puschReceiveReqGrant_t.numOfPrb
    ...           -E header=y -E separator=';' > ${pcapprocessed_nbOfPrb_l1_ul_l2_ps_uldata_puschreceivereq_path}
    run Keyword if    '${mcshark_present}'=='${False}'   Run       ${cmd}
    ...  ELSE                                            Run       ${cmd_mcshark}
    # remove space if present
    Run      command=sed -i -e 's/ //g' ${pcapprocessed_nbOfPrb_l1_ul_l2_ps_uldata_puschreceivereq_path}

    ${extract_col_info}   OperatingSystem.grep file        ${pcapprocessed_nbOfPrb_l1_ul_l2_ps_uldata_puschreceivereq_path}   _ws.col.Info
    ${pattern}=     set variable if   '${mcshark_present}'=='${False}'    ICOM_5G/UlData_PuschReceiveReq
    ...                                                                   UlData_PuschReceiveReq
    ${extract}  OperatingSystem.grep file  ${pcapprocessed_nbOfPrb_l1_ul_l2_ps_uldata_puschreceivereq_path}
    ...                                    ${pattern}
    run keyword if  len($extract)==0     fail   UlData_PuschReceiveReq not found
    OperatingSystem.copy file    ${pcapprocessed_nbOfPrb_l1_ul_l2_ps_uldata_puschreceivereq_path}
    ...                          ${testCaseDir}/msg_nbOfPrb_UlData_PuschReceiveReq_pcap.csv

Check no DL Qos Load Indication MeasuredNgbrNnbrLoad upper 100
    [Arguments]    ${pdmlFile}
    Dated log           ${pdmlFile}

    ${cmd}=    Catenate     cat ${pdmlFile} | grep -i 'dssDlQosLoadMeasurement.measuredNgbrNnbrLoad' | grep 'measuredNgbrNnbrLoad (Uint8)' |
    ...                                             awk '{print $9}' | sed -e 's/value="//g' | sed -e 's/"/ /g' | awk '{print $1}'
    ${MeasuredNgbrNnbrLoad}=    OperatingSystem.Run    ${cmd}
    @{lines}    Split To Lines    ${MeasuredNgbrNnbrLoad}
    ${length}=    get length     ${lines}
    @{MeasuredNgbrNnbrLoad}    Evaluate    map(lambda x: int(x, 16), @{lines})
    Dated log   DL MeasuredNgbrNnbrLoad = @{MeasuredNgbrNnbrLoad} and length = ${length}
    ${avg_dl_MeasuredNgbrNnbrLoad}    Evaluate    round(round(sum(@{MeasuredNgbrNnbrLoad}), 1)/round(${length}, 1), 1)
    ${NbrElt}  ${list_dl_MeasuredNgbrNnbrLoad_upper_100}=   nps_2574_tools.check_dl_MeasuredNgbrNnbrLoad_upper_100    ${MeasuredNgbrNnbrLoad}
    Dated log   DL MeasuredNgbrNnbrLoad upper 100 = @{list_dl_MeasuredNgbrNnbrLoad_upper_100} and length = ${NbrElt}
    ${avg_dl_MeasuredNgbrNnbrLoad_upper_100}    run Keyword if   '${NbrElt}'!='0'
    ...              Evaluate    round(round(sum(@{list_dl_MeasuredNgbrNnbrLoad_upper_100}), 1)/round(${NbrElt}, 1), 1)
    ...  ELSE        set variable    0
    Log many          [DATA TRANSFER] DL dssDlQosLoadMeasurement MeasuredNgbrNnbrLoad average: ${avg_dl_MeasuredNgbrNnbrLoad}
    Log To Console    \t\t\tDownlink dssDlQosLoadMeasurement.MeasuredNgbrNnbrLoad Avg:\t\t ${avg_dl_MeasuredNgbrNnbrLoad} %
    Log many          [DATA TRANSFER] DL dssDlQosLoadMeasurement MeasuredNgbrNnbrLoad List upper 100 : ${avg_dl_MeasuredNgbrNnbrLoad_upper_100}
    Log To Console    \t\t\tDL dssDlQosLoadMeasurement MeasuredNgbrNnbrLoad List upper 100 Avg:\t\t ${avg_dl_MeasuredNgbrNnbrLoad_upper_100} %

Check no UL Qos Load Indication MeasuredNgbrNnbrLoad upper 100
    [Arguments]    ${pdmlFile}
    Dated log           ${pdmlFile}

    ${cmd}=    Catenate     cat ${pdmlFile} | grep -i 'enDssUlQosLoadMeasurement.MeasuredNgbrNnbrLoad' |
    ...                grep 'MeasuredNgbrNnbrLoad (Uint8)' | awk '{print $9}' | sed -e 's/value="//g' | sed -e 's/"/ /g' | awk '{print $1}'
    ${MeasuredNgbrNnbrLoad}=    OperatingSystem.Run    ${cmd}
    @{lines}    Split To Lines    ${MeasuredNgbrNnbrLoad}
    Remove Values From List     ${lines}     00
    ${length}=    get length     ${lines}
    @{MeasuredNgbrNnbrLoad}    Evaluate    map(lambda x: int(x, 16), @{lines})
    Dated log   UL MeasuredNgbrNnbrLoad = @{MeasuredNgbrNnbrLoad} and length = ${length}
    ${avg_ul_MeasuredNgbrNnbrLoad}    Evaluate    round(round(sum(@{MeasuredNgbrNnbrLoad}), 1)/round(${length}, 1), 1)
    ${NbrElt}  ${list_ul_MeasuredNgbrNnbrLoad_upper_100}=   nps_1586_tools.check_MeasuredNgbrNnbrLoad_upper_100    ${MeasuredNgbrNnbrLoad}
    Dated log   UL MeasuredNgbrNnbrLoad upper 100 = @{list_ul_MeasuredNgbrNnbrLoad_upper_100} and length = ${NbrElt}
    ${avg_ul_MeasuredNgbrNnbrLoad_upper_100}    run Keyword if   '${NbrElt}'!='0'
    ...              Evaluate    round(round(sum(@{list_ul_MeasuredNgbrNnbrLoad_upper_100}), 1)/round(${NbrElt}, 1), 1)
    ...  ELSE        set variable    0
    Log many          [DATA TRANSFER] UL dssUlQosLoadMeasurement MeasuredNgbrNnbrLoad average: ${avg_ul_MeasuredNgbrNnbrLoad}
    Log To Console    \t\t\Uplink dssUlQosLoadMeasurement.MeasuredNgbrNnbrLoad Avg:\t\t ${avg_ul_MeasuredNgbrNnbrLoad} %
    Log many          [DATA TRANSFER] UL dssUlQosLoadMeasurement MeasuredNgbrNnbrLoad List upper 100 : ${avg_ul_MeasuredNgbrNnbrLoad_upper_100}
    Log To Console    \t\t\Uplink dssUlQosLoadMeasurement MeasuredNgbrNnbrLoad List upper 100 Avg:\t\t ${avg_ul_MeasuredNgbrNnbrLoad_upper_100} %

5GC001586 build UEs list
    [Arguments]                     ${CallType}=NSA    ${UEnb}=1    ${CellID}=1
    ${UEsList}                      Run Keyword If    "${CallType}" == "NSA"
    ...                             5GC001586 build UEs list NSA      UEnb=${UEnb}    CellID=${CellID}
    ...                             ELSE IF           "${CallType}" == "SA"
    ...                             5GC001586 build UEs list SA       UEnb=${UEnb}    CellID=${CellID}
    ...                             ELSE
    ...                             Create List
    [return]                        ${UEsList}

5GC001586 build UEs list NSA
    [Arguments]                     ${UEnb}=1    ${CellID}=1
    ${UEsList}                      Create List
    FOR    ${UEid}    IN RANGE    1    ${UEnb}+1
            &{UEcurrent}=                   Copy Dictionary          ${UE_SIMPLE}
            Set To Dictionary               ${UEcurrent}      ue                 ${UEid}
            Set To Dictionary               ${UEcurrent}      target_cells       ${CellID}
            Append To List                  ${UEsList}    ${UEcurrent}
    END
    [return]                        ${UEsList}

5GC001586 build UEs list SA
    [Arguments]                     ${UEnb}=1    ${CellID}=1
    ${UEsList}                      Create List
    FOR    ${UEid}    IN RANGE    1    ${UEnb}+1
            &{UEcurrent}=                   Copy Dictionary          ${UE_SIMPLE}
            Set To Dictionary               ${UEcurrent}      ue                 ${UEid}
            Set To Dictionary               ${UEcurrent}      pdu                ${UEid}
            Set To Dictionary               ${UEcurrent}      target_cells       ${CellID}
            Append To List                  ${UEsList}    ${UEcurrent}
    END
    [return]                        ${UEsList}

Create Header Csv Test result
    [Arguments]          ${target_dir}=None           ${text}=Extract INF/.uplane/L2-PS/src/sgnl/psCell/CellSetupLogger.cpp from SYSLOG...
    ${local_target_dir}=    Run Keyword If    '${target_dir}'=='None'    Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}
    ${timeStamp}=    DateTime.Get current date    exclude_millis=True    result_format=%Y%m%d-%H%M%S
    ${testCase}    Replace String    ${TEST_NAME[0:30]}    ${SPACE}    _
    ${testCase}    Replace String    ${testCase}    .    _
    ${testCase}    Remove String     ${testCase}    [1]
    ${testCase}    Remove String     ${testCase}    [1.0]
    ${testCase}    Remove String     ${testCase}    [2.0]
    ${testCase}    Remove String     ${testCase}    [
    ${testCase}    Remove String     ${testCase}    ]
    ${filename}   set Variable
    ...               CellSetupLogger-SYSLOG-${testCase}-${timeStamp}.log
    Run Keyword And Ignore Error    OperatingSystem.touch    ${local_target_dir}/${filename}
    Run Keyword And Ignore Error    OperatingSystem.run      echo "${text}" > ${local_target_dir}/${filename}
    set suite variable      ${log_file_results}       ${local_target_dir}/${filename}
    ${filename}   set Variable      egate_commands.log
    ${timeStamp}    get current date    result_format=%Y%m%d_%H%M%S
    ${timeStamp}=    Remove String    ${timeStamp.replace(' ','-')}
    Run Keyword And Ignore Error    OperatingSystem.touch    ${local_target_dir}/${filename}
    Run Keyword And Ignore Error    OperatingSystem.run      echo "${timeStamp} : ${filename}" > ${local_target_dir}/${filename}
    set suite variable      ${log_file_egate_command}       ${local_target_dir}/${filename}

Log Test results
    [Arguments]                    ${text}
    Run Keyword And Ignore Error    OperatingSystem.run      echo "${text}" >> ${log_file_results}

Log egate command results
    [Arguments]                    ${text}
    Run Keyword And Ignore Error    OperatingSystem.run      echo "${text}" >> ${log_file_egate_command}

Extract egate_command
    [Documentation]   Analyzing this kind of egate trace
    ...    [session 1]: sim_log_set
    [Arguments]     ${dir}=${EMPTY}     ${egate_console}=egate_console.log

    ${commandToRun}     Catenate
    ...     cat ${dir}/${egate_console} | grep
    ...     '\\[session'
    ${msg}=        Catenate   ${consTraceColorBgYellow}${consTraceColorBlack}no [session found${defColor}
    ${output}=        OperatingSystem.Run
    ...    command=cat ${dir}/${egate_console} | grep "\\[session"
    ${isEmpty}    Run Keyword And Return Status       should be empty       ${output}
    run Keyword if    ${isEmpty}      dated log   ${msg}
    Return From Keyword If      ${isEmpty}
    ${egate_cmd}  nps_dss_tools.extract_session_from_egateconsole   ${output}
    ${isEmpty}    Run Keyword And Return Status       should be empty       ${egate_cmd}
    run Keyword if    ${isEmpty}         log to console      no [session found: ${egate_cmd}
    ${msg}=        Catenate   ${consTraceColor}no [session found${defColor}
    return from Keyword if   ${isEmpty}     dated log   ${msg}
    ${text}=    Catenate      egate_command FROM ${dir}/${egate_console} :
    Log egate command results      ${text}
    ${text}=    Catenate      =============================================================
    Log egate command results      ${text}
    FOR    ${egate_cmd_elt}    IN    @{egate_cmd}
        # ${text}=    Catenate     ${egate_cmd_elt}
        Log egate command results      ${egate_cmd_elt}
    END
    # [Return]        ${egate_cmd}

Extract L2-PS/src/sgnl/psCell/CellSetupLogger
    [Documentation]   Analyzing this kind of Syslog trace
    ...    INF/.uplane/L2-PS/src/sgnl/psCell/CellSetupLogger.cpp:
    [Arguments]     ${dir}=/tmp/btslog2     ${syslog}=/tmp/

    ${commandToRun}     Catenate
    ...     cat ${dir}/${syslog} | grep
    ...     'INF/.uplane/L2-PS/src/sgnl/psCell/CellSetupLogger.cpp:'
    ${msg}=        Catenate   ${consTraceColorBgYellow}${consTraceColorBlack}no L2-PS/src/sgnl/psCell/CellSetupLogger found${defColor}
    ${output}=        OperatingSystem.Run
    ...    command=cat ${dir}/${syslog} | grep "INF/.uplane/L2-PS/src/sgnl/psCell/CellSetupLogger.cpp:"
    ${isEmpty}    Run Keyword And Return Status       should be empty       ${output}
    run Keyword if    ${isEmpty}      dated log   ${msg}
    Return From Keyword If      ${isEmpty}
    ${bbrm_err}  nps_1586_tools.extract_L2_PS_CellSetupLogger_from_syslog   ${output}
    ${isEmpty}    Run Keyword And Return Status       should be empty       ${bbrm_err}
    run Keyword if    ${isEmpty}         log to console      no INF/.uplane/L2-PS/src/sgnl/psCell/CellSetupLogger.cpp: found: ${bbrm_err}
    ${msg}=        Catenate   ${consTraceColor}no INF/.uplane/L2-PS/src/sgnl/psCell/CellSetupLogger.cpp: found${defColor}
    return from Keyword if   ${isEmpty}     dated log   ${msg}
    ${text}=    Catenate      Extract L2-PS/src/sgnl/psCell/CellSetupLogger FROM ${syslog} :
    Log Test results      ${text}
    ${text}=    Catenate      =============================================================
    Log Test results      ${text}
    FOR    ${bbrm_err_elt}    IN    @{bbrm_err}
        ${text}=    Catenate     line ${bbrm_err_elt[0]} : ${bbrm_err_elt[1]}
        Log Test results      ${text}
    END
    [Return]        ${bbrm_err}

