Library          taf.wts.runner                            WITH NAME    wtsemu
Library          ute_wtssim
Library          OperatingSystem
Library          DateTime


# 1586 specific
Library          ../python/tools.py     WITH NAME    nps_dss_tools
Library          ../python/Common.py
Library          ../python/aasyslog.py
Library          ../../../resources/DSS/python/robot_extension.py      WITH NAME          robot_extension

Resource         ../../../../../resources/SWENG/robot/Container.robot
Resource         ../../../../../resources/SWENG/robot/Restart.robot
Resource         ../../../../../resources/SWENG/robot/Tools.robot

# DSS Specific
Resource         ../../../resources/DSS/robot/common_Dss_SA_NSA.robot

# 1586 specific
Resource         5GC001586_Kw_TestSetup.robot
Resource         5GC001586_Ue_command.robot
Resource         pcap.robot
Resource         bip_trace.robot
Resource         bip_trace_ap.robot
Resource         tcpdump.robot

*** Variables ***

# ${BLACK}    "\\033[30m"
# ${RED}      "\\033[31m"
# ${BLUE}     "\\033[34m"
# ${GREEN}    "\\033[32m"
# ${NORMAL}   "\\033[0m"

${kill_btslog}     timeout 5 sudo kill -9 $(ps -ef|grep btslog|grep -v grep|awk '{print $2}') 1>/dev/null 2>&1
${kill_dpkg}       timeout 5 sudo kill -9 $(ps -ef|grep dpkg|grep tti-dec.deb|grep -v grep|awk '{print $2}') 1>/dev/null 2>&1
${kill_sherpa}     timeout 5 sudo kill -9 $(ps -ef|grep ./Sherpa|grep -v grep|grep -v run|awk '{print $2}') 1>/dev/null 2>&1
${kill_tcpdump}     timeout 5 sudo kill -9 $(ps -ef|grep tcpdump|grep -v grep|grep -v run|awk '{print $2}') 1>/dev/null 2>&1

&{logs_and_traces_flags}     BackhaulTrace=${False}
...                          L1L2BIPTrace=${True}
...                          AP_L1L2BIPTrace=${True}
...                          X2Trace=${False}


&{start_end_trace_point}     get_biptrace_start_point=before_attach
...                          get_biptrace_stop_point=after_attach
...                          get_backhaul_start_point=before_attach
...                          get_backhaul_stop_point=after_attach


# to remove later
&{OPT_GNB_MIRRORING}                bb_slot=bb_slot_1
...                                 mirroring_mode='manual'
# ...                                 bb_board_type='ABIL'
...                                 l2_l1_bip='false'
...                                 syscom_mirroring='false'
...                                 carrier_aggregation='false'
...                                 backhaul_mirroring='false'
...                                 l2hi_l2lo_mirroring='false'
...                                 filtering='off'
...                                 capturing_time_seconds='1'

&{CAPTURE_BH_GNB_FS_TO_REMOVE}                prefix=BH_GNB_FS                   name=
...                                 path=                              filter=${EMPTY}

# for PM Check
${latest_pm_file_name}
${coam_pm_file_path}   gnb_pm_counters

# Table describing list of field we want to collect for each packet
@{FIELDS_PUCCH_REQ}                 slot        sfn         rnti        pucchFormat     startPrb
...                                 numOfBitsOfUciInformation           nANPucch        numOfSymbols
...                                 firstSymbol
@{FIELDS_PUCCH_RESP}                slot        sfn         rnti        pucchFormat     startPrb
...                                 dtx         ackNack     crc
@{FIELDS_PDSCHSendReq}              rat0Bitmap        rbgSize         numOfPrb
@{FIELDS_PUCCHreceivereq}                           pucchFormat          startPrb         nANPucch
@{FIELDS_PUSCHreceivereq}           numOfPrb       startPrb

# Global counters to build status when parsing pucchResp packets
${NbReq}                            0           # Number of pucchReq packets found
${NbNone}                           0           # Number of pucchReq with no pucchResp found
${NbOK}                             0           # Number of pucchReq/resp where numOfBitsOfUci is OK
${NbKO}                             0           # Number of pucchReq/resp where numOfBitsOfUci is KO

# UL/DL throughput
${UL_THROUGHPUT}     200M
${DL_THROUGHPUT}    600M
@{UL_THROUGHPUT_LIST}
@{DL_THROUGHPUT_LIST}
${UL_EXPECT}        30M
${DL_EXPECT}        30M

${PCAP_PATH_GNB}=       /tmp/lte1460/portMirroringTmp.pcap.gz
${PCAP_PATH_TMP_VM}=        /tmp/tmp.pcap

${REGEX_PDU_SESSION_PASS}=  (Established PDU session ID=\\d+ using PDU Gateway ID=\\d+)


*** Keywords ***
# robocop: off=unused-argument
# robocop: off=possible-variable-overwriting
#===================================
# To Start and stop Traces for 1586
#===================================

Init Trace color
    ${consTraceColor}               Evaluate                    "${CYAN}"
    ${consTraceColorBlack}          Evaluate                    "${BLACK}"
    ${consTraceColorRed}            Evaluate                    "${RED}"
    ${consTraceColorGreen}          Evaluate                    "${GREEN}"
    ${consTraceColorYellow}         Evaluate                    "${YELLOW}"
    ${consTraceColorBgBlue}         Evaluate                    "${BG_BLUE}"
    ${consTraceColorBgYellow}       Evaluate                    "${BG_YELLOW}"
    ${consTraceColorBgRed}          Evaluate                    "${BG_RED}"
    ${defColor}                     Evaluate                    "${NORMAL}"
    Set Suite Variable              ${consTraceColor}
    Set Suite Variable              ${consTraceColorBlack}
    Set Suite Variable              ${consTraceColorRed}
    Set Suite Variable              ${consTraceColorGreen}
    Set Suite Variable              ${consTraceColorYellow}
    Set Suite Variable              ${consTraceColorBgBlue}
    Set Suite Variable              ${consTraceColorBgYellow}
    Set Suite Variable              ${defColor}
    Set Suite Variable              ${consTraceColorBgRed}

Clean Up Env
    [Arguments]    ${host_ip}=localhost
    [Documentation]    This keyword is to clean up testline process such as btslog and so on.
    ...    Examples:
    ...    | Clean Up Env |
    ${HOME}=    Get Environment Variable    name=HOME
    Run Keyword If     '${host_ip}'=='127.0.0.1' or '${host_ip}'=='localhost'    Run Keywords    Run     ${kill_btslog}
    ...     AND     Run   ${kill_dpkg}
    ...     AND     Run   ${kill_sherpa}
    ...     AND     Run   ${kill_tcpdump}
    ...     AND     Run    rm /tmp/admin_api_*.txt -f
    ...     AND     Run    rm /tmp/disconnect*.ims2 -f
    ...     AND     Run    rm ${EXECDIR}/admin_api_*.txt -f
    ...     AND     Run    rm ${EXECDIR}/disconnect*.ims2 -f
    ...     AND     Run    rm ${HOME}/SosReport*.tgz -f
    ...     AND     Run    rm ${HOME}/WTS*.tgz -f
    ...     AND     run keyword and ignore error   Run   command=cd ${EXECDIR}; find . -name '*disconnect*.ims2' -type f -print -exec rm -rf {} \\;
    ...     AND     Run    rm /tmp/*.pcap* -rf
    ...     AND     Run    rm /tmp/*.pcap -rf
    ...     AND     Run    sudo rm /tmp/*.pcap* -rf
    ...     AND     Dated log      Clean Up Env ===> Save sudo df -kh in df_kh.txt
    ...     AND     Run    sudo df -kh > ${testCaseDir}/df_kh.txt
    ...     AND     Dated log      Clean Up Env ===> Save sudo lsof -w /tmp in lsof_tmp.txt
    ...     AND     Run    sudo lsof -w /tmp > ${testCaseDir}/lsof_tmp.txt
    ...     ELSE    Run keywords    SSH.Connect To    ${host_ip}    ute    ute    alias=remote_connection
    ...     AND     SSH.Execute    ${kill_btslog}    connection=remote_connection
    ...     AND     SSH.Disconnect    connection=remote_connection

Start capture Backhaul for DSS
    ${capture_BH_GNB}=             set Backhaul Capture                     prefix=BH.XP
    ${capture_BH_GNB}=             Initialize Filter XP message Capture     capture=${capture_BH_GNB}
    set global variable            ${capture_BH_GNB}
    common_Dss_Keywords.Start capture Backhaul XP for DSS New               capture=${capture_BH_GNB}

Stop capture Backhaul for DSS
    ${pdmlFile}      common_Dss_Keywords.Stop capture for Backhaul XP DSS New     capture=${capture_BH_GNB}
    ...                                                             lua_path=/home/ute/tools/luashark/generated_luashark-9.1800.330/luashark.lua
    [return]    ${pdmlFile}

Start capture Bip and Xp for 1586
    [Documentation]                1586-C : Start capture Bip and Xp for 1586
    [Arguments]                    ${prefix}=XP_L1L2_BIP

    # set a specific name to keep the trace
    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}               Capture L1L2 Set Upon Config
    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.prefix}         set Variable   ${prefix}
    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.withTN}         set Variable   True
    Set Suite Variable              ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}

    ${capture_BH_GNB_ALL}=             set Backhaul Capture                     prefix=BH.XP.All
    set global variable            ${capture_BH_GNB_ALL}
    ${capture_BH_GNB_ALL}=             Initialize Filter XP message Capture     capture=${capture_BH_GNB_ALL}

    # ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.filter}       Get Filter all BIP msgs
    # ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.filter}       Catenate    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.filter}

    # Initialize Capture                ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}
    Capture Init                    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}   # ==== Capture Init Kw introduce 30s sleep , not very good !!!!
    Capture Start                   ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}
    common_Dss_Keywords.Start capture Backhaul XP for DSS New               capture=${capture_BH_GNB_ALL}

Start capture Bip and Xp for 1586 OLD 24012022
    [Documentation]                1586-C : Start capture Bip and Xp for 1586
    [Arguments]                    ${prefix}=XP_L1L2_BIP

    # set a specific name to keep the trace
    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}               Capture L1L2 Set Upon Config
    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.prefix}         set Variable   ${prefix}
    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.withTN}         set Variable   True
    Set Suite Variable              ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}

    # Get SCF File (SCF.xml) in test setup
    ${current_scf_fullname}    set Variable      ${LOG_PATH}/SCF.xml
    scf.load_scf     ${current_scf_fullname}
    ${ipAddr}        scf.get_value_from_scf   p_name=localIpAddr
    ...              dist_name=MRBTS-${MRBTS_ID}/TNLSVC-1/TNL-1/IPNO-1/IPIF-1/IPADDRESSV4-1
    ${ipAddress_XPIFREMOTE}  scf.get_value_from_scf   p_name=ipAddress
    ...              dist_name=MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/XPAP-1/XPIF-1/XPIFREMOTE-1

    ${filter_BH}       Catenate      '(src ${ipAddr} and dst ${ipAddress_XPIFREMOTE}) or (src ${ipAddress_XPIFREMOTE} and dst ${ipAddr})'
    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.filter}       Get Filter all BIP msgs
    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.filter}       Catenate    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.filter}    or ${filter_BH}
    # ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.filter}       set variable        ${filter}
    Dated log          CAPTURE_BH_GNB_FS_DSS.filter = ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.filter}
    ${filterBH}   Catenate  '((ip.src == ${ipAddr}) && (ip.dst == ${ipAddress_XPIFREMOTE}) )
    ...                       || ( (ip.src == ${ipAddress_XPIFREMOTE}) && (ip.dst == ${ipAddr}))'
    set suite variable   ${filterBH}

    # Initialize Capture                ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}
    Capture Init                    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}   # ==== Capture Init Kw introduce 30s sleep , not very good !!!!
    Capture Start                   ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}
    Start capture BH data on GNB

Stop capture Bip and Xp for 1586
    [Arguments]
    ${alias}                        SSH Connect                             host=${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.target.host}
    Capture Stop                   ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}
    common_Dss_Keywords.Stop capture for Backhaul XP DSS New     capture=${capture_BH_GNB_ALL}    w_pdml=False    w_traces_archived=False
    ...                                                          lua_path=/home/ute/tools/luashark/generated_luashark-9.1800.330/luashark.lua
    Run               cp ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.path} ${PCAP_PATH_TMP_VM}
    @{pcap_files_list}     set variable   ${PCAP_PATH_TMP_VM}    ${capture_BH_GNB_ALL.path}
    Merge pcap files    ${pcap_files_list}    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.path}

    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.path}
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.path}    ${testCaseDir}
    Dated Log     dss pcap file ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.path} copied into ${testCaseDir}


################################################################################################################################
#               To test DSS PM counters
################################################################################################################################


Collect PM Counters File
    ${pm_files_path}       Set Variable                 ${LOG_PATH}/PM
    BuiltIn.Log     The PM counters file collected from gnb will be stored under : ${pm_files_path}
    ${latest_pm_file_name}   Counters.Collect PM files from BTS  ${pm_files_path}
    set Suite Variable    ${LATEST_FILE}       ${latest_pm_file_name}
    # BuiltIn.Log     \n***Latest pm counters file : ${LATEST_FILE}  console=yes
    Dated Log New Line     ***Latest pm counters file : ${LATEST_FILE}
    # Log to console  \n***Latest pm counters file : ${LATEST_FILE} ***

Collect PM

#    Sleep        900s
    Set suite variable    ${pmDir}    ${LOG_PATH}/PM
    Create Directory      ${pmDir}
    Dated log          LOG_PATH/PM:${pmDir}
    ${pm_latest}       Collect PM files from BTS    ${pmDir}
    Set suite variable    ${LATEST_FILE}    ${pm_latest}

Check 1586 Counters
    [Arguments]         ${iteration}=0

    ${counter_values_M55332C00001}        Retrieve Latest Single Counter Value From Pm File         ${LATEST_FILE}               M55332C00001
    ${counter_values_M55332C00002}        Retrieve Latest Single Counter Value From Pm File         ${LATEST_FILE}               M55332C00002
    ${counter_values_M55332C00003}        Retrieve Latest Single Counter Value From Pm File         ${LATEST_FILE}               M55332C00003
    ${counter_values_M55332C01001}        Retrieve Latest Single Counter Value From Pm File         ${LATEST_FILE}               M55332C01001

    ${counter_values_M55332C01002}        Retrieve Latest Single Counter Value From Pm File         ${LATEST_FILE}               M55332C01002
    ${counter_values_M55332C01003}        Retrieve Latest Single Counter Value From Pm File         ${LATEST_FILE}               M55332C01003
    ${counter_values_M55332C02001}        Retrieve Latest Single Counter Value From Pm File         ${LATEST_FILE}               M55332C02001
    ${counter_values_M55332C02002}        Retrieve Latest Single Counter Value From Pm File         ${LATEST_FILE}               M55332C02002

    BuiltIn.Log       \n ***DSS DL Ratio: Number of DL Slots assigned to NR (M55332C00001)            console=yes
    BuiltIn.Log          ***DSS DL Ratio: Total number of available DL Slots (M55332C02001)            console=yes
    BuiltIn.Log          ***DSS DL Ratio: M55332C00001=${counter_values_M55332C00001}           console=yes
    BuiltIn.Log          ***DSS DL Ratio: M55332C02001=${counter_values_M55332C02001}           console=yes
    BuiltIn.Log          ***DSS DL Ratio: ${counter_values_M55332C00001}/${counter_values_M55332C02001}           console=yes
    # Log to console  \n***DSS DL Ratio: ${counter_values_counter_values_1} ${counter_values_M55332C02001}  ***

    BuiltIn.Log       \n ***DSS DL Ratio: Number of DL Slots assigned to NR with maximum share (M55332C00002)            console=yes
    BuiltIn.Log          ***DSS DL Ratio: Number of DL Slots assigned to NR with minimum share (M55332C00003)            console=yes
    BuiltIn.Log          ***DSS DL Ratio: M55332C00002=${counter_values_M55332C00002}           console=yes
    BuiltIn.Log          ***DSS DL Ratio: M55332C00003=${counter_values_M55332C00003}           console=yes
    BuiltIn.Log          ***DSS DL Ratio: ${counter_values_M55332C00002}/${counter_values_M55332C00003}           console=yes

    ${dl_ratio}    Evaluate     (round(${counter_values_M55332C00001})/round(${counter_values_M55332C02001}))*100

    BuiltIn.Log          \n***DSS DL Ratio : ${dl_ratio}           console=yes

    BuiltIn.Log       \n ***DSS UL Ratio: Number of UL PRBs assigned to NR (M55332C01001)            console=yes
    BuiltIn.Log          ***DSS UL Ratio: Total number of available UL PRBs (M55332C02002)            console=yes
    BuiltIn.Log          ***DSS UL Ratio: M55332C01001=${counter_values_M55332C01001}            console=yes
    BuiltIn.Log          ***DSS UL Ratio: M55332C02002=${counter_values_M55332C02002}            console=yes
    BuiltIn.Log          ***DSS UL Ratio: ${counter_values_M55332C01001}/${counter_values_M55332C02002}           console=yes

    BuiltIn.Log       \n ***DSS UL Ratio: Number of UL PRBs assigned to NR with maximum share (M55332C01002)            console=yes
    BuiltIn.Log          ***DSS UL Ratio: Number of UL PRBs assigned to NR with minimum share (M55332C01003)            console=yes
    BuiltIn.Log          ***DSS UL Ratio: M55332C01002=${counter_values_M55332C01002}           console=yes
    BuiltIn.Log          ***DSS UL Ratio: M55332C01003=${counter_values_M55332C01003}            console=yes
    BuiltIn.Log          ***DSS UL Ratio: ${counter_values_M55332C01002}/${counter_values_M55332C01003}           console=yes

    ${ul_ratio}    Evaluate     (round(${counter_values_M55332C01001})/round(${counter_values_M55332C02002}))*100

    BuiltIn.Log        \n***DSS UL Ratio : ${ul_ratio}           console=yes

    # deviation_in_percent = 10 %, the target are 70% for DL DSS and 70 % for UL DSS , linked to DL and UL pattern used for the test
    ${min}=                         Evaluate                                70 * (100 - 10) / 100
    ${max}=                         Evaluate                                70 * (100 + 10) / 100
    ${status}=                      Evaluate                                ${min} <= ${dl_ratio} <= ${max}
    Run Keyword If                  '${status}'=='True'
    ...    Dated Log                Average DL DSS Ratio REACHED: expected = 70 , current = ${dl_ratio}
    ...    ELSE
    ...    Dated Log                Average DL DSS RATIO NOT REACHED: expected = 70, current = ${dl_ratio}
    Run Keyword If                  '${status}'!='True'                     Fail    DL DSS Ratio

    ${status}=                      Evaluate                                ${min} <= ${ul_ratio} <= ${max}
    Run Keyword If                  '${status}'=='True'
    ...    Dated Log                Average UL DSS Ratio REACHED: expected = 70 , current = ${ul_ratio}
    ...    ELSE
    ...    Dated Log                Average UL DSS RATIO NOT REACHED: expected = 70, current = ${ul_ratio}
    Run Keyword If                  '${status}'!='True'                     Fail    UL DSS Ratio

    # 5min = 300 s
    # DL RATIO = 70 %
    # 300 * 1000 * 0.7 = 210000
    # M55332C00002   Check value with tolerance = 10%
    ${min}=                         Evaluate                                210000 * (100 - 10) / 100
    ${max}=                         Evaluate                                210000 * (100 + 10) / 100
    ${status}=                      Evaluate                                ${min} <= ${counter_values_M55332C00002} <= ${max}
    Run Keyword If                  '${status}'=='True'
    ...    Dated Log                M55332C00002 value REACHED: expected = 210000 , current = ${counter_values_M55332C00002}
    ...    ELSE
    ...    Dated Log                M55332C00002 value NOT REACHED: expected = 210000, current = ${counter_values_M55332C00002}
    Run Keyword If                  '${status}'!='True'                     Fail    M55332C00002


# get PM files
Collect gNB files
    Create directories for log
    ${dest_dir}=    SET VARIABLE    ${LOG_PATH}
    log to console       !!! dest_dir of PM counter collection :  ${LOG_PATH}
    ${collection_name_dir}=    SET VARIABLE    gnb_pm_counters
    5GC0001329-A_Counters_Keywords.Generic Collect PM files
    ...    ${tl.gnbs[0].cu.oam_http_connection_details.addr}
    ...    ${tl.gnbs[0].cu.oam_http_connection_details.username}
    ...    ${tl.gnbs[0].cu.oam_http_connection_details.password}
    ...    ${tl.gnbs[0].cu.oam_http_connection_details.port}
    ...    ${dest_dir}
    ...    ${collection_name_dir}


# to get PM file at the end of  ths test
Collect PM Counters file and filter last file coam
    Collect PM Counters file coam
    # Filter last PM Counters file coam

Collect PM Counters file coam
    [Arguments]         ${TEST_LOG_PATH}=${LOG_PATH}
    BuiltIn.Log To Console    \nuploading pm file from coam
    ${webservice}               Create Dictionary
    ...            host=${tl.gnbs[0].cu.oam_http_connection_details.addr}
    ...            user=${tl.gnbs[0].cu.oam_http_connection_details.username}
    ...            password=${tl.gnbs[0].cu.oam_http_connection_details.password}
    ...            port=443

    tafpmcounters.create pm collector
    ...    name=gnb_pm_counters
    ...    webservice=${webservice}
    ...    oam_type=coam
    tafpmcounters.setup collectors
    ...    names=gnb_pm_counters
    tafpmcounters.collect collectors
    ...    names=gnb_pm_counters
    ...    target_dir=${TEST_LOG_PATH}
    tafpmcounters.teardown collectors
    ...    names=gnb_pm_counters

Filter last PM Counters file coam
    ${rc}    ${all_pm_file}    Run And Return Rc And Output    ls -r ${LOG_PATH}/${coam_pm_file_path}/PM*ANY.xml
    ${result}    set variable if    '${rc}'=='${0}'    pass    fail
    run keyword if     '${result}'=='fail'    Fail    no measurement file available
    ${temp}    split to lines    ${all_pm_file}
    ${pm_file_name_with_path}    set variable    ${temp[0]}
    ${pm_file_name}    replace string     ${pm_file_name_with_path}    ${LOG_PATH}/${coam_pm_file_path}/    ${EMPTY}

    Run    mv ${pm_file_name_with_path} ${LOG_PATH}/.
    Run    rm ${LOG_PATH}/${coam_pm_file_path}/PM*ANY.xml
    Run    mv ${LOG_PATH}/PM*ANY.xml ${LOG_PATH}/${coam_pm_file_path}/.

    ${file_string}   Get Binary File   ${pm_file_name_with_path}
    ${file_string}  Replace String    ${file_string}  ><  >\n<   count=-1
    Create File    ${LOG_PATH}/pm.xml    ${file_string}

    BuiltIn.Set Test Variable    ${pmCounter_xml_file}    ${LOG_PATH}/pm.xml

    Run Keyword if    '${bts_type}'=='classical'    Return From Keyword    ${pm_file_name_with_path}

    @{pm_parts}   split_string   ${pm_file_name}   _
    ${pm_file_date}    set variable   ${pm_parts[2]}
    @{pm_file_chars}    split string to characters    ${pm_file_date}
    ${pm_file_yyyymmdd}    set variable    ${pm_file_chars[0]}${pm_file_chars[1]}${pm_file_chars[2]}${pm_file_chars[3]}-
    ${pm_file_yyyymmdd}    set variable    ${pm_file_yyyymmdd}${pm_file_chars[4]}${pm_file_chars[5]}-${pm_file_chars[6]}${pm_file_chars[7]}

    ${pm_file_time}    set variable   ${pm_parts[3]}
    @{pm_file_chars}    split string to characters    ${pm_file_time}
    ${pm_file_hhmmss}    set variable    ${pm_file_chars[0]}${pm_file_chars[1]}:${pm_file_chars[2]}${pm_file_chars[3]}:
    ${pm_file_hhmmss}    set variable    ${pm_file_hhmmss}${pm_file_chars[4]}${pm_file_chars[5]}

    ${pm_file}          set variable    ${pm_file_yyyymmdd} ${pm_file_hhmmss}

    ${diff}    subtract date from date    ${pm_file}    ${time_before_detach}    result_format=number     exclude_millis=true
    ${meas_period_sec}    evaluate    ${measurement_period_in_min}*60

    ${result}    set variable if    0 < ${diff} < ${meas_period_sec}   pass    fail
    run keyword if     '${result}'=='fail'    Fail    no valid measurement file found

################################################################################################################################
#              END :  To test PM
################################################################################################################################

Enable BLER on F1 side
    [Documentation]                 KW used to enable BLER on DU side. BLER profile is supposed to be
    ...                             configure inside WTS cfg file:
    ...                                     <testModeBler index="0">
    ...                                         <dlBlerTargetUe index="0">200</dlBlerTargetUe>
    ...                                         <dlBlerTargetUe index="1">100</dlBlerTargetUe>
    ...                                         <dlBlerTargetUe index="2">100</dlBlerTargetUe>
    ...                                         <dlBlerTargetUe index="3">0</dlBlerTargetUe>
    ...                                         <dlBlerTargetUe index="4">0</dlBlerTargetUe>
    ...                                         <dlBlerTargetUe index="5">0</dlBlerTargetUe>
    ...                                         <dlBlerTargetUe index="6">0</dlBlerTargetUe>
    ...                                         <dlBlerTargetUe index="7">0</dlBlerTargetUe>
    ...                                         <ulBlerTargetUe>0</ulBlerTargetUe>
    ...                                     </testModeBler>
    ...                             Call to taf function wtsemu.ue_testmode_set_param is replaced by a custom call as the option test_mode
    ...                             no more exist and is now testmode (no _).
    [Arguments]                     ${ueSetting}

    ute_wtssim.setup_egate      egate_port=${tl.core.egate_port}
    ...                         host_ip=${tl.core.default_ssh_connection_details.addr}
    ...                         tool_dir=${tl.core.dir_path}
    ...                         alias=egate
    ...                         ssh_user=ute
    ...                         ssh_pass=ute

    ute_wtssim.execute_egate_command    cmd=ue_testmode_set id=${ueSetting.ue} bearer=2 testmode=bler profile_index=0 action=activate    alias=egate
    ute_wtssim.teardown_egate    alias=egate

Disable BLER on F1 side
    [Documentation]                 KW used to disable BLER on DU side. . BLER profile is supposed to be
    ...                             configure inside WTS cfg file
    ...                             Call to taf function wtsemu.ue_testmode_set_param is replaced by a custom call as the option test_mode
    ...                             no more exist and is now testmode (no _).
    [Arguments]                     ${ueSetting}

    ute_wtssim.setup_egate      egate_port=${tl.core.egate_port}
    ...                         host_ip=${tl.core.default_ssh_connection_details.addr}
    ...                         tool_dir=${tl.core.dir_path}
    ...                         alias=egate
    ...                         ssh_user=ute
    ...                         ssh_pass=ute

    ute_wtssim.execute_egate_command   cmd=ue_testmode_set id=${ueSetting.ue} bearer=2 testmode=bler profile_index=0 action=deactivate   alias=egate
    ute_wtssim.teardown_egate    alias=egate

######################################################################################################################
#  Basic procedure
######################################################################################################################

Initialize Colors
    [Documentation]    :   Initialize Colors
    ${BLACK}   set variable    "\\033[30m"
    ${black}=   Evaluate   "${BLACK}"
    Set suite Variable  ${black}
    ${red}=   Evaluate   "${RED}"
    Set suite Variable  ${red}
    ${blue}=   Evaluate   "${BLUE}"
    Set suite Variable  ${blue}
    ${green}=   Evaluate   "${GREEN}"
    Set suite Variable  ${green}
    ${normal}=   Evaluate   "${NORMAL}"
    Set suite Variable  ${normal}

Connect to test pc proxy
    [Documentation]    :
    ...    It is needed when there is different test_pc for each unit.
    ...    In such case "tl.test_pc.connections" is required
    [Arguments]    ${gnb_id}
    ${gnb_test_pc}=    5GC001586_Keywords.Get Test PC for Object    ${tl.gnbs[${gnb_id}]}
    ${alias}=    Set variable    gnb-${gnb_id}-test_pc
    ssh.Connect_to      hostname=${gnb_test_pc.default_ssh_connection_details.addr}
    ...                 username=${gnb_test_pc.default_ssh_connection_details.username}
    ...                 password=${gnb_test_pc.default_ssh_connection_details.password}
    ...                 alias=${alias}
    [Return]    ${alias}


Get Test PC for Object
    [Documentation]    :
    [Arguments]    ${obj}
    ${result}=    Evaluate    [test_pc for test_pc in $tl.test_pcs for obj in test_pc.connections if obj is $obj][0]
    [Return]    ${result}

Connect to gNB Common Unit
    [Documentation]    :
    ...     setup ssh connection to Airscale (ASXX) and returns connection handle/alias
    ...
    ...     :param gnb_id:         Id of gnb                       [0.. ]  default=0
    ...     :param du_id:          Id of DU                        [0.. ]  default=0
    ...     :param comu_id:        Id of Common Unit               [0..1]  default=0
    ...     :param alias:       (optional) connection alias  !! should not be used
    ...
    ...     :returns alias:     alias for ssh connection to Common Unit
    ...
    ...     **Example:**
    ...
    ...     | ${asxx_alias}=   connect.Connect to gNB Common Unit    gnb_id=0  du_id=0  comu_id=0
    ...     | ssh.execute     command=uptime  connection=${asxx_alias}
    ...
    [Arguments]    ${gnb_id}=${0}  ${du_id}=${0}  ${comu_id}=${0}  ${alias}=ssh-gnb-${gnb_id}-${du_id}-${comu_id}
    ${test_pc_connection_count}=   Get Length    ${tl.test_pc.connections}
    # ${proxy}   Run keyword If   ${test_pc_connection_count}==0       5GC001586_Keywords.Connect to test pc proxy    gnb_id=${gnb_id}
    # ...    ELSE    Set variable    ${None}
    ${proxy}    Set variable    ${None}
    ssh.Connect_to      hostname=${tl.gnbs[${gnb_id}].dus[${du_id}].airscale.common_units[${comu_id}].lmp_connection.addr}
    ...                 username=${tl.gnbs[${gnb_id}].dus[${du_id}].airscale.common_units[${comu_id}].lmp_connection.username}
    ...                 password=${tl.gnbs[${gnb_id}].dus[${du_id}].airscale.common_units[${comu_id}].lmp_connection.password}
    ...                 alias=${alias}
    ...                 proxy=${proxy}
    ssh.Force Reconnect    ${alias}
    [Return]    ${alias}

Check Airscale Board Status
    [Documentation]    [PRIVATE]
    ...
    ...     :param alias:               ssh connnection alias to common unit board
    ...     :param board_id:            Board ID
    ...     :param CCS_Daemon_node_id:  CC&S Node Id
    [Arguments]     ${alias}  ${board_id}    ${CCS_Daemon_node_id}
    ssh.Force Reconnect    ${alias}
    ${sys_result}=  ssh.execute
    ...     command=PYTHONPATH=/opt/hwmt/python python3 /opt/hwmt/python/hwapi/AdetS.py -s -p 15004 -n ${CCS_Daemon_node_id} | grep ${board_id}
    ...     connection=${alias}
    ...     timeout=60 sec
    Should Contain  ${sys_result}   ready[0]

Set Reset Loop Counter
    [Documentation]                 INTERNAL USAGE
    ...                             ddal -s ddal_boot_set_reset_loop_count 0
    [Arguments]                     ${rlc_number}=0

    Dated log                       Initialize reset_loop_count on ${GNB_DU.name} (command =ddal -s ddal_boot_set_reset_loop_count ${rlc_number})
    ${alias}                        SSH Connect                          ${GNB_DU.sys[0].M}
    ${file}                         SSH Cmd                              command=ddal -s ddal_boot_set_reset_loop_count ${rlc_number}
    ...                             alias=${alias}

Restart
    [Tags]                          RESTART
    [Arguments]                     ${isOAMRebooted}=${False}       ${OwnTLReset}=${False}    ${GNBCallback}=None

    Run keyword if      '${OwnTLReset}'=='${False}'      Restart TL       isOAMRebooted=${isOAMRebooted}
    ...                                                                   GNBCallback=${GNBCallback}
    ...         ELSE       Private Restart Gnb Classical     isOAMRebooted=${isOAMRebooted}

##################################################################################################################
#  WTS , X2  and XP Link Setup
##################################################################################################################

execute eGate Command
    [Arguments]                 ${command}    ${egate_alias}=egate    ${edaemon_alias}=edaemon
    ute_wtssim.setup_egate      egate_port=${tl.core.egate_port}
    ...                         host_ip=${tl.core.default_ssh_connection_details.addr}
    ...                         tool_dir=${tl.core.dir_path}
    ...                         alias=egate
    ...                         ssh_user=ute
    ...                         ssh_pass=ute
    ute_wtssim.setup_edaemon    edaemon_port=${tl.core.edaemon_port}
    ...                         host_ip=${tl.core.default_ssh_connection_details.addr}
    ...                         tool_dir=${tl.core.dir_path}
    ...                         alias=edaemon
    # ute_wtssim.execute_egate_command_and_wait_for_data    cmd=pdn_connect_ue ue=1 pdn=2    alias=egate_alias
    # ute_wtssim.execute_egate_command_and_wait_for_data    cmd=ue_dc_modify_enb ue=1 bearer_to_add=8
    #      by=enb cause=RN_sCG_Mobility    alias=egate_alias
    ute_wtssim.execute_egate_command    cmd=${command}    alias=egate
    ute_wtssim.teardown_egate    alias=egate
    ute_wtssim.teardown_edaemon    alias=edaemon

Clean Old WTS Logs to remove
    [Documentation]                 Clean unnecessary logs created
    ${alias}            SSH connect     host=${HOST_EPCSIM}
    Run Keyword And Ignore Error       ssh.execute    cd ${tl.core.dir_path} && sudo rm *.log.* && sudo rm *.tgz
    ...                                                          connection=${alias}

Setup WTS to remove
    [Arguments]              ${remove_logs}=False

    Run keyword if    '${remove_logs}'=='True'    SSH Connect    host=${HOST_EPCSIM}
    Run keyword if    '${remove_logs}'=='True'    ssh.execute    cd ${tl.core.dir_path} && sudo rm *.log.* && sudo rm *.tgz
    ...                                                          connection=${HOST_EPCSIM.alias}

    CallSetup.WTS Setup

Start WTS and setup X2 link to remove
    [Arguments]                 ${egate_alias}=egate    ${edaemon_alias}=edaemon
    Setup WTS    remove_logs=True
    Launch WTS   egate_alias=${egate_alias}

Start WTS to remove
   [Arguments]                 ${egate_alias}=egate    ${edaemon_alias}=edaemon    ${shouldUseLua}=${False}    ${nbUe}=1
    Setup WTS Only    shouldUseLua=${shouldUseLua}    nbUe=${nbUe}
    Launch WTS   egate_alias=${egate_alias}

Check wts in active state
    [Documentation]    [PRIVATE]    check that wts is in state active
    [Arguments]                 ${alias}=EPCSIM
    Log To Console    \n***check if wts in active state with alias=${alias}***
    Wait Until Keyword Succeeds    5 min    20 sec    5GC001586_Keywords.Check wts state   alias=${alias}
    Log To Console    ***check if wts in active state ended

Check wts state
    [Documentation]    [PRIVATE]    check that wts is in state active
    [Arguments]                 ${alias}=EPCSIM
    wts.execute egate command and wait for data
    ...    cmd=sim_state_disp
    ...    pass_regexp=The state is ACTIVE   alias=${alias}

Wait Xp link Up
    [Documentation]    [PRIVATE]    wait Xp link up
    [Arguments]                 ${alias}=EPCSIM
    Wait Until Keyword Succeeds    2 min    20 sec    5GC001586_Keywords.Xp link setup Up   alias=${alias}

Xp link Setup Up
    [Arguments]          ${timeout}=20       ${alias}=EPCSIM
    Log to console  \n***Activate eNBSim with XpAp interface [eNBId=${Param.Context.eNBId} and gNBId=${Param.Context.gNBId}] with alias=${alias}***
    wts.execute egate command    cmd=enb_xp_param id=${Param.Context.eNBId} ignore_xp=off xp_listening_socket=on    alias=${alias}
    wts.execute egate command    cmd=enb_xp_param id=${Param.Context.eNBId} xp_peers=${Param.Context.gNBId}    alias=${alias}
    ${output}=    wts.execute egate command and wait for data    cmd=enb_xp_link_up enb=${Param.Context.eNBId} target=${Param.Context.gNBId}
    ...                                            pass_regexp=(XpAP Link .* is up|Xp Link is already active)   timeout=${timeout}  alias=${alias}
    ${output}         Get Lines Matching Regexp    ${output}    XpAP Link .* is up   partial_match=${TRUE}
    Log to Console    ${output}
    ${output}         Get Lines Matching Regexp    ${output}    Xp Link is already active   partial_match=${TRUE}
    Log to Console    ${output}
    # wts.execute egate command and wait for data    cmd=enb_xp_link_up enb=${Param.Context.eNBId} target=${Param.Context.gNBId}
    # ...                                                pass_regexp=XpAP Link .* is up   timeout=${timeout}  alias=${alias}
    # sometimes the link falls, and come back again after 4-5 seconds, so we add a sleep here
    Traced sleep    10s
    Log to console  \n***Activate eNBSim with XpAp interface completed ***

Xp link Setup
    [Arguments]                 ${alias}=EPCSIM
    Log to console  \n***Activate eNBSim with XpAp interface [eNBId=${Param.Context.eNBId} and gNBId=${Param.Context.gNBId}] with alias=${alias}***

    wts.execute egate command    cmd=enb_xp_param id=${Param.Context.eNBId} ignore_xp=off xp_listening_socket=on    alias=${alias}
    wts.execute egate command    cmd=enb_xp_param id=${Param.Context.eNBId} xp_peers=${Param.Context.gNBId}    alias=${alias}
    wts.execute egate command and wait for data    cmd=enb_xp_link_up enb=${Param.Context.eNBId} target=${Param.Context.gNBId}
    ...                                              pass_regexp=XpAP Link .* is up   timeout=120  alias=${alias}
    # sometimes the link falls, and come back again after 4-5 seconds, so we add a sleep here
    Traced sleep    10s
    Log to console  \n***Activate eNBSim with XpAp interface completed ***

    ${ute_wtssim_interface}    Get Library Instance    wts
    set suite variable     ${wtsObj}      ${ute_wtssim_interface}

X2Ap link Setup to remove
    [Arguments]                 ${alias}=EPCSIM
    Log to console  \n***Activate eNBSim with X2Ap interface [eNBId=${Param.Context.eNBId} and gNBId=${Param.Context.gNBId}] with alias=${alias}***

    wts.execute egate command and wait for data    cmd=enb_x2_link_up enb=${Param.Context.eNBId} target=${Param.Context.gNBId}
    ...                                                     pass_regexp=X2AP Link .* is up    timeout=60   alias=${alias}
    # sometimes the link falls, and come back again after 4-5 seconds, so we add a sleep here
    Traced sleep    10s
    Log to console  \n***Activate eNBSim with X2AP interface completed ***


Store Current swconfig from Airphone
    [Documentation]    :
    ...    in case testcase needs to modify swconfig.txt on Airphone, collect current one as backup, Set path as Suite Variable ${P_ORIG_AP_SWCONFIG}
    ...
    ...    :param ue_id:      Id of ue                       [0.. ]  default=0
    ...    :param comu_id:    Id of Common Unit              [0..1]  default=0
    ...    :param target_dir: where to save original swconfig.txt, default with testline.Get Test Suite Config Directory
    ...
    ...    **Example:**
    ...    | wts_ue.Store Current swconfig from Airphone
    ...
    [Arguments]    ${ue_id}=${0}    ${comu_id}=${0}    ${target_dir}=None
    ${ORIG_SWCONFIG}=    5GC001586_Keywords.Get swconfig from Airphone    ue_id=${0}    comu_id=${0}    target_dir=${target_dir}
    Run    mv ${ORIG_SWCONFIG} ${ORIG_SWCONFIG}.orig
    Set Suite Variable    ${P_ORIG_AP_SWCONFIG}    ${ORIG_SWCONFIG}.orig

Connect to Airphone Common Unit
    [Documentation]    :
    ...     setup ssh connection to Airphone Airscale (ASXX) and returns connection handle/alias
    ...
    ...     :param ue_id:             Id of UE                       [0.. ]  default=0
    ...     :param ue_comu_id:        Id of AP Common Unit           [0..1]  default=0
    ...     :param alias:       (optional) connection alias  !! should not be used
    ...
    ...     :returns alias:     alias for ssh connection to Common Unit
    ...
    ...     **Example:**
    ...
    ...     | ${ap_alias}=   connect.Connect to Airphone Common Unit    ue_id=0  ue_comu_id=0
    ...     | ssh.execute     command=uptime  connection=${ap_alias}
    ...
    [Arguments]    ${ue_id}=${0}    ${ue_comu_id}=${0}  ${alias}=ssh-ap-${ue_id}-${ue_comu_id}
    ssh.Connect_to      hostname=${tl.ues[${ue_id}].l1.common_units[${ue_comu_id}].lmp_connection.addr}
    ...                 username=${tl.ues[${ue_id}].l1.common_units[${ue_comu_id}].lmp_connection.username}
    ...                 password=${tl.ues[${ue_id}].l1.common_units[${ue_comu_id}].lmp_connection.password}
    ...                 alias=${alias}
    ssh.Force Reconnect    connection=${alias}
    [Return]    ${alias}

Get swconfig from Airphone
    [Documentation]    :Author: Ch SAMSON
    ...
    ...     :param ue_id:         Id of gnb                       [0.. ]  default=0
    ...     :param comu_id:       Id of Common Unit               [0..1]  default=0
    ...     :param target_dir:    (default None) save swconfig to path
    ...
    ...     :return:   swconfig path for further usage
    ...
    [Arguments]    ${ue_id}=${0}    ${comu_id}=${0}    ${target_dir}=None
    ${target_dir}=    Run Keyword If    '${target_dir}'=='None'    common_Dss_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}
    ${ap_alias}=    5GC001586_Keywords.Connect to Airphone Common Unit    ue_id=${ue_id}    ue_comu_id=${comu_id}
    ssh.Download File    remote_path=/ffs/run/swconfig.txt    local_path=${target_dir}/ap_swconfig.txt    connection=${ap_alias}
    [Return]    ${target_dir}/ap_swconfig.txt


Get APL3 log from Airphone
    [Documentation]    :Author: Ch SAMSON
    ...
    ...     :param ue_id:         Id of gnb                       [0.. ]  default=0
    ...     :param comu_id:       Id of Common Unit               [0..1]  default=0
    ...     :param target_dir:    (default None) save swconfig to path
    ...
    ...     :return:   startup_l3_log for further usage
    ...
    [Arguments]    ${ue_id}=${0}    ${comu_id}=${0}    ${target_dir}=None
    ${target_dir}=    Run Keyword If    '${target_dir}'=='None'    common_Dss_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}
    ${ap_alias}=    5GC001586_Keywords.Connect to Airphone Common Unit    ue_id=${ue_id}    ue_comu_id=${comu_id}
    Dated log                       Check the startup_l3.log file: zipped or not zipped
    ssh.send command    ls -ltr /ram/startup_l3.log.xz   connection=${ap_alias}
    ${output_1}=    ssh.read output   connection=${ap_alias}
    ssh.send command    ls -ltr /ram/startup_l3.log   connection=${ap_alias}
    ${output_2}=    ssh.read output   connection=${ap_alias}
    ${lenght_1}                     Get Length                              ${output_1}
    ${length_2}                     Get Length                              ${output_2}
    Dated log                       AP startup_l3 length_xz:${lenght_1} - lenght_non_xz:${length_2}
    ${APL3_log}=    Set Variable If                 ${lenght_1} != 0                        startup_l3.log.xz
    ...                                             ${length_2} != 0                        startup_l3.log
    ...                                                                                     startup_l3.log
    ssh.Download File    remote_path=/ram/${APL3_log}    local_path=${target_dir}/ap_${APL3_log}    connection=${ap_alias}
    [Return]    ${target_dir}/ap_${APL3_log}


Collect egate log files
    [Documentation]    Author: Ch SAMSON
    ...    Run keyword before egate teardown
    ...
    ...
    ...    :param target_dir:   directory to store the journal file
    ...    :param wts_alias:    alias name to handle egate for ute_wtssim    default=ap_egate
    ...
    [Arguments]    ${target_dir}=None    ${wts_alias}=ap_egate
    ${target_dir}=    Run Keyword If    '${target_dir}'=='None'    common_Dss_Keywords.Get testcase log directory
    ...    ELSE    Set Variable    ${target_dir}

    ute_wtssim.setup_egate      egate_port=${tl.core.egate_port}
    ...                         host_ip=${tl.core.default_ssh_connection_details.addr}
    ...                         tool_dir=${tl.core.dir_path}
    ...                         alias=ap_egate
    ...                         ssh_user=ute
    ...                         ssh_pass=ute

    ute_wtssim.collect_egate_log_files    unzip=${False}    subdirectory=${target_dir}    alias=ap_egate

    ${alias}            SSH Connect             host=${HOST_EPCSIM}
    # option h added in case of WTS folder is a link
    Dated Log      tar zcvfh WTS.tgz ${tl.core.dir_path}
    ssh.execute    tar zcvfh WTS.tgz ${tl.core.dir_path}            connection=${alias}
    ssh.execute    ls -l ${tl.core.dir_path}/* >ls-l-WTS.txt        connection=${alias}

    csn.download_file               remote_path=/home/ute/WTS.tgz
    ...                             local_path=${target_dir}/WTS.tgz
    ...                             connection=${alias}
    csn.download_file               remote_path=/home/ute/ls-l-WTS.txt
    ...                             local_path=${target_dir}/ls-l-WTS.txt
    ...                             connection=${alias}
    Dated Log                  WTS log files stored to ${target_dir}

    ute_wtssim.teardown_egate    alias=ap_egate

Collect edaemon log files
    [Documentation]    Author: Ch SAMSON
    ...    Run keyword before edaemon teardown
    ...
    ...    :param target_dir:   directory to store the journal file
    ...    :param edaemon_alias:    alias name to handle edaemon for ute_wtssim    default=ap_edaemon
    ...
    [Arguments]    ${target_dir}=None    ${edaemon_alias}=ap_edaemon
    ${target_dir}=    Run Keyword If    '${target_dir}'=='None'    Get Testcase Log Directory
    ...    ELSE    Set Variable    ${target_dir}
    ute_wtssim.setup_egate      egate_port=${tl.core.egate_port}
    ...                         host_ip=${tl.core.default_ssh_connection_details.addr}
    ...                         tool_dir=${tl.core.dir_path}
    ...                         alias=ap_edaemon
    ...                         ssh_user=ute
    ...                         ssh_pass=ute
    ute_wtssim.collect edaemon log files    unzip=${False}    subdirectory=${target_dir}    alias=ap_edaemon
    ute_wtssim.teardown_egate    alias=ap_edaemon

########################################################################################################
# cmd reset eGate
########################################################################################################
Reset_eGate
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}
    Log to console  \n***Cmd Reset eGate alias=${alias}***
    sleep   2
    wts.execute egate command    cmd=reset   alias=${alias}

#########################################################################################################
#
#               For 1586 CellSetup, 5g Call & Traffic
#
#########################################################################################################
#########################################################################################################
#   CRM DSS Cell Setup
#########################################################################################################

DSS_Cell_Setup
#     [Arguments]                 ${testParam}=Param    ${alias}=default
     [Arguments]                 ${alias}=default
     [Documentation]    This keyword is used for DSS Ph2

    Log to console   \n${blue}***DSS Phase-II CRM CellSetup BW=${Param.seq.bandwidth} with alias=${alias}*** ${normal}

    wts.execute egate command    cmd=enb_dss_param id=${Param.Context.eNBId} feature_flag=on message_sets=V1,DMS2    alias=${alias}
    Sleep   2
    wts.execute egate command    cmd=enb_cell_param enb=${Param.Context.eNBId} id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM    alias=${alias}
    Sleep   2
    wts.execute egate command    cmd=enb_dss_configure_partnership enb=${Param.Context.eNBId} cell=1 dss_peer=${Param.Context.gNBId}:1
    ...                                    alias=${alias}
    sleep   2

    ${cmd}    Catenate    enb_crm_cell_resource_reservation enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1
    ...         assigned_dl_minimum_share_to_nr=15 assigned_dl_maximum_share_to_nr=70 assigned_dl_minimum_share_to_lte=15
    ...         assigned_dl_maximum_share_to_lte=70 assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=70

    wts.execute egate command      cmd=${cmd}    alias=${alias}

    # to simulate the EN DSS UL QoS LOAD INDICATION Timer = 80ms sent into DL coord rsp
    ${cmd}    Catenate    enb_crm_param id=${Param.Context.eNBId} ul_qos_load_meas_timer=${Param.seq.qos_load_meas_timer}
    ...                                      dl_qos_load_meas_timer=${Param.seq.qos_load_meas_timer}
    Dated Log New Line       ${cmd}
    wts.execute egate command      cmd=${cmd}      alias=${alias}

    # sleep   5
    # increase the sleeping time betwenn cell resource resernation and dss estab partnership => 10 s instead of 5 s
    # sometimes, the XP dont came up at the first time !!!
    # 19:55:06.872 19:55:06.871 [37;41mACR[0m: ENB-1: Failed to connect to ENB-2 over SCTP: 9 - system connect()
    #    error. errno=99 (Cannot assign requested address)
    # 19:55:06.872 19:55:06.871 [37;41mACR[0m: ENB-1: Failed to connect to GNB-2 (10.0.1.111:32742[0]) over SCTP
    sleep    30
    wts.execute egate command   cmd=enb_dss_establish_partnership enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1
    ...                                         alias=${alias}

    # wts.execute egate command and wait for data cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1
    #     pass_regexp=CRM Partnership Creation timeout=15
    sleep   10

    5GC001586_Keywords.DSS DL Cell Resource Allocation    ${Param.seq.dl_allocated_normal_subframes}    ${alias}

    # Param variable is visible under the test suite
    5GC001586_Keywords.DSS UL Cell Resource Allocation     ${Param.seq.ULNbrOfPrb}    ${Param.scfFile.nrcell.msg1FrequencyStart}   ${alias}

    sleep    10

    log to console   \n${blue}***DSS CRM CELLSETUP BW=${Param.seq.bandwidth} completed*** ${normal}

    ${output}    wts.execute egate command and wait for data      cmd=enb_crm_status enb=${Param.Context.eNBId} cell=1       alias=${alias}
    Log To Console    \n*** enb_crm_status enb=${Param.Context.eNBId} cell=1
    Log To Console    \n${output}


DSS_Cell_Setup_M2
#     [Arguments]                 ${testParam}=Param    ${alias}=default
     [Arguments]                 ${alias}=default
     [Documentation]    This keyword is used for DSS Ph2

    Log to console  \n${blue}***DSS Phase-II CRM CellSetup BW=${Param.seq.bandwidth} with alias=${alias}*** ${normal}

    wts.execute egate command    cmd=enb_dss_param id=${Param.Context.eNBId} feature_flag=on message_sets=V1,DMS2    alias=${alias}
    Sleep   2
    wts.execute egate command    cmd=enb_cell_param enb=${Param.Context.eNBId} id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM    alias=${alias}
    Sleep   2
    wts.execute egate command    cmd=enb_dss_configure_partnership enb=${Param.Context.eNBId} cell=1 dss_peer=${Param.Context.gNBId}:1
    ...                                               alias=${alias}
    sleep   2
    ${cmd}    Catenate    enb_crm_cell_resource_reservation enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1
    ...          assigned_dl_minimum_share_to_nr=15 assigned_dl_maximum_share_to_nr=70 assigned_dl_minimum_share_to_lte=15
    ...          assigned_dl_maximum_share_to_lte=70 assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=70
    wts.execute egate command      cmd=${cmd}    alias=${alias}
    # sleep   5
    # increase the sleeping time betwenn cell resource resernation and dss estab partnership => 10 s instead of 5 s
    # sometimes, the XP dont came up at the first time !!!
    # 19:55:06.872 19:55:06.871 [37;41mACR[0m: ENB-1: Failed to connect to ENB-2 over SCTP: 9 - system connect()
    #   error. errno=99 (Cannot assign requested address)
    # 19:55:06.872 19:55:06.871 [37;41mACR[0m: ENB-1: Failed to connect to GNB-2 (10.0.1.111:32742[0]) over SCTP
    sleep    30
    wts.execute egate command  cmd=enb_dss_establish_partnership enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1
    ...                                     alias=${alias}
    # wts.execute egate command and wait for data cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1
    #     pass_regexp=CRM Partnership Creation timeout=15
    sleep   10
    5GC001586_Keywords.DSS DL Cell Resource Allocation    ${Param.seq.dl_allocated_normal_subframes}    ${alias}
    # Param variable is visible under the test suite
    5GC001586_Keywords.DSS UL Cell Resource Allocation     ${Param.seq.ULNbrOfPrb}    ${Param.seq.startPrb}   ${alias}
    sleep    10
    log to console  \n${blue}***DSS CRM CELLSETUP BW=${Param.seq.bandwidth} completed*** ${normal}

DSS DL Cell Resource Allocation
    [Arguments]     ${dl_allocated_normal_subframes}=0011101110-0111101110-0011101110-0111101110-0011101110-0111101110-0011101110-0111101110
    ...             ${alias}=default
    [Documentation]    This keyword is used for DSS Phase2
    sleep   5
    ${msg}    Catenate    DSS DL Cell Resource Allocation with allocation_start_time=immediate and
    ...                    dl_allocated_normal_subframes=${dl_allocated_normal_subframes} with alias=${alias}
    Dated Log New Line      ${msg}
    ${cmd}    Catenate      enb_dss_resource_allocation enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1 dir=DL
    ...                        allocation_start_time=immediate dl_allocated_normal_subframes=${dl_allocated_normal_subframes}
    wts.execute egate command    cmd=${cmd}     alias=${alias}
    log to console  \n***DSS DL Cell Resource Allocation completed***

DSS UL Cell Resource Allocation
    [Arguments]                 ${ULNbrOfPrb}=0x00000023     ${msg1FrequencyStart}=4      ${alias}=default
    [Documentation]    This keyword is used for DSS Phase2
    sleep   5
    ${ULNbrOfPrb_decimal}              toDecimalStr     ${ULNbrOfPrb}
    ${msg1FrequencyStart_decimal}       toDecimalStr     ${msg1FrequencyStart}
    ${msg}    Catenate     DSS UL Cell Resource Allocation with msg1FrequencyStart=${msg1FrequencyStart_decimal} and
    ...                        NbrOfPRB=${ULNbrOfPrb_decimal} with alias=${alias}
    Dated Log New Line     ${msg}
    # ${cmd}    Catenate    enb_dss_resource_allocation enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1 dir=UL
    # ...                     allocation_start_time=immediate ul_allocated_prb_list=${msg1FrequencyStart_decimal},${ULNbrOfPrb_decimal}
    ${pucchModeSelect}=     get pucchModeSelect from SCF
    # 3 PRB area defined in case of longPUCCH
    ${ul_allocated_prb_list}=     run Keyword if     '${pucchModeSelect}' == 'longPucch'
    ...            set variable      0,3|${msg1FrequencyStart_decimal},${ULNbrOfPrb_decimal}|49,3
    ...   ELSE     set variable      ${msg1FrequencyStart_decimal},${ULNbrOfPrb_decimal}
    ${cmd}    Catenate    enb_dss_resource_allocation enb=${Param.Context.eNBId} cell=1 tgt_enb=${Param.Context.gNBId} tgt_cell=1 dir=UL
    ...                     allocation_start_time=immediate ul_allocated_prb_list=${ul_allocated_prb_list}
    wts.execute egate command    cmd=${cmd}   alias=${alias}
    log to console  \n***DSS UL Cell Resource Allocation completed***

Periodic DL Fast Allocation
    [Arguments]                 ${alias}=default

    ${msg_console}=   Catenate   ***DSS ${Param.Context.DSS_Phase} CRM Periodic DL Fast Allocation BW=${Param.seq.bandwidth} with alias=${alias}***
    Log to console   \n${blue} ${msg_console} ${normal}

    ${dl_allocated_normal_subframes}=  Catenate   0011101110-0111101110-0011101110-0111101110-0011101110-0111101110-0011101110-0111101110
    # ${dl_allocated_normal_subframes}=      Catenate       ${Param.seq.dl_allocated_normal_subframes}

    ${dl_prb_area_allocation_list}=    Catenate    SEPARATOR=  0:0,0+1:0,0+2:0,52+3:0,52+4:0,52+5:0,0+6:0,52+7:0,52+8:0,52+9:0,0+10:0,0+11:0,52+12:0,
    ...    52+13:0,52+14:0,52+15:0,0+16:0,52+17:0,52+18:0,52+19:0,0+20:0,0+21:0,0+22:0,52+23:0,52+24:0,52+25:0,0+26:0,52+27:0,52+28:0,52+29:0,0+30:0,
    ...    0+31:0,52+32:0,52+33:0,52+34:0,52+35:0,0+36:0,52+37:0,52+38:0,52+39:0,0+40:0,0+41:0,0+42:0,52+43:0,52+44:0,52+45:0,0+46:0,52+47:0,52+48:0,
    ...    52+49:0,0+50:0,0+51:0,52+52:0,52+53:0,52+54:0,52+55:0,0+56:0,52+57:0,52+58:0,52+59:0,0+60:0,0+61:0,0+62:0,52+63:0,52+64:0,52+65:0,0+66:0,
    ...    52+67:0,52+68:0,52+69:0,0+70:0,0+71:0,52+72:0,52+73:0,52+74:0,52+75:0,0+76:0,52+77:0,52+78:0,52+79:0,0

    5GC001586_Keywords.DSS enb crm periodic allocation pattern   dl_allocated_normal_subframes=${dl_allocated_normal_subframes}
    ...                                                          dl_prb_area_allocation_list=${dl_prb_area_allocation_list}
    ...                                                          alias=${alias}

    ${dl_allocated_normal_subframes}=  Catenate   1011111110-1111111110-1011111110-1111111110-1011111110-1111111110-1011111110-1111111110

    ${dl_prb_area_allocation_list}=    Catenate    SEPARATOR=    0:0,52+1:0,0+2:0,52+3:0,52+4:0,52+5:0,36+6:0,52+7:0,52+8:0,52+9:0,0+10:0,52+11:0,
    ...     52+12:0,52+13:0,52+14:0,52+15:0,36+16:0,52+17:0,52+18:0,52+19:0,0+20:0,52+21:0,0+22:0,52+23:0,52+24:0,52+25:0,36+26:0,52+27:0,52+28:0,
    ...     52+29:0,0+30:0,52+31:0,52+32:0,52+33:0,52+34:0,52+35:0,36+36:0,52+37:0,52+38:0,52+39:0,0+40:0,52+41:0,0+42:0,52+43:0,52+44:0,52+45:0,
    ...     36+46:0,52+47:0,52+48:0,52+49:0,0+50:0,52+51:0,52+52:0,52+53:0,52+54:0,52+55:0,36+56:0,52+57:0,52+58:0,52+59:0,0+60:0,52+61:0,0+62:0,
    ...     52+63:0,52+64:0,52+65:0,36+66:0,52+67:0,52+68:0,52+69:0,0+70:0,52+71:0,52+72:0,52+73:0,52+74:0,52+75:0,36+76:0,52+77:0,52+78:0,52+79:0,0

    5GC001586_Keywords.DSS enb crm periodic allocation pattern   dl_allocated_normal_subframes=${dl_allocated_normal_subframes}
    ...                                                          dl_prb_area_allocation_list=${dl_prb_area_allocation_list}
    ...                                                          alias=${alias}

    5GC001586_Keywords.DSS DL Cell Periodic Resource Allocation Phase3     alias=${alias}

    # Param variable is visible under the test suite
    5GC001586_Keywords.DSS UL Cell Resource Allocation Phase3     ULNbrOfPrb=${Param.seq.ULNbrOfPrb}    msg1FrequencyStart=1
    ...                                                           allocation_start_time=auto   alias=${alias}

    sleep    2s    reason=make sure the cmd take affect

    log to console   \n${blue}***DSS CRM Periodic DL Fast Allocation BW=${Param.seq.bandwidth} completed*** ${normal}

    ${output}    wts.execute egate command and wait for data      cmd=enb_crm_status enb=${Param.Context.eNBId} cell=1       alias=${alias}
    Log To Console    \n*** enb_crm_status enb=${Param.Context.eNBId} cell=1
    Log To Console    \n${output}

Periodic UL Fast Allocation
    [Arguments]                 ${alias}=default

    ${msg_console}=   Catenate   ***DSS ${Param.Context.DSS_Phase} CRM Periodic UL Fast Allocation BW=${Param.seq.bandwidth} with alias=${alias}***
    Log to console   \n${blue} ${msg_console} ${normal}

    ${ul_allocated_prb_list }=  Catenate   1,35

    5GC001586_Keywords.DSS enb crm periodic allocation pattern UL   ul_allocated_prb_list=${ul_allocated_prb_list}
    ...                                                             alias=${alias}

    ${ul_allocated_prb_list }=  Catenate   1,20

    5GC001586_Keywords.DSS enb crm periodic allocation pattern UL   ul_allocated_prb_list=${ul_allocated_prb_list}
    ...                                                             alias=${alias}

    5GC001586_Keywords.DSS UL Cell Periodic Resource Allocation Phase3     alias=${alias}

    # Param variable is visible under the test suite

    sleep    2s    reason=make sure the cmd take affect

    log to console   \n${blue}***DSS CRM Periodic UL Fast Allocation BW=${Param.seq.bandwidth} completed*** ${normal}

    ${output}    wts.execute egate command and wait for data      cmd=enb_crm_status enb=${Param.Context.eNBId} cell=1       alias=${alias}
    Log To Console    \n*** enb_crm_status enb=${Param.Context.eNBId} cell=1
    Log To Console    \n${output}

Check DSS CellSetup Phase2
    [Arguments]         ${pdmlFile}
    run Keyword if    '${mcshark_present}'=='${False}'   Check DSS CellSetup       pdmlFile=${pdmlFile}
    ...  ELSE                                            Check DSS CellSetup Phase2 Using MCShark   pdmlFile=${pdmlFile}

TC 1586-CellSetup
    [Documentation]                Generic test for 1586-C: test purpose is to setup X2, Xp and DSS
    [Arguments]                    ${param}     ${alias}=default
    Init Sequence                  ${param}
    # Critical Step                  WTS Clear
    5GC001586_Keywords.Restart     OwnTLReset=${False}    GNBCallback=5GC001586_Keywords.Set Reset Loop Counter
    # Step                           Start capture Backhaul for DSS                               depends=5GC001586_Keywords.Restart
    ${capture_BH_GNB}=             set Backhaul Capture                     prefix=BH.XP
    set global variable              ${capture_BH_GNB}
    ${capture_BH_GNB}=             Initialize Filter XP message Capture     capture=${capture_BH_GNB}
    common_Dss_Keywords.Start capture Backhaul XP for DSS New               capture=${capture_BH_GNB}    suffix=DssCellSetup
    Step                           common_Dss_Keywords.Start WTS           argument=${alias}      depends=5GC001586_Keywords.Restart
    Step                           5GC001586_Keywords.Check wts in active state       argument=${alias}     depends=common_Dss_Keywords.Start WTS
    Step                           5GC001586_Keywords.Wait Xp link Up                 argument=${alias}     depends=common_Dss_Keywords.Start WTS
    Step                           common_Dss_command.X2Ap link Setup      argument=${alias}     depends=common_Dss_Keywords.Start WTS
    # DSS_Cell_Setup use ${param} variable initialized into the Init Sequence Kw
    Step                           5GC001586_Keywords.DSS_Cell_Setup        argument=${alias}        depends=5GC001586_Keywords.Wait Xp link Up
    ${pdmlFile}                    Run Keyword if      '${TRACE_SHOULD_BE_STOP_AFTER_CELLSETUP}' == '1'
    ...                            common_Dss_Keywords.Stop capture for Backhaul XP DSS New     capture=${capture_BH_GNB}
    ...                                                                 lua_path=/home/ute/tools/luashark/generated_luashark-9.1800.330/luashark.lua
    ...                                                                 suffix=DssCellSetup
    Run Keyword if       ('${TRACE_SHOULD_BE_STOP_AFTER_CELLSETUP}' == '1') and ('${CELLSETUP_SHOULD_BE_CHECK}' == '1')
    ...                            Step        Check DSS CellSetup Phase2       argument=${pdmlFile}       depends=5GC001586_Keywords.DSS_Cell_Setup

    # Wait gNB cell 5g On air with globalCellId=1
    Critical Step                  common_Dss_CellSetup.Wait gNB cell 5g On air      globalCellId=1
    Critical Step                  5GC001586_Ue_command.Verify AP Classical Cell Setup
    [Teardown]                     GenericTest.Display diagnosis


TC 1586M2-5gCall
    [Documentation]                Generic test for 1586-C: test purpose is to setup X2, Xp and DSS
    [Arguments]                    ${param}     ${alias}=default
    Init Sequence                  ${param}
    5GC001586_Keywords.Restart     OwnTLReset=${False}     GNBCallback=5GC001586_Keywords.Set Reset Loop Counter
    Step                     Start capture Bip and Xp for 1586     prefix=Xp.L1L2Bip.DssCellSetup
    Step                     common_Dss_Keywords.Start WTS         argument=${alias}
    Step                     5GC001586_Keywords.Check wts in active state       argument=${alias}     depends=common_Dss_Keywords.Start WTS
    Step                     5GC001586_Keywords.Wait Xp link Up                 argument=${alias}     depends=common_Dss_Keywords.Start WTS
    Step                     common_Dss_command.X2Ap link Setup     argument=${alias}            depends=common_Dss_Keywords.Start WTS
    # DSS_Cell_Setup use ${param} variable initialized into the Init Sequence Kw
    Step                     5GC001586_Keywords.DSS_Cell_Setup_M2        argument=${alias}        depends=5GC001586_Keywords.Wait Xp link Up
    Step                     Stop capture Bip and Xp for 1586                                     depends=Start capture Bip and Xp for 1586
    # Wait gNB cell 5g On air with globalCellId=1
    Critical Step            common_Dss_CellSetup.Wait gNB cell 5g On air     globalCellId=1
    Critical Step            5GC001586_Ue_command.Verify AP Classical Cell Setup
    set test variable        ${logs_and_traces_flags['BackhaulTrace']}     ${True}
    5GC001586_Keywords.Start/Stop BIP/backaul Traces  call_location=before_attach  collector_name=${collector_name}_attach
    Critical Step            5GC001586_Keywords.Test SgNB Addition PRACH      depends=5GC001586_Ue_command.Verify AP Classical Cell Setup
    [Teardown]    Run Keywords   5GC001586_Keywords.Start/Stop BIP/backaul Traces  call_location=after_attach  collector_name=${collector_name}_attach
    ...              AND         set test variable        ${logs_and_traces_flags['BackhaulTrace']}     ${False}

Check DSS CellSetup
    [Documentation]      KW used to check DSS  CellSetup inside PDML file (LUA version)
    [Arguments]                     ${pdmlFile}
    ...                             ${dlAllocationSequenceNumber}=00000000
    ...                             ${ulAllocationSequenceNumber}=00000000

    Dated log                   Checking DSS CellSetup inside PDML file    ${pdmlFile}

    Dated log                   ---Checking enDssSetupReq

# XpDssMessage.XpDssMessage-Discriminator value = 02000000 means enDssSetupReq
# check enDssSetupReq
    analyzer.check_exists_once      pdmlFile=${pdmlFile}
    ...                             packetName=xp_dss_XpDssMessage
    ...                             path=.XpDssMessage.XpDssMessage-Discriminator$
    ...                             kind="value"
    ...                             value=02000000
    ...                             startPacket=${1}
    ...                             endPacket=${-1}

    Dated log                   ---Checking enDssSetupResp

# XpDssMessage.XpDssMessage-Discriminator value = 03000000 means enDssSetupResp
# check enDssSetupRsp
    analyzer.check_exists_once      pdmlFile=${pdmlFile}
    ...                             packetName=xp_dss_XpDssMessage
    ...                             path=.XpDssMessage.XpDssMessage-Discriminator$
    ...                             kind="value"
    ...                             value=03000000
    ...                             startPacket=${1}
    ...                             endPacket=${-1}

#    analyzer.check_list             pdmlFile=${pdmlFile}
#    ...                             packetName=xp_dss_XpDssMessage
#    ...                             path=xp_dss_xpdssmessage$
#    ...                             kind="showname"
#    ...                             value=enDssDlCellSubframeResourceCoordinationReq (Structure)
#    ...                             startPacket=${1}
#    ...                             endPacket=${-1}

    Dated log                   ---Checking enDssDlCellSubframeResourceCoordinationResp

# check enDssDlCellSubframeResourceCoordinationResp
#    analyzer.check_list             pdmlFile=${pdmlFile}
    analyzer.check_exists_once      pdmlFile=${pdmlFile}
    ...                             packetName=xp_dss_XpDssMessage
    ...                             path=.enDssDlQoSLoadMeasurementTimer.enDssDlQoSLoadMeasurementTimer-Items$
    ...                             kind="value"
    ...                             value=c800
    ...                             startPacket=${1}
    ...                             endPacket=${-1}

    Dated log                   ---Checking enDssUlCellSubframeResourceCoordinationResp

# check enDssUlCellSubframeResourceCoordinationResp
#    analyzer.check_list             pdmlFile=${pdmlFile}
    analyzer.check_exists_once      pdmlFile=${pdmlFile}
    ...                             packetName=xp_dss_XpDssMessage
    ...                             path=.enDssUlQoSLoadMeasurementTimer.enDssUlQoSLoadMeasurementTimer-Items$
    ...                             kind="value"
    ...                             value=c800
    ...                             startPacket=${1}
    ...                             endPacket=${-1}

    Dated log                   ---Checking enDssDlSubframeResourceAllocationResp

# check enDssDlSubframeResourceAllocationResp
    # analyzer.check_list             pdmlFile=${pdmlFile}
    analyzer.check_exists_once      pdmlFile=${pdmlFile}
    ...                             packetName=xp_dss_XpDssMessage
    ...                             path=.enDssDlSubframeResourceAllocationResp.dlAllocationSequenceNumber$
    ...                             kind="value"
    ...                             value=${dlAllocationSequenceNumber}
    ...                             startPacket=${1}
    ...                             endPacket=${-1}

    Dated log                   ---Checking enDssUlSubcarrierResourceAllocationResp

# check enDssUlSubcarrierResourceAllocationResp
#    analyzer.check_list             pdmlFile=${pdmlFile}
    analyzer.check_exists_once      pdmlFile=${pdmlFile}
    ...                             packetName=xp_dss_XpDssMessage
    ...                             path=.enDssUlSubcarrierResourceAllocationResp.ulAllocationSequenceNumber$
    ...                             kind="value"
    ...                             value=${ulAllocationSequenceNumber}
    ...                             startPacket=${1}
    ...                             endPacket=${-1}

    Dated log                   End checking DSS CellSetup inside PDML file

