TC 1586-UL_Tput_and_check
    [Documentation]                Generic test for 1586-C: test purpose is to test UL Tput Only
    [Arguments]                    ${param}
    # Capture L1L2 Set Upon Config  => means that gnbMirroring.sh will be use
    ${CaptureBIP}                   Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    # set a specific name to keep the trace
    ${CaptureBIP.prefix}   set Variable   L1L2_BIP_GNB_FS
    ${CaptureBIP.withTN}   set Variable   True
    # filter UlData_PuschReceiveReq
    Point ENB_BUILD to luashark sw package
    Point AF_PATH to current sw package
    ${CaptureBIP.filter}        Get msgId from lua package      ${param.seq.filtermsg}
    Dated log          CaptureBIP.filter = ${CaptureBIP.filter}
    Set Suite Variable       ${CaptureBIP}

    # 2022-08-03 : remove this part since luaShark is not present anymore in UTE TL => replace by MCShark
    # FOR   ${elementList}    IN    @{param.seq.filtermsg}
    # \    ${elementList}=             Catenate     SEPARATOR=;     ${elementList}
    # Dated log    Check messageId in luaShark for ${elementList}...
    # ${f}    common_Dss_Keywords.Read L1L2 filter from luaShark    ${elementList}
    # Dated log    ... messageId from luaShark for ${param.seq.filtermsg} is ${f}

    Point AF_PATH to local luashark XP package
    Point ENB_BUILD to local luashark XP package

    ${CaptureXP}                set Backhaul Capture      prefix=XP_GNB_FS
    Initialize Filter Backhaul Xn Capture                 capture=${CaptureXP}
    Set test Variable       ${CaptureXP}

    # Initialize Capture      ${CAPTURE_L1L2_GNB_FS_ASIK_DSS}
    Capture Init                     ${CaptureBIP}   # Beware that 30s sleep is added by Capture Init Kw !!!!
    ${aliasASIKGNB}       Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'    SSH Wait For Connect     ${GNB_DU.sys[0].M}
    ${tput_log_file_path_gnb}      Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'
    ...                                Start tput log capture    gnb_index=0    asik_alias=${aliasASIKGNB}
    # Start capture BH data on GNB
    Start capture Backhaul XP for DSS New      capture=${CaptureXP}    suffix=UL_Tput_and_check
    Traffic UE UL    ueSetting=${UE_SIMPLE_CellDSS}  throughput=${param.seq.ul_throughput}
    ...              duration=${param.seq.timeDuration}  shouldBeStop=True    shouldBeCheck=False   deviation=15
    ...              captureCallback=Callback Capture L1L2
    ...              capture=${CaptureBIP}  captureDuration=${param.seq.timeDuration}
    Stop capture for Backhaul XP DSS New  capture=${CaptureXP}   w_pdml=False    w_traces_archived=False
    ...                                   lua_path=/home/ute/tools/luashark/generated_luashark-9.1800.330/luashark.lua
    ...                                   suffix=UL_Tput_and_check

    # calculate waiting UL ratio based on L1L2 pcap traces
    ${sum_prb}   ${sum_prb_5min}  ${ul_ratio_to_check}  ${sum_ul_prb_allocated_to_nr}=   Sum NbrOfPrb Info from L1L2 uldata_puschreceivereq_t Pcap
    ...                                                                                                        ${param}
    ...                                                                                                        ${CaptureBIP.path}
    ${expected_ul_ratio_to_check}    set variable    100
    ${aliasASIKGNB}    Run Keyword If   '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'    SSH Wait For Connect    ${GNB_DU.sys[0].M}
    Run Keyword If   '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'   Check Throughput from aasyslog   asik_alias=${aliasASIKGNB}
    ...                                                                       tput_log_file_path_gnb_combined=${tput_log_file_path_gnb}
    Run Keyword If       '${UL_TPUT_SHOULD_BE_CHECK}' == '1'         Convert and Check Xp      ${CaptureXP}    ${expected_ul_ratio_to_check}
    Run Keyword If       '${UL_TPUT_SHOULD_BE_CHECK}' == '1'         Convert and Check Bip     ${CaptureBIP}

    [Teardown]         Run Keywords      Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureXP.path}      AND
    ...                         Run Keyword And Ignore Error    OperatingSystem.Copy File    ${CaptureXP.path}    ${testCaseDir}    AND
    ...                         Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CaptureBIP.path}     AND
    ...                         Run Keyword And Ignore Error    OperatingSystem.Copy File    ${CaptureBIP.path}    ${testCaseDir}


TC 1586-DL_UL_Tput
    [Documentation]                Generic test for 1586-C: test purpose is to test DL/UL Tput
    [Arguments]                    ${param}
    Init Sequence                  ${param}
    Dated log             Point AF_PATH to local luashark XP package
    Point AF_PATH to local luashark XP package
    Point ENB_BUILD to local luashark XP package
    Dated log     SSH on ${GNB_DU.sys[0].M.sshId}
    ${aliasASIKGNB}         SSH Wait For Connect                    ${GNB_DU.sys[0].M}
    ${tput_log_file_path_gnb}      Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'    Start tput log capture    gnb_index=0
    ...                                                                                                          asik_alias=${aliasASIKGNB}
    ${status}   ${msg}      Run Keyword And Ignore Error    Traffic UE UL DL   ueSetting=${UE_SIMPLE_CellDSS}  throughput=15   shouldBeCheck=False
    Dated log                       Calculate DL and UL throughput on gnb L2Lo case ...
    Run Keyword And Ignore Error    Check UL DL Throughput
    Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'   Check Throughput from aasyslog   asik_alias=${aliasASIKGNB}
    ...                                                                                   tput_log_file_path_gnb_combined=${tput_log_file_path_gnb}
    [Teardown]                      GenericTest.Display diagnosis


####################################################################################################################################""
#
#       Common 1586 Teardown
#
####################################################################################################################################""

Teardown 1586
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    BuiltIn.Log      \nTest ${TEST_NAME} 1586 ending   console=yes
    Produce Scout Data

    # get Alarm at the end of the test and store it into a file
    Dated log New Line  OAM Get Active Alarms to Save into file
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}

    ${active_alarms}     OAM Get Active Alarms                   oam=${GNB_DU.oam}    textFormat=${False}

    ${len}    Get Length    ${active_alarms}
    ${alarm_id_list}    Create List
    ${alarm_name_list}    Create List
    ${faultId}=     set variable if    ${isAiC}        fault_id
    ...                                                faultId
    ${faultName}=     set variable if    ${isAiC}      fault_name
    ...                                                faultName
    FOR    ${i}    IN RANGE    ${len}
          ${tmp_id}    Get From Dictionary    ${active_alarms[${i}]}    ${faultId}
          ${tmp_name_id}    Get From Dictionary    ${active_alarms[${i}]}    ${faultName}
          Append To List    ${alarm_id_list}    ${tmp_id}
          Append To List    ${alarm_name_list}    ${tmp_name_id}
    # Dated log     Active alarms: alarm_id_list=${alarm_id_list}
    # Dated log     Active alarms: alarm_name_list=${alarm_name_list}
    END
    Append To File    ${testCaseDir}/OAM_Alarms_After_${TEST_NAME}.txt     Active Alarms Id List:\n${alarm_id_list}\n\n
    Append To File    ${testCaseDir}/OAM_Alarms_After_${TEST_NAME}.txt     Active Alarms Name List:\n${alarm_name_list}\n\n

    OAM Disconnect                          ${GNB_DU.oam}

    # Restore WTS cfg file name
    Run Keyword If   '${Param.seq.bandwidth}'!='10MHz'    restoreFilename

    Dated Log         Collect /ram/startup_l3.log and egate_console.log from Airphone...
    common_Dss_Keywords.Prepare Logs Directory Path    subdir=airphone
    Run Keyword And Ignore Error     Collect EGATE console Logs
    Run keyword and Ignore error      common_Dss_Keywords.Get APL3 log from Airphone         target_dir=${testCaseDir}/airphone

    Dated Log         Collect /ffs/run/simmode/new_iphy.xml from Airphone...
    Run keyword and Ignore error      common_Dss_Keywords.Get iPhy.xml file from Airphone    target_dir=${testCaseDir}/airphone

    robot_extension.Run Keyword And Warn On Failure   Extract egate_command   dir=${testCaseDir}  egate_console=egate_console.log

    # check here that there is no DSS alarm at the end of the test
    common_Dss_Keywords.Check Dss active Alarm Should not be present

    common_Dss_Keywords.Get Gnb Snapshot if TestCase Failed

    # wts.stop_and_collect_wts_logs   subdirectory=${LOG_PATH}
    wts.teardown_all_aliases_for_egate
    wts.teardown_all_aliases_for_edaemon

    [Teardown]      Run Keywords    GenericTest.Display diagnosis        AND
    ...                             Collect Logs if needed   ${alias}    AND
    ...                             set Suite Variable  ${testCaseDir}  None


Teardown 1586 M2
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    BuiltIn.Log      \nTest ${TEST_NAME} 1586 M2 ending   console=yes
    Produce Scout Data

    # get Alarm at the end of the test and store it into a file
