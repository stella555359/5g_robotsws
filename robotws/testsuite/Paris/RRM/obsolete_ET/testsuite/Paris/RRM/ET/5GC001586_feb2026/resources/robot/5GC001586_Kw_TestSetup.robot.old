&{TestDSS20Mhz_1586_J_DL_RATIO_70}       seq=${T5_DL_RATIO_70}       wtsXmlFile=${wtsXml20MHz}     scfFile=${Scf20MHzDSS_1586M}   Context=${Context}
...                       rdEnableFDMPdschDmrs_0x5801a6=0     RadParam742_0x580158=0     RadParamcprt679_A_0x590050=0
...                       RadParam_cprtrd742isPdcchPatternActivated_0x5801a1=1   RadParam_rdDynamicPdcchConfigActivation_0x59005d=1
...                       RadParam_rdSupportedUlMCS_0x580010=0x1fffffff
...                       RadParam_rdDssUlDciAggregationThreshold_0x590093=15
...                       RadParam_rdExtendK2Max_0x580226=5


*** Keywords ***
# robocop: off=unused-argument
# robocop: off=possible-variable-overwriting

##################################################################################
# TL 69 specific RAD param
##################################################################################

# 0x5801a6=0 #R&D param rdEnableFDMPdschDmrs
# 0x580158=0 # 742 disabled . activated by default
# 0x590050=0 # New CPRT 679-A deactivation. TBC if needed once 679-A will be activated by default.
## 679-A feature flag, it would activate 679-A when it equals to TRUE and deactivate 679-A when it equals to FALSE.

#CP-RT log level (default 1 in 19B, 2 in 20A)
# 0x590072=1

# L2PS
# rd742isPdcchPatternActivated
# The parameter disables/enables using PDCCH Pattern for schedulers.
# 0x5801a1=1

# CPRT
# rdDynamicPdcchConfigActivation
# Enable Dynamic Pdcch Config
# 0: disabled[Default],
# 1: enabled
# 5GC000733-I
# 0x59005d=1

##################################################################################


Update gNB Swconfig 1586-J_TO_REMOVE
    [Arguments]                      ${testParam}
    ${l2ps_rdEnableFDMPdschDmrs_0x5801a6}=      create dictionary          field=0x5801a6     value=${testParam.rdEnableFDMPdschDmrs_0x5801a6}

    # 20A Only
    ${742_0x580158}=       Run Keyword If  '${branch}' == '20A'     create dictionary    field=0x580158    value=${testParam.RadParam742_0x580158}

    # 20A Only
    # CPRT	0x590050	rdEnable679A	0x1	TRUE	679-A feature flag, it would activate 679-A
    # when it equals to TRUE and deactivate 679-A when it equals to FALSE.
    #	nicolas.nl.lefevre@nokia.com	0: Disabled [Default], 1: Enabled	unknown	5GC000679-A	unknown
    ${cprt679_A_0x590050}=    Run Keyword If  '${branch}' == '20A'  create dictionary  field=0x590050   value=${testParam.RadParamcprt679_A_0x590050}

    # CPRT activate debug trace
    ${cprt_log_level_0x590072}=       create dictionary                  field=0x590072          value=1
    ${l2ps_rdSupportedUlMCS_0x580010}=      create dictionary   field=0x580010        value=${testParam.RadParam_rdSupportedUlMCS_0x580010}

    # 1586-M1
    # 20A Only
    # L2PS	0x5801a1	rd742isPdcchPatternActivated	0x0	TRUE	The parameter disables/enables using PDCCH Pattern for schedulers.
    ${l2ps_rd742isPdcchPatternActivated_0x5801a1}=   Run Keyword If  '${branch}' == '20A'  create dictionary    field=0x5801a1
    ...                                                                     value=${testParam.RadParam_cprtrd742isPdcchPatternActivated_0x5801a1}
    # 20A Only
    # CPRT	0x59005d	rdDynamicPdcchConfigActivation	0x0	FALSE	Enable Dynamic Pdcch Config	xingkai.li@nokia-sbell.com	0: disabled[Default],
    #    1: enabled	unknown	5GC000733-I	unknown
    ${cprt_rdDynamicPdcchConfigActivation_0x59005d}=   Run Keyword If  '${branch}' == '20A'   create dictionary    field=0x59005d
    ...                                                                        value=${testParam.RadParam_rdDynamicPdcchConfigActivation_0x59005d}

    # 26/04/2021 : 1586-J activated by default
    # ${cprt_rdDssUlDciAggregationThreshold_0x590093}=   Run Keyword If  '${branch}' == '20A'  create dictionary   field=0x590093
    # ...                                                                         value=${testParam.RadParam_rdDssUlDciAggregationThreshold_0x590093}
    # ...       ELSE      create dictionary     field=0x590095      value=${testParam.RadParam_rdDssUlDciAggregationThreshold_0x590093}
    # ${l2ps_rdExtendK2Max_0x580226}=      Run Keyword If   '${branch}' == '20A'    create dictionary    field=0x580226
    # ...                                                                                          value=${testParam.RadParam_rdExtendK2Max_0x580226}
    # ...       ELSE     create dictionary      field=0x580221          value=${testParam.RadParam_rdExtendK2Max_0x580226}

    # ${cprt_rdDssUlDciAggregationThreshold_0x590093}=       create dictionary     field=0x590093
    # ...                            value=${testParam.RadParam_rdDssUlDciAggregationThreshold_0x590093}
    # ${l2ps_rdExtendK2Max_0x580226}=       create dictionary                  field=0x580226
    # ...                                                     value=${testParam.RadParam_rdExtendK2Max_0x580226}

    ${swconfig_gnb}=                 Create List           ${l2ps_rdEnableFDMPdschDmrs_0x5801a6}
    ...                                                    ${cprt_log_level_0x590072}
    ...                                                    ${l2ps_rdSupportedUlMCS_0x580010}
    # ...                                                    ${cprt_rdDssUlDciAggregationThreshold_0x590093}
    # ...                                                    ${l2ps_rdExtendK2Max_0x580226}
    Run Keyword If  '${branch}' == '20A'         Append To List    ${swconfig_gnb}       ${742_0x580158}
    Run Keyword If  '${branch}' == '20A'         Append To List    ${swconfig_gnb}       ${cprt679_A_0x590050}
    Run Keyword If  '${branch}' == '20A'         Append To List    ${swconfig_gnb}       ${l2ps_rd742isPdcchPatternActivated_0x5801a1}
    Run Keyword If  '${branch}' == '20A'         Append To List    ${swconfig_gnb}       ${cprt_rdDynamicPdcchConfigActivation_0x59005d}
    Set Fields in swconfig DU       param_list=${swconfig_gnb}

Set 1586 Specific RAD
    [Documentation]   Author: Ch SAMSON , set Rad parameters for 1586
    [Arguments]                      ${testParam}

    ${cprt_log_level_0x590072}=                 create dictionary      field=0x590072     value=1
    ${l2ps_rdSupportedUlMCS_0x580010}=          create dictionary      field=0x580010     value=${testParam.RadParam_rdSupportedUlMCS_0x580010}

    ${swconfig_gnb}=       run Keyword if    '${SHOULD_UPDATE_RAD}' == '1'          Create List           ${cprt_log_level_0x590072}
    ...                                                                                                   ${l2ps_rdSupportedUlMCS_0x580010}
    ...     ELSE                                                                    Create List

    [return]    ${swconfig_gnb}

Set 1586 J Specific RAD
    [Documentation]   Author: Ch SAMSON , set Rad parameters for 1586
    [Arguments]                      ${testParam}

    ${cprt_log_level_0x590072}=                 create dictionary      field=0x590072     value=1
    # ${l2ps_rdSupportedUlMCS_0x580010}=          create dictionary      field=0x580010     value=${testParam.RadParam_rdSupportedUlMCS_0x580010}
    # for testing purpose : rdDynamicUlOverloadControl= 0
    # 04/07/2022 : to desactivate the dynamic UL Overload Control functionality introduced by feature CB006784-5G-A
    # ${l2ps_rdDynamicUlOverloadControl_0x58045B}=          create dictionary      field=0x58045B     value=0
    #  remove  Create List       ${l2ps_rdDynamicUlOverloadControl_0x58045B}
    ${swconfig_gnb}=       run Keyword if    '${SHOULD_UPDATE_RAD}' == '1'          Create List   ${cprt_log_level_0x590072}
    ...     ELSE                                                                    Create List

    [return]    ${swconfig_gnb}

Test Setup 1586 C
    [Arguments]         ${testParam}

    # upload scf file, xml and cfg for DSS
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}

    csn.upload_file                 remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${CURDIR}/${cfg_wts_dss}
    ...                             connection=${alias_epc}

    Dated Log                  basic cfg file has been uploaded with default (${CURDIR}/${cfg_wts_dss})

    ${ap_configfile}                Get XML AirPhoneConfig Path
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    run Keyword if      '${ap_configfile}' != '${empty}'     csn.upload_file          remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${CURDIR}/${xml_wts_dss}
    ...                             connection=${alias_epc}

    Dated Log                 ApOamConfig has been uploaded with default (${CURDIR}/${xml_wts_dss})

    run keyword and ignore error      common_Dss_Keywords.Remove RAD param for Link Adaptation on swconfig if present

    Run Keyword If                  '${TRAFFIC_DL_RATE}' != '0'     set suite  variable    ${testParam.seq.dl_throughput}    ${TRAFFIC_DL_RATE}
    Run Keyword If                  '${TRAFFIC_UL_RATE}' != '0'     set suite  variable    ${testParam.seq.ul_throughput}    ${TRAFFIC_UL_RATE}

    Run Keyword If                  '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'      Set Specific RAD & scf parameters & iphy & WTS for DSS   ${testParam}
    ${isOAMRebooted}       Run Keyword If    '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'     SSH Was OAM Rebooted     ${GNB_DU}     timeout=60

