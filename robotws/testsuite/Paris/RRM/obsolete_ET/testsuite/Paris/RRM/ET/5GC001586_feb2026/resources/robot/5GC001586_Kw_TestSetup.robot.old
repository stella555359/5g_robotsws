    ...    value=${testParam.scfFile.xpif.sctpWaitTimeInitSeqRetry}
    ...    nodeType=${nodeType}

    &{modify_param9}    Create Dictionary
    ...    parameter=udpDscp
    ...    dist_name=MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/XPAP-1/XPIF-1
    ...    value=${testParam.scfFile.xpif.udpDscp}
    ...    nodeType=${nodeType}

    # AiC WA FOR THE MOMENT => ${IPIF-XP-ID}=2
    # ${IPIF-XP-ID}=    set variable if    ${isAiC}    2
    # ...                                              ${IPIF-XP-ID}

    @{param}    Create List    MRBTS-${MRBTS_ID}/TNLSVC-1/TNL-1/IPNO-1/IPIF-${IPIF-XP-ID}/IPADDRESSV4-1    ipV4AddressDN1
    ${f1Cplane_ADDRESS_DISTNAME}   ${f1Cplane_DN_NAME}=    run Keyword if   ${isAiC}    get ipV4AddressDN1 from DU   nodeType=Vdu
    ...   ELSE       set variable      ${param}

