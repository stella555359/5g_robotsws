Test Setup 1586 M
    [Arguments]         ${testParam}    ${btsType}=Classical

    Log to Console like Next Step     0     5GC001586_Kw_TestSetup.Test Setup 1586 M ${testParam.seq.bandwidth} for btsType=${btsType}

    Run Keyword If   '${WITH_UPLOAD_1586_CONFIGURATION}' == '1'      run keyword       Upload 1586 Configuration

    run keyword and ignore error      common_Dss_Keywords.Remove RAD param for Link Adaptation on swconfig if present

    # intialize  cellDepType with scf value
    ${nodeType}=   set variable if    '${btsType}' == 'Classical'     Classical
    ...                                                               Vdu
    ${testParam.Context.cellDepType}=   5GC001586_Kw_TestSetup.get cellDepType from SCF    nodeType=${nodeType}
    # eNBid = 2 and gNBId = 1 if SANSA TL configuration
    # BEWARE : ${WITH_UPLOAD_1586_CONFIGURATION} should be 0 in case of cellDepType == SANSA => add warning here !!!
    Run Keyword If   '${testParam.Context.cellDepType}' == 'SA+NSA'   5GC001586_Kw_TestSetup.update eNBId and gNBId In Context  ${testParam}   2   1
    ${testParam.scfFile.nrdsslte.eNodeBId}    set variable     ${testParam.Context.eNBId}

    # need to adapt minNrDssRatio for SA !!!!
    # computed sfn = 21% in case of SA and = 11% in case of NSA
    # ${testParam.scfFile.lteNrDssDlRatio.minNrDssRatio}   Run Keyword If   '${testParam.Context.cellDepType}' == 'SA+NSA'   set variable   25
    # ${testParam.seq.dl_allocated_normal_subframes}  Run Keyword If  '${testParam.Context.cellDepType}'=='SA+NSA'  set variable  ${PATTERN_DL_70_SA}

    Run Keyword If   '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'   5GC001586_Kw_TestSetup.set SCF 1586 M1 for AiC and Classical  ${testParam}
    ...                                                                                                                    btsType=${btsType}
    Run Keyword If   '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'   Modify 1586 searchSpaceDedicated related Parameters for AiC and Classical
    ...                                                                                                                    ${testParam}
    ...                                                                                                                    btsType=${btsType}
    ${1586_swconfig_gnb}=    Run Keyword If   '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'      Set 1586 Specific RAD     ${testParam}
    Run Keyword If   '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'   5GC001586_Kw_TestSetup.Set Specific RAD & scf parameters
    ...                                                                                                          ${testParam}
    ...                                                                                                          swconfig_gnb=${1586_swconfig_gnb}
    ...                                                                                                          btsType=${btsType}

    # iPHY gscn update depending of chBwDl
    Dated Log      iPHY gscn update with ${testParam.scfFile.nrcell.gscn} : chBwDl=${testParam.scfFile.nrcellfdd.chBwDl}
    common_Dss_Keywords.Set Context_AP IPHY    ${testParam}

    # default configuration is 10MHz case , nothing to do in this case
    Run Keyword If   '${testParam.seq.bandwidth}'!='10MHz'   common_Dss_Keywords.Modify Bandwidth Parameters for WTS   ${testParam}

    ${isOAMRebooted}    Run Keyword If      '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'    SSH Was OAM Rebooted     ${GNB_DU}          timeout=60

    # SCF.xml is used by procedure verifyFeatureActivation (second call here to upate it)
    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable              ${test_scf_file}
    Dated Log                  Current 1586 SCF file stored to ${test_scf_file}

    # Save current SCF file used during test cases
    ${current_scf_file}             OAM Get SCF File            dir=${testCaseDir}      file=SCF_used_for_1586_M_${testParam.seq.bandwidth}_Tests.xml
    Set Suite Variable              ${current_scf_file}
    Dated Log New Line         Current 1586-M SCF file stored to ${current_scf_file}

    # Get swconfig file that will be used during 1586-M tests
    # ${status}     ${alias_gnb}              run keyword and ignore error      SSH Wait For Connect                ${GNB_DU.sys[0].M}
    ${alias_gnb}=  Wait until keyword succeeds     10 min     10 sec
    ...     common_Dss_Keywords.Connect to gNB Common Unit  gnb_id=0  du_id=0    comu_id=0
    # run keyword and ignore error      csn.download_file               remote_path=${SWCONFIG_PATH}
    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${testCaseDir}/swconfig_used_for_1586_M_${testParam.seq.bandwidth}_Tests.txt
    ...                             connection=${alias_gnb}
    Dated Log                  Current 1586-M swconfig file stored to ${LOG_PATH}/swconfig_used_for_1586_M_${testParam.seq.bandwidth}_Tests.txt

    # Get EPC file configuration that will be used during 1586-M tests
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.download_file               remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${testCaseDir}/basic_wts_used_for_1586_M_${testParam.seq.bandwidth}_Tests.cfg
    ...                             connection=${alias_epc}

    # Get AP configuration file that will be used during 1586-M tests
    ${ap_configfile}                Get XML AirPhoneConfig Path
    run Keyword if      '${ap_configfile}' != '${empty}'     csn.download_file       remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${testCaseDir}/ApOamConfig_used_for_1586_M_${testParam.seq.bandwidth}_Tests.xml
    ...                             connection=${alias_epc}

    ${msg}=   Catenate      Current 1586-M basic file ${tl.core.cfg_filename} stored
    ...                        to ${testCaseDir}/basic_wts_used_for_1586_M_${testParam.seq.bandwidth}_Tests.cfg
    Dated Log  ${msg}
    Dated Log  Current 1586-M ApOamConfig file stored to ${testCaseDir}/ApOamConfig_used_for_1586_M_${testParam.seq.bandwidth}_Tests.xml

