Get BTS ID From vDU SCF
    [Arguments]  ${scf_path}
    [Documentation]   Get BTS ID From vDU SCF
    ...    | Input Parameters | Man. | Description |
    ...    | scf_path | yes | scf file with absolute path, it's vDU scf file. |
    ...    *RETURN VALUE*
    ...    list value, contains [<mrbts_id>, <nrbts_id>, <nrdu_id>]
    ...
    ...    Example
    ...    |  ${mrbts_id}  | ${nrbts_id} | ${nrdu_id} | Get BTS ID From vDU SCF | scf_path=/tmp/a.scf |
    ...
    ${scf_content}   OperatingSystem.Get File   ${scf_path}
    ${result}     Get Regexp Matches    ${scf_content}   .*NRDU"\\s+distName="MRBTS-(\\d+)/NRBTS-(\\d+)/NRDU-(\\d+)"\\s+.*   1  2  3
    ${mrbts_id}  Set Variable If  ${result}   ${result[0][0]}
    ${nrbts_id}  Set Variable If  ${result}   ${result[0][1]}
    ${nrdu_id}   Set Variable If  ${result}   ${result[0][2]}
    [Return]  ${mrbts_id}   ${nrbts_id}  ${nrdu_id}

Get VDU Conf From SCF
    [Arguments]  ${scf_path}=${EMPTY}   ${vdu_index}=0   ${gnb_index}=0    ${nodeType}=Classical
    [Documentation]  Get VDU Conf From SCF file.
    ...    | Input Parameters | Man. | Description |
    ...	   | scf_path  | no | abosolute path of scf file, if it's ${EMPTY} it will download scf from CURRENT plan, default is ${EMPTY} |
    ...	   | vdu_index | no | vdu_index, default is 0 |
    ...
    ...    *RETURN VALUE*
    ...    Dictionary of configuration in SCF file.
    ...    example: {'mrbts_id': '1234', 'nrbts_id': '5678', 'nrdu_id': '1', 'tnl_oam': '3',
    ...    'tnl_version': 'TNLVDU20B_2006_001' }
    ...
    ...    Example
    ...    | ${vdu_conf} | Get VDU Conf From SCF | scf_path=/home/ute/a.scf |
    ...    | ${vdu_conf} | Get VDU Conf From SCF |
    ...
    ${scf_path}   run keyword if  "${scf_path}"=="${EMPTY}"  common_Dss_Keywords.Get Temporary Scf From Current Plan    gnb_index=${gnb_index}
    ...                                                                                                                 vdu_index=${vdu_index}
    ...    ELSE    set variable  ${scf_path}

    ${mrbts_id}   ${nrbts_id}  ${nrdu_id}  Get BTS ID From vDU SCF    scf_path=${scf_path}
    # ${tnl_version}   scf.get_mo_attribute   dist_name=MRBTS-${mrbts_id}/TNLSVC-1   attribute=version     nodeType=Vdu
    ${tnl_version}   scf.get_mo_attribute    MRBTS-${mrbts_id}/TNLSVC-1     version     nodeType=${nodeType}
    # ${nrbts_version}  scf.get_mo_attribute   dist_name=MRBTS-${mrbts_id}/NRBTS-${nrbts_id}/NRDU-${nrdu_id}   attribute=version    nodeType=Vdu
    ${nrbts_version}  scf.get_mo_attribute    MRBTS-${mrbts_id}/NRBTS-${nrbts_id}/NRDU-${nrdu_id}     version    nodeType=${nodeType}
    # ${mnl_version}  scf.get_mo_attribute   dist_name=MRBTS-${mrbts_id}/MNL-1   attribute=version    nodeType=Vdu
    ${mnl_version}  scf.get_mo_attribute     MRBTS-${mrbts_id}/MNL-1    version    nodeType=${nodeType}
    # ${eqm_version}  scf.get_mo_attribute   dist_name=MRBTS-${mrbts_id}/EQM-1  attribute=version    nodeType=Vdu
    ${eqm_version}  scf.get_mo_attribute     MRBTS-${mrbts_id}/EQM-1    version    nodeType=${nodeType}
    ${conf}   create dictionary
    ...  mrbts_id=${mrbts_id}
    ...  nrbts_id=${nrbts_id}
    ...  nrdu_id=${nrdu_id}
    ...  tnl_version=${tnl_version}
    ...  nrbts_version=${nrbts_version}
    ...  mnl_version=${mnl_version}
	...  eqm_version=${eqm_version}
    [Return]  ${conf}

get ipV4AddressDN1 from DU
    [Documentation]   Get ipV4AddressDN1 from DU (Kw specific to VRAN2.0)
    [Arguments]       ${gnb_index}=0    ${vdu_index}=0    ${nodeType}=Classical

    ${scf_file_with_fullpath}      common_Dss_Keywords.Get Temporary Scf From Current Plan    gnb_index=${gnb_index}   vdu_index=${vdu_index}
    scf.Load_Scf     ${scf_file_with_fullpath}

    ${VDU_CONF}  Get VDU Conf From SCF   scf_path=${scf_file_with_fullpath}    nodeType=${nodeType}
    ${NRDU_DISTNAME}  Set Variable   MRBTS-${VDU_CONF["mrbts_id"]}/NRBTS-${VDU_CONF["nrbts_id"]}/NRDU-${VDU_CONF["nrdu_id"]}
    ${r}   Run Keyword And Ignore Error   scf.Get_Value_From_Scf
    ...      dist_name=${NRDU_DISTNAME}   list_name=f1Cplane   p_name=ipV4AddressDN1   nodeType=${nodeType}
    ${f1Cplane_ADDRESS_DISTNAME}   Run Keyword If  '${r[0]}'=='PASS'   Set Variable  ${r[1]}
    ...  ELSE    scf.Get_Value_From_Scf   dist_name=${NRDU_DISTNAME}   list_name=f1Cplane   p_name=ipV6AddressDN1   nodeType=${nodeType}
    ${f1Cplane_DN_NAME}  Set Variable If   '${r[0]}'=='PASS'   ipV4AddressDN1   ipV6AddressDN1
    [return]    ${f1Cplane_ADDRESS_DISTNAME}   ${f1Cplane_DN_NAME}

Set SCF XPIF 1586
    [Arguments]          ${testParam}      ${btsType}=Classical
