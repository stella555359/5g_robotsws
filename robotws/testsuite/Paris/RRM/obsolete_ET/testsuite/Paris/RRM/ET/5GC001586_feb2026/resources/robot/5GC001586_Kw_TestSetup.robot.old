# ADD_9
#---------------------------------------------------------------------------------------------------------------------------
# Set SCF 1586 M2 keyword for 5GC001586 testing PURPOSE
# Reuse existing keyword Set SCF 1586
#---------------------------------------------------------------------------------------------------------------------------

Set SCF 1586 M2
    [Arguments]          ${testParam}
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
#      TestParam is ${testParam}
    &{bwpp1_locationAndBandwidthUl}     Create Dictionary
    ...                 cRbSizeUl=${testParam.scfFile.Bwp_Profile1_locationAndBandwidthUl.cRbSizeUl}
    ...                 cRbStartUl=${testParam.scfFile.Bwp_Profile1_locationAndBandwidthUl.cRbStartUl}
    ${dist}=   Catenate      MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-1
    &{modify_param1}    Evaluate    {'dist_name': '${dist}','parameter': 'locationAndBandwidthUl','value':[&{bwpp1_locationAndBandwidthUl}]}
    # &{modify_param1}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-1',
    # ...                              'parameter': 'locationAndBandwidthUl','value':[&{bwpp1_locationAndBandwidthUl}]}

    &{modify_param2}    Create Dictionary
    ...    parameter=dciDedicatedAggregationLevel
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1
    ...    value=${testParam.scfFile.Bwp_Profile2_pdcch1.dciDedicatedAggregationLevel}

    &{modify_param3}    Create Dictionary
    ...    parameter=dciRaCompletionAggregationLevel
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1
    ...    value=${testParam.scfFile.Bwp_Profile2_pdcch1.dciRaCompletionAggregationLevel}

    &{modify_param4}    Create Dictionary
    ...    parameter=dciRaMsg2AggregationLevel
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1
    ...    value=${testParam.scfFile.Bwp_Profile2_pdcch1.dciRaMsg2AggregationLevel}

    &{coresetCommon}    Create Dictionary
    ...                 coresetId=${testParam.scfFile.coresetCommon.coresetId}
    ...                 cceToRegMapping=${testParam.scfFile.coresetCommon.cceToRegMapping}
    ...                 cRbStart=${testParam.scfFile.coresetCommon.cRbStart}
    ...                 duration=${testParam.scfFile.coresetCommon.duration}
    ...                 interleaverSize=${testParam.scfFile.coresetCommon.interleaverSize}
    ...                 regBundleSize=${testParam.scfFile.coresetCommon.regBundleSize}
    ...                 size=${testParam.scfFile.coresetCommon.size}
    ${dist}=   Catenate     MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1
    &{modify_param5}    Evaluate    {'dist_name': '${dist}','parameter': 'coresetCommon','value':[&{coresetCommon}]}
    # &{modify_param5}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1',
    # ...                              'parameter': 'coresetCommon','value':[&{coresetCommon}]}

    &{searchSpaceCommon}    Create Dictionary
    ...                 coresetId=${testParam.scfFile.searchSpaceCommon.coresetId}
    ...                 dciFormat=${testParam.scfFile.searchSpaceCommon.dciFormat}
    ...                 duration=${testParam.scfFile.searchSpaceCommon.duration}
    ...                 monitoringSymbolWithinSlot=${testParam.scfFile.searchSpaceCommon.monitoringSymbolWithinSlot}
    ...                 numOfPdcchCandidatesInAL16=${testParam.scfFile.searchSpaceCommon.numOfPdcchCandidatesInAL16}
    ...                 numOfPdcchCandidatesInAL2=${testParam.scfFile.searchSpaceCommon.numOfPdcchCandidatesInAL2}
    ...                 numOfPdcchCandidatesInAL4=${testParam.scfFile.searchSpaceCommon.numOfPdcchCandidatesInAL4}
    ...                 numOfPdcchCandidatesInAL8=${testParam.scfFile.searchSpaceCommon.numOfPdcchCandidatesInAL8}
    ...                 periodicity=${testParam.scfFile.searchSpaceCommon.periodicity}
    ...                 searchSpaceId=${testParam.scfFile.searchSpaceCommon.searchSpaceId}
    ...                 searchSpaceType=${testParam.scfFile.searchSpaceCommon.searchSpaceType}
    ...                 slotOffset=${testParam.scfFile.searchSpaceCommon.slotOffset}
    ${dist}=   Catenate     MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1
    &{modify_param6}    Evaluate    {'dist_name': '${dist}','parameter': 'searchSpaceCommon','value':[&{searchSpaceCommon}]}
    # &{modify_param6}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1',
    # ...                              'parameter': 'searchSpaceCommon','value':[&{searchSpaceCommon}]}

    &{searchSpaceDedicated}    Create Dictionary
    ...                 coresetId=${testParam.scfFile.searchSpaceDedicated.coresetId}
    ...                 dciFormat=${testParam.scfFile.searchSpaceDedicated.dciFormat}
    ...                 duration=${testParam.scfFile.searchSpaceDedicated.duration}
    ...                 monitoringSymbolWithinSlot=${testParam.scfFile.searchSpaceDedicated.monitoringSymbolWithinSlot}
    ...                 numOfPdcchCandidatesInAL1=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL1}
    ...                 numOfPdcchCandidatesInAL16=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL16}
    ...                 numOfPdcchCandidatesInAL2=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL2}
    ...                 numOfPdcchCandidatesInAL4=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL4}
    ...                 numOfPdcchCandidatesInAL8=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL8}
    ...                 periodicity=${testParam.scfFile.searchSpaceDedicated.periodicity}
    ...                 searchSpaceId=${testParam.scfFile.searchSpaceDedicated.searchSpaceId}
    ...                 searchSpaceType=${testParam.scfFile.searchSpaceDedicated.searchSpaceType}
    ...                 slotOffset=${testParam.scfFile.searchSpaceDedicated.slotOffset}
    ${dist}=   Catenate      MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_DEDICATED-1
    &{modify_param7}    Evaluate    {'dist_name': '${dist}','parameter': 'searchSpaceDedicated','value':[&{searchSpaceDedicated}]}
    # &{modify_param7}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_DEDICATED-1',
    # ...                              'parameter': 'searchSpaceDedicated','value':[&{searchSpaceDedicated}]}

    &{modify_param8}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsHighEdgeDL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scfFile.BlankedPRBs.nbrOfBlankedPRBsHighEdgeDL}

    &{modify_param9}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsHighEdgeUL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scfFile.BlankedPRBs.nbrOfBlankedPRBsHighEdgeUL}

    &{modify_param10}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsLowEdgeDL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scfFile.BlankedPRBs.nbrOfBlankedPRBsLowEdgeDL}

    &{modify_param11}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsLowEdgeUL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scfFile.BlankedPRBs.nbrOfBlankedPRBsLowEdgeUL}

    &{modify_param12}    Create Dictionary
    ...    parameter=aggregationLevel
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scfFile.aggregationLevel}

    &{modify_param13}    Create Dictionary
    ...    parameter=actPRBBlanking
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scfFile.actPRBBlanking}

    &{modify_param14}    Create Dictionary
    ...    parameter=trsMutingInBlankedPRBsEnabled
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scfFile.trsMutingInBlankedPRBsEnabled}

    &{modify_param15}    Create Dictionary
    ...    parameter=msg1FrequencyStart
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${testParam.scfFile.nrcell.msg1FrequencyStart}

    &{modify_param16}    Create Dictionary
    ...    parameter=btsName
    ...    dist_name=MRBTS-${MRBTS_ID}
    ...    value=${testParam.scfFile.mrbts.btsName}


    @{modify_param}    Create List
    ...       ${modify_param1}       ${modify_param2}        ${modify_param3}        ${modify_param4}        ${modify_param5}
    ...       ${modify_param6}       ${modify_param7}        ${modify_param8}        ${modify_param9}        ${modify_param10}
    ...       ${modify_param11}       ${modify_param12}      ${modify_param13}       ${modify_param14}       ${modify_param15}
    ...       ${modify_param16}

    BuiltIn.Log      \nParameters to modify:\n @{modify_param}   console=yes
    OAM Set Params      modify_param=@{modify_param}

