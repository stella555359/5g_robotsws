Get scf file name
    [Arguments]    ${scf_file_path}   ${extension}=${EMPTY}
    ${scf_file_name}    Fetch from right    ${scf_file_path}    /
    ${file_name_without_extension}    String.Replace string    ${scf_file_name}    .xml    ${EMPTY}
    ${scf_name_for_update}    catenate    SEPARATOR=${EMPTY}    ${file_name_without_extension}
    ...    ${extension}
    [return]    ${scf_name_for_update}

Delete DSS Information If Exist
    [Documentation]   Auther: Ch SAMSON
    [Arguments]    ${scf_file_path_du}     ${scf_file_path_cu}=${EMPTY}   ${nodeType}=Classical
    log to console    Delete DSS Information If Exist
    ${default_scf_file_path_du}    Copy file    source=${scf_file_path_du}    destination=${LOG_PATH}/DSS_delete/
    ${default_scf_file_path_cu}   run keyword if    '${scf_file_path_cu}'!='${EMPTY}'      Copy file    source=${scf_file_path_cu}
    ...                                                                                                 destination=${LOG_PATH}/DSS_delete/
    ...    ELSE                                                                            set variable    ${EMPTY}
    ${scf_name_for_update}=    Get scf file name     ${scf_file_path_du}    _DSS_delete.xml
    ${scf_name_for_update_cu}=    run Keyword if  '${scf_file_path_cu}'!='${EMPTY}'    Get scf file name     ${scf_file_path_cu}   _DSS_delete.xml
    ...    ELSE                                                                        set variable    ${EMPTY}
    ${scf_file_update_path}    set variable    ${LOG_PATH}/DSS_delete/${scf_name_for_update}
    ${scf_file_update_path_cu}    set variable if    '${scf_file_path_cu}'!='${EMPTY}'    ${LOG_PATH}/DSS_delete/${scf_name_for_update_cu}
    ...                                                                                    ${EMPTY}
    scf.Load scf    ${default_scf_file_path_du}
    run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Load scf    ${default_scf_file_path_cu}
    # ${MNL_version}=    scf.get_mo_attribute    MRBTS-69/MNL-1    version
    FOR    ${item}    IN    @{DSS_1586_PARAMS_TO_ADD}
         ${result}    scf.is_object_in_scf    dist_name=${item}[dist_name]    nodeType=${item}[nodeType]
         run keyword if    ${result}==True    scf.remove_mo_with_descendant_mos    dist_name=${item}[dist_name]    nodeType=${item}[nodeType]

    END
    FOR    ${item}    IN    @{DSS_1586_SA_PARAMS_TO_ADD}
         ${result}    scf.is_object_in_scf    dist_name=${item}[dist_name]    nodeType=${item}[nodeType]
         run keyword if    ${result}==True    scf.remove_mo_with_descendant_mos    dist_name=${item}[dist_name]    nodeType=${item}[nodeType]

    END
    FOR    ${item}    IN    @{MNL_DSS_1586_PARAMS_TO_ADD}
         ${result}    scf.is_object_in_scf    dist_name=${item}[dist_name]    nodeType=${item}[nodeType]
         run keyword if    ${result}==True    scf.remove_mo_with_descendant_mos    dist_name=${item}[dist_name]    nodeType=${item}[nodeType]

    # modify list under object
    # MRBTS-69/NRBTS-2/NRCELL-1
    # cellBwpList
    END
    ${dist_name}  set variable  MRBTS-69/NRBTS-2/NRCELL-1
    ${result}  scf.is_list_in_object  dist_name=${dist_name}     list_name=cellBwpList     nodeType=${nodeType}
    run keyword if    ${result}==True    scf.remove_list_from_scf  dist_name=${dist_name}   list_name=cellBwpList    nodeType=${nodeType}
    scf.add list to scf  dist_name=${dist_name}   list_name=cellBwpList     nodeType=${nodeType}
    ${nodeType_}     set variable if    '${nodeType}'=='Classical'        Classical
    ...                                                                   Vdu
    scf.Save scf    ${scf_file_update_path}     nodeType=${nodeType_}
    run Keyword if    '${scf_file_path_cu}'!='${EMPTY}'       scf.Save scf   file_path=${scf_file_update_path_cu}      nodeType=Vcu
    [Return]    ${scf_file_update_path}    ${scf_file_update_path_cu}

get nrcell version VcuVdu
     [Arguments]   ${scf_file_path_du}   ${scf_file_path_cu}
     scf.Load scf      ${scf_file_path_du}
     run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Load scf    ${scf_file_path_cu}

     ${nrcell_version1}=    scf.get_mo_attribute    MRBTS-69/NRBTS-2/NRCELL-1/NRCELL_FDD-1     version   nodeType=Vcu
     ${nodeType_1}=    set variable      Vcu
     ${nrcell_version2}=    scf.get_mo_attribute    MRBTS-69/NRBTS-2/NRCELL-1/NRCELL_FDD-1     version   nodeType=Vdu
     ${nodeType_2}=    set variable      Vdu
     [return]    ${nrcell_version1}   ${nodeType_1}   ${nrcell_version2}   ${nodeType_2}

get nrcell version nodeType
     [Arguments]   ${scf_file_path_du}   ${scf_file_path_cu}   ${nodeType}=Classical
     scf.Load scf      ${scf_file_path_du}
     run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Load scf    ${scf_file_path_cu}

     ${nrcell_version1}=   scf.get_mo_attribute    MRBTS-69/NRBTS-2/NRCELL-1/NRCELL_FDD-1     version   nodeType=${nodeType}
     ${nodeType_1}=        set variable       ${nodeType}
     ${nrcell_version2}=   set variable       ${EMPTY}
     ${nodeType_2}=        set variable       ${EMPTY}
     [return]    ${nrcell_version1}   ${nodeType_1}   ${nrcell_version2}   ${nodeType_2}

get nrcell version
     [Arguments]   ${scf_file_path_du}   ${scf_file_path_cu}   ${nodeType}=Classical
     ${nrcell_version1}   ${nodeType_1}  ${nrcell_version2}   ${nodeType_2}=   run Keyword if   '${nodeType}'=='VcuVdu' or '${nodeType}'=='VduVcu'
     ...                get nrcell version VcuVdu       ${scf_file_path_du}    ${scf_file_path_cu}
     ...   ELSE         get nrcell version nodeType     ${scf_file_path_du}    ${scf_file_path_cu}   nodeType=${nodeType}
     &{nrcell_version_1}    Create Dictionary
     ...    nodeType=${nodeType_1}
     ...    nrcell_version=${nrcell_version1}
     &{nrcell_version_2}    Create Dictionary
     ...    nodeType=${nodeType_2}
     ...    nrcell_version=${nrcell_version2}
     @{nrcell_version_param}    Create List    ${nrcell_version_1}
     ...                ${nrcell_version_2}
     [return]   ${nrcell_version_param}

Add DSS information to scf
    [Documentation]   Auther: Ch SAMSON
    [Arguments]    ${scf_file_path}    ${scf_file_path_cu}=${EMPTY}   ${nodeType}=Classical
    log to console    Add DSS information to scf
    ${default_scf_file_path}    Copy file    source=${scf_file_path}    destination=${LOG_PATH}/DSS_add/
    ${default_scf_file_vcu_path}    run Keyword if    '${scf_file_path_cu}'!='${EMPTY}'    Copy file    source=${scf_file_path_cu}
    ...                                                                                                 destination=${LOG_PATH}/DSS_add/
    ${scf_name_for_update}=       Get scf file name     ${scf_file_path}    _DSS_add.xml
    ${scf_name_for_update_cu}=    run Keyword if    '${scf_file_path_cu}'!='${EMPTY}'    Get scf file name     ${scf_file_path_cu}    _DSS_add.xml
    ...    ELSE                                                                          set variable    ${EMPTY}

    ${scf_file_update_path}       set variable    ${LOG_PATH}/DSS_add/${scf_name_for_update}
    ${scf_file_update_path_cu}    set variable if    '${scf_file_path_cu}'!='${EMPTY}'    ${LOG_PATH}/DSS_add/${scf_name_for_update_cu}
    ...                                                                                    ${EMPTY}

    ${nrcell_version}=    get nrcell version     ${scf_file_path}    ${scf_file_path_cu}   ${nodeType}
    Dated log     nrcell_version=${nrcell_version}

    scf.Load scf    ${default_scf_file_path}
    run Keyword if   '${scf_file_path_cu}'!='${EMPTY}'       scf.Load scf    ${default_scf_file_vcu_path}

    # ${nrcell_version}=    scf.get_mo_attribute    MRBTS-69/NRBTS-2/NRCELL-1/NRCELL_FDD-1    version
    # ${MNL_version}=    scf.get_mo_attribute    MRBTS-69/MNL-1    version

    FOR    ${item}    IN    @{DSS_1586_PARAMS_TO_ADD}
        # scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]  version=${nrcell_version}  nodeType=${item}[nodeType]
        dated log    nodeType=${item}[nodeType]
        ${nodeType_}=   set variable     ${item}[nodeType]
        run Keyword if   '${item}[nodeType]'!='VduVcu'       scf.add object to scf  class_name=${item}[class_name]
        ...                                                                         dist_name=${item}[dist_name]
        ...                                                                         version=${nrcell_version[0]}[nrcell_version]
        ...                                                                         nodeType=${item}[nodeType]
        ...   ELSE      run Keywords      scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]
        ...                                                      version=${nrcell_version[0]}[nrcell_version]
        ...                                                      nodeType=Vcu                                                        AND
        ...                               scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]
        ...                                                      version=${nrcell_version[1]}[nrcell_version]
        ...                                                      nodeType=Vdu
    END
    FOR    ${item}    IN    @{DSS_1586_SA_PARAMS_TO_ADD}
        # scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]  version=${nrcell_version}  nodeType=${item}[nodeType]
        dated log    nodeType=${item}[nodeType]
        ${nodeType_}=   set variable     ${item}[nodeType]
        run Keyword if   '${item}[nodeType]'!='VduVcu'       scf.add object to scf  class_name=${item}[class_name]
        ...                                                                         dist_name=${item}[dist_name]
        ...                                                                         version=${nrcell_version[0]}[nrcell_version]
        ...                                                                         nodeType=${item}[nodeType]
        ...   ELSE      run Keywords      scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]
        ...                                                      version=${nrcell_version[0]}[nrcell_version]
        ...                                                      nodeType=Vcu                                                        AND
        ...                               scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]
        ...                                                      version=${nrcell_version[1]}[nrcell_version]
        ...                                                      nodeType=Vdu
    END
    FOR    ${item}    IN    @{MNL_DSS_1586_PARAMS_TO_ADD}
        # scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]   version=${MNL_version}  nodeType=${item}[nodeType]
        dated log    nodeType=${item}[nodeType]
        ${nodeType_}=   set variable     ${item}[nodeType]
        run Keyword if   '${item}[nodeType]'!='VduVcu'       scf.add object to scf  class_name=${item}[class_name]
        ...                                                                         dist_name=${item}[dist_name]
        ...                                                                         version=${nrcell_version[0]}[nrcell_version]
        ...                                                                         nodeType=${item}[nodeType]
        ...   ELSE      run Keywords      scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]
        ...                                                      version=${nrcell_version[0]}[nrcell_version]
        ...                                                      nodeType=Vcu                                                        AND
        ...                               scf.add object to scf  class_name=${item}[class_name]   dist_name=${item}[dist_name]
        ...                                                      version=${nrcell_version[1]}[nrcell_version]
        ...                                                      nodeType=Vdu
    END
    FOR    ${item}    IN    @{DSS_1586_LIST_NAME_PARAMS_TO_ADD}
        scf.add list to scf  dist_name=${item}[dist_name]   list_name=${item}[list_name]  nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{DSS_1586_SA_LIST_NAME_PARAMS_TO_ADD}
        scf.add list to scf  dist_name=${item}[dist_name]   list_name=${item}[list_name]  nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{DSS_1586_LIST_ITEMS_PARAMS_TO_ADD}
        scf.add item to list  dist_name=${item}[dist_name]    list_name=${item}[list_name]    elements=${item}[elements]  nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{DSS_1586_SA_LIST_ITEMS_PARAMS_TO_ADD}
        scf.add item to list  dist_name=${item}[dist_name]    list_name=${item}[list_name]    elements=${item}[elements]  nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{DSS_1586_LIST_ELEMENTS_PARAMS_TO_ADD}
        scf.add elements to list  dist_name=${item}[dist_name]  list_name=${item}[list_name]  elements=${item}[elements]  nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{DSS_1586_SA_LIST_ELEMENTS_PARAMS_TO_ADD}
        scf.add elements to list  dist_name=${item}[dist_name]  list_name=${item}[list_name]  elements=${item}[elements]  nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{DSS_1586_ELEMENTS_PARAMS_TO_ADD}
        scf.add element to scf  dist_name=${item}[dist_name]    p_name=${item}[p_name]    value=${item}[value]  nodeType=${item}[nodeType]
    END
    FOR    ${item}    IN    @{DSS_1586_SA_ELEMENTS_PARAMS_TO_ADD}
        scf.add element to scf  dist_name=${item}[dist_name]    p_name=${item}[p_name]    value=${item}[value]  nodeType=${item}[nodeType]
    END
    ${nodeType_}     set variable if    '${nodeType}'=='Classical'        Classical
    ...                                                                   Vdu
    scf.Save scf       file_path=${scf_file_update_path}    nodeType=${nodeType_}
    run Keyword if    '${scf_file_path_cu}'!='${EMPTY}'       scf.Save scf      file_path=${scf_file_update_path_cu}    nodeType=Vcu
    [Return]    ${scf_file_update_path}    ${scf_file_update_path_cu}

Commissioning SCF
    [Tags]                          INIT_AND_TEST
    [Arguments]                     ${ScfFile}    ${oam}=${GNB_DU.oam}   ${w_TlRestart}=True
    Dated log                       Commisioning SCF : ${ScfFile}
    File should exist               ${ScfFile}                              SCF file ${ScfFile} not found
    OAM Perform Full Commissioning  scf_file=${ScfFile}   oam=${oam}
    OAM wait available     oam=${oam}
    ${isOAMRebooted}    run Keyword if   '${isAic}'=='${False}'      SSH Was OAM Rebooted        ${GNB_DU}          timeout=60
    ...   ELSE                                                       set variable      False
    # If gNB was rebooted after re-commissioning, wait until it's ready again.
    Run Keyword If                  '${isOAMRebooted}' == 'True'        Airscale Wait for Ready         ${GNB_DU}
    Run Keyword If                  '${w_TlRestart}' == 'True'          5GC001586_Keywords.Restart      isOAMRebooted=${isOAMRebooted}
    ...                                                                                    OwnTLReset=${false}
    ...                                                                                    GNBCallback=5GC001586_Keywords.Set Reset Loop Counter

Get GNB BTS Info
   [Documentation]                 Retrieve several info from GNB OAM
    ...                             Information retrieved are :
    ...                                 NRBTS_ID, MRBTS_ID and NRCELL_DIST_NAME
   ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
   OAM Get GNB BTS Info            oam=${GNB_DU.oam}
   Dated log                       \tMRBTS_ID=${MRBTS_ID}
   Dated log                       \tNRBTS_ID=${NRBTS_ID}
   Dated log                       \tNRCELL_DIST_NAME=${NRCELL_DIST_NAME}
   OAM Disconnect                  ${GNB_DU.oam}


Delete NRPLMNSET_SA into SCF If Exist
   [Documentation]    delete NRPLMNSET_SA-1 object if present
   [Arguments]    ${scf_file_path}     ${nodeType}=Classical   ${distName}=MRBTS-69/NRBTS-2/NRCELL-1
    log to console    Remove NRPLMNSET_SA-1 from SCF if present for CellId=1
    scf.Load scf    ${scf_file_path}
    ${result}    scf.is_object_in_scf    dist_name=${distName}/NRPLMNSET_SA-1    nodeType=${nodeType}
    run keyword if    ${result}==True    scf.remove_mo_with_descendant_mos    dist_name=${distName}/NRPLMNSET_SA-1
    ...                                                                       nodeType=${nodeType}
    scf.Save scf    ${scf_file_path}     nodeType=${nodeType}
    [Return]    ${scf_file_path}


modify scf to NSA only for SANSA and update Context
  [Arguments]       ${testParam}

    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}

    &{modify_param}    Create Dictionary
    ...    parameter=actNgcFlexSaMode
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...    value=false
    &{modify_param1}    Create Dictionary
    ...    parameter=actSACallProcessingDU
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...    value=false
    &{modify_param2}    Create Dictionary
    ...    parameter=gNbCuType
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...    value=NSA
    &{modify_param3}    Create Dictionary
    ...    parameter=cellDepType
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=NSA

    @{modify_param}    Create List    ${modify_param}
    ...                               ${modify_param1}
    ...                               ${modify_param2}
    ...                               ${modify_param3}

    BuiltIn.Log      \nParameters to modify:\n @{modify_param}   console=yes
    # coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params    modify_param=@{modify_param}

    # manage other cells than CellId 1 if present
    modify scf cellDepType to NSA only for SANSA Configuration for All Cell expect CellId   1

    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable              ${test_scf_file}
    ${cellDepType}=   5GC001586_Kw_TestSetup.get cellDepType from SCF
    ${testParam.Context.cellDepType}      set variable    ${cellDepType}

modify TL configuration for NSA Only
   [Arguments]       ${local_scf_file_path_du}     ${local_scf_file_path_cu}=${EMPTY}   ${nodeType}=Classical   ${cellId_to_bypass}=1

   Dated log   modify TL configuration for NSA Only with MRBTS=MRBTS-${MRBTS_ID} and NRBTS=NRBTS-${NRBTS_ID}

   # delete MRBTS-1/NRBTS-1/NRSYSINFO_PROFILE-1/NRLIM-1 if needed
   ${local_scf_file_path_du}    Delete NRLIM-1 into SCF If Exist     ${local_scf_file_path_du}

   # delete NRPLMNSET_SA if present as 1586 is NSA Only (for CellId 1)
   ${local_scf_file_path_du}      5GC001586_Kw_TestSetup.Delete NRPLMNSET_SA into SCF If Exist     ${local_scf_file_path_du}
   ...                                                                                       distName=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1

   scf.Load scf    ${local_scf_file_path_du}

   ${result}    ${msg} =           Run Keyword And Ignore Error      scf.modify_scf_element
   ...                                                                   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
   ...                                                                   p_name=actNgcFlexSaMode
   ...                                                                   value=false
   Run Keyword If                  '${result}' is None or '${result}' == 'FAIL'
   ...                             scf.add_element_to_scf
   ...                                 dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
   ...                                 p_name=actNgcFlexSaMode
   ...                                 value=false

   ${result}    ${msg} =           Run Keyword And Ignore Error      scf.modify_scf_element
   ...                                                                   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
   ...                                                                   p_name=actSACallProcessingDU
   ...                                                                   value=false
   Run Keyword If                  '${result}' is None or '${result}' == 'FAIL'
   ...                             scf.add_element_to_scf
   ...                                 dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
   ...                                 p_name=actSACallProcessingDU
   ...                                 value=false

   ${result}    ${msg} =           Run Keyword And Ignore Error      scf.modify_scf_element
   ...                                                                   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
   ...                                                                   p_name=gNbCuType
   ...                                                                   value=NSA
   Run Keyword If                  '${result}' is None or '${result}' == 'FAIL'
   ...                             scf.add_element_to_scf
   ...                                 dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
   ...                                 p_name=gNbCuType
   ...                                 value=NSA

   ${result}    ${msg} =           Run Keyword And Ignore Error      scf.modify_scf_element
   ...                                                                   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
   ...                                                                   p_name=cellDepType
   ...                                                                   value=NSA
   Run Keyword If                  '${result}' is None or '${result}' == 'FAIL'
   ...                             scf.add_element_to_scf
   ...                                 dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
   ...                                 p_name=cellDepType
   ...                                 value=NSA

   ${dist_name}  set variable  MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/TRACKINGAREA-200
   ${result}  scf.is_list_in_object  dist_name=${dist_name}     list_name=snssaiDNList     nodeType=${nodeType}
   run keyword if    ${result}==True    scf.remove_list_from_scf  dist_name=${dist_name}   list_name=snssaiDNList    nodeType=${nodeType}
   ${result}  scf.is_list_in_object  dist_name=${dist_name}     list_name=snssaiList     nodeType=${nodeType}
   run keyword if    ${result}==True    scf.remove_list_from_scf  dist_name=${dist_name}   list_name=snssaiList    nodeType=${nodeType}

   FOR    ${item}    IN    @{nsaDrbParam_1586_NSA_LIST_NAME_PARAMS_TO_ADD}
        ${result}  scf.is_list_in_object  dist_name=${item}[dist_name]     list_name=${item}[list_name]
        Continue for loop If   ${result}==True
        scf.add list to scf  dist_name=${item}[dist_name]   list_name=${item}[list_name]  nodeType=${item}[nodeType]
   END

   FOR    ${item}    IN    @{nsaDrbParam_1586_NSA_LIST_NAME_PARAMS_TO_ADD}
        scf.add item to list  dist_name=${item}[dist_name]    list_name=${item}[list_name]    elements=${item}[elements]  nodeType=${item}[nodeType]
   END

   ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
   ${cell_list}=         Get All Cell Id                 connection=${aliasGNB}
   Dated log     Get All Cell Id list=${cell_list}
   robot_extension.Run Keyword And Warn On Failure     OAM Disconnect      ${GNB_DU.oam}

   FOR    ${CELL}  IN  @{cell_list}
        # dated log    CellId=${CELL}
        Continue for loop If    '${CELL}'=='${cellId_to_bypass}'
        dated log    set cellDepType=NSA for CellId ${CELL}
        ${result}    ${msg} =     Run Keyword And Ignore Error      scf.modify_scf_element
        ...                                                             dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${CELL}
        ...                                                             p_name=cellDepType
        ...                                                             value=NSA
        Run Keyword If    '${result}' is None or '${result}' == 'FAIL'   Fail
        ...                                                       Modifying cellDepType MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${CELL} with NSA
        ${distName}    Set Variable      MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${CELL}
        ${result}    scf.is_object_in_scf    dist_name=${distName}/NRPLMNSET_SA-1    nodeType=Classical
        log to console    Remove NRPLMNSET_SA-1 from SCF if present for CellId=${CELL}
        run keyword if    ${result}==True    scf.remove_mo_with_descendant_mos    dist_name=${distName}/NRPLMNSET_SA-1
        ...                                                                       nodeType=Classical
   END
   scf.Save scf    ${local_scf_file_path_du}     nodeType=${nodeType_}
   run Keyword if    '${local_scf_file_path_cu}'!='${EMPTY}'       scf.Save scf   file_path=${local_scf_file_path_cu}      nodeType=Vcu
   [Return]    ${local_scf_file_path_du}    ${local_scf_file_path_cu}


Delete NRLIM-1 into SCF If Exist
