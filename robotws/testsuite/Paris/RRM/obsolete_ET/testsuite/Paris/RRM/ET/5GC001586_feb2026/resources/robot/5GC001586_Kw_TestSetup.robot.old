Set SCF 1586 M1 for AiC and Classical
    [Arguments]          ${testParam}      ${btsType}=Classical
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
#      TestParam is ${testParam}
    # ISSUE WITH AiC => to investigate later ....
    return from Keyword if     ${isAiC}
    # list param for VDU   or  Classical
    ${nodeType}=     set variable if   '${btsType}' == 'Classical'    Classical
    ...                                                               Vdu
    &{bwpp1_locationAndBandwidthUl}     Create Dictionary
    ...                 cRbSizeUl=${testParam.scfFile.Bwp_Profile1_locationAndBandwidthUl.cRbSizeUl}
    ...                 cRbStartUl=${testParam.scfFile.Bwp_Profile1_locationAndBandwidthUl.cRbStartUl}
    ${dist}=   Catenate      MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-1
    ${p}=      Catenate      locationAndBandwidthUl
    #&{modify_param3}  Evaluate  {'dist_name': '${dist}','parameter': 'locationAndBandwidthUl','value':[&{bwpp1_locationAndBandwidthUl}]}
    &{modify_param3}  Evaluate  {'dist_name': '${dist}','parameter': '${p}','value':[&{bwpp1_locationAndBandwidthUl}],'nodeType': '${nodeType}'}

    &{modify_param4}    Create Dictionary
    ...    parameter=dciDedicatedAggregationLevel
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1
    ...    value=${testParam.scfFile.Bwp_Profile2_pdcch_1.dciDedicatedAggregationLevel}
    ...    nodeType=${nodeType}

    &{modify_param5}    Create Dictionary
    ...    parameter=dciRaCompletionAggregationLevel
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1
    ...    value=${testParam.scfFile.Bwp_Profile2_pdcch_1.dciRaCompletionAggregationLevel}
    ...    nodeType=${nodeType}

    &{modify_param6}    Create Dictionary
    ...    parameter=dciRaMsg2AggregationLevel
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1
    ...    value=${testParam.scfFile.Bwp_Profile2_pdcch_1.dciRaMsg2AggregationLevel}
    ...    nodeType=${nodeType}

   &{modify_param7}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsHighEdgeDL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=0
    ...    nodeType=${nodeType}

    &{modify_param8}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsHighEdgeUL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=0
    ...    nodeType=${nodeType}

    &{modify_param9}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsLowEdgeDL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=0
    ...    nodeType=${nodeType}

    &{modify_param10}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsLowEdgeUL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=0
    ...    nodeType=${nodeType}

    &{coresetCommon}    Create Dictionary     coresetId=${testParam.scfFile.coresetCommon.coresetId}
    ...                 cceToRegMapping=${testParam.scfFile.coresetCommon.cceToRegMapping}
    ...                 cRbStart=${testParam.scfFile.coresetCommon.cRbStart}
    ...                 duration=${testParam.scfFile.coresetCommon.duration}
    ...                 interleaverSize=${testParam.scfFile.coresetCommon.interleaverSize}
    ...                 regBundleSize=${testParam.scfFile.coresetCommon.regBundleSize}
    ...                 size=${testParam.scfFile.coresetCommon.size}
    ${dist}=    Catenate    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1
    &{modify_param}    Evaluate    {'dist_name': '${dist}','parameter': 'coresetCommon','value':[&{coresetCommon}],'nodeType': '${nodeType}'}
    # &{modify_param}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1',
    # ...                   'parameter': 'coresetCommon','value':[&{coresetCommon}]}

    &{searchSpaceCommon}    Create Dictionary     coresetId=${testParam.scfFile.searchSpaceCommon.coresetId}
    ...                 dciFormat=${testParam.scfFile.searchSpaceCommon.dciFormat}
    ...                 duration=${testParam.scfFile.searchSpaceCommon.duration}
    ...                 monitoringSymbolWithinSlot=${testParam.scfFile.searchSpaceCommon.monitoringSymbolWithinSlot}
    ...                 numOfPdcchCandidatesInAL16=${testParam.scfFile.searchSpaceCommon.numOfPdcchCandidatesInAL16}
    ...                 numOfPdcchCandidatesInAL4=${testParam.scfFile.searchSpaceCommon.numOfPdcchCandidatesInAL4}
    ...                 numOfPdcchCandidatesInAL8=${testParam.scfFile.searchSpaceCommon.numOfPdcchCandidatesInAL8}
    ...                 periodicity=${testParam.scfFile.searchSpaceCommon.periodicity}
    ...                 searchSpaceId=${testParam.scfFile.searchSpaceCommon.searchSpaceId}
    ...                 searchSpaceType=${testParam.scfFile.searchSpaceCommon.searchSpaceType}
    ...                 slotOffset=${testParam.scfFile.searchSpaceCommon.slotOffset}
    ${dist}=    Catenate    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1
    &{modify_param1}    Evaluate   {'dist_name': '${dist}','parameter': 'searchSpaceCommon','value':[&{searchSpaceCommon}],'nodeType': '${nodeType}'}
#    &{modify_param1}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1',
#    ...      'parameter': 'searchSpaceCommon','value':[&{searchSpaceCommon}]}

    &{searchSpaceDedicated}    Create Dictionary     coresetId=${testParam.scfFile.searchSpaceDedicated.coresetId}
    ...                 dciFormat=${testParam.scfFile.searchSpaceDedicated.dciFormat}
    ...                 duration=${testParam.scfFile.searchSpaceDedicated.duration}
    ...                 monitoringSymbolWithinSlot=${testParam.scfFile.searchSpaceDedicated.monitoringSymbolWithinSlot}
    ...                 numOfPdcchCandidatesInAL1=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL1}
    ...                 numOfPdcchCandidatesInAL16=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL16}
    ...                 numOfPdcchCandidatesInAL2=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL2}
    ...                 numOfPdcchCandidatesInAL4=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL4}
    ...                 numOfPdcchCandidatesInAL8=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL8}
    ...                 periodicity=${testParam.scfFile.searchSpaceDedicated.periodicity}
    ...                 searchSpaceId=${testParam.scfFile.searchSpaceDedicated.searchSpaceId}
    ...                 searchSpaceType=${testParam.scfFile.searchSpaceDedicated.searchSpaceType}
    ...                 slotOffset=${testParam.scfFile.searchSpaceDedicated.slotOffset}
    ${dist}=    Catenate      MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_DEDICATED-1
    ${p}=       Catenate      searchSpaceDedicated
    &{modify_param2}    Evaluate   {'dist_name': '${dist}','parameter': '${p}','value':[&{searchSpaceDedicated}],'nodeType': '${nodeType}'}
    # &{modify_param2}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_DEDICATED-1',
    # ...                              'parameter': 'searchSpaceDedicated','value':[&{searchSpaceDedicated}]}

    # &{cellBwpList}    Create Dictionary     bwpDN=${testParam.scfFile.cellBwpList_Item1.bwpDN}
    # ...                 cellBwpId=${testParam.scfFile.cellBwpList_Item1.cellBwpId}
    # &{modify_param3}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1',
    # ...                              'parameter': 'cellBwpList','value':[&{cellBwpList}]}

    # &{cellBwpList2}    Create Dictionary     bwpDN=${testParam.scfFile.cellBwpList_Item2.bwpDN}
    # ...                 cellBwpId=${testParam.scfFile.cellBwpList_Item2.cellBwpId}
    # &{modify_param4}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1',
    # ...                              'parameter': 'cellBwpList','value':[&{cellBwpList2}]}

    @{modify_param}    Create List    ${modify_param}
    ...                ${modify_param1}
    ...                ${modify_param2}
    ...                ${modify_param3}
    ...                ${modify_param4}
    ...                ${modify_param5}
    ...                ${modify_param6}
    ...                ${modify_param7}
    ...                ${modify_param8}
    ...                ${modify_param9}
    ...                ${modify_param10}

    BuiltIn.Log      \nParameters to modify:\n @{modify_param}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params AIC      modify_param=@{modify_param}

Set SCF 1586 M1
    [Arguments]          ${testParam}
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
#      TestParam is ${testParam}
    &{bwpp1_locationAndBandwidthUl}     Create Dictionary
    ...                 cRbSizeUl=${testParam.scfFile.Bwp_Profile1_locationAndBandwidthUl.cRbSizeUl}
    ...                 cRbStartUl=${testParam.scfFile.Bwp_Profile1_locationAndBandwidthUl.cRbStartUl}
    ${dist}=   Catenate      MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-1
    &{modify_param3}    Evaluate    {'dist_name': '${dist}','parameter': 'locationAndBandwidthUl','value':[&{bwpp1_locationAndBandwidthUl}]}

    &{modify_param4}    Create Dictionary
    ...    parameter=dciDedicatedAggregationLevel
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1
    ...    value=${testParam.scfFile.Bwp_Profile2_pdcch_1.dciDedicatedAggregationLevel}

    &{modify_param5}    Create Dictionary
    ...    parameter=dciRaCompletionAggregationLevel
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1
    ...    value=${testParam.scfFile.Bwp_Profile2_pdcch_1.dciRaCompletionAggregationLevel}

    &{modify_param6}    Create Dictionary
    ...    parameter=dciRaMsg2AggregationLevel
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1
    ...    value=${testParam.scfFile.Bwp_Profile2_pdcch_1.dciRaMsg2AggregationLevel}

   &{modify_param7}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsHighEdgeDL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=0

    &{modify_param8}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsHighEdgeUL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=0

    &{modify_param9}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsLowEdgeDL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=0

    &{modify_param10}    Create Dictionary
    ...    parameter=nbrOfBlankedPRBsLowEdgeUL
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=0

    &{coresetCommon}    Create Dictionary     coresetId=${testParam.scfFile.coresetCommon.coresetId}
    ...                 cceToRegMapping=${testParam.scfFile.coresetCommon.cceToRegMapping}
    ...                 cRbStart=${testParam.scfFile.coresetCommon.cRbStart}
    ...                 duration=${testParam.scfFile.coresetCommon.duration}
    ...                 interleaverSize=${testParam.scfFile.coresetCommon.interleaverSize}
    ...                 regBundleSize=${testParam.scfFile.coresetCommon.regBundleSize}
    ...                 size=${testParam.scfFile.coresetCommon.size}
    ${dist}=    Catenate    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1
    &{modify_param}    Evaluate    {'dist_name': '${dist}','parameter': 'coresetCommon','value':[&{coresetCommon}]}
    # &{modify_param}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1',
    # ...                   'parameter': 'coresetCommon','value':[&{coresetCommon}]}

    &{searchSpaceCommon}    Create Dictionary     coresetId=${testParam.scfFile.searchSpaceCommon.coresetId}
    ...                 dciFormat=${testParam.scfFile.searchSpaceCommon.dciFormat}
    ...                 duration=${testParam.scfFile.searchSpaceCommon.duration}
    ...                 monitoringSymbolWithinSlot=${testParam.scfFile.searchSpaceCommon.monitoringSymbolWithinSlot}
    ...                 numOfPdcchCandidatesInAL16=${testParam.scfFile.searchSpaceCommon.numOfPdcchCandidatesInAL16}
    ...                 numOfPdcchCandidatesInAL4=${testParam.scfFile.searchSpaceCommon.numOfPdcchCandidatesInAL4}
    ...                 numOfPdcchCandidatesInAL8=${testParam.scfFile.searchSpaceCommon.numOfPdcchCandidatesInAL8}
    ...                 periodicity=${testParam.scfFile.searchSpaceCommon.periodicity}
    ...                 searchSpaceId=${testParam.scfFile.searchSpaceCommon.searchSpaceId}
    ...                 searchSpaceType=${testParam.scfFile.searchSpaceCommon.searchSpaceType}
    ...                 slotOffset=${testParam.scfFile.searchSpaceCommon.slotOffset}
    ${dist}=    Catenate    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1
    &{modify_param1}    Evaluate    {'dist_name': '${dist}','parameter': 'searchSpaceCommon','value':[&{searchSpaceCommon}]}
#    &{modify_param1}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_COMMON-1',
#    ...      'parameter': 'searchSpaceCommon','value':[&{searchSpaceCommon}]}

    &{searchSpaceDedicated}    Create Dictionary     coresetId=${testParam.scfFile.searchSpaceDedicated.coresetId}
    ...                 dciFormat=${testParam.scfFile.searchSpaceDedicated.dciFormat}
    ...                 duration=${testParam.scfFile.searchSpaceDedicated.duration}
    ...                 monitoringSymbolWithinSlot=${testParam.scfFile.searchSpaceDedicated.monitoringSymbolWithinSlot}
    ...                 numOfPdcchCandidatesInAL1=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL1}
    ...                 numOfPdcchCandidatesInAL16=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL16}
    ...                 numOfPdcchCandidatesInAL2=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL2}
    ...                 numOfPdcchCandidatesInAL4=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL4}
    ...                 numOfPdcchCandidatesInAL8=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL8}
    ...                 periodicity=${testParam.scfFile.searchSpaceDedicated.periodicity}
    ...                 searchSpaceId=${testParam.scfFile.searchSpaceDedicated.searchSpaceId}
    ...                 searchSpaceType=${testParam.scfFile.searchSpaceDedicated.searchSpaceType}
    ...                 slotOffset=${testParam.scfFile.searchSpaceDedicated.slotOffset}
    ${dist}=    Catenate      MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_DEDICATED-1
    &{modify_param2}    Evaluate    {'dist_name': '${dist}','parameter': 'searchSpaceDedicated','value':[&{searchSpaceDedicated}]}
    # &{modify_param2}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_DEDICATED-1',
    # ...                              'parameter': 'searchSpaceDedicated','value':[&{searchSpaceDedicated}]}

    # &{cellBwpList}    Create Dictionary     bwpDN=${testParam.scfFile.cellBwpList_Item1.bwpDN}
    # ...                 cellBwpId=${testParam.scfFile.cellBwpList_Item1.cellBwpId}
    # &{modify_param3}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1',
    # ...                              'parameter': 'cellBwpList','value':[&{cellBwpList}]}

    # &{cellBwpList2}    Create Dictionary     bwpDN=${testParam.scfFile.cellBwpList_Item2.bwpDN}
    # ...                 cellBwpId=${testParam.scfFile.cellBwpList_Item2.cellBwpId}
    # &{modify_param4}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1',
    # ...                              'parameter': 'cellBwpList','value':[&{cellBwpList2}]}

    @{modify_param}    Create List    ${modify_param}
    ...                ${modify_param1}
    ...                ${modify_param2}
    ...                ${modify_param3}
    ...                ${modify_param4}
    ...                ${modify_param5}
    ...                ${modify_param6}
    ...                ${modify_param7}
    ...                ${modify_param8}
    ...                ${modify_param9}
    ...                ${modify_param10}

    BuiltIn.Log      \nParameters to modify:\n @{modify_param}   console=yes
    # 1) coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # 2) coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    OAM Set Params      modify_param=@{modify_param}

Modify 1586 searchSpaceDedicated related Parameters for AiC and Classical
    [Documentation]                to update searchSpaceDedicated
    [Arguments]                    ${testParam}      ${btsType}=Classical    ${alias}=default

    # ISSUE WITH AiC => to investigate later ....
    return from Keyword if     ${isAiC}

    # list param for VDU   or  Classical
    ${nodeType}=     set variable if   '${btsType}' == 'Classical'    Classical
    ...                                                               Vdu

    &{searchSpaceDedicated0}    Create Dictionary     coresetId=${testParam.scfFile.searchSpaceDedicated.coresetId}
    ...                 dciFormat=${testParam.scfFile.searchSpaceDedicated.dciFormat}
    ...                 duration=${testParam.scfFile.searchSpaceDedicated.duration}
    ...                 monitoringSymbolWithinSlot=${testParam.scfFile.searchSpaceDedicated.monitoringSymbolWithinSlot}
    ...                 numOfPdcchCandidatesInAL1=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL1}
    ...                 numOfPdcchCandidatesInAL16=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL16}
    ...                 numOfPdcchCandidatesInAL2=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL2}
    ...                 numOfPdcchCandidatesInAL4=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL4}
    ...                 numOfPdcchCandidatesInAL8=${testParam.scfFile.searchSpaceDedicated.numOfPdcchCandidatesInAL8}
    ...                 periodicity=${testParam.scfFile.searchSpaceDedicated.periodicity}
    ...                 searchSpaceId=${testParam.scfFile.searchSpaceDedicated.searchSpaceId}
    ...                 searchSpaceType=${testParam.scfFile.searchSpaceDedicated.searchSpaceType}
    ...                 slotOffset=${testParam.scfFile.searchSpaceDedicated.slotOffset}

    &{searchSpaceDedicated1}    Create Dictionary     coresetId=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.coresetId}
    ...               dciFormat=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.dciFormat}
    ...               duration=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.duration}
    ...               monitoringSymbolWithinSlot=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.monitoringSymbolWithinSlot}
    ...               numOfPdcchCandidatesInAL1=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.numOfPdcchCandidatesInAL1}
    ...               numOfPdcchCandidatesInAL16=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.numOfPdcchCandidatesInAL16}
    ...               numOfPdcchCandidatesInAL2=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.numOfPdcchCandidatesInAL2}
    ...               numOfPdcchCandidatesInAL4=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.numOfPdcchCandidatesInAL4}
    ...               numOfPdcchCandidatesInAL8=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.numOfPdcchCandidatesInAL8}
    ...               periodicity=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.periodicity}
    ...               searchSpaceId=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.searchSpaceId}
    ...               searchSpaceType=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.searchSpaceType}
    ...               slotOffset=${testParam.scfFile.bwp_Profile2_pdcch1_dedicated1_searchSpaceDedicated2.slotOffset}

    @{searchSpaceDedicated_value}    create list
    Append To List    ${searchSpaceDedicated_value}    ${searchSpaceDedicated0}    ${searchSpaceDedicated1}
    &{searchSpaceDedicated_params}   Create Dictionary   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/BWP_PROFILE-2/PDCCH-1/PDCCH_CONFIG_DEDICATED-1
    ...    parameter=searchSpaceDedicated
    ...    value=${searchSpaceDedicated_value}
    ...    nodeType=${nodeType}
    dated log          searchSpaceDedicated_params=${searchSpaceDedicated_params}

    @{modify_param}    Create List    ${searchSpaceDedicated_params}
    OAM Set Params AIC      modify_param=@{modify_param}

