    ...                         scriptFile=classicalbts_log_collector.sh      remotePath=/ffs/run/config/scripts

# 1586 is NSA Only => in case of SANSA TL , need to change scf to be NSA Only
#   <p name="actNgcFlexSaMode">true</p>           =>          <p name="actNgcFlexSaMode">false</p>
#   <p name="actSACallProcessingDU">true</p>      =>          <p name="actSACallProcessingDU">false</p>
#   <p name="gNbCuType">SA+NSA</p>                =>          <p name="gNbCuType">NSA</p>
# remove MRBTS-1/NRBTS-1/NRCELL-1/NRPLMNSET_SA-1
# <managedObject class="com.nokia.srbts.nrbts:NRPLMNSET_SA" distName="MRBTS-1/NRBTS-1/NRCELL-1/NRPLMNSET_SA-1"
#      version="NRBTSCL22R1_2106_100" operation="create">

Test Line Preparation for NSA Only
   [Arguments]       ${testParam}

   Log to Console like Next Step    0    ${SUITE NAME} - ${TEST NAME.replace(" ", "_")}
   ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
   Set Suite Variable              ${test_scf_file}
   ${cellDepType}=   5GC001586_Kw_TestSetup.get cellDepType from SCF
   ${testParam.Context.cellDepType}      set variable    ${cellDepType}
   return from Keyword if   '${testParam.Context.cellDepType}' == 'NSA'
   # 10/25/2022 : remove here of modification online scf parameters from SANSA configuration to NSA only
   #    => replaced with "modify TL configuration for NSA Only" procedure
   #    => all scf parameters changes to configure TL from SANSA to NSA are now with full Commissioning
   # run Keyword if    '${testParam.Context.cellDepType}' == 'SA+NSA'   modify scf to NSA only for SANSA and update Context   ${testParam}
   # Get current  SCF file
   ${local_path_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF_used_for_1586_Tests_NSAOnly.xml
   ${default_local_scf_file_path_nsaOnly}    Move file    source=${local_path_scf_file}    destination=${LOG_PATH}/NSAOnly/
   # for testing purpose
   ${default_local_scf_file_path_nsaOnly}  ${local_path_scf_file_cu}    modify TL configuration for NSA Only   ${default_local_scf_file_path_nsaOnly}
   run Keyword if    '${testParam.Context.cellDepType}' == 'SA+NSA'   5GC001586_Kw_TestSetup.update eNbId and gNBId In Context   ${testParam}   2   1
   ${cellDepType}=      set variable      ${testParam.Context.cellDepType}
   set suite variable     ${NWtype}      ${cellDepType}

   Run Keyword If   '${SHOULD_BE_COMMISSIONED_GNB_FIRST}' == '1'    5GC001586_Kw_TestSetup.Commissioning SCF   ${default_local_scf_file_path_nsaOnly}
   ...                                                                                                         w_TlRestart=False

   # manage other cells than CellId 1 if present
   # 01/16/2023 This part is bypass as now this part is included in KW "modify TL configuration for NSA Only" (using full Commissioning)
   # modify scf cellDepType to NSA only for SANSA Configuration for All Cell expect CellId   1

   ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
   Set Suite Variable              ${test_scf_file}
   ${cellDepType}=   5GC001586_Kw_TestSetup.get cellDepType from SCF
   ${testParam.Context.cellDepType}      set variable    ${cellDepType}

   run Keyword if    '${testParam.Context.cellDepType}' == 'SA+NSA'   5GC001586_Kw_TestSetup.update eNbId and gNBId In Context   ${testParam}   2   1
   ...         ELSE                                                   5GC001586_Kw_TestSetup.update eNbId and gNBId In Context   ${testParam}   1   2
   ${cellDepType}=      set variable      ${testParam.Context.cellDepType}
   set suite variable     ${NWtype}      ${cellDepType}


Test Line Preparation
   [Arguments]       ${testParam}

   Log to Console like Next Step    0    ${SUITE NAME} - ${TEST NAME.replace(" ", "_")}

   common_Dss_Keywords.PrintTLInformation
   common_Dss_Keywords.Get Testline Name

   ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
   Set Suite Variable              ${test_scf_file}
   ${cellDepType}=   5GC001586_Kw_TestSetup.get cellDepType from SCF
   ${testParam.Context.cellDepType}      set variable    ${cellDepType}

   ${cellDepType}=      set variable      ${testParam.Context.cellDepType}
   set suite variable     ${NWtype}      ${cellDepType}

   # test DSS only with Dl64Qam
   Run Keyword If                  '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'        Set SCF actDl256Qam      actDl256Qam=false

   # Get current  SCF file
   ${local_path_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF_used_for_1586_Tests_FirstCommissioning.xml
   ${default_local_scf_file_path}    Copy file    source=${local_path_scf_file}    destination=${LOG_PATH}/DSS_delete/

   Dated Log   =====> Lock in scf all RU and Cells Except CellId 1
   ${status}   ${modified_scf_file_path}   run Keyword and ignore error    common_Dss_Keywords.Lock in scf all RU and Cells Except CellId
   ...                                                                                                 Cell=1
   ...                                                                                                 test_scf_file=${default_local_scf_file_path}
   ${modified_scf_file_path} =    run Keyword if   '${status}'!='PASS'     set variable   ${default_local_scf_file_path}
   ...   ELSE                                                              set variable   ${modified_scf_file_path}

   ${default_local_scf_file_path}    Copy file    source=${modified_scf_file_path}    destination=${LOG_PATH}/DSS_delete/
   Set Suite Variable              ${default_local_scf_file_path}

   # we need to change GNBID with NRBTS-2 into all scf file (DSS purpose)
   gNB_ModifySCFwithNewGNBID    ${default_local_scf_file_path}    NRBTS-2
   # needed for DELETE and ADD DSS obj
   Dated Log New Line  =====> gNB_ModifySCFwithNewMRBTSID with mrbtsID_original=MRBTS-${MRBTS_ID} and mrbtsID_new=MRBTS-69
   gNB_ModifySCFwithNewMRBTSID_2   ${default_local_scf_file_path}    mrbtsID_original=MRBTS-${MRBTS_ID}   mrbtsID_new=MRBTS-69

   ${local_path_dss_scf_file}    ${local_path_scf_file_cu}  5GC001586_Kw_TestSetup.Delete DSS Information If Exist    ${default_local_scf_file_path}
   # delete NRPLMNSET_SA if present as 1586 is NSA Only (for CellId 1)
   ${local_path_dss_scf_file}      5GC001586_Kw_TestSetup.Delete NRPLMNSET_SA into SCF If Exist     ${local_path_dss_scf_file}
   # remove NRPLMNSET_SA for CellId 2
   ${local_path_dss_scf_file}      Delete NRPLMNSET_SA_1 Cell into SCF If Exist       ${local_path_dss_scf_file}      CellId=2

   Set Suite Variable              ${local_path_dss_scf_file}

   ${local_path_dss_scf_file_with_dss_info}  ${local_path_scf_file_cu}  5GC001586_Kw_TestSetup.Add DSS information to scf  ${local_path_dss_scf_file}
   Set Suite Variable              ${local_path_dss_scf_file_with_dss_info}

   # need to adapt the NRBTS in case of SANSA
   run Keyword if     '${cellDepType}' == 'SA+NSA'      5GC001586_Kw_TestSetup.add SA cellBwpList to SCF     ${local_path_dss_scf_file_with_dss_info}
   ...      ELSE          5GC001586_Kw_TestSetup.add NSA cellBwpList to SCF     ${local_path_dss_scf_file_with_dss_info}
   run Keyword if     '${cellDepType}' == 'SA+NSA'
   ...                                          Dated Log    =====> gNB_ModifySCFwithNewNRBTS with nrbtsID_original=NRBTS-2 and nrbtsID_new=NRBTS-1
   run Keyword if     '${cellDepType}' == 'SA+NSA'      gNB_ModifySCFwithNewNRBTS    ${local_path_dss_scf_file_with_dss_info}    NRBTS-2    NRBTS-1

   # update with the current MRBTS_ID of the TL
   Dated Log New Line  =====> gNB_ModifySCFwithNewMRBTSID with mrbtsID_original=MRBTS-69 and mrbtsID_new=MRBTS-${MRBTS_ID}
   gNB_ModifySCFwithNewMRBTSID_2   ${local_path_dss_scf_file_with_dss_info}    mrbtsID_original=MRBTS-69   mrbtsID_new=MRBTS-${MRBTS_ID}

   Run Keyword If   '${SHOULD_BE_COMMISSIONED_GNB_FIRST}' == '1'  5GC001586_Kw_TestSetup.Commissioning SCF   ${local_path_dss_scf_file_with_dss_info}
   Run Keyword If   '${SHOULD_BE_COMMISSIONED_GNB_FIRST}' == '1'  5GC001586_Kw_TestSetup.Get GNB BTS Info

   # 10/06/2023 : need to change 4DL4UL to 2DL2UL for Cell1 if Needed
   ${dlMimoMode}          coam_parameter.get_single_value_from_scf_file
   ...                           parameter=dlMimoMode
   ...                           dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
   ...                           connection=coam_gnb
   Dated Log                     dlMimoMode is set to ${dlMimoMode}
   ${cond}=    Evaluate     '${dlMimoMode}'!='2x2 Closed Loop Spatial Multiplexing' and '${dlMimoMode}'!='2x2 Open Loop Spatial Multiplexing'
   Run Keyword If     ${cond} and '${SHOULD_BE_COMMISSIONED_GNB_FIRST}' == '1'
   ...       Run Keywords        dated log      => performing scf delta commission to configure cell1 with 2DL2UL...
   ...         AND               coam_parameter.perform_scf_delta_commission
   ...                              delta_file=${dlMimoMode_2DL2UL_delta_file_cell1}
   ...                              connection=coam_gnb
   # Wait end of commissioning
   ...         AND               OAM wait available
   # End of need to change 4DL4UL to 2DL2UL for Cell1 if Needed

   # SCF.xml is used by procedure verifyFeatureActivation
   ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
   Set Suite Variable              ${test_scf_file}
   Dated Log                  Current 1586 SCF file stored to ${test_scf_file}

Update cell state with "${nbr_cell_unlock}" and "${nbr_cell_lock}" into "${testParam}"
   ${testParam_1586}                 Tools.Dictionary Get              ${testParam}
   ${testParam_1586.Context.nbr_cell_unlock}    set Variable     ${nbr_cell_unlock}
   ${testParam_1586.Context.nbr_cell_lock}      set Variable     ${nbr_cell_lock}
   set suite variable    ${testParam_1586}
   [Return]      ${testParam_1586}

#=======================================================================================================================
# CONFIG/SETTINGS services on basic.cfg (the default basic.cfg is for 10MHz)
#=======================================================================================================================
Backup XML AirphoneConfig to remove
    [Documentation]                 Backup current AirphoneConfig file on ePCSim
    ${file}                         Get XML AirPhoneConfig Path
    return from Keyword if   '${file}' == '${empty}'
    Dated log                       On wtsemu, backing up file ${file}
    ${alias}                        SSH Connect                       ${HOST_EPCSIM}
    # Creates a copy of current XML AirphoneConfig
    ${backup_exists}=    csn.execute    test -f ${file}.backup && echo -n "okman" || echo -n "noway"    connection=${alias}
    ${file_exists}=      csn.execute    test -f ${file} && echo -n "okman" || echo -n "noway"    connection=${alias}
    Run Keyword If    '${file_exists}'=='okman' and '${backup_exists}'!='okman'    csn.execute    cp ${file} ${file}.backup    connection=${alias}

Set FullStack NodeId to remove
    [Arguments]                      ${x_path_l1Hw}
    setText                          ${x_path_l1Hw}/l1UlNodeId          ${Fullstack_NodeId_WtsXml}
    setText                          ${x_path_l1Hw}/l1DlNodeId          ${Fullstack_NodeId_WtsXml}

Set L1ByPass NodeId to remove
    [Arguments]                      ${x_path_l1Hw}
    setText                          ${x_path_l1Hw}/l1UlNodeId          ${L1bypass_NodeId_WtsXml}
    setText                          ${x_path_l1Hw}/l1DlNodeId          ${L1bypass_NodeId_WtsXml}

WTS Preparation to remove
    [Arguments]       ${testParam}
    WTS cfg Preparation                ${testParam}
    WTS xml Preparation             ${testParam}
    WTS Setup                       nbUe=${testParam.seq.totalUE}

WTS cfg Preparation to remove
    [Arguments]       ${testParam}
    WtsCfgConfig.startSession
    ${oldValue}          getParam           prefix=set_cell          param=nr_arfcn
    replaceValue         prefix=set_cell
    ...                  param=nr_arfcn
    ...                  oldValue=${oldValue}
    ...                  newValue=${testParam.wtsXmlFile.ulNrArfcn}:${testParam.wtsXmlFile.dlNrArfcn}
    ${oldValue}          getParam           prefix=set_cell          param=bw
    replaceValue         prefix=set_cell
    ...                  param=bw
    ...                  oldValue=${oldValue}
    ...                  newValue=${testParam.wtsXmlFile.bw}
    WtsCfgConfig.stopSession         rename=modified

WTS xml Preparation to remove
    [Arguments]          ${testParam}
    ${file}      Backup XML AirphoneConfig
    return from Keyword if   '${file}' == '${EMPTY}'
    WtsXmlConfig.startSession
    # 07/07/2021 : to remove ad not present anymore in the xml file
    # ${x_path_cellGrp}                set variable                           /config/cellGroupConfig/cellGroup
    # setText                          ${x_path_cellGrp}/dlBandwidth          ${testParam.wtsXmlFile.dlUlBandwidth}
    # setText                          ${x_path_cellGrp}/ulBandwidth          ${testParam.wtsXmlFile.dlUlBandwidth}
    # setText                          ${x_path_cellGrp}/ssBlockPrbOffset          ${testParam.wtsXmlFile.ssBlockPrbOffset}
    #set Arfcn
    WtsXmlConfig.setListEltText         //dlNrArfcn                        ${testParam.scfFile.nrcellfdd.nrarfcnDl}
    WtsXmlConfig.setListEltText         //ulNrArfcn                        ${testParam.scfFile.nrcellfdd.nrarfcnUl}
    WtsXmlConfig.setListEltText         //gscn                             ${testParam.scfFile.nrcell.gscn}
    WtsXmlConfig.stopSession

# the basic configuration is for 10MHz
Set UE capa on EPCSim to remove
    [Arguments]                     ${ue_nr_capa_value}=${ue_nr_capabilities_20MHz}    ${ue_ue_eutra_nr_capa}=${ue_ue_eutra_nr_capabilities_20MHz}
    Modify Field in WtsEmu Cfg File
    ...                             field=ue_nr_capabilities                 value=${ue_nr_capa_value}
    Modify Field in WtsEmu Cfg File
    ...                             field=ue_eutra_nr_capabilities                 value=${ue_ue_eutra_nr_capa}

Update AirPhoneConfig file name in WTS Config to remove
    [Documentation]    :
    ...    update WTS Config with given file name
    ...    :param remote_cfg: target WTS config file name (default ${tl.core.cfg_filename})
    ...
    ...    **Example:**
    ...    | wts_ue.Update AirPhoneConfig file name in WTS Config    file_name=AirphoneConfig.xml
    ...
    [Arguments]    ${file_name}    ${remote_cfg}=${tl.core.cfg_filename}
    ${core_alias}=    connect.Connect to Core
    ${output}=    ssh.execute    command=ls ${tl.core.dir_path}/${file_name}    connection=${core_alias}
    Should Contain    ${output}    ${file_name}
    Update WTS config with Regex    regex= file=\\S+    value= file=${file_name}    remote_cfg=${remote_cfg}


Update WTS config with Regex to remove
    [Documentation]    :
    ...    update value in WTS config file by using Regular expression, and verify if value has been correctly updated
    ...    it uses taf.transport.ssh to execute, therefore please use double '\' if you have '\' in arguments
    ...    :param regex:
    ...    :param value:
    ...    :param remote_cfg: target WTS config file name (default ${tl.core.cfg_filename})
    ...
    ...    **Example:**
    ...    | wts_ue.Update WTS config with Regex    regex=nr_arfcn=\\S+    value=nr_arfcn=646000:646000
    ...
    [Arguments]    ${regex}    ${value}    ${remote_cfg}=${tl.core.cfg_filename}
    ${core_alias}=    connect.Connect to Core
    ssh.execute    command=sed -i -E 's/${regex}/${value}/g' ${tl.core.dir_path}/${remote_cfg}
    ...    connection=${core_alias}
    ${output}=    ssh.execute    grep ${value} ${tl.core.dir_path}/${remote_cfg}    connection=${core_alias}
    Should Contain    ${output}    ${value}


