Set Context_AP IPHY to remove later
    [Arguments]          ${testParam}
    WtsXmlConfig.startSession           file=iphy
    #set GSCN
    WtsXmlConfig.setListEltText         //GSCN                          ${testParam.scfFile.nrcell.gscn}
    WtsXmlConfig.stopSession            file=iphy

