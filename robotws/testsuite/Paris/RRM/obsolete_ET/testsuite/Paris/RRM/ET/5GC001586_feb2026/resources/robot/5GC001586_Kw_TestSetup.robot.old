    ${result}    scf.is_object_in_scf   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRSYSINFO_PROFILE-1/NRLIM-1    nodeType=${nodeType}
    run keyword if    ${result}==True   scf.remove_mo_with_descendant_mos   dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRSYSINFO_PROFILE-1/NRLIM-1
    ...                                                                     nodeType=${nodeType}
    scf.Save scf    ${scf_file_path}    nodeType=${nodeType}
