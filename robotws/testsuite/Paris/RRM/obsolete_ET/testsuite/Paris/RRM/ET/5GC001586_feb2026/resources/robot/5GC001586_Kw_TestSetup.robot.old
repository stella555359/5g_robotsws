    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${LOG_PATH}/swconfig_used_for_1586_D_${testParam.seq.bandwidth}_Tests.txt
    ...                             connection=${alias_gnb}
    Dated Log                  Current 1586-D swconfig file stored to ${LOG_PATH}/swconfig_used_for_1586_D_${testParam.seq.bandwidth}_Tests.txt

    # Get EPC file configuration that will be used during 1586-D tests
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.download_file               remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${LOG_PATH}/basic_wts_used_for_1586_D_${testParam.seq.bandwidth}_Tests.cfg
    ...                             connection=${alias_epc}

    # Get AP configuration file that will be used during 1586-D tests
    ${ap_configfile}                Get XML AirPhoneConfig Path
    run Keyword if      '${ap_configfile}' != '${empty}'     csn.download_file        remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${LOG_PATH}/ApOamConfig_used_for_1586_D_${testParam.seq.bandwidth}_Tests.xml
    ...                             connection=${alias_epc}

    ${msg}=  Catenate      Current 1586-D basic file ${tl.core.cfg_filename}
    ...                      stored to ${LOG_PATH}/basic_wts_used_for_1586_D_${testParam.seq.bandwidth}_Tests.cfg
    Dated Log      ${msg}
    Dated Log      Current 1586-D ApOamConfig file stored to ${LOG_PATH}/ApOamConfig_used_for_1586_D_${testParam.seq.bandwidth}_Tests.xml

Remove RAD param for Link Adaptation on swconfig if present to remove
   [Arguments]       ${host}=${GNB_DU.entryCard[0]}
   [Documentation]         workaround on swconfig.txt to remove RAD param for Link adaptation
    ${SWCONFIG_LOCAL_PATH}          getTempDir
    ${SWCONFIG_REMOTE_PATH}         set variable                        /ffs/run/swconfig.txt
    Set Suite Variable              ${SWCONFIG_LOCAL_PATH}
    ...                             ${SWCONFIG_LOCAL_PATH}/swconfig.txt
    set suite variable              ${SWCONFIG_REMOTE_PATH}
    Dated Log                       startSession : Download ${SWCONFIG_REMOTE_PATH} in ${SWCONFIG_LOCAL_PATH}
    ${alias}                        SSH Wait For Connect                 ${GNB_DU.sys[0].M}
    csn.download_file               remote_path=${SWCONFIG_REMOTE_PATH}
    ...                             local_path=${SWCONFIG_LOCAL_PATH}
    ...                             connection=${alias}

    Dated log      Workaround on swconfig.txt to remove RAD param for Link adaptation
    Dated Log      sed -i -e 's/0x580011=0/#0x580011=0/g' ${SWCONFIG_LOCAL_PATH}
    Dated Log      sed -i -e 's/0x580012=0/#0x580012=0/g' ${SWCONFIG_LOCAL_PATH}
    Dated Log      sed -i -e 's/0x580013=0/#0x580013=0/g' ${SWCONFIG_LOCAL_PATH}
    Dated Log      sed -i -e 's/0x580014=0/#0x580014=0/g' ${SWCONFIG_LOCAL_PATH}

    Run          command=sed -i 's/0x580011=0/#0x580011=0/g' ${SWCONFIG_LOCAL_PATH}
    Run          command=sed -i 's/0x580012=0/#0x580012=0/g' ${SWCONFIG_LOCAL_PATH}
    Run          command=sed -i 's/0x580013=0/#0x580013=0/g' ${SWCONFIG_LOCAL_PATH}
    Run          command=sed -i 's/0x580014=0/#0x580014=0/g' ${SWCONFIG_LOCAL_PATH}

    Dated Log                       Upload ${SWCONFIG_LOCAL_PATH} in ${SWCONFIG_REMOTE_PATH}.new
    csn.upload_file                 local_path=${SWCONFIG_LOCAL_PATH}
    ...                             remote_path=${SWCONFIG_REMOTE_PATH}.new
    ...                             connection=${GNB_DU.sys[0].M.alias}
    Dated Log                       cp ${SWCONFIG_REMOTE_PATH} ${SWCONFIG_REMOTE_PATH}.sav
    SSH Exec                        command=cp ${SWCONFIG_REMOTE_PATH} ${SWCONFIG_REMOTE_PATH}.sav           alias=${GNB_DU.sys[0].M.alias}
    Dated Log                       remove ${SWCONFIG_REMOTE_PATH}
    SSH Exec                        command=rm ${SWCONFIG_REMOTE_PATH}           alias=${GNB_DU.sys[0].M.alias}
    ${output}=     SSH Exec         command=ls -lrt ${SWCONFIG_REMOTE_PATH}           alias=${GNB_DU.sys[0].M.alias}
    Dated log                       output ls ${SWCONFIG_REMOTE_PATH} = ${output.strip()}
    Dated Log                       cp ${SWCONFIG_REMOTE_PATH}.new ${SWCONFIG_REMOTE_PATH}
    ${output}=     SSH Exec         command=cp ${SWCONFIG_REMOTE_PATH}.new ${SWCONFIG_REMOTE_PATH}     alias=${GNB_DU.sys[0].M.alias}    timeout=20
    ${output}=     SSH Exec         command=ls -lrt ${SWCONFIG_REMOTE_PATH}           alias=${GNB_DU.sys[0].M.alias}
    Dated log                       output ls ${SWCONFIG_REMOTE_PATH} = ${output.strip()}
    Dated Log                       stopSession : crasign ${SWCONFIG_REMOTE_PATH}
    SSH Exec                        command=crasign ${SWCONFIG_REMOTE_PATH}           alias=${GNB_DU.sys[0].M.alias}

Update gNB Swconfig to remove
    [Arguments]                      ${testParam}

    return from Keyword if      '${SHOULD_UPDATE_RAD}' == '0'
    ${l2ps_rdEnableFDMPdschDmrs_0x5801a6}=      create dictionary          field=0x5801a6     value=${testParam.rdEnableFDMPdschDmrs_0x5801a6}

    # 20A Only
    ${742_0x580158}=       Run Keyword If  '${branch}' == '20A'     create dictionary    field=0x580158    value=${testParam.RadParam742_0x580158}

    # 20A Only
    # CPRT	0x590050	rdEnable679A	0x1	TRUE	679-A feature flag, it would activate 679-A
    # when it equals to TRUE and deactivate 679-A when it equals to FALSE.
    #	nicolas.nl.lefevre@nokia.com	0: Disabled [Default], 1: Enabled	unknown	5GC000679-A	unknown
    ${cprt679_A_0x590050}=    Run Keyword If  '${branch}' == '20A'  create dictionary  field=0x590050   value=${testParam.RadParamcprt679_A_0x590050}

    ${cprt_log_level_0x590072}=       create dictionary                  field=0x590072          value=1
    ${l2ps_rdSupportedUlMCS_0x580010}=      create dictionary   field=0x580010        value=${testParam.RadParam_rdSupportedUlMCS_0x580010}

    # 1586-M1
    # 20A Only
    # L2PS	0x5801a1	rd742isPdcchPatternActivated	0x0	TRUE	The parameter disables/enables using PDCCH Pattern for schedulers.
    ${l2ps_rd742isPdcchPatternActivated_0x5801a1}=   Run Keyword If  '${branch}' == '20A'  create dictionary    field=0x5801a1
    ...                                                                     value=${testParam.RadParam_cprtrd742isPdcchPatternActivated_0x5801a1}
    # 20A Only
    # CPRT	0x59005d	rdDynamicPdcchConfigActivation	0x0	FALSE	Enable Dynamic Pdcch Config	xingkai.li@nokia-sbell.com	0: disabled[Default],
    #    1: enabled	unknown	5GC000733-I	unknown
    ${cprt_rdDynamicPdcchConfigActivation_0x59005d}=   Run Keyword If  '${branch}' == '20A'   create dictionary    field=0x59005d
    ...                                                                        value=${testParam.RadParam_rdDynamicPdcchConfigActivation_0x59005d}

    ${swconfig_gnb}=                 Create List           ${l2ps_rdEnableFDMPdschDmrs_0x5801a6}
    ...                                                    ${cprt_log_level_0x590072}
    ...                                                    ${l2ps_rdSupportedUlMCS_0x580010}

    Run Keyword If  '${branch}' == '20A'         Append To List    ${swconfig_gnb}       ${742_0x580158}
    Run Keyword If  '${branch}' == '20A'         Append To List    ${swconfig_gnb}       ${cprt679_A_0x590050}
    Run Keyword If  '${branch}' == '20A'         Append To List    ${swconfig_gnb}       ${l2ps_rd742isPdcchPatternActivated_0x5801a1}
    Run Keyword If  '${branch}' == '20A'         Append To List    ${swconfig_gnb}       ${cprt_rdDynamicPdcchConfigActivation_0x59005d}


Set Specific RAD & scf parameters & iphy & WTS for DSS
   [Arguments]       ${testParam}
    # set specific RAD param for DSS
    Dated Log New Line   Set Specific RAD parameters for DSS
    ${1586_swconfig_gnb}=      Set 1586 Specific RAD     ${testParam}
    common_Dss_Keywords.Update gNB Swconfig     ${1586_swconfig_gnb}
    # scf for 10Mhz
    ${msg}=    Catenate    Scf update for DSS specific ${testParam.scfFile.nrcellfdd.chBwDl} parameters
    Run Keyword If   '${testParam.seq.bandwidth}'=='10MHz'     Dated Log   ${msg}
    # scf for DSS specific parameters  only in case of 10MHz (parameters not BW dependant )
    Run Keyword If   '${testParam.seq.bandwidth}'=='10MHz'     Set SCF NRDBR 1586     ${testParam}
    Run Keyword If   '${testParam.seq.bandwidth}'=='10MHz'     Set SCF NRDDSSLTE 1586     ${testParam}
    Run Keyword If   '${testParam.seq.bandwidth}'=='10MHz'     Set SCF XPIF 1586    ${testParam}
    Dated Log      Scf update for ${testParam.scfFile.nrcellfdd.chBwDl}
    5GC001586_Kw_TestSetup.Set SCF 1586     ${testParam}     ${trunk}
    # iPHY gscn update depending of chBwDl
    Dated Log      iPHY gscn update with ${testParam.scfFile.nrcell.gscn} : chBwDl=${testParam.scfFile.nrcellfdd.chBwDl}
    common_Dss_Keywords.Set Context_AP IPHY    ${testParam}
    # default configuration is 10MHz case , nothing to do in this case
    Run Keyword If   '${testParam.seq.bandwidth}'!='10MHz'   common_Dss_Keywords.Modify Bandwidth Parameters for WTS   ${testParam}

Set Specific RAD & scf parameters
   [Arguments]       ${testParam}    ${swconfig_gnb}   ${btsType}=Classical
    # set specific RAD param for DSS
    Dated Log New Line   Set Specific RAD parameters for DSS
    common_Dss_Keywords.Update gNB Swconfig     ${swconfig_gnb}
    # scf for 10Mhz
    Run Keyword If   '${testParam.seq.bandwidth}'=='10MHz'
    ...                             Dated Log   Scf update for DSS specific ${testParam.scfFile.nrcellfdd.chBwDl} parameters [btsType=${btsType}]
    # scf for DSS specific parameters  only in case of 10MHz (parameters not BW dependant )
    Run Keyword If   '${testParam.seq.bandwidth}'=='10MHz'   Set SCF NRDBR 1586     ${testParam}    btsType=${btsType}
    Run Keyword If   '${testParam.seq.bandwidth}'=='10MHz'   Set SCF NRDDSSLTE 1586     ${testParam}    btsType=${btsType}
    Run Keyword If   '${testParam.seq.bandwidth}'=='10MHz'   Set SCF XPIF 1586    ${testParam}    btsType=${btsType}
    # 5GC001586_Kw_TestSetup.Set SCF IPIF 1586    ${testParam}
    Dated Log      Scf update for ${testParam.scfFile.nrcellfdd.chBwDl} [btsType=${btsType}]
    5GC001586_Kw_TestSetup.Set SCF 1586     ${testParam}    ${trunk}     btsType=${btsType}

