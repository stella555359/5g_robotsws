modify scf cellDepType to NSA only for SANSA Configuration for All Cell expect CellId
    [Documentation]    Kw called in case of MultiCell configuration
    [Arguments]       ${cellId_to_bypass}=1

    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    # set test variable               ${aliasGNB}
    ${cell_list}=         Get All Cell Id                 connection=${aliasGNB}
    Dated log     Get All Cell Id list=${cell_list}
    robot_extension.Run Keyword And Warn On Failure     OAM Disconnect      ${GNB_DU.oam}

    @{modify_params}    Create List
    FOR    ${CELL}  IN  @{cell_list}
        # dated log    CellId=${CELL}
        Continue for loop If    '${CELL}'=='${cellId_to_bypass}'
        dated log    set cellDepType=NSA for CellId ${CELL}
        &{modify_param}    Create Dictionary
        ...    parameter=cellDepType
        ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${CELL}
        ...    value=NSA
        append to List   ${modify_params}    ${modify_param}
    END

    ${status}   ${value}=    Run Keyword And Ignore Error      Should Be Empty    ${modify_params}
    # '${status}' == 'PASS' means ListParamterToModify is empty
    IF    '${status}' != 'PASS'
    ...    BuiltIn.Log      \nParameters to modify:\n @{modify_params}   console=yes
    END
    # coam_gnb_classical.Modify COAM parameters    modify_param=@{modify_param}
    # coam_gnb_classical.Modify COAM parameters with rest API     modify_param=@{modify_param}
    IF    '${status}' != 'PASS'
    ...    OAM Set Params    modify_param=@{modify_params}
    END

    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable              ${test_scf_file}

