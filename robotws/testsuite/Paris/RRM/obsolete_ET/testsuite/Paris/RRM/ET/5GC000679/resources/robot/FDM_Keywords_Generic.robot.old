Capture Bip Traffic
    [Arguments]                        ${airscaleType}
    ...                                ${captureName}
    ...                                ${filtermsg}=@{EMPTY}
    ${CaptureBIPTraffic}               Capture L1L2 Set Upon Config              airscale=${airscaleType}           isMirror=${True}
    ${CaptureBIPTraffic.name}                Set Variable           ${captureName}
    Capture Init                       ${CaptureBIPTraffic}
    ${CaptureBIPTraffic.filter}        BuiltIn.Run Keyword if                    @{filtermsg}==@{EMPTY}
    ...                                CaptureFilter.Get Filter All BIP Msgs
    ...     ELSE                       CaptureFilter.Get Filter For Particular Msgs              bipMsgList=${filtermsg}
    [Return]                           ${CaptureBIPTraffic}

Check Traffic Quality
    [Documentation]     Check DTX and CRC in corresponding uldata_pucchreceiverespharqd on DL traffic
    ...                 or uldata_pucchreceiverespharqd AND uldata_puschreceiverespharqu
    ...                 on UL traffic in format 2
    ...                 calculate the ratio of dtx in function of total number of
    ...                 given uldata_pucchreceiverespharqd msgs
    [Arguments]         ${pcapInput}
    ...                 ${index}
    ...                 ${dtxLimit}=10
    ...                 ${crcLimit}=10
    ...                 ${direction}=dl
    ${pdmlFile}         analyzer.pcap_to_pdml        pcapFile=${pcapInput}
    Set Test Variable              ${TRAFFIC_PDML.pdmlTrf${index}}               ${pdmlFile}
#    Check DTX CRC       index=${index}     direction=${direction}    dtxLimit=${dtxLimit}     crcLimit=${crcLimit}

Check DTX CRC
    [Arguments]         ${index}
    ...                 ${direction}
    ...                 ${dtxLimit}
    ...                 ${crcLimit}
    Dated log new line                  Getting all uldata_puschreceiverespharqu
    @{listAllPuschRecRespHarqU}            analyzer.get_match_from_paths
    ...                                 pdmlFile=${TRAFFIC_PDML.pdmlTrf${index}}
    ...                                 packetName=uldata_puschreceiverespharqu
    ...                                 pathList=${FIELDS_TRF_QUALITY}
    ${lenPuschRecRespHarqU}             get length                                          ${listAllPuschRecRespHarqU}
    Dated Log New Line                  Total number of PuschRecRespHarqU msgs: ${lenPuschRecRespHarqU}
    DTX CRC calcul       listMessage=${listAllPuschRecRespHarqU}     lenMessage=${lenPuschRecRespHarqU}     index=${index}
    Run Keyword If      '${direction}'=='dl'         DTX CRC Calcul DL     index=${index}
    Run Keyword If       ${TRAFFIC_RESULT.dtxPcap${index}} < ${dtxLimit}
    ...                  Dated log new line       Good traffic with dtx=${TRAFFIC_RESULT.dtxPcap${index}}%
    ...                  ELSE     Dated log new line       Bad traffic with dtx=${TRAFFIC_RESULT.dtxPcap${index}}%
    Run Keyword If       ${TRAFFIC_RESULT.crcPcap${index}} < ${crcLimit}
    ...                  Dated log new line       Good traffic with crc=${TRAFFIC_RESULT.crcPcap${index}}%
    ...                  ELSE                 Dated log new line       Bad traffic with crc=${TRAFFIC_RESULT.crcPcap${index}}%
    Should Be True       ${TRAFFIC_RESULT.dtxPcap${index}} < ${dtxLimit}
    Should Be True       ${TRAFFIC_RESULT.crcPcap${index}} < ${crcLimit}

DTX CRC Calcul DL
    [Arguments]                         ${index}
    @{listAllPucchRecRespHarqD}            analyzer.get_match_from_paths
    ...                                 pdmlFile=${TRAFFIC_PDML.pdmlTrf${index}}
    ...                                 packetName=uldata_pucchreceiverespharqd
    ...                                 pathList=${FIELDS_TRF_QUALITY}
    ${lenPucchRecRespHarqD}                get length                                          ${listAllPucchRecRespHarqD}
    Dated Log New Line                  Total number of PucchRespHarqD msgs: ${lenPucchRecRespHarqD}
    DTX CRC Calcul       listMessage=${listAllPucchRecRespHarqD}     lenMessage=${lenPucchRecRespHarqD}     index=${index}

DTX CRC Calcul
    [Arguments]                         ${listMessage}
    ...                                 ${lenMessage}
    ...                                 ${index}
    ${counterNonDtx}                    Set Variable                                        ${0}
    ${counterDtx}                       Set Variable                                        ${0}
    FOR    ${packet}   IN              @{listMessage}
    #       Retrieve pucchFormat and dtx for current PucchRespHarqD
            ${pucchFormat}              Get Value In Packet Match
            ...                         packetMatch=${packet}
            ...                         field=pucchFormat
            ${dtx}                      Get Value In Packet Match
            ...                         packetMatch=${packet}
            ...                         field=dtx
            ${crc}                      Get Value In Packet Match
            ...                         packetMatch=${packet}
            ...                         field=crc
            checkingDtxCrc.checkNonDTX     dtx=${dtx}     format2=${pucchFormat}
            checkingDtxCrc.checkNonCRC     crc=${crc}     format2=${pucchFormat}
    END
    ${counterNonDtx}=                   checkingDtxCrc.resultNonDTX
    ${counterDtx}=                      checkingDtxCrc.resultDTX
    ${counterNonCrc}=                   checkingDtxCrc.resultNonCRC
    ${counterCrc}=                      checkingDtxCrc.resultCRC
    Dated log                           number of NON-DTX:${counterNonDtx}
    Dated log                           number of DTX:${counterDtx}
    Dated log                           number of NON-CRC:${counterNonCrc}
    Dated log                           number of CRC:${counterCrc}
    ${totalDtxMessage}                  EVALUATE                     ${counterDtx}+${counterNonDtx}
    ${ratioOfDtx}                       EVALUATE                     (${counterDtx}/${totalDtxMessage})*100
    ${totalCrcMessage}                  EVALUATE                     ${counterCrc}+${counterNonCrc}
    ${ratioOfCrc}                       EVALUATE                     (${counterCrc}/${totalCrcMessage})*100
    ${ratioOfDtxTotal}                  EVALUATE                     ${TRAFFIC_RESULT.dtxPcap${index}}+${ratioOfDtx}
    ${ratioOfCrcTotal}                  EVALUATE                     ${TRAFFIC_RESULT.crcPcap${index}}+${ratioOfCrc}
    Set Test Variable                   ${TRAFFIC_RESULT.dtxPcap${index}}           ${ratioOfDtxTotal}
    Set Test Variable                   ${TRAFFIC_RESULT.crcPcap${index}}           ${ratioOfCrcTotal}

Check NumOfPrb
    [Documentation]                 Retrieve from pdml value of numOfPrb has to be less than 273
     ...                            from message dldata_pdschsendreq and check prb allocation conditions.
    [Arguments]                     ${pdmlFile}
    ...                             ${dirTraffic}
    ...                             ${maxNumOfPrb}
    ...                             ${listMessageParam}
    ${trafficMessage}=       Set Variable If       '${dirTraffic}'=='dl'     dldata_pdschsendreq      uldata_puschreceivereq
    # 1 - Retrieve from pdml all pucchReceiveReq or pdschSendReq
    Dated log new line              Getting all ${trafficMessage}
    @{listMessageTraffic}           analyzer.get_match_from_paths
    ...                             pdmlFile=${pdmlFile}
    ...                             packetName=${trafficMessage}
    ...                             pathList=${listMessageParam}
    [Return]              ${listMessageTraffic}

Check StartPrb Allocation and NumOfPrb
    [Documentation]                 Check overlap on startPrbAllocation
    ...                             Check message dldata_pdschsendreq on dl or
    ...                             uldata_puschreceivereq on ul.
    [Arguments]                     ${pdmlFile}
    ...                             ${dirTraffic}
    ...                             ${prbMax}=${TDD_PRB_MAX}
    ${packetName}=       Set Variable If       '${dirTraffic}'=='dl'     dldata_pdschsendreq      uldata_puschreceivereq
    Dated log                       Start get_match_from_paths
    SlotSfn.createSlotSfnRecords    pdmlFile=${pdmlFile}
    ...                             packetName=${packetName}
    ...                             pathList=${DATA_SEND_REQ_FIELDS}
    ...                             prbMax=${TDD_PRB_MAX}
    ...                             verbose=${False}
    SlotSfn.printSlotSfnRec         onlyKO=${True}
    ${nbRecord}                     countSlotSfnRecord
    ${nbError}                      SlotSfn.countPrbInconsistency
    Dated log                       NB ERROR=${nbError}/${nbRecord} SlotSfn records
    Should Be Equal                 ${nbError}      ${0}
    ...                             Too many errors in PRB checks (ovelap or limit)

Check Prb Allocation with rat0bitmap
    [Documentation]                 Check overlap PRB in DL with rat0bitmap field in dldata_pdschsendreq
    [Arguments]                     ${pdmlFile}
    ${packetName}=                  Set Variable    dldata_pdschsendreq
    Dated log                       Start get_match_from_paths
    SlotSfn.createSlotSfnRecordsBitmap
    ...                             pdmlFile=${pdmlFile}
    ...                             packetName=${packetName}
    ...                             pathList=${DATA_SEND_REQ_FIELDS_BITMAP}
    ...                             verbose=${False}
    SlotSfn.printSlotSfnRec         onlyKO=${True}
    ${nbRecord}                     countSlotSfnRecord
    ${nbError}                      SlotSfn.countPrbInconsistency
    Dated log                       NB ERROR=${nbError}/${nbRecord} SlotSfn records
    Should Be Equal                 ${nbError}      ${0}
    ...                             Too many errors in PRB checks (ovelap or limit)

Check Counter FDM
    [Arguments]         ${log_path_pm}
    ...                 ${expected_val}
    ...                 ${comparison}
    ...                 &{expected_dict}
    ${foundOrNot}            Run Keyword If                  ${isAic}
    ...                      Counters.Check At Least One Value Is In Criteria From Pm Files For Object With ID on vDU
    ...                      ${expected_val}       ${comparison}         &{expected_dict}
    ...                      ELSE
    ...                      Counters.Check At Least One Value Is In Criteria From Pm Files For Object With ID
    ...                      ${log_path_pm}        ${expected_val}       ${comparison}         &{expected_dict}
    [Return]            ${foundOrNot}

Log Counter FDM
    [Arguments]         ${counter}
    ...                 ${expectedValue}
    ...                 ${result}
    Dated Log           ${counter.name}=${counter.counter}
    Dated Log           ${counter.name}:${expectedValue}=${result}
    Should Be True      '${result}'=='True'

Check PM Counter
    [Documentation]                 KW to check Performance Management (PM) counter list and compare with
    ...                             expected value with an error percentage
    [Arguments]                     ${expectedValue}
    ...                             ${counter_id}
    ...                             ${pm_reporting_period}=0 minutes
    Traced Sleep                    ${pm_reporting_period}
    ${date}                          Get Current Date
    ${date_in_dir_name}              Convert Date         ${date}     result_format=%d%m%Y_%H%M
    ${log_path_pm}                   Set Variable         ${LOG_PATH}/PM_${date_in_dir_name}
    ${pm_latest}                     Collect PM files from BTS    ${log_path_pm}
    ${counter_values}=            Counters.Retrieve NRCell Counter Value From Pm File      ${pm_latest}    ${counter_id}
    Dated Log                     counter_values= ${counter_values}
    Should be Equal                 ${expectedValue}         ${counter_values}

Check PM Counter Greater
    [Documentation]                 KW to check Performance Management (PM) counter list and compare with
    ...                             expected value with an error percentage
    [Arguments]                     ${greaterThanValue}
    ...                             ${counter_id}
    ...                             ${pm_reporting_period}=0 minutes
    Traced Sleep                    ${pm_reporting_period}
    ${date}                          Get Current Date
    ${date_in_dir_name}              Convert Date         ${date}     result_format=%d%m%Y_%H%M
    ${log_path_pm}                   Set Variable         ${LOG_PATH}/PM_${date_in_dir_name}
    ${pm_latest}                     Collect PM files from BTS    ${log_path_pm}
    ${counter_values}=            Counters.Retrieve NRCell Counter Value From Pm File      ${pm_latest}    ${counter_id}
    Dated Log                     counter_values= ${counter_values}
    Should Be True                    ${counter_values} > ${greaterThanValue}

Check PM Counter Equal
    [Documentation]                 KW to check Performance Management (PM) counter list and compare with
    ...                             expected value with an error percentage
    [Arguments]                     ${equalTo}
    ...                             ${counter_id}
    ...                             ${pm_reporting_period}=0
    Traced Sleep                    ${pm_reporting_period}
    ${date}                         Get Current Date
    ${date_in_dir_name}             Convert Date         ${date}     result_format=%d%m%Y_%H%M
    ${log_path_pm}                  Set Variable         ${LOG_PATH}/PM_${date_in_dir_name}
    ${pm_latest}                    Collect PM files from BTS    ${log_path_pm}
    ${counter_values}=              Counters.Retrieve NRCell Counter Value From Pm File      ${pm_latest}    ${counter_id}
    ${counter_val}=	                Convert To Integer	${counter_values}
    Dated Log                       counter_values= ${counter_values}
    Should Be Equal                 ${counter_val}    ${equalTo}

Test Traffic Start Multi with filter DEBUG
    [Documentation]     Cannot use callback capture L1L2 because we need filter on pcap.
    ...                 retrieve PCAP traffic from Airphone
    [Arguments]         ${testParam}
        FOR      ${idUE}      IN RANGE      1        ${testParam.seq.totalUE}+1
         ${ueProfile}       Copy Dictionary       ${UE_PROFILE${idUE}}
         Run Keyword And Continue On Failure      Traffic UE              throughput=${testParam.seq.throughput}
         ...                                      duration=${testParam.seq.trafficDuration}
         ...                                      shouldBeStop=${testParam.seq.stopTraffic}
         ...                                      ueSetting=${ueProfile}
         ...                                      dir=${testParam.seq.dirTraffic}
#    \    ...                                      captureDuration=${testParam.seq.captureDuration}
        END
    ${CaptureBIPTrafficGNB}     Capture Bip Traffic    airscaleType=${GNB_DU}     filtermsg=${testParam.filtermsg}
    ...                                                captureName=${testParam.captureName}
    ${CaptureBIPTrafficAP}      Capture Bip Traffic      airscaleType=${AP_DU}     captureName=${testParam.captureName}
    Set Test Variable                             ${CaptureBIPTrafficGNB}
    Set Test Variable                             ${CaptureBIPTrafficAP}
    Capture Start                                 ${CaptureBIPTrafficGNB}
    Capture Start                                 ${CaptureBIPTrafficAP}
    sleep                                         ${testParam.seq.captureDuration}s
    Capture Stop                                  ${CaptureBIPTrafficGNB}
    Capture Stop                                  ${CaptureBIPTrafficAP}
    Dated Log                    CaptureBipGnb=${CaptureBIPTrafficGNB.path} CaptureBipAP=${CaptureBIPTrafficAP.path}
    Dated Log                    CaptureBipGnb=${CaptureBIPTrafficGNB.path}
    [Return]                     ${CaptureBIPTrafficGNB.path}

Get Distance Name Profile
    [Arguments]              ${endClassParent}
    ...                      ${endClassChild}
    ...                      ${bwpTypeValue}
    XmlScf.StartSession      path=${SCF_SETUP_PATH}
    @{listMO}                XmlScf.getListMOWithAttr
    ...                      endClass=${endClassParent}
    ...                      attrName=bwpType
    ...                      value=${bwpType_value}
    ${profileMO}             set variable                ${listMO[0]}
    ${profileDN}             set variable                ${profileMO.get("distName")}
    Dated log                PROFILE MO:DN=${profileDN}
    ${ManagedObject}         XmlScf.getListMOWithDN
    ...                      endClass=${endClassChild}
    ...                      startDN=${profileDN}
    ${distanceName}          XmlScf.getMODistName     ${ManagedObject[0]}
    Dated log                DistanceName= ${distanceName}
    [Return]                 ${distanceName}


Create Ue List for Multi Ues
	[Arguments]              ${nb_ue}
#	For Ue 1 to....n Ues
	${ue_list}    Create List
	Set Test Variable    ${ue_list}
	FOR   ${ue_id}   IN RANGE   1    ${nb_ue}+1
	    &{current_UE}=    Copy Dictionary    ${UE_SIMPLE}
	    Set To Dictionary    ${current_UE}    ue    ${ue_id}
	    Append To List    ${ue_list}    ${current_UE}
	END

