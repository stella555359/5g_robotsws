    Run Keyword If        ${testParam.checkPucch} and '${pucchModeSelect}[0]' == 'shortPucch'        Prepare UE RRC List
    FOR      ${idUE}      IN RANGE      1         ${testParam.seq.totalUE}+1
         ${ueProfile}     Copy Dictionary         ${UE_PROFILE${idUE}}
         ${CAPTURE_SCTP}                          Test UE attach          ueProfile=${ueProfile}
         ...                                      testParam=${testParam}
         Set suite variable                       ${CAPTURE_SCTP}
         Dated log                                CAPTURE_SCTP=${CAPTURE_SCTP}
         UE Attach Check
#         Run Keyword If        ${testParam.checkPucch} and '${pucchModeSelect}[0]' == 'shortPucch'   Test Check PUCCH
#         ...                   ue=${idUE}
#         ...                   pcapFile=${CAPTURE_SCTP}
#         ...                   technology=${testParam.seq.technology}
    END
#    Run Keyword If        ${testParam.checkPucch} and '${pucchModeSelect}[0]' == 'shortPucch'        Check Start Prb Between UEs
#    ...                 UeRrcList=${UeRrcList}

Prepare UE RRC List
