# TC covered under New Feature
# [1]5GC002574-A1_TC2_Cellsetup_SANSA_10MHz_DL_ratio_max_70_95_Coord_Indication_Update_Procedure
[1][1.0] 5GC002574-A1_TC2_Cellsetup_w_Coord_Update_Ind_10MHz_DL_ratio_max_70_95_Check_Xp
   [Tags]    FULL_RUN    Cellsetup     10MHZ    2574   2574_A1
   ...       CRT
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%, CellSetup with CatM activated
   ...                 DL Coordination Req/Rsp and DL Coordination Update Ind test scenario case
   ...                 Check CatM capabilities and CatMinfo during Coordination procedure
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory    AND
   ...                       common_Dss_Keywords.Prepare Test Name             AND
   ...                       common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp
   ${tc_name}    Set variable    TestLine_preparation
   ${tc_status}    getTcStatusByName    name=${tc_name}
   ${msg}   Catenate   "2574_DSS_Cellsetup: sw release used [${convert_version}], Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%,\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                Check CatM capabilities and CatMinfo during Coordination procedure"
   common_Dss_Keywords.Log Test description   ${msg}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A1}
   ${tc_name}    Set variable    TestLine_2574_Test_setup_10Mhz
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A1}

   # Update nrCellType into Context for CellId=1
   Update nrCellType into "${TestDSS10Mhz_2574_A1}" for cellID "1"

   Update assigned_dl_maximum_share_to_nr with "100" into "${TestDSS10Mhz_2574_A1}"

   # desactivate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS10Mhz_2574_A1}"

   5GC002574_keywords.TC 2574 CellSetup         ${TestDSS10Mhz_2574_A1}   egate_TC2

   ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
   should contain	                ${output}	                            passed

   [Teardown]      Run Keywords    Update assigned_dl_maximum_share_to_nr with   ${TestDSS10Mhz_2574_A1}   70    AND
   ...                             common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
   ...                             Teardown 2574      alias=egate_TC2    AND
   ...                             set Suite Variable  ${testCaseDir}  None

# TC covered under New Feature
# [1]5GC002574-A1_TC2_Cellsetup_SANSA_10MHz_DL_ratio_max_70_95_Coord_Indication_Update_Procedure
[1][1.0] 5GC002574-A1_TC2_Bis_Cellsetup_w_Coord_Update_Ind_10MHz_DL_ratio_max_70_95_Check_Cprt
   [Tags]    FULL_RUN    Cellsetup     10MHZ    2574   2574_A1
   ...       CRT
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%, CellSetup with CatM activated
   ...                 DL Coordination Req/Rsp and DL Coordination Update Ind test scenario case
   ...                 Check CPRT CatM activation
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory    AND
   ...                       common_Dss_Keywords.Prepare Test Name
   ${tc_name}    Set variable    TestLine_preparation
   ${tc_status}    getTcStatusByName    name=${tc_name}
   ${msg}   Catenate   "2574_DSS_Cellsetup: sw release used [${convert_version}], Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%,\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                Check CPRT CatM activation"
   common_Dss_Keywords.Log Test description   ${msg}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A1}
   ${tc_name}    Set variable    TestLine_2574_Test_setup_10Mhz
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A1}

   # Update nrCellType into Context for CellId=1
   Update nrCellType into "${TestDSS10Mhz_2574_A1}" for cellID "1"

   Update assigned_dl_maximum_share_to_nr with "100" into "${TestDSS10Mhz_2574_A1}"

   # desactivate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS10Mhz_2574_A1}"

   # update CatM data with CatMinfo_10MHz_CatMData_Slot_6_period_1 in Context
   Update CatMinfo with ${CatMinfo_10MHz_CatMData_Slot_6_period_1} into "${TestDSS10Mhz_2574_A1}"

   5GC002574_keywords.TC 2574 CellSetup to check CPRT CatM activation         ${TestDSS10Mhz_2574_A1}   egate_TC3

   Update CatMinfo with ${CatMinfo_10MHz} into "${TestDSS10Mhz_2574_A1}"

   ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
   should contain	                ${output}	                            passed

   [Teardown]      Run Keywords    Update assigned_dl_maximum_share_to_nr with   ${TestDSS10Mhz_2574_A1}   70    AND
   ...                             Teardown 2574      alias=egate_TC3    AND
   ...                             set Suite Variable  ${testCaseDir}  None

# TC covered under New Feature
# [1]5GC002574_A1_TC4_Cellsetup_SANSA_10MHz_DL_ratio_max_70_95_Coord_Indication_Update_Procedure_Fast_AllocationActivated
[1][1.0] 5GC002574-A1_TC4_Cellsetup_w_Coord_Update_Ind_10MHz_DL_ratio_max_70_95_w_superfast_allocation
   [Tags]    FULL_RUN    Cellsetup     10MHZ    2574   2574_A1
   ...       CRT
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%, CellSetup with CatM activated
   ...                 DL Coordination Req/Rsp and DL Coordination Update Ind test scenario case
   ...                 Check CPRT CatM activation with superfast allocation activated
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory    AND
   ...                       common_Dss_Keywords.Prepare Test Name
   ${tc_name}    Set variable    TestLine_preparation
   ${tc_status}    getTcStatusByName    name=${tc_name}
   ${msg}   Catenate   "2574_DSS_Cellsetup: sw release used [${convert_version}], Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%,\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                Check CPRT CatM activation with superfast allocation activated"
   common_Dss_Keywords.Log Test description   ${msg}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_2574_A1}
   ${tc_name}    Set variable    TestLine_2574_Test_setup_10Mhz
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS10Mhz_2574_A1}

   # Update nrCellType into Context for CellId=1
   Update nrCellType into "${TestDSS10Mhz_2574_A1}" for cellID "1"

   Update assigned_dl_maximum_share_to_nr with "100" into "${TestDSS10Mhz_2574_A1}"

   # activate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "true" value and update into "${TestDSS10Mhz_2574_A1}"

   5GC002574_keywords.TC 2574 CellSetup to check CPRT CatM activation         ${TestDSS10Mhz_2574_A1}   egate_TC4

   ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
   should contain	                ${output}	                            passed

   # add here the DL Pattern list to add to CRMSim and activate it ....
   DSS_5g_Periodic_DL_Fast_Allocation           ${TestDSS10Mhz_2574_A1}    egate_TC4

   [Teardown]      Run Keywords   Update assigned_dl_maximum_share_to_nr with   ${TestDSS10Mhz_2574_A1}   70    AND
   ...                            Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value    AND
   ...                            5GC002574_Kw_TestSetup.Update DSS superfast_allocation with    ${TestDSS10Mhz_2574_A1}    false     AND
   ...                            Teardown 2574      alias=egate_TC4    AND
   ...                            set Suite Variable  ${testCaseDir}  None


