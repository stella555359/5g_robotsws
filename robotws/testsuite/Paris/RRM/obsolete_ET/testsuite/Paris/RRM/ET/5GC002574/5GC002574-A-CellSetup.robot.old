# TC covered under New Feature
# [1]5GC002574-A1_TC7_Cellsetup_SANSA_10MHz_DL_ratio_max_70_95_Failure_Case_DL_Cell_Alloc_Req_wo_CATMInfoReceived
[1][1.0] 5GC002574-A1_TC7_Cellsetup_SANSA_20MHz_DL_ratio_max_70_95_DL_Cell_Alloc_Failure_PRB_area_C_D_SIB1_BR_missing
   [Tags]    FULL_RUN    CellsetupFailureCase     20MHZ    2574   2574_A1
   ...       CRT
   [Documentation]     Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%, CellSetup with CatM activated
   ...                 DL Coordination Req/Rsp and DL Coordination Update Ind test scenario case
   ...                 Check CatM capabilities and CatMinfo during Coordination procedure
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory    AND
   ...                       common_Dss_Keywords.Prepare Test Name             AND
   ...                       common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp
   ${tc_name}    Set variable    TestLine_preparation
   ${tc_status}    getTcStatusByName    name=${tc_name}
   ${msg}   Catenate   "2574_DSS_Cellsetup: sw release used [${convert_version}], Cellsetup Dss phase 3, BW= 10MHz, DL RATIO = 100%,\n
   ...                CellSetup with CatM activated,\nDL Coordination Req/Rsp and DL Coordination Update Ind test scenario case,\n
   ...                Check CatM capabilities and CatMinfo during Coordination procedure"
   common_Dss_Keywords.Log Test description   ${msg}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS20Mhz_2574_A}
   ${tc_name}    Set variable    TestLine_2574_Test_setup_20MHz
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS20Mhz_2574_A}

   # Update nrCellType into Context for CellId=1
   Update nrCellType into "${TestDSS20Mhz_2574_A}" for cellID "1"

   Update assigned_dl_maximum_share_to_nr with "100" into "${TestDSS20Mhz_2574_A}"

   # desactivate superfast_allocation in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS20Mhz_2574_A}"

   # DSS Cellsetup with only PRB_area_A_B_SIB1_BR provided by CRMSim
   # Test is executed on 20MHz BW and as PRB_area_C_D_SIB1_BR are missing => DL Allocation Req Failure case
   ${cellsetup_shouldBe_checked_previously}   set variable   ${CELLSETUP_SHOULD_BE_CHECK}
   Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}   0
   # update wts waiting pattern with Received DSS DL Resource Area Allocation Failure in this case
   5GC002574_keywords.Update pattern "Received DSS DL Resource Area Allocation Failure" into "${TestDSS20Mhz_2574_A}" Context

   5GC002574_keywords.TC 2574 CellSetup         ${TestDSS20Mhz_2574_A}   egate_TC7

   # go back to default value
   5GC002574_keywords.Update pattern "Received DSS DL Resource Area Allocation Response" into "${TestDSS20Mhz_2574_A}" Context

   ${output}=    nps_2574_tools.Verify QC Test Case    verify_5GC002574_activation
   should contain	                ${output}	                            passed

   [Teardown]      Run Keywords    Set global variable    ${CELLSETUP_SHOULD_BE_CHECK}    ${cellsetup_shouldBe_checked_previously}      AND
   ...                             Update assigned_dl_maximum_share_to_nr with   ${TestDSS20Mhz_2574_A}   70    AND
   ...                             common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
   ...                             Teardown 2574      alias=egate_TC7    AND
   ...                             set Suite Variable  ${testCaseDir}  None

# TC covered under New Feature
# [1]5GC002574-A1_TC3_Cellsetup_SANSA_10MHz_DL_ratio_max_70_95_Failure_Case
[1][1.0] 5GC002574-A1_TC3_Cellsetup_SANSA_20MHz_DL_ratio_max_70_95_Failure_Case
   [Tags]    FULL_RUN    Cellsetup     20MHZ    2574   2574_A1
   ...       CRT
   [Documentation]     Cellsetup Dss phase 3, BW= 20MHz, DL RATIO = 100%, CellSetup with CatM desactivated on gNB but
   ...                 activated on CRM side
   ...                 DL Coordination Req/Rsp Failure test scenario case
   ...                 Check Coordination Failure procedure
   [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
   ...                       common_Dss_Keywords.Get testcase log directory    AND
   ...                       common_Dss_Keywords.Prepare Test Name             AND
   ...                       common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp
   ${msg}   Catenate   "2574_DSS_Cellsetup: sw release used [${convert_version}], Cellsetup Dss phase 3, BW= 20MHz, DL RATIO = 100%,\n
   ...                CellSetup with CatM desactivated on gNB but activated on CRM side\n
   ...                Check Coordination Failure procedure"
   common_Dss_Keywords.Log Test description   ${msg}
   ${tc_name}    Set variable    TestLine_preparation
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Line Preparation    ${TestDSS20Mhz_2574_A}
   ${tc_name}    Set variable    TestLine_2574_Test_setup_20Mhz
   ${tc_status}    getTcStatusByName    name=${tc_name}
   Run keyword if    '${tc_status}'!='PASS'
   ...           5GC002574_Kw_TestSetup.Test Setup 2574    ${TestDSS20Mhz_2574_A}

   # Update nrCellType into Context for CellId=1
   Update nrCellType into "${TestDSS20Mhz_2574_A}" for cellID "1"

   Update assigned_dl_maximum_share_to_nr with "100" into "${TestDSS20Mhz_2574_A}"

   # desactivate superfast_allocation and actLteNrDssLteCatM in scf and Param context (used during CellSetup)
   Set 2574 Specifc Scf Param actLteNrDssFastAlloc with "false" value and update into "${TestDSS20Mhz_2574_A}"
   Set 2574 Specifc Scf Param actLteNrDssLteCatM with "false" value and update into "${TestDSS20Mhz_2574_A}"

   # only to activate CatM on CRM side => CatM is still activated on CRMSim side and desactivated on gNB side
   Update DSS actLteNrDssLteCatM with "true" into "${TestDSS20Mhz_2574_A}"

   5GC002574_keywords.TC 2574 CellSetup Coordination Failure Case         ${TestDSS20Mhz_2574_A}   egate_TC3

   [Teardown]      Run Keywords    Set 2574 Specifc Scf Param actLteNrDssLteCatM with "true" value   AND
   ...                             Update DSS actLteNrDssLteCatM with    ${TestDSS20Mhz_2574_A}    true     AND
   ...                             Update assigned_dl_maximum_share_to_nr with   ${TestDSS20Mhz_2574_A}   70    AND
   ...                             common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
   ...                             Teardown 2574      alias=egate_TC3    AND
   ...                             set Suite Variable  ${testCaseDir}  None


