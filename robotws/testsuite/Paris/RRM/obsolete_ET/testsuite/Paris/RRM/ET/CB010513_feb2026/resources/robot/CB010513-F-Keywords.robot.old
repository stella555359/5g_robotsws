    WA Airscale Wait for Ready    ${GNB_DU}
    # Restart.F1 Wait Link Classical

Set RAD Params Of CB010513 F
    [Documentation]     Add or Modify the RAD params of 8940 To Activate the feature
    ...                 will be replaced later by NIDD params
    ...                 0x580117=1 : #CSI-RS Event Sherpa
    ...                 0x58012B=1 : Canada Frame Struct
    ...                 0x58070a=1 : 10513-E rdCellCsiRsPeriodicityBbPoolExtensionTddFr1, for L2PS
    ...                 0x5901dd=1 : 10513-F rdCprt for L3
    Dated Log New Line   Add RAD params of 8940-F InterL1SubPool and ZeroAllocationByPass are Disabled ......
    ${rad_param_1}=      create dictionary       field=0x580117    value=1
    ${rad_param_2}=      create dictionary       field=0x58012B    value=1
    # ${rad_param_3}=      create dictionary       field=0x58070a    value=1
    # ${rad_param_4}=      create dictionary       field=0x5901dd    value=1
    ${rad_param_list}=       Create List         ${rad_param_1}
    ...                                          ${rad_param_2}
    # ...                                          ${rad_param_3}
    # ...                                          ${rad_param_4}
    Dated Log New Line    RAD params :  ${rad_param_list}
    SetConfig.Set Fields in swconfig DU       param_list=${rad_param_list}
    Dated Log New Line   RAD params of 10513-F update completed

Multi Cells Setup CB010513 F
    [Arguments]       ${nbCell}
    ${msgStr}=    Catenate  Test ${nbCell} Cells Setup
    Dated Log   ${msgStr}
    Setup Wtsemu SA
    sleep    60s
    WTS Set X2 Link
    sleep    5s
    #wtsemu.ue_testmode_decode_muxphychan    decode_mux_phy_chan=decode_PDSCH
    #sleep    2s

SA Call DL UL Traffic With UE Profile
    [Arguments]                      ${ue_profile}
    [Documentation]                  1  UE SA call  based on UE profile (ue_id, pdu, gw, dl_tput, ul_tput, deviation)
    ...                              This keyword can be used to perform a UE call based on the UE profile
    ...                              how to use :
    ...                              - create a dictionary of ue profile with the following structure:
    ...                                 &{Profile_UE}
    ...                                     ue_id=1
    ...                                     pdu=1
    ...                                     gw=1
    ...                                     dl_tput=175   #(tput in mbps)
    ...                                     ul_tput=50
    ...                                     deviation=40  #(percentage of expected deviation of tput)
    ...                              - call the keyword with the UE profile
    ...                                     SA Call DL Traffic With UE Profile     ${Profile_UE}
    CallSetup.UE Register            ue=${ue_profile.ue_id}
    sleep                            1s
    CallSetup.Launch PDU Session     ue=${ue_profile.ue_id}     pdu=${ue_profile.pdu}       gw=${ue_profile.gw}
    sleep                            1s
    ${ueSetting}                     set variable            ${BASIC_UE_SA}
    ${ueSetting.pdu}                 set variable            ${ue_profile.ue_id}
    ${ueSetting.ue}                  set variable            ${ue_profile.ue_id}
    Traffic UE DL                    ueSetting=${BASIC_UE_SA}    throughput=${ue_profile.dl_tput}
    ...                              shouldBeStop=False          deviation=${ue_profile.deviation}
    ...                              shouldBeCheck=False
    sleep                            1s
    Traffic UE UL                    ueSetting=${BASIC_UE_SA}    throughput=50
    ...                              shouldBeStop=False          deviation=${ue_profile.deviation}
    ...                              shouldBeCheck=False

Check CB010513 F PM Counters
    Check CB010513 F PM Counters Expected values      ${CB010513_F_BB_POOL_DL_Counter_Expected}
    Check CB010513 F PM Counters Expected values      ${CB010513_F_BB_POOL_UL_Counter_Expected}

Check CB010513 F PM Counters Expected values
    [Documentation]                 To Check CB010513 F PM counter values are as exepected
    [Arguments]                     ${PM_Counters_Expected}
    Dated Log                       =======================================================================
    Dated Log                       PM counter : ${PM_Counters_Expected.PM_ID}
    Dated Log                       --------------------------------------------------------------------------------
    ${Value_PM_Counter_Cell_1}=            Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                                    ${LATEST_PM_FILE}       ${PM_Counters_Expected.PM_ID}       ${NRCELLID_1_idx}
    Dated Log                         Value of PM counter : ${PM_Counters_Expected.PM_ID} : cell : ${NRCELLID_1_idx} : ${Value_PM_Counter_Cell_1}
    ${Value_PM_Counter_Cell_2}=            Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                                    ${LATEST_PM_FILE}       ${PM_Counters_Expected.PM_ID}       ${NRCELLID_2_idx}
    Dated Log                         Value of PM counter : ${PM_Counters_Expected.PM_ID} : cell : ${NRCELLID_2_idx} : ${Value_PM_Counter_Cell_2}
    ${Value_PM_Counter_Cell_3}=            Counters.Retrieve Latest Single Counter Value From Pm File with CellID
    ...                                    ${LATEST_PM_FILE}       ${PM_Counters_Expected.PM_ID}       ${NRCELLID_3_idx}
    Dated Log                         Value of PM counter : ${PM_Counters_Expected.PM_ID} : cell : ${NRCELLID_3_idx} : ${Value_PM_Counter_Cell_3}
    should be true      ${Value_PM_Counter_Cell_1} == ${PM_Counters_Expected.CELL_1_Expected}
    should be true      ${Value_PM_Counter_Cell_2} == ${PM_Counters_Expected.CELL_2_Expected}
    should be true      ${Value_PM_Counter_Cell_3} == ${PM_Counters_Expected.CELL_3_Expected}

Check CB010513 F PM Counters With Constraints
    [Documentation]                 To Check CB010513 F PM counter values are as exepected
    [Arguments]                     ${KPI_Constrains_File_Name}
    Dated Log                        ====> check counter and KPI constraints is started
    Dated Log                        ====> Latest PM counter file is : ${LATEST_PM_FILE}
    KPI Evaluate                    pmFile=${LATEST_PM_FILE}
    ...                             constraintsFile=${KPI_Constrains_File_Name}
    ...                             failOnError=${True}
    Dated Log                        ====> check counter and KPI constraints ended

Collect TTI Traces
    [Documentation]                 To collect TTI traces for test
    ${TestName}                     getFormattedName
    ${TTIdir}                       Get TTI Trace Path                 dir_suffix=${TestName}_TTI
    Dated Log                       ====== start TTI capture : ======
    Start TTI Traces in Streaming mode      src_ip=10.0.1.2
    Traced Sleep                    duration=5      msg=TTI capture during DL UL traffic
    ${TTIpcap}                      Stop TTI Traces in Streaming mode
    ...                             tti_trace_path=${TTIdir}
    ...                             tti_trace_filename=TTI_Trace_DL_UL
    Traced Sleep                    duration=5      msg=TTI capture end
    Dated Log                       ====== Convert TTItrace : ${TTIpcap} to json and csv ======
    ${TTIjson}                      Convert TTItrace from pcap to others
    ...                             input_file_path=${TTIpcap}
    ${TTIcsv}                       decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=10000
    Dated Log                       ====== json file : ${TTIjson} csv file : ${TTIcsv}

Post processing TTI Traces
