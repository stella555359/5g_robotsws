*** Keywords ***

Set SCF Context
	${SCF_MODIFIED}                 Set Variable          ${SCF_SETUP_PATH}.modif
	Copy File                       ${SCF_SETUP_PATH}     ${SCF_MODIFIED}
	SCF StartSession                scf_file=${SCF_MODIFIED}
	
	${dist_name}         Set Variable    MRBTS-1/NRBTS-1/NRCELL-1
	SCF Set element    dist_name=${dist_name}    element_name=chBw  element_value=50MHz
	SCF Set element    dist_name=${dist_name}    element_name=actDl256Qam  element_value=false
	SCF Set element    dist_name=${dist_name}    element_name=actUl256Qam  element_value=false	
	
	SCF StopSession      scf_file=${SCF_MODIFIED}
    Dated Log    ----> Modifications completed.\n

    OAM Perform Full Commissioning          scf_file=${SCF_MODIFIED}
    WA Airscale Wait For Ready                  ${GNB_DU}
    Dated Log    ----> Airscale Ready.\n

Collect PM Counters File
    [Documentation]                 KW to get counters and store in specific directory with day date

    ${date}                          robot.libraries.DateTime.Get Current Date
    ${date_in_dir_name}              robot.libraries.DateTime.Convert Date         ${date}     result_format=%d%m%Y_%H%M
    ${log_path_pm}                   Set Variable         ${LOG_PATH}/PM_${date_in_dir_name} 
    BuiltIn.Log              The PM counters file collected from gnb will be stored under : ${log_path_pm}
    ${pm_latest}                    Counters.Collect PM files from BTS    ${log_path_pm}
    set Suite Variable              ${LATEST_FILE}       ${pm_latest}
    set Suite Variable              ${log_path_pm}
    BuiltIn.Log     Latest pm counters file : ${LATEST_FILE}

Check MCS Values    

    ${valMCS20}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_MCS_20_Cell1}
    Dated Log           Valeur de ${PM_Counter_MCS_20} ${valMCS20}
	${valMCS21}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_MCS_21_Cell1}
    Dated Log           Valeur de ${PM_Counter_MCS_21} ${valMCS21}
    ${valMCS22}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_MCS_22_Cell1}
    Dated Log           Valeur de ${PM_Counter_MCS_22} ${valMCS22}
	${valMCS23}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_MCS_23_Cell1}
    Dated Log           Valeur de ${PM_Counter_MCS_23} ${valMCS23}
    ${valMCS24}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_MCS_24_Cell1}
    Dated Log           Valeur de ${PM_Counter_MCS_24} ${valMCS24}
    ${valMCS25}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_MCS_25_Cell1}
    Dated Log           Valeur de ${PM_Counter_MCS_25} ${valMCS25}
    ${valMCS26}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_MCS_26_Cell1}
    Dated Log           Valeur de ${PM_Counter_MCS_26} ${valMCS26}
    ${valMCS27}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_MCS_27_Cell1}
    Dated Log           Valeur de ${PM_Counter_MCS_27} ${valMCS27}
    ${valMCS28}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_MCS_28_Cell1}
    Dated Log           Valeur de ${PM_Counter_MCS_28} ${valMCS28}

    should be true      ${valMCS21} > (${valMCS20} + ${valMCS22}) 
    should be true      ${valMCS24} > (${valMCS23} + ${valMCS25})
    should be true      ${valMCS28} > (${valMCS27} + ${valMCS26})
	
Check MCS UL Values
    
    ${valMCS20UL}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_PUSCH_MCS_20_Cell1}
    Dated Log           Valeur de ${PM_Counter_PUSCH_MCS_20} ${valMCS20UL}
    ${valMCS21UL}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_PUSCH_MCS_21_Cell1}
    Dated Log           Valeur de ${PM_Counter_PUSCH_MCS_21} ${valMCS21UL}
    ${valMCS22UL}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_PUSCH_MCS_22_Cell1}
    Dated Log           Valeur de ${PM_Counter_PUSCH_MCS_22} ${valMCS22UL}
	${valMCS23UL}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_PUSCH_MCS_23_Cell1}
    Dated Log           Valeur de ${PM_Counter_PUSCH_MCS_23} ${valMCS23UL}
    ${valMCS24UL}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_PUSCH_MCS_24_Cell1}
    Dated Log           Valeur de ${PM_Counter_PUSCH_MCS_24} ${valMCS24UL}
    ${valMCS25UL}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_PUSCH_MCS_25_Cell1}
    Dated Log           Valeur de ${PM_Counter_PUSCH_MCS_25} ${valMCS25UL}
    ${valMCS26UL}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_PUSCH_MCS_26_Cell1}
    Dated Log           Valeur de ${PM_Counter_PUSCH_MCS_26} ${valMCS26UL}
    ${valMCS27UL}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_PUSCH_MCS_27_Cell1}
    Dated Log           Valeur de ${PM_Counter_PUSCH_MCS_27} ${valMCS27UL}
    ${valMCS28UL}=    Counters.Retrieve Sum of Values Counter From Pm Files with CellID
    ...        ${log_path_pm}   &{PM_Counter_PUSCH_MCS_28_Cell1}
    Dated Log           Valeur de ${PM_Counter_PUSCH_MCS_28} ${valMCS28UL}

    should be true      ${valMCS22UL} > (${valMCS21UL} + ${valMCS20UL}) 
    should be true      ${valMCS25UL} > (${valMCS24UL} + ${valMCS23UL})
    should be true      ${valMCS28UL} > (${valMCS27UL} + ${valMCS26UL})

