...                                 M55314C03009=2        M55323C01009=1
...                                 M55323C04009=1
...                                 M55313C08009=1     M55313C04009=1
...                                 M55313C09009=1     M55112C00502=1
...                                 M55117C00528=2     M55117C00529=2       M55117C00532=2
...                                 M55117C00533=2     M55110C00034=1       M55112C00002=1
...                                 M55112C00003=1     M55112C03002=1       M55113C01001=1
...                                 M55113C01002=1     M55319C02009=1
...                                 M55123C00003=1     M55123C00004=1
...                                 M55301C09001=1     M55301C09002=1

# Dictionary to retrieve nodeTypes to which a counter belongs - AiC case
&{dict_counter_nodeTypes}           M55319C02009=CU
...                                 M55314C03009=DU        M55323C01009=CU
...                                 M55323C04009=CU
...                                 M55313C08009=CU     M55313C04009=CU
...                                 M55313C09009=CU     M55112C00502=CU
...                                 M55117C00528=DU     M55117C00529=DU       M55117C00532=DU
...                                 M55117C00533=DU     M55110C00034=CU       M55112C00002=CU
