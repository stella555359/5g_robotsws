...                                 M55113C01002=CU     M55319C02009=CU
...                                 M55123C00003=CU     M55123C00004=CU
...                                 M55301C09001=DU     M55301C09002=DU

# Dictionary embedding counters dictionaries for all TCs
&{dict_kpis_all_tc}    5GC001248_J_60=${dict_kpis_tc_1248_J_60}    5GC001248_J_73=${dict_kpis_tc_1248_J_73}
...                    5GC001248_J_66=${dict_kpis_tc_1248_J_66}    5GC001248_J_59=${dict_kpis_tc_1248_J_59}
...                    5GC001248_J_64=${dict_kpis_tc_1248_J_64}
