...                    5GC001248_J_61=${dict_kpis_tc_1248_J_61}    5GC001248_J_62=${dict_kpis_tc_1248_J_62}
...                    5GC001248_D=${dict_kpis_tc_1248_D}
...                    5GC001248_M_1=${dict_kpis_tc_1248_M_1}
...                    5GC001248_M_2=${dict_kpis_tc_1248_M_2}

*** Keywords ***
-
# KW used to be sure to report 2 layers inside PUCCH RI
# Not used yet. Default value for scell ID (8) is used.
Update Cell Range Bounds
    [Documentation]                 KW used to update cell range bound which will be used for
    ...                             all egate commands
    ...                             Dedicated KW used to not every param changes.
    [Arguments]                     ${ueSetting}

    ${console_msg}           Evaluate     "${BG_CYAN}Updating Cell range bounds${NORMAL}"
    Dated Log                ${console_msg}

    # Update cell bound range only
    wtsemu.enb_endc_param                serving_cell_index_range_scg=${auto_1248_cell_lower_bound}:${auto_1248_cell_upper_bound}


Update RI reported values
    [Documentation]             This KW is used to send a command to WTS in order to report a rank 2 towards gNB (i.e.: RI=1)
    ...                         In fact, it seems useless as, by doing some trials, reported rank is already set to 2
    ...                         However, when looking at the configured default test configuration RI is set to 0...
    ...                         I don't really know why there is a difference. To be sure I have added this WTS command
    ...                         in order to change the test mode RI to 1 instead of 0 as it's displayed.
    ...                         May be it's useless ?
    [Arguments]                 ${ueSetting}
    ...                         ${ri_value}=1

    ${console_msg}              Evaluate     "${BG_CYAN}Updating RI values to rank ${ri_value}${NORMAL}"
    Dated Log                   ${console_msg}

    # Be sure to have RI reported to 1 in order to perform DL in 2 layers.
    wtsemu.csi_override_testmode_nr             profile_id=1            ri_mode=fixed               ri=1
    wtsemu.ue_testmode_set_nr                   id=${ueSetting.ue}      testmode=csi_override       action=activate     profile_id=1


# KW used to update DDDS reported value over X2 during test execution
Update DDDS Parameters
    [Documentation]                 KW used to update DDDS reported value over X2 during test execution

    [Arguments]                     ${ueSetting}
    ...                             ${dbs}=1000
    ...                             ${ddr}=0
    ...                             ${success_rate}=100

    ${console_msg}           evaluate
    ...                      "${BG_CYAN}Updating DDDS param to DBS=${dbs}, DDR=${ddr}, Success ratio=${success_rate}${NORMAL}"
    Dated Log                ${console_msg}

    # Set DDDS related parameters
    wtsemu.enb_endc_param               id=${ueSetting.ue}        desired_buffer_sizes=${dbs}:${ddr}
    ...                                 dl_data_delivery_success_rate=${success_rate}


Set DDDS Drop Configuration
    [Documentation]                 KW used to drop DDDS report on X2 side
    ...                             As this command is not available under taf interface, direct connection
    ...                             is used toward egate.
    ...                             enb_endc_param id=1 ddds_transmission=3:200  : Drop 15 reports DDDS every
    ...                             300 DDDS (150 ms hole)
    ...                             ddds_transmission = off => Stop sending DDDS
    ...                             ddds_transmission = on => Send DDDS again
    [Arguments]                     ${ueSetting}
    ...                             ${ddds_transmission}

    # Run egate command
    wtsemu.enb_endc_param             id=${ueSetting.ue}        ddds_transmission=${ddds_transmission}

    ${console_msg}           Evaluate     "${BG_CYAN}DDDS reports are now set to: ${ddds_transmission}${NORMAL}"
    Dated Log                ${console_msg}

Enable BLER on F1 side
    [Documentation]                 KW used to enable BLER on DU side by using link adaptation.
    ...                             AP will reduc ereported CQI until target MCS (0) is reached.
    ...                             This will reduce availbale DL thourhgput and thus trigger FC
    ...                             at L2HI level.
    ...                             BLER profile is supposed to be NOT defined inside AirphoneConfig.xml file.
    ...                             Otherwise, egate commande will be ignored.
    [Arguments]                     ${ueSetting}


    # Define BLER configuration to reach MCS=0
    wtsemu.bler_testmode_nr             profile_id=3        target_mcs=0       num_dl_pkts=2000

    # Activate BLER generation
    #
    # Here several things are supposed to be true:
    # 1. The test mode parameters related to BLER and RI have been removed from AirphoneConfig.xml file
    # 2. Default value reported for RI is 1 inside PUCCH.
    # It means DL traffic will use 2 layers.
    # Otherwise, expected throughput (20 Mbps) can't be reached with MCS0. True so far
    # 3. scell ID is set to 8 (auto_1248_default_cell_bound). True so far
    wtsemu.ue_testmode_set_nr               id=${ueSetting.ue}            testmode=bler             profile_id=3
    ...                                     scell=${auto_1248_default_cell_bound}                   action=activate

    ${console_msg}           Evaluate     "${BG_CYAN}BLER is now enabled for UE ${ueSetting.ue}${NORMAL}"
    Dated Log               ${console_msg}

Disable BLER on F1 side
    [Documentation]                 KW used to disable BLER on DU side.
    [Arguments]                     ${ueSetting}

    # Disable BLER generation
    wtsemu.ue_testmode_set_nr               id=${ueSetting.ue}            testmode=bler             profile_id=3
    ...                                     scell=${auto_1248_default_cell_bound}                   action=deactivate

    ${console_msg}           Evaluate     "${BG_CYAN}BLER is now disabled for UE ${ueSetting.ue}${NORMAL}"
    Dated Log               ${console_msg}


Add New Bearer Definition Configuration
    [Documentation]                 Keywork used to set flow control configuration like Five Qi and NRDBR
    ...                             QCI (related to feature 5GC000776 ???)
    ...                             Optionnal depends on enable_new_bearer_definition_configuration value
    [Arguments]                     ${split_mode}
    ...                             ${fc_mode}
    ...                             ${initial_dl}

    &{mode_fc_2}                    Run Keyword if    '${split_mode}' == 'dlOverF1U'
    ...                                 Create Dictionary    dlDataSplitMode=${split_mode}
    ...                                                      initialDLTrafficRouting=${initial_dl}
    ...                                                      actPrioritizeX2AfterInactivity=false
    ...                             ELSE
    ...                                 Create Dictionary    dlDataSplitMode=${split_mode}
    ...                                                      initialDLTrafficRouting=${initial_dl}
    ...                                                      actPrioritizeX2AfterInactivity=true

    # List of DRB configuration to be updated
    @{nrdrb_list}                   Create List
    ...                                 MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRDRB-1
    ...                                 MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRDRB-2
    ...                                 MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRDRB-3
    ...                                 MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRDRB-4
    ...                                 MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRDRB-5
    ...                                 MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRDRB-6
    ...                                 MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRDRB-7
    ...                                 MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRDRB-8
    ...                                 MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRDRB-9

    @{param_list_new_bearers_definition}                   Create List

    FOR        ${drb}      IN      @{nrdrb_list}
        &{p_drb}    Evaluate    {'dist_name': '${drb}','parameter': 'dlFlowControlAlgo','value':'${fc_mode}'}
        Append To List    ${param_list_new_bearers_definition}    ${p_drb}
        Run Keyword If    '${auto_1248_j_debug_scf_update}' == 'True'    Log To Console  Adding: ${p_drb} to SCF param list

    END
    FOR        ${drb}      IN      @{nrdrb_list}

        &{p_drb}    Evaluate    {'dist_name': '${drb}','parameter': 'nsaDrbParam','value':[&{mode_fc_2}]}
        Append To List    ${param_list_new_bearers_definition}    ${p_drb}
        Run Keyword If    '${auto_1248_j_debug_scf_update}' == 'True'    Log To Console  Adding: ${p_drb} to SCF param list

    END
    [Return]                       @{param_list_new_bearers_definition}


# Set gNB and WTS parameters related to 3GPP
Build Set Flow Control Configuration List
    [Documentation]                 Set FC parameters mode for NSA (useless far SA ???)
    ...                             Default values are proposed, but can be override
    [Arguments]                     ${split_mode}=dlOverF1UX2U
    ...                             ${initial_dl}=initDLoverX2U
    ...                             ${actDl256Qam}=false


    &{mode_fc_1}                    Run Keyword if    '${split_mode}' == 'dlOverF1U'
    ...                                 Create Dictionary    dlDataSplitMode=${split_mode}
    ...                                                      initialDLTrafficRouting=${initial_dl}
    ...                                                      dlFlowControlAlgo=3gppFlowControl
    ...                                                      actPrioritizeX2AfterInactivity=false
    ...                                                      actDl256Qam=${actDl256Qam}
    ...                             ELSE
    ...                                 Create Dictionary    dlDataSplitMode=${split_mode}
    ...                                                      initialDLTrafficRouting=${initial_dl}
    ...                                                      dlFlowControlAlgo=3gppFlowControl
    ...                                                      actPrioritizeX2AfterInactivity=true
    ...                                                      actDl256Qam=${actDl256Qam}

    &{mode_fc_3}                    Create Dictionary       dlFlowControlAlgo=3gppFlowControl

    # For the NRDRB-x like bearers (for NSA and 5GC000776)
    ${new_bearer_definition_config}    Add New Bearer Definition Configuration      split_mode=${split_mode}
    ...                                                                             fc_mode=3gppFlowControl
    ...                                                                             initial_dl=${initial_dl}

    # Disable inactivity detection when no traffic to avoid unexpected UE release.
    &{p_inact_det}    Evaluate    {'dist_name': 'MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}','parameter': 'actInactDetNSAUe','value':'false'}
    Append To List    ${new_bearer_definition_config}               ${p_inact_det}

    [Return]                        @{new_bearer_definition_config}


Set Flow Control Configuration
    [Documentation]                 Set FC configuration for both WTS and gNB
    ...                             Default values are proposed, but can be overriden
    [Arguments]                     ${FC_protocol}=3gpp
    ...                             ${split_mode}=dlOverF1UX2U
    ...                             ${initial_dl}=initDLoverX2U

    # WTS updates:
    Modify Field in WtsEmu Cfg File     field=control_flow_period    value=3gpp1

    ${param_list_scf}     Build Set Flow Control Configuration List    split_mode=${split_mode}
    ...                                                                initial_dl=${initial_dl}

    Run Keyword If       '${auto_1248_j_debug_scf_update}' == 'True'
    ...                      Log to console                  SCF params: ${param_list_scf}

    Run Keyword If       '${auto_1248_j_debug_scf_update}' == 'True'
    ...                      Log to console                  Updating SCF file

    # Modify COAM parameters with rest API            modify_param=@{param_list_scf}
    OAM Set Params       ${param_list_scf}

# KW to parse counter list for each TC and compare with predefined value with an error percentage
Verify Counter Cumulative Values With Margin
    [Documentation]                 KW to parse counter list for each TC and
    ...                             compare with predefined value with an error percentage
    [Arguments]                     ${TC_name}
    ...                             ${Error_percentage}=5


   ${date}                          Get Current Date
   ${date_in_dir_name}              Convert Date         ${date}     result_format=%d%m%Y_%H%M
   ${log_path_pm}                   Set Variable         ${LOG_PATH}/PM_${date_in_dir_name}
   #Real/20200423_121416.5GC001248_J_Tests/Logs/20200423121428855369/PM_23042020_1254/
   # Retrieve BTS domain Id from OAM
   # Run Keyword And Ignore Error     Get TL Info
   # To enable counter KW debug mode (Verify Object Counter ...)
   # Set Debug Mode

    ${pm_latest}                    Collect PM files from BTS    ${log_path_pm}

    ${tc_kpi_dict}                  Get From Dictionary     ${dict_kpis_all_tc}     ${TC_name}
    ${tc_dict_keys}                 Get Dictionary Keys     ${tc_kpi_dict}

    Run Keyword If   '${auto_1248_j_debug_scf_update}' == 'True'    Log To Console    ${tc_kpi_dict}
    Run Keyword If   '${auto_1248_j_debug_scf_update}' == 'True'    Log To Console    Keys: ${tc_dict_keys}

    # For loop parsing counter defined inside ${tc_kpi_dict} and compare with a predefinied value
    FOR    ${counter}    IN    @{tc_dict_keys}
        ${domain}            Get From Dictionary     ${dict_counter_domains}     ${counter}
        ${min_max}           Get From Dictionary     ${tc_kpi_dict}     ${counter}
        ${valeur_min}        Get From List     ${min_max}        0
        ${valeur_max}        Get From List     ${min_max}        1
        ${valeur_min_to_string}                Convert To String    ${valeur_min}
        ${valeur_max_to_string}                Convert To String    ${valeur_max}
        &{counter_dict}      Create Dictionary
        ...                  counter=${counter}    obj=${domain}    min=${valeur_min_to_string}    max=${valeur_max_to_string}

        ${value}           Run Keyword If    '${domain}'=='NRBTS'
        ...                   Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${log_path_pm}     ${domain}         ${counter}      ${NRBTS_ID}
        ...                ELSE
        ...                   Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${log_path_pm}     ${domain}         ${counter}

        # Print debug about counter values and deviation compared to expected values
        ${average}            Evaluate        (${valeur_max} + ${valeur_min}) / 2
        ${kpi_deviation}      Run Keyword If            ${average}!=0
        ...                            Evaluate        (${value} - ${average})*100 / ${average}
        ...                      ELSE
        ...                            Evaluate        0
        Log To Console  Compteur: ${counter} Min: ${valeur_min} - Value : ${value} - Max: ${valeur_max} ---> Deviation is ${kpi_deviation} %

        ${range_status}   Run Keyword If    '${domain}'=='NRBTS'
        ...                   Verify Object Counter with ID Sum Of Values In A Range    ${log_path_pm}     ${NRBTS_ID}      &{counter_dict}
        ...               ELSE
        ...                   Verify Object Counter Sum Of Values In A Range    ${log_path_pm}    &{counter_dict}
        Should Be True   '${range_status}' == 'True'

    END

Verify Counter Cumulative Values With Margin for AiC
    [Documentation]                 KW to parse counter list for each TC and
    ...                             compare with predefined value with an error percentage
    ...                             For AllInCloud (AiC) - VRAN2.0
    [Arguments]                     ${TC_name}
    ...                             ${Error_percentage}=5

   ${date}                          Get Current Date
   ${date_in_dir_name}              Convert Date         ${date}     result_format=%d%m%Y_%H%M
   ${log_path_pm}                   Set Variable         ${LOG_PATH}/PM_${date_in_dir_name}
   #Real/20200423_121416.5GC001248_J_Tests/Logs/20200423121428855369/PM_23042020_1254/
   # Retrieve BTS domain Id from OAM
   # Run Keyword And Ignore Error     Get TL Info
   # To enable counter KW debug mode (Verify Object Counter ...)
   # Set Debug Mode

    ${tc_kpi_dict}                  Get From Dictionary     ${dict_kpis_all_tc}     ${TC_name}
    ${tc_dict_keys}                 Get Dictionary Keys     ${tc_kpi_dict}
    # ${tc_dict_keys}                 Get Dictionary Keys     ${tc_kpi_dict}   sort_keys=False

    Run Keyword If   '${auto_1248_j_debug_scf_update}' == 'True'    Log To Console    ${tc_kpi_dict}
    Run Keyword If   '${auto_1248_j_debug_scf_update}' == 'True'    Log To Console    Keys: ${tc_dict_keys}

    # For loop parsing counter defined inside ${tc_kpi_dict} and compare with a predefinied value
    FOR    ${counter}    IN    @{tc_dict_keys}
        ${domain}                   Get From Dictionary     ${dict_counter_domains_AiC}     ${counter}
        ${domainId}                 Get From Dictionary     ${dict_counter_domainIds_AiC}   ${counter}
        ${nodeType}                 Get From Dictionary     ${dict_counter_nodeTypes}   ${counter}
        ${min_max}                  Get From Dictionary     ${tc_kpi_dict}     ${counter}
        ${valeur_min}               Get From List     ${min_max}        0
        ${valeur_max}               Get From List     ${min_max}        1
        ${valeur_min_to_string}     Convert To String    ${valeur_min}
        ${valeur_max_to_string}     Convert To String    ${valeur_max}

        &{counter_dict}      Create Dictionary
        ...                  counter=${counter}    obj=${domain}    objId=${domainId}     min=${valeur_min_to_string}    max=${valeur_max_to_string}
        run Keyword if    '${domain}'=='NRBTS'     Set to Dictionary       ${counter_dict}       objId=${NRBTS_ID}
        ...     ELSE                               Set to Dictionary       ${counter_dict}       objId=${domainId}

        ${value}    run Keyword if    '${nodeType}'=='DU'   Counters.Retrieve Counter Sum of Values From Pm Files For Object and Id on vDU
        ...                                                                  &{counter_dict}
        ...                   ELSE                          Counters.Retrieve Counter Sum of Values From Pm Files For Object and Id on vCU
        ...                                                                  &{counter_dict}

        # Print debug about counter values and deviation compared to expected values
        ${average}            Evaluate        (${valeur_max} + ${valeur_min}) / 2
        ${kpi_deviation}      Run Keyword If            ${average}!=0
        ...                            Evaluate        (${value} - ${average})*100 / ${average}
        ...                      ELSE
        ...                            Evaluate        0
        Log To Console  Compteur: ${counter} Min: ${valeur_min} - Value : ${value} - Max: ${valeur_max} ---> Deviation is ${kpi_deviation} %

        ${range_status}    run Keyword if    '${nodeType}'=='DU'   Counters.Verify Object Counter with ID Sum Of Values In A Range on vDU
        ...                                                                  &{counter_dict}
        ...                   ELSE                                 Counters.Verify Object Counter with ID Sum Of Values In A Range on vCU
        ...                                                                  &{counter_dict}

        Should Be True   '${range_status}' == 'True'

    END

Verify Counter Cumulative Values With Margin for 1248_M
    [Documentation]         Dedicated KW for checkout 1248_M counter
    ...                     Now gNB seems to use 4TX instead of 2 TX previously
    ...                     Thus M55301C09001/M55301C09002 (PDSCH transmissions using 2TX transmission with rank x)
    ...                     are no more incremented.
    ...                     Now it's M55301C10001/M55301C10002 (PDSCH transmissions using 4TX transmission with rank x)
    ...                     The best solution is to check M55301C09001+M55301C10001 or M55301C09002+M55301C10002
    ...                     to cover both cases.

    [Arguments]                     ${TC_name}

    ${date}                          Get Current Date
    ${date_in_dir_name}              Convert Date         ${date}     result_format=%d%m%Y_%H%M
    ${log_path_pm}                   Set Variable         ${LOG_PATH}/PM_${date_in_dir_name}
    ${pm_latest}                     Collect PM files from BTS    ${log_path_pm}

    # Sum-up PDSCH with rank 1 transmission
    ${pdsch_transmissions_rank1}              Set Variable                    0
    FOR    ${counter}    IN    @{counter_list_1248_M_for_rank1}

        ${value}              Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${log_path_pm}     NRCELL         ${counter}

        ${pdsch_transmissions_rank1}     Evaluate        ${pdsch_transmissions_rank1} + ${value}
    END

    # Sum-up PDSCH with rank 2 transmission
    ${pdsch_transmissions_rank2}              Set Variable                    0
    FOR    ${counter}    IN    @{counter_list_1248_M_for_rank2}

        ${value}              Retrieve Counter Sum of Values From Pm Files For Object With Name
        ...                   ${log_path_pm}     NRCELL         ${counter}

        ${pdsch_transmissions_rank2}     Evaluate        ${pdsch_transmissions_rank2} + ${value}
    END


    ${tc_kpi_dict}                  Get From Dictionary     ${dict_kpis_all_tc}     ${TC_name}

    ${min_max}        Get From Dictionary     ${tc_kpi_dict}     PDSCH_RANK_1
    ${min_rk1}        Get From List     ${min_max}        0
    ${max_rk1}        Get From List     ${min_max}        1

    ${min_max}        Get From Dictionary     ${tc_kpi_dict}     PDSCH_RANK_2
    ${min_rk2}        Get From List     ${min_max}        0
    ${max_rk2}        Get From List     ${min_max}        1

    Log To Console  Min: ${min_rk1} - Num of PDSCH rank 1: ${pdsch_transmissions_rank1} - Max: ${max_rk1}
    Log To Console  Min: ${min_rk2} - Num of PDSCH rank 2: ${pdsch_transmissions_rank2} - Max: ${max_rk2}

    Should Be True      ${pdsch_transmissions_rank1}>=${min_rk1}
    Should Be True      ${pdsch_transmissions_rank1}<=${max_rk1}

    Should Be True      ${pdsch_transmissions_rank2}>=${min_rk2}
    Should Be True      ${pdsch_transmissions_rank2}<=${max_rk2}


Check Bearer CU
    [Documentation]      KW used to check CU bearer configuration inside PDML file
    [Arguments]                     ${pdmlFile}
    ...                             ${fc_mode}
    ...                             ${initial_dl}


   # Checks related to f1UFlowControlParams
   analyzer.check_exists_once      pdmlFile=${pdmlFile}
   ...                             packetName=itf_l2_hi_cu_user_BearerSetupReq
   ...                             path=itf_l2_hi_cu_user_FlowControlParams.dddsPeriod$
   ...                             value=5
   analyzer.check_list             pdmlFile=${pdmlFile}
   ...                             packetName=itf_l2_hi_cu_user_BearerSetupReq
   ...                             path=itf_l2_hi_cu_user_FlowControlParams.maxRLCQueueingDelay_item$
   ...                             value=20

   # Checks related to CU/X2 side (flowControlParams)
   analyzer.check_exists_once      pdmlFile=${pdmlFile}
   ...                             packetName=itf_l2_hi_cu_user_BearerSetupReq
   ...                             path=itf_l2_hi_cu_user_FlowControlParams.dddsPeriod$
   ...                             value=10
   analyzer.check_list             pdmlFile=${pdmlFile}
   ...                             packetName=itf_l2_hi_cu_user_BearerSetupReq
   ...                             path=itf_l2_hi_cu_user_SplitBearerParams.initialDLTrafficRouting$
   ...                             value=${initial_dl}

   # Common checks related to f1UFlowControlParams and CU/X2 side (flowControlParams)
   analyzer.check_exists_once      pdmlFile=${pdmlFile}
   ...                             packetName=itf_l2_hi_cu_user_BearerSetupReq
   ...                             path=itf_l2_hi_cu_user_FlowControlParams.minThFlowCtrl$
   ...                             value=1
   analyzer.check_exists_once      pdmlFile=${pdmlFile}
   ...                             packetName=itf_l2_hi_cu_user_BearerSetupReq
   ...                             path=itf_l2_hi_cu_user_FlowControlParams.maxTransferDelay$
   ...                             value=20


Check Bearer DU
    [Documentation]      KW used to check DU bearer configuration inside PDML file
    [Arguments]                     ${pdmlFile}
    ...                             ${fc_mode}

   analyzer.check_list             pdmlFile=${pdmlFile}
   ...                             packetName=itf_l2_hi_du_user_BearerSetupReq
   ...                             path=itf_l2_hi_du_user_SFlowControlParams.dddsPeriod$
   ...                             value=5
   analyzer.check_list             pdmlFile=${pdmlFile}
   ...                             packetName=itf_l2_hi_du_user_BearerSetupReq
   ...                             path=itf_l2_hi_du_user_SFlowControlParams.minThFlowCtrl$
   ...                             value=1
