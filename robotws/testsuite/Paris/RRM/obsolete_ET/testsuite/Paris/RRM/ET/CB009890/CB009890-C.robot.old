Update_SCF_woBSR
    ${Current_btsName}=        set Variable   ${Host Name}
    ${PartOfBtsName}=          set Variable   16DL-8UL BeamSet_6 3Cells woBSR
    ${FullbtsName}=            set Variable   CB009890 - ${Current_btsName} - ${PartOfBtsName}
    ${test_scf_file}           COAM Get SCF      file=SCF.xml    w_setup_admin=False   alias=coam_gnb
    ${current_scf_fullname}    set Variable      ${test_scf_file}
    # ${current_scf_fullname}    set Variable     /home/ute/csamson/TRACES/Configuration_scf_MRBTS-1_7_15_UTE5GTL308_20230216-1847.xml
    ${CsvFilename}      Remove String      ${current_scf_fullname}     .xml
    ${scf_update_eirp}    SCF Enable CB009890-C without BSR    input_scf=${current_scf_fullname}
    ...                                                        output_scf=${CsvFilename}_CB009890_C_modified.xml
    ...                                                        btsName=${FullbtsName[0:78]}
    dated log   To commit ${CsvFilename}_modified_for_CB009890_C.xml

Update_SCF_wBSR
    ${Current_btsName}=        set Variable   ${Host Name}
    ${PartOfBtsName}=          set Variable   16DL-8UL BeamSet_6 3Cells wBSR
    ${FullbtsName}=            set Variable   CB009890 - ${Current_btsName} - ${PartOfBtsName}
    ${test_scf_file}           COAM Get SCF      file=SCF.xml    w_setup_admin=False   alias=coam_gnb
