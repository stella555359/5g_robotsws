CB011017 Check CellSetupRequest
    [Documentation]
    ...   Arguments:
    ...     - pcap_CPRT: CPRT trace
    ...     - FieldShowName: dictionary of fields/values to check in the message
    ...                         key: field to find in the message
    ...                         value: string (regular expression) to check as "showname" in PDML
    [Arguments]    ${CAPTURE_CPRT}    ${FieldShowName}
    Dated Log          Check itf_l2_ps_cell_cellsetupreq parameters

    ${pdml}            analyzer.pcap_to_pdml       ${CAPTURE_CPRT.path}

    ${msg_field}       Set Variable    @{FieldShowName.keys()}

    FOR   ${Field}   IN   @{msg_field}
        ${Value}          set variable    ${FieldShowName["${Field}"]}

        Dated Log         --- Check ${Field} = ${Value}
        analyzer.check_exists_once     pdmlFile=${pdml}
        ...                            packetName=itf_l2_ps_cell_CellSetupReq_t
        ...                            path=${Field}
        ...                            value=${Value}
        ...                            kind=showname
        ...                            test=MATCH
    END
    [return]    ${pdml}


CB011017 Check StartConformanceTestReq
    [Documentation]
    ...   Arguments:
    ...     - pcap_CPRT: CPRT trace
    ...     - FieldShowName: dictionary of fields/values to check in the message
    ...                         key: field to find in the message
    ...                         value: string (reru_modegular expression) to check as "showname" in PDML
    ...       Tips & Tricks:
    ...          To check different values of one field, the associated keys can be defined
    ...          several time in the dictionary with KEYxx at the begining.
    ...          As exemple, to check in PDML both values 100 and 200 of patternId_item:
    ...                  patternId_item" showname="patternId_item_0 (Uint16): 100"
    ...                  patternId_item" showname="patternId_item_1 (Uint16): 200"
    ...          It has to be defined two times in the FieldShowName dictionary as:
    ...                  KEY01patternId_item=patternId_item_0.*\\b100
    ...                  KEY02patternId_item=patternId_item_1.*\\b200
    ...                     => .*: one or more any character, \\b: a space character
    [Arguments]    ${pcap_CPRT}    ${FieldShowName}
    Dated Log          Check itf_l2_ps_tm_cell_startconformancetestreq parameters

    ${pdml}            analyzer.pcap_to_pdml       ${pcap_CPRT.path}

    ${msg_field}       Set Variable    @{FieldShowName.keys()}

    FOR   ${Field}   IN   @{msg_field}
        ${FieldName}      Remove String Using Regexp    ${Field}    ^KEY\\d\\d
        ${Value}          set variable    ${FieldShowName["${Field}"]}

        Dated Log         --- Check ${FieldName} = ${Value}
        analyzer.check_exists_once     pdmlFile=${pdml}
        ...                            packetName=itf_l2_ps_tm_cell_startconformancetestreq_t
        ...                            path=${FieldName}
        ...                            value=${Value}
        ...                            kind=showname
        ...                            test=MATCH
    END
    [return]    ${pdml}


CB011017 Check StartConformanceTestResp status
    [Arguments]    ${pcap_CPRT}
    Dated Log          Check itf_l2_ps_tm_cell_startconformancetestresp status

    ${pdml}            analyzer.pcap_to_pdml       ${pcap_CPRT.path}

    analyzer.check_exists_once     pdmlFile=${pdml}
    ...                            packetName=itf_l2_ps_tm_cell_startconformancetestresp_t
    ...                            path=status
    ...                            value=EStatus5G_Ok
    ...                            kind=showname
    ...                            test=MATCH
    [return]    ${pdml}




CB011017 Check PuschReceiveReq
    [Arguments]    ${BIP_L1L2}    ${FieldShowName}
    [Documentation]
    ...   Arguments:
    ...     - BIP_L1L2: L1/L2 trace
    ...     - FieldShowName: dictionary of fields/values to check in the message
    ...                         key: field to find in the message
    ...                         value: string (rru_modeegular expression) to check as "showname" in PDML
    ...       Tips & Tricks:
    ...          To check different values of one field, the associated keys can be defined
    ...          several time in the dictionary with KEYxx at the begining.
    ...          As exemple, to check in PDML both values 100 and 200 of patternId_item:
    ...                  patternId_item" showname="patternId_item_0 (Uint16): 100"
    ...                  patternId_item" showname="patternId_item_1 (Uint16): 200"
    ...          It has to be defined two times in the FieldShowName dictionary as:
    ...                  KEY01patternId_item=patternId_item_0.*\\b100
    ...                  KEY02patternId_item=patternId_item_1.*\\b200
    ...                     => .*: one or more any character, \\b: a space character
    Dated Log          Check uldata_puschreceivereq parameters

    ${pcapFiltered}    analyzer.filter_pcap
    ...                pcapInFile=${BIP_L1L2.path}
    ...                filterName=puschReceiveReq
    ...                filterExp=uldata_puschreceivereqCB010793

    ${msg_field}       Set Variable    @{FieldShowName.keys()}

    FOR   ${Field}   IN   @{msg_field}
        ${Value}          set variable    ${FieldShowName["${Field}"]}
        ${FieldName}      Remove String Using Regexp    ${Field}    ^KEY\\d\\d

        Dated Log         --- Check ${FieldName} = ${Value}
        analyzer.check_exists_once     pdmlFile=${pdml}
        ...                            packetName=UlData_PuschReceiveReq_t
        ...                            path=${FieldName}
        ...                            value=${Value}
        ...                            kind=showname
        ...                            test=MATCH
    END
    [return]    ${pdml}



CB011017 setup Mirroring for BIP capture
    [Arguments]    ${prefix}

    ${CAPTURE_L1L2}           Capture L1L2 Set Upon Config
    Set Suite Variable        ${CAPTURE_L1L2}
    ${CAPTURE_CPRT}           Capture CPRT Set Upon Config
    Set Suite Variable        ${CAPTURE_CPRT}

    ${CAPTURE_CPRT.filter}    Get Filter For SCTP
    ${CAPTURE_CPRT.prefix}    Set Variable    CPRT_${prefix}
    ${CAPTURE_L1L2.prefix}    Set Variable    L1L2_${prefix}


CB011017 Start Capture CPRT
    Capture Init              ${CAPTURE_CPRT}
    Capture Start             ${CAPTURE_CPRT}


CB011017 Start Capture L1L2
    Capture Init              ${CAPTURE_L1L2}
    Capture Start             ${CAPTURE_L1L2}



Suite Teardown CB011017-Common
    [Documentation]
    ...     Conditions:     it needs no conditions
    ...     Actions:        it restores the files when the test is finished
    ...     Checks:         it needs no checks
    ...     Verdict:        suite teardown is passed

    Restore Files
    ${scf_suite_teardown_restore}=              Get Variable Value    ${scf_suite_setup_backup}    None
    OAM Perform Full Commissioning              scf_file=${scf_suite_teardown_restore}
    OAM wait available
    ${std_output}=                              Run    rm -f ${scf_suite_setup_backup}
    Dated Log                                   ===> restore file is ${scf_suite_teardown_restore}
