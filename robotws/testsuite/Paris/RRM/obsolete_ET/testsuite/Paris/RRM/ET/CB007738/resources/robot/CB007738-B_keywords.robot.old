Set SCF CB007738 TC_10
    ${actRateMatchedCsiIm_objLocation}=   Catenate      ${NRCELL_DIST_NAME}
    Set Suite Variable                    ${actRateMatchedCsiIm_objLocation}
    Dated log New Line                       NRCELL_DIST_NAME=${actRateMatchedCsiIm_objLocation}
    Copy File            ${test_scf_file}     ${test_scf_file}._7738B_TC10
    SCF StartSession     scf_file=${test_scf_file}
    SCF Set element      dist_name=${actRateMatchedCsiIm_objLocation}
    ...                  element_name=actCDrx
    ...                  element_value=true
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELLGRP-0
    ...                  element_name=ssBurstSetPeriod
    ...                  element_value=20
    SCF Set element      dist_name=${NRCELL_DIST_NAME}/NRDSSLTE-1
    ...                  element_name=actRateMatchedCsiIm
    ...                  element_value=true
    # SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    # ...                  element_name=actGeneralConnectivityGold
    # ...                  element_value=true

    ${list_name_drx}         Set Variable    drxProfile1
    SCF Set element in List    dist_name=${actRateMatchedCsiIm_objLocation}
    ...                        list_name=csirsForTracking
    ...                        element_name=csirsTrackingPeriod
    ...                        element_value=80ms
    SCF Set element in List    dist_name=${actRateMatchedCsiIm_objLocation}
    ...                        list_name=${list_name_drx}
    ...                        element_name=drxInactivityTimer
    ...                        element_value=40ms  #40ms
    SCF Set element in List    dist_name=${actRateMatchedCsiIm_objLocation}
    ...                        list_name=${list_name_drx}
    ...                        element_name=drxLongCycle
    ...                        element_value=160ms   #160ms
    SCF Set element in List    dist_name=${actRateMatchedCsiIm_objLocation}
    ...                        list_name=${list_name_drx}
    ...                        element_name=drxOnDurationTimer
    ...                        element_value=20ms  #20ms
    SCF Set element in List    dist_name=${actRateMatchedCsiIm_objLocation}
    ...                        list_name=${list_name_drx}
    ...                        element_name=drxRetransTimerDl
    ...                        element_value=0slot
    SCF Set element in List    dist_name=${actRateMatchedCsiIm_objLocation}
    ...                        list_name=${list_name_drx}
    ...                        element_name=drxRetransTimerUl
    ...                        element_value=0slot
    SCF StopSession      scf_file=${test_scf_file}
    Dated Log    ----> Modifications completed.\n
    Oam.OAM Perform Full Commissioning          scf_file=${test_scf_file}
    WA Airscale Wait For Ready                  ${GNB_DU}

