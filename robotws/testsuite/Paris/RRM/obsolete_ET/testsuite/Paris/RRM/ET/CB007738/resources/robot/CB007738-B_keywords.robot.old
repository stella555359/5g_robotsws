Set 7738 Specifc Scf Param actRateMatchedCsiIm
    [Arguments]          ${testParam}     ${trunk}=False
    [documentation]
    ...                actRateMatchedCsiIm seting to True
    ...                info from Denis Taupin 2021 Sept 08th

    BuiltIn.log       bandwidth is ${testParam.seq.bandwidth}
    BuiltIn.log       trunk=${trunk}
    ${actRateMatchedCsiIm_objLocation}=   Catenate      ${NRCELL_DIST_NAME}/NRDSSLTE-1
    Set Suite Variable                    ${actRateMatchedCsiIm_objLocation}
    Dated log New Line                       NRCELL_DIST_NAME=${actRateMatchedCsiIm_objLocation}
    &{modify_param}    Create Dictionary
    ...    parameter=actRateMatchedCsiIm
    ...    dist_name=${actRateMatchedCsiIm_objLocation}
    ...    value=true
    @{modify_param_to_apply}    Create List    ${modify_param}
    BuiltIn.Log      \nParameters to modify:\n @{modify_param_to_apply}   console=yes
    OAM Set Params      modify_param=@{modify_param_to_apply}

