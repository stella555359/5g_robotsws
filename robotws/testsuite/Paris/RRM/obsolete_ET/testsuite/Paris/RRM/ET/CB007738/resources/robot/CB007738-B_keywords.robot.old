*** Keywords ***

TC 7738 NSA CellSetup
    [Documentation]                Generic test for 1745: test purpose is to setup X2, Xp and DSS CellSetup Phase3
    [Arguments]                    ${param}     ${alias}=default
    Init Sequence                  ${param}
    common_Dss_Keywords.Restart     OwnTLReset=${False}     GNBCallback=common_Dss_Keywords.Set Reset Loop Counter
    Step                           Start capture Backhaul XP for DSS         argument=BH.XP.CellSetup       depends=common_Dss_Keywords.Restart
    Step                           CB007738_keywords.Start WTS For NSA       argument=${alias}
    Step                           Wait Xp link Up                 argument=${alias}        depends=CB007738_keywords.Start WTS For NSA
    Step                           X2Ap link Setup               argument=${alias}          depends=CB007738_keywords.Start WTS For NSA
    # Step                           common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3    argument=${alias}     depends=Wait Xp link Up
    Step                           common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3    alias=${alias}  wtsObj=${wtsObj}   depends=Wait Xp link Up
    ${pdmlFile}                    Stop capture Backhaul XP for DSS
    Run Keyword if       '${CELLSETUP_SHOULD_BE_CHECK}' == '1'
    ...                    Step        Check DSS CellSetup Phase3      argument=${pdmlFile}   depends=common_Dss_CellSetup.DSS_CRM_Cell_Setup_Phase3
    Critical Step                  common_Dss_CellSetup.Verify AP Classical Cell Setup
    [Teardown]               GenericTest.Display diagnosis

TC 7738 NSA Call
    [Documentation]                Generic test for 1745: test purpose is to setup X2, Xp and DSS CellSetup Phase3
    [Arguments]                    ${param}     ${alias}=default
    BuiltIn.log                    alias is ${alias}
    Init Sequence                  ${param}
    Critical Step            common_Dss_SA_NSA.Test SgNB Addition PRACH
    [Teardown]               GenericTest.Display diagnosis

TC 7738 SA CellSetup
    [Documentation]                Generic test for 7738: test purpose is to setup X2, Xp and DSS CellSetup Phase3
    ...                            Check nGBR in Load Indication Msgs
    [Arguments]                    ${param}     ${alias}=default
    Init Sequence                  ${param}
    common_Dss_Keywords.Restart     OwnTLReset=${False}      GNBCallback=common_Dss_Keywords.Set Reset Loop Counter
    Start capture Backhaul XP for DSS     prefix=BH.XP.CellSetup
    Start WTS                         egate_alias=${alias}
    Wait Xp link Up                     alias=${alias}
    X2Ap link Setup                   alias=${alias}
    Run Keyword If     '${alias}'=='egate_TCB9'
    ...     7738_DSS_CRM_Cell_Setup_Phase3    alias=${alias}
    ...     max_lte_nr_dss_ratio=100    testmode_decode_PDSCH=true
    ...     ELSE
    ...     7738_DSS_CRM_Cell_Setup_Phase3    alias=${alias}     max_lte_nr_dss_ratio=100
    ${pdmlFile}                    Stop capture Backhaul XP for DSS
    Run Keyword if       '${CELLSETUP_SHOULD_BE_CHECK}' == '1'
    ...      common_Dss_CellSetup.Check DSS CellSetup Phase3     ${pdmlFile}
    common_Dss_CellSetup.Verify AP Classical Cell Setup


