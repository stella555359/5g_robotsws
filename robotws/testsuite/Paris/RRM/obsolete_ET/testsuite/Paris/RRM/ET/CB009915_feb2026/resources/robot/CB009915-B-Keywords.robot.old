    #vbo#Sherpa end#...                                                             alloc_stream_prb=${num_stream_two_cells_dl_string}
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_1}
    #vbo#Sherpa end#...                                                             check_operator===
