    #vbo#Sherpa end#
    Sleep Until PM Availability    # Wait end of PM period containing cell setup

    # Start SYSLOG capture during traffic establishment
    ${syslog}=    Run Keyword If    not ${CALL_SETUP_ONLY}    SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_traffic

    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY}
        ...    Step                             ${param.dir} Traffic Not Stopped    param=${param}    current_ue_setting=${current_elem}
        ...                                     depends=CallSetup.Launch PDU Session
    END

    # WA by moving Captures Init and Start to avoid exceeded traffic - Capture L1L2 during traffic for verification
    Run Keyword If    not ${CALL_SETUP_ONLY}    Run Keywords    Captures Init
    ...    AND                                  Captures Start    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${is_capture.is_capture_cprt}
    ...                                                             action_l1l2=${is_capture.is_capture_l1l2}
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic for L1L2 trace
    ...    AND    Step                          Captures Stop    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${is_capture.is_capture_cprt}
    ...                                                             action_l1l2=${is_capture.is_capture_l1l2}
    ${list_l1l2_messages_filters}=              CB009915 Create Filter Message List
    Run Keyword If    not ${CALL_SETUP_ONLY} and ${is_capture.is_capture_l1l2}    Run Keywords    Step    CB009915 Analyze pcap and pdml
    ...                                                             pcap_file=${capture_l1l2.path}
