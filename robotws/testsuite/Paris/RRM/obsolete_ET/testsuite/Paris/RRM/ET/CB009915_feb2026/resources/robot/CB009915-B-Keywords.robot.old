*** Variables ***
&{dlData_csiRsSendReq_check_9915_B1}            subcellid=0    sfn=0    slot=0    rnti=0    startPrb=0    numOfPrb=0    trsInfo=0

# coresetDomainFreq definition for nrcell 1:
# 9223363240761753600 => 7FFF F800 0000 0000 => 0111 1111 1111 1111 1111 1000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000
# 1st bit is 0 then PRBs from 0 to 5 (6 PRBs) are not used <=> the blanking low edge should be > 0 and <=6.
# 20 bits are set to 1 (20* 6 PRBs) then 120 PRBs are used for coreset and, 120 is the size defined for the coresetDedicated of this cell
${coresetFreqDomain_9915_B1_2_C1}               9223363240761753600
${coresetFreqDomain_9915_B2_6_C1}               9223363240761753600    #vbo#WA HIGH#18446726481523507200
# 18446726481523507200 => FFFF F000 0000 0000 => 1111 1111 1111 1111 1111 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000
${coresetFreqDomain_9915_B1_2_C2}               18446726481523507200
${coresetFreqDomain_9915_B2_4_C1}               18446726481523507200
# 9223231299366420480 => 7FFF 8000 0000 0000 => 0111 1111 1111 1111 1000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000
${coresetFreqDomain_9915_B2_5_C1}               9223231299366420480    # for blanking low edge 5 nonInterleaved size= 96
${coresetFreqDomain_9915_B2_6_PS_C1}            9223231299366420480    # for power saving 40MHz#vbo#WA HIGH#
#vbo#WA HIGH#${coresetFreqDomain_9915_B2_6_PS_C1}    18446726481523507200
# 2305280059260272640 => 1FFE 0000 0000 0000 => 0001 1111 1111 1110 1000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000
${coresetFreqDomain_9915_B2_5_C2}               2305280059260272640    # for blanking low edge 14 nonInterleaved size= 72
${coresetFreqDomain_9915_B2_6_PS_C2}            2305280059260272640    # for power saving 40MHz#vbo#WA HIGH#
#vbo#WA HIGH#${coresetFreqDomain_9915_B2_6_PS_C2}    18446726481523507200
# 2305840810190438400 => 1FFF FE00 0000 0000 => 0001 1111 1111 1111 1111 1110 0000 0000 0000 0000 0000 0000 0000 0000 0000
${coresetFreqDomain_9915_B1_2_C3}               2305840810190438400
${coresetFreqDomain_9915_B2_6_C2}               2305840810190438400    #vbo#WA HIGH#18446726481523507200
# 70093866270720 => 3FC0 0000 0000 => 0011 1111 1100 0000 0000 0000 0000 0000 0000 0000 0000 0000
${coresetFreqDomain_9915_B1_2_0xFFFF}           70093866270720
# 143552238122434560 => 1FE0 0000 0000 => 0001 1111 1110 0000 0000 0000 0000 0000 0000 0000 0000 0000
${coresetFreqDomain_9915_B2_4_0xFFFF}           143552238122434560
${coresetFreqDomain_9915_B2_5_0xFFFF}           143552238122434560
${coresetFreqDomain_9915_B2_6_0xFFFF}           143552238122434560

&{dlData_pdcchSendReq_coresetFreqDomain_check_9915_B1}    subcellid=0    sfn=0    slot=0    rnti=0    startCce=0    coresetFreqDomain=0

&{dlData_pdschSendReq_check_9915_B1}            subcellid=0    sfn=0    slot=0    rnti=0    startPrb=0    numOfPrb=0    rbgSize=0    rbgSizeFirst=0
...                                             mcs=0    numOfLayers=0

&{ulData_prachReceiveReq_check_9915_B1}         subcellid=0    sfn=0    slot=0    rnti=0    prachPrbOffset=0

&{ulData_pucchReceiveReq_check_9915_B1}         subcellid=0    sfn=0    slot=0    rnti=0    pucchFormat=0    numOfLayers=0    startPrb=0
...                                             numOfPrb=0

&{ulData_puschReceiveReq_check_9915_B1}         subcellid=0    sfn=0    slot=0    rnti=0    startPrb=0    numOfPrb=0    mcs=0    numOfLayers=0
...                                             pairedUe=0

&{ulData_srsReceiveReq_check_9915_B1}           subcellid=0    sfn=0    slot=0    rnti=0    startPrb=0

*** Keywords ***
# --------------------------------------------------------------------------------------------------------------------------------------------------
Start Low Traffic For Ues
    [Documentation]
    ...     Conditions:     it is based on the arguments ${param} ${list_ue} ${current_trf_id} ${unit} ${bwp_transition}
    ...     Actions:        it manages the traffic low on the UE (unit is kbps by default)
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        traffic are passed
    [Arguments]             ${param}
    ...                     ${list_ue}
    ...                     ${current_trf_id}=1
    ...                     ${unit}=kbps
    ...                     ${bwp_transition}=from bwpId 1 to 2

    FOR    ${current_elem}    IN    @{list_ue}
        Dated Log New Line    ===> traffic is requested for ue id=${current_elem.ue} dl=${current_elem.throughput}${unit}
        Run Keyword If    ${current_elem.throughput} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY}
        ...                                     ${param.dir} Traffic Low Not Stopped    param=${param}    current_ue_setting=${current_elem}
        ...                                                         throughput_low=${current_elem.throughput}
        ...                                                         throughput_ul_low=${current_elem.throughput_ul}
        ...                                                         unit=${unit}
        ...                                                         bwp_transition=${bwp_transition}
    END


Stop Low Traffic For Ues
    [Documentation]
    ...     Conditions:     it is based on the arguments ${param} ${list_ue}
    ...     Actions:        it stop the traffic on the UE
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        traffic are stopped
    [Arguments]             ${param}
    ...                     ${list_ue}

    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY}    Run Keywords
        ...    wtsemu.trf_data_start    ue=${current_elem.ue}    pdu=${current_elem.pdu}    qfi=${current_elem.qfi}    dir=dl
        ...    AND    Dated Log    ===> traffic stop is requested for ue id=${current_elem.ue}
    END


CB009915_B2 Post Processing and Analysis within L1L2
    [Documentation]
    ...     Conditions:     it is based on the arguments ${capture_input} and +
    ...     Actions:        it manages the post-processing and analysis withing L1L2 traces
    ...     Checks:         it checks L1L2 values
    ...     Verdict:        all checks are passed
    [Arguments]             ${capture_input}
    ...                     ${config_blanking}
    ...                     ${is_capture}=${True}
    ...                     ${subcellid_C1}=0
    ...                     ${subcellid_C2}=1
    ...                     ${coresetFreqDomain_C1}=${coresetFreqDomain_9915_B2_5_C1}
    ...                     ${coresetFreqDomain_C2}=${coresetFreqDomain_9915_B2_5_C2}
    ...                     ${coresetFreqDomain_0xFFFF}=${coresetFreqDomain_9915_B2_5_0xFFFF}
    ...                     ${total_prb}=${NUM_MAX_PRB_DEFAULT}
    ...                     ${rbgsize}=16
    ...                     ${is_large_bwp}=${False}
    ...                     ${total_prb_bwp2}=${NUM_MAX_PRB_BWP_40MHZ}
    ...                     ${prb_reserved_C1}=36    # NRCELL.pdcchAutoConfig.pucchSize <=> numOfNrPucchPrbs
    ...                     ${prb_reserved_C2}=32
    ...                     ${is_nb_prb_max_triggered}=${False}

    Dated Log                                   ===> capture input is ${capture_input}
    ${list_l1l2_messages_filters}=              CB009915 Create Filter Message List
    Run Keyword If    ${is_capture}    Run Keywords    CB009915 Analyze pcap and pdml    pcap_file=${capture_input}
    ...                                                             list_message_filter=${list_l1l2_messages_filters}
    # dlData pdcchSendReq
    ...    AND                                  Check dlData pdcchSendReq coresetFreqDomain
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdcchsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdcchSendReq_coresetFreqDomain_check_9915_B1}
    ...                                                             subcellid=${subcellid_C1}
    ...                                                             packet_end=128    #-1
    ...                                                             coresetFreqDomain= ${coresetFreqDomain_C1}
    ...                                                             coresetFreqDomain_0xFFFF=${coresetFreqDomain_0xFFFF}
    ...    AND                                  Check dlData pdcchSendReq coresetFreqDomain
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdcchsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdcchSendReq_coresetFreqDomain_check_9915_B1}
    ...                                                             subcellid=${subcellid_C2}
    ...                                                             packet_end=128    #-1
    ...                                                             coresetFreqDomain= ${coresetFreqDomain_C2}
    ...                                                             coresetFreqDomain_0xFFFF=${coresetFreqDomain_0xFFFF}
    # dlData pdschSendReq
    ...    AND                                  Check dlData pdschSendReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdschSendReq_check_9915_B1}
    ...                                                             subcellid=${subcellid_C1}
    ...                                                             packet_end=512    #-1
    ...                                                             nb_prb_blanking_low=${config_blanking.nbBlankedPRBsLowEdge}[0]
    ...                                                             nb_prb_blanking_high=${config_blanking.nbBlankedPRBsHighEdge}[0]
    ...                                                             total_prb=${total_prb}
    ...                                                             rbgsize=${rbgsize}
    ...                                                             is_large_bwp=${is_large_bwp}
    ...                                                             total_prb_bwp2=${total_prb_bwp2}
    ...    AND                                  Check dlData pdschSendReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdschSendReq_check_9915_B1}
