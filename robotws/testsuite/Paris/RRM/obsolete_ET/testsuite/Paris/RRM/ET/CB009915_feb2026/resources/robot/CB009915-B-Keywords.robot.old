CB009915_B1_3_IWK_extended_SA
    [Documentation]
    ...     Conditions:     it is based on the arguments ${config_blanking} ${dict_ues} ${is_capture} ${param} ${test_name}
    ...     Actions:        it performs the call setup for multi-ues with traffic on different cells
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues with traffic and PRB blanking are passed
    [Arguments]             ${config_blanking}
    ...                     ${dict_ues}
    ...                     ${is_capture}
    ...                     ${param}
    ...                     ${test_name}

    Init Sequence                               ${param}
    Dated Log New Line                          ===> test name is ${test_name}
    Run Keyword If    ${SUITE_DEBUG_MODE}       Set Debug Mode
    Step                                        Set RAD Parameters for CB009915
    Step                                        Set RAD Parameters on Airphone
    Run Keyword If    ${param.act_blanking} == ${True}    Dated Log New Line    ===> blanking variable is enabled
    ...         ELSE                            Dated Log New Line    ===> BLANKING VARIABLE is disabled

    Critical Step                               Restart TL

    # Configure new ue's dynamically
    ${initial_nb_ue}=                           get length    ${dict_ues}
    Run Keyword If    ${initial_nb_ue} < ${param.total_nb_ue}    Configure New Ues    ${dict_ues}
    ...                                                             ${initial_nb_ue}
    ...                                                             ${param.total_nb_ue}
    ...                                                             ${dict_settings_ue_default}
    # Configure the current setting for all the ue's
    ${param.total_nb_ue}=                       get length    ${dict_ues}
    Dated Log New Line                          ===> configure the setting for all the ${param.total_nb_ue} ue's
    @{list_ue}=                                 Create List
    FOR    ${current_id}    IN RANGE    0    ${param.total_nb_ue}
        ${current_ue}=                          Evaluate            ${current_id} + 1
        ${current_ue_setting}=                  Copy Dictionary     ${BASIC_UE_SA}
        ${current_ue_id}=                       Evaluate            ${current_ue} + 0    #id for a sa ue starts at 1 into basic_setup.cfg#
        Set To Dictionary                       ${current_ue_setting}    ue    ${current_ue_id}
        Set To Dictionary                       ${current_ue_setting}    trf_id    1
        Set To Dictionary                       ${current_ue_setting}    pdu    1
        Set To Dictionary                       ${current_ue_setting}    target_gnb    ${param.target_gnb}

        # Dispatching the ue on the requested original cell for the call establishment
        Set To Dictionary                       ${current_ue_setting}    target_cells    ${dict_ues[${current_id}].original_cell}
        # Set the correct requested throughput per ue
        Set To Dictionary                       ${current_ue_setting}    throughput    ${dict_ues[${current_id}].throughput}
        Set To Dictionary                       ${current_ue_setting}    throughput_gbr    ${dict_ues[${current_id}].throughput_gbr}
        Set To Dictionary                       ${current_ue_setting}    throughput_ul    ${dict_ues[${current_id}].throughput_ul}
        Append To List                          ${list_ue}    ${current_ue_setting}
    END
    Dated Log New Line                          ===> ue's list is ${list_ue}
    Check Multi Ues Setting In List             list_multi_ue=${list_ue}
    Traced Sleep                                duration=15s    msg=Wtsemu system start-up to give radio modules time to start up

    # Start SYSLOG capture during call setup
    ${syslog}=                                  SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_call_setup

    # Capture TTI traces during call setup
    ##Start TTI Logs

    # Setup wtsemu SA for all the ue's
    Critical Step                               CallSetup.Setup Wtsemu SA    nbUe=${param.total_nb_ue}
    ...                                                             nbSaUe=${param.total_nb_ue}
    ...                                                             shouldUseLua=${False}
    ###...                                                          nb_cell=${param.total_nb_cell}
    ...                                                             list_of_UE_tobe_created=${list_ue}

    # Capture TTI traces during call setup
    Start TTI Logs

    # WA to avoid degradation on cells
    Traced Sleep                                duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    Step                                        CallSetup.WTS Set X2 Link

    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                                    CallSetup.UE Register    ue=${current_elem.ue}
        ...                                     depends=CallSetup.Setup Wtsemu SA
        Step                                    CallSetup.Launch PDU Session    ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         gw=${current_elem.ue}
        ...                                     depends=CallSetup.UE Register
    END

    Step                                        Stop and Get TTI Logs    trace_name=TTI.${test_name}_call_setup
    ${capture_tti_output}=                      Set Variable    ${LOG_PATH}/TTITraces/TTI.${test_name}_call_setup.json
    Step                                        SYSLOG Stop    syslog=${syslog}

    ${num_stream_cell_dl_float}=                Evaluate    (${NUM_MAX_STREAM_PRB_L1_SP} * 2) / 3    # two l1sp and because 3 cells
    ${num_stream_cell_dl_int}=                  Convert To Integer    ${num_stream_cell_dl_float}
    ${num_stream_cell_dl_string}=               Convert To String    ${num_stream_cell_dl_int}
    ${num_stream_two_cells_dl_int}=             Evaluate    ${num_stream_cell_dl_int} * 2
    ${num_stream_two_cells_dl_string}=          Convert To String    ${num_stream_two_cells_dl_int}
    Should Be True    ${num_stream_cell_dl_int} == 800    #vbo#double verification in case vendor file is not deployed correctly
    Should Be True    ${num_stream_two_cells_dl_int} == 1600
    ${num_stream_cell_ul_float}=                Evaluate    (${NUM_MAX_STREAM_PRB_L1_SP_UL_32} + ${NUM_MAX_STREAM_PRB_L1_SP_UL_64}) / 3
    ${num_stream_cell_ul_int}=                  Convert To Integer    ${num_stream_cell_ul_float}
    ${num_stream_cell_ul_string}=               Convert To String    ${num_stream_cell_ul_int}
    ${num_stream_two_cells_ul_int}=             Evaluate    ${num_stream_cell_ul_int} * 2
    ${num_stream_two_cells_ul_string}=          Convert To String    ${num_stream_two_cells_ul_int}
    Should Be True    ${num_stream_cell_ul_int} == 764
    Should Be True    ${num_stream_two_cells_ul_int} == 1528

    # Check l1SubPoolStreamPrb Consistency on dl during call setup
    Step                                        Check l1SubPoolStreamPrb Consistency within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             pool_max_num_stream_prb=2400
    ...                                                             mode_debug=${False}
    # Check l1SubPoolStreamPrbCapacity on dl during call setup both sub_pool_id
    Step                                        Check l1SubPoolStreamPrbCapacity within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             sub_pool_id=${ID_SUBPOOL_1}
    ...                                                             default_stream=${NUM_MAX_STREAM_PRB_L1_SP}
    ...                                                             current_stream=${num_stream_two_cells_dl_int}
    ...                                                             calculated_stream=${num_stream_two_cells_dl_int}
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}
    Step                                        Check l1SubPoolStreamPrbCapacity within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             sub_pool_id=${ID_SUBPOOL_2}
    ...                                                             default_stream=${NUM_MAX_STREAM_PRB_L1_SP}
    ...                                                             current_stream=${num_stream_cell_dl_int}
    ...                                                             calculated_stream=${num_stream_cell_dl_int}
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}

    Sleep Until PM Availability    # Wait end of PM period containing cell setup
    # Start SYSLOG capture during traffic establishment
    ${syslog}=    Run Keyword If    not ${CALL_SETUP_ONLY}    SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_traffic

    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY}
        ...    Critical Step                    ${param.dir} Traffic Not Stopped    param=${param}    current_ue_setting=${current_elem}
        ...                                     depends=CallSetup.Launch PDU Session
    END

    # PDU session modify reserved for the ue's configured with GBR traffic
    ${nb_ue_traffic_gbr}=                       Get Number Of Ue Configured With GBR Traffic    dict_ues=${list_ue}
    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput_gbr} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY}    Run Keywords
        ...    Step                             CallSetup.UE PDU Session Modify    ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         qfta=2
        ...                                                         by=amf
        ...                                     depends=CallSetup.Launch PDU Session
        ...    AND    Step                      CallSetup.UE PDU Session Modify    ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         qfta=3
        ...                                                         by=amf
        ...                                     depends=CallSetup.Launch PDU Session
    END

    # Start the DL+UL GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput_gbr} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY}    Run Keywords
        ...    Critical Step                    DL Traffic GBR SA Not Stopped    param=${param}    current_ue_setting=${current_elem}
        ...                                     depends=CallSetup.Launch PDU Session
        ...    AND    Critical Step             UL Traffic GBR SA Not Stopped    param=${param}    current_ue_setting=${current_elem}
        ...                                     depends=CallSetup.Launch PDU Session
    END

    # WA by moving Captures Init and Start to avoid exceeded traffic - Capture L1L2 during traffic for verification
    Run Keyword If    not ${CALL_SETUP_ONLY}    Run Keywords    Captures Init
    ...    AND                                  Captures Start    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${is_capture.is_capture_cprt}
    ...                                                             action_l1l2=${is_capture.is_capture_l1l2}
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic for L1L2 trace
    ...    AND    Step                          Captures Stop    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${is_capture.is_capture_cprt}
    ...                                                             action_l1l2=${is_capture.is_capture_l1l2}
    ${list_l1l2_messages_filters}=              CB009915 Create Filter Message List
    Run Keyword If    not ${CALL_SETUP_ONLY} and ${is_capture.is_capture_l1l2}    Run Keywords    Step    CB009915 Analyze pcap and pdml
    ...                                                             pcap_file=${capture_l1l2.path}
    ...                                                             list_message_filter=${list_l1l2_messages_filters}
    # dlData pdcchSendReq
    ...    AND    Step                          Check dlData pdcchSendReq coresetFreqDomain
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdcchsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdcchSendReq_coresetFreqDomain_check_9915_B1}
    ...                                                             subcellid=0
    ...                                                             packet_end=128    #-1
    ...                                                             coresetFreqDomain=${coresetFreqDomain_9915_B1_2_C1}
    #
    ...    AND    Step                          Check dlData pdcchSendReq coresetFreqDomain
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdcchsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdcchSendReq_coresetFreqDomain_check_9915_B1}
    ...                                                             subcellid=1
    ...                                                             packet_end=128    #-1
    ...                                                             coresetFreqDomain=${coresetFreqDomain_9915_B1_2_C2}
    #
    ...    AND    Step                          Check dlData pdcchSendReq coresetFreqDomain
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdcchsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdcchSendReq_coresetFreqDomain_check_9915_B1}
    ...                                                             subcellid=2
    ...                                                             packet_end=128    #-1
    ...                                                             coresetFreqDomain=${coresetFreqDomain_9915_B1_2_C3}
    # dlData pdschSendReq
    ...    AND    Step                          Check dlData pdschSendReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdschSendReq_check_9915_B1}
    ...                                                             subcellid=0
    ...                                                             packet_end=512    #-1
    ...                                                             nb_prb_blanking_low=5
    ...                                                             nb_prb_blanking_high=0
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    ...                                                             rbgsize=16
    #
    ...    AND    Step                          Check dlData pdschSendReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdschSendReq_check_9915_B1}
    ...                                                             subcellid=1
    ...                                                             packet_end=512    #-1
    ...                                                             nb_prb_blanking_low=0
    ...                                                             nb_prb_blanking_high=22
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    ...                                                             rbgsize=16
    #
    ...    AND    Step                          Check dlData pdschSendReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschsendreq}].pdml_file_result}
    ...                                                             field_values=${dlData_pdschSendReq_check_9915_B1}
    ...                                                             subcellid=2
    ...                                                             packet_end=512    #-1
    ...                                                             nb_prb_blanking_low=14
    ...                                                             nb_prb_blanking_high=13
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    ...                                                             rbgsize=16
    # ulData pucchReceiveReq
    ...    AND    Step                          Check ulData pucchReceiveReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_pucchreceivereq}].pdml_file_result}
    ...                                                             field_values=${ulData_pucchReceiveReq_check_9915_B1}
    ...                                                             subcellid=0
    ...                                                             packet_end=128    #-1
    ...                                                             nb_prb_blanking_low=5
    ...                                                             nb_prb_blanking_high=0
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    #
    ...    AND    Step                          Check ulData pucchReceiveReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_pucchreceivereq}].pdml_file_result}
    ...                                                             field_values=${ulData_pucchReceiveReq_check_9915_B1}
    ...                                                             subcellid=1
    ...                                                             packet_end=128    #-1
    ...                                                             nb_prb_blanking_low=0
    ...                                                             nb_prb_blanking_high=22
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    #
    ...    AND    Step                          Check ulData pucchReceiveReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_pucchreceivereq}].pdml_file_result}
    ...                                                             field_values=${ulData_pucchReceiveReq_check_9915_B1}
    ...                                                             subcellid=2
    ...                                                             packet_end=128    #-1
    ...                                                             nb_prb_blanking_low=14
    ...                                                             nb_prb_blanking_high=13
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    # ulData puschReceiveReq
    ...    AND    Step                          Check ulData puschReceiveReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_puschreceivereq}].pdml_file_result}
    ...                                                             field_values=${ulData_puschReceiveReq_check_9915_B1}
    ...                                                             subcellid=0
    ...                                                             packet_end=-1
    ...                                                             nb_prb_blanking_low=5
    ...                                                             nb_prb_blanking_high=0
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    ...                                                             prb_reserved=30
    ...                                                             is_nb_prb_max_triggered=${False}
    # PrbLimiter UL from SYSLOG informs about that the maximumNumberOfPrb is around 191 (after vendor customization NUM_MAX_LAYER_PRB_L1_SP_UL
    # 546+600= 1146 => per cell 1146/3=382 => as UL 382/2=191
    #
    ...    AND    Step                          Check ulData puschReceiveReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_puschreceivereq}].pdml_file_result}
    ...                                                             field_values=${ulData_puschReceiveReq_check_9915_B1}
    ...                                                             subcellid=1
    ...                                                             packet_end=-1
    ...                                                             nb_prb_blanking_low=0
    ...                                                             nb_prb_blanking_high=22
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    ...                                                             prb_reserved=30
    ...                                                             is_nb_prb_max_triggered=${False}
    #
    ...    AND    Step                          Check ulData puschReceiveReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_puschreceivereq}].pdml_file_result}
    ...                                                             field_values=${ulData_puschReceiveReq_check_9915_B1}
    ...                                                             subcellid=2
    ...                                                             packet_end=-1
    ...                                                             nb_prb_blanking_low=14
    ...                                                             nb_prb_blanking_high=13
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    ...                                                             prb_reserved=30
    ...                                                             is_nb_prb_max_triggered=${False}
    # ulData srsReceiveReq
    ...    AND    Step                          Check ulData srsReceiveReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_srsreceivereq}].pdml_file_result}
    ...                                                             field_values=${ulData_srsReceiveReq_check_9915_B1}
    ...                                                             subcellid=0
    ...                                                             packet_end=128    #-1
    ...                                                             nb_prb_blanking_low=5
    ...                                                             nb_prb_blanking_high=0
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    #
    ...    AND    Step                          Check ulData srsReceiveReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_srsreceivereq}].pdml_file_result}
    ...                                                             field_values=${ulData_srsReceiveReq_check_9915_B1}
    ...                                                             subcellid=1
    ...                                                             packet_end=128    #-1
    ...                                                             nb_prb_blanking_low=0
    ...                                                             nb_prb_blanking_high=22
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    #
    ...    AND    Step                          Check ulData srsReceiveReq
    ...                                         pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_srsreceivereq}].pdml_file_result}
    ...                                                             field_values=${ulData_srsReceiveReq_check_9915_B1}
    ...                                                             subcellid=2
    ...                                                             packet_end=128    #-1
    ...                                                             nb_prb_blanking_low=14
    ...                                                             nb_prb_blanking_high=13
    ...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}    #273#

    # Capture TTI traces during traffic for verification
    Run Keyword If    not ${CALL_SETUP_ONLY}    Run Keywords    Start TTI Logs
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic for TTI trace
    ...    AND    Step                          Stop and Get TTI Logs    trace_name=TTI.${test_name}_traffic
    ${capture_tti_output}=                      Set Variable    ${LOG_PATH}/TTITraces/TTI.${test_name}_traffic.json

    ${num_prb_cell}=    Run Keyword If    ${param.act_blanking} == ${True}    Evaluate
    ...    ${NUM_MAX_PRB_DEFAULT} - (${config_blanking.nbBlankedPRBsHighEdge}[0] + ${config_blanking.nbBlankedPRBsLowEdge}[0])
    ...                               ELSE    Set Variable    ${NUM_MAX_PRB_DEFAULT}
    ${num_prb_cell_1}=                          Convert To String    ${num_prb_cell}
    ${num_prb_cell}=    Run Keyword If    ${param.act_blanking} == ${True}    Evaluate
    ...    ${NUM_MAX_PRB_DEFAULT} - (${config_blanking.nbBlankedPRBsHighEdge}[1] + ${config_blanking.nbBlankedPRBsLowEdge}[1])
    ...                               ELSE    Set Variable    ${NUM_MAX_PRB_DEFAULT}
    ${num_prb_cell_2}=                          Convert To String    ${num_prb_cell}
    ${num_prb_cell}=    Run Keyword If    ${param.act_blanking} == ${True}    Evaluate
    ...    ${NUM_MAX_PRB_DEFAULT} - (${config_blanking.nbBlankedPRBsHighEdge}[2] + ${config_blanking.nbBlankedPRBsLowEdge}[2])
    ...                               ELSE    Set Variable    ${NUM_MAX_PRB_DEFAULT}
    ${num_prb_cell_3}=                          Convert To String    ${num_prb_cell}

    # Check l1SubPoolStreamPrb Consistency on dl during traffic
    Step                                        Check l1SubPoolStreamPrb Consistency within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             pool_max_num_stream_prb=2400
    ...                                                             mode_debug=${False}
    # Check l1SubPoolStreamPrbCapacity on dl during traffic both sub_pool_id
    Step                                        Check l1SubPoolStreamPrbCapacity within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             pool_max_num_stream_prb=2400
    ...                                                             sub_pool_id=${ID_SUBPOOL_1}
    ...                                                             check_operator=>
    ...                                                             default_stream=${NUM_MAX_STREAM_PRB_L1_SP}
    ...                                                             current_stream=${NUM_MAX_STREAM_PRB_L1_SP}
    ...                                                             calculated_stream=${NUM_MAX_STREAM_PRB_L1_SP}
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}
    Step                                        Check l1SubPoolStreamPrbCapacity within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             pool_max_num_stream_prb=2400
    ...                                                             sub_pool_id=${ID_SUBPOOL_2}
    ...                                                             check_operator=<
    ...                                                             default_stream=${NUM_MAX_STREAM_PRB_L1_SP}
    ...                                                             current_stream=${NUM_MAX_STREAM_PRB_L1_SP}
    ...                                                             calculated_stream=${NUM_MAX_STREAM_PRB_L1_SP}
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}
    # Check l1SubPoolStreamPrb Consistency on ul during traffic
    Step                                        Check l1SubPoolStreamPrb Consistency within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             pool_max_num_stream_prb=2292
    ...                                                             packet_name=ulInterL1SubpoolReconfData
    ...                                                             mode_debug=${False}
    # Check l1SubPoolStreamPrbCapacity on ul during traffic both sub_pool_id
    Step                                        Check l1SubPoolStreamPrbCapacity within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             pool_max_num_stream_prb=2292
    ...                                                             sub_pool_id=${ID_SUBPOOL_1}
    ...                                                             check_operator=>
    ...                                                             default_stream=${NUM_MAX_STREAM_PRB_L1_SP_UL_64}
    ...                                                             current_stream=${NUM_MAX_STREAM_PRB_L1_SP_UL_64}
    ...                                                             calculated_stream=${NUM_MAX_STREAM_PRB_L1_SP_UL_64}
    ...                                                             packet_name=ulInterL1SubpoolReconfData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}
    Step                                        Check l1SubPoolStreamPrbCapacity within TTI trace    json_file=${capture_tti_output}
    ...                                                             pool_id=${ID_POOL}
    ...                                                             pool_max_num_stream_prb=2292
    ...                                                             sub_pool_id=${ID_SUBPOOL_2}
    ...                                                             check_operator=<
    ...                                                             default_stream=${NUM_MAX_STREAM_PRB_L1_SP_UL_32}
    ...                                                             current_stream=${NUM_MAX_STREAM_PRB_L1_SP_UL_32}
    ...                                                             calculated_stream=${NUM_MAX_STREAM_PRB_L1_SP_UL_32}
    ...                                                             packet_name=ulInterL1SubpoolReconfData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}
    # Check Number Of PRB Allocated on dl per cell
    Step                                        Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=50
    ...                                                             check_operator=>
    ...                                                             stream_prb_gbr_alloc=0
    ...                                                             stream_prb_non_gbr_alloc=200
    ...                                                             num_alloc_prb=180
    ...                                                             bbrm_usable_cell_prb=${num_prb_cell_1}
    ...                                                             packet_name=dlAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}
    Step                                        Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=51
    ...                                                             check_operator=>
    ...                                                             stream_prb_gbr_alloc=0
    ...                                                             stream_prb_non_gbr_alloc=200
    ...                                                             num_alloc_prb=180
    ...                                                             bbrm_usable_cell_prb=${num_prb_cell_2}
    ...                                                             packet_name=dlAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}
    Step                                        Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=52
    ...                                                             check_operator=>
    ...                                                             stream_prb_gbr_alloc=0
    ...                                                             stream_prb_non_gbr_alloc=200
    ...                                                             num_alloc_prb=180
    ...                                                             bbrm_usable_cell_prb=${num_prb_cell_3}
    ...                                                             packet_name=dlAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}
    # Check Number Of PRB Allocated on ul per cell
    Step                                        Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=50
    ...                                                             check_operator=>
    ...                                                             stream_prb_gbr_alloc=30
    ...                                                             stream_prb_non_gbr_alloc=300
    ...                                                             num_alloc_prb=120
    ...                                                             bbrm_usable_cell_prb=${num_prb_cell_1}
    ...                                                             packet_name=ulAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}
    Step                                        Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=51
    ...                                                             check_operator=>
    ...                                                             stream_prb_gbr_alloc=30
    ...                                                             stream_prb_non_gbr_alloc=300
    ...                                                             num_alloc_prb=120
    ...                                                             bbrm_usable_cell_prb=${num_prb_cell_2}
    ...                                                             packet_name=ulAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}
    Step                                        Check Number Of PRB Allocated within TTI trace    json_file=${capture_tti_output}
    ...                                                             phys_cell_id=52
    ...                                                             check_operator=>
    ...                                                             stream_prb_gbr_alloc=30
    ...                                                             stream_prb_non_gbr_alloc=300
    ...                                                             num_alloc_prb=120
    ...                                                             bbrm_usable_cell_prb=${num_prb_cell_3}
    ...                                                             packet_name=ulAllocatedPooledResourcesData
    ...                                                             number_packet_to_check=128
    ...                                                             mode_debug=${False}

    # Waiting time added for observation and allow generation of multiple count periods
    FOR    ${iteration_pm}    IN RANGE    0    ${param.pm_waiting_period}
        Sleep Until PM Availability
        ${pm_path}=                             Counters.Collect PM files from BTS    ${LOG_PATH}/PM
        Run Keyword If    not ${CALL_SETUP_ONLY}    Step    Check Counter And KPI Constraints    ${pm_path}
        ...                                                         ${test_name}
        ...                                                         localKpiFileName=CB009915_KPI_Definitions.csv
    END
    Run Keyword If    not ${CALL_SETUP_ONLY}    Step    SYSLOG Stop    syslog=${syslog}

    # Deregister all the ue's
    Step                                        Traced Sleep    duration=3s    msg=deregistering    depends=CallSetup.UE Register
    FOR    ${current_elem}    IN    @{list_ue}
        Step                                    CallSetup.UE Deregister    id=${current_elem.ue}
        ...                                                         ue_deregister_type=switch_off
        ...                                                         by=ue
        ...                                     depends=CallSetup.UE Register
    END

    [Teardown]      Display diagnosis
# --------------------------------------------------------------------------------------------------------------------------------------------------
CB009915_B_IWK_basic_SA
    [Documentation]
    ...     Conditions:     it is based on the arguments ${config_blanking} ${dict_ues} ${is_capture} ${param} ${test_name}
    ...     Actions:        it performs the call setup for multi-ues with traffic on different cells
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues with traffic and PRB blanking are passed
    [Arguments]             ${config_blanking}
    ...                     ${dict_ues}
    ...                     ${is_capture}
    ...                     ${param}
    ...                     ${test_name}

    Init Sequence                               ${param}
    Dated Log New Line                          ===> test name is ${test_name}
    Run Keyword If    ${SUITE_DEBUG_MODE}       Set Debug Mode
    Step                                        Set RAD Parameters for CB009915    #vbo#Sherpa end#rad_0x580117_val=9
    Run Keyword If    ${param.act_blanking} == ${True}    Dated Log New Line    ===> blanking variable is enabled
    ...         ELSE                            Dated Log New Line    ===> BLANKING VARIABLE is disabled

    Critical Step                               Restart TL

    # Configure new ue's dynamically
    ${initial_nb_ue}=                           get length    ${dict_ues}
    Run Keyword If    ${initial_nb_ue} < ${param.total_nb_ue}    Configure New Ues    ${dict_ues}
    ...                                                             ${initial_nb_ue}
    ...                                                             ${param.total_nb_ue}
    ...                                                             ${dict_settings_ue_default}
    # Configure the current setting for all the ue's
    ${param.total_nb_ue}=                       get length    ${dict_ues}
    Dated Log New Line                          ===> configure the setting for all the ${param.total_nb_ue} ue's
    @{list_ue}=                                 Create List
    FOR    ${current_id}    IN RANGE    0    ${param.total_nb_ue}
        ${current_ue}=                          Evaluate            ${current_id} + 1
        ${current_ue_setting}=                  Copy Dictionary     ${BASIC_UE_SA}
        ${current_ue_id}=                       Evaluate            ${current_ue} + 0    #id for a sa ue starts at 1 into basic_setup.cfg#
        Set To Dictionary                       ${current_ue_setting}    ue    ${current_ue_id}
        Set To Dictionary                       ${current_ue_setting}    trf_id    1
        Set To Dictionary                       ${current_ue_setting}    pdu    1
        Set To Dictionary                       ${current_ue_setting}    target_gnb    ${param.target_gnb}

        # Dispatching the ue on the requested original cell for the call establishment
        Set To Dictionary                       ${current_ue_setting}    target_cells    ${dict_ues[${current_id}].original_cell}
        # Set the correct requested throughput per ue
        Set To Dictionary                       ${current_ue_setting}    throughput    ${dict_ues[${current_id}].throughput}
        Set To Dictionary                       ${current_ue_setting}    throughput_gbr    ${dict_ues[${current_id}].throughput_gbr}
        Set To Dictionary                       ${current_ue_setting}    throughput_ul    ${dict_ues[${current_id}].throughput_ul}
        Append To List                          ${list_ue}    ${current_ue_setting}
    END
    Dated Log New Line                          ===> ue's list is ${list_ue}
    Check Multi Ues Setting In List             list_multi_ue=${list_ue}
    Traced Sleep                                duration=15s    msg=Wtsemu system start-up to give radio modules time to start up

    # Start SYSLOG capture during call setup
    ${syslog}=                                  SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_call_setup

    # Capture TTI traces during call setup
    Start TTI Logs

    # Setup wtsemu SA for all the ue's
    Critical Step                               CallSetup.Setup Wtsemu SA    nbUe=${param.total_nb_ue}
    ...                                                             nbSaUe=${param.total_nb_ue}
    ...                                                             shouldUseLua=${False}
    ...                                                             list_of_UE_tobe_created=${list_ue}
    # WA to avoid degradation on cells
    Traced Sleep                                duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    Step                                        CallSetup.WTS Set X2 Link

    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                                    CallSetup.UE Register    ue=${current_elem.ue}
        ...                                     depends=CallSetup.Setup Wtsemu SA
        Step                                    CallSetup.Launch PDU Session    ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         gw=${current_elem.ue}
        ...                                     depends=CallSetup.UE Register
    END

    Step                                        Stop and Get TTI Logs    trace_name=TTI.${test_name}_call_setup
    Step                                        SYSLOG Stop    syslog=${syslog}

    #vbo#Sherpa end## Capture Sherpa after call setup for initial verification
    #vbo#Sherpa end#${enable_sherpa}=                           Set Variable        ${SHERPA_TRACE}
    #vbo#Sherpa end#Run Keyword If    ${enable_sherpa} == ${True}    Run Keywords    Step     Activate Sherpa
    #vbo#Sherpa end#...    AND                                  Traced Sleep    duration=8s    msg=capture after call setup
    #vbo#Sherpa end#...    AND                                  Deactivate Sherpa and Stop Collect
    #vbo#Sherpa end#...    AND    Step    Upload and decode sherpa pcap files    Sherpa_logs_local_path=${trace_dir}    duration=0
    #vbo#Sherpa end#...    AND                                  Calling Panda Extract Csv For PRB Blanking
    #vbo#Sherpa end#...    AND                                  Calling Panda Extract Csv For PRB Pooling
    #vbo#Sherpa end#Run Keyword If    not ${CALL_SETUP_ONLY} and ${enable_sherpa} == ${True}    Run Keywords
    #vbo#Sherpa end## Verification of ... direction=Dl by default
    #vbo#Sherpa end#...    Step                                 Verification of Pool Id within PRB Pooling Report    pool_id=${ID_POOL}
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_1}
    #vbo#Sherpa end#...    AND    Step                          Verification of Pool Id within PRB Pooling Report    pool_id=${ID_POOL}
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_2}
    #vbo#Sherpa end##
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling Mode within PRB Pooling Allocation Report    pool_id=${ID_POOL}
    #vbo#Sherpa end##
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling cell distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_1}
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_1}
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling cell distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_2}
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_2}
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling cell distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_3}
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_1}
    #vbo#Sherpa end## Verification of ... direction=Ul
    #vbo#Sherpa end#...    AND    Step                          Verification of Pool Id within PRB Pooling Report    pool_id=${ID_POOL}
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_1}
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end#...    AND    Step                          Verification of Pool Id within PRB Pooling Report    pool_id=${ID_POOL}
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_2}
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end##
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling Mode within PRB Pooling Allocation Report    pool_id=${ID_POOL}
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end##
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling cell distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_1}
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_1}
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling cell distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_2}
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_2}
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling cell distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_3}
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_1}
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end##
    #vbo#Sherpa end#
    Sleep Until PM Availability    # Wait end of PM period containing cell setup

    # Start SYSLOG capture during traffic establishment
    ${syslog}=    Run Keyword If    not ${CALL_SETUP_ONLY}    SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_traffic

    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY}
        ...    Step                             ${param.dir} Traffic Not Stopped    param=${param}    current_ue_setting=${current_elem}
        ...                                     depends=CallSetup.Launch PDU Session
    END

    # WA by moving Captures Init and Start to avoid exceeded traffic - Capture L1L2 during traffic for verification
    Run Keyword If    not ${CALL_SETUP_ONLY}    Run Keywords    Captures Init
    ...    AND                                  Captures Start    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${is_capture.is_capture_cprt}
    ...                                                             action_l1l2=${is_capture.is_capture_l1l2}
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic for L1L2 trace
    ...    AND    Step                          Captures Stop    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${is_capture.is_capture_cprt}
    ...                                                             action_l1l2=${is_capture.is_capture_l1l2}
    ${list_l1l2_messages_filters}=              CB009915 Create Filter Message List
    Run Keyword If    not ${CALL_SETUP_ONLY} and ${is_capture.is_capture_l1l2}    Step    CB009915 Analyze pcap and pdml
    ...                                                             pcap_file=${capture_l1l2.path}
    ...                                                             list_message_filter=${list_l1l2_messages_filters}

    # Capture TTI traces during traffic for verification
    Run Keyword If    not ${CALL_SETUP_ONLY}    Run Keywords    Start TTI Logs
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic for TTI trace
    ...    AND    Step                          Stop and Get TTI Logs    trace_name=TTI.${test_name}_traffic

    #vbo#Sherpa end## Capture Sherpa during traffic for verification
    #vbo#Sherpa end#${enable_sherpa}=                           Set Variable        ${SHERPA_TRACE}
    #vbo#Sherpa end#Run Keyword If    not ${CALL_SETUP_ONLY} and ${enable_sherpa} == ${True}    Run Keywords    Critical Step    Activate Sherpa
    #vbo#Sherpa end#...    AND                                  Traced Sleep    duration=8s    msg=call with traffic for Sherpa trace
    #vbo#Sherpa end#...    AND                                  Deactivate Sherpa and Stop Collect
    #vbo#Sherpa end#...    AND    Step    Upload and decode sherpa pcap files    Sherpa_logs_local_path=${trace_dir}    duration=0
    #vbo#Sherpa end#...    AND                                  Calling Panda Extract Csv For PRB Blanking
    #vbo#Sherpa end#...    AND                                  Calling Panda Extract Csv For PRB Pooling
    #vbo#Sherpa end#
    ${num_prb_cell}=    Run Keyword If    ${param.act_blanking} == ${True}    Evaluate
    ...    ${NUM_MAX_PRB_DEFAULT} - (${config_blanking.nbBlankedPRBsHighEdge}[0] + ${config_blanking.nbBlankedPRBsLowEdge}[0])
    ...                               ELSE    Set Variable    ${NUM_MAX_PRB_DEFAULT}
    ${num_prb_cell_1}=                          Convert To String    ${num_prb_cell}
    ${num_prb_cell}=    Run Keyword If    ${param.act_blanking} == ${True}    Evaluate
    ...    ${NUM_MAX_PRB_DEFAULT} - (${config_blanking.nbBlankedPRBsHighEdge}[1] + ${config_blanking.nbBlankedPRBsLowEdge}[1])
    ...                               ELSE    Set Variable    ${NUM_MAX_PRB_DEFAULT}
    ${num_prb_cell_2}=                          Convert To String    ${num_prb_cell}
    ${num_prb_cell}=    Run Keyword If    ${param.act_blanking} == ${True}    Evaluate
    ...    ${NUM_MAX_PRB_DEFAULT} - (${config_blanking.nbBlankedPRBsHighEdge}[2] + ${config_blanking.nbBlankedPRBsLowEdge}[2])
    ...                               ELSE    Set Variable    ${NUM_MAX_PRB_DEFAULT}
    ${num_prb_cell_3}=                          Convert To String    ${num_prb_cell}

    #vbo#Sherpa end#Run Keyword If    not ${CALL_SETUP_ONLY} and ${enable_sherpa} == ${True}    Run Keywords
    #vbo#Sherpa end## Verification of ... direction=Dl by default
    #vbo#Sherpa end#...    Step    Verification of Stream PRB Information within PRB Pooling Report    stream_prb_capa=2710
    #vbo#Sherpa end#...                                             alloc_stream_prb=2056    #2710 <=> 2184+ 526 (+526 from subpool 2)
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_1}
    #vbo#Sherpa end#...                                                             check_operator===
    #vbo#Sherpa end#...    AND    Step    Verification of Stream PRB Information within PRB Pooling Report    stream_prb_capa=1658
    #vbo#Sherpa end#...                                                             alloc_stream_prb=1004    #1658 <=> 2184- 526 (-526 to subpool 1)
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_2}
    #vbo#Sherpa end#...                                                             check_operator===
    #vbo#Sherpa end##
    #vbo#Sherpa end#...    AND    Step    Verification of Number PRB Allocated within PRB Pooling Report    num_min_prb=${NUM_MIN_PRB_DEFAULT}
    #vbo#Sherpa end#...                                                             num_max_prb=${num_prb_cell_1}
    #vbo#Sherpa end#...                                                             num_prb_alloc=${num_prb_cell_1}
    #vbo#Sherpa end#...                                                             prereq_data=${COL_NAME_NRCELLID}
    #vbo#Sherpa end#...                                                             prereq_value=${ID_NRCELL_1}
    #vbo#Sherpa end#...                                                             check_operator===
    #vbo#Sherpa end#...    AND    Step    Verification of Number PRB Allocated within PRB Pooling Report    num_min_prb=${NUM_MIN_PRB_DEFAULT}
    #vbo#Sherpa end#...                                                             num_max_prb=${num_prb_cell_2}
    #vbo#Sherpa end#...                                                             num_prb_alloc=${num_prb_cell_2}
    #vbo#Sherpa end#...                                                             prereq_data=${COL_NAME_NRCELLID}
    #vbo#Sherpa end#...                                                             prereq_value=${ID_NRCELL_2}
    #vbo#Sherpa end#...                                                             check_operator===
    #vbo#Sherpa end#...    AND    Step    Verification of Number PRB Allocated within PRB Pooling Report    num_min_prb=${NUM_MIN_PRB_DEFAULT}
    #vbo#Sherpa end#...                                                             num_max_prb=${num_prb_cell_3}
    #vbo#Sherpa end#...                                                             num_prb_alloc=${num_prb_cell_3}
    #vbo#Sherpa end#...                                                             prereq_data=${COL_NAME_NRCELLID}
    #vbo#Sherpa end#...                                                             prereq_value=${ID_NRCELL_3}
    #vbo#Sherpa end#...                                                             check_operator===
    #vbo#Sherpa end##
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling ZAB distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_1}
    #vbo#Sherpa end#...                                                             zab_privilege=0
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling ZAB distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_2}
    #vbo#Sherpa end#...                                                             zab_privilege=0
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling ZAB distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_3}
    #vbo#Sherpa end#...                                                             zab_privilege=0
    #vbo#Sherpa end## Verification of ... direction=Ul
    #vbo#Sherpa end#...    AND    Step    Verification of Stream PRB Information within PRB Pooling Report    stream_prb_capa=2164
    #vbo#Sherpa end#...                                                             alloc_stream_prb=2056
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_1}
    #vbo#Sherpa end#...                                                             check_operator===
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end#...    AND    Step    Verification of Stream PRB Information within PRB Pooling Report    stream_prb_capa=1112
    #vbo#Sherpa end#...                                                             alloc_stream_prb=1004
    #vbo#Sherpa end#...                                                             subpool_id=${ID_SUBPOOL_2}
    #vbo#Sherpa end#...                                                             check_operator===
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end##
    #vbo#Sherpa end#...    AND    Step                          Verification of Number PRB Allocated within PRB Pooling Report
    #vbo#Sherpa end#...                                                             num_min_prb=${NUM_MIN_PRB_DEFAULT_UL}
    #vbo#Sherpa end#...                                                             num_max_prb=${num_prb_cell_1}
    #vbo#Sherpa end#...                                                             num_prb_alloc=${num_prb_cell_1}
    #vbo#Sherpa end#...                                                             prereq_data=${COL_NAME_NRCELLID}
    #vbo#Sherpa end#...                                                             prereq_value=${ID_NRCELL_1}
    #vbo#Sherpa end#...                                                             check_operator===
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end#...    AND    Step                          Verification of Number PRB Allocated within PRB Pooling Report
    #vbo#Sherpa end#...                                                             num_min_prb=${NUM_MIN_PRB_DEFAULT_UL}
    #vbo#Sherpa end#...                                                             num_max_prb=${num_prb_cell_2}
    #vbo#Sherpa end#...                                                             num_prb_alloc=${num_prb_cell_2}
    #vbo#Sherpa end#...                                                             prereq_data=${COL_NAME_NRCELLID}
    #vbo#Sherpa end#...                                                             prereq_value=${ID_NRCELL_2}
    #vbo#Sherpa end#...                                                             check_operator===
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end#...    AND    Step                          Verification of Number PRB Allocated within PRB Pooling Report
    #vbo#Sherpa end#...                                                             num_min_prb=${NUM_MIN_PRB_DEFAULT_UL}
    #vbo#Sherpa end#...                                                             num_max_prb=${num_prb_cell_3}
    #vbo#Sherpa end#...                                                             num_prb_alloc=${num_prb_cell_3}
    #vbo#Sherpa end#...                                                             prereq_data=${COL_NAME_NRCELLID}
    #vbo#Sherpa end#...                                                             prereq_value=${ID_NRCELL_3}
    #vbo#Sherpa end#...                                                             check_operator===
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end##
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling ZAB distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_1}
    #vbo#Sherpa end#...                                                             zab_privilege=0
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling ZAB distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_2}
    #vbo#Sherpa end#...                                                             zab_privilege=0
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end#...    AND    Step    Verification of BB Pooling ZAB distribution within PRB Pooling Report    nr_cell_id=${ID_NRCELL_3}
    #vbo#Sherpa end#...                                                             zab_privilege=0
    #vbo#Sherpa end#...                                                             direction=Ul
    #vbo#Sherpa end#
    # Waiting time added for observation and allow generation of multiple count periods
    FOR    ${iteration_pm}    IN RANGE    0    ${param.pm_waiting_period}
        Sleep Until PM Availability
        ${pm_path}=                             Counters.Collect PM files from BTS    ${LOG_PATH}/PM
        Run Keyword If    not ${CALL_SETUP_ONLY}    Step    Check Counter And KPI Constraints    ${pm_path}
        ...                                                         ${test_name}
        ...                                                         localKpiFileName=CB009915_KPI_Definitions.csv
    END

    Run Keyword If    not ${CALL_SETUP_ONLY}    Step    SYSLOG Stop    syslog=${syslog}

    # Deregister all the ue's
    Step                                        Traced Sleep    duration=3s    msg=deregistering    depends=CallSetup.UE Register
    FOR    ${current_elem}    IN    @{list_ue}
        Step                                    CallSetup.UE Deregister    id=${current_elem.ue}
        ...                                                         ue_deregister_type=switch_off
        ...                                                         by=ue
        ...                                     depends=CallSetup.UE Register
    END

