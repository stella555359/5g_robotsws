CB009915_B2_6_IWK_multi_dedicated_power_saving_SA
    [Documentation]
    ...     Conditions:     it is based on the arguments ${config_blanking} ${dict_ues} ${is_capture} ${param} ${test_name}
    ...     Actions:        it performs the call setup for multi-ues with traffic on different cells
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues with traffic and PRB blanking are passed
    [Arguments]             ${config_blanking}
    ...                     ${dict_ues}
    ...                     ${is_capture}
    ...                     ${param}
    ...                     ${test_name}

    Init Sequence                               ${param}
    Dated Log New Line                          ===> test name is ${test_name}
    Run Keyword If    ${SUITE_DEBUG_MODE}       Set Debug Mode
    Step                                        Set RAD Parameters for CB009915    rad_0x58057a_val=4    rad_0x58057c_val=0x10000
    Run Keyword If    ${param.act_blanking} == ${True}    Dated Log New Line    ===> blanking variable is enabled
    ...         ELSE                            Dated Log New Line    ===> BLANKING VARIABLE is disabled

    Critical Step                               Restart TL

    # Configure new ue's dynamically
    ${initial_nb_ue}=                           get length    ${dict_ues}
    Run Keyword If    ${initial_nb_ue} < ${param.total_nb_ue}    Configure New Ues    ${dict_ues}
    ...                                                             ${initial_nb_ue}
    ...                                                             ${param.total_nb_ue}
    ...                                                             ${dict_settings_ue_default}
    # Configure the current setting for all the ue's
    ${param.total_nb_ue}=                       get length    ${dict_ues}
    Dated Log New Line                          ===> configure the setting for all the ${param.total_nb_ue} ue's
    @{list_ue}=                                 Create List
    FOR    ${current_id}    IN RANGE    0    ${param.total_nb_ue}
        ${current_ue}=                          Evaluate            ${current_id} + 1
        ${current_ue_setting}=                  Copy Dictionary     ${BASIC_UE_SA}
        ${current_ue_id}=                       Evaluate            ${current_ue} + 0    #id for a sa ue starts at 1 into basic_setup.cfg#
        Set To Dictionary                       ${current_ue_setting}    ue    ${current_ue_id}
        Set To Dictionary                       ${current_ue_setting}    trf_id    1
        Set To Dictionary                       ${current_ue_setting}    pdu    1
        Set To Dictionary                       ${current_ue_setting}    target_gnb    ${param.target_gnb}

        # Dispatching the ue on the requested original cell for the call establishment
        Set To Dictionary                       ${current_ue_setting}    target_cells    ${dict_ues[${current_id}].original_cell}
        # Set the correct requested throughput per ue
        Set To Dictionary                       ${current_ue_setting}    throughput    ${dict_ues[${current_id}].throughput}
        Set To Dictionary                       ${current_ue_setting}    throughput_gbr    ${dict_ues[${current_id}].throughput_gbr}
        Set To Dictionary                       ${current_ue_setting}    throughput_ul    ${dict_ues[${current_id}].throughput_ul}
        Append To List                          ${list_ue}    ${current_ue_setting}
    END
    Dated Log New Line                          ===> ue's list is ${list_ue}
    Check Multi Ues Setting In List             list_multi_ue=${list_ue}
    Traced Sleep                                duration=15s    msg=Wtsemu system start-up to give radio modules time to start up

    # Start SYSLOG capture during call setup
    ${syslog}=                                  SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_call_setup

    # Capture TTI traces during call setup
    Start TTI Logs

    # Capture L1L2 traces during call setup
    Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Step    Captures Init
    ...    AND                                  Capture Start    capture=${capture_l1l2}

    # Setup wtsemu SA for all the ue's
    Critical Step                               CallSetup.Setup Wtsemu SA    nbUe=${param.total_nb_ue}
    ...                                                             nbSaUe=${param.total_nb_ue}
    ...                                                             shouldUseLua=${False}
    ...                                                             list_of_UE_tobe_created=${list_ue}
    # WA to avoid degradation on cells
    Traced Sleep                                duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    Step                                        CallSetup.WTS Set X2 Link

    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Critical Step                           CallSetup.UE Register    ue=${current_elem.ue}
        ...                                     depends=CallSetup.Setup Wtsemu SA
        Step                                    CallSetup.Launch PDU Session    ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         gw=${current_elem.ue}
        ...                                     depends=CallSetup.UE Register
    END

    ${capture_l1l2_output}=                     Set Variable    ${LOG_PATH}/L1L2.${test_name}_call_setup.pcap
    Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Step    Capture Stop    capture=${capture_l1l2}
    ...    AND                                  Dated Log    capture l1l2 input= ${capture_l1l2.path}
    ...    AND                                  Dated Log    capture l1l2 output= ${capture_l1l2_output}
    ...    AND                                  Run    command=mv ${capture_l1l2.path} ${capture_l1l2_output}

    Step                                        Stop and Get TTI Logs    trace_name=TTI.${test_name}_call_setup
    Step                                        SYSLOG Stop    syslog=${syslog}

    # Generation of multiples L1L2, TTI captures
    ${iteration_pm}=                            Set Variable    0
    Dated Log New Line                          ===> Loop_${iteration_pm}: L1L2 + TTI during different phases of traffic

    # Capture SYSLOG traces during switch from small dedicated BWP to power saving BWP
    ${syslog}=                                  SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_sm_ps_bwp_loop-${iteration_pm}
    # Start the non GBR traffic upper than power saving thresholds for ue1 and ue2 traffics in small dedicated BWP
    ${list_ue[0].throughput}=                   Set Variable    11    # ue is small dedicated capable
    ${list_ue[1].throughput}=                   Set Variable    12    # ue is small dedicated capable
    Critical Step                               Start Low Traffic For Ues    param=${param}    list_ue=${list_ue}    unit=mbps
    ...                                                             bwp_transition=from bwpId 2 to 1
    Traced Sleep    duration=8s    msg=call with traffic upper than thresholds for NOT triggering power saving then to activate dedicated

    # Capture L1L2 traces during traffic for verification
    ${capture_l1l2_output}=                     Set Variable    ${LOG_PATH}/L1L2.${test_name}_sm_bwp_loop-${iteration_pm}.pcap
    Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Capture Start    capture=${capture_l1l2}
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic in dedicated for L1L2 trace
    ...    AND    Step                          Capture Stop    capture=${capture_l1l2}
    ...    AND                                  Dated Log    capture l1l2 input= ${capture_l1l2.path}
    ...    AND                                  Dated Log    capture l1l2 output= ${capture_l1l2_output}
    ...    AND                                  Run    command=mv ${capture_l1l2.path} ${capture_l1l2_output}

    # Capture TTI traces during traffic for verification
    Start TTI Logs
    Traced Sleep    duration=8s    msg=call with traffic in dedicated for TTI trace
    Step                                        Stop and Get TTI Logs    trace_name=TTI.${test_name}_sm_bwp_loop-${iteration_pm}

    # Start the non GBR traffic lower than power saving thresholds for ue1 and ue2 switching to power saving
    ${list_ue[0].throughput}=                   Set Variable    101
    ${list_ue[1].throughput}=                   Set Variable    102
    Critical Step                               Start Low Traffic For Ues    param=${param}    list_ue=${list_ue}    unit=kbps
    ...                                                             bwp_transition=from bwpId 1 to 2
    Traced Sleep    duration=8s    msg=call with traffic lower than thresholds for triggering power saving
    Step                                        SYSLOG Stop    syslog=${syslog}

    # Capture L1L2 traces during traffic for verification
    ${capture_l1l2_output}=                     Set Variable    ${LOG_PATH}/L1L2.${test_name}_sm_ps_bwp_loop-${iteration_pm}.pcap
    Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Capture Start    capture=${capture_l1l2}
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic lower than thresholds for L1L2 trace
    ...    AND    Step                          Capture Stop    capture=${capture_l1l2}
    ...    AND                                  Dated Log    capture l1l2 input= ${capture_l1l2.path}
    ...    AND                                  Dated Log    capture l1l2 output= ${capture_l1l2_output}
    ...    AND                                  Run    command=mv ${capture_l1l2.path} ${capture_l1l2_output}

    # Capture TTI traces during traffic for verification
    Start TTI Logs
    Traced Sleep    duration=8s    msg=call with traffic lower than thresholds for TTI trace
    Step                                        Stop and Get TTI Logs    trace_name=TTI.${test_name}_sm_ps_bwp_loop-${iteration_pm}

    # Stop the traffic on all ue's
    Step                                        Stop Low Traffic For Ues    param=${param}    list_ue=${list_ue}
    ${list_ue[0].throughput}=                   Set Variable    ${NO_THROUGHPUT}
    ${list_ue[1].throughput}=                   Set Variable    ${NO_THROUGHPUT}

    # Capture SYSLOG traces during switch from large dedicated BWP to power saving BWP
    ${syslog}=                                  SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_lg_ps_bwp_loop-${iteration_pm}
    # Start the non GBR traffic upper than power saving thresholds for ue1 and ue2 traffics in small dedicated BWP
    ${list_ue[2].throughput}=                   Set Variable    13    # ue is large dedicated capable
    ${list_ue[3].throughput}=                   Set Variable    14    # ue is large dedicated capable
    Critical Step                               Start Low Traffic For Ues    param=${param}    list_ue=${list_ue}    unit=mbps
    ...                                                         bwp_transition=from bwpId 2 to 1
    Traced Sleep    duration=8s    msg=call with traffic upper than thresholds for NOT triggering power saving then to activate dedicated

    # Capture L1L2 traces during traffic for verification
    ${capture_l1l2_output}=                     Set Variable    ${LOG_PATH}/L1L2.${test_name}_lg_bwp_loop-${iteration_pm}.pcap
    Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Capture Start    capture=${capture_l1l2}
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic in dedicated for L1L2 trace
    ...    AND    Step                          Capture Stop    capture=${capture_l1l2}
    ...    AND                                  Dated Log    capture l1l2 input= ${capture_l1l2.path}
    ...    AND                                  Dated Log    capture l1l2 output= ${capture_l1l2_output}
    ...    AND                                  Run    command=mv ${capture_l1l2.path} ${capture_l1l2_output}

    # Capture TTI traces during traffic for verification
    Start TTI Logs
    Traced Sleep    duration=8s    msg=call with traffic in dedicated for TTI trace
    Step                                        Stop and Get TTI Logs    trace_name=TTI.${test_name}_lg_bwp_loop-${iteration_pm}

    # Start the non GBR traffic lower than power saving thresholds for ue1 and ue2 switching to power saving
    ${list_ue[2].throughput}=                   Set Variable    103
    ${list_ue[3].throughput}=                   Set Variable    104
    Critical Step                               Start Low Traffic For Ues    param=${param}    list_ue=${list_ue}    unit=kbps
    ...                                                             bwp_transition=from bwpId 1 to 2
    Traced Sleep    duration=8s    msg=call with traffic lower than thresholds for triggering power saving
    Step                                        SYSLOG Stop    syslog=${syslog}

    # Capture L1L2 traces during traffic for verification
    ${capture_l1l2_output}=                     Set Variable    ${LOG_PATH}/L1L2.${test_name}_lg_ps_bwp_loop-${iteration_pm}.pcap
    Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Capture Start    capture=${capture_l1l2}
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic lower than thresholds for L1L2 trace
    ...    AND    Step                          Capture Stop    capture=${capture_l1l2}
    ...    AND                                  Dated Log    capture l1l2 input= ${capture_l1l2.path}
    ...    AND                                  Dated Log    capture l1l2 output= ${capture_l1l2_output}
    ...    AND                                  Run    command=mv ${capture_l1l2.path} ${capture_l1l2_output}

    # Capture TTI traces during traffic for verification
    Start TTI Logs
    Traced Sleep    duration=8s    msg=call with traffic lower than thresholds for TTI trace
    Step                                        Stop and Get TTI Logs    trace_name=TTI.${test_name}_lg_ps_bwp_loop-${iteration_pm}

    # Stop the traffic on all ue's
    Step                                        Stop Low Traffic For Ues    param=${param}    list_ue=${list_ue}
    ${list_ue[2].throughput}=                   Set Variable    ${NO_THROUGHPUT}
    ${list_ue[3].throughput}=                   Set Variable    ${NO_THROUGHPUT}

    # Check counter and KPI constraints in loop
    Sleep Until PM Availability    # Wait end of PM period
    FOR    ${iteration_pm}    IN RANGE    1    ${param.pm_waiting_period} + 1
        Dated Log New Line                      ===> Loop_${iteration_pm}: check counters and KPI constraints with different phases of traffic

        # Start the non GBR traffic upper than power saving thresholds for all ue's
        ${list_ue[0].throughput}=               Set Variable    11    # ue is small dedicated capable
        ${list_ue[1].throughput}=               Set Variable    12    # ue is small dedicated capable
        ${list_ue[2].throughput}=               Set Variable    13    # ue is large dedicated capable
        ${list_ue[3].throughput}=               Set Variable    14    # ue is large dedicated capable
        Critical Step                           Start Low Traffic For Ues    param=${param}    list_ue=${list_ue}    unit=mbps
        ...                                                         bwp_transition=from bwpId 2 to 1
        Traced Sleep    duration=60s    msg=call with traffic upper than thresholds for NOT triggering power saving then to activate dedicated

        # Start the non GBR traffic lower than power saving thresholds for ue1 and ue2 switching to power saving
        ${list_ue[0].throughput}=               Set Variable    101
        ${list_ue[1].throughput}=               Set Variable    102
        ${list_ue[2].throughput}=               Set Variable    103
        ${list_ue[3].throughput}=               Set Variable    104
        Critical Step                           Start Low Traffic For Ues    param=${param}    list_ue=${list_ue}    unit=kbps
        ...                                                         bwp_transition=from bwpId 1 to 2
        Traced Sleep    duration=90s    msg=call with traffic lower than thresholds for triggering power saving

        # Stop the traffic on all ue's
        Step                                    Stop Low Traffic For Ues    param=${param}    list_ue=${list_ue}
        ${list_ue[0].throughput}=               Set Variable    ${NO_THROUGHPUT}
        ${list_ue[1].throughput}=               Set Variable    ${NO_THROUGHPUT}
        ${list_ue[2].throughput}=               Set Variable    ${NO_THROUGHPUT}
        ${list_ue[3].throughput}=               Set Variable    ${NO_THROUGHPUT}

        #vbo#check_not_fixed#Sleep Until PM Availability    # Wait end of PM period
        #vbo#check_not_fixed#${pm_path}=                             Counters.Collect PM files from BTS    ${LOG_PATH}/PM
        #vbo#check_not_fixed#Step                                    Check Counter And KPI Constraints    ${pm_path}
        #vbo#check_not_fixed#...                                                         ${test_name}
        #vbo#check_not_fixed#...                                                         localKpiFileName=CB009915_KPI_Definitions.csv
    END

    # Deregister all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                                    CallSetup.UE Deregister    id=${current_elem.ue}
        ...                                                         ue_deregister_type=switch_off
        ...                                                         by=ue
        ...                                     depends=CallSetup.UE Register
    END

    # Post-processing and traces analysis
    ${iteration_pm}=                            Set Variable    0
    Dated Log New Line    ===> Loop_${iteration_pm}: post-processing and analysis of L1L2 and TTI in case small dedicated ue1 and ue2
    ${capture_l1l2_output}=                     Set Variable    ${LOG_PATH}/L1L2.${test_name}_sm_bwp_loop-${iteration_pm}.pcap
    #vbo#check_not_fixed#Step    CB009915_B2 Post Processing and Analysis within L1L2    capture_input=${capture_l1l2_output}
    #vbo#check_not_fixed#...                                                             config_blanking=${config_blanking}
    #vbo#check_not_fixed#...                                                             is_capture=${is_capture.is_capture_l1l2}
    #vbo#check_not_fixed#...                                                             subcellid_C1=0
    #vbo#check_not_fixed#...                                                             subcellid_C2=1
    #vbo#check_not_fixed#...                                                             coresetFreqDomain_C1=${coresetFreqDomain_9915_B2_6_C1}
    #vbo#check_not_fixed#...                                                             coresetFreqDomain_C2=${coresetFreqDomain_9915_B2_6_C2}
    #vbo#check_not_fixed#...    coresetFreqDomain_0xFFFF=${coresetFreqDomain_9915_B2_6_0xFFFF}
    #vbo#check_not_fixed#...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}
    #vbo#check_not_fixed#...                                                             rbgsize=16
    #vbo#check_not_fixed#...                                                             is_large_bwp=${False}
    #vbo#check_not_fixed#...                                                             total_prb_bwp2=${NUM_MAX_PRB_BWP_60MHZ}
    #vbo#check_not_fixed#...    prb_reserved_C1=36    # NRCELL.pdcchAutoConfig.pucchSize <=> numOfNrPucchPrbs
    #vbo#check_not_fixed#...                                                             prb_reserved_C2=32    #vbo#WA HIGH#
    #vbo#check_not_fixed##vbo#WA HIGH#...                                                             prb_reserved_C2=36
    #vbo#check_not_fixed#...                                                             is_nb_prb_max_triggered=${False}
    ${capture_tti_output}=                      Set Variable    ${LOG_PATH}/TTITraces/TTI.${test_name}_sm_bwp_loop-${iteration_pm}.json
    #vbo#check_not_fixed#Step    CB009915_B2 Post Processing and Analysis within TTI    capture_input=${capture_tti_output}
    #vbo#check_not_fixed#...                                                             phys_cell_id_1=50
    #vbo#check_not_fixed#...                                                             phys_cell_id_2=51
    #vbo#check_not_fixed#...                                                             search_space_type=UE_SPECIFIC
    #vbo#check_not_fixed#...                                                             search_space_id=13
    #vbo#check_not_fixed#...                                                             cell_bwp_id=2

    Dated Log New Line    ===> Loop_${iteration_pm}: post-processing and analysis of L1L2 and TTI in case power saving ue1 and ue2
    ${capture_l1l2_output}=                     Set Variable    ${LOG_PATH}/L1L2.${test_name}_sm_ps_bwp_loop-${iteration_pm}.pcap
    #vbo#check_not_fixed#Step    CB009915_B2 Post Processing and Analysis within L1L2    capture_input=${capture_l1l2_output}
    #vbo#check_not_fixed#...                                                             config_blanking=${config_blanking}
    #vbo#check_not_fixed#...                                                             is_capture=${is_capture.is_capture_l1l2}
    #vbo#check_not_fixed#...                                                             subcellid_C1=0
    #vbo#check_not_fixed#...                                                             subcellid_C2=1
    #vbo#check_not_fixed#...                                                             coresetFreqDomain_C1=${coresetFreqDomain_9915_B2_6_C1}
    #vbo#check_not_fixed#...                                                             coresetFreqDomain_C2=${coresetFreqDomain_9915_B2_6_C2}
    #vbo#check_not_fixed#...    coresetFreqDomain_0xFFFF=${coresetFreqDomain_9915_B2_6_0xFFFF}
    #vbo#check_not_fixed#...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}
    #vbo#check_not_fixed#...                                                             rbgsize=16
    #vbo#check_not_fixed#...                                                             is_large_bwp=${False}
    #vbo#check_not_fixed#...                                                             total_prb_bwp2=${NUM_MAX_PRB_BWP_40MHZ}    #vbo#WA HIGH#
    #vbo#check_not_fixed##vbo#WA HIGH#...                                                             total_prb_bwp2=${NUM_MAX_PRB_BWP_60MHZ}
    #vbo#check_not_fixed#...    prb_reserved_C1=36    # NRCELL.pdcchAutoConfig.pucchSize <=> numOfNrPucchPrbs
    #vbo#check_not_fixed#...                                                             prb_reserved_C2=32    #vbo#WA HIGH#
    #vbo#check_not_fixed##vbo#WA HIGH#...                                                             prb_reserved_C2=36
    #vbo#check_not_fixed#...                                                             is_nb_prb_max_triggered=${False}
    ${capture_tti_output}=                      Set Variable    ${LOG_PATH}/TTITraces/TTI.${test_name}_sm_ps_bwp_loop-${iteration_pm}.json
    Step                                        CB009915_B2 Post Processing and Analysis within TTI    capture_input=${capture_tti_output}
    ...                                                             phys_cell_id_1=50
    ...                                                             phys_cell_id_2=51
    ...                                                             search_space_type=UE_SPECIFIC
    ...                                                             search_space_id=18    #vbo#WA HIGH#
    #vbo#WA HIGH#...                                                             search_space_id=13
    ...                                                             cell_bwp_id=3    #vbo#WA HIGH#
    #vbo#WA HIGH#...                                                             cell_bwp_id=2

    Dated Log New Line    ===> Loop_${iteration_pm}: post-processing and analysis of L1L2 and TTI in case large dedicated ue3 and ue4
    ${capture_l1l2_output}=                     Set Variable    ${LOG_PATH}/L1L2.${test_name}_lg_bwp_loop-${iteration_pm}.pcap
    #vbo#check_not_fixed#Step    CB009915_B2 Post Processing and Analysis within L1L2    capture_input=${capture_l1l2_output}
    #vbo#check_not_fixed#...                                                             config_blanking=${config_blanking}
    #vbo#check_not_fixed#...                                                             is_capture=${is_capture.is_capture_l1l2}
    #vbo#check_not_fixed#...                                                             subcellid_C1=0
    #vbo#check_not_fixed#...                                                             subcellid_C2=1
    #vbo#check_not_fixed#...                                                             coresetFreqDomain_C1=${coresetFreqDomain_9915_B2_6_C1}
    #vbo#check_not_fixed#...                                                             coresetFreqDomain_C2=${coresetFreqDomain_9915_B2_6_C2}
    #vbo#check_not_fixed#...    coresetFreqDomain_0xFFFF=${coresetFreqDomain_9915_B2_6_0xFFFF}
    #vbo#check_not_fixed#...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}
    #vbo#check_not_fixed#...                                                             rbgsize=16
    #vbo#check_not_fixed#...                                                             is_large_bwp=${True}
    #vbo#check_not_fixed#...    prb_reserved_C1=36    # NRCELL.pdcchAutoConfig.pucchSize <=> numOfNrPucchPrbs
    #vbo#check_not_fixed#...                                                             prb_reserved_C2=32    #vbo#WA HIGH#
    #vbo#check_not_fixed##vbo#WA HIGH#...                                                             prb_reserved_C2=36
    #vbo#check_not_fixed#...                                                             is_nb_prb_max_triggered=${False}
    ${capture_tti_output}=                      Set Variable    ${LOG_PATH}/TTITraces/TTI.${test_name}_lg_bwp_loop-${iteration_pm}.json
    #vbo#check_not_fixed#Step    CB009915_B2 Post Processing and Analysis within TTI    capture_input=${capture_tti_output}
    #vbo#check_not_fixed#...                                                             phys_cell_id_1=50
    #vbo#check_not_fixed#...                                                             phys_cell_id_2=51
    #vbo#check_not_fixed#...                                                             search_space_type=UE_SPECIFIC
    #vbo#check_not_fixed#...                                                             search_space_id=8
    #vbo#check_not_fixed#...                                                             cell_bwp_id=1

    Dated Log New Line    ===> Loop_${iteration_pm}: post-processing and analysis of L1L2 and TTI in case power saving ue3 and ue4
    ${capture_l1l2_output}=                     Set Variable    ${LOG_PATH}/L1L2.${test_name}_lg_ps_bwp_loop-${iteration_pm}.pcap
    #vbo#check_not_fixed#Step    CB009915_B2 Post Processing and Analysis within L1L2    capture_input=${capture_l1l2_output}
    #vbo#check_not_fixed#...                                                             config_blanking=${config_blanking}
    #vbo#check_not_fixed#...                                                             is_capture=${is_capture.is_capture_l1l2}
    #vbo#check_not_fixed#...                                                             subcellid_C1=0
    #vbo#check_not_fixed#...                                                             subcellid_C2=1
    #vbo#check_not_fixed#...                                                             coresetFreqDomain_C1=${coresetFreqDomain_9915_B2_6_C1}
    #vbo#check_not_fixed#...                                                             coresetFreqDomain_C2=${coresetFreqDomain_9915_B2_6_C2}
    #vbo#check_not_fixed#...    coresetFreqDomain_0xFFFF=${coresetFreqDomain_9915_B2_6_0xFFFF}
    #vbo#check_not_fixed#...                                                             total_prb=${NUM_MAX_PRB_DEFAULT}
    #vbo#check_not_fixed#...                                                             rbgsize=16
    #vbo#check_not_fixed#...                                                             is_large_bwp=${False}    #vbo#WA HIGH#
    #vbo#check_not_fixed##vbo#WA HIGH#...                                                             is_large_bwp=${True}
    #vbo#check_not_fixed#...                                                             total_prb_bwp2=${NUM_MAX_PRB_BWP_40MHZ}    #vbo#WA HIGH#
    #vbo#check_not_fixed##vbo#WA HIGH#...                                                             total_prb_bwp2=${NUM_MAX_PRB_DEFAULT}
    #vbo#check_not_fixed#...    prb_reserved_C1=36    # NRCELL.pdcchAutoConfig.pucchSize <=> numOfNrPucchPrbs
    #vbo#check_not_fixed#...                                                             prb_reserved_C2=32    #vbo#WA HIGH#
    #vbo#check_not_fixed##vbo#WA HIGH#...                                                             prb_reserved_C2=36
    #vbo#check_not_fixed#...                                                             is_nb_prb_max_triggered=${False}
    ${capture_tti_output}=                      Set Variable    ${LOG_PATH}/TTITraces/TTI.${test_name}_lg_ps_bwp_loop-${iteration_pm}.json
    Step                                        CB009915_B2 Post Processing and Analysis within TTI    capture_input=${capture_tti_output}
    ...                                                             phys_cell_id_1=50
    ...                                                             phys_cell_id_2=51
    ...                                                             search_space_type=UE_SPECIFIC
    ...                                                             search_space_id=18    #vbo#WA HIGH#
    #vbo#WA HIGH#...                                                             search_space_id=8
    ...                                                             cell_bwp_id=3    #vbo#WA HIGH#
    #vbo#WA HIGH#...                                                             cell_bwp_id=1

    [Teardown]      Display diagnosis
# --------------------------------------------------------------------------------------------------------------------------------------------------
CB009915_B2_5_IWK_power_saving_SA
    [Documentation]
    ...     Conditions:     it is based on the arguments ${config_blanking} ${dict_ues} ${is_capture} ${param} ${test_name}
    ...     Actions:        it performs the call setup for multi-ues with traffic on different cells
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues with traffic and PRB blanking are passed
    [Arguments]             ${config_blanking}
    ...                     ${dict_ues}
    ...                     ${is_capture}
    ...                     ${param}
    ...                     ${test_name}

    Init Sequence                               ${param}
    Dated Log New Line                          ===> test name is ${test_name}
    Run Keyword If    ${SUITE_DEBUG_MODE}       Set Debug Mode
    Step                                        Set RAD Parameters for CB009915    rad_0x58057a_val=4    rad_0x58057c_val=0x90000
    Run Keyword If    ${param.act_blanking} == ${True}    Dated Log New Line    ===> blanking variable is enabled
    ...         ELSE                            Dated Log New Line    ===> BLANKING VARIABLE is disabled

    Critical Step                               Restart TL

    # Configure new ue's dynamically
    ${initial_nb_ue}=                           get length    ${dict_ues}
    Run Keyword If    ${initial_nb_ue} < ${param.total_nb_ue}    Configure New Ues    ${dict_ues}
    ...                                                             ${initial_nb_ue}
    ...                                                             ${param.total_nb_ue}
    ...                                                             ${dict_settings_ue_default}
    # Configure the current setting for all the ue's
    ${param.total_nb_ue}=                       get length    ${dict_ues}
    Dated Log New Line                          ===> configure the setting for all the ${param.total_nb_ue} ue's
    @{list_ue}=                                 Create List
    FOR    ${current_id}    IN RANGE    0    ${param.total_nb_ue}
        ${current_ue}=                          Evaluate            ${current_id} + 1
        ${current_ue_setting}=                  Copy Dictionary     ${BASIC_UE_SA}
        ${current_ue_id}=                       Evaluate            ${current_ue} + 0    #id for a sa ue starts at 1 into basic_setup.cfg#
        Set To Dictionary                       ${current_ue_setting}    ue    ${current_ue_id}
        Set To Dictionary                       ${current_ue_setting}    trf_id    1
        Set To Dictionary                       ${current_ue_setting}    pdu    1
        Set To Dictionary                       ${current_ue_setting}    target_gnb    ${param.target_gnb}

        # Dispatching the ue on the requested original cell for the call establishment
        Set To Dictionary                       ${current_ue_setting}    target_cells    ${dict_ues[${current_id}].original_cell}
        # Set the correct requested throughput per ue
        Set To Dictionary                       ${current_ue_setting}    throughput    ${dict_ues[${current_id}].throughput}
        Set To Dictionary                       ${current_ue_setting}    throughput_gbr    ${dict_ues[${current_id}].throughput_gbr}
        Set To Dictionary                       ${current_ue_setting}    throughput_ul    ${dict_ues[${current_id}].throughput_ul}
        Append To List                          ${list_ue}    ${current_ue_setting}
    END
    Dated Log New Line                          ===> ue's list is ${list_ue}
    Check Multi Ues Setting In List             list_multi_ue=${list_ue}
    Traced Sleep                                duration=15s    msg=Wtsemu system start-up to give radio modules time to start up

    # Start SYSLOG capture during call setup
    ${syslog}=                                  SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_call_setup

    # Capture TTI traces during call setup
    ##Start TTI Logs

    # Capture L1L2 traces during call setup
    Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Step    Captures Init
    ...    AND                                  Capture Start    capture=${capture_l1l2}

    # Setup wtsemu SA for all the ue's
    Critical Step                               CallSetup.Setup Wtsemu SA    nbUe=${param.total_nb_ue}
    ...                                                             nbSaUe=${param.total_nb_ue}
    ...                                                             shouldUseLua=${False}
    ###...                                                          nb_cell=${param.total_nb_cell}
    ...                                                             list_of_UE_tobe_created=${list_ue}

    # Capture TTI traces during call setup
    Start TTI Logs

    # WA to avoid degradation on cells
    Traced Sleep                                duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    Step                                        CallSetup.WTS Set X2 Link

    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                                    CallSetup.UE Register    ue=${current_elem.ue}
        ...                                     depends=CallSetup.Setup Wtsemu SA
        Step                                    CallSetup.Launch PDU Session    ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         gw=${current_elem.ue}
        ...                                     depends=CallSetup.UE Register
    END

    ${capture_l1l2_output}=                     Set Variable    ${LOG_PATH}/L1L2.${test_name}_call_setup.pcap
    Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Step    Capture Stop    capture=${capture_l1l2}
    ...    AND                                  Dated Log    capture l1l2 input= ${capture_l1l2.path}
    ...    AND                                  Dated Log    capture l1l2 output= ${capture_l1l2_output}
    ...    AND                                  Run    command=mv ${capture_l1l2.path} ${capture_l1l2_output}

    Step                                        Stop and Get TTI Logs    trace_name=TTI.${test_name}_call_setup
    Step                                        SYSLOG Stop    syslog=${syslog}

    # Generation of multiples L1L2, TTI captures (without analysis in loop), check counter and KPI constraints
    FOR    ${iteration_pm}    IN RANGE    1    ${param.pm_waiting_period} + 1
        # Capture SYSLOG traces during switch to power saving BWP
        ${syslog}=                              SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_loop-${iteration_pm}
        # Start the non GBR traffic upper than thresholds for all the ue's when requested
        Critical Step                           Start Low Traffic For Ues    param=${param}    list_ue=${list_ue}    unit=mbps
        ...                                                         bwp_transition=from bwpId 2 to 1
        Traced Sleep    duration=1s    msg=call with traffic upper than thresholds for NOT triggering power saving then to activate dedicated
        Wait PM availability    pmPeriodSec=300    #Sleep Until PM Availability

        Dated Log New Line    ===> Loop_${iteration_pm}: L1L2 + TTI + check counters and KPI constraints during traffic

        ${list_ue[0].throughput}=         Set Variable    100
        ${list_ue[1].throughput}=         Set Variable    100
        Critical Step                           Start Low Traffic For Ues    param=${param}    list_ue=${list_ue}    unit=kbps
        ...                                                         bwp_transition=from bwpId 1 to 2
        Traced Sleep    duration=8s    msg=call with traffic lower than thresholds for triggering power saving
        Step                                    SYSLOG Stop    syslog=${syslog}

        # Capture L1L2 traces during traffic for verification
        ${capture_l1l2_output}=                 Set Variable    ${LOG_PATH}/L1L2.${test_name}_loop-${iteration_pm}.pcap
        Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Capture Start    capture=${capture_l1l2}
        ...    AND                              Traced Sleep    duration=8s    msg=call with traffic lower than thresholds for L1L2 trace
        ...    AND    Step                      Capture Stop    capture=${capture_l1l2}
        ...    AND                              Dated Log    capture l1l2 input= ${capture_l1l2.path}
        ...    AND                              Dated Log    capture l1l2 output= ${capture_l1l2_output}
        ...    AND                              Run    command=mv ${capture_l1l2.path} ${capture_l1l2_output}

        # Capture TTI traces during traffic for verification
        Start TTI Logs
        Traced Sleep    duration=8s    msg=call with traffic lower than thresholds for TTI trace
        Step                                    Stop and Get TTI Logs    trace_name=TTI.${test_name}_loop-${iteration_pm}

        # Capture PM counters during traffic for constraints and KPI's verification
        Wait PM availability    pmPeriodSec=300    #Sleep Until PM Availability
        ${pm_path}=                             Counters.Collect PM files from BTS    ${LOG_PATH}/PM
        Step                                    Check Counter And KPI Constraints    ${pm_path}
        ...                                                         ${test_name}
        ...                                                         localKpiFileName=CB009915_KPI_Definitions.csv
    END

    # Deregister all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                                    CallSetup.UE Deregister    id=${current_elem.ue}
        ...                                                         ue_deregister_type=switch_off
        ...                                                         by=ue
        ...                                     depends=CallSetup.UE Register
    END

    # Post-processing and traces analysis
    ${list_l1l2_messages_filters}=              CB009915 Create Filter Message List
    FOR    ${iteration_pm}    IN RANGE    1    ${param.pm_waiting_period} + 1
        Dated Log New Line    ===> Loop_${iteration_pm}: post-processing and analysis
        ${capture_l1l2_output}=                 Set Variable    ${LOG_PATH}/L1L2.${test_name}_loop-${iteration_pm}.pcap
        Step                                    CB009915_B2 Post Processing and Analysis within L1L2    capture_input=${capture_l1l2_output}
        ...                                                         config_blanking=${config_blanking}
        ...                                                         is_capture=${is_capture.is_capture_l1l2}
        ...                                                         subcellid_C1=0
        ...                                                         subcellid_C2=1
        ...                                                         coresetFreqDomain_C1=${coresetFreqDomain_9915_B2_5_C1}
        ...                                                         coresetFreqDomain_C2=${coresetFreqDomain_9915_B2_5_C2}
        ...                                                         coresetFreqDomain_0xFFFF=${coresetFreqDomain_9915_B2_5_0xFFFF}
        ...                                                         total_prb=${NUM_MAX_PRB_DEFAULT}
        ...                                                         rbgsize=16
        ...                                                         is_large_bwp=${False}
        ...                                                         total_prb_bwp2=${NUM_MAX_PRB_BWP_40MHZ}
        ...                                                         prb_reserved_C1=36    # NRCELL.pdcchAutoConfig.pucchSize <=> numOfNrPucchPrbs
        ...                                                         prb_reserved_C2=32
        ...                                                         is_nb_prb_max_triggered=${False}

        ${capture_tti_output}=                  Set Variable    ${LOG_PATH}/TTITraces/TTI.${test_name}_loop-${iteration_pm}.json
        Step                                    CB009915_B2 Post Processing and Analysis within TTI    capture_input=${capture_tti_output}
    END

    [Teardown]      Display diagnosis


CB009915_B2_4_IWK_multi_dedicated_BWP_SA
    [Documentation]
    ...     Conditions:     it is based on the arguments ${config_blanking} ${dict_ues} ${is_capture} ${param} ${test_name}
    ...     Actions:        it performs the call setup for multi-ues with traffic on different cells
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues with traffic and PRB blanking are passed
    [Arguments]             ${config_blanking}
    ...                     ${dict_ues}
    ...                     ${is_capture}
    ...                     ${param}
    ...                     ${test_name}

    Init Sequence                               ${param}
    Dated Log New Line                          ===> test name is ${test_name}
    Run Keyword If    ${SUITE_DEBUG_MODE}       Set Debug Mode
    Step                                        Set RAD Parameters for CB009915    rad_0x58057a_val=4    rad_0x58057c_val=0x10000
    Run Keyword If    ${param.act_blanking} == ${True}    Dated Log New Line    ===> blanking variable is enabled
    ...         ELSE                            Dated Log New Line    ===> BLANKING VARIABLE is disabled

    Critical Step                               Restart TL

    # Configure new ue's dynamically
    ${initial_nb_ue}=                           get length    ${dict_ues}
    Run Keyword If    ${initial_nb_ue} < ${param.total_nb_ue}    Configure New Ues    ${dict_ues}
    ...                                                             ${initial_nb_ue}
    ...                                                             ${param.total_nb_ue}
    ...                                                             ${dict_settings_ue_default}
    # Configure the current setting for all the ue's
    ${param.total_nb_ue}=                       get length    ${dict_ues}
    Dated Log New Line                          ===> configure the setting for all the ${param.total_nb_ue} ue's
    @{list_ue}=                                 Create List
    FOR    ${current_id}    IN RANGE    0    ${param.total_nb_ue}
        ${current_ue}=                          Evaluate            ${current_id} + 1
        ${current_ue_setting}=                  Copy Dictionary     ${BASIC_UE_SA}
        ${current_ue_id}=                       Evaluate            ${current_ue} + 0    #id for a sa ue starts at 1 into basic_setup.cfg#
        Set To Dictionary                       ${current_ue_setting}    ue    ${current_ue_id}
        Set To Dictionary                       ${current_ue_setting}    trf_id    1
        Set To Dictionary                       ${current_ue_setting}    pdu    1
        Set To Dictionary                       ${current_ue_setting}    target_gnb    ${param.target_gnb}

        # Dispatching the ue on the requested original cell for the call establishment
        Set To Dictionary                       ${current_ue_setting}    target_cells    ${dict_ues[${current_id}].original_cell}
        # Set the correct requested throughput per ue
        Set To Dictionary                       ${current_ue_setting}    throughput    ${dict_ues[${current_id}].throughput}
        Set To Dictionary                       ${current_ue_setting}    throughput_gbr    ${dict_ues[${current_id}].throughput_gbr}
        Set To Dictionary                       ${current_ue_setting}    throughput_ul    ${dict_ues[${current_id}].throughput_ul}
        Append To List                          ${list_ue}    ${current_ue_setting}
    END
    Dated Log New Line                          ===> ue's list is ${list_ue}
    Check Multi Ues Setting In List             list_multi_ue=${list_ue}
    Traced Sleep                                duration=15s    msg=Wtsemu system start-up to give radio modules time to start up

    # Start SYSLOG capture during call setup
    ${syslog}=                                  SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_call_setup

    # Capture TTI traces during call setup
    Start TTI Logs

    # Capture L1L2 traces during call setup
    Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Step    Captures Init
    ...    AND                                  Capture Start    capture=${capture_l1l2}

    # Setup wtsemu SA for all the ue's
    Critical Step                               CallSetup.Setup Wtsemu SA    nbUe=${param.total_nb_ue}
    ...                                                             nbSaUe=${param.total_nb_ue}
    ...                                                             shouldUseLua=${False}
    ...                                                             list_of_UE_tobe_created=${list_ue}
    # WA to avoid degradation on cells
    Traced Sleep                                duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    Step                                        CallSetup.WTS Set X2 Link

    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                                    CallSetup.UE Register    ue=${current_elem.ue}
        ...                                     depends=CallSetup.Setup Wtsemu SA
        Step                                    CallSetup.Launch PDU Session    ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         gw=${current_elem.ue}
        ...                                     depends=CallSetup.UE Register
    END

    ${capture_l1l2_output}=                     Set Variable    ${LOG_PATH}/L1L2.${test_name}_call_setup.pcap
    Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Step    Capture Stop    capture=${capture_l1l2}
    ...    AND                                  Dated Log    capture l1l2 input= ${capture_l1l2.path}
    ...    AND                                  Dated Log    capture l1l2 output= ${capture_l1l2_output}
    ...    AND                                  Run    command=mv ${capture_l1l2.path} ${capture_l1l2_output}

    Step                                        Stop and Get TTI Logs    trace_name=TTI.${test_name}_call_setup
    Step                                        SYSLOG Stop    syslog=${syslog}

    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY}
        ...    Step                             ${param.dir} Traffic Not Stopped    param=${param}    current_ue_setting=${current_elem}
        ...                                     depends=CallSetup.Launch PDU Session
    END

    # Generation of multiples L1L2, TTI captures (without analysis in loop), check counter and KPI constraints
    FOR    ${iteration_pm}    IN RANGE    1    ${param.pm_waiting_period} + 1
        Sleep Until PM Availability

        Dated Log New Line    ===> Loop_${iteration_pm}: L1L2 + TTI + check counters and KPI constraints during traffic

        # Capture SYSLOG traces during traffic on dedicated bwp's
        ${syslog}=                              SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_loop-${iteration_pm}

        # Capture L1L2 traces during traffic for verification
        ${capture_l1l2_output}=                 Set Variable    ${LOG_PATH}/L1L2.${test_name}_loop-${iteration_pm}.pcap
        Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Capture Start    capture=${capture_l1l2}
        ...    AND                              Traced Sleep    duration=8s    msg=call with traffic for L1L2 trace
        ...    AND    Step                      Capture Stop    capture=${capture_l1l2}
        ...    AND                              Dated Log    capture l1l2 input= ${capture_l1l2.path}
        ...    AND                              Dated Log    capture l1l2 output= ${capture_l1l2_output}
        ...    AND                              Run    command=mv ${capture_l1l2.path} ${capture_l1l2_output}

        # Capture TTI traces during traffic for verification
        Start TTI Logs
        Traced Sleep    duration=8s    msg=call with traffic for TTI trace
        Step                                    Stop and Get TTI Logs    trace_name=TTI.${test_name}_loop-${iteration_pm}

        Step                                    SYSLOG Stop    syslog=${syslog}

        # Capture PM counters during traffic for constraints and KPI's verification
        Sleep Until PM Availability
        ${pm_path}=                             Counters.Collect PM files from BTS    ${LOG_PATH}/PM
        Step                                    Check Counter And KPI Constraints    ${pm_path}
        ...                                                         ${test_name}
        ...                                                         localKpiFileName=CB009915_KPI_Definitions.csv
    END

    # Deregister all the ue's
    FOR    ${current_elem}    IN    @{list_ue}
        Step                                    CallSetup.UE Deregister    id=${current_elem.ue}
        ...                                                         ue_deregister_type=switch_off
        ...                                                         by=ue
        ...                                     depends=CallSetup.UE Register
    END

    # Post-processing and traces analysis
    FOR    ${iteration_pm}    IN RANGE    1    ${param.pm_waiting_period} + 1

        Dated Log New Line    ===> Loop_${iteration_pm}: post-processing and analysis

        ${list_l1l2_messages_filters}=          CB009915 Create Filter Message List
        ${capture_l1l2_output}=                 Set Variable    ${LOG_PATH}/L1L2.${test_name}_loop-${iteration_pm}.pcap
        Run Keyword If    ${is_capture.is_capture_l1l2}    Run Keywords    Step    CB009915 Analyze pcap and pdml
        ...                                                             pcap_file=${capture_l1l2_output}
        ...                                                             list_message_filter=${list_l1l2_messages_filters}
        # check for small and large dedicated BWP's then goal is only to verify that blanking PRB's are not used
        # dlData pdcchSendReq
        ...    AND    Step                      Check dlData pdcchSendReq coresetFreqDomain
        ...                                     pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdcchsendreq}].pdml_file_result}
        ...                                                         field_values=${dlData_pdcchSendReq_coresetFreqDomain_check_9915_B1}
        ...                                                         subcellid=0
        ...                                                         packet_end=128    #-1
        ...                                                         coresetFreqDomain=${coresetFreqDomain_9915_B2_4_C1}
        ...                                                         coresetFreqDomain_0xFFFF=${coresetFreqDomain_9915_B2_4_0xFFFF}
        ...    AND    Step                      Check dlData pdcchSendReq coresetFreqDomain
        ...                                     pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdcchsendreq}].pdml_file_result}
        ...                                                         field_values=${dlData_pdcchSendReq_coresetFreqDomain_check_9915_B1}
        ...                                                         subcellid=1
        ...                                                         packet_end=128    #-1
        ...                                                         coresetFreqDomain=${coresetFreqDomain_9915_B2_4_C1}
        ...                                                         coresetFreqDomain_0xFFFF=${coresetFreqDomain_9915_B2_4_0xFFFF}
        # dlData pdschSendReq
        ...    AND    Step                      Check dlData pdschSendReq
        ...                                     pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschsendreq}].pdml_file_result}
        ...                                                         field_values=${dlData_pdschSendReq_check_9915_B1}
        ...                                                         subcellid=0
        ...                                                         packet_end=512    #-1
        ...                                                         nb_prb_blanking_low=${config_blanking.nbBlankedPRBsLowEdge}[0]
        ...                                                         nb_prb_blanking_high=${config_blanking.nbBlankedPRBsHighEdge}[0]
        ...                                                         total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
        ...                                                         rbgsize=16
        ...    AND    Step                      Check dlData pdschSendReq
        ...                                     pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschsendreq}].pdml_file_result}
        ...                                                         field_values=${dlData_pdschSendReq_check_9915_B1}
        ...                                                         subcellid=1
        ...                                                         packet_end=512    #-1
        ...                                                         nb_prb_blanking_low=${config_blanking.nbBlankedPRBsLowEdge}[1]
        ...                                                         nb_prb_blanking_high=${config_blanking.nbBlankedPRBsHighEdge}[1]
        ...                                                         total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
        ...                                                         rbgsize=16
        # ulData pucchReceiveReq
        ...    AND    Step                      Check ulData pucchReceiveReq
        ...                                     pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_pucchreceivereq}].pdml_file_result}
        ...                                                         field_values=${ulData_pucchReceiveReq_check_9915_B1}
        ...                                                         subcellid=0
        ...                                                         packet_end=128    #-1
        ...                                                         nb_prb_blanking_low=${config_blanking.nbBlankedPRBsLowEdge}[0]
        ...                                                         nb_prb_blanking_high=${config_blanking.nbBlankedPRBsHighEdge}[0]
        ...                                                         total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
        ...    AND    Step                      Check ulData pucchReceiveReq
        ...                                     pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_pucchreceivereq}].pdml_file_result}
        ...                                                         field_values=${ulData_pucchReceiveReq_check_9915_B1}
        ...                                                         subcellid=1
        ...                                                         packet_end=128    #-1
        ...                                                         nb_prb_blanking_low=${config_blanking.nbBlankedPRBsLowEdge}[1]
        ...                                                         nb_prb_blanking_high=${config_blanking.nbBlankedPRBsHighEdge}[1]
        ...                                                         total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
        # ulData puschReceiveReq
        ...    AND    Step                      Check ulData puschReceiveReq
        ...                                     pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_puschreceivereq}].pdml_file_result}
        ...                                                         field_values=${ulData_puschReceiveReq_check_9915_B1}
        ...                                                         subcellid=0
        ...                                                         packet_end=-1
        ...                                                         nb_prb_blanking_low=${config_blanking.nbBlankedPRBsLowEdge}[0]
        ...                                                         nb_prb_blanking_high=${config_blanking.nbBlankedPRBsHighEdge}[0]
        ...                                                         total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
        ...                                                         prb_reserved=36    # NRCELL.pdcchAutoConfig.pucchSize <=> numOfNrPucchPrbs
        ...                                                         is_nb_prb_max_triggered=${False}
        ...    AND    Step                      Check ulData puschReceiveReq
        ...                                     pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_puschreceivereq}].pdml_file_result}
        ...                                                         field_values=${ulData_puschReceiveReq_check_9915_B1}
        ...                                                         subcellid=1
        ...                                                         packet_end=-1
        ...                                                         nb_prb_blanking_low=${config_blanking.nbBlankedPRBsLowEdge}[1]
        ...                                                         nb_prb_blanking_high=${config_blanking.nbBlankedPRBsHighEdge}[1]
        ...                                                         total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
        ...                                                         prb_reserved=36    # NRCELL.pdcchAutoConfig.pucchSize <=> numOfNrPucchPrbs
        ...                                                         is_nb_prb_max_triggered=${False}
        # ulData srsReceiveReq
        ...    AND    Step                      Check ulData srsReceiveReq
        ...                                     pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_srsreceivereq}].pdml_file_result}
        ...                                                         field_values=${ulData_srsReceiveReq_check_9915_B1}
        ...                                                         subcellid=0
        ...                                                         packet_end=128    #-1
        ...                                                         nb_prb_blanking_low=${config_blanking.nbBlankedPRBsLowEdge}[0]
        ...                                                         nb_prb_blanking_high=${config_blanking.nbBlankedPRBsHighEdge}[0]
        ...                                                         total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
        ...    AND    Step                      Check ulData srsReceiveReq
        ...                                     pdml_file=${list_l1l2_messages_filters[${pos_filter_uldata_srsreceivereq}].pdml_file_result}
        ...                                                         field_values=${ulData_srsReceiveReq_check_9915_B1}
        ...                                                         subcellid=1
        ...                                                         packet_end=128    #-1
        ...                                                         nb_prb_blanking_low=${config_blanking.nbBlankedPRBsLowEdge}[1]
        ...                                                         nb_prb_blanking_high=${config_blanking.nbBlankedPRBsHighEdge}[1]
        ...                                                         total_prb=${NUM_MAX_PRB_DEFAULT}    #273#
    END

    [Teardown]      Display diagnosis
