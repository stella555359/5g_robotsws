    ...                                                             nb_prb_blanking_low=${config_blanking.nbBlankedPRBsLowEdge}[1]
    ...                                                             nb_prb_blanking_high=${config_blanking.nbBlankedPRBsHighEdge}[1]
    ...                                                             total_prb=${total_prb}
