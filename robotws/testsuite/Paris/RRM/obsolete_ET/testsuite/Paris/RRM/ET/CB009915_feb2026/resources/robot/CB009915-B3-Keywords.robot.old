&{dlData_csiRsSendReq_check_9915_A}             subcellid=0    sfn=0    slot=0    rnti=0    startPrb=0    numOfPrb=0    trsInfo=0

# coresetDomainFreq definition for nrcell 1 - PCell:
# 9223363240761753600 => 7FFF F800 0000 0000 => 0111 1111 1111 1111 1111 1000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000
# 20 bits are set to 1 (20* 6 PRBs) then 120 PRBs are used for coreset and, 120 is the size defined for the coresetDedicated of this cell
${coresetFreqDomain_9915_B3_PCell}                9223363240761753600

# coresetDomainFreq definition for nrcell 1 - PCell:
# 9223363240761753600 => 7FFF F800 0000 0000 => 0111 1111 1111 1111 1111 1000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000
# 20 bits are set to 1 (20* 6 PRBs) then 120 PRBs are used for coreset and, 120 is the size defined for the coresetDedicated of this cell
${coresetFreqDomain_9915_B3_SCell}                18446726481523507200

&{dlData_pdcchSendReq_coresetFreqDomain_check_9915_A_6_C1}    subcellid=0    sfn=0    slot=0    rnti=0    startCce=0    coresetFreqDomain=0

&{dlData_pdschSendReq_check_9915_A}             subcellid=0    sfn=0    slot=0    rnti=0    startPrb=0    numOfPrb=0    rbgSize=0    rbgSizeFirst=0
...                                             mcs=0    numOfLayers=0

&{ulData_prachReceiveReq_check_9915_A}          subcellid=0    sfn=0    slot=0    rnti=0    prachPrbOffset=0


&{ulData_puschReceiveReq_check_9915_A}          subcellid=0    sfn=0    slot=0    rnti=0    startPrb=0    numOfPrb=0    mcs=0    numOfLayers=0
...                                             pairedUe=0



