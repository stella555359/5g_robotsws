def calculate_average_of_list_in_file(file_name):
    data_sum = 0
    none_zero_cnt = 0
    with open(file_name, 'r') as f_p:
        for each_line in f_p:
            line_data = each_line.rstrip()
            #  Pipeline modif requested : testsuite/RRM/ECE/DSS/5GC002535/resources/python/tools.py:53:26:
            #  W605 invalid escape sequence 'antislash d'
            if re.match("\\d+", line_data):
                new_data = int(each_line.rstrip())
                if new_data != 0:
                    none_zero_cnt += 1
                    data_sum += new_data
    if none_zero_cnt == 0:
        return none_zero_cnt
    return data_sum/none_zero_cnt


def Calculate_UL_throughoutput_old(alias, location=14, size=2000, cellid='', sleep_time=5):
    ssh.send_command('journalctl -f | grep --line-buffered rlcPdus | grep "{}"'.format(cellid),
                     connection=alias, timeout=60)
    time.sleep(sleep_time)
    output = ssh.read_output(size=size, connection=alias).split('\r\n')
    ul_output = output[0].split('\n')
    ul_output.pop()
    num = 0
    sum = 0
    for element in ul_output:
        data = element.split(' ')[location]
        traffic_data = data.split('(')[-1]
        num += 1
        sum += int(traffic_data)
        logger.info(
            "Traffic data {} bytes received from UE".format(traffic_data))
    UL_Throughoutput = round(
        float(8 * Decimal(sum) / Decimal(num) / 1048576), 3)
    logger.info("UL_Throughoutput is {}".format(UL_Throughoutput))
    return UL_Throughoutput


def Calculate_UL_throughput(alias, file_name, location=9, size=20000, cellid='', sleep_time=5):
    # ssh.send_command('grep --line-buffered rlcPduBytes /tmp/ASP-124A_startup.log | grep "{}"'.format(cellid),
    #                 connection=alias, timeout=60)
    ssh.send_command('grep --line-buffered rlcPduBytes "{}" | grep "{}"'.format(file_name, cellid),
                     connection=alias, timeout=60)
    time.sleep(sleep_time)
    output = ssh.read_output(size=size, connection=alias).split('\r\n')
    ul_output = output[0].split('\n')
    # logger.info("Traffic data 1  {} bytes received from UE".format(output))
    ul_output.pop()
    num = 0
    sum = 0
    output.pop()
    # logger.info("Traffic data 2 {} bytes received from UE".format(ul_output))
    for element in output:
        data = element.split(' ')[location]
        traffic_data = data.split('(')[-1]
        if int(traffic_data) > 0:
            num += 1
            sum += int(traffic_data)
            # logger.info("Traffic data 3 {} bytes received from UE".format(traffic_data))
    logger.info("Traffic data sum {} bytes received from UE".format(sum))
    logger.info("Traffic num data {} received from UE".format(num))
    UL_Throughoutput = round(
        float(8 * Decimal(sum) / Decimal(num) / 1000000), 3)
    logger.info("UL_Throughput(Mbps) is {}".format(UL_Throughoutput))
    return UL_Throughoutput


def Calculate_DL_throughput(alias, file_name, location=11, size=20000, cellid=''):
    ssh.send_command('grep --line-buffered -i SentDataMeasurementCounting "{}" | grep DataPdu | grep "{}"'
                     .format(file_name, cellid), connection=alias, timeout=60)
    time.sleep(5)
    output = ssh.read_output(size=size, connection=alias).split('\r\n')
    dl_output = output[0].split('\n')
    dl_output.pop()
    num = 0
    sum = 0
    output.pop()
    for element in output:
        data = element.split(' ')[location]
        # traffic_data = data.split('|')[-1].split(']')[0]
        traffic_data = data.split('|')[0]
        if int(traffic_data) > 0:
            num += 1
            sum += int(traffic_data)
            logger.info(
                "Traffic data {} bytes sent to UE".format(traffic_data))
    logger.info("Traffic data sum {} bytes sent to UE".format(sum))
    logger.info("Traffic num data {} sent to UE".format(num))
    DL_Throughoutput = round(
        float(8 * Decimal(sum) / Decimal(num) / 1024000), 3)
    logger.info("DL_Throughput(Mbps) is {}".format(DL_Throughoutput))
    return DL_Throughoutput


def Calculate_DL_throughoutput_old(alias, location=17, size=3000, cellid=''):
    ssh.send_command(r'journalctl -f | grep --line-buffered -i SentDataMeasurementCounting | grep "{}"'.format(cellid),
                     connection=alias, timeout=60)
    time.sleep(5)
    output = ssh.read_output(size=size, connection=alias).split('\r\n')
    dl_output = output[0].split('\n')
    dl_output.pop()
    num = 0
    sum = 0
    for element in dl_output:
        data = element.split(' ')[location]
        traffic_data = data.split('|')[-1].split(']')[0]
        num += 1
        sum += int(traffic_data)
        logger.info("Traffic data {} bytes sent to UE".format(traffic_data))
    DL_Throughoutput = round(
        float(8 * Decimal(sum) / Decimal(num) / 1048576), 3)
    logger.info("DL_Throughoutput is {}".format(DL_Throughoutput))
    return DL_Throughoutput


def Calculate_DL_throughput2(alias, file_name, size=50000, cellid=''):
    ssh.send_command('grep --line-buffered -a -i DataPdu "{}" | grep -a "{}"'.format(file_name, cellid),
                     connection=alias, timeout=60)
    time.sleep(5)
    output = ssh.read_output(size=size, connection=alias).split('\r\n')
    dl_output = output[0].split('\n')
    dl_output.pop()
    num = 0
    sum = 0
    output.pop()
    return _get_throughput_result(output, "dl")


def Calculate_UL_throughput2(alias, file_name, size=50000, cellid=''):
    ssh.send_command('grep --line-buffered -a -i rlcPdus "{}" | grep -a "{}"'.format(file_name, cellid),
                     connection=alias, timeout=60)
    time.sleep(5)
    output = ssh.read_output(size=size, connection=alias).split('\r\n')
    dl_output = output[0].split('\n')
    dl_output.pop()
    num = 0
    sum = 0
    output.pop()
    return _get_throughput_result(output, "ul")


def _get_throughput_result(output, direct):
    # l2_putput = output.split('\n')
    # l2_putput.pop()
    num = 0
    sum = 0
    for i, element in enumerate(output):
        if i == 0:
            continue
        data = element.split(' ')
        for i, content in enumerate(data):
            if direct == "dl":
                if content.count('DataPdu') > 0:
                    traffic_data = data[i+1].split('|')[-1].split(']')[0]
                    break
            elif direct == "ul":
                if content.count('rlcPduBytes') > 0:
                    traffic_data = data[i-1].split('(')[-1]
            else:
                traffic_data = 0
        if int(traffic_data) > 0:
            num += 1
            sum += int(traffic_data)
        # logger.info("Traffic data {} bytes received from UE".format(traffic_data))
    if num == 0:
        num += 1
    throughoutput = round((8 * Decimal(sum) / Decimal(num) / 1048000), 3)
    logger.info("throughput {} is {}".format(direct, throughoutput))
    return throughoutput

    # ${sw_version}=       pcap.Get Software Version


def get_root_path():
    """
    computing root path where to deploy Luashark
    Strategy is :
        if /home/<user> exists, it will be root path
        otherwise, retrieve TEMP_PATH robot variable as root path
    """
    root = "/home/{}".format(linux.get_user())
    if os.path.isdir(root):
        return root
    output_dir = BuiltIn().get_variable_value("${TEMP_PATH}")
    assert output_dir is not None, \
        "${TEMP_PATH} robot variable was not set in robot context"
    return output_dir


def reform_coam_sw_version(version):
    """reform SW Version from COAM GNB to QC required form:
    from 5G19_FSMK_0000_018351_001507 to 5G_0.18351.1507
    from 5G19B_FDD_GNB_0008_001840_000327 to 5G19B_0.1840.327
    from SBTS21B_ENB_0000_210310_000024 to SBTS21B_ENB_0000_210310_000024
    from SBTS21B_ENB_9999_210310_000024 to SBTS00_ENB_9999_210310_000024
    from vDUCNF22R2_0.300.3624 to vDUCNF22R2_0_300_3624"""
    version = version.replace(".", "_")
    subversions = version.split('_')
    if version.startswith('5G'):
        version = strip_version(subversions[-3:])
        if version[0] == '0':
            result = '_'.join(['5G', version])
        else:
            result = '_'.join([subversions[0], version])
    elif version.startswith('SBTS'):
        if subversions[2].startswith('9'):
            subversions[0] = 'SBTS00'
        result = '_'.join(subversions)
    elif version.startswith('vDU'):
        if subversions[2].startswith('9'):
            subversions[0] = 'SBTS00'
        result = '_'.join(subversions)
    return result


def strip_version(version):
    """remove 0 from sw version"""
    for i in range(len(version)):
        if version[i].lstrip('0') == '':
            version[i] = '0'
        else:
            version[i] = version[i].lstrip('0')
    return '.'.join(version)


def install_multidynamic_if_needed_to_remove():
    # Author : Nikolay Shkulepov
    # -------------------------------------------------------------------------------------------------[120 characters]
    # Private Keyword: Install Multidynamic if neeeded
    # It helps to check whether MULTI is installed and install it if not
    # -------------------------------------------------------------------------------------------------[120 characters]
    try:
        import multi
    except ImportError:
        try:
            if os.getenv("VIRTUAL_ENV"):
                pip_path = os.path.join(os.getenv("VIRTUAL_ENV"), "bin", "pip")
            else:
                pip_path = "pip"
            cmdStr = "sudo mkdir /opt/tti_dissectors ; sudo chmod 777 /opt/tti_dissectors ; cd /opt/tti_dissectors"
            rbi.log("install_multidynamic_if_neeeded(): cmdStr = %s" % cmdStr, "TRACE")
            os.system(cmdStr)
            # swVersion = rbi.run_keyword("Get gNB SW version").split("_")[1]
            # swVersion = rbi.run_keyword("Get Software Version")
            swVersion = rbi.run_keyword("Get gNB Software Version")
            rbi.log("install_multidynamic_if_neeeded(): swVersion = %s" % swVersion, "TRACE")
            os.chdir("/opt/tti_dissectors")
            if swVersion.startswith("SBTS"):
                swVersionSBTS = rbi.run_keyword("Get gNB Software Version")
                cmdStr1 = "wget https://lterel.es-si-s3-z2.eecloud.nsn-net.net/build/SBTS00/"
                cmdStr2 = "%s_tti-dissectors.zip" % swVersionSBTS
                zipFileName = "%s_tti-dissectors.zip" % swVersionSBTS
            else:
                swVersion = rbi.run_keyword("Get gNB Software Version").split("_")[1]
                cmdStr1 = "wget https://artifactory-espoo1.ext.net.nokia.com/artifactory/mnp5g-central-public-local/"
                cmdStr2 = "System_Release/%s/tti-dissectors-%s.zip" % (swVersion, swVersion)
                zipFileName = "tti-dissectors-%s.zip" % swVersion
            cmdStr = cmdStr1 + cmdStr2
            rbi.log("install_multidynamic_if_neeeded(): cmdStr = %s" % cmdStr, "TRACE")
            os.system(cmdStr)
            cmdStr1 = "unzip -n %s ; " % zipFileName
            cmdStr2 = "chmod 777 * ; " + pip_path + " install --no-index -f . multidynamic.zip"
            cmdStr = cmdStr1 + cmdStr2
            rbi.log("install_multidynamic_if_neeeded(): cmdStr = %s" % cmdStr, "TRACE")
            os.system(cmdStr)
        except Exception as e:
            rbi.log("install_multidynamic_if_neeeded(): Exception = <%s>" % str(e))


def logException(functionNameStr, e, silent=False):
    rbi.log("%s(): Exception = <%s>" % (functionNameStr, str(e)), "TRACE")
    if not silent:
        rbi.log_to_console(
            "  %s: exception happened (see log.html)" % functionNameStr)


def decode_tti_traces_to_remove(inputStr="", event_nr_max=1000):
    # ------------------------------------------------------------------------------------------------[120 characters]
    rbi.log_to_console("TTI Trace decoding .", no_newline=True)
    resultDir = rbi.run_keyword("5GC002535_Keywords.Get Testcase Log Directory")
    pcapPathName = resultDir + "/ttitrace_streaming.pcap"
    rbi.log("decode_tti_traces_in_streaming_mode(): pcapPathName = %s" % pcapPathName)
    udpPathName = pcapPathName.replace(".pcap", ".udp")
    if os.path.exists(pcapPathName) and os.path.getsize(pcapPathName) > 24:
        try:
            rbi.log_to_console(".1.", no_newline=True)
            cmdStr1 = "tshark -r %s --disable-protocol swe --disable-protocol syscom -T fields -e data" % pcapPathName
            cmdStr2 = " | perl -0ne's/\\n//g;print pack\"H*\",$_' > %s" % udpPathName
            cmdStr = cmdStr1 + cmdStr2
            rbi.log("decode_tti_traces_in_streaming_mode(): cmdStr = %s" % cmdStr)
            stdoutStr = os.system(cmdStr)
            rbi.log("decode_tti_traces_in_streaming_mode(): stdoutStr = %s" % stdoutStr)
            rbi.log_to_console(".2.", no_newline=True)
        except Exception as e:
            logException("decode_tti_traces_in_streaming_mode [1]", e)
            rbi.log_to_console(".ERROR")
            return
    rbi.log("decode_tti_traces_in_streaming_mode(): udpPathName = %s" % udpPathName)
    if os.path.exists(udpPathName) and os.path.getsize(udpPathName) > 24:
        try:
            # os.system("rm %s >/dev/null 2>&1" % pcapPathName)
            rbi.log_to_console(".3.", no_newline=True)
            file_name = udpPathName
            msgFile_all = open(resultDir + "/msg_all.csv", "w")
            with open(file_name, 'rb') as file_obj:
                startTime = int(time.time())
                msgFile_all.write("-;" * 10 + "\n")
                for i, event in enumerate(TtitraceReader(file_obj=file_obj)):
                    if i > event_nr_max:
                        break
                    if event.type != "ttiStartInd":
                        outStr = str(event.type) + ";" + repr(event.data) + "\n"
                        outStr = outStr.replace("{", "").replace("}", "").replace(" ", "")
                        outStr = outStr.replace("[", "").replace("]", "").replace("'", "")
                        outStr = outStr.replace(":", ";").replace(",", ";")
                        msgFile_all.write(outStr)
            msgFile_all.close()
            rbi.log_to_console(".4.", no_newline=True)
            os.system("zip -mj %s/ttiTrace_stream_udp.zip %s >/dev/null 2>&1" % (resultDir, udpPathName))
        except Exception as e:
            logException("decode_tti_traces_in_streaming_mode [2]", e)
            rbi.log_to_console(".ERROR")
            return
    rbi.log_to_console(".done")


def verify_5GC002535_UL_MCS_NbrPrb_old(resultDir):
    # TTITraces Events: dlFdSchedData + csiSrReportData
    filePathName = resultDir + "/msg_all.csv"
    BuiltIn().log("verify_qc_test_case(5GC002535): filePathName = %s" %
                  filePathName, logLevel)
    mcsList = []
    numOfPrbList = []
    averageMcs = 0
    gradiantMcs = 0
    averageNbrPrb = 0
    gradiantNbrPrb = 0
    tcResult = "failed"
    try:
        if os.path.isfile(filePathName):
            BuiltIn().log("verify_qc_test_case(5GC002535): file OK = %s " % (filePathName))
            with open(filePathName, "r") as csvFile:
                lineNumber = 0
                BuiltIn().log("verify_qc_test_case(5GC002535): open file OK = %s " % (filePathName))
                for line in csvFile:
                    # BuiltIn().log("verify_qc_test_case(5GC002535): line content = %s " % (line))
                    lineNumber += 1
                    # BuiltIn().log("verify_qc_test_case(5GC002535): line content = %s %s" % (line,lineNumber))
                    if "ulFdSchedData;" in line and "isValidWhatIsProposed;1" in line:
                        a = line.find(";rrmUlProposedMcs;") + 18
                        b = line[a:].find(";") + a
                        mcs = line[a:b]
                        # BuiltIn().log("verify_qc_test_case(5GC002535): mcs = %s (%s)" % (mcs, lineNumber))
                        try:
                            mcsList.append(int(mcs))
                        except Exception as e:
                            BuiltIn().log("verify_qc_test_case(5GC002535): MCS exit")
                            logException("verify_qc_test_case", e, True)
                        # numOfPrb;35;startPrb;4
                        a = line.find(";numOfPrb;") + 10
                        b = line[a:].find(";") + a
                        numOfPrbs = line[a:b]
                        # BuiltIn().log("verify_qc_test_case(5GC002535): numOfPrb = %s (%s)" % (numOfPrbs, lineNumber))
                        try:
                            numOfPrbList.append(int(numOfPrbs))
                        except Exception as e:
                            BuiltIn().log("verify_qc_test_case(5GC002535): numOfPrbs exit")
                            logException("verify_qc_test_case", e, True)
                    if "csiSrReportData;" in line:
                        a = line.find(";cqi;") + 5
                        b = line[a:].find(";") + a
                        cqi = line[a:b]
                        # BuiltIn().log("verify_qc_test_case(5GC002535): cqi = %s (%s)" % (cqi, lineNumber))
                        # break
            BuiltIn().log("verify_qc_test_case(5GC002535): mcsList = %s" % (mcsList))
            length = len(mcsList)
            if length > 2:
                aX = sum(mcsList)/length
                BuiltIn().log("verify_qc_test_case(5GC002535): aX = %s" % (aX))
                averageMcs = aX
                aY = (1+length)/2
                BuiltIn().log("verify_qc_test_case(5GC002535): aY = %s" % (aY))
                y, m1, m2, m = 0, 0, 0, 0
                for mcs in mcsList:
                    y += 1
                    m1 += (mcs-aX) * (y-aY)
                    m2 += (mcs-aX) * (mcs-aX)
                BuiltIn().log("verify_qc_test_case(5GC002535): m1 = %s" % (m1))
                BuiltIn().log("verify_qc_test_case(5GC002535): m2 = %s" % (m2))
                if m2 == 0:
                    m2 = 1.0
                m = m1 / m2
                BuiltIn().log("verify_qc_test_case(5GC002535): m = %s" % (m))
                gradiantMcs = m
            BuiltIn().log("verify_qc_test_case(5GC002535): numOfPrbList = %s" % (numOfPrbList))
            length = len(numOfPrbList)
            if length > 2:
                aX = sum(numOfPrbList)/length
                BuiltIn().log("verify_qc_test_case(5GC002535): numOfPrb aX = %s" % (aX))
                averagenumOfPrb = aX
                aY = (1+length)/2
                BuiltIn().log("verify_qc_test_case(5GC002535): numOfPrb aY = %s" % (aY))
                y, m1, m2, m = 0, 0, 0, 0
                for numOfPrb in numOfPrbList:
                    y += 1
                    m1 += (numOfPrb-aX) * (y-aY)
                    m2 += (numOfPrb-aX) * (numOfPrb-aX)
                BuiltIn().log("verify_qc_test_case(5GC002535): numOfPrb m1 = %s" % (m1))
                BuiltIn().log("verify_qc_test_case(5GC002535): numOfPrb m2 = %s" % (m2))
                if m2 == 0:
                    m2 = 1.0
                m = m1 / m2
                BuiltIn().log("verify_qc_test_case(5GC002535): numOfPrb m = %s" % (m))
                gradiantNbrPrb = m
        if averagenumOfPrb >= 35 and 35 in numOfPrbList and gradiantNbrPrb >= 0.0:
            tcResult = "passed"
        msg = "averageNumOfPrb=" + str(averagenumOfPrb)
        BuiltIn().log_to_console(BOLD + (GREEN if tcResult.lower() == 'passed' else RED) + msg + RESET + "",
                                 no_newline=False)
    except Exception as e:
        logException("verify_qc_test_case", e)
    return tcResult


def verify_5GC002535_UL_MCS_StartPrb_old(resultDir):
