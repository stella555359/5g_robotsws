    for i in range(0, int(retry) + 1):
        raw_throughput_string = egate_interface.send_command_check_for_faults(
            cmd)
        if '===' in raw_throughput_string:
            break
        elif i == int(retry):
            raise EgateRetryException(
                'Egate was not able to find valid throughput output in {} retries:\n {}'.format(
                    retry, raw_throughput_string
                )
            )
    return raw_throughput_string


def add_File_ending_if_missing(file_path, file_ending):
    if file_ending not in file_path:
        file_path += file_ending
    return file_path


def filter_non_printable_and_remove_head(string):
    result = []
    ws_last = False
    for c in string:
        if ws_last:
            result.append(c)
        if c == ']':
            result = []
            ws_last = True
    string_f = ''.join(result).replace(' ', '_')
    string_f = re.sub("[^A-Z_a-z0-9]", "", string_f.strip())
    return string_f
