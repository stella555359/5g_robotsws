Library         ute_wtssim           WITH NAME    wts
Library         taf.rfrl.common_resources.python.SWConfig
Library         taf.epcsim

Resource        ../../../../../resources/SWENG/robot/CallSetup.robot
Resource        ../../../../../resources/SWENG/robot/GenericTest.robot
Resource        ../../../../../resources/SWENG/robot/SetConfig.robot
Resource        ../../../../../resources/SWENG/robot/Tools.robot

Resource        pcap.robot
Resource        5GC001586_Kw_TestSetup.robot
Resource        5GC001586_Keywords.robot
Resource        5GC001586_D_keywords.robot

Variables       ../../../../../resources/SWENG/python/ReadConfig.py
# Variables       ../python/Constants.py

*** Keywords ***

Verify DSS DL Coordination Failure Phase2
   [Arguments]                     ${pdmlFile}   ${enDssFailureCause}
   run Keyword if    '${mcshark_present}'=='${False}'    Verify DSS DL Coordination Failure   pdmlFile=${pdmlFile}
   ...                                                                                        enDssFailureCause=${enDssFailureCause}
   ...  ELSE                                             Verify DSS DL Coordination Failure using MCShark   pdmlFile=${pdmlFile}
   ...                                                                                                      enDssFailureCause=${enDssFailureCause}

# EnDssCellCoordResourceConfigConflict5gAl test case
# 7510 EFaultId_EnDssCellCoordResourceConfigConflict5gAl
# resource_conflict
TC 1586-B-Check_EN_DSS_DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait_scenario_1
    [Documentation]                1586-B : test purpose is DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait
    [Arguments]                    ${param}      ${egate_alias}
    Init Sequence                  ${param}
    # Restart
    WTS Clear
    Step      common_Dss_Keywords.Start WTS          argument=${egate_alias}       # depends=Restart
    Step      5GC001586_Keywords.Wait Xp link Up     argument=${egate_alias}           depends=common_Dss_Keywords.Start WTS
    Step      common_Dss_command.X2Ap link Setup     argument=${egate_alias}           depends=common_Dss_Keywords.Start WTS
    Step      5GC001586_Keywords.Start capture Backhaul for DSS                        depends=5GC001586_Keywords.Wait Xp link Up
    Step      DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait   argument=${egate_alias}
    ...                                                                                  depends=5GC001586_Keywords.Start capture Backhaul for DSS
    sleep              4
    ${pdmlFile}    5GC001586_Keywords.Stop capture Backhaul for DSS
    Verify DSS DL Coordination Failure Phase2   pdmlFile=${pdmlFile}   enDssFailureCause=resource_conflict
    Step                           common_Dss_Keywords.Check DSS Active Alarms     argument=7510
    sleep             2
    # to clear the OAM DSS 7510 alarm
    # to check alarm 7510 not present
    [Teardown]      Run Keywords    DL_Cell_Subframe_Resource_Coordination_Normal_case   ${egate_alias}
    ...    AND    common_Dss_Keywords.Check Clear DSS Active Alarms     fault_id=7510
    ...    AND    GenericTest.Display diagnosis

# EnDssCellCoordResourceConfigFailure5gAl test case
# 7512 EFaultId_EnDssCellCoordResourceConfigFailure5gAl
# non_matching_resource_reservation
TC 1586-B-Check_EN_DSS_DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait_scenario_2
    [Documentation]                1586-B : test purpose is DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case2_w_time_to_wait
    [Arguments]                    ${param}     ${egate_alias}
    Init Sequence                  ${param}
    # Restart
    WTS Clear
    Step       common_Dss_Keywords.Start WTS         argument=${egate_alias}       # depends=Restart
    Step       5GC001586_Keywords.Wait Xp link Up     argument=${egate_alias}            depends=common_Dss_Keywords.Start WTS
    Step       common_Dss_command.X2Ap link Setup     argument=${egate_alias}            depends=common_Dss_Keywords.Start WTS
    Step       5GC001586_Keywords.Start capture Backhaul for DSS                         depends=5GC001586_Keywords.Wait Xp link Up
    Step       DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case2_w_time_to_wait   argument=${egate_alias}
    ...                          depends=5GC001586_Keywords.Start capture Backhaul for DSS
    sleep              4
    ${pdmlFile}    5GC001586_Keywords.Stop capture Backhaul for DSS
    Verify DSS DL Coordination Failure Phase2   pdmlFile=${pdmlFile}   enDssFailureCause=non_matching_resource_reservation
    Step                           common_Dss_Keywords.Check DSS Active Alarms     argument=7512
    sleep             2
    # to clear the OAM DSS 7512 alarm
    # to check alarm 7512 not present
    [Teardown]      Run Keywords    DL_Cell_Subframe_Resource_Coordination_Normal_case   ${egate_alias}
    ...    AND    common_Dss_Keywords.Check Clear DSS Active Alarms     fault_id=7512
    ...    AND    GenericTest.Display diagnosis


# EnDssDlCellCoordDssConfigError5gAl test case
# 7517 EFaultId_EnDssDlCellCoordDssConfigError5gAl
# norsp on DL subframe alloc Req
TC 1586-B-Check_EN_DSS_DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_timeout
    [Documentation]                1586-B : test purpose is Check_EN_DSS_DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_timeout
    [Arguments]                    ${param}      ${egate_alias}
    Init Sequence                  ${param}
    # Restart
    WTS Clear
    Step        common_Dss_Keywords.Start WTS         argument=${egate_alias}       # depends=Restart
    Step        5GC001586_Keywords.Wait Xp link Up     argument=${egate_alias}            depends=common_Dss_Keywords.Start WTS
    Step        common_Dss_command.X2Ap link Setup     argument=${egate_alias}            depends=common_Dss_Keywords.Start WTS
    Step        5GC001586_Keywords.Start capture Backhaul for DSS                         depends=5GC001586_Keywords.Wait Xp link Up
    Step        DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_timeout   argument=${egate_alias}
    ...                                                                     depends=5GC001586_Keywords.Start capture Backhaul for DSS
    sleep          2
    ${pdmlFile}      5GC001586_Keywords.Stop capture Backhaul for DSS
    Step                           Check Nbr enDssDlCellSubframeResourceCoordinationReq      argument=${pdmlFile}
    # BuiltIn.Log    \n Nbr enDssDlCellSubframeResourceCoordinationReq > 5 \n    console=yes
    Dated log     Nbr enDssDlCellSubframeResourceCoordinationReq > 5
    Step                           common_Dss_Keywords.Check DSS Active Alarms   argument=7517
    sleep             2
    # to clear the OAM DSS 7517 alarm
    # to check alarm 7517 not present
    [Teardown]      Run Keywords    DL_Cell_Subframe_Resource_Coordination_Normal_case   ${egate_alias}
    ...    AND    common_Dss_Keywords.Check Clear DSS Active Alarms     fault_id=7517
    ...    AND    GenericTest.Display diagnosis


####Slot mapping for sharing pattern (bitstring(80))
# ${40%_pos1}                     0010001010-0110001010-0010001010-0110001010-0010001010-0110001010-0010001010-0110001010
# ${50%_pos1}                     0011001010-0110001110-0011001010-0110001110-0011001010-0110001110-0011001110-0011001010
# ${40%_pos6}                     0110000010-0110001010-0110000010-0110001010-0110000010-0110001010-0110000010-0110001010
# ${50%_pos6}                     0111000010-0110001110-0111000010-0110001110-0111000010-0110001110-0111000110-0011001010

# not used but just to keep in mind the DL pattern used
DSS DL Cell Resource Allocation_allocation_start_time ?????
    [Arguments]       ${var1}
    log to console  \n***Slot mapping for sharing pattern (bitstring(80)): ${var1} ***
    ${Pattern}=   set variable if   '${var1}'=='40%_pos1'    0010001010-0110001010-0010001010-0110001010-0010001010-0110001010-0010001010-0110001010
    ...                             '${var1}'=='50%_pos1'    0011001010-0110001110-0011001010-0110001110-0011001010-0110001110-0011001110-0011001010
    ...                             '${var1}'=='40%_pos6'    0110000110-0110001110-0110000110-0110001110-0110000110-0110001110-0110000110-0110001110
    ...                             '${var1}'=='50%_pos6'    0111000110-0110001110-0111000110-0110001110-0111000110-0110001110-0111000110-0011001110
    ...                                                      ${None}
    sleep   5
    log to console  \nn***Slot mapping for DL sharing pattern (bitstring(80)): ${Pattern} ***
    ${cmd}=    Catenate   enb_dss_resource_allocation enb=1 cell=1 tgt_enb=2 tgt_cell=1 dir=DL allocation_start_time=0:0
    ...                                                 dl_allocated_normal_subframes=${Pattern} dl_allocation_priority=0
    wts.execute egate command and wait for data
    ...               cmd=${cmd}
    ...               pass_regexp=Received DSS DL Subframe Cell Resource Allocation Response SequenceNumber
    ...               timeout=15
    ${output}   wts.execute egate command and wait for data      cmd=enb_crm_status enb=1
    log to console      ${output}


################################################################################################################################
# DL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait
# Dl coord failed case with "non_matching_resource_reservation"
#   send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=
# failure ul_cell_resource_coordination_cause=non_matching_resource_reservation \r"
#   wts.execute egate command    cmd=crm_management_abnormal_cases enb=1 cell=1
# ul_cell_resource_coordination_req_action=failure ul_cell_resource_coordination_cause=non_matching_resource_reservation
################################################################################################################################

DL_Cell_Subframe_Resource_Coordination_Normal_case
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    Log to console  \n***DSS Phase-II DL_Cell_Subframe_Resource_Coordination_Normal_case ***
    sleep   2
    ${cmd}=    Catenate    crm_management_abnormal_cases enb=1 cell=1 dl_cell_resource_coordination_req_action=normal
    wts.execute egate command    cmd=${cmd}    alias=${alias}

    sleep       2

    log to console  \n***DSS DL_Cell_Subframe_Resource_Coordination_Normal_case completed***


DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_timeout
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    Log to console  \n***DSS Phase-II DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_timeout ***
    sleep   2

# [session 2]: enb_xp_param id=1 ignore_xp=off xp_listening_socket=on
# [session 2]: enb_xp_param id=1 xp_peers=2
# [session 2]: enb_xp_link_up enb=1 target=2
# [session 2]: enb_x2_link_up enb=1 target=2
# [session 2]: enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2
# [session 2]: enb_cell_param enb=1 id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM
# [session 2]: enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:1
# [session 2]: enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1 ...
#   ... assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=40
# [session 2]: enb_crm_param id=1 cell_resource_coordination_failure_ttw=1
# [session 2]: crm_management_abnormal_cases enb=1 cell=1 dl_cell_resource_coordination_req_action=no_rsp
# [session 2]: enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1

    wts.execute egate command    cmd=enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2    alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_cell_param enb=1 id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM    alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:1     alias=${alias}
    sleep   2
    ${cmd}=   Catenate        enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1
    ...                                   assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=40
    wts.execute egate command    cmd=${cmd}    alias=${alias}
    sleep    2
    wts.execute egate command    cmd=enb_crm_param id=1 cell_resource_coordination_failure_ttw=1    alias=${alias}
    sleep   2
    wts.execute egate command    cmd=crm_management_abnormal_cases enb=1 cell=1 dl_cell_resource_coordination_req_action=no_rsp    alias=${alias}
    sleep   2
    # wts.execute egate command    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1    alias=${alias}
    wts.execute egate command and wait for data    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1    timeout=20
    ...                                          pass_regexp=No response to EN DSS DL Cell Subframe Resource Coordination   alias=${alias}
    sleep   5
    log to console  \n***DSS DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_timeout***


# to check that we have a lot of enDssDlCellSubframeResourceCoordinationReq without rsp
Check Nbr enDssDlCellSubframeResourceCoordinationReq
    [Arguments]    ${pdmlFile}
    ${cmd}=   Catenate     egrep -n -i enDssDlCellSubframeResourceCoordinationReq ${pdmlFile} | wc -l
    ...                             > ${LOG_PATH}/nbr_enDssDlCellSubframeResourceCoordinationReq_parsed.txt
    OperatingSystem.Run      ${cmd}
    ${output}    OperatingSystem.Run     cat ${LOG_PATH}/nbr_enDssDlCellSubframeResourceCoordinationReq_parsed.txt
    Should Be True    ${output}>5


DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    Log to console  \n***DSS Phase-II DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait ***
    sleep   2

    wts.execute egate command    cmd=enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2   alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_cell_param enb=1 id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM   alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:1     alias=${alias}
    sleep   2
    ${cmd}=   Catenate      enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1
    ...                                           assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=70
    wts.execute egate command    cmd=${cmd}   alias=${alias}
    sleep   2

    wts.execute egate command    cmd=enb_crm_param id=1 cell_resource_coordination_failure_ttw=1    alias=${alias}

    sleep   1

# ul coord failed case
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action= ...
# ...         failure ul_cell_resource_coordination_cause=dss_configuration_error \r"
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action= ...
# ...         failure ul_cell_resource_coordination_cause=non_matching_resource_reservation \r"
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action= ...
# ...         failure ul_cell_resource_coordination_cause=resource_conflict \r"

# ul coord failed case with no_rsp
#    wts.execute egate command    cmd=crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=no_rsp
    ${cmd}=    Catenate      crm_management_abnormal_cases enb=1 cell=1 dl_cell_resource_coordination_req_action=failure
    ...                                                        dl_cell_resource_coordination_cause=resource_conflict
    wts.execute egate command    cmd=${cmd}   alias=${alias}

    sleep       5

    # wts.execute egate command    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1     alias=${alias}
    wts.execute egate command and wait for data    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1    timeout=20
    ...                                            pass_regexp=EN DSS DL Cell Subframe Resource Coordination Failure   alias=${alias}

    log to console  \n***DSS DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait completed***


DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case2_w_time_to_wait
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    Log to console  \n***DSS Phase-II DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case2_w_time_to_wait ***
    sleep   2

    wts.execute egate command    cmd=enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2   alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_cell_param enb=1 id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM   alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:1     alias=${alias}
    sleep   2
    ${cmd}=      Catenate      enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1
    ...                                                          assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=70
    wts.execute egate command    cmd=${cmd}   alias=${alias}
    sleep   2

    wts.execute egate command    cmd=enb_crm_param id=1 cell_resource_coordination_failure_ttw=1    alias=${alias}

    sleep   1

# ul coord failed case
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action= ...
#      ....   failure ul_cell_resource_coordination_cause=dss_configuration_error \r"
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action= ...
# ...         failure ul_cell_resource_coordination_cause=non_matching_resource_reservation \r"
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action= ...
# ...         failure ul_cell_resource_coordination_cause=resource_conflict \r"

# dl coord failed case with no_rsp
#    wts.execute egate command    cmd=crm_management_abnormal_cases enb=1 cell=1 dl_cell_resource_coordination_req_action=no_rsp
    ${cmd}=   Catenate    crm_management_abnormal_cases enb=1 cell=1 dl_cell_resource_coordination_req_action=failure
    ...                         dl_cell_resource_coordination_cause=non_matching_resource_reservation
    wts.execute egate command    cmd=${cmd}   alias=${alias}

    sleep       5

    # wts.execute egate command    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1     alias=${alias}
    wts.execute egate command and wait for data    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1     timeout=20
    ...                                            pass_regexp=EN DSS DL Cell Subframe Resource Coordination Failure   alias=${alias}

    log to console  \n***DSS DL_Cell_Subframe_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait completed***


