#------------------------------------------------------------------------------------------------------------
#Example case 10MHz:
# blanking Higher edge N Prbs
# totalPrbs = 52 (10MHz); 79 (15MHz); 106 (20MHz)
# index of blanked Prbs in NR grid : 51, 50, ..., 51-(N-1)
# Condition : UL/DL traffic should not use blanked Prbs from 51-(N-1) to 51
# startPrb + numOfPrbs - 1 < 51-(N-1) (startPrb and numOfPrb from UlData_PuschReceiveReq/)
# startPrb + numOfPrbs - 1 < CHBwPrb - numOfBlankedPrbs
# --> startPrb + numOfPrb < ChBwPrb - nbrOfBlankedPRBs + 1
# --> startPrb + numOfPrb <= ChBwPrb - nbrOfBlankedPRBs

Check Blanking Higher Edge on uldata_pushreceivereq

    [Documentation]                 Retrieve from pdml value of startPrb and numOfPrb
    ...                            from message uldata_puschreceivereq and check Blanking High Edge conditions on uldata_pushreceivereq.
    [Arguments]                     ${captureBip}
    # ${branch} is a test suite variable intialized during test suite setup Kw
    # uldata_puschreceivereql1sw and uldata_puschreceivereq are a namedtuple defined into Constants.py
    ${l1l2ItfVersion}=   Run Keyword And Return Status   Should Match Regexp     ${branch}     ^SBTS25R[2-9]|SBTS00$
    ${message}=    Run Keyword If    ${l1l2ItfVersion}   set variable     uldata_puschreceivereql1sw
    ...               ELSE                               set variable     uldata_puschreceivereq
    Dated log           pcap.Convert pcap to pdml file [${${message}.filter_name} filtered]...
    ${pdmlFile}         pcap.Convert pcap to pdml file       ${captureBip.path}         message=${message}
    Dated log           Checking Blanking Higher Edge conditions on ${${message}.filter_expression}...

    ${NbOK}                  Evaluate    0
    ${NbKO}                  Evaluate    0
    Set Suite Variable              ${NbOK}
    Set Suite Variable              ${NbKO}

    ${numOfBlankedPrb}      set variable        ${param.scfFile.BlankedPRBs.nbrOfBlankedPRBsHighEdgeDL}
    ${totalPrbs}            set variable        ${param.seq.chBwPRB}

    ${nbrOfavailablePRBs}    Evaluate   ${totalPrbs}-${numOfBlankedPrb}
    ${nbrOfavailablePRBs}    Convert To Integer    ${nbrOfavailablePRBs}
    Dated log           \tnbrOfavailablePRBs = ${nbrOfavailablePRBs}

    # 1 - Retrieve from pdml all uldata_pushreceivereq
    Dated log                       \tGetting all ${message}
    @{listAllPuschReq}              analyzer.get_match_from_paths
    ...                             pdmlFile=${pdmlFile}
    # ...                             packetName=${message}
    ...                             packetName=${${message}.filter_expression}
    ...                             pathList=${FIELDS_PUSCHreceivereq}
    ${lenPuschReq}                  get length                          ${listAllPuschReq}
    Dated log                       \tNB ${${message}.filter_expression}:${lenPuschReq}
    # 2 - For each puschReq, find corresponding puschResp (same startPrb)
    FOR    ${packet}       IN          @{listAllPuschReq}

    #       Retrieve startPrb and numOfPrb for current puschreceiveReq
            ${startPrb}            Get Value In Packet Match
            ...                    packetMatch=${packet}
            ...                    field=startPrb
            ${startPrb}   Convert To Integer    ${startPrb}
            ${numOfPrb}            Get Value In Packet Match
            ...                    packetMatch=${packet}
            ...                    field=numOfPrb
            ${numOfPrb}   Convert To Integer    ${numOfPrb}
            ${val}        Evaluate     ${startPrb}+${numOfPrb}
            ${comp}         Evaluate        ${val} <= ${nbrOfavailablePRBs}
            Run Keyword If      ('${comp}'!='True')
            ...   New Case KO
    END
    ${PASSED}       Evaluate        (round(${NbKO})*100)/round(${lenPuschReq})
    ${PASSED}             Convert to Number        ${PASSED}      2
    Dated log              \t%nrOf_KO [Blanking High Edge conditions not met]:${PASSED}%
    ${PASSED_TO_CHECK}    Convert To Integer    ${PASSED}
    Should Be Equal    ${PASSED_TO_CHECK}          ${0}


#------------------------------------------------------------------------------------------------------------
# number of available DL PRBs depends on number of blanked PRBs in High Edge
# Blanked PRBs should not be used for DL Traffic. This can be traduced by the following formula:
# startPrb + numOfPrb - 1 (in pdschsendreq) should be < totalPrbs - numOfBlankedPrb
# equivalent to startPrb + numOfPrb <= nbrOfavailablePRBs

Check Blanking Higher Edge on dldata_pdschsendreq

    [Documentation]                 Retrieve from pdml value of numOfPrb
    ...                            from message dldata_pdschsendreq and check Blanking High Edge conditions.
    [Arguments]                     ${captureBip}
    # ${branch} is a test suite variable intialized during test suite setup Kw
    # uldata_puschreceivereql1sw and uldata_puschreceivereq are a namedtuple defined into Constants.py
    ${l1l2ItfVersion}=   Run Keyword And Return Status   Should Match Regexp     ${branch}     ^SBTS25R[2-9]|SBTS00$
    ${message}=    Run Keyword If    ${l1l2ItfVersion}   set variable     dldata_pdschsendreql1sw
    ...               ELSE                               set variable     dldata_pdschsendreq
    Dated log           pcap.Convert pcap to pdml file [pdschsendreq filtered]...
    ${pdmlFile}       pcap.Convert pcap to pdml file       ${captureBip.path}         message=${message}
    Dated log           Checking Blanking Higher Edge conditions on dldata_pdschsendreq...

    ${NbOK}                    Evaluate     0
    ${NbKO}                    Evaluate     0
    Set Suite Variable              ${NbOK}
    Set Suite Variable              ${NbKO}

    ${numOfBlankedPrb}      set variable        ${param.scfFile.BlankedPRBs.nbrOfBlankedPRBsHighEdgeDL}
    ${totalPrbs}            set variable        ${param.seq.chBwPRB}

    ${nbrOfavailablePRBs}         Evaluate     ${totalPrbs}-${numOfBlankedPrb}
    ${nbrOfavailablePRBs}     Convert to Integer   ${nbrOfavailablePRBs}
    # ${branch} is a test suite variable intialized during test suite setup Kw
    ${l1l2ItfVersion}=   Run Keyword And Return Status   Should Match Regexp     ${branch}     ^SBTS25R[2-9]|SBTS00$
    ${message}=    Run Keyword If    ${l1l2ItfVersion}   set variable     dldata_pdschsendreql1sw
    ...               ELSE                               set variable     dldata_pdschsendreq

    # 1 - Retrieve from pdml all pdschsendreq
    Dated log                       \tGetting all ${message}
    @{listAllPdschReq}              analyzer.get_match_from_paths
    ...                             pdmlFile=${pdmlFile}
    ...                             packetName=${message}
    ...                             pathList=${FIELDS_PDSCHSendReq}
    ${lenPdschReq}                  get length                          ${listAllPdschReq}
    Dated log                       \tNB of ${message}:${lenPdschReq}
    # 2 - For each pdschsendreq find corresponding startPrb and numOfPrb
    FOR    ${packet}       IN          @{listAllPdschReq}

    #       Retrieve startPrb & numOfPrb  for current pdschsendreq
            ${startPrb}            Get Value In Packet Match
            ...                    packetMatch=${packet}
            ...                    field=startPrb
            ${startPrb}   Convert To Integer    ${startPrb}
            ${numOfPrb}            Get Value In Packet Match
            ...                    packetMatch=${packet}
            ...                    field=numOfPrb
            ${numOfPrb}    Convert to Integer    ${numOfPrb}
            ${val}         Evaluate         ${startPrb}+${numOfPrb}
            ${comp}        Evaluate         ${val} <= ${nbrOfavailablePRBs}
            Run Keyword If    ('${comp}'!='True')
            ...   New Case KO
    END
    ${PASSED}    Evaluate        (round(${NbKO})*100)/round(${lenPdschReq})

    ${PASSED}             Convert to Number        ${PASSED}      2
    Dated log              \t%nrOf_KO [numOfPrb exceeds nbrOfavailablePRBs=${nbrOfavailablePRBs}]:${PASSED}%
    ${PASSED_TO_CHECK}    Convert To Integer    ${PASSED}
    Should Be Equal    ${PASSED_TO_CHECK}          ${0}



