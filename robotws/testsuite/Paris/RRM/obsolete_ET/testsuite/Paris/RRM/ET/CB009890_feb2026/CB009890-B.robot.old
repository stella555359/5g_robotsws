*** Settings ***
# https://confluence.ext.net.nokia.com/pages/viewpage.action?spaceKey=5GFTPARIS&title=ET+Coding+Rules
# --------------------------------------------------------------------------------------------------------------------------------------------------
Documentation     [SUITE PURPOSE]   CB009890-B Test suite ...
...               Prerequisite : gNB configured with x Cells & RU detected. Physical cells id are 50, 51, etc.
...               Scope : call setup - nGBR and GBR traffic several Ues
...               Test Case Scenario author   : christophe.samson@nokia.com
...               Creation Date               : 06-15-2023
...               Modified Date               : 06-15-2023
...               Last Modified by            : christophe.samson@nokia.com
...               Version   Date          Author                                   Notes
...               0.1       06-15-2023    christophe.samson@nokia.com              Creation
...               0.2       10-13-2023    christophe.samson@nokia.com              LBT27586 - 03165922 - TMO CAS
# --------------------------------------------------------------------------------------------------------------------------------------------------

# Libraries
Library      taf.transport.ssh                                   WITH NAME          ssh
Library      taf.sbts.oam.coam.admin.interface
Library      taf.sbts.oam.coam.admin                             WITH NAME          coam
Library      taf.collectors.tcpdump                              WITH NAME          tcpdump
Library      taf.collectors.core                                 WITH NAME          core
Library      ute_wtssim
Library      taf.config.wts                                      WITH NAME          wts

# Libraries SWENG
Library         ../../../resources/SWENG/python/StringTool.py

# Libraries CB009890
Library      resources/python/Constants-CB009890-A.py            WITH NAME          MyConstants

# Resources CB009890
Resource     ./resources/robot/CB009890-Common-Keywords.robot
Resource     ./resources/robot/CB009890-A-Common-Keywords.robot
Resource     ./resources/robot/CB009890-Test-Template-Keywords.robot
Resource     ./resources/robot/CB009890-Test-Template-Keywords-TC18-TC22.robot

Variables    ./resources/python/Constants-CB009890-A.py

# Suites and Tests setup and teardown
Suite Setup       Suite Setup CB009890-A-Common
...                    test_dictParam=${dictParam}
...                    yamlPathname=${CURDIR}/../../../../../custom-config/${feature path}${custom_config_file}
Suite Teardown    Suite Teardown CB009890-A-Common
Test Setup        Test Setup for CB009890-Common
Test Teardown     Test Teardown for CB009890-Common

*** Variables ***

${feature path}                          POOLING/CB009890/CLOUD_5G_O_E_AP_LOO_SANSA_FS_ECPRI_CMWV_TDD_3Cells/
${custom_config_file}                    config_ASOE_DL_CL_MIMO_4x4_3Cells_AP_2ABIO.yaml

${relative_json_path}                                               ${CURDIR}/CB009890_B_data_tests.json

${TestSharkTool}                                                    MC_SHARK

&{dictParam}                                                        w_Basic_Call_to_Setup_Wtsemu=${True}
...                                                                 w_enable_sherpa_Traces=True
...                                                                 w_check_9890_using_sherpa=False
...                                                                 w_GetTtiTrace=True
...                                                                 w_convert_TtiPcap_to_excelCsv=False
...                                                                 w_GetL1L2Bip=False
...                                                                 w_generic_capture=True
...                                                                 w_CaptureCORE=${False}
...                                                                 w_CaptureL1L2=${False}
...                                                                 w_CaptureCPRT=${True}
...                                                                 w_ue_detach=False
...                                                                 w_GetBtsLog=True
...                                                                 w_DISPLAY_ue_stats_nr_15min=False

# capture Time setting
&{CAPTURE}                                                          GetTtiTraceTime=1s
...                                                                 Getl1l2TraceTime=1s
...                                                                 GetSherpaTraceTime=1s
...                                                                 GetTtiTraceNumOfEvent=5000

&{dictExpectedValues}                                               expected_avg_total_prbs_spool1=546
...                                                                 expected_avg_total_prbs_spool2=78
...                                                                 expected_avg_total_prbsstream_spool1=2100
...                                                                 expected_avg_total_prbsstream_spool2=300

# tests settings
&{C_Cell}                                                           dir=DL
...                                                                 totalNbOfUe=6                 # total number of ue's to configure
...                                                                 totalNbOfCell=3               # total number of cell used for ue's dispatching
...                                                                 targetGnb=2                   # gnb target id
...                                                                 captureDuration=0             # capture duration during traffic starting phase
...                                                                 duration=3                    # traffic duration during declaration phase
...                                                                 deviation=10                  # allowed deviation for throughput

# ue's settings
&{dict_settings_ue_1}                                               originalCell=1                # original cell for call establishment
...                                                                 DL_throughput=150             # throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 DL_throughput_GBR=10          # throughput GBR is not supported
...                                                                 UL_throughput=0               # UL throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 protocol=udp
...                                                                 packet_size=1350
...                                                                 cqi=15
...                                                                 ri=3

&{dict_settings_ue_2}                                               originalCell=2
...                                                                 DL_throughput=100
...                                                                 DL_throughput_GBR=10
...                                                                 UL_throughput=0               # UL throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 protocol=udp
...                                                                 packet_size=1350
...                                                                 cqi=15
...                                                                 ri=3

&{dict_settings_ue_3}                                               originalCell=3
...                                                                 DL_throughput=100
...                                                                 DL_throughput_GBR=10
...                                                                 UL_throughput=0               # UL throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 protocol=udp
...                                                                 packet_size=1350
...                                                                 cqi=15
...                                                                 ri=3

&{dict_settings_ue_4}                                               originalCell=1                # original cell for call establishment
...                                                                 DL_throughput=150             # throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 DL_throughput_GBR=10          # throughput GBR is not supported
...                                                                 UL_throughput=0               # UL throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 protocol=udp
...                                                                 packet_size=1350
...                                                                 cqi=15
...                                                                 ri=3

&{dict_settings_ue_5}                                               originalCell=2
...                                                                 DL_throughput=100
...                                                                 DL_throughput_GBR=10
...                                                                 UL_throughput=0               # UL throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 protocol=udp
...                                                                 packet_size=1350
...                                                                 cqi=15
...                                                                 ri=3

&{dict_settings_ue_6}                                               originalCell=3
...                                                                 DL_throughput=100
...                                                                 DL_throughput_GBR=10
...                                                                 UL_throughput=0               # UL throughput nonGBR for ue or ${NO_THROUGHPUT}
...                                                                 protocol=udp
...                                                                 packet_size=1350
...                                                                 cqi=15
...                                                                 ri=3

&{dict_settings_ue_default}                                         originalCell=1
...                                                                 DL_throughput=900
...                                                                 DL_throughput_GBR=0           # throughput GBR is not supported
...                                                                 UL_throughput=0
...                                                                 protocol=udp
...                                                                 packet_size=1350
...                                                                 cqi=15
...                                                                 ri=3


@{dict_settings_3_ues}                                              ${dict_settings_ue_1}
...                                                                 ${dict_settings_ue_2}
...                                                                 ${dict_settings_ue_3}

@{dict_settings_all_ues}                                            ${dict_settings_ue_1}
...                                                                 ${dict_settings_ue_2}
...                                                                 ${dict_settings_ue_3}
...                                                                 ${dict_settings_ue_4}
...                                                                 ${dict_settings_ue_5}
...                                                                 ${dict_settings_ue_6}

# vendor's setting

# BB pool mode : Load-metric based
# bbL1SpPrbInitCapacity settings :
#	        <item>
#	          <p name="bbHwVariant">ABIO</p>
#	          <p name="csSize">48</p>
#	          <p name="direction">DL</p>
#	          <p name="l1PoolType">NR_L1_Loki_TDD_FR1_eCPRI_IQF_Asymm</p>
#	          <p name="maxNumLayerPrbL1Sp">1200</p>
#	          <p name="maxNumStreamPrbL1Sp">1200</p>
#	          <p name="maxNumWbStreamPrbL1Sp">600</p>
#	        </item>

&{Vendor_IWK_CB8940-L_CB7113}                                       bbHwVariant=ABIO
...                                                                 maxNumLayerPrbL1Sp=1200
...                                                                 maxNumStreamPrbL1Sp=1200
...                                                                 maxNumWbStreamPrbL1Sp=600
...                                                                 maxNumScheUePdschL1Pool=None
...                                                                 maxNumScheUePdschL1Sp=None
...                                                                 maxNumDlSubcellL1Pool=6
...                                                                 maxNumDlSubcellL1Sp=4
...                                                                 maxNumUlSubcellL1Pool=6
...                                                                 maxNumUlSubcellL1Sp=4
...                                                                 ul_maxNumLayerPrbL1Sp_csSize32=410
...                                                                 ul_maxNumStreamPrbL1Sp_csSize32=820
...                                                                 ul_maxNumWbStreamPrbL1Sp_csSize32=None
...                                                                 ul_maxNumLayerPrbL1Sp_csSize48=None
...                                                                 ul_maxNumStreamPrbL1Sp_csSize48=None
...                                                                 ul_maxNumWbStreamPrbL1Sp_csSize48=None
...                                                                 ul_maxNumLayerPrbL1Sp_csSize64=820
...                                                                 ul_maxNumStreamPrbL1Sp_csSize64=1640
...                                                                 ul_maxNumWbStreamPrbL1Sp_csSize64=None

*** Test Cases ***
### SA

# CB009890_B_13_Secondary_UL_Subcell_Deactivation_based_On_Load_Based_Algorithm for (LBT27586 - 03165922 - TMO CAS)
[1][1.0] CB009890_B_02_Secondary_UL_Subcell_Deactivation_based_On_Load_Based_Algorithm
    [Documentation]
    ...     Conditions:     it is based on the configuration ${C_Cell}
    ...                         actDlSrsBm is activated
    ...                         srsForBeamMgmt at Cell level
    ...                              <list name="srsForBeamMgmt">
    ...                                   <item>
    ...                                   <p name="bSRS">2</p>
    ...                                   <p name="cSRS">63</p>
    ...                                   <p name="srsPowerThresholdForDlBm">-1200</p>
    ...                                   <p name="srsTypeAllocForDlBm">antenna switching or codebook</p>
    ...                                   <p name="srsUePeriodicity">slots40</p>
    ...                                   </item>
    ...                              </list>
    ...                        actUeCsirsCoexistCellCsirs = TRUE
    ...                    In egate, you need to activate the Srs mode : cfg file modified by KW
    ...                                                       "Update Basic Configuration File for actDlSrsBm Test Mode"
    ...                      cell_srs_beam_pos_nr profile_id=1 num_of_ue_positions=4 azimuth=-40,-13,13,40
    ...                      cell_testmode_set_nr cell_id=1 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
    ...                      cell_testmode_set_nr cell_id=2 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
    ...                      cell_testmode_set_nr cell_id=3 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate
	...                    ------------------------------------------------------------------------------
    ...     Actions:        based on dlTdSchedSubcellData,numAllocCellPrbDl , check prbstreamcapa as expected
    ...                      for subpool1 and subpoll2
    ...     Checks:
    ...     Verdict:        calls for multi ues and PRB pooling are passed
    [Tags]  CRT
    # Set To Dictionary       ${C_Cell}    totalNbOfUe       2
    TC CB009890 B  ${C_Cell}    ${dictParam}    ${Vendor_IWK_CB8940-L_CB7113}    ${dict_settings_all_ues}    nrCell=3
    ...          kw Set RAD Params=Set RAD Params for 9890-A
    ...          kw NIDD Set=Set CB009890-B NIDD PARAMETERS with ulMUMIMO
    ...          kw NIDD Check=Check CB009890-B NIDD PARAMETERS with ulMUMIMO
    ...       kw Specific Set TestMode After Attach=Set UE CSI profile And SRS Beam Position for muMIMO UE pairing for all ${C_Cell.totalNbOfUe} Ues
    ...          NIDD_9890_PARAMS=${NIDD_9890_B_w_CB008940_CB007113_PARAMS_ASOE}
    ...          kw Specific Check=Check PRB Assignment CB009890-B TC
    ...          Kw TestLine Preparation=TL_Preparation_CB009890_SCF_CB006915_CFG_1
    ...          Json test configuration=${relative_json_path}

