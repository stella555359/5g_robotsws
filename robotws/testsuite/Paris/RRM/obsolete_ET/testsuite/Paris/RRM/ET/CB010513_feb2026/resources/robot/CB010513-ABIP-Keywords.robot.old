# The counter M55308C1005 (PRBs available for PDSCH with L1 Baseband pooling enabled) values
# Assumptions : frame structure SemiStatic 1_4 with SlotPattern of 160 Slots.
# Nidd csiReportPeriodicity=320Slots, csirsTrackingPeriod=80ms, 6 beams, beamRefinement=true, ssBurstSetPeriod=20ms, chBw=100Mhz
# Computation of the numPdschPrbInSsbSlots : 20 PRB ROUNDUP to the RBG Size of 32 PRB
# Computation of the usable PRB for CSI-RS for BeamManagement : 28 PRBs ROUNDUP to the RBG size of 32 PRB
#   12 SSB slots : 273 PDSCH PRB - 32 unusable PRB(SSB)- 32 unusable PRB(CSI-RS BeamMngt)=209 PRB remaining for PDSCH = 12*209 PRB
#                        // or 54-20-28=6 PRB for PDSCH
# + 12 SIB slots : 273 PDSCH PRB per SIB slot = 12*273 PRB
# + 2 TRS slots = numPdschPrbInTrsSlots = 2 * 273 PDSCH PRB  (1 muted slot with introduction of CB08940 )
# + 30 Special slots = 30 * 273 PDSCH PRB per Slot
# + 72 Full DL slots = 30 * 273 PDSCH PRB per Slot , 10 muted Slots
#
# NrCell-2 : ZAB cell eligible, BBRM allocats 273 PRB due to inter L1subpool pooling
# in every 160slots : 12*209+12*273+2*273+30*273+72*273=34176
# in 5 mins :  34176*(600000/160)=128160000
#
# NrCell-6 : non ZAB cell eligible, BBRM allocates 54 PRB due to inter L1subpool pooling
# in every 160slots : 10 muted slots,  12*(54-48)+12*54+32*54+72*54-14*54=5580
# in 5mins ;   5580*(600000/160)=20925000
#
# NrCell-4 : non ZAB cell eligible, BBRM allocates 273 PRB due to inter L1subpool,
# in every 160slots :  12*209+12*273+2*273+30*273+58*273=34176
#                      14 muted slots ==> 34176-14*273=30354
# in 5mins :   30354*(600000/160)=113827500

&{BB_POOL_Counter_Expected}             PM_ID=M55308C10005
...                                     CELL_1_Expected=128160000
...                                     CELL_2_Expected=128160000
...                                     CELL_3_Expected=20925000
...                                     CELL_4_Expected=20925000
...                                     CELL_5_Expected=113827500
...                                     CELL_6_Expected=113827500

&{PRB_AVAIL_PUSCH_LEGACY_Expected}      PM_ID=M55308C10004
...                                     CELL_1_Expected=28800000
...                                     CELL_2_Expected=28800000
...                                     CELL_3_Expected=28800000
...                                     CELL_4_Expected=28800000
...                                     CELL_5_Expected=28800000
...                                     CELL_6_Expected=28800000

&{PRB_AVAIL_PDSCH_LEGACY_Expected}      PM_ID=M55308C10003
...                                     CELL_1_Expected=128160000
...                                     CELL_2_Expected=128160000
...                                     CELL_3_Expected=113827500
...                                     CELL_4_Expected=113827500
...                                     CELL_5_Expected=113827500
...                                     CELL_6_Expected=113827500

&{7113_UL_BB_POOL_Counter_Expected}     PM_ID=M55308C10006
...                                     CELL_1_Expected=28800000
...                                     CELL_2_Expected=28800000
...                                     CELL_3_Expected=28800000
...                                     CELL_4_Expected=28800000
...                                     CELL_5_Expected=28800000
...                                     CELL_6_Expected=28800000

&{8940_J_DL_Slots_Counter_Expected}     PM_ID=M55308C00001
