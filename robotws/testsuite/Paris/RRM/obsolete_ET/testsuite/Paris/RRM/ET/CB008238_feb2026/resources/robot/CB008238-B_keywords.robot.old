Resource                            ./CB008238_keywords.robot
Resource                            ../../../resources/common/TtiTrace/ttitrace.robot


*** Variables ***
${DL_duration}                   60
${DL_trace_duration}             5

${TputVolMargin}                 5


*** Keywords ***
CB008238_TC_B_02_single_UE_NGBR_interaction_with_SIBs_TDD_SA
    ${MaxRetentionDelay}          Evaluate    10
    CB008238 CellSetup            actDtxOptimzedScheduler=true       MaxRetentionDelay=${MaxRetentionDelay}    CallType=SA
    ...                           actDl256Qam=false
    CB008238 Attach SA            ueSetting=${BASIC_UE_SA}

    # L1/L2 capture configuration
    ${CaptureBIP_DL}              Capture L1L2 Set Upon Config       airscale=${GNB_DU}
    Capture Init                  ${CaptureBIP_DL}                   suffix=_B02

    # TTI capture configuration
    ${TTIdir}                     Get TTI Trace Path                 dir_suffix=B02

    Dated Log New Line            ${trcColor}=== Start packets sending ${defColor}
    ${pktPeriod}                  Evaluate    12
    ${pktSize}                    Evaluate    100
    ${pktBurst}                   Evaluate    1
    Send UE DL packets            ueSetting=${BASIC_UE_SA}
    ...                           duration=0
    ...                           period_ms=${pktPeriod}
    ...                           size=${pktSize}
    ...                           burst=${pktBurst}
    ...                           shouldBeStop=${False}
    ...                           deviation=${TputVolMargin}
    ${timeStartTraffic}           Get Current Date

    # start TTI capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2

    # start L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=START

    Traced Sleep                  ${DL_trace_duration}               msg=DL traffic capture

    # stop L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=STOP

    # stop TTI capture
    ${TTIpcap}                    Stop TTI Traces in Streaming mode
    ...                           tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTITrace_B02

    Traced Sleep                  ${DL_duration}                     msg=DL traffic

    Dated Log New Line            ${trcColor}=== Stop packets sending and detach UE ${defColor}
    ${timeStopTraffic}            Get Current Date
    Traffic Stop                  ueSetting=${BASIC_UE_SA}           dir=dl
    UE Deregister                 id=${BASIC_UE_SA.ue}

    ${TTIjson}                    Convert TTItrace from pcap to others
    ...                           input_file_path=${TTIpcap}
    ${TTIcsv}                     decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=10000

    Dated Log New Line            ${trcColor}=== Check retention in TTI trace ${defColor}
    ${nbCheck}                    checkMaxRetentionAndSIB    jsonPathName=${TTIjson}    mode=TDD    maxRetention=${MaxRetentionDelay}
    Should Be True                ${nbCheck}>0

    CB008238 get PM files

    ${uDTX_OPTIMIZED}  ${uDTX_NO_BUNDLING}    CB008238 get uDTX counters
    ${SlotsWithPDSCH}                         CB008238 get number of slot with PDSCH
    Dated Log New Line            ${trcColor}=== Number of slot with PDSCH: ${SlotsWithPDSCH} ${defColor}
    Dated Log New Line            ${trcColor}=== uDTX_OPTIMIZED: ${uDTX_OPTIMIZED}, uDTX_NO_BUNDLING: ${uDTX_NO_BUNDLING} ${defColor}

    ${timeDiff}                   Subtract Date From Date    ${timeStopTraffic}    ${timeStartTraffic}
    ${trafficDuration}            Convert To Integer    ${timeDiff}
    ${DLtput}                     Evaluate       ${pktSize}*${pktBurst}*8*1000/${pktPeriod}
    ${expectedDataVol}            Evaluate       ${DLtput}*${trafficDuration}/8
    ${expectedDataVolMargin}      Evaluate       ${expectedDataVol} - ${expectedDataVol}*${TputVolMargin}/100
    ${status_DL_dataVolume}       CB008238 check DL Data Volume    QCI=QCI6    expectedDataVol=${expectedDataVolMargin}
    ${status_DL_BLER}             CB008238 check DL BLER    maxBLER=1

    # uDTX_OPTIMIZED: have to take into account PDSCH slots for NSA attach
    # uDTX_NO_BUNDLING: because of coscheduling with SIBs, could be 22,5% less than uDTX_OPTIMIZED
    Should be True                ${uDTX_OPTIMIZED}>=(${SlotsWithPDSCH}-20) and ${uDTX_NO_BUNDLING}>=(${uDTX_OPTIMIZED}*75/100)
    Should be True                ${status_DL_dataVolume} and ${status_DL_BLER}


CB008238_TC_B_09_Multi_UEs_DTX_interactions_with_NGBR_TDD_NSA
    ${MaxRetentionDelay}          Evaluate           10
    CB008238 CellSetup            actDtxOptimzedScheduler=true    MaxRetentionDelay=${MaxRetentionDelay}    CallType=NSA    nbUe=2
    ...                           actDl256Qam=false

    &{UE1}                        copy dictionary    ${UE_SIMPLE}
    &{UE2}                        copy dictionary    ${UE_SIMPLE}
    ${UE2.ue}                     Set Variable       2
    Dated Log New Line            ${trcColor}=== Attach UE1 ${defColor}
    CB008238 Attach NSA           ueSetting=${UE1}
    Dated Log New Line            ${trcColor}=== Attach UE2 ${defColor}
    CB008238 Attach NSA           ueSetting=${UE2}

    # L1/L2 capture configuration
    ${CaptureBIP_DL}              Capture L1L2 Set Upon Config       airscale=${GNB_DU}
    Capture Init                  ${CaptureBIP_DL}                   suffix=_B09

    # TTI capture configuration
    ${TTIdir}                     Get TTI Trace Path                 dir_suffix=B09

    Dated Log New Line            ${trcColor}=== Start packets sending UE1 ${defColor}
    ${UE1pktPeriod}               Evaluate    18
    ${pktSize}                    Evaluate    50
    ${pktBurst}                   Evaluate    1
    Send UE DL packets            ueSetting=${UE1}
    ...                           duration=0
    ...                           period_ms=${UE1pktPeriod}
    ...                           size=${pktSize}
    ...                           burst=${pktBurst}
    ...                           shouldBeStop=${False}
    ...                           deviation=${TputVolMargin}
    ${UE1timeStartTraffic}        Get Current Date

    Dated Log New Line            ${trcColor}=== Start packets sending UE2 ${defColor}
    ${UE2pktPeriod}               Evaluate    20
    ${pktSize}                    Evaluate    50
    ${pktBurst}                   Evaluate    1
    Send UE DL packets            ueSetting=${UE2}
    ...                           duration=0
    ...                           period_ms=${UE2pktPeriod}
    ...                           size=${pktSize}
    ...                           burst=${pktBurst}
    ...                           shouldBeStop=${False}
    ...                           deviation=${TputVolMargin}
    ${UE2timeStartTraffic}        Get Current Date

    # start TTI capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2

    # start L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=START

    Traced Sleep                  ${DL_trace_duration}               msg=DL traffic capture

    # stop L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=STOP

    # stop TTI capture
    ${TTIpcap}                    Stop TTI Traces in Streaming mode
    ...                           tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTITrace_B09

    Traced Sleep                  ${DL_duration}                     msg=DL traffic

    Dated Log New Line            ${trcColor}=== Stop packets sending and detach UEs ${defColor}
    ${UE1timeStopTraffic}         Get Current Date
    Traffic Stop                  ueSetting=${UE1}                   dir=dl
    ${UE2timeStopTraffic}         Get Current Date
    Traffic Stop                  ueSetting=${UE2}                   dir=dl
    UE Detach Enb                 ueSetting=${UE1}
    UE Detach Enb                 ueSetting=${UE2}

    ${TTIjson}                    Convert TTItrace from pcap to others
    ...                           input_file_path=${TTIpcap}
    ${TTIcsv}                     decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=10000

    # Because TTI trace sequence evolves regularly,and as 8238 is now mature,
    # TTI check is removed and checks are done with counters.
    #Dated Log New Line            ${trcColor}=== Check retention in TTI trace ${defColor}
    #${nbCheck}                    checkMaxRetention2UEsNGBR    jsonPathName=${TTIjson}    mode=TDD    maxRetention=${MaxRetentionDelay}
    #Should Be True                ${nbCheck}>0

    CB008238 get PM files

    ${uDTX_OPTIMIZED}  ${uDTX_NO_BUNDLING}    CB008238 get uDTX counters
    Dated Log New Line            ${trcColor}=== uDTX_OPTIMIZED: ${uDTX_OPTIMIZED}, uDTX_NO_BUNDLING: ${uDTX_NO_BUNDLING} ${defColor}

    ${UE1timeDiff}                Subtract Date From Date    ${UE1timeStopTraffic}    ${UE1timeStartTraffic}
    ${UE1trafficDuration}         Convert To Integer    ${UE1timeDiff}
    ${UE2timeDiff}                Subtract Date From Date    ${UE2timeStopTraffic}    ${UE2timeStartTraffic}
    ${UE2trafficDuration}         Convert To Integer    ${UE2timeDiff}

    ${UE1uDTXexpectedMin}         Evaluate       ${UE1trafficDuration}*1000/${UE1pktPeriod}
    ${UE2uDTXexpectedMin}         Evaluate       ${UE2trafficDuration}*1000/${UE2pktPeriod}
    ${uDTXexpectedMin}            Evaluate       ${UE1uDTXexpectedMin}+${UE2uDTXexpectedMin}

    ${UE1DLtput}                  Evaluate       ${pktSize}*${pktBurst}*8*1000/${UE1pktPeriod}
    ${UE1expectedDataVol}         Evaluate       ${UE1DLtput}*${UE1trafficDuration}/8
    ${UE2DLtput}                  Evaluate       ${pktSize}*${pktBurst}*8*1000/${UE2pktPeriod}
    ${UE2expectedDataVol}         Evaluate       ${UE2DLtput}*${UE2trafficDuration}/8
    ${expectedDataVol}            Evaluate       ${UE1expectedDataVol} + ${UE2expectedDataVol}
    ${expectedDataVolMargin}      Evaluate       ${expectedDataVol} - ${expectedDataVol}*${TputVolMargin}/100
    ${status_DL_dataVolume}       CB008238 check DL Data Volume    QCI=QCI9    expectedDataVol=${expectedDataVolMargin}
    ${status_DL_BLER}             CB008238 check DL BLER    maxBLER=1

    Should be True                ${uDTX_OPTIMIZED}>=${uDTXexpectedMin} and ${status_DL_dataVolume} and ${status_DL_BLER}


CB008238_TC_B_16_UE1_NGBR_UE2_VONR_5QI1_FDD_SA
    ${MaxRetentionDelay}          Evaluate           30
    CB008238 CellSetup            actDtxOptimzedScheduler=true    MaxRetentionDelay=${MaxRetentionDelay}    CallType=SA    VoNR=true    nbUe=2
    ...                           actDl256Qam=false
    &{ueVoNR}                     copy dictionary    ${BASIC_UE_SA}
    ${ueVoNR.qfi}                 Set Variable       3
    ${ueVoNR.throughput}          Set Variable       ${None}

    &{ueBasic}                    copy dictionary    ${BASIC_UE_SA}
    ${ueBasic.ue}                 Set Variable       2
    ${ueBasic.pdu}                Set Variable       2
    ${ueBasic.trf_id}             Set Variable       2

    Dated Log New Line            ${trcColor}=== Attach VoNR UE ${defColor}
    CB008238 Attach SA            ueSetting=${ueVoNR}    VoNR=true
    Dated Log New Line            ${trcColor}=== Attach NGBR UE ${defColor}
    CB008238 Attach SA            ueSetting=${ueBasic}

    # L1/L2 capture configuration
    ${CaptureBIP_DL}              Capture L1L2 Set Upon Config       airscale=${GNB_DU}
    Capture Init                  ${CaptureBIP_DL}                   suffix=_B16

    # TTI capture configuration
    ${TTIdir}                     Get TTI Trace Path                 dir_suffix=B16

    Dated Log New Line            ${trcColor}=== Start traffic on VoNR UE ${defColor}
    ${pktPeriodQCI1}              Evaluate    12
    ${pktSizeQCI1}                Evaluate    50
    ${pktBurstQCI1}               Evaluate    1
    Send UE DL packets            ueSetting=${ueVoNR}
    ...                           duration=0
    ...                           period_ms=${pktPeriodQCI1}
    ...                           size=${pktSizeQCI1}
    ...                           burst=${pktBurstQCI1}
    ...                           shouldBeStop=${False}
    ...                           deviation=${TputVolMargin}
    ${timeStartQCI1Traffic}       Get Current Date

    Dated Log New Line            ${trcColor}=== Start traffic on NGBR UE ${defColor}
    ${pktPeriod}                  Evaluate    20
    ${pktSize}                    Evaluate    100
    ${pktBurst}                   Evaluate    1
    Send UE DL packets            ueSetting=${ueBasic}
    ...                           duration=0
    ...                           period_ms=${pktPeriod}
    ...                           size=${pktSize}
    ...                           burst=${pktBurst}
    ...                           shouldBeStop=${False}
    ...                           deviation=${TputVolMargin}
    ${DRBtimeStartTraffic}           Get Current Date

    # start TTI capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2

    # start L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=START

    Traced Sleep                  ${DL_trace_duration}               msg=DL traffic capture

    # stop L1/L2 capture
    Callback Capture L1L2         capture=${CaptureBIP_DL}           Action=STOP

    # stop TTI capture
    ${TTIpcap}                    Stop TTI Traces in Streaming mode
    ...                           tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTITrace_B16

    Traced Sleep                  ${DL_duration}                     msg=DL traffic

    Dated Log New Line            ${trcColor}=== Stop traffic on basic UE ${defColor}
    ${DRBtimeStopTraffic}         Get Current Date
    Traffic Stop                  ueSetting=${ueBasic}               dir=dl

    Dated Log New Line            ${trcColor}=== Stop traffic on VoNR UE ${defColor}
    ${timeStopQCI1Traffic}        Get Current Date
    Traffic Stop                  ueSetting=${ueVoNR}                dir=dl

    Dated Log New Line            ${trcColor}=== Detach UEs ${defColor}
    UE Deregister                 id=${ueVoNR.ue}
    UE Deregister                 id=${ueBasic.ue}

    ${TTIjson}                    Convert TTItrace from pcap to others
    ...                           input_file_path=${TTIpcap}
    ${TTIcsv}                     decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=10000

    CB008238 get PM files

    ${uDTX_OPTIMIZED}  ${uDTX_NO_BUNDLING}    CB008238 get uDTX counters
    Dated Log New Line            ${trcColor}=== uDTX_OPTIMIZED: ${uDTX_OPTIMIZED}, uDTX_NO_BUNDLING: ${uDTX_NO_BUNDLING} ${defColor}

    ${VoNRtimeDiff}               Subtract Date From Date    ${timeStopQCI1Traffic}    ${timeStartQCI1Traffic}
    ${VoNRtrafficDuration}        Convert To Integer    ${VoNRtimeDiff}
    ${VoNRDLtput}                 Evaluate       ${pktSizeQCI1}*${pktBurstQCI1}*8*1000/${pktPeriodQCI1}
    ${VoNRexpectedDataVol}        Evaluate       ${VoNRDLtput}*${VoNRtrafficDuration}/8
    ${VoNRexpectedDataVolMargin}  Evaluate       ${VoNRexpectedDataVol} - ${VoNRexpectedDataVol}*${TputVolMargin}/100

    ${DRBtimeDiff}                Subtract Date From Date    ${DRBtimeStopTraffic}    ${DRBtimeStartTraffic}
    ${DRBtrafficDuration}         Convert To Integer    ${DRBtimeDiff}
    ${DRBDLtput}                  Evaluate       ${pktSize}*${pktBurst}*8*1000/${pktPeriod}
    ${DRBexpectedDataVol}         Evaluate       ${DRBDLtput}*${DRBtrafficDuration}/8
    ${DRBexpectedDataVolMargin}   Evaluate       ${DRBexpectedDataVol} - ${DRBexpectedDataVol}*${TputVolMargin}/100

    ${uDTXexpectedMin}            Evaluate       ${DRBtrafficDuration}*1000/${pktPeriod}

    ${status_VoNR_dataVolume}     CB008238 check DL Data Volume    QCI=QCI1    expectedDataVol=${VoNRexpectedDataVolMargin}
    ${status_DRB_dataVolume}      CB008238 check DL Data Volume    QCI=QCI6    expectedDataVol=${DRBexpectedDataVolMargin}
    ${status_DL_BLER}             CB008238 check DL BLER    maxBLER=1

    Should be True                ${uDTX_OPTIMIZED}>=${uDTXexpectedMin} and ${uDTX_NO_BUNDLING}==0
    Should be True                ${status_VoNR_dataVolume} and ${status_DRB_dataVolume} and ${status_DL_BLER}
