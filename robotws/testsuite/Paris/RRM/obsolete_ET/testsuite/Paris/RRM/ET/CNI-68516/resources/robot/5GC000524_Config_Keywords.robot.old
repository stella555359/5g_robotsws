*** Variables ***

# variable set to ${True} to automatically save SOS report and OAM snapshot
# (by default, these information are saved only if a test is failed)
#${ForceDebugDataCollection}    ${False}
#${ForceDebugDataCollection}    ${True}

# ====================================================================
&{BASIC_UE_SA_1}                    ue=1                                    profile=None        type=${None}
...                                 pdu=1                                   qfi=1
...                                 bearer=${None}                          testMode=False
...                                 trf_id=1                                burst=${None}
...                                 target_gnb=${None}                      target_cells=1
...                                 throughput=270                          testModeValue=csi_report_override
...                                 period_ms=${None}                       size=${None}

&{BASIC_UE_SA_2}                    ue=2                                   profile=None        type=${None}
...                                 pdu=2                                  qfi=1
...                                 bearer=${None}                          testMode=False
...                                 trf_id=2                                burst=${None}
...                                 target_gnb=${None}                      target_cells=1
...                                 throughput=270                          testModeValue=csi_report_override
...                                 period_ms=${None}                       size=${None}

&{UE_SIMPLE_TEST_NSA_11}            ue=11                                   profile=1           type=l3
...                                 pdu=${None}                             qfi=${None}
...                                 bearer=2                                testMode=False
...                                 trf_id=1                                burst=${None}
...                                 target_gnb=2                            target_cells=${TARGET_CELLS}
...                                 throughput=150                          testModeValue=csi_report_override
...                                 period_ms=${None}                       size=${None}

&{UE_SIMPLE_TEST_NSA_12}            ue=12                                   profile=1           type=l3
...                                 pdu=${None}                             qfi=${None}
...                                 bearer=2                                testMode=False
...                                 trf_id=2                                burst=${None}
...                                 target_gnb=2                            target_cells=${TARGET_CELLS}
...                                 throughput=150                          testModeValue=csi_report_override
...                                 period_ms=${None}                       size=${None}


@{UEs_SA_Liste}        ${BASIC_UE_SA_1}           ${BASIC_UE_SA_2}
@{UEs_NSA_Liste}       ${UE_SIMPLE_TEST_NSA_11}   ${UE_SIMPLE_TEST_NSA_12}

