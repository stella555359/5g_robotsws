# Variables for ue profile and traffic


#Variables for sherpa event 45 check

#Variables for trsInfo check

${trsInfo_0}               trsInfo=0
${trsInfo_1}               trsInfo=1

@{FIELDS_cell_cellsetupreq}                             physCellId        csirsPoolingGroupId
@{FIELDS_cell_cellsetupresp}             				nrCellIdentity    slotOffset
@{FIELDS_slot_offset}                                   slotOffset    nrCellIdentity
@{listToCheck_cell_16385}                               20      61    95
@{listToCheck_cell_16386}                               60      101   15
@{listToCheck_cell_16387}                               100     21    55
${nrCellid_16385}                                       16385
${nrCellid_16386}                                       16386
${nrCellid_16387}                                       16387
${text_offset_cell1_1}                                  Slot Offset Position for nrCellid 16385 are included in [RS1:20,
${text_offset_cell1_2}                                  RS2:61, RS4:95] if cell1 in PG0 or [RS1:100, RS2:21, RS4:55] if cell1 in PG2
${text_offset_cell3_1}                                  Slot Offset Position for nrCellid 16387 are included in [RS1:20,
${text_offset_cell3_2}                                  RS2:61, RS4:95] if cell3 in PG0 or [RS1:100, RS2:21, RS4:55] if cell3 in PG2


*** Keywords ***

TC 8940 Cell Setup
    [Documentation]        8940 Cell Setup
    [Arguments]            ${params}        ${Vendor_Param}
    Set Suite Variable     ${params}
    Init Sequence          ${params}
    Step                   Set RAD Params Of 8940
    Step                   CB008940-Config.Vendor File Config With Specific Settings     argument=${Vendor_Param}
    Step                   CB008940-Config.Update 8940 Params in OAM SCF And Recommissioning
    # Critical Step          Restart.F1 Wait Link Classical
    Step                   Restart.F1 Wait Link Classical
    # Step                   sleep    600s
    Step                   Multi Cells Setup 8940                 argument=${params.nbCell}
    Step                   Activate Sherpa On All Cells
    Step                   sleep    10s
    Step                   Stop Sherpa Collection
    Step                   5GC001227-Common_keywords.Check Sherpa RR Pooling Report Presence

TC 8940 check csi-rs for tracking
    [Documentation]        Check Scheduling and periodicity of the cell specific CSI-RS for Tracking Interworking with
    ...                    Paging OSI slots frame structure
    [Arguments]            ${params}        ${Vendor_Param}
    Set Suite Variable     ${params}
    Init Sequence          ${params}
    Step                   Set RAD Params Of 8940
    Step                   CB008940-Config.Vendor File Config With Specific Settings     argument=${Vendor_Param}
    Step                   CB008940-Config.Update 8940 Params in OAM SCF And Recommissioning
    Step                   Restart.F1 Wait Link Classical
    Step                   CB008940-B-Keywords.Start Capture on ASIB CPRT Container
    Step                   Multi Cells Setup 8940                 argument=${params.nbCell}
    Step                   CB008940-B-Keywords.Stop Capture on ASIB CPRT Container
    Step                   Activate Sherpa On All Cells
    Step                   sleep    10s
    Step                   Stop Sherpa Collection
    Step                   5GC001227-Common_keywords.Check Sherpa RR Pooling Report Presence
    Step                   Check csi pooling group
#    Step                   Check slot offset position
     Step                   Check slot offset position test lib
    Step                   Check TRS symbols


Suite Setup 8940

    [Documentation]
    ...     Conditions:     customs configurations yamlPathname
    ...     Actions:        it performs the generic suite setup and backup the configurations files
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        suite setup is passed
    [Arguments]             ${yamlPathname}=${EMPTY}

    Setup.Suite Setup from scratch        yamlPathname=${yamlPathname}
    ...                                   listBackupFiles=${FD_ALL}
    ...                                   keepAllUeDataInCfgFile=${True}

    Backup Files
    ${scf_suite_setup_backup}         OAM Get SCF File    file=SCF_Suite_Setup_Backup.xml
    Set Suite Variable      ${scf_suite_setup_backup}
    Dated Log               SCF backup file = ${scf_suite_setup_backup}

Check csi pooling group
    [Documentation]      Check that each cell is in different csi-rs pooling group starting from 0 to 2
    ...                  check is done in itf_l2_ps_cell_cellsetupreq packet using cprt traces.

    Dated Log    [Checking csirsPoolingGroupId In CPRT itf_l2_ps_cell_CellSetupReq depending on physCellId]
    Dated Log    ----> convert pcap to pdml with filter itf_l2_ps_cell_cellsetupreq ......
    Dated Log    ----> pcap file : ${CaptureCPRT_ASIB.path}

    ${CaptureCPRT_setupreq}         analyzer.filter_pcap
    ...                             pcapInFile=${CaptureCPRT_ASIB.path}
    ...                             filterName=filteredBymsg
    ...                             filterExp=itf_l2_ps_cell_cellsetupreq
    ${pdmlFile}                     analyzer.pcap_to_pdml      ${CaptureCPRT_setupreq}

    Dated Log    ----> filtred pcap file (itf_l2_ps_cell_cellsetupreq) : ${CaptureCPRT_setupreq}

    Dated log new line                      Getting some captured itf_l2_ps_cell_cellsetupreq on cell0
    @{itf_l2_ps_cell_cellsetupreq}          Get Packet Match List
    ...                                     pdmlFile=${pdmlFile}
    ...                                     packetName=itf_l2_ps_cell_CellSetupReq
    ...                                     pathList=${FIELDS_cell_cellsetupreq}
    ...                                     startPacket=${1}
    ...                                     endPacket=${1}
    Dated log new line                 - For cell0
    FOR     ${packet}   IN           @{itf_l2_ps_cell_cellsetupreq}
            ${physCellId_in_pcap}           Get Value In Packet Match
            ...                             packetMatch=${packet}
            ...                             field=physCellId

            ${csirsPoolingGroupId_in_pcap}             Get Value In Packet Match
            ...                                        packetMatch=${packet}
            ...                                        field=csirsPoolingGroupId
            Dated Log                  - physCellId=${physCellId_in_pcap}
            Dated Log                  - PoolingGroupId=${csirsPoolingGroupId_in_pcap}
            Dated Log                  - PoolingGroupId=${packet}
            should be true              ${physCellId_in_pcap}==0x00000032
            should be true              ${csirsPoolingGroupId_in_pcap}==0x00000000
    END

    Dated log new line                      Getting some captured itf_l2_ps_cell_cellsetupreq on cell1
    @{itf_l2_ps_cell_cellsetupreq}          Get Packet Match List
    ...                                     pdmlFile=${pdmlFile}
    ...                                     packetName=itf_l2_ps_cell_CellSetupReq
    ...                                     pathList=${FIELDS_cell_cellsetupreq}
    ...                                     startPacket=${2}
    ...                                     endPacket=${2}
    Dated log new line                  - For cell1
    FOR     ${packet}   IN           @{itf_l2_ps_cell_cellsetupreq}

            ${physCellId_in_pcap}           Get Value In Packet Match
            ...                             packetMatch=${packet}
            ...                             field=physCellId

            ${csirsPoolingGroupId_in_pcap}             Get Value In Packet Match
            ...                                        packetMatch=${packet}
            ...                                        field=csirsPoolingGroupId
            Dated Log                  - physCellId=${physCellId_in_pcap}
            Dated Log                  - PoolingGroupId=${csirsPoolingGroupId_in_pcap}
            should be true              ${physCellId_in_pcap}==0x00000033
            should be true              ${csirsPoolingGroupId_in_pcap}==0x00000001
    END

    Dated log new line                      Getting some captured itf_l2_ps_cell_cellsetupreq on cell2
    @{itf_l2_ps_cell_cellsetupreq}          Get Packet Match List
    ...                                     pdmlFile=${pdmlFile}
    ...                                     packetName=itf_l2_ps_cell_CellSetupReq
    ...                                     pathList=${FIELDS_cell_cellsetupreq}
    ...                                     startPacket=${3}
    ...                                     endPacket=${3}
    Dated log new line                  - For cell2
    FOR     ${packet}   IN           @{itf_l2_ps_cell_cellsetupreq}

            ${physCellId_in_pcap}           Get Value In Packet Match
            ...                             packetMatch=${packet}
            ...                             field=physCellId

            ${csirsPoolingGroupId_in_pcap}             Get Value In Packet Match
            ...                                        packetMatch=${packet}
            ...                                        field=csirsPoolingGroupId
            Dated Log                  - physCellId=${physCellId_in_pcap}
            Dated Log                  - PoolingGroupId=${csirsPoolingGroupId_in_pcap}
            should be true              ${physCellId_in_pcap}==0x00000034
            should be true              ${csirsPoolingGroupId_in_pcap}==0x00000002
    END

