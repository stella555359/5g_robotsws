...    NRBTS.bbL1SpPrbInitCapacity___ABIO___32___UL___NR_L1_Loki_TDD_FR1_eCPRI_IQF_Asymm.maxNumWbStreamPrbL1Sp=${NUM_MAX_WB_STREAM_PRB_L1_SP_UL_32}
...    NRBTS.bbL1SpPrbInitCapacity___ABIO___64___UL___NR_L1_Loki_TDD_FR1_eCPRI_IQF_Asymm.maxNumLayerPrbL1Sp=${NUM_MAX_LAYER_PRB_L1_SP_UL_64}
...    NRBTS.bbL1SpPrbInitCapacity___ABIO___64___UL___NR_L1_Loki_TDD_FR1_eCPRI_IQF_Asymm.maxNumStreamPrbL1Sp=${NUM_MAX_STREAM_PRB_L1_SP_UL_64}
...    NRBTS.bbL1SpPrbInitCapacity___ABIO___64___UL___NR_L1_Loki_TDD_FR1_eCPRI_IQF_Asymm.maxNumWbStreamPrbL1Sp=${NUM_MAX_WB_STREAM_PRB_L1_SP_UL_64}
...    NRBTS.bbL1SpPrbInitCapacity___ABIO___48___DL___NR_L1_Loki_TDD_FR1_eCPRI_IQF_Asymm.maxNumLayerPrbL1Sp=${NUM_MAX_LAYER_PRB_L1_SP}
