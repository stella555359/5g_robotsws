#vbo#debug#
#vbo#WA HIGH#

# Libraries

# Resources
Resource                                        ./resources/robot/CB009915-B-Keywords.robot

# Tags
Force Tags                                      CA_5G_SW_FR-Villarceaux    RRM    PY36
...                                             CLOUD_5G_I_LO_AP_LOOO_SANSA_FS_ECPRI_CMWV_TDD
...                                             master_classicalbts_all    SBTS00
...                                             CONFIGURED    5G_RAN    RAN_5G    CRT

# Suites
Suite Setup    CB009915-Common-Keywords.Suite Setup CB009915-Common    keep_all_data_in_file=${True}    #vbo#debug#in some cases#
Suite Teardown                                  CB009915-Common-Keywords.Suite Teardown CB009915-Common    #vbo#debug#

*** Variables ***

# capture setting
&{CAPTURE_L1L2}                                 is_capture_core=${False}    is_capture_cprt=${False}    is_capture_l1l2=${True}

# tests settings
&{CB009915_B_basic}                             act_blanking=${False}                   # blanking treatment is requested if parameter is true
...                                             capture_duration=0                      # capture duration during traffic starting phase
...                                             deviation=90                            # default deviation for throughput and double for uplink
...                                             dir=UL+DL
...                                             duration=3                              # traffic duration during declaration phase
...                                             pm_waiting_period=1                     # number of waiting periods added for observation
...                                             target_gnb=2                            # gnb target id
...                                             total_nb_cell=3                         # total number of cell used for ue's dispatching
...                                             total_nb_ue=0                           # total number of ue's to configure

&{CB009915_B2_4_IWK10}                          act_blanking=${False}    capture_duration=0    deviation=5    dir=UL+DL    duration=3
...                                             pm_waiting_period=1    target_gnb=2    total_nb_cell=2    total_nb_ue=0

&{CB009915_B2_5_IWK10}                          act_blanking=${False}    capture_duration=0    deviation=5    dir=DL    duration=3
...                                             pm_waiting_period=1    target_gnb=2    total_nb_cell=2    total_nb_ue=0

&{CB009915_B2_6_IWK10}                          act_blanking=${False}    capture_duration=0    deviation=5    dir=DL    duration=3
...                                             pm_waiting_period=1    target_gnb=2    total_nb_cell=2    total_nb_ue=0

# ue's settings # configuration based chBW=100MHz wo/ blanking
&{dict_settings_ue_9_1}                         original_cell=1                         # original cell for call establishment
...                                             throughput=351                          # dl throughput nonGBR max for ue in chBW=100MHz wo/blanking
...                                             throughput_gbr=10                       # throughput GBR for ue or ${NO_THROUGHPUT}
...                                             throughput_ul=91                        # ul throughput nonGBR max for ue in chBW=100MHz wo/blanking
&{dict_settings_ue_9_2}                         original_cell=2    throughput=352    throughput_gbr=10    throughput_ul=92
&{dict_settings_ue_9_3}                         original_cell=3    throughput=353    throughput_gbr=10    throughput_ul=93
&{dict_settings_ue_9_4}                         original_cell=1    throughput=354    throughput_gbr=${NO_THROUGHPUT}    throughput_ul=94
&{dict_settings_ue_9_5}                         original_cell=2    throughput=355    throughput_gbr=${NO_THROUGHPUT}    throughput_ul=95
&{dict_settings_ue_9_6}                         original_cell=3    throughput=356    throughput_gbr=${NO_THROUGHPUT}    throughput_ul=96
&{dict_settings_ue_default}                     original_cell=1    throughput=1    throughput_gbr=${NO_THROUGHPUT}    throughput_ul=1
@{dict_settings_B_basic}                        ${dict_settings_ue_9_1}    ${dict_settings_ue_9_2}    ${dict_settings_ue_9_3}
...                                             ${dict_settings_ue_9_4}    ${dict_settings_ue_9_5}    ${dict_settings_ue_9_6}

