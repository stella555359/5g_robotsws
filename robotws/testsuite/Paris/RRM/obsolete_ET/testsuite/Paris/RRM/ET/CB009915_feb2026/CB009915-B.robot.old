*** Test Cases ***
[1]CB009915-B2-5_IWK10_with_power_saving
    [Documentation]
    ...     Conditions:     it is based on the configuration ${CB009915_B2_5_IWK10}
    ...     Actions:        it performs the call setup for multi ue's on different cells
    ...     Checks:         it checks nothing more than already done on lib
    ...     Verdict:        the constraints on counters and KPIs are passed

    ${CB009915_B2_5_IWK10.act_blanking}=           Set Variable    ${True}
    ${CONFIG_BLANKING_B_100MHZ_default.nbBlankedPRBsHighEdge}=      Create List         0    12
    ${CONFIG_BLANKING_B_100MHZ_default.nbBlankedPRBsLowEdge}=       Create List         5    14
    Apply Custom Config    scfc=${CURDIR}/config/custom/CB009915_B_B2/scf_240102_1539_CB009915_B2_5_PS40_LG100_BLANKING.xml
    ...                                         iphy=${CURDIR}/config/custom/CB009915_B_B2/iphy_231128_1026_CB009915_B2_7864.xml
    ...                                         cfg=${CURDIR}/config/custom/CB009915_B_B2/basic_setup_sa_power_saving_capable.cfg
    ...                                         rad_params=${EMPTY}
    ...                                         vendor_params=${EMPTY}

    CB009915_B2_5_IWK_power_saving_SA           config_blanking=${CONFIG_BLANKING_B_100MHZ_default}
    ...                                         dict_ues=${dict_settings_B2_5}
    ...                                         is_capture=${CAPTURE_L1L2}
    ...                                         param=${CB009915_B2_5_IWK10}
    ...                                         test_name=TC_CB009915_B2_5_IWK10_power_saving_SA
    [Teardown]                                  Setup.Test Teardown
