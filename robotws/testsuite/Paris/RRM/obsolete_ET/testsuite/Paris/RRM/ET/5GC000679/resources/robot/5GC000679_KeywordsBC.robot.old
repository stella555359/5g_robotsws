*** Settings ***
Documentation     [PURPOSE] Set of keywords used for 5GC000679 feature FDD tests cases
...               Modified Date               : 20-Apr-2023
...               Last Modified by            : vincent.boulet@nokia.com
...                                         - Remove SWconfig, limit traffic deviation and update for shortPucch conf
...               ML-Leborgne and M. Hummel - Adaptations for VRAN2.0
...               vincent.boulet@nokia.com  - Correction for capturing Sherpa in case of VRAN
...               vincent.boulet@nokia.com  - Capturing the Sherpa trace by iteration loop
...               vincent.boulet@nokia.com  - Removing obsolete waiting time
...               vincent.boulet@nokia.com  - Introduction of 2 new counters related to the number of UEs scheduled per slot in DL excluding paging
...               16/04/2024 - vincent.boulet@nokia.com - Parity testing to introduce dRNIC RINLINE2 CLOUD_5GC_dRNIC_1vDU_P_AP_LO_DC


Resource          5GC000679_Keywords.robot

*** Variables ***
&{Test_BC}        seq=${T_BC}         checkPucch=${False}       scfFile=${scf100MHz}     captureName=BC
...               filtermsg=@{ListOfMsgTrf}      setUecapabilities=${False}     dtxLimit=10     crcLimit=10
...               allowShortPucchConfig=${False}
&{Test_BC_1857}   seq=${T_BC_1857}    checkPucch=${False}       scfFile=${scf100MHz}      captureName=BC
...               filtermsg=@{ListOfMsgTrf}      setUecapabilities=${True}     dtxLimit=10    crcLimit=10
...               allowShortPucchConfig=${False}

&{T_BC}           feature679=${True}       totalUE=4     loop=1      bandwidth=100    technology=TDD
...               throughput=50    trafficDuration=10   captureDuration=10    stopTraffic=${False}    dirTraffic=dl
...               deviation=90
&{T_BC_1857}      feature679=${True}       totalUE=1     loop=1      bandwidth=100    technology=TDD
...               throughput=50   trafficDuration=10   captureDuration=10    stopTraffic=${False}     dirTraffic=dl
...               deviation=90

${TestSharkTool}                    MC_SHARK

*** Keywords ***
Run Test 679 BC
    [Arguments]                      ${testParam}
    Get Pucch Mode Select
    Test Setup 679 BC                ${testParam}
    Restart TL
    WTS Preparation 679 BC           ${testParam}
    Test 679 Loop BC                 ${testParam}

Test 679 Loop BC
    [Arguments]                      ${testParam}
    Dated log                        Start Test:Name=${TEST_NAME}
    FOR    ${index}    IN RANGE     1        ${testParam.seq.loop}+1
            Run Keyword If           ${enable_sherpa}==${True}             Activate Sherpa
            Attach UE Multi          ${testParam}
            ${trafficPcap}           Start Traffic Multi UE with Filter    ${testParam}
            Run keyword if           ${testParam.seq.stopTraffic}==${False}
            ...                      Stop Traffic Multi UE                 ${testParam}
            sleep                    3s
            Detach UE Multi          ${testParam.seq.totalUE}
            Set Test Variable        ${TRAFFIC_PCAP.pcapTrf${index}}       ${trafficPcap}
            Dated Log                TRAFFIC_PCAP.pcapTrf=${TRAFFIC_PCAP.pcapTrf${index}}
            Run Keyword If           ${enable_sherpa}==${True}    Run Keywords    Deactivate Sherpa and Stop Collect
            ...    AND               Upload and decode sherpa pcap files    Sherpa_logs_local_path=${trace_dir}    duration=0
            Check Traffic Quality    pcapInput=${TRAFFIC_PCAP.pcapTrf${index}}    index=${index}
            ...                      dtxLimit=${testParam.dtxLimit}
            ...                      crcLimit=${testParam.crcLimit}
            ...                      direction=${testParam.seq.dirTraffic}
            Check Feature BC         ${TRAFFIC_PDML.pdmlTrf${index}}       ${testParam}
            Run Keyword If           ${isAic}    Check Feature BC Counter    ${testParam}
    END

Check Feature BC
    [Arguments]              ${pdmlFile}
    ...                      ${testParam}
    Dated Log                Check PRB allocation in ${pdmlFile}
    Check Prb Allocation with rat0bitmap    pdmlFile=${pdmlFile}
    Run Keyword If     ${testParam.setUecapabilities}
    ...                Check UeCapabilities    pdmlFile=${pdmlFile}       dirTraffic=${testParam.seq.dirTraffic}

WTS Preparation 679 BC
    [Arguments]       ${testParam}
    Run Keyword If    ${testParam.setUecapabilities}
    ...               Set UE capa on EPCSim           ue_nr_capa_value=${ue_nr_capa_onePortsPTRS_10_fr1}
    WTS Setup         nbUe=${testParam.seq.totalUE}        shouldUseLua=${True}

Test Setup 679 BC
   [Arguments]        ${testParam}
   Run Keyword If     ${testParam.setUecapabilities}      Set SCF BC UeCapabilities       ${testParam}
   ...                ELSE                                Set SCF TDD Counter             ${testParam}

Set SCF BC Short Pucch Configuration
    Dated Log new line         pucchModeSelect is ${pucchModeSelect} then change configuration to short Pucch
    SCF Set element            dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRBTS_ID}
    ...                        element_name=pucchModeSelect
    ...                        element_value=shortPucch
    # BWP_PROFILE dedicated PDCCH
    ${dist_name}               Get Distance Name Profile
    ...                        endClassParent=BWP_PROFILE
    ...                        endClassChild=PDCCH
    ...                        bwpTypeValue=dedicated
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=alSelection
    ...                        element_value=static
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciDedicatedAggregationLevel
    ...                        element_value=AL4
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciPagingAggregationLevel
    ...                        element_value=AL4
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciRaCompletionAggregationLevel
    ...                        element_value=AL4
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciRaMsg2AggregationLevel
    ...                        element_value=AL4
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciSiAggregationLevel
    ...                        element_value=AL4
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=downgradeAL16toAL8
    ...                        element_value=notAllowed
    # BWP_PROFILE dedicated PDCCH_CONFIG_COMMON
    ${dist_name}               Get Distance Name Profile
    ...                        endClassParent=BWP_PROFILE
    ...                        endClassChild=PDCCH_CONFIG_COMMON
    ...                        bwpTypeValue=dedicated
    # searchSpaceCommon
    ${list_name}               Set Variable              searchSpaceCommon
	SCF Remove list            dist_name=${dist_name}    list_name=${list_name}
	SCF Add list               dist_name=${dist_name}    list_name=${list_name}
	&{searchSpaceCommon_e}     Create Dictionary         coresetId=0
	...                                                  dciFormat=formats0-0-And-1-0
	...                                                  duration=3
	...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL16=n1
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n4
    ...                                                  numOfPdcchCandidatesInAL8=n2
    ...                                                  periodicity=sl5
    ...                                                  searchSpaceId=4
    ...                                                  searchSpaceType=Type0A
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
	&{searchSpaceCommon_e}     Create Dictionary         coresetId=0
	...                                                  dciFormat=formats0-0-And-1-0
	...                                                  duration=1
	...                                                  monitoringSymbolWithinSlot=symbol_0_1
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n4
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n0
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=5
    ...                                                  searchSpaceType=Type1
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
	&{searchSpaceCommon_e}     Create Dictionary         coresetId=0
	...                                                  dciFormat=formats0-0-And-1-0
	...                                                  duration=3
	...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL16=n1
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n4
    ...                                                  numOfPdcchCandidatesInAL8=n2
    ...                                                  periodicity=sl5
    ...                                                  searchSpaceId=6
    ...                                                  searchSpaceType=Type2
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
	# BWP_PROFILE dedicated PDCCH_CONFIG_DEDICATED
    ${dist_name}               Get Distance Name Profile
    ...                        endClassParent=BWP_PROFILE
    ...                        endClassChild=PDCCH_CONFIG_DEDICATED
    ...                        bwpTypeValue=dedicated
	# coresetDedicated
    ${list_name}               Set Variable              coresetDedicated
	SCF Remove list            dist_name=${dist_name}    list_name=${list_name}
	SCF Add list               dist_name=${dist_name}    list_name=${list_name}
	&{searchSpaceCommon_e}     Create Dictionary         cceToRegMapping=nonInterleaved
	...                                                  coresetId=1
	...                                                  cRbStart=0
	...                                                  duration=1
    ...                                                  interleaverSize=none
    ...                                                  regBundleSize=n6
    ...                                                  size=192
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    # searchSpaceDedicated
    ${list_name}               Set Variable              searchSpaceDedicated
	SCF Remove list            dist_name=${dist_name}    list_name=${list_name}
	SCF Add list               dist_name=${dist_name}    list_name=${list_name}
	&{searchSpaceCommon_e}     Create Dictionary         coresetId=0
	...                                                  dciFormat=formats0-0-And-1-0
	...                                                  duration=1
	...                                                  monitoringSymbolWithinSlot=symbol_0_1
    ...                                                  numOfPdcchCandidatesInAL1=n0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n2
    ...                                                  numOfPdcchCandidatesInAL8=n0
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=7
    ...                                                  searchSpaceType=Type3
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
	&{searchSpaceCommon_e}     Create Dictionary         coresetId=1
	...                                                  dciFormat=formats0-1-And-1-1
	...                                                  duration=1
	...                                                  monitoringSymbolWithinSlot=symbol_0_1
    ...                                                  numOfPdcchCandidatesInAL1=n0
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n5
    ...                                                  numOfPdcchCandidatesInAL8=n0
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=8
    ...                                                  searchSpaceType=UE-Specific
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
    # BWP_PROFILE initial PDCCH
    ${dist_name}               Get Distance Name Profile
    ...                        endClassParent=BWP_PROFILE
    ...                        endClassChild=PDCCH
    ...                        bwpTypeValue=initial
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=alSelection
    ...                        element_value=static
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciDedicatedAggregationLevel
    ...                        element_value=AL4
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciPagingAggregationLevel
    ...                        element_value=AL4
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciRaCompletionAggregationLevel
    ...                        element_value=AL4
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciRaMsg2AggregationLevel
    ...                        element_value=AL4
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=dciSiAggregationLevel
    ...                        element_value=AL4
    SCF Set element            dist_name=${dist_name}
    ...                        element_name=downgradeAL16toAL8
    ...                        element_value=notAllowed
    # BWP_PROFILE initial PDCCH_CONFIG_COMMON
    ${dist_name}               Get Distance Name Profile
    ...                        endClassParent=BWP_PROFILE
    ...                        endClassChild=PDCCH_CONFIG_COMMON
    ...                        bwpTypeValue=initial
    # searchSpaceCommon
    ${list_name}               Set Variable              searchSpaceCommon
	SCF Remove list            dist_name=${dist_name}    list_name=${list_name}
	SCF Add list               dist_name=${dist_name}    list_name=${list_name}
	&{searchSpaceCommon_e}     Create Dictionary         coresetId=0
	...                                                  dciFormat=formats0-0-And-1-0
	...                                                  duration=3
	...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL16=n1
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n4
    ...                                                  numOfPdcchCandidatesInAL8=n2
    ...                                                  periodicity=sl5
    ...                                                  searchSpaceId=1
    ...                                                  searchSpaceType=Type0A
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
	&{searchSpaceCommon_e}     Create Dictionary         coresetId=0
	...                                                  dciFormat=formats0-0-And-1-0
	...                                                  duration=1
	...                                                  monitoringSymbolWithinSlot=symbol_0_1
    ...                                                  numOfPdcchCandidatesInAL16=n0
    ...                                                  numOfPdcchCandidatesInAL2=n4
    ...                                                  numOfPdcchCandidatesInAL4=n4
    ...                                                  numOfPdcchCandidatesInAL8=n0
    ...                                                  periodicity=sl1
    ...                                                  searchSpaceId=2
    ...                                                  searchSpaceType=Type1
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}
	&{searchSpaceCommon_e}     Create Dictionary         coresetId=0
	...                                                  dciFormat=formats0-0-And-1-0
	...                                                  duration=3
	...                                                  monitoringSymbolWithinSlot=symbol_0
    ...                                                  numOfPdcchCandidatesInAL16=n1
    ...                                                  numOfPdcchCandidatesInAL2=n0
    ...                                                  numOfPdcchCandidatesInAL4=n4
    ...                                                  numOfPdcchCandidatesInAL8=n2
    ...                                                  periodicity=sl5
    ...                                                  searchSpaceId=3
    ...                                                  searchSpaceType=Type2
    ...                                                  slotOffset=0
    SCF Add items to list      dist_name=${dist_name}    list_name=${list_name}   elements=${searchSpaceCommon_e}

Set SCF BC UeCapabilities
    [Arguments]          ${testParam}
    Copy File            ${SCF_SETUP_PATH}     ${SCF_SETUP_PATH}.ori_AB
    SCF StartSession     scf_file=${SCF_SETUP_PATH}
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRBTS_ID}
    ...                  element_name=chBw
    ...                  element_value=${testParam.scfFile.chBw}
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...                  element_name=actFdmScheduling
    ...                  element_value=${testParam.scfFile.actFdmScheduling}
#    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRBTS_ID}
#    ...                  element_name=frequencyDensityThresNrb0
#    ...                  element_value=${frequencyDensityThresNrb0}
#    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRBTS_ID}
#    ...                  element_name=frequencyDensityThresNrb1
#    ...                  element_value=${frequencyDensityThresNrb1}
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRBTS_ID}
    ...                  element_name=actDlPtrs    element_value=true
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRBTS_ID}
    ...                  element_name=actUlPtrs    element_value=true
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRBTS_ID}
    ...                  element_name=dlPtrsFreqDensityThresNrb0
    ...                  element_value=${dlPtrsFreqDensityThresNrb0}
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRBTS_ID}
    ...                  element_name=dlPtrsFreqDensityThresNrb1
    ...                  element_value=${dlPtrsFreqDensityThresNrb1}
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRBTS_ID}
    ...                  element_name=ulPtrsFreqDensityThresNrb0
    ...                  element_value=${ulPtrsFreqDensityThresNrb0}
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRBTS_ID}
    ...                  element_name=ulPtrsFreqDensityThresNrb1
    ...                  element_value=${ulPtrsFreqDensityThresNrb1}
    Run Keyword If       ${testParam.allowShortPucchConfig} == ${True} and '${pucchModeSelect}[0]' == 'longPucch'
    ...                  Set SCF BC Short Pucch Configuration
    SCF StopSession      scf_file=${SCF_SETUP_PATH}
    Dated Log    ----> Modifications completed.\n

    Oam.OAM Perform Full Commissioning          scf_file=${SCF_SETUP_PATH}
    WA Airscale Wait For Ready                  ${GNB_DU}

Set SCF TDD Counter
    [Arguments]          ${testParam}
    ...                  ${destIpAddr_value}=10.0.1.1
    ...                  ${gateway_value}=172.16.2.101
    Copy File            ${SCF_SETUP_PATH}     ${SCF_SETUP_PATH}.ori_AB
    Run Keyword If       ${isAic}
    ...                  Copy File            ${SCF_CU_SETUP_PATH}     ${SCF_CU_SETUP_PATH}.ori_AB
    SCF StartSession     scf_file=${SCF_SETUP_PATH}        second_scf_file=${SCF_CU_SETUP_PATH}
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${NRCELL_ID}
    ...                  element_name=chBw
    ...                  element_value=${testParam.scfFile.chBw}
    ...                  aicListEntity=vduvcu       scope=both      bestEffort=${True}
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ...                  element_name=actFdmScheduling
    ...                  element_value=${testParam.scfFile.actFdmScheduling}
    ...                  aicListEntity=vduvcu       scope=both      bestEffort=${True}
    SCF Set element      dist_name=MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/PMCADM-1
    ...                  element_name=reportingIntervalPm
    ...                  element_value=${testParam.scfFile.reportingIntervalPm}
    ...                  aicListEntity=vduvcu       scope=both      bestEffort=${True}
    Run Keyword If       ${testParam.allowShortPucchConfig} == ${True} and '${pucchModeSelect}[0]' == 'longPucch'
    ...                  Set SCF AA Short Pucch Configuration
    #vbo# adding route on VDU for capture Sherpa for VRAN#
    SCF StopSession      scf_file=${SCF_SETUP_PATH}        second_scf_file=${SCF_CU_SETUP_PATH}
    Dated Log    ----> Modifications completed.\n

    Oam.OAM Perform Full Commissioning          scf_file=${SCF_SETUP_PATH}

    Run Keyword If                  ${isAic}                       Oam.OAM Perform Full Commissioning
    ...                             scf_file=${SCF_CU_SETUP_PATH}           oam=${GNB_CU.oam}

    Run Keyword If                  not ${isAic}
    ...                             WA Airscale Wait For Ready                  ${GNB_DU}
#vbo# Introduction of 2 new counters related to the number of UEs scheduled per slot in DL excluding paging#
Check Feature BC Counter
    [Arguments]              ${testParam}
    Dated Log                Check test counter
    Traced Sleep             ${testParam.scfFile.reportingIntervalPm}
    ${date}                  Get Current Date
    ${date_in_dir_name}      Convert Date         ${date}    result_format=%d%m%Y_%H%M
    ${log_path_pm}           Set Variable         ${LOG_PATH}/PM_${date_in_dir_name}
    # Activate debug mode via ${SUITE_DEBUG_MODE}
    Set Debug Mode
    ${pm_latest}             Run Keyword If       not ${isAic}    Collect PM files from BTS    ${log_path_pm}
    #vbo# M55308C10009#
    ${myexpected_val}=       Set Variable         4
    ${mycomparison}=         Set Variable         '=='
    ${foundOrNot}            Check Counter FDM    ${log_path_pm}    ${myexpected_val}    ${mycomparison}    &{M55308C10009}
    Log Counter FDM          counter=&{M55308C10009}    expectedValue=${myexpected_val}    result=${foundOrNot}
    #vbo# M55308C10010#
    ${myexpected_val}=       Run Keyword If       not ${isAic}    Set Variable    100000
    ...                                  ELSE                     Set Variable    90000
    ${mycomparison}=         Set Variable         '>='
    ${foundOrNot}            Check Counter FDM    ${log_path_pm}    ${myexpected_val}    ${mycomparison}    &{M55308C10010}
    Log Counter FDM          counter=&{M55308C10010}    expectedValue=${myexpected_val}    result=${foundOrNot}
