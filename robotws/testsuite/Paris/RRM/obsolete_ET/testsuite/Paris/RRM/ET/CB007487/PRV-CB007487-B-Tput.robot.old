    ...                                                     TrafficDuration=60
    ...                                                     DLthroughput=1100
    # ...                                                     DLthroughput=0
    ...                                                     ULthroughput=200
    ...                                                     deviation=10
    ...                                                     shouldBeStop=False
    ...                                                     shouldBeCheck=False
    ...                                                     w_UE_CSI_TM_for_4_4_DL_MIMO=True
    # ...                                                     GetTtiTraceTime=3s
    ...                                                     GetTtiTraceTime=0
    ...                                                     GetL1L2TraceTime=0
    # ...                                                     GetL1L2TraceTime=1s
    ...                                                     num_of_cells_cellsetup=2
