PRV_TC5_CB007487_B_23_B12_Call_Setup_Success_Rate_NSA_Restricted_Cell2
    [Tags]    NSA   CELL2   FULL_RUN
    [Documentation]  TC under QC : CB007487_B_23_B12_Call_Setup_Success_Rate_NSA_Restricted_Cell2
    ...            => Perform 10 successive NSA Call Setup/Call Release in Cell2, each call performing 30 seconds of low UL/DL traffic.
    ...            5G TDD cell is in "OnAir" state.
    ...            AES encryption is configured.
    ...            To activate AES ciphering, under NRBTS/cipherPrefL list, set nea2_128 to 1 and other parameters to 0.
    ...            actDl256Qam is set to false.
    ...            MCS is forced to MCS3 through following R&D parameters:
    ...            - rdSupportedDl64QamMcs 0x58000f
    ...            - rdSupportedUlMCS 0x580010
    ...            set w_UE_CSI_TM_for_4_4_DL_MIMO=True to Activate ue csi TM with cqi reported = 15 and RI reported = 3
    ...            => means BENCHMARK_ID = 4 is used for this testcase
    ${BENCHMARK_ID}    set variable     4
    # BENCHMARK_ID=12 mean without Cyphering
    # ${BENCHMARK_ID}    set variable     12
    Dated log     BENCHMARK_ID is ${BENCHMARK_ID}
    set Test Variable      ${current_BM_CB007487_B}    ${dict_BM["${BENCHMARK_ID}"]}
    Dated log  ====> TC ${TEST NAME} running with ${current_BM_CB007487_B}
    ${w_UE_CSI_TM_for_4_4_DL_MIMO}=   set Variable if   '${current_BM_CB007487_B.DL_MIMO}'=='4x4'    True
    ...                                                                                              False
    # zuc and snow3G shall not be used for TPut higher than 25Mbps as they computationally intensive algorithms
    # and are supported by Airphone only for functional tests.
    ${DLTput_Target}=    set Variable if    '${current_BM_CB007487_B.Encrypt}'=='snow' or '${current_BM_CB007487_B.Encrypt}'=='zuc'    100
    ...                                                                                                                                1100
    ${ULTput_Target}=    set Variable if    '${current_BM_CB007487_B.Encrypt}'=='snow' or '${current_BM_CB007487_B.Encrypt}'=='zuc'    100
    ...                                                                                                                                200
    &{dictParam}                    Create Dictionary       loopNb=10
    ...                                                     UEnb=1
    ...                                                     CallType=NSA
    ...                                                     Cell=2
    ...                                                     TrafficDuration=30
    ...                                                     DLthroughput=${DLTput_Target}
    ...                                                     ULthroughput=${ULTput_Target}
    ...                                                     deviation=10
    ...                                                     shouldBeStop=False
    ...                                                     shouldBeCheck=False
    ...                                                     w_UE_CSI_TM_for_4_4_DL_MIMO=${w_UE_CSI_TM_for_4_4_DL_MIMO}
    ...                                                     GetTtiTraceTime=3s
    # ...                                                     GetTtiTraceTime=0
    ...                                                     GetL1L2TraceTime=0
    # ...                                                     GetL1L2TraceTime=1s
    ...                                                     num_of_cells_cellsetup=2
    ...                                                     w_ue_detach=True
    ...                                                     GetBtsLog=1
    ...                                                     isOAMRebooted=False
    ...                                                     w_Block_unBlock_Cell=False
    ...                                                     w_Get_Mem_Usage=True

    # Ue Capa update in cfg file
    Modify maxNumberMIMO-LayersPDSCH Ue Capa for WTS     ue_nr_capa_value=${ue_nr_capabilities_maxNumberMIMO_4_LayersPDSCH_NSA}
    ...                                                  ue_ue_eutra_nr_capa=${ue_ue_eutra_nr_capabilities_maxNumberMIMO_4_LayersPDSCH_NSA}
    ${msg}   Catenate   "${current_BM_CB007487_B}"
    ${tc_name}    Set variable    Test Case Setup
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'
    ...          Testline_settings   ${current_BM_CB007487_B}   CellId=2
    CB007487-B_Attach_Traffic      ${dictParam}   ${msg}

