${ShuttingDown_}  regex"ShuttingDown|Shutting Down"
${Dependency_}  regex"Dependency|dependency"
${PowerOff_}  regex"PowerOff|power off"
${Testing_}  regex"Testing|testing"
${Initializing_}  regex"Initializing|initializing"
${Commissioned_}  regex"Commissioned|commissioned"
${NotCommissioned_}  regex"NotCommissioned|notCommissioned"
${IntegratedToRan_}  regex"IntegratedToRan|integrated to RAN"
${OnAir_}  regex"OnAir|onAir"
${OnAirDone_}  regex"OnAirDone|onAirDone"
${Test_}  regex"Test|test"
${Configured_}  regex"Configured|configured"
${IntegratedToRan_Configured_}  regex"IntegratedToRan|integrated to RAN|Configured|configured"
${Blocked_}  Blocked
${Unblocked_}  Unblocked
${Blocking_}  Blocking
${Unblocking_}  Unblocking
${Idle_}  Idle
${Active_}  Active
${Disabled_Enabled_}  regex"Disabled|disabled|Enabled|enabled"

*** Test Cases ***

# for This test , need to:
# - Prepare the TL  (modify / adapt UE capa to support 4 Layers)
# - Ciphering and integrity protection at PDCP : zuc and snow3G shall not be used for TPut higher than 25Mbps
# as they computationally intensive algorithms and are supported by Airphone only for functional tests.
# AES should be the preferred algorithm. The ciphering algorithm preference shall be updated on the gNB side using the parameter "cipherPrefL"
# With AES ciphering algorithm, downlink throughput shall be restricted to 1.2Gbps in SA and 1Gbps in NSA in default UTE cloud VM used for WTS.
# Once the ciphering offload is enabled by default from QT, the limitation for SA shall be removed.
# Ciphering offload will be enabled once the work item planned in FPB-743673.
# For NSA the limitation at 1Gbps will remain as is as there are no plans to increase the EPCSIM TPut with default UTE cloud VM used for WTS.
# - set w_UE_CSI_TM_for_4_4_DL_MIMO=True to Activate ue csi TM with cqi reported = 15 and RI reported = 3

# Test
#      [Tags]   TEST
#     Dated log    TAGS=@{TEST TAGS}
#      ${current_BM_CB007487_B}=   set Variable      ${dict_BM["${BENCHMARK_ID}"]}
#     # MaxMIMO-Layers RAD activation
#     Dated log  ====> TC1 running with ${current_BM_CB007487_B}
#      scf.load_scf    ${test_scf_file}
#      Modify Channels to support 4DL4UL nrCellType    ${current_BM_CB007487_B}  1
#      Modify Channels to support 4DL4UL nrCellType    ${current_BM_CB007487_B}  2
#      scf.save_scf    ${test_scf_file}

#       ${Need_to_Perform_Commissioning_1}  set Variable   ${True}
#       ${Need_to_Perform_Commissioning_2}  set Variable   ${False}
#       ${Need_to_Perform_Commissioning_3}  set Variable   ${False}
#       ${Need_to_Perform_Commissioning_4}  set Variable   ${True}

#       ${Commissioning_1}  Evaluate   ${Need_to_Perform_Commissioning_1}==${True} or ${Need_to_Perform_Commissioning_2}==${True}
#       ${Commissioning_2}  Evaluate   ${Need_to_Perform_Commissioning_3}==${True} or ${Need_to_Perform_Commissioning_4}==${True}
#       Run Keyword if   ${Commissioning_1}==${True} or ${Commissioning_2}==${True}       Dated log    Commissioning SCF with ${test_scf_file}
#       ${msg}   Catenate   "TC Test: sw release used [${current_gNB_sw_version}]"
#      Dated log   ${msg} Done

Test Case Setup
    [Tags]    NSA  SA  CELL1  CELL2  FULL_RUN
    Dated log     BENCHMARK_ID is ${BENCHMARK_ID}
    set Suite Variable    ${current_BM_CB007487_B}  ${dict_BM["${BENCHMARK_ID}"]}
    Dated Log new line  ${consTraceColor}====> TC ${TEST NAME} running with :\n\t\t${current_BM_CB007487_B} ${defColor}
    # test that cipher and Integrity is configured in scf as expected
    ${cypher_OK}=   Evaluate   '${higher_cipher}'=='${current_BM_CB007487_B.Encrypt}'
    ${msg_err}=   Catenate     ${consTraceColorRed} Cypher configured in SCF [${higher_cipher}] is not as
    ...                                                    EXPECTED [expected=${current_BM_CB007487_B.Encrypt}]  => Need to update ${defColor}
    Run Keyword if   '${cypher_OK}'=='False'
    ...                       Dated log  ${msg_err}
    ...  ELSE                 Dated log  Cypher configured in SCF [${higher_cipher}] is as Expected [expected=${current_BM_CB007487_B.Encrypt}]
    ${integrity_OK}=   Evaluate   '${higher_Integrity}'=='${current_BM_CB007487_B.Encrypt}'
    ${msg_err}=   Catenate     ${consTraceColorRed} Integrity configured in SCF [${higher_Integrity}] is not as
    ...                                                    EXPECTED [expected=${current_BM_CB007487_B.Encrypt}] => Need to update ${defColor}
    Run Keyword if  '${integrity_OK}'=='False'
    ...                 Dated log  ${msg_err}
    ...  ELSE           Dated log  Integrity configured in SCF [${higher_Integrity}] is as Expected [expected=${current_BM_CB007487_B.Encrypt}]
    ${Need_to_Perform_Commissioning_1}  ${Need_to_Perform_Commissioning_2}  CB007487-B_Testline_settings   ${current_BM_CB007487_B}   CellId=1
    ${Need_to_Perform_Commissioning_3}  ${Need_to_Perform_Commissioning_4}  CB007487-B_Testline_settings   ${current_BM_CB007487_B}   CellId=2
    ...                                                                                                    Need_To_Update_CellMapping_Cell1=${True}
    ${Commissioning_1}  Evaluate   ${Need_to_Perform_Commissioning_1}==${True} or ${Need_to_Perform_Commissioning_2}==${True}
    ${Commissioning_2}  Evaluate   ${Need_to_Perform_Commissioning_3}==${True} or ${Need_to_Perform_Commissioning_4}==${True}
    Run Keyword if   ${Commissioning_1}==${True} or ${Commissioning_2}==${True}       Commissioning SCF  ${test_scf_file}
    Run Keyword and ignore Error    Update_Private_variables_Suite_setup

PRV_TC1_CB007487_B_NSA_Cell1_DL_UL_maxTput
    [Tags]    NSA   CELL1   FULL_RUN
    [Documentation]   Need to prepare the TL MANUALLY (modify / adapt UE capa to support 4 Layers)
    ...               Ciphering and integrity protection at PDCP : zuc and snow3G shall not be used for TPut higher than 25Mbps
    ...               set w_UE_CSI_TM_for_4_4_DL_MIMO=True to Activate ue csi TM with cqi reported = 15 and RI reported = 3
    Dated log     BENCHMARK_ID is ${BENCHMARK_ID}
    set Test Variable      ${current_BM_CB007487_B}   ${dict_BM["${BENCHMARK_ID}"]}
    Dated log  ====> TC ${TEST NAME} running with ${current_BM_CB007487_B}
    ${w_UE_CSI_TM_for_4_4_DL_MIMO}=   set Variable if   '${current_BM_CB007487_B.DL_MIMO}'=='4x4'    True
    ...                                                                                              False
    # zuc and snow3G shall not be used for TPut higher than 25Mbps as they computationally intensive algorithms
    # and are supported by Airphone only for functional tests.
    ${DLTput_Target}=    set Variable if    '${current_BM_CB007487_B.Encrypt}'=='snow' or '${current_BM_CB007487_B.Encrypt}'=='zuc'    100
    ...                                                                                                                                1100
    ${ULTput_Target}=    set Variable if    '${current_BM_CB007487_B.Encrypt}'=='snow' or '${current_BM_CB007487_B.Encrypt}'=='zuc'    100
    ...                                                                                                                                200
    &{dictParam}                    Create Dictionary       loopNb=1
    ...                                                     UEnb=1
    ...                                                     CallType=NSA
    ...                                                     Cell=1
    ...                                                     TrafficDuration=60
    ...                                                     DLthroughput=${DLTput_Target}
    ...                                                     ULthroughput=${ULTput_Target}
    ...                                                     deviation=10
    ...                                                     shouldBeStop=False
    ...                                                     shouldBeCheck=False
    ...                                                     w_UE_CSI_TM_for_4_4_DL_MIMO=${w_UE_CSI_TM_for_4_4_DL_MIMO}
    ...                                                     GetTtiTraceTime=3s
    # ...                                                     GetTtiTraceTime=0
    ...                                                     GetL1L2TraceTime=0
    # ...                                                     GetL1L2TraceTime=1s
    # ...                                                     num_of_cells_cellsetup=2
    ...                                                     num_of_cells_cellsetup=2
    ...                                                     w_ue_detach=False
    ...                                                     GetBtsLog=1
    ...                                                     isOAMRebooted=False
    ...                                                     w_Block_unBlock_Cell=False
    ...                                                     w_Get_Mem_Usage=False

    # Ue Capa update in cfg file
    Modify maxNumberMIMO-LayersPDSCH Ue Capa for WTS     ue_nr_capa_value=${ue_nr_capabilities_maxNumberMIMO_4_LayersPDSCH_NSA}
    ...                                                  ue_ue_eutra_nr_capa=${ue_ue_eutra_nr_capabilities_maxNumberMIMO_4_LayersPDSCH_NSA}

    ${msg}   Catenate   "${current_BM_CB007487_B}"
    ${tc_name}    Set variable    Test Case Setup
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'      Testline_settings  ${current_BM_CB007487_B}   CellId=1
    CB007487-B_Attach_Traffic      ${dictParam}  ${msg}

