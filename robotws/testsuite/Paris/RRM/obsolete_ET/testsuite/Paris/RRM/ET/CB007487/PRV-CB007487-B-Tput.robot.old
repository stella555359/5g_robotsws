*** Settings ***
Documentation     [SUITE PURPOSE]  CB007487-B - ABIP integration
...               Scope : Performance KPIs Tput TCs in NSA/SA
...
...               Test Case Scenario author   : Christophe.samson@nokia.com
...               Test Case Scenario contact  : Christophe.samson@nokia.com
...               Test Case automation contact:
...               Creation Date               : 29-June-2022
...               Modified Date               : 29-June-2022
...               Last Modified by            : Christophe.samson@nokia.com

Library           DateTime
Library    		  taf.sbts.oam.coam.admin        WITH NAME       coam
Library           taf.sbts.oam.coam.admin.interface
Library           taf.transport.ssh              WITH NAME    ssh

Library           ../../../resources/SWENG/python/StringTool.py
Library           resources/python/Constants.py  WITH NAME       MyConstants
Library           resources/python/tools.py                      WITH NAME    nps_7487_tools

Library           ../../../resources/SWENG/python/OldMultiScf.py      WITH NAME   scf

Resource          ./resources/robot/btslog.robot
Resource          ./resources/robot/connect.robot
Resource          ./resources/robot/CB007487_PerfKPI_Keywords.robot

Variables         resources/python/Constants.py

Suite Setup            Run Keywords    Fetch common OAM SW version
...                    AND             CB007487_PerfKPI_Keywords.Test Suite Setup for CB007487
...                    AND             Get Testline Name
...                    AND             run keyword and ignore error   Remove RAD param for Link Adaptation on swconfig if present
...                    AND             Get_Private_variables_Suite_setup
...                    AND             Create Header Csv Test result
...                    AND             btslog.Create cplane runtime file to gnb
...                    AND             Set Global Variable    ${WAIT_5G_CELL_ONAIR}   1
Suite Teardown                         CB007487_PerfKPI_Keywords.Test Suite Teardown for CB007487
Test Setup             Run Keywords    CB007487_PerfKPI_Keywords.Test Setup for CB007487
...                    AND             Update local SCF
...                    AND             set test variable      ${2_2_nrCellType_to_update_Cell1}   ${False}
...                    AND             set test variable      ${4_4_nrCellType_to_update_Cell1}   ${False}
Test Teardown                          CB007487_PerfKPI_Keywords.Test Teardown for CB007487

*** Variables ***

${subFeature}   CB007484-B

${BENCHMARK_ID}    2

# auto-valorized of w/wo BF from scf during suite setup
${BF}           False
# auto-valorized of Higher cipher/Integrity from scf during suite setup
${higher_cipher}         AES
${higher_integrity}      AES
${Test Line}           =HYPERLINK(\\"https://confluence.ext.net.nokia.com/pages/viewpage.action?spaceKey=5GFTPARIS\\&title=NPS3-TL034\\")
# auto-valorized of DL Modulation from scf during suite setup
${DL Mod}       64QAM
${DL MCS}       Max
${UL Mod}       64QAM
${UL Mimo}      2X2
${UL MCS}       Max


&{BM_CB007487_B1}
...    DL_MIMO=2x2   DL_Mod=64QAM   DL_MCS=Max   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=Max    Encrypt=aes

&{BM_CB007487_B2}
...    DL_MIMO=4x4   DL_Mod=64QAM   DL_MCS=Max   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=Max    Encrypt=aes

# introduced to test with no_cypher and no_integrity (testing purpose)
&{BM_CB007487_B2_1}
...    DL_MIMO=4x4   DL_Mod=64QAM   DL_MCS=Max   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=Max    Encrypt=no_cipher_aes_integrity

&{BM_CB007487_B3}
...    DL_MIMO=4x4   DL_Mod=64QAM   DL_MCS=0   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=0    Encrypt=aes

&{BM_CB007487_B4}
...    DL_MIMO=4x4   DL_Mod=64QAM   DL_MCS=3   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=3    Encrypt=aes

# in call SA, MCS used for rrc setup response is MCS 5 => tested in MCS 5 instead of 3
&{BM_CB007487_B4_1}
...    DL_MIMO=4x4   DL_Mod=64QAM   DL_MCS=5   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=5    Encrypt=aes

&{BM_CB007487_B4_2}
...    DL_MIMO=4x4   DL_Mod=64QAM   DL_MCS=3   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=3    Encrypt=no_cipher_aes_integrity

&{BM_CB007487_B4_3}
...    DL_MIMO=4x4   DL_Mod=256QAM   DL_MCS=3   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=3    Encrypt=aes

&{BM_CB007487_B5}
...    DL_MIMO=4x4   DL_Mod=256QAM   DL_MCS=Max   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=Max    Encrypt=aes

&{BM_CB007487_B6}
...    DL_MIMO=4x4   DL_Mod=64QAM   DL_MCS=5   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=5    Encrypt=aes

# FYI,  DL and UL Tput is limited to 25 Mbps for snow and zuc (AirPhone limitation)
&{BM_CB007487_B7}
...    DL_MIMO=4x4   DL_Mod=256QAM   DL_MCS=Max   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=Max    Encrypt=snow   TputTarget=25Mbps

&{BM_CB007487_B8}
...    DL_MIMO=4x4   DL_Mod=256QAM   DL_MCS=Max   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=Max    Encrypt=zuc    TputTarget=25Mbps

&{BM_CB007487_B8_1}
...    DL_MIMO=4x4   DL_Mod=64QAM   DL_MCS=Max   UL_MIMO=2x2   UL_Mod=64QAM    UL_MCS=Max    Encrypt=zuc    TputTarget=25Mbps


${NIDD_VERSION}                  MNL22R4_2213_100

# check alarm that need to be ignored;
&{ADD_SBTS_IGNORED_ALARM}    alarmId=7115    faultId=6134

&{SBTS_EXPECTED_ALARMS_49}   alarmId=7102   faultId=49

