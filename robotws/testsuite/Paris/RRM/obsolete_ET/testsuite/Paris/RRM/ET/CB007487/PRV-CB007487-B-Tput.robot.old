    set global variable    ${current_gNB_sw_version}      ${gnb_sw_version}
    ${msg}=   StringTool.getHeaderLine    Fetch Current gNB SW Version:   ${gnb_sw_version}
    Dated log   ===========================================================================================
    Dated log             ${msg}
    Dated log   ===========================================================================================
    [Return]    ${gnb_sw_version}

# "TC; CallType; Cell; TrafficDuration; DLTput Reached (Mbps); ULTput Reached (Mbps); desciption "
Create Header Csv Test result
  [Arguments]                    ${text}=""
    ${text}    catenate   "Subfeature; technology; BF; SA/NSA; DL Mod; downlinkMimoMode; DL MCS; UL Mimo; UL Mod; UL MCS; cipher; Integrity;
    ...                    CellId; Test Line; TrafficDuration(s);
    ...                    DLTput Reached (Mbps); ULTput Reached (Mbps);"
    ...                   "physicalCellId; nrCellType; Sw version; TC Name; BMId; Test Description;"

    ${timeStamp}=    DateTime.Get current date    exclude_millis=True    result_format=%Y%m%d-%H%M%S
    ${current_BM_CB007487}=   set Variable   ${dict_BM["${BENCHMARK_ID}"]}
    ${filename}   set Variable
    ...               TestResults-${SUITE_NAME}-BM-${BENCHMARK_ID}-${current_BM_CB007487.Encrypt}-${current_BM_CB007487.Encrypt}-${timeStamp}.csv
    Run Keyword And Ignore Error    OperatingSystem.touch    ${LOG_PATH}/${filename}
    Run Keyword And Ignore Error    OperatingSystem.run      echo ${text} > ${LOG_PATH}/${filename}
    set suite variable      ${csv_file_results}       ${LOG_PATH}/${filename}

Log Test results
  [Arguments]                    ${text}
    Run Keyword And Ignore Error    OperatingSystem.run      echo "${text}" >> ${csv_file_results}

Private Setup Wtsemu SA
    [Documentation]                WTSEmu Setup for SA call. This is a call to keyword 'WTS Setup':
    ...                            | WTS Setup
    ...                            | ...   telnet_egate_addr=${tl.core.default_ssh_connection_details.addr}
    ...                            | ...   nbUe=1
    ...                            | ...   nbSaUe=${nbSaUe}
    ...                            | ...   shouldUseLua=${shouldUseLua}
    ...                            | ...   bypassX2Setup=${True}
    ...                            | ...   bypassSIB=${False}
    ...                            | ...   nbCell=${nbCell}
    ...                            See keyword 'WTS Setup' for more details.
    ...
    ...                            *Argument details:*
    ...                            - *nbSaUe*: number of SA UE to use (default value = 1, should be >= 1)
    ...                            - *nbCell*: number of cell to check for SystemInformationBlock-NR (default value= 0 dynamically retrieved)
    ...                            - *shouldUseLua*: flag to choose between cfg or lua basic-setup file (default value = False)
    ...                            - *list_of_UE_tobe_created*: list of UEs structure to be created when using lua (default value = None)
    ...                                 mandatory params: ue & target_cells &{my_UE_SA}     ue=1    target_cells=2
    [Arguments]    ${nbUe}=1    ${nbCell}=1    ${nbSaUe}=1    ${shouldUseLua}=${False}    ${list_of_UE_tobe_created}=${None}   ${bypassSIB}=${False}
    CallSetup.WTS Setup         nbUe=${nbUe}    nbSaUe=${nbSaUe}    nbCell=${nbCell}    bypassX2Setup=${True}    shouldUseLua=${shouldUseLua}
    ...                         list_of_UE_tobe_created=${list_of_UE_tobe_created}   bypassSIB=${bypassSIB}

Private Setup Wtsemu
    [Documentation]                WTSEmu Setup for NSA call. This is a call to keyword 'WTS Setup':
    ...                            | WTS Setup
    ...                            | ...   telnet_egate_addr=${tl.core.default_ssh_connection_details.addr}
    ...                            | ...   nbUe=1
    ...                            | ...   nbSaUe=${nbSaUe}
    ...                            | ...   shouldUseLua=${shouldUseLua}
    ...                            | ...   bypassX2Setup=${True}
    ...                            | ...   bypassSIB=${False}
    ...                            | ...   nbCell=${nbCell}
    ...                            See keyword 'WTS Setup' for more details.
    ...
    ...                            *Argument details:*
    ...                            - *nbSaUe*: number of SA UE to use (default value = 1, should be >= 1)
    ...                            - *nbCell*: number of cell to check for SystemInformationBlock-NR (default value= 0 dynamically retrieved)
    ...                            - *shouldUseLua*: flag to choose between cfg or lua basic-setup file (default value = False)
    ...                                 mandatory params: ue & target_cells &{my_UE_SA}     ue=1    target_cells=2
    [Arguments]    ${nbUe}=1    ${nbCell}=1    ${nbSaUe}=0    ${shouldUseLua}=${False}    ${bypassSIB}=${False}
    CallSetup.WTS Setup         nbUe=${nbUe}    nbSaUe=${nbSaUe}   nbCell=${nbCell}    shouldUseLua=${shouldUseLua}
    ...                         bypassSIB=${bypassSIB}

CB007487-B cell setup
    [Arguments]                     ${CallType}    ${UEsList}   ${num_of_cells}=1   ${isOAMRebooted}=False   ${bypassSIB}=${False}
    Dated Log new line              ${consTraceColor}=== Restart TL === ${defColor}
    Restart TL                      isOAMRebooted=${isOAMRebooted}    GNBCallback=CB007487 Start Capture After GNB Ready
    Dated Log new line              ${consTraceColor}=== WTS setup === ${defColor}
    ${UEnb}                         get length     ${UEsList}

    # Run Keyword If                  "${CallType}" == "NSA"     WTS setup          nbUe=${UEnb}   bypassSIB=${True}
    # to manage the case of test with 1 Cell with 2 cells configured in SCF
    Run Keyword If                  "${CallType}" == "NSA"     Private Setup Wtsemu     nbUe=${UEnb}   nbSaUe=0    nbCell=${num_of_cells}
    ...                                                                           shouldUseLua=${True}       bypassSIB=${bypassSIB}
    Run Keyword If                  "${CallType}" == "None"     Private Setup Wtsemu     nbUe=${UEnb}   nbSaUe=0    nbCell=${num_of_cells}
    ...                                                                           shouldUseLua=${False}      bypassSIB=${bypassSIB}
    Run Keyword If                  "${CallType}" == "SA"      Private Setup Wtsemu SA    nbUe=${UEnb}    nbSaUe=${UEnb}   nbCell=${num_of_cells}
    ...                                                                           list_of_UE_tobe_created=${UEsList}    shouldUseLua=${True}
    ...                                                                           bypassSIB=${bypassSIB}

    UE Cell Setup Check       nbCell=${num_of_cells}
    # bypassed for the moment ...    ${num_of_cells}=    Get Cell Number
    # Wait gNB cells 5g On air    num_of_cells=${num_of_cells}
    # csamson : to remove later whan 2 Cells will be OK - Only Cell0 is OK
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${cells_status}=    coam.get_cells_info    cell_type=nr     timeout=30    connection=${aliasGNB}
    ${dict_cells}=  Create dictionary
    ${num_of_cells}   set variable   2
    FOR    ${cell_id}    IN RANGE    ${num_of_cells}
        Dated Log New Line  ${consTraceColor}=== cellId ${cell_id} === ${defColor}
        Dated Log           globalCellId=${cells_status[${cell_id}]['globalCellId']}
        Dated Log           configuration=${cells_status[${cell_id}]['id']['configuration']}
        Dated Log           band=${cells_status[${cell_id}]['band']}
        Dated Log           subCellList=${cells_status[${cell_id}]['subCellList']}
        Dated Log           cellName=${cells_status[${cell_id}]['cellName']}
        Dated Log           physicalCellId=${cells_status[${cell_id}]['physicalCellId']}
        Dated Log           technology=${cells_status[${cell_id}]['technology']}
        ${technology}=      set variable    ${cells_status[${cell_id}]['technology']}
        Dated Log           nrCellType=${cells_status[${cell_id}]['nrCellType']}
        Dated Log           cellDepType=${cells_status[${cell_id}]['cellDepType']}
        Dated Log           downlinkMimoMode=${cells_status[${cell_id}]['downlinkMimoMode']}
        Run Keyword if     '${technology}' == 'TDD'      Run Keywords    Dated Log     chBw=${cells_status[${cell_id}]['chBw']}    AND
        ...                                                              Dated Log     nrarfcn=${cells_status[${cell_id}]['nrarfcn']}
        ...   ELSE                                       Run Keywords    Dated Log     chBwUl=${cells_status[${cell_id}]['chBwUl']}    AND
        ...                                                              Dated Log     chBwDl=${cells_status[${cell_id}]['chBwDl']}    AND
        ...                                                              Dated Log     nrarfcnUl=${cells_status[${cell_id}]['nrarfcnUl']}  AND
        ...                                                              Dated Log     nrarfcnDl=${cells_status[${cell_id}]['nrarfcnDl']}

        ${val}  Create list  ${cells_status[${cell_id}]['globalCellId']}   ${cells_status[${cell_id}]['physicalCellId']}
        ...                  ${cells_status[${cell_id}]['nrCellType']}     ${cells_status[${cell_id}]['downlinkMimoMode']}
        ...                  ${cells_status[${cell_id}]['technology']}
        Set To Dictionary    ${dict_cells}    CellId-${cells_status[${cell_id}]['globalCellId']}=${val}
    END
    set suite variable   ${dict_cells}
    Dated log   dict_cells=${dict_cells}

    [teardown]   CB007487 Capture Stop           cellSetup

Step ${index}: Perform Block Unblock SBTS cells
    Dated Log   Step ${consTraceColorRed} ${index} ${defColor}: ${consTraceColor} Perform Block Unblock SBTS cells ${defColor}
    ${Cell_state_blocked_check}=  Set Variable
    ...  operationalState=${Disabled_}, availabilityStatus=${Offline_}, blockingState=${Blocked_}
    # ${Cell_state_unblocked_check}=  Set Variable  operationalState=${Enabled_}, blockingState=${Unblocked_}
    ${Cell_state_unblocked_check}=  Set Variable  operationalState=${Disabled_Enabled_}, blockingState=${Unblocked_}
    ${Cell_state_blocked}=  Set Variable  operationalState=Disabled, availabilityStatus=Offline, blockingState=Blocked
    ${Cell_state_unblocked}=  Set Variable  operationalState=Enabled, blockingState=Unblocked
    Set Test Variable  ${Cell_state_blocked_check}
    Set Test Variable  ${Cell_state_unblocked_check}
    Set Test Variable  ${Cell_state_blocked}
    Set Test Variable  ${Cell_state_unblocked}
    Set Test Variable  ${ALARM_49_count}  0

    Run Keywords  Perform Block all SBTS cells
    ...  AND  Perform Unblock all SBTS cells

Perform Block SBTS RAT cells
    [Arguments]  ${RAT}
    FOR  ${item}  IN  @{${RAT}_CELL_list}
        Block SBTS cell   ${item}
    END

Perform Block all SBTS cells
    Log  ***** Perform Block all BTS cells *****  console=True
    Run Keyword If  ${NR_CELL_list}  Perform Block SBTS RAT cells  NR

Perform Unblock SBTS RAT cells
    [Arguments]  ${RAT}
    FOR  ${item}  IN  @{${RAT}_CELL_list}
        Unblock SBTS cell    ${item}
    END

Perform Unblock all SBTS cells
    Log  ***** Perform Unblock all BTS cells *****  console=True
    Run Keyword If  ${NR_CELL_list}  Perform Unblock SBTS RAT cells  NR

Block SBTS cell
    [Arguments]   ${Cell_Id}
    ${cell_class_name}=      Set Variable      NRCEL
    # dated Log    Block SBTS cell ${Cell_Id}
    Log  *** Perform "Cell Block" operation on BTS: ${Cell_Id}  console=True
    coam.Block Cell  dist_name=${Cell_Id}  timeout=180  connection=${aliasGNB}
    Sleep  3s

    Log  *** Check BTS state and alarms after "Cell Block" operation on SBTS ${cell_class_name}  console=True
    coam.Assert  class_name=${cell_class_name}  id=${Cell_Id}  parameters=${Cell_state_blocked_check}  timeout=30  connection=${aliasGNB}
    Log  *** BTS ${Cell_Id} status:\n - ${Cell_state_blocked}  console=True

    Sleep  1s

    ${ALARM_49_count}=  Evaluate  ${ALARM_49_count} + 1
    Set Test Variable  ${ALARM_49_count}
    ${SBTS_EXPECTED_ALARMS_49_full}=  Prepare expected alarms list  ${SBTS_EXPECTED_ALARMS_49}  ${ALARM_49_count}
    Log  *** BTS "Cell blocked (0049)" alarm, expected number: ${ALARM_49_count}  console=True
    # Check Alarm Raised    ${SBTS_EXPECTED_ALARMS_49_full}
    Check Alarm Raised     parameters=faultId=49,severity=Critical,impactedCellsList[?]=${Cell_Id}
    Log  *** BTS "Cell blocked (0049)" alarm, found number: ${ALARM_49_count}, as expected!  console=True

Unblock SBTS cell
    [Arguments]   ${Cell_Id}
    ${cell_class_name}=  Set Variable   NRCEL
    Log  *** Perform "Cell Unblock" operation on BTS: ${Cell_Id}  console=True
    coam.Unblock Cell  dist_name=${Cell_Id}  timeout=180  connection=${aliasGNB}
    Sleep  10s

    Log  *** Check BTS state and alarms after "Cell Unblock" operation on BTS ${cell_class_name}  console=True
    coam.Assert  class_name=${cell_class_name}  id=${Cell_Id}  parameters=${Cell_state_unblocked_check}  timeout=30  connection=${aliasGNB}
    Log  *** BTS ${Cell_Id} status:\n - ${Cell_state_unblocked}  console=True

    ${ALARM_49_count}=  Evaluate  ${ALARM_49_count} - 1
    Set Test Variable  ${ALARM_49_count}
    ${SBTS_EXPECTED_ALARMS_49_full}=  Prepare expected alarms list  ${SBTS_EXPECTED_ALARMS_49}  ${ALARM_49_count}
    Log  *** BTS "Cell blocked (0049)" alarm, expected number: ${ALARM_49_count}  console=True
    # Check Alarm Cleared    ${SBTS_EXPECTED_ALARMS_49_full}
    Check Alarm Cleared     parameters=faultId=49,severity=Critical,impactedCellsList[?]=${Cell_Id}
    Log  *** BTS "Cell blocked (0049)" alarm, found number: ${ALARM_49_count}, as expected!  console=True

Get Ids For All
    [Arguments]    ${class_name}
    ...            ${timeout}=10
    ...            ${alias}=${ADMIN_ALIAS}
    ${out_current_id}=    coam.get_ids_for_all
    ...    class_name=${class_name}
    ...    timeout=${timeout}
    ...    connection=${alias}
    [Return]    ${out_current_id}

Prepare expected alarms list
    [Documentation]
    ...  Keyword for creating list of alarms multiplicated by multiplication number
    ...  | Parameter             | Man. | Description                                    |
    ...  | exp_alarms_list       | Yes  | List with alarms prepared for multiplication   |
    ...  | multiplication_number | Yes  | Number by which alarms should be multiplicated |
    ...
    ...  *RETURN*
    ...  | Parameter              | Description               |
    ...  | multiplicated_exp_list | List of lists with alarms |
    ...
    ...  *EXAMPLE*
    ...  | ${WCDMA_exp_alarms_multiplicated}= | Prepare expected alarms list | [['7665', 'Core']] | 5 |

    [Arguments]  ${exp_alarms_list}  ${multiplication_number}
    ${multiplicated_exp_list}=  create list
    FOR  ${index}  IN RANGE  ${multiplication_number}
        # Append to list  ${multiplicated_exp_list}  @{exp_alarms_list}
        Append to list  ${multiplicated_exp_list}  ${exp_alarms_list}
    END
    [Return]  ${multiplicated_exp_list}

# faultId=49, severity=Critical
Check Alarm Raised
    [Arguments]    ${parameters}=faultId=49,severity=Critical
    coam.assert_alarm_active    parameters=${parameters}    timeout=5   connection=${aliasGNB}

Check Alarm Raised 2
    [Arguments]    ${fault_id}   ${severity}=Critical
    ${fault_id_str}    Convert To String    ${fault_id}
    coam.assert_alarm_active    parameters=faultId=${fault_id_str}, severity=${severity}    timeout=5   connection=${aliasGNB}

Check Alarm Cleared
    [Arguments]    ${parameters}=faultId=49,severity=Critical
    coam.assert_alarm_inactive    parameters=${parameters}    timeout=5   connection=${aliasGNB}

Check Alarm Cleared 2
    [Arguments]    ${fault_id}
    ${fault_id_str}    Convert To String    ${fault_id}
    coam.assert_alarm_inactive    parameters=faultId=${fault_id_str}    timeout=5   connection=${aliasGNB}

Check Active Alarms
    [Tags]      ALARMS_CHECK
    [Arguments]    ${fault_id}

    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}

    Fault Should Be Present   fault_id=${fault_id}

    [Teardown]    OAM Disconnect                          ${GNB_DU.oam}

Check Clear Active Alarms
    [Tags]      ALARMS_CHECK
    [Arguments]    ${fault_id}

    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}

    Fault Should Not Be Present   fault_id=${fault_id}

    [Teardown]    OAM Disconnect                          ${GNB_DU.oam}

Fault Should Be Present
    [Documentation]
    ...
    [Arguments]    ${fault_id}
    Dated log          KW - Fault Should Be Present fault_id=${fault_id}
    ${active_alarms}     OAM Get Active Alarms                   oam=${GNB_DU.oam}     textFormat=${False}
    ${len}    Get Length    ${active_alarms}
    ${alarm_id_list}    Create List
    ${alarm_name_list}    Create List
    FOR    ${i}    IN RANGE    ${len}
         ${tmp_id}    Get From Dictionary    ${active_alarms[${i}]}    faultId
         ${tmp_name_id}    Get From Dictionary    ${active_alarms[${i}]}    faultName
         Append To List    ${alarm_id_list}    ${tmp_id}
         Append To List    ${alarm_name_list}    ${tmp_name_id}
    END
    Dated log     Active alarms: alarm_id_list=${alarm_id_list}
    Dated log     Active alarms: alarm_name_list=${alarm_name_list}
    ${list}     convert to string  ${alarm_id_list}
    Should Contain     ${list}    ${fault_id}

Fault Should Not Be Present
    [Documentation]
    ...
    [Arguments]    ${fault_id}
    Dated log     KW - Fault Should Not Be Present fault_id=${fault_id}
    ${active_alarms}     OAM Get Active Alarms                   oam=${GNB_DU.oam}     textFormat=${False}
    ${len}    Get Length    ${active_alarms}
    ${alarm_id_list}    Create List
    FOR    ${i}    IN RANGE    ${len}
         ${tmp_id}    Get From Dictionary    ${active_alarms[${i}]}    faultId
         Append To List    ${alarm_id_list}    ${tmp_id}
    END
    Dated log     Active alarms: alarm_id_list=${alarm_id_list}
    ${list}     convert to string  ${alarm_id_list}
    Should Not Contain     ${list}    ${fault_id}

CB007487-B_Attach_Traffic
    [Documentation]                 Generic KW to attach/detach n UEs, with or without traffic
    ...                             Argument is a dictionary including following keys:
    ...                             loopNb:           number of loops "attach/traffic/detach"
    ...                             UEnb:             number of UEs to "attach/traffic/detach" simultaneously
    ...                             CallType:         NSA or SA (for all UEs)
    ...                             Cell:             Target cell (must be index 1, 2, ...)
    ...                             TrafficDuration:  duration of traffic (0 means no traffic)
    ...                             DLthroughput:     DL throughput
    ...                             ULthroughput:     UL throughput
    ...                             shouldBeStop:     To Stop or not traffic after TrafficDuration
    ...                             shouldBeCheck:    To Check or not traffic after TrafficDuration
    ...                             w_UE_CSI_TM_for_4_4_DL_MIMO:      with Cqi Ri airphone TestMode
    ...                             GetTtiTraceTime:  Time of TtiTrace
    ...                             GetL1L2TraceTime: Time of L1L2 Bip Trace
    ...                             num_of_cells_cellsetup:   Num of cell to check after CellSetup
    ...                             w_ue_detach:              With Or Without Ue Detach
    ...                             GetBtsLog:                With Or Without BtsLog
    ...                             w_Block_unBlock_Cell:     With Or Without Block/UnBlock Cell
    ...                             NOTE: If both DL and UL throughput are not null,
    ...                                   DL and UL traffic are launched simultaneously
    [Arguments]         ${dictParam}   ${msg}=""

    ${LoopNb}                  Get From Dictionary     ${dictParam}     loopNb
    ${UEnb}                    Get From Dictionary     ${dictParam}     UEnb
    ${CallType}                Get From Dictionary     ${dictParam}     CallType
    ${Cell}                    Get From Dictionary     ${dictParam}     Cell
    ${TrafficDuration}         Get From Dictionary     ${dictParam}     TrafficDuration
    ${DLthroughput}            Get From Dictionary     ${dictParam}     DLthroughput
    ${ULthroughput}            Get From Dictionary     ${dictParam}     ULthroughput
    ${deviation}               Get From Dictionary     ${dictParam}     deviation
    ${shouldBeStop}            Get From Dictionary     ${dictParam}     shouldBeStop
    ${shouldBeCheck}           Get From Dictionary     ${dictParam}     shouldBeCheck
    ${w_UE_CSI_TM_for_4_4_DL_MIMO}             Get From Dictionary     ${dictParam}     w_UE_CSI_TM_for_4_4_DL_MIMO
    ${GetTtiTraceTime}         Get From Dictionary     ${dictParam}     GetTtiTraceTime
    ${GetL1L2TraceTime}        Get From Dictionary     ${dictParam}     GetL1L2TraceTime
    ${num_of_cells}            Get From Dictionary     ${dictParam}     num_of_cells_cellsetup
    ${w_ue_detach}             Get From Dictionary     ${dictParam}     w_ue_detach
    ${GetBtsLog}               Get From Dictionary     ${dictParam}     GetBtsLog
    ${isOAMRebooted}           Get From Dictionary     ${dictParam}     isOAMRebooted
    ${w_Block_unBlock_Cell}    Get From Dictionary     ${dictParam}     w_Block_unBlock_Cell
    ${w_Get_Mem_Usage}         Get From Dictionary     ${dictParam}     w_Get_Mem_Usage

    ${CellID}                   set variable            ${NRCELL_ID_LIST[${Cell}-1]}
    ${Expected_UEnb_attached}   Evaluate                ${LoopNb} * ${UEnb}
    ${UEnb_attached}            Evaluate                0

    ${UEsList}                 CB007487 build UEs list             CallType=${CallType}    UEnb=${UEnb}    CellID=${CellID}

    run Keyword if     '${GetBtsLog}' != '0'    Dated log     =====> Start Btslog
    run Keyword if     '${GetBtsLog}' != '0'    btslog.Start Btslog
    run Keyword if     '${GetBtsLog}' != '0'    set Test variable     ${BtsLogStarted}    True

    CB007487-B cell setup        CallType=${CallType}    UEsList=${UEsList}    num_of_cells=${num_of_cells}     isOAMRebooted=${isOAMRebooted}
    ...                          bypassSIB=${True}

    Run Keyword If             ${enable_sherpa} == ${True}         Activate Sherpa

    ${aliasGNB_2}=   run Keyword if    '${w_Get_Mem_Usage}' == 'True'     connect.Connect to gNB Common Unit      gnb_id=0      du_id=0     comu_id=0
    ...            ELSE                                                 set Variable   ${NONE}
    set Test Variable       ${aliasGNB_2}

    FOR    ${loopIND}    IN RANGE    1    ${LoopNb}+1
        Dated Log new line     ${consTraceColorRed}##### LOOP ${loopIND} / ${LoopNb} ##### ${defColor}

        run Keyword if    '${w_Get_Mem_Usage}' == 'True'    Get Mem Usage     board_id=1     period=before    connection=${aliasGNB_2}
        ...                                                                   suffix=Mem-Usage-loop-${loopIND}-loopNb-${LoopNb}

        ${UEsAttached}         CB007487 attach        UEsList=${UEsList}    CallType=${CallType}
        ...                                           w_UE_CSI_TM_for_4_4_DL_MIMO=${w_UE_CSI_TM_for_4_4_DL_MIMO}
        Sleep                  5s

        # get ue_disp egate results
        ${nbUE}                get length    ${UEsList}
        run Keyword if         '${nbUE}' != '0'      Get Ue_disp

        Run Keyword If         ${TrafficDuration} != 0
        ...                    CB007487 Traffic    UEsList=${UEsAttached}
        ...                    Duration=${TrafficDuration}    DLtput=${DLthroughput}    ULtput=${ULthroughput}   shouldBeStop=${shouldBeStop}
        ...                    shouldBeCheck=${shouldBeCheck}
        Sleep                  5s

        run Keyword if    '${w_Get_Mem_Usage}' == 'True'    Get Mem Usage     board_id=1     period=during    connection=${aliasGNB_2}
        ...                                                                   suffix=Mem-Usage-loop-${loopIND}-loopNb-${LoopNb}

        # ue_id=1 because of PRV Kw with only 1 UE
        ${Ue_Avg_PDSCH_Tput}    ${Ue_Avg_PUSCH_Tput}  run Keyword if    '${shouldBeStop}' == 'False' and '${TrafficDuration}' != '0'
        ...                                                                                   Get PDSCH and PUSCH ue_stats_nr
        ...                                                                                                ue_id=1
        ...                                                                                                DLthroughput=${DLthroughput}
        ...                                                                                                ULthroughput=${ULthroughput}
        ...                                                                                                CallType=${CallType}

        # add here BLOCK and UNBLOCK CELLs if needed
        Run Keyword If         '${w_Block_unBlock_Cell}' == 'True'
        ...                    Step ${loopIND}: Perform Block Unblock SBTS cells

        # "TC; CallType; Cell; TrafficDuration(s); DLTput Reached (Mbps); ULTput Reached (Mbps); desciption "
        ${value}=    Get From Dictionary    ${dict_cells}    CellId-${CellID}
        Dated log   CellID-${CellID} Info = ${value}
        ${physicalCellId}=   set Variable   ${value}[1]
        ${nrCellType}=   set Variable   ${value}[2]
        ${DL MIMO}=   set Variable   ${value}[3]
        ${Techno}=    set Variable   ${value}[4]
        ${BF}=   set variable if    '${CellID}' == '1'    ${actBeamforming_cell1}
        ...                                               ${actBeamforming_cell2}
        ${DL Mod}=   set variable if    '${CellID}' == '1' and '${actDl256Qam_cell1.lower()}' == 'true'    256Qam
        ...                             '${CellID}' == '1' and '${actDl256Qam_cell1.lower()}' == 'false'   64Qam
        ...                             '${CellID}' == '2' and '${actDl256Qam_cell2.lower()}' == 'true'    256Qam
        ...                             '${CellID}' == '2' and '${actDl256Qam_cell2.lower()}' == 'false'   64Qam
        ...                                                                                                64Qam
        ${text}   catenate   ${subFeature}; ${Techno}; ${BF}; ${CallType}; ${DL Mod}; ${DL MIMO}; ${DL MCS}; ${UL Mod}; ${UL Mimo}; ${UL MCS};
        ...                  ${higher_cipher}; ${higher_Integrity}; ${CellID};${Test Line}; ${TrafficDuration};  ${Ue_Avg_PDSCH_Tput};
        ...                  ${Ue_Avg_PUSCH_Tput}; ${physicalCellId}; ${nrCellType}; ${current_gNB_sw_version}; ${TEST_NAME}; ${BENCHMARK_ID};
        ...                  ${msg};

        Dated log             ${text}
        Log Test results      ${text}

        ${tti_trace_path}   run Keyword if   '${GetTtiTraceTime}' != '0'  Run Keyword And Ignore Error   Get TTI traces 2
        ...                                                                                                suffix=loop-${loopIND}-loopNb-${LoopNb}
        ...                                                                                                time=${GetTtiTraceTime}
        ...                                                                                                w_convert_pcap_to_excelCsv=False
        ...    ELSE         set variable   ${EMPTY}

        run Keyword if    '${w_ue_detach}' == 'True'      CB007487 detach        UEsList=${UEsAttached}    CallType=${CallType}
        # force UE detach for BLOCK / UNBLOCK TC / NSA case
        run Keyword if    '${w_Block_unBlock_Cell}' == 'True' and '${CallType}' == 'NSA'
        ...                                               CB007487 detach        UEsList=${UEsAttached}    CallType=${CallType}

        run Keyword if    '${w_Get_Mem_Usage}' == 'True'    Get Mem Usage     board_id=1     period=after    connection=${aliasGNB_2}
        ...                                                                   suffix=Mem-Usage-loop-${loopIND}-loopNb-${LoopNb}

        ${UE_attached_loop}    get length         ${UEsAttached}
        ${UEnb_attached}       Evaluate           ${UEnb_attached} + ${UE_attached_loop}
    END

    run Keyword if     '${GetBtsLog}' != '0'    Dated log     =====> Stop Btslog
    run Keyword if     '${GetBtsLog}' != '0'    btslog.Stop Btslog    target_dir=${testCaseDir}
    run Keyword if     '${GetBtsLog}' != '0'    set Test variable     ${BtsLogStarted}      False

    Run Keyword If                  ${enable_sherpa} == ${True}             Sherpa.Deactivate Sherpa and Stop Collect    keep_pcap_file=True

    # run Keyword if     '${GetTtiTraceTime}' != '0'       Run Keyword And Ignore Error    Get TTI traces    time=${GetTtiTraceTime}

    # ${L1L2_Pcap_File}=   run Keyword if     '${Getl1l2TraceTime}' != '0'    CB007487_PerfKPI_Keywords.Get L1L2 traces   time=${GetL1L2TraceTime}
    # ...                                                                                                                 prefix=L1L2Bip.wDLULTput
    ${L1L2_Pcap_File}=   run Keyword if     '${Getl1l2TraceTime}' != '0'    CB007487_PerfKPI_Keywords.Get L1L2 traces Version ABIP
    ...                                                                                                                 time=${GetL1L2TraceTime}
    ...                                                                                                                 prefix=L1L2Bip.wDLULTput
    run Keyword if   '${L1L2_Pcap_File}' != 'None'      Run Keywords     Dated log    gzip -f ${L1L2_Pcap_File} ...    AND
    ...                                                                               Run    gzip -f ${L1L2_Pcap_File}

    [teardown]  Teardown CB007487-B_Attach_Traffic

Teardown CB007487-B_Attach_Traffic
    run Keyword if   '${BtsLogStarted}'=='True'    run Keywords    Dated log     =====> Stop Btslog
    ...                                            AND             btslog.Stop Btslog    target_dir=${testCaseDir}
    Run Keyword And Ignore Error    ssh.disconnect    connection=${aliasGNB_2}

Update local SCF
    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable              ${test_scf_file}

Get_Private_variables_Suite_setup
    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable              ${test_scf_file}
    ${nodeType}=     set variable if   ${isAic}     Vdu
    ...                                             Classical
    ${actBeamforming_cell1}=   Get actBeamforming from SCF    nodeType=${nodeType}  CellId=1
    ${status}  ${actBeamforming_cell2}=   run Keyword and ignore error    Get actBeamforming from SCF    nodeType=${nodeType}  CellId=2
    ${actBeamforming_cell2}=   set Variable if   '${status}'=='FAIL'    False
    ...                                                                 ${actBeamforming_cell2}
    ${actDl256Qam_cell1}=      Get actDl256Qam from SCF    nodeType=${nodeType}  CellId=1
    ${status}   ${actDl256Qam_cell2}=      run Keyword and ignore error    Get actDl256Qam from SCF    nodeType=${nodeType}  CellId=2
    ${actDl256Qam_cell2}=   set Variable if   '${status}'=='FAIL'    False
    ...                                                              ${actDl256Qam_cell2}
    ${original_Cipher}=        Get Cipher Parameters From gNB
    ${original_Integrity}=     Get Integrity Parameters From gNB
    Set Suite Variable   ${actBeamforming_cell1}
    Set Suite Variable   ${actBeamforming_cell2}
    Set Suite Variable   ${actDl256Qam_cell1}
    Set Suite Variable   ${actDl256Qam_cell2}
    Set Suite Variable    ${original_Cipher}
    Set Suite Variable    ${original_Integrity}
    Dated log   original_Cipher_prio=${original_Cipher}
    Dated log   original_Integrity_prio=${original_Integrity}
    ${higher_cipher}=  get_higher_value_from_dict  ${original_Cipher}
    # Dated log    higher_cipher algo is ${higher_cipher}
    ${higher_integrity_tmp}=  get_higher_value_from_dict  ${original_Integrity}
    # Dated log    higher_integrity algo is ${higher_integrity_tmp}
    &{dict_cipher}=   Create Dictionary        nea0=no_cipher  nea1_128=snow   nea2_128=aes  nea3_128=zuc
    &{dict_Integrity}=   Create Dictionary     nia0=no_cipher  nia1_128=snow   nia2_128=aes  nia3_128=zuc
    ${higher_cipher}=   set Variable      ${dict_cipher["${higher_cipher}"]}
    ${higher_Integrity}=   set Variable      ${dict_Integrity["${higher_Integrity_tmp}"]}
    Dated log    higher_cipher algo is ${consTraceColor}${higher_cipher}${defColor}
    Dated log    higher_Integrity algo is ${consTraceColor}${higher_Integrity}${defColor}
    Set Suite Variable    ${higher_cipher}
    Set Suite Variable    ${higher_Integrity}

    &{dict_BM}=   Create Dictionary        1=&{BM_CB007487_B1}  2=&{BM_CB007487_B2}   3=&{BM_CB007487_B3}  4=&{BM_CB007487_B4}
    ...                                    5=&{BM_CB007487_B5}  6=&{BM_CB007487_B6}   7=&{BM_CB007487_B7}  8=&{BM_CB007487_B8}  9=&{BM_CB007487_B2_1}
    ...                                    10=&{BM_CB007487_B8_1}   11=&{BM_CB007487_B4_1}   12=&{BM_CB007487_B4_2}   13=&{BM_CB007487_B4_3}
    Set Suite Variable    ${dict_BM}

Update_Private_variables_Suite_setup
    Dated log    ====> Update Globale Variables
    ${test_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF.xml
    Set Suite Variable              ${test_scf_file}
    ${nodeType}=     set variable if   ${isAic}     Vdu
    ...                                             Classical
    ${actBeamforming_cell1}=   Get actBeamforming from SCF    nodeType=${nodeType}  CellId=1
    ${status}  ${actBeamforming_cell2}=   run Keyword and ignore error    Get actBeamforming from SCF    nodeType=${nodeType}  CellId=2
    ${actBeamforming_cell2}=   set Variable if   ${status}!='PASSED'    False
    ...                                                                 ${actBeamforming_cell2}
    ${actDl256Qam_cell1}=      Get actDl256Qam from SCF    nodeType=${nodeType}  CellId=1
    ${status}   ${actDl256Qam_cell2}=      run Keyword and ignore error    Get actDl256Qam from SCF    nodeType=${nodeType}  CellId=2
    ${actDl256Qam_cell2}=   set Variable if   ${status}!='PASSED'    False
    ...                                                              ${actDl256Qam_cell2}
    ${original_Cipher}=        Get Cipher Parameters From gNB
    ${original_Integrity}=     Get Integrity Parameters From gNB
    Set Suite Variable   ${actBeamforming_cell1}
    Set Suite Variable   ${actBeamforming_cell2}
    Set Suite Variable   ${actDl256Qam_cell1}
    Set Suite Variable   ${actDl256Qam_cell2}
    Set Suite Variable    ${original_Cipher}
    Set Suite Variable    ${original_Integrity}
    Dated log   original_Cipher_prio=${original_Cipher}
    Dated log   original_Integrity_prio=${original_Integrity}
    ${higher_cipher}=  get_higher_value_from_dict  ${original_Cipher}
    # Dated log    higher_cipher algo is ${higher_cipher}
    ${higher_integrity_tmp}=  get_higher_value_from_dict  ${original_Integrity}
    # Dated log    higher_integrity algo is ${higher_integrity_tmp}
    &{dict_cipher}=   Create Dictionary        nea0=no_cipher  nea1_128=snow   nea2_128=aes  nea3_128=zuc
    &{dict_Integrity}=   Create Dictionary     nia0=no_cipher  nia1_128=snow   nia2_128=aes  nia3_128=zuc
    ${higher_cipher}=   set Variable      ${dict_cipher["${higher_cipher}"]}
    ${higher_Integrity}=   set Variable      ${dict_Integrity["${higher_integrity_tmp}"]}
    Dated log    higher_cipher algo is ${consTraceColor}${higher_cipher}${defColor}
    Dated log    higher_Integrity algo is ${consTraceColor}${higher_Integrity}${defColor}
    Set Suite Variable    ${higher_cipher}
    Set Suite Variable    ${higher_Integrity}

Testline_settings
    [Arguments]    ${BM_id}=${BM_CB007487_B1}   ${CellId}=1
    # test that cipher and Integrity is configured in scf as expected
    ${cypher_OK}=   Evaluate   '${higher_cipher}'=='${BM_id.Encrypt}'
    ${msg_err}=   Catenate       ${consTraceColorRed} Cypher configured in SCF [${higher_cipher}] is not as
    ...                                                    EXPECTED [expected=${BM_id.Encrypt}] ${defColor}
    Run Keyword if   '${cypher_OK}'=='False'   Dated log  ${msg_err}
    ...  ELSE                                  Dated log  Cypher configured in SCF [${higher_cipher}] is as Expected [expected=${BM_id.Encrypt}]
    ${integrity_OK}=   Evaluate   '${higher_Integrity}'=='${BM_id.Encrypt}'
    ${msg_err}=   Catenate       ${consTraceColorRed} Integrity configured in SCF [${higher_Integrity}] is not as
    ...                                                    EXPECTED [expected=${BM_id.Encrypt}] ${defColor}
    Run Keyword if  '${integrity_OK}'=='False'
    ...                               Dated log  ${msg_err}
    ...  ELSE                         Dated log  Integrity configured in SCF [${higher_Integrity}] is as Expected [expected=${BM_id.Encrypt}]
    ${Need_to_Perform_Commissioning_1}  ${Need_to_Perform_Commissioning_2}    CB007487-B_Testline_settings   ${BM_id}   CellId=${CellId}
    Run Keyword if   ${Need_to_Perform_Commissioning_1}==${True} or ${Need_to_Perform_Commissioning_2}==${True}
    ...                                                                                                 Commissioning SCF  ${test_scf_file}
    Run Keyword and ignore Error    Update_Private_variables_Suite_setup

CB007487-B_Testline_settings
    [Documentation]
    ...                 This KW will help to set 5gnb swconfig file for mcs purpose
    ...                 and call Set_XL_mod to set UL_mod / DL_mod in the scf
    [Arguments]         ${BM_id}=${BM_CB007487_B1}   ${CellId}=1   ${Need_To_Update_CellMapping_Cell1}=${False}

    #** 5gnb swconfig update
    Dated Log new line    ${consTraceColor}=== CELL-${CellId} Settings value ${BM_id} === ${defColor}

    #exemple in swconfig
    # 0x58000E=0x1fffffff     #rdSupportedDl64QamMcs
    # 0x58000F=0x1fffffff     #rdSupportedDl256QamMcs
    # 0x580010=0x1fffffff     #rdSupportedUlMCS

    # DL Case
    ${rdSupportedDlMcs}    Set Variable if    "${BM_id.DL_MCS}" == "0"        0x01
    ...                                       "${BM_id.DL_MCS}" == "3"        0x0F
    ...                                       "${BM_id.DL_MCS}" == "5"        0x3F
    ...                                                                       noRAD
    Dated Log  RAD rdSupportedDlMcs: ${rdSupportedDlMcs}
    set suite Variable      ${DL MCS}    ${BM_id.DL_MCS}

    # UL Case
    ${rdSupportedUlMcs}    Set Variable if    "${BM_id.UL_MCS}" == "0"        0x01
    ...                                       "${BM_id.UL_MCS}" == "3"        0x0F
    ...                                       "${BM_id.UL_MCS}" == "5"        0x3F
    ...                                                                      noRAD
    Dated Log  RAD rdSupportedUlMcs: ${rdSupportedUlMcs}
    set suite Variable      ${UL MCS}    ${BM_id.UL_MCS}

    #0x58000F rdSupportedDl256QamMcs
    #0x58000E rdSupportedDl64QamMcs
    ${TargetToSetforDL}   Set Variable if      "${BM_id.DL_Mod}" == "256QAM"    0x58000F    0x58000E
    Dated Log  DBG : TargetToSetforDL ${TargetToSetforDL}
    ${Dico1}           Create Dictionary     field=${TargetToSetforDL}    value=${rdSupportedDlMcs}
    ${Dico2}           Create Dictionary     field=0x580010               value=${rdSupportedUlMcs}
    # 19/10/2022 : update here gnb swconfig with 0x42005B = 1
    # EnableFlexDeploymentForAbip_RP003279_NB_P4
    # 0x42005B = 1
    ${Dico3}           Create Dictionary     field=0x42005B               value=1
    @{swconfig_gnb}        Create List
    run Keyword if   '${rdSupportedDlMcs}' != 'noRAD'     Append To List   ${swconfig_gnb}   ${Dico1}
    run Keyword if   '${rdSupportedUlMcs}' != 'noRAD'     Append To List   ${swconfig_gnb}   ${Dico2}
    Append To List   ${swconfig_gnb}   ${Dico3}
    # MaxMIMO-Layers:
    # 0x590004=4
    ${Dico3}           Create Dictionary     field=0x590004               value=4
    Run Keyword if   '${BM_id.DL_MIMO}'=='4x4'   Append To List   ${swconfig_gnb}   ${Dico3}

    Dated Log  Adding ${swconfig_gnb} in 5gnb-swconfig.txt (+crasign)
    # Set Fields in swconfig DU    ${Dicolist}    ${GNB_DU.entryCard[0]}
    Update gNB Swconfig   ${swconfig_gnb}

    #** SCF update
    ${value}    set variable if    '${BM_id.DL_Mod}' == '256QAM'    true    false
    ${actDl256Qam}=   Get actDl256Qam from SCF   CellId=${CellId}
    ${actDl256Qam_to_update}=   set variable if   '${actDl256Qam.lower()}'=='false' and '${BM_id.DL_Mod}'=='256QAM'   True
    ...                                           '${actDl256Qam.lower()}'=='true' and '${BM_id.DL_Mod}'=='64QAM'     True
    ...                                                                                                               False
    # Run Keyword if   '${actDl256Qam_to_update}'=='True'  Set_xL_mod    actDl256Qam    ${value}    ${CellId}
    @{OAMParam_modiflist}    Create List
    IF    '${actDl256Qam_to_update}'=='True'
        ${OAMParam_modiflist2}=      Set_XL_mod_ListParam   actDl256Qam    ${value}    ${CellId}    ${OAMParam_modiflist}
    ELSE
        ${OAMParam_modiflist2}=      set variable   ${OAMParam_modiflist}
    END
    Run Keyword if   '${actDl256Qam_to_update}'=='True'               Dated log    actDl256Qam Updated in Scf
    ${nrCellType}=  Get nrCellType from SCF   CellId=${CellId}
    ${dlMimoMode}=  Get dlMimoMode from SCF   CellId=${CellId}
    ${4_4_DL_MODE_to_update}=   set variable if   '${nrCellType}'!='4DL4UL' and '${BM_id.DL_MIMO}'=='4x4'   True
    ...                                           '${dlMimoMode}'!='4x4 or 4x2 Closed Loop Spatial Multiplexing' and '${BM_id.DL_MIMO}'=='4x4'  True
    ...                                                                                                     False
    ${4_4_nrCellType_to_update_Cell1}=  set Variable if   '${CellId}'=='1' and '${4_4_DL_MODE_to_update}'=='True'   ${True}
    ...                                                                                                             ${4_4_nrCellType_to_update_Cell1}
    set test Variable   ${4_4_nrCellType_to_update_Cell1}
    # Run Keyword if   '${4_4_DL_MODE_to_update}'=='4x4'   Set 4x4 DL Mimo Mode   ${CellId}
    IF    '${4_4_DL_MODE_to_update}'=='True'
        ${OAMParam_modiflist3}=  Set 4x4 DL Mimo Mode ListParam   ${CellId}  ${OAMParam_modiflist2}
    ELSE
        ${OAMParam_modiflist3}=  set variable   ${OAMParam_modiflist2}
    END

    ${2_2_DL_MODE_to_update}=   set variable if   '${nrCellType}'!='2DL2UL' and '${BM_id.DL_MIMO}'=='2x2'   True
    ...                                           '${dlMimoMode}'!='2x2 Closed Loop Spatial Multiplexing' and '${BM_id.DL_MIMO}'=='2x2'  True
    ...                                                                                                     False
    ${2_2_nrCellType_to_update_Cell1}=  set Variable if   '${CellId}'=='1' and '${2_2_DL_MODE_to_update}'=='True'   ${True}
    ...                                                                                                             ${2_2_nrCellType_to_update_Cell1}
    set test Variable   ${2_2_nrCellType_to_update_Cell1}
    # Run Keyword if   '${2_2_DL_MODE_to_update}'=='4x4'   Set 2x2 DL Mimo Mode   ${CellId}
    IF    '${2_2_DL_MODE_to_update}'=='True'
        ${OAMParam_modiflist4}=  Set 2x2 DL Mimo Mode ListParam   ${CellId}  ${OAMParam_modiflist3}
    ELSE
        ${OAMParam_modiflist4}=  set variable   ${OAMParam_modiflist3}
    END
    ${ulMimoMode}=    Get UL Mimo Mode from SCF    ${CellId}
    IF    '${ulMimoMode}' != 'Closed loop Spatial Multiplexing (2x2)'
        ${OAMParam_modiflist5}=  Set 2x2 UL Mimo Mode ListParam   ${CellId}  ${OAMParam_modiflist4}
    ELSE
        ${OAMParam_modiflist5}=  set variable   ${OAMParam_modiflist4}
    END
    # update Cyphering and Integrity
    IF    '${higher_cipher}'!='${BM_id.Encrypt.lower()}' and '${BM_id.Encrypt.lower()}'=='no_cipher_aes_integrity'
        ${OAMParam_modiflist6}=      Modify no cipherPrefL and AES integrityProtPrefL ListParam    ${OAMParam_modiflist5}
    ELSE
        ${OAMParam_modiflist6}=      set variable   ${OAMParam_modiflist5}
    END
    IF    '${higher_cipher}'!='${BM_id.Encrypt.lower()}' and '${BM_id.Encrypt.lower()}'=='no_cipher_snow_integrity'
        ${OAMParam_modiflist7}=      Modify no cipherPrefL and SNOW integrityProtPrefL ListParam    ${OAMParam_modiflist6}
    ELSE
        ${OAMParam_modiflist7}=      set variable   ${OAMParam_modiflist6}
    END
    IF    '${higher_cipher}'!='${BM_id.Encrypt.lower()}' and '${BM_id.Encrypt.lower()}'=='aes'
        ${OAMParam_modiflist8}=      Modify AES cipherPrefL and integrityProtPrefL ListParam    ${OAMParam_modiflist7}
    ELSE
        ${OAMParam_modiflist8}=      set variable   ${OAMParam_modiflist7}
    END
    IF    '${higher_cipher}'!='${BM_id.Encrypt.lower()}' and '${BM_id.Encrypt.lower()}'=='snow'
        ${OAMParam_modiflist9}=      Modify SNOW cipherPrefL and integrityProtPrefL ListParam    ${OAMParam_modiflist8}
    ELSE
        ${OAMParam_modiflist9}=      set variable   ${OAMParam_modiflist8}
    END
    IF    '${higher_cipher}'!='${BM_id.Encrypt.lower()}' and '${BM_id.Encrypt.lower()}'=='zuc'
        ${OAMParam_modiflist10}=      Modify ZUC cipherPrefL and integrityProtPrefL ListParam    ${OAMParam_modiflist9}
    ELSE
        ${OAMParam_modiflist10}=      set variable   ${OAMParam_modiflist9}
    END
    # required to reach max Throughput
    ${actUnlimitedDataRateDl}=   Get actUnlimitedDataRateDl from SCF
    IF    '${actUnlimitedDataRateDl}'=='true'
        ${OAMParam_modiflist11}=    Set actUnlimitedDataRateDl ListParam    true    ${OAMParam_modiflist10}
    ELSE
        ${OAMParam_modiflist11}=    set variable   ${OAMParam_modiflist10}
    END
    # dlQam256PowerBackoffSub6:  3dB  if needed (sometimes required to avoid  power saturation of DL 256QAM I/Q)
    ${dlQam256PowerBackoffSub6}=   Get dlQam256PowerBackoffSub6 from SCF   CellId=${CellId}
    IF    '${dlQam256PowerBackoffSub6}'!='30'
        ${OAMParam_modiflist12}=    Set dlQam256PowerBackoffSub6 ListParam    ${CellId}    30    ${OAMParam_modiflist11}
    ELSE
        ${OAMParam_modiflist12}=    set variable   ${OAMParam_modiflist11}
    END
    # Need to Aligned with OTAVA
    ${OAMParam_modiflist13}=  Update OAM param to Aligned with OTAVA   cellId=${CellId}   modiflist=${OAMParam_modiflist12}
    Update gNB OAM List Param   ${OAMParam_modiflist13}

    ${2_2_nrCellType_to_update}=   set variable if   '${nrCellType}'!='2DL2UL' and '${BM_id.DL_MIMO}'=='2x2'   True
    ...                                                                                                        False
    ${4_4_nrCellType_to_update}=   set variable if   '${nrCellType}'!='4DL4UL' and '${BM_id.DL_MIMO}'=='4x4'   True
    ...                                                                                                        False
    # Need to update Cabling in Scf
    # local SCF to update first
    Update local SCF
    scf.load_scf    ${test_scf_file}
    Run Keyword if   ${Need_To_Update_CellMapping_Cell1}==${True} and ${2_2_nrCellType_to_update_Cell1}==${True}
    ...                                        Run Keywords          Remove Channels to support 2DL2UL nrCellType    ${BM_id}  1
    ...                                        AND                   scf.save_scf    ${test_scf_file}
    ...                                        AND                   scf.load_scf    ${test_scf_file}
    ...                                        AND                   Dated log   ====> Remove Channels to support 2DL2UL nrCellType for CellId-1
    Run Keyword if   ${Need_To_Update_CellMapping_Cell1}==${True} and ${4_4_nrCellType_to_update_Cell1}==${True}
    ...                                        Run Keywords          Modify Channels to support 4DL4UL nrCellType    ${BM_id}  1
    ...                                        AND                   scf.save_scf    ${test_scf_file}
    ...                                        AND                   scf.load_scf    ${test_scf_file}
    ...                                        AND                   Dated log   ====> Modify Channels to support 4DL4UL nrCellType for CellId-1
    ${Need_to_Perform_Commissioning_1}=  Run Keyword if   '${2_2_nrCellType_to_update}'=='True'
    ...                                                        Remove Channels to support 2DL2UL nrCellType    ${BM_id}  ${CellId}
    ...   ELSE                                                 set Variable   ${False}
    Run Keyword if   '${2_2_nrCellType_to_update}'=='True'     Dated log  Remove Channels to support 2DL2UL nrCellType
    ${Need_to_Perform_Commissioning_2}=  Run Keyword if   '${4_4_nrCellType_to_update}'=='True'
    ...                                                             Modify Channels to support 4DL4UL nrCellType   ${BM_id}  ${CellId}
    ...  ELSE                                                       set Variable   ${False}
    Run Keyword if   '${4_4_nrCellType_to_update}'=='True'           Dated log    Modify Channels to support 4DL4UL nrCellType
    Run Keyword if   ${Need_to_Perform_Commissioning_1}==${True} or ${Need_to_Perform_Commissioning_2}==${True}   scf.save_scf    ${test_scf_file}
    [return]    ${Need_to_Perform_Commissioning_1}   ${Need_to_Perform_Commissioning_2}

Modify bits in swconfig
  [Arguments]       ${bit}    ${file_path}    ${connection}
  [Documentation]   change the value of an hexadecimal field (or several fields) with the new value(s), both specified in ${bit} in
  ...               the swconfig file within the path specified ${file_path}. If the hexadecimal field does not exist in the file,
  ...               the hexadecimal field & its value are written into the file initial file is saved in a local directory.
  ...               it returns the local path of the file (for restore initial file purpose)
  ...               ${bit} format can be like "4600BA=2 0x100002=0"
  ...               TAF used: ssh version 3.3.1

  ssh.execute               rm ${file_path}.p7    connection=${connection}
  @{file_name}              split string     ${file_path}    /
  reverse list              ${file_name}
  ${save_file}              join path   ${testCaseDir}    @{file_name}[0]_ini
  ssh.download file         ${file_path}    ${save_file}   connection=${connection}
  ${bit_without_quotes}     Strip String    ${bit}    characters="
  @{bit_splited}            Split String    ${bit_without_quotes}   ${EMPTY}
  FOR   ${element}    IN    @{bit_splited}
        @{bit_splited2}     Split String    ${element}   =
        ${registerId}       fetch from right   @{bit_splited2}[0]   \#
        ssh.send command     grep ${registerId} ${file_path}    connection=${connection}
        ${output}            ssh.read output                    connection=${connection}
        @{output_splited}     Split String    ${output}   =
        ${resp}     Run         grep -i "@{bit_splited2}[0]" ${file_path}
        ssh.execute         chmod 777 ${file_path}     connection=${connection}
        IF              len($output) == 0 and len($resp) == 0 and '#' in $element
                            log     No change
        ELSE IF         len($output) == 0
                            ssh.execute     echo "${element}" >> ${file_path}     connection=${connection}
        ELSE
                            set suite variable      @{cmd_sw}    grep ${registerId} ${file_path} > /dev/null && sed -i
                            ...    "s/@{output_splited}[0]=[0-9]*/${element}/" ${file_path} || echo "${element}" >> ${file_path}
                            set suite variable         ${cmd_sw}        @{cmd_sw}[0] @{cmd_sw}[1]       AND
                            log         ${cmd_sw}
        END
        IF              len($output) != 0
                            ssh.execute       ${cmd_sw}       connection=${connection}
        END
  END

  #Check if reboot needed
  ${save_file_new}          join path   ${testCaseDir}    @{file_name}[0]_new
  ssh.download file         ${file_path}    ${save_file_new}  connection=${connection}
  ${resp}                   Run                       diff ${save_file} ${save_file_new}
  ${len}                    get length      ${resp}
  Run keyword if             ${len}>0                  set test variable    ${reboot}     1

  [Return]                  ${save_file}

MaxMIMO-Layers RAD deactivation
    [Documentation]   MaxMIMO-Layers 0x590004 deactivation
    [Arguments]             ${swconfig_file_path}=/ffs/run/swconfig.txt
    ${alias}                        SSH Wait For Connect                 ${GNB_DU.sys[0].M}
    Modify bits in swconfig    "#0x590004"     ${swconfig_file_path}      ${alias}
    Dated Log                       stopSession : crasign ${swconfig_file_path}
    SSH Exec                        command=crasign ${swconfig_file_path}           alias=${alias}

MaxMIMO-Layers RAD activation
    [Documentation]   MaxMIMO-Layers 0x590004 deactivation
    [Arguments]             ${swconfig_file_path}=/ffs/run/swconfig.txt
    ${alias}                        SSH Wait For Connect                 ${GNB_DU.sys[0].M}
    Modify bits in swconfig    "0x590004=4"     ${swconfig_file_path}      ${alias}
    Dated Log                       stopSession : crasign ${swconfig_file_path}
    SSH Exec                        command=crasign ${swconfig_file_path}           alias=${alias}

