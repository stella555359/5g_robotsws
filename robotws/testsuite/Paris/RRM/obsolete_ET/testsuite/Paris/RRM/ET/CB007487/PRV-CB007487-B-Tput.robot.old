    ...                                                     UEnb=1
    ...                                                     CallType=SA
    ...                                                     Cell=1
    ...                                                     TrafficDuration=60
    ...                                                     DLthroughput=1600
    ...                                                     ULthroughput=200
    ...                                                     deviation=10
    ...                                                     shouldBeStop=False
    ...                                                     shouldBeCheck=False
    ...                                                     w_UE_CSI_TM_for_4_4_DL_MIMO=True
    # ...                                                     GetTtiTraceTime=0
    # ...                                                     GetL1L2TraceTime=0
