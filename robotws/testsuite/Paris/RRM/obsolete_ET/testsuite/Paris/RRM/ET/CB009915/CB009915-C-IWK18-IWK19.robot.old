# Libraries
Library      taf.transport.ssh                                   WITH NAME          ssh
Library      taf.sbts.oam.coam.admin.interface
Library      taf.sbts.oam.coam.admin                             WITH NAME          coam
Library      taf.collectors.tcpdump                              WITH NAME          tcpdump
Library      taf.collectors.core                                 WITH NAME          core
Library      ute_wtssim
Library      taf.config.wts                                      WITH NAME          wts

# Libraries SWENG
Library      ../../../resources/SWENG/python/StringTool.py

# Libraries CB009915
Library      resources/python/Constants-CB009915-C.py            WITH NAME          MyConstants
Library      resources/python/tools.py                           WITH NAME          nps_9915_tools

# Resources taf
Resource      taf/ul/ettf/main.robot

# Resources CB009915
Resource     ./resources/robot/CB009915-Common-Keywords.robot
Resource     ./resources/robot/CB009915-C-Keywords.robot
Resource     ./resources/robot/CB009915-C-Test-Template-Keywords.robot

# Variables taf
Variables     taf/ul/ettf/logging/policies.py
Variables     taf/ul/ettf/log_analysis/policies.py

# Variables CB009915
Variables    ./resources/python/Constants-CB009915-C.py
Variables    ./resources/python/logging_policy.py

# Suites and Tests setup and teardown
Suite Setup       Suite Setup CB009915-C-Common      test_dictParam=${dictParam}
Suite Teardown    Suite Teardown CB009915-C-Common
Test Setup        Test Setup for CB009915-Common
Test Teardown     Test Teardown for CB009915-Common

