*** Variables ***

# capture setting
&{CAPTURE_L1L2}                                 is_capture_core=${False}
...                                             is_capture_cprt=${True}
...                                             is_capture_l1l2=${True}

&{CB007103_D02}                                 capture_duration=0                      # capture duration during traffic starting phase
...                                             deviation=99                            # default deviation for throughput and double for uplink
...                                             dir=UL+DL
...                                             dldev=0                                 # DL deviation on tput for PM check
...                                             uldev=1                                 # UL deviation on tput for PM check
...                                             duration=3                              # traffic duration during declaration phase
...                                             pm_waiting_period=2                     # number of waiting periods added for observation
...                                             target_gnb=2                            # gnb target id
...                                             total_nb_cell=1                         # total number of cell used for ue's dispatching
...                                             total_nb_ue=0                           # total number of ue's to configure
...                                             sfnMarg=1
...                                             slotMarg=0
...                                             dod=${AcceptanceCriteriaD2}               # Values to checks
...                                             PMdod=testsuite/Paris/RRM/ET/CB007103/resources/config/PM/CB007103-D_Constraints.csv

&{CB007103_D04}                                 capture_duration=0                      # capture duration during traffic starting phase
...                                             deviation=99                            # default deviation for throughput and double for uplink
...                                             dir=UL+DL
...                                             dldev=0                                 # DL deviation on tput for PM check
...                                             uldev=1                                 # UL deviation on tput for PM check
...                                             duration=3                              # traffic duration during declaration phase
...                                             pm_waiting_period=2                     # number of waiting periods added for observation
...                                             target_gnb=2                            # gnb target id
...                                             total_nb_cell=1                         # total number of cell used for ue's dispatching
...                                             total_nb_ue=0                           # total number of ue's to configure
...                                             sfnMarg=1
...                                             slotMarg=0
...                                             dod=${AcceptanceCriteriaD4}               # Values to checks
...                                             PMdod=testsuite/Paris/RRM/ET/CB007103/resources/config/PM/CB007103_Constraints_D_TC04.csv


# ue's settings # configuration based chBW=40Mhz
&{dict_settings_7103D02_ue_01}                  ueid=1
...                                             original_cell=1                         # original cell for call establishment
...                                             throughput=${NO_THROUGHPUT}             # For CRT, else same as UE2, dl throughput nonGBR max
...                                             throughput_gbr=${NO_THROUGHPUT}         # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                             throughput_ul=${NO_THROUGHPUT}          # For CRT, else same as UE2, ul throughput nonGBR max for ue

&{dict_settings_7103D02_ue_02}                  ueid=2
...                                             original_cell=2                         # original cell for call establishment
...                                             throughput=875                          # dl throughput nonGBR max
...                                             throughput_gbr=${NO_THROUGHPUT}         # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                             throughput_ul=10                        # 80 ul tput nonGBR max

&{dict_settings_7103D04_ue_01}                  ueid=1
...                                             original_cell=1                         # original cell for call establishment
...                                             throughput=525                          # For CRT, else same as UE2, dl throughput nonGBR max
...                                             throughput_gbr=${NO_THROUGHPUT}         # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                             throughput_ul=80                        # ul throughput nonGBR max

&{dict_settings_7103D04_ue_03}                  ueid=3
...                                             original_cell=3                         # original cell for call establishment
...                                             throughput=525                          # dl throughput nonGBR max
...                                             throughput_gbr=${NO_THROUGHPUT}         # dl throughput GBR for ue or ${NO_THROUGHPUT}
...                                             throughput_ul=80                        # ul tput nonGBR max


&{dict_settings_ue_default}                     original_cell=1
...                                             throughput=100
...                                             throughput_gbr=${NO_THROUGHPUT}
...                                             throughput_ul=20

@{dict_settings_7103D04}                        ${dict_settings_7103D04_ue_01}
...                                             ${dict_settings_7103D04_ue_03}

