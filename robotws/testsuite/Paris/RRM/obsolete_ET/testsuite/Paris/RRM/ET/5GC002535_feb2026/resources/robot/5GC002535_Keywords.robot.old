# cmd reset eGate
#######################################################################################################################

Reset_eGate
   [Arguments]                 ${alias}=${HOST_EPCSIM.alias}
   Log to console  \n***Cmd Reset eGate alias=${alias}***
   sleep   2
   wts.execute egate command    cmd=reset   alias=${alias}

