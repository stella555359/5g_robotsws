*** Variables ***

&{OPT_GNB_MIRRORING}                bb_slot=bb_slot_1
...                                 mirroring_mode='manual'
...                                 bb_board_type='ABIL'
...                                 l2_l1_bip='false'
...                                 syscom_mirroring='false'
...                                 carrier_aggregation='false'
...                                 backhaul_mirroring='false'
...                                 l2hi_l2lo_mirroring='false'
...                                 filtering='off'
...                                 capturing_time_seconds='1'

# Table describing list of field we want to collect for each packet
@{FIELDS_PUCCH_REQ}                 slot        sfn         rnti        pucchFormat     startPrb
...                                 numOfBitsOfUciInformation           nANPucch        numOfSymbols
...                                 firstSymbol
@{FIELDS_PUCCH_RESP}                slot        sfn         rnti        pucchFormat     startPrb
...                                 dtx         ackNack     crc
@{FIELDS_PDSCHSendReq}              rat0Bitmap        rbgSize         numOfPrb    numOfDmrsCdmGroupWithoutData
@{FIELDS_PUCCHreceivereq}                           pucchFormat          startPrb         nANPucch
@{FIELDS_PUSCHreceivereq}           numOfPrb       startPrb

# Global counters to build status when parsing pucchResp packets
${NbReq}                            0           # Number of pucchReq packets found
${NbNone}                           0           # Number of pucchReq with no pucchResp found
${NbOK}                             0           # Number of pucchReq/resp where numOfBitsOfUci is OK
${NbKO}                             0           # Number of pucchReq/resp where numOfBitsOfUci is KO

*** Keywords ***
# robocop: off=unused-argument
# robocop: off=possible-variable-overwriting
#===================================
# To Start and stop Traces for 2535
#===================================

return filter for capture
    [Documentation]       return filter for capture
    ...                   test_scf_file is gloval variable
    ...                   Only for Classical
    [Arguments]                    ${filter}    ${name}=CAPTURE_L1L2_GNB_FS
    ${current_scf_fullname}    set Variable      ${test_scf_file}
    scf.load_scf	 ${current_scf_fullname}
    ${ipAddr}	 scf.get_value_from_scf   p_name=localIpAddr
    ...              dist_name=MRBTS-${MRBTS_ID}/TNLSVC-1/TNL-1/IPNO-1/IPIF-1/IPADDRESSV4-1
    ${filter}       Catenate    ${filter}    or host ${ipAddr}
    Dated log          ${name}.filter = ${filter}
    [return]     ${filter}

Start capture for 2535
    [Documentation]                 Start capture for 2535
    [Arguments]                    ${prefix}=L1L2_BIP

    # set a specific name to keep the trace
    ${CAPTURE_L1L2_GNB_FS_2535.prefix}       set Variable   ${prefix}
    ${CAPTURE_L1L2_GNB_FS_2535.withTN}       set Variable   True
    # ${CAPTURE_L1L2_GNB_FS_2535.filter}       Get Filter all BIP msgs
    # to manage the case vlan218 encapsulated within vlan305 (seen with ABIO / ABIP) and the case vlan218 only (seen with ABIP & ABIL)
    ${CAPTURE_L1L2_GNB_FS_2535.filter}       set variable   ether[12:2]=0x8951 or ether[16:2]=0x8951

    # Get SCF File (SCF.xml) in Kw 'Test case setup'
    ${CAPTURE_L1L2_GNB_FS_2535.filter}=     run Keyword if    '${isAiC}' != '${True}'
    ...                                        return filter for capture    filter=${CAPTURE_L1L2_GNB_FS_2535.filter}   name=CAPTURE_L1L2_GNB_FS_2535
    ...   ELSE                              set variable      ${CAPTURE_L1L2_GNB_FS_2535.filter}

    # ${current_scf_fullname}    set Variable      ${test_scf_file}
    # scf.load_scf	 ${current_scf_fullname}
    # ${ipAddr}	 scf.get_value_from_scf   p_name=localIpAddr
    # ...              dist_name=MRBTS-${MRBTS_ID}/TNLSVC-1/TNL-1/IPNO-1/IPIF-1/IPADDRESSV4-1
    # ${CAPTURE_L1L2_GNB_FS_2535.filter}       Catenate    ${CAPTURE_L1L2_GNB_FS_2535.filter}    or host ${ipAddr}
    # Dated log          CAPTURE_L1L2_GNB_FS_2535.filter = ${CAPTURE_L1L2_GNB_FS_2535.filter}
    # ${CAPTURE_L1L2_GNB_FS_2535.filter}       set variable         ${CAPTURE_L1L2_GNB_FS_2535.filter}

    Capture Init                   capture=${CAPTURE_L1L2_GNB_FS_2535}
    Capture Start                  ${CAPTURE_L1L2_GNB_FS_2535}


Stop capture for 2535
    Capture Stop                   ${CAPTURE_L1L2_GNB_FS_2535}

    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CAPTURE_L1L2_GNB_FS_2535.path}
    Run Keyword And Ignore Error    OperatingSystem.Move File    ${CAPTURE_L1L2_GNB_FS_2535.path}    ${testCaseDir}
    Dated Log     pcap file ${CAPTURE_L1L2_GNB_FS_2535.path} copied into ${testCaseDir}

    # Dated log                       pdml files generation ...
    # ${pdmlFile}=          analyzer.pcap_to_pdml          ${CAPTURE_L1L2_GNB_FS_2535.path}
    # Dated log                       pdml files generation completed ...

    # [return]   ${pdmlFile}


################################################################################################################################
#               To test 2535 Alarms
################################################################################################################################

Check 2535 Active Alarms
    [Tags]      ALARMS_CHECK
    [Arguments]    ${fault_id}

    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}

    Fault Should Be Present   fault_id=${fault_id}

    [Teardown]    OAM Disconnect                          ${GNB_DU.oam}

Check Clear 2535 Active Alarms
    [Tags]      ALARMS_CHECK
    [Arguments]    ${fault_id}

    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}

    Fault Should Not Be Present   fault_id=${fault_id}

    [Teardown]    OAM Disconnect                          ${GNB_DU.oam}

Fault Should Be Present
    [Documentation]
    ...
    [Arguments]    ${fault_id}
    Dated log          KW - Fault Should Be Present fault_id=${fault_id}
    ${active_alarms}     OAM Get Active Alarms                   oam=${GNB_DU.oam}       textFormat=${False}
    ${len}    Get Length    ${active_alarms}
    ${alarm_id_list}    Create List
    ${alarm_name_list}    Create List
    FOR    ${i}    IN RANGE    ${len}
        ${tmp_id}    Get From Dictionary    ${active_alarms[${i}]}    faultId
        ${tmp_name_id}    Get From Dictionary    ${active_alarms[${i}]}    faultName
        Append To List    ${alarm_id_list}    ${tmp_id}
        Append To List    ${alarm_name_list}    ${tmp_name_id}
    END
    Dated log     Active alarms: alarm_id_list=${alarm_id_list}
    Dated log     Active alarms: alarm_name_list=${alarm_name_list}
    ${list}     convert to string  ${alarm_id_list}
    Should Contain     ${list}    ${fault_id}

Fault Should Not Be Present
    [Documentation]
    ...
    [Arguments]    ${fault_id}
    Dated log     KW - Fault Should Not Be Present fault_id=${fault_id}
    ${active_alarms}     OAM Get Active Alarms                   oam=${GNB_DU.oam}        textFormat=${False}
    ${len}    Get Length    ${active_alarms}
    ${alarm_id_list}    Create List
    FOR    ${i}    IN RANGE    ${len}
        ${tmp_id}    Get From Dictionary    ${active_alarms[${i}]}    faultId
        Append To List    ${alarm_id_list}    ${tmp_id}
    END
    Dated log     Active alarms: alarm_id_list=${alarm_id_list}
    ${list}     convert to string  ${alarm_id_list}
    Should Not Contain     ${list}    ${fault_id}

################################################################################################################################
#              END :  To test 2535 Alarms
################################################################################################################################


