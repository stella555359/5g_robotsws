#
######################################################################################################################"

NSA CellSetup
    [Documentation]         [PRIVATE]       Start WTS, setup X2 and check cellsetup
    [Arguments]                    ${nbCell}=2
    ${nbCell}        Convert to string    ${nbCell}
    CallSetup.WTS Setup            nbCell=${nbCell}

TC 2535 CellSetup
    [Documentation]                Generic test for 2535: test purpose is to setup X2 ans check cellsetup
    [Arguments]                    ${param}      ${alias}=default
    Init Sequence                  ${param}
    5GC002535_Keywords.Restart     OwnTLReset=${False}
    Step                           Start capture for 2535        argument=TC_2535_CellSetup.wL1L2Bip       depends=5GC002535_Keywords.Restart
    # Step                           CallSetup.WTS Setup
    # argument is nbCell unlocked
    Step                           5GC002535_Keywords.NSA CellSetup     argument=${param.Context.nbr_cell_unlock}
    Run Keyword if   '${TRACE_SHOULD_BE_STOP_AFTER_CELLSETUP}' == '1'    Step   Stop capture for 2535        depends=Start capture for 2535
    Critical Step                  5GC002535_Ue_command.Verify AP Classical Cell Setup
    [Teardown]                      GenericTest.Display diagnosis

#################################################################################################################################################
# 5g Call Setup
#################################################################################################################################################

Test SgNB Addition PRACH
    ${capture_path}      CallSetup.SgNB Addition to ENB          ueSetting=${ueProfile1}
    Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${capture_path}
    Run Keyword And Ignore Error    OperatingSystem.Copy File    ${capture_path}    ${testCaseDir}

Check numOfDmrsCdmGroupWithoutData on DlData_PdschSendReq
    [Documentation]                 Retrieve from pdml value of numOfDmrsCdmGroupWithoutData
     ...                            from message DlData_PdschSendReq and check numOfDmrsCdmGroupWithoutData.
    [Arguments]                     ${pdmlFile}       ${numOfDmrsCdmGroupWithoutDataToCheck}=0x00000002

    ${NbOK}                    Evaluate     0
    ${NbKO}                    Evaluate     0
    Set Suite Variable              ${NbOK}
    Set Suite Variable              ${NbKO}

    # ${pdmlFile}                     set variable            ${CURDIR}/L1L2_BIP_GNB_FS_UL_TPUT.5GC001586_C_TC_03_5GC001586-C_NSA_Check_UL_Tput.pdml
    # 1 - Retrieve from pdml all DlData_PdschSendReq
    Dated log                       \tGetting all DlData_PdschSendReq
    @{listAllPdschSendReq}          analyzer.get_match_from_paths
    ...                             pdmlFile=${pdmlFile}
    ...                             packetName=DlData_PdschSendReq
    ...                             pathList=${FIELDS_PDSCHSendReq}
    ${lenPdschSendReq}                  get length                          ${listAllPdschSendReq}
    Dated log                       \tNB of DlData_PdschSendReq:${lenPdschSendReq}
    # 2 - For each PdschSendReq, find corresponding PdschSendReq (same numOfDmrsCdmGroupWithoutData)
    FOR    ${packet}       IN          @{listAllPdschSendReq}
           #  Retrieve numOfPrb  for current PdschSendReq
           ${numOfDmrsCdmGroupWithoutData}            Get Value In Packet Match
           ...                                                     packetMatch=${packet}
           ...                                                     field=numOfDmrsCdmGroupWithoutData
          #  Dated log                 numOfDmrsCdmGroupWithoutData:${numOfDmrsCdmGroupWithoutData}
          ${comp}                     compareInDecimal   ${numOfDmrsCdmGroupWithoutData}   ${numOfDmrsCdmGroupWithoutDataToCheck}
          Run Keyword If    ('${comp}'!='True')
          ...                            New Case KO
    END
    ${PASSED}             evaluate       (${NbKO}*100)/${lenPdschSendReq}
    ${PASSED}             Convert to Number        ${PASSED}      2
    Dated log              \t%nrOf_KO [numOfDmrsCdmGroupWithoutData!=${numOfDmrsCdmGroupWithoutDataToCheck}]:${PASSED}%
    Should Be Equal        ${PASSED}          ${0}

New Case OK
    ${NbOK}                         Evaluate                            ${NbOK}+1
    Set Suite Variable              ${NbOK}

New Case KO
    ${NbKO}                         Evaluate                            ${NbKO}+1
    Set Suite Variable              ${NbKO}

New Case NONE
    ${NbNone}                       Evaluate                            ${NbNone}+1
    Set Suite Variable              ${NbNone}

TC 2535-5gCall
    [Documentation]                Test purpose is to test 5g  Call
    [Arguments]                    ${param}
    Init Sequence                  ${param}
    Step         5GC002535_Keywords.Test SgNB Addition PRACH
    Step         CallSetup.UE Attach Check                        depends=Test SgNB Addition PRACH
    Run Keyword if      '${TRACE_SHOULD_BE_STOP_AFTER_CELLSETUP}' == '0'     Step      Stop capture for 2535
    [Teardown]          GenericTest.Display diagnosis


Start SYSLOG tput log capture
    return from Keyword if   ${isAiC}
    Dated log     SSH on ${GNB_DU.sys[0].M.sshId}
    ${aliasGNB}          SSH Wait For Connect        ${GNB_DU.sys[0].M}
    set test variable     ${aliasGNB}
    ${tput_log_file_path_gnb}     Start tput log capture    gnb_index=0
    ...                                                     gnb_alias=${aliasGNB}
    [return]     ${tput_log_file_path_gnb}


Check SYSLOG tput log capture
