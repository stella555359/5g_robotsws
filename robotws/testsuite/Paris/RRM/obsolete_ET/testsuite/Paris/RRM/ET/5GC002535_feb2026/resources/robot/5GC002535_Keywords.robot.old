Check numOfDmrsCdmGroupWithoutData based on L1L2 pcap
    [Arguments]      ${param}     ${filename}
    5GC002535_Keywords.Extract numOfDmrsCdmGroupWithoutData from L1L2 Pcap       File=${filename}
    ${UeList}    5GC002535_tools.get_rntis_from_pcap     ${testCaseDir}
    Dated log       UeList=${UeList}
    ${Rnti_UeId1}   set variable     ${UeList}[0]
    Dated log     verify_5GC002535_numOfDmrsCdmGroupWithoutData for Ue_RNTI ${Rnti_UeId1}
    ${output}=    5GC002535_tools.Verify QC Test Case    verify_5GC002535_numOfDmrsCdmGroupWithoutData
    ...                                                          rnti_ue=${Rnti_UeId1}
    ...                                                          rdMcsIndexForDmrsFDMThreshold=${param.scfFile.nrcell.dlDataDmrsFdmThres256QamMcs}
    [return]     ${output}

# check numOfDmrsCdmGroupWithoutData into pdml file
# <field name="DlData_PdschSendReq.PdschSendReq.numOfDmrsCdmGroupWithoutData" showname="numOfDmrsCdmGroupWithoutData
#   (Uint8): 0x02(2)" size="1" pos="98" show="0x00000002" value="02"/>
TC 2535-DLOnly and check numOfDmrsCdmGroupWithoutData
    [Documentation]                Generic test: test purpose is to check numOfDmrsCdmGroupWithoutData
    ...                            Acceptance criteria based on TtiTrace
    [Arguments]                    ${param}
    Init Sequence                  ${param}
    Point ENB_BUILD to luashark sw package
    Point AF_PATH to current sw package
    ${CaptureBIP_wo_filtering}      Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    ${CaptureBIP_wo_filtering.prefix}   set Variable   TC_2535.wDLTput.wL1L2Bip.woFiltering.gNB.FS
    #   L1L2_BIP_WO_FILTERING_GNB_FS_DL_TPUT
    Set Suite Variable       ${CaptureBIP_wo_filtering}

    ${tput_log_file_path_gnb}        Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'       Start SYSLOG tput log capture
    ...       ELSE                                                                                        set variable       ${EMPTY}

    Capture Init      capture=${CaptureBIP_wo_filtering}
    Capture Start     ${CaptureBIP_wo_filtering}
    Dated Log         Start TTI Traces in Streaming Mode
    ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traffic UE DL    ueSetting=${ueProfile1}  throughput=${param.seq.dl_throughput}  duration=1s
    ...                             shouldBeStop=${param.seq.stopTraffic}    shouldBeCheck=${param.seq.shouldBeCheck}  deviation=10
    Capture Stop      ${CaptureBIP_wo_filtering}
    # ${branch} is a test suite variable intialized during test suite setup Kw
    ${l1l2ItfVersion}=   Run Keyword And Return Status   Should Match Regexp     ${branch}     ^SBTS25R[2-9]|SBTS00$
    ${filter}=    Run Keyword If    ${l1l2ItfVersion}   set variable     dldata_pdschsendreql1sw
    ...               ELSE                              set variable     dldata_pdschsendreq
    Run Keywords      Dated log      Filtering pcap ${CaptureBIP_wo_filtering.path} with filter=${filter}...   AND
    ...               5GC002535_Keywords.Filter Pcap           src=${CaptureBIP_wo_filtering.path}
    ...                                                        dest=${CaptureBIP_wo_filtering.name}_${filter}.pcap
    ...                                                        filter=${filter}
    # ...                                                        lua_path=/opt/luashark/generated_luashark/luashark.lua
    ${filtered_pcap}=   5GC002535_Keywords.Filter Pcap with Tshark
    ...                                                        pcap_file_full_path=${CaptureBIP_wo_filtering.path}
    ...                                                        filterName=${filter}_2
    ...                                                        filterExp=${filter}
    Run Keyword And Ignore Error     OperatingSystem.Move File   ${CaptureBIP_wo_filtering.name}_${filter}.pcap  ${testCaseDir}
    Run Keyword And Ignore Error     OperatingSystem.Move File   ${filtered_pcap}  ${testCaseDir}
    Run Keyword And Ignore Error     OperatingSystem.File Should Exist   ${CaptureBIP_wo_filtering.path}
    Run Keyword And Ignore Error     OperatingSystem.Move File   ${CaptureBIP_wo_filtering.path}  ${testCaseDir}
    Dated log         Stop TTI Traces in Streaming Mode...
    ${tti_trace_filename}=   set variable    ttitrace_streaming
    ${tti_trace_path}=     ttitrace.Stop TTI Traces in Streaming Mode   tti_trace_path=${testCaseDir}   tti_trace_filename=${tti_trace_filename}
    Dated log         Convert TTI trace from pcap to excelCsv...
    Run keyword and continue on failure    ttitrace.Convert TTI trace from pcap to excelCsv     input_file_path=${tti_trace_path}
    ...                                                                                         output_file_path=${testCaseDir}
    ${tti_traces_file_msg_all_csv}   nps_ttitraces_tools.decode_tti_traces_Using_TtitraceReaderEvtDec   desired_storage_directory=${testCaseDir}
    ...                                                                                              desired_file_name=${tti_trace_filename}.pcap
    ...                                                                                              num_of_events=1000
    run Keyword if    '${DL_TPUT_CHECK_BASED_PCAP}' == '1'   Check numOfDmrsCdmGroupWithoutData based on pcap traces
    ...                                                                    ${param}
    ...                                                                    filename=${testCaseDir}/${CaptureBIP_wo_filtering.name}_${filter}.pcap
    ${output}      run Keyword if    ${isAiC}    Check numOfDmrsCdmGroupWithoutData based on L1L2 pcap
    ...                                                                    ${param}
    ...                                                                    filename=${testCaseDir}/${CaptureBIP_wo_filtering.name}_${filter}.pcap
    ${output}       run Keyword if    '${DL_TPUT_CHECK_BASED_TTITRACE}' == '1'   Check numOfDmrsCdmGroupWithoutData based on TTI traces   ${param}
    run Keyword If    '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'      Check SYSLOG tput log capture
    ...                                                                               tput_log_file_path_gnb=${tput_log_file_path_gnb}
    [return]     ${output}

TC 2535-DLOnly and check numOfDmrsCdmGroupWithoutData VRAN dedicated
    [Documentation]                Generic test: test purpose is to check numOfDmrsCdmGroupWithoutData
    ...                            Acceptance criteria based on L1L2 Bip Pcap
    [Arguments]                    ${param}
    Init Sequence                  ${param}
    Point ENB_BUILD to luashark sw package
    Point AF_PATH to current sw package
    ${CaptureBIP_wo_filtering}      Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    ${CaptureBIP_wo_filtering.prefix}   set Variable   TC_2535.wDLTput.wL1L2Bip.woFiltering.gNB.FS
    Set Suite Variable       ${CaptureBIP_wo_filtering}

    ${tput_log_file_path_gnb}        Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'       Start SYSLOG tput log capture
    ...       ELSE                                                                                        set variable       ${EMPTY}

    Capture Init      capture=${CaptureBIP_wo_filtering}
    Capture Start     ${CaptureBIP_wo_filtering}
    Dated Log         Start TTI Traces in Streaming Mode
    ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traffic UE DL    ueSetting=${ueProfile1}  throughput=${param.seq.dl_throughput}  duration=1s
    ...                             shouldBeStop=${param.seq.stopTraffic}    shouldBeCheck=${param.seq.shouldBeCheck}  deviation=10
    Dated log         Stop TTI Traces in Streaming Mode...
    ${tti_trace_filename}=   set variable    ttitrace_streaming
    ${tti_trace_path}=     ttitrace.Stop TTI Traces in Streaming Mode   tti_trace_path=${testCaseDir}   tti_trace_filename=${tti_trace_filename}
    Capture Stop      ${CaptureBIP_wo_filtering}
    ${filter}=       set variable     dldata_pdschsendreq
    Run Keywords      Dated log      Filtering pcap ${CaptureBIP.path} with filter=${filter}...   AND
    ...               5GC002535_Keywords.Filter Pcap          src=${CaptureBIP_wo_filtering.path}
    ...                                                       dest=${CaptureBIP_wo_filtering.name}_${filter}.pcap
    ...                                                       filter=${filter}
    # ...                                                       lua_path=/opt/luashark/generated_luashark/luashark.lua
    ${filtered_pcap}=   5GC002535_Keywords.Filter Pcap with Tshark
    ...                                                       pcap_file_full_path=${CaptureBIP_wo_filtering.path}
    ...                                                       filterName=${filter}_2
    ...                                                       filterExp=${filter}
    Run Keyword And Ignore Error     OperatingSystem.Move File   ${CaptureBIP_wo_filtering.name}_${filter}.pcap  ${testCaseDir}
    Run Keyword And Ignore Error     OperatingSystem.Move File   ${filtered_pcap}  ${testCaseDir}
    Run Keyword And Ignore Error     OperatingSystem.File Should Exist   ${CaptureBIP_wo_filtering.path}
    Run Keyword And Ignore Error     OperatingSystem.Move File   ${CaptureBIP_wo_filtering.path}  ${testCaseDir}
    # Dated log         Convert TTI trace from pcap to excelCsv...
    # Run keyword and continue on failure    ttitrace.Convert TTI trace from pcap to excelCsv     input_file_path=${tti_trace_path}
    #                                                                                             output_file_path=${testCaseDir}
    # ${tti_traces_file_msg_all_csv}   nps_ttitraces_tools.decode_tti_traces_Using_TtitraceReaderEvtDec   desired_storage_directory=${testCaseDir}
    # ...                                                                                              desired_file_name=${tti_trace_filename}.pcap
    # ...                                                                                              num_of_events=1000
    run Keyword if    '${DL_TPUT_CHECK_BASED_PCAP}' == '1'         Check numOfDmrsCdmGroupWithoutData based on pcap traces   ${param}
    ...                                                                     filename=${testCaseDir}/${CaptureBIP_wo_filtering.name}_${filter}.pcap
    # Acceptance criteria for AiC case
    ${output}      run Keyword if    ${isAiC}       Check numOfDmrsCdmGroupWithoutData based on L1L2 pcap   ${param}
    ...                                                                     filename=${testCaseDir}/${CaptureBIP_wo_filtering.name}_${filter}.pcap
    # ${output}       run Keyword if    '${DL_TPUT_CHECK_BASED_TTITRACE}' == '1'   Check numOfDmrsCdmGroupWithoutData based on TTI traces   ${param}
    run Keyword If    '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'      Check SYSLOG tput log capture
    ...                                                                               tput_log_file_path_gnb=${tput_log_file_path_gnb}
    [return]     ${output}

Check numOfDmrsCdmGroupWithoutData based on pcap traces
    [Arguments]                    ${param}     ${filename}
    # Init Sequence                  ${param}
    pcap.Point to luashark scripts via AF_PATH variable
    Dated log                       pcap.Convert pcap to pdml file [DlData_PdschSendReqL1sw filtered]...
    ${pdmlFileBIP_DL}     pcap.Convert pcap to pdml file   ${filename}      message=DlData_PdschSendReqL1sw
    Dated log                       Checking numOfDmrsCdmGroupWithoutData on DlData_PdschSendReqL1sw...
    Check numOfDmrsCdmGroupWithoutData on DlData_PdschSendReq     ${pdmlFileBIP_DL}    ${param.seq.numOfDmrsCdmGroupWithoutData}

Check numOfDmrsCdmGroupWithoutData based on TTI traces
    [Arguments]                    ${param}
    ${resultDir}=     5GC002535_Keywords.Get Testcase Log Directory
    ${UeList}    nps_2535_tools.get_rntis     ${resultDir}
    ${UeId1}   set variable     ${UeList}[0]
    Dated log     verify_5GC002535_DL_numOfDmrsCdmGroupWithoutData_Based_Mcs for Ue_RNTI ${UeId1}
    ${output}=    5GC002535_tools.Verify QC Test Case    verify_5GC002535_DL_numOfDmrsCdmGroupWithoutData_Based_Mcs
    ...                                                          rnti_ue=${UeId1}
    ...                                                          rdMcsIndexForDmrsFDMThreshold=${param.scfFile.nrcell.dlDataDmrsFdmThres256QamMcs}
    ...                                                          method="Expand array item Field"
    [return]    ${output}

Extract numOfDmrsCdmGroupWithoutData from L1L2 Pcap
    [Arguments]                     ${File}
    [Documentation]                 Extract numOfDmrsCdmGroupWithoutData from L1L2 Bip Pcap

    Dated log                   Checking numOfDmrsCdmGroupWithoutData inside PCAP file    ${File}

    set test variable    ${pcapprocessed_2535_L1L2}    pcapprocessed_2535_L1L2.txt
    set test variable    ${pcapprocessed_2535_L1L2_path}    ${LOG_PATH}/${pcapprocessed_2535_L1L2}
    ${cmd}    catenate      tshark -X lua_script:/opt/luashark/generated_luashark/luashark.lua -r
    ...        ${File} -T fields -Y "icom_5g" -e _ws.col.Info
    ...           -e DlData_PdschSendReq.PdschSendReq.sfn
    ...           -e DlData_PdschSendReq.PdschSendReq.slot
    ...           -e DlData_PdschSendReq.grants_item_0.rnti
    ...           -e DlData_PdschSendReq.grants_item_0.mcs
    ...           -e DlData_PdschSendReq.grants_item_0.rvIndex
    ...           -e DlData_PdschSendReq.grants_item_0.numOfLayers
    ...           -e DlData_PdschSendReq.grants_item_0.numOfDmrsCdmGroupWithoutData
    ...           -E header=y -E separator=';' > ${pcapprocessed_2535_L1L2_path}
    Run       ${cmd}

    ${extract}   OperatingSystem.grep file        ${pcapprocessed_2535_L1L2_path}   ICOM_5G/DlData_PdschSendReq
    run keyword if  len($extract)==0     fail   dldata_pdschsendreq not found

    OperatingSystem.copy file     ${pcapprocessed_2535_L1L2_path}    ${testCaseDir}/msg_DlData_PdschSendReq_pcap.csv


Verify if nc process is killed
    [Documentation]  Author: Ch Samson
    [Arguments]  ${gnb_alias}=Master
    ${is_nc_process_started}    common.is_process_exist    process_name=51000    connection=${gnb_alias}
    Should not be true    ${is_nc_process_started}

kill nc process
    [Documentation]  Author: Ch Samson
    [Arguments]  ${gnb_alias}=Master
    ${is_nc_process_killed}    common.kill_process_by_name    process_name=51000    connection=${gnb_alias}
    Should be true    ${is_nc_process_killed}

Start tput log capture
    [Documentation]    Author: Ch Samson
    ...                Description: Start L2LO throughput log capturing from aasyslog and return the log path in GNB
    ...                             It can only support for 1 GNB currently,
    ...                             due to the limitation for common keyword 'Connect to Capacity Unit Master'
    ...                             If started separate nc processes for UL and DL, then log records will be influenced.
    ...                             So captured both UL and DL tput log in one log file at the same time.
    ...                Return the tput file path on GNB: /tmp/Tput_ul_dl.txt
    [Arguments]  ${gnb_index}=0    ${gnb_alias}=Master    ${du_index}=0

    aasyslog.aasyslog_realtime_output_configuration    host=${tl.gnbs[0].dus[0].airscale.common_units[0].lmp_connection.addr}
    ...    username=${tl.gnbs[0].dus[0].airscale.common_units[0].lmp_connection.username}
    ...    password=${tl.gnbs[0].dus[0].airscale.common_units[0].lmp_connection.password}    type=mcu

    ${is_nc_process_started}    common.is_process_exist    process_name=51000    connection=${gnb_alias}

    Run keyword if    ${is_nc_process_started}
    ...    Run keywords    Log to console    Existing aasys log process exists, will close it before starting tput log capturing    AND
    ...    kill nc process    gnb_alias=${gnb_alias}

    Wait until keyword succeeds    5s    200ms    Verify if nc process is killed    gnb_alias=${gnb_alias}

    #  command="nc -u -w 100 -l 127.0.0.1 51000 > /tmp/Tput_gnb.txt"
    ${tput_log_file_path_gnb_combined}     common.start_nc_aasyslog        connection=${gnb_alias}

    Sleep    200ms

    ${is_nc_process_started}    common.is_process_exist    process_name=51000    connection=${gnb_alias}

    Should be true    ${is_nc_process_started}

    [Return]    ${tput_log_file_path_gnb_combined}

Check Throughput from aasyslog
    [Documentation]    Author: Ch Samson
    [Arguments]   ${gnb_alias}=Master     ${tput_log_file_path_gnb_combined}=/tmp/Tput_ul_dl.txt

    ${is_nc_process_started}    common.is_process_exist    process_name=51000    connection=${gnb_alias}

    # command="ps -ef |grep 51000|grep -v grep| awk '{print $2}'|xargs kill -9"
    Run keyword if    ${is_nc_process_started}
    ...    Run keywords     Dated log      Existing aasys log process exists, will close it before starting tput log capturing    AND
    ...    kill nc process    gnb_alias=${gnb_alias}

    Wait until keyword succeeds    5s    200ms    Verify if nc process is killed    gnb_alias=${gnb_alias}

    Dated log     Calculate UL and DL throughput with ${tput_log_file_path_gnb_combined}
    ${ul_tp_l2lo}=        nps_2535_tools.Calculate_UL_throughput2      alias=${gnb_alias}     file_name=${tput_log_file_path_gnb_combined}
    ${dl_tp_l2lo}=        nps_2535_tools.Calculate_DL_throughput2      alias=${gnb_alias}     file_name=${tput_log_file_path_gnb_combined}
    ${cur_time}    Get Current Date
    log to console    Current time : ${cur_time}, DL actual throughput(Mbps): ${dl_tp_l2lo}
    log to console    Current time : ${cur_time}, UL actual throughput(Mbps): ${ul_tp_l2lo}


Check UL Throughput
    [Documentation]
    [Arguments]    ${ul_expect}=${UL_EXPECT}
    ...            ${ul_throughput_list}=${UL_THROUGHPUT_LIST}

    Calculate UL throughput on gnb L2Lo case    ul_expect=${ul_expect}    ul_throughput_list=${ul_throughput_list}

Check UL DL Throughput
    [Documentation]
    [Arguments]    ${ul_expect}=${UL_EXPECT}    ${dl_expect}=${DL_EXPECT}
    ...            ${ul_throughput_list}=${UL_THROUGHPUT_LIST}    ${dl_throughput_list}=${DL_THROUGHPUT_LIST}

    Calculate UL throughput on gnb L2Lo case    ul_expect=${ul_expect}    ul_throughput_list=${ul_throughput_list}
    Calculate DL throughput on gnb L2Lo case    dl_expect=${dl_expect}    dl_throughput_list=${dl_throughput_list}

Calculate UL throughput on gnb L2Lo case
    [Documentation]
    ...             This keyword check the UL throughput in gnb l2lo and compare with expect value.
    [Arguments]     ${ul_expect}    ${ul_throughput_list}
    ${LogL2RT}                      Container.Get Log                                 name=L2RT
    Dated log     SSH on ${GNB_DU.bb[0].S.sshId}
    ${aliasL2RT}         SSH Wait For Connect                    ${GNB_DU.bb[0].S}

    # Dated Log       LogL2RT = ${LogL2RT}
    # Dated Log       LIST_LOG = @{LIST_LOG}

    ${ZipLog}                       Set variable                            ${LogL2RT.path.replace('.log','.zip')}
    Dated log                       Check ASP:ZIPLOG=${ZipLog}
    ${output}                       SSH Cmd
    ...                             ls -lrt ${ZipLog}                       alias=${aliasL2RT}
    ${len}                          Get Length                              ${output}
    Dated log                       Presence ${ZipLog} = ${len} output=${output.strip()}
    ${nodeL2RT}                     Get Node         L2RT
    Dated log                       LogL2RT.prefix = /tmp/node_${nodeL2RT.id}/${LogL2RT.prefix}
    Run Keyword If                  ${len} != 0
    ...                             SSH Cmd
    ...                             unzip -o -d /tmp/node_${nodeL2RT.id}/${LogL2RT.prefix} ${ZipLog}              alias=${aliasL2RT}
    Dated log                       Grep into ${LogL2RT.path}
    # ${output}                       SSH Cmd
    # ...                             grep --line-buffered "rlcPduBytes" ${LogL2RT.path}
    # ...                             alias=${aliasL2RT}

    Dated log     Calculate_UL_throughput with ${LogL2RT.path}
    ${ul_tp_l2lo}=        nps_2535_tools.Calculate_UL_throughput2      alias=${aliasL2RT}     file_name=${LogL2RT.path}

    ${cur_time}    Get Current Date
    # log to console    Current time:${cur_time}, grep = ${output}
    log to console    Current time : ${cur_time}, UL actual throughput(Mbps): ${ul_tp_l2lo}
    # Append to list    ${ul_throughput_list}    ${ul_tp_l2lo}
    # should be true    ${ul_tp_l2lo} > ${ul_expect}
    [Teardown]    run keyword and ignore error  csn.disconnect    connection=${aliasL2RT}

Calculate DL throughput on gnb L2Lo case
    [Documentation]
    ...             This keyword check the DL throughput in gnb l2lo and compare with expect value.
    [Arguments]     ${ul_expect}    ${ul_throughput_list}
    ${LogL2RT}                      Container.Get Log                                 name=L2RT
    Dated log     SSH on ${GNB_DU.bb[0].S.sshId}
    ${aliasL2RT}         SSH Wait For Connect                    ${GNB_DU.bb[0].S}
    # Dated Log       LogL2RT = ${LogL2RT}
    # Dated Log       LIST_LOG = @{LIST_LOG}

    ${ZipLog}                       Set variable                            ${LogL2RT.path.replace('.log','.zip')}
    Dated log                       Check ASP:ZIPLOG=${ZipLog}
    ${output}                       SSH Cmd
    ...                             ls -lrt ${ZipLog}                       alias=${aliasL2RT}
    ${len}                          Get Length                              ${output}
    Dated log                       Presence ${ZipLog} = ${len} output=${output.strip()}
    ${nodeL2RT}                     Get Node         L2RT
    Dated log                       LogL2RT.prefix = /tmp/node_${nodeL2RT.id}/${LogL2RT.prefix}
    Run Keyword If                  ${len} != 0
    ...                             SSH Cmd
    ...                             unzip -o -d /tmp/node_${nodeL2RT.id}/${LogL2RT.prefix} ${ZipLog}              alias=${aliasL2RT}
    Dated log                       Grep into ${LogL2RT.path}
    # ${output}                       SSH Cmd
    # ...                             grep --line-buffered "SentDataMeasurementCounting" ${LogL2RT.path}
    # ...                             alias=${aliasL2RT}

    Dated log     Calculate_DL_throughput with ${LogL2RT.path}
    ${dl_tp_l2lo}=        nps_2535_tools.Calculate_DL_throughput2      alias=${aliasL2RT}     file_name=${LogL2RT.path}

    ${cur_time}    Get Current Date
    # log to console    Current time:${cur_time}, grep = ${output}
    log to console    Current time : ${cur_time}, DL actual throughput(Mbps): ${dl_tp_l2lo}
    # Append to list    ${dl_throughput_list}    ${dl_tp_l2lo}
    # should be true    ${dl_tp_l2lo} > ${dl_expect}
    [Teardown]    run keyword and ignore error  csn.disconnect    connection=${aliasL2RT}

