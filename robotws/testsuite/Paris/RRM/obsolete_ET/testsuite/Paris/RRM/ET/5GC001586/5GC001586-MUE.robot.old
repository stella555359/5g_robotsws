dss_call_2Ue_w_cqi_diff
    [Arguments]                    ${testParam}     ${w_stopTraffic}=true    ${w_Trace}=true     ${alias}=default
    Init Sequence                  ${testParam}
    5GC001586_Keywords.Restart    OwnTLReset=${False}    GNBCallback=5GC001586_Keywords.Set Reset Loop Counter
    run Keyword if    '${w_Trace}' == 'true'      run Keywords      Dated Log         Start Bip and Xp capture for 1586...   AND
    ...                                                             Start capture Bip and Xp for 1586
    Dated Log         Dss Cellsetup with DL pattern ${testParam.seq.dl_allocated_normal_subframes}...
    TC 1586-J CellSetup             ${testParam}   alias=${alias}
    Dated log         dss 5gCall and UL Traffic with 2Ues
    UE Attach Enb                   ueSetting=${UE_PROFILE1}
    Add Scell Range To NSA        alias=${alias}
    Critical Step     UE Attach Gnb        ueSetting=${UE_PROFILE1}
    # ${output}=           common_Dss_SA_NSA.Read WTS Output For Pattern And Print matching Lines    ${UE_attach_pattern}    ${Timeout_NSA}
    # Critical Step        common_Dss_SA_NSA.5G Ue Attach Check      ${output}
    # For CSI Override Testmode, a new command is intrduced i.e. csi_override_testmode_nr
    # This command is profile Id based like any other testMode command.
    # The old cqi command i.e. ue_cqi_param is no more supported from 4.0.17638 AP build.
    # Below is the link:
    # https://confluence.ext.net.nokia.com/pages/viewpage.action?pageId=1049396918 => old command
    # new command => https://confluence.ext.net.nokia.com/display/AirPhoneWTS/CB007492%3A+Migration+of+Test+Modes+
    #    from+OAM+Webtool+to+eGate+-+User+Manual#CB007492:MigrationofTestModesfromOAMWebtooltoeGateUserManual-RLFTestMode
    # NSA UE Testmode Cqi param   UeId=${UE_PROFILE1.ue}   nr_cqi=8    nr_cqi_mode=fixed    nr_cqi_period=10     alias=${alias}
    Override and Activate UE CSI profile  profile_id=1   UeId=${UE_PROFILE1.ue}   nr_cqi=8    nr_cqi_mode=fixed       alias=${alias}
    Traffic UE UL  ueSetting=${UE_PROFILE1}  throughput=${param.seq.ul_throughput}
    ...             duration=1  shouldBeStop=False  shouldBeCheck=False  deviation=15
    UE Attach Enb                   ueSetting=${UE_PROFILE2}
    Critical Step    UE Attach Gnb        ueSetting=${UE_PROFILE2}
    # ${output}=           common_Dss_SA_NSA.Read WTS Output For Pattern And Print matching Lines    ${UE_attach_pattern}    ${Timeout_NSA}
    # Critical Step        common_Dss_SA_NSA.5G Ue Attach Check      ${output}
    Override and Activate UE CSI profile  profile_id=2   UeId=${UE_PROFILE2.ue}   nr_cqi=15    nr_cqi_mode=fixed     alias=${alias}
    run Keyword if    '${w_Trace}' == 'true'      run Keywords       Dated Log         Start TTI Traces in Streaming Mode     AND
    ...                                                              ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traffic UE UL  ueSetting=${UE_PROFILE2}  throughput=${param.seq.ul_throughput}
    ...             duration=10  shouldBeStop=False  shouldBeCheck=False  deviation=15
    [Teardown]    Stop and collect all needed traces     ${testParam}
    ...                                                  w_snapshot=false
    ...                                                  w_pcap=${w_Trace}
    ...                                                  w_Trace=${w_Trace}
    ...                                                  w_stopTraffic=${w_stopTraffic}

Stop and collect all needed traces
   [Arguments]       ${testParam}       ${w_snapshot}=true      ${w_pcap}=true    ${w_Trace}=true    ${w_stopTraffic}=true
    run Keyword if    '${w_stopTraffic}' == 'true'      run Keywords      Dated Log     Stop UL Traffic on 3 Ues...      AND
    ...                                                                   TC 1586-j Stop Ul Traffic on 3 Ues     ${testParam}
    run Keyword if    '${w_Trace}' == 'true'      run Keywords       Dated log         Stop TTI Traces in Streaming Mode...   AND
    ...                                                              ttitrace.Stop TTI Traces in Streaming Mode     tti_trace_path=${testCaseDir}
    run Keyword if    '${w_pcap}' == 'true'    run Keywords       Dated Log         Stop capture for 1586...     AND
    ...                                                           Stop capture Bip and Xp for 1586
    # ...             Capture Stop     ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH}      AND
    # ...             Run Keyword And Ignore Error     OperatingSystem.File Should Exist   ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.path}     AND
    # ...             Run Keyword And Ignore Error     OperatingSystem.Move File   ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.path}  ${testCaseDir}
    ${msg}=   run Keyword if    '${w_pcap}' == 'true'
    ...                   Catenate      dss pcap file ${CAPTURE_L1L2_GNB_FS_ASIK_DSS_ATTACH.path} generated and copied into ${testCaseDir}
    ...                   ELSE     set Variable    None
    run Keyword if    '${w_pcap}' == 'true'         Dated Log     ${msg}
    run Keyword if    '${w_Trace}' == 'true'      run Keywords      Dated log         Decode TTI Traces...      AND
    ...         nps_ttitraces_tools.decode_tti_traces_using_TtitraceReaderEvtDec       desired_storage_directory=${testCaseDir}
    # ...                                                                     num_of_events=None
    run Keyword if    '${w_snapshot}' == 'true'    Dated Log New Line         Get gNB snapshot...
    ${status}  ${snapshot_path}=  run Keyword if   '${w_snapshot}' == 'true'  Run Keyword And Ignore Error  5GC001586_Keywords.Get GNB Logs from Coam
    run Keyword if    '${w_snapshot}' == 'true'    run Keywords
    ...                                       Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${snapshot_path}   AND
    ...                                       Run Keyword And Ignore Error    OperatingSystem.Move File    ${snapshot_path}    ${testCaseDir}   AND
    ...                                       Dated Log     gNB snapshot ${snapshot_path} generated and copied into ${testCaseDir}
    Save swconfig file used       ${testParam}

Wait for counters
    [Arguments]         ${sleep_timer}=5 min
    Dated log           Wait ${sleep_timer} for counters.
    Traced Sleep   ${sleep_timer}     msg=counters GP overlap

Get pm counters 1586J2
    5GC001586_Keywords.Collect PM Counters File
    # M55308C19001 (AL1) (no variation)
    # M55308C19002(PM for AL2)
    # M55308C19003 (PM for AL4)
    # M55308C19004 (AL8)(no variation)
    @{counters}  Create list  M55308C19001  M55308C19002  M55308C19003  M55308C19004
    FOR  ${counter}   IN   @{counters}
        ${samples_value}     Retrieve Latest Single Counter Value From Pm File
        ...                   pm_path=${LATEST_FILE}
        ...                   counter_name=${counter}
        Set test variable  ${${counter}}  ${samples_value}
    END

Check M55308C19002
    ${bool} =   Set variable if    0 < ${M55308C19002}    ${TRUE}    ${FALSE}
    Run keyword if      ${bool}
    ...                 Log to console  *** M55308C19002 is not equal to 0
    ...                 ELSE  Fail  msg=*** M55308C19002 is equal to 0

Check M55308C19003
    ${bool} =   Set variable if    0 < ${M55308C19003}    ${TRUE}    ${FALSE}
    Run keyword if      ${bool}
    ...                 Log to console  *** M55308C19003 is not equal to 0
    ...                 ELSE  Fail  msg=*** M55308C19003 is equal to 0

Check if M55308C19001 is 0
    ${bool} =   Set variable if    '0' == '${M55308C19001}'    ${TRUE}    ${FALSE}
    Run keyword if      ${bool}
    ...                 Log to console  *** M55308C19001 is equal to 0
    ...                 ELSE  Fail  msg=*** M55308C19001 is not equal to 0

Check if M55308C19004 is 0
    ${bool} =   Set variable if    '0' == '${M55308C19004}'    ${TRUE}    ${FALSE}
    Run keyword if      ${bool}
    ...                 Log to console  *** M55308C19004 is equal to 0
    ...                 ELSE  Fail  msg=*** M55308C19004 is not equal to 0

# 95635+95635 = 2 Ue PDCCH with 70% DL Ratio pattern
# Check 95635+95635=M55308C19002+M55308C19003
# 2022/01/12 : Updated with 100915+109227 = 2 Ue PDCCH with 70% DL Ratio pattern
# Check 100915+109227=M55308C19002+M55308C19003
Check M55308C19002+M55308C19003
    ${sum}=    Evaluate   ${M55308C19002}+${M55308C19003}
    ${min}=   Evaluate    (100915+109227) * (100 - 15) / 100
    ${max}=   Evaluate    (100915+109227) * (100 + 15) / 100
    ${status}=      Evaluate       ${min} <= ${sum} <= ${max}
    BuiltIn.Log          *** M55308C19002: ${M55308C19002}           console=yes
    BuiltIn.Log          *** M55308C19003: ${M55308C19003}           console=yes
    Dated log    sum M55308C19002+M55308C19003 = ${sum} min=${min} max=${max} status is ${status}
    Run keyword if      ${status}
    ...                 Log to console  *** Counter M55308C19002 and M55308C19003 value are acceptable
    ...                 ELSE  Fail  msg=*** Counter M55308C19002 and M55308C19003 values are not acceptable

Get pm counter M55308C18002
    5GC001586_Keywords.Collect PM Counters File
    # M55308C18002 : Maximum number of Scheduled (FDM and MU-MIMO) UEs on PUSCH per slot
    @{counters}  Create list  M55308C18002   M55319C06009   M55319C06009   M55319C00001
    FOR  ${counter}   IN   @{counters}
        ${samples_value}     Retrieve Latest Single Counter Value From Pm File
        ...                   pm_path=${LATEST_FILE}
        ...                   counter_name=${counter}
        Set test variable  ${${counter}}  ${samples_value}
    END

Check if M55308C18002 is "${nbrUe_per_UlSlot}"
    ${bool} =   Set variable if    '${nbrUe_per_UlSlot}' == '${M55308C18002}'    ${TRUE}    ${FALSE}
    Run keyword if      ${bool}
    ...                 Log to console  *** M55308C18002 is equal to ${nbrUe_per_UlSlot}
    ...                 ELSE  Fail  msg=*** M55308C18002 is not equal to ${nbrUe_per_UlSlot}

Check Tput over GP period to remove
    [Documentation]    Computes and checks the Tput UL and DL between start_per_time and end_per_time
    ...                Tputs should be equal to maximum Tputs all along the test, with 5% margin
    [Arguments]    ${nb_cell}=1    ${dl_expected_tput}=550    ${ul_expected_tput}=100

    #M55319C00001: MEAS_PERIOD_NR_PDCP_REPORT1
    #M55319C0200x : DL_VOL_TX_NSA_QOS_GRP_0x: DL PDCP SDU volume transmitted for NSA Bearer - QoS Group 0x: nbre de bytes
    #M55319C02009 : Tput PDCP DL en bytes sur QoS 9
    #M55319C0600x: UL PDCP SDU volume received for NSA Bearer - QoS Group 0x: nbre de bytes
    #M55319C06009: Tput PDCP UL en bytes sur QoS 9

    #M55304C00001: Duration of the measurement period for the NR MAC PDU throughput
    # les compteurs suivants sont en bytes
    #M55304C01001 a 28: Initial transmission volume on PDSCH with 64QAM MCS table using MCS x, i.e Cell PDSCH without retrans Tput
    #M55304C02001 a 28: Initial and retransmission volume on PDSCH with 64QAM MCS table using MCS x, i.e Cell PDSCH with retrans Tput
    #M55304C03001 a 28: Initial transmissions volume on PUSCH with CP-OFDM and 64QAM MCS table using MCS x, i.e Cell PUSCH without retrans Tput
    #M55304C04001 a 28: Initial and retransmission volume on PUSCH with CP-OFDM and 64QAM MCS table using MCS x, i.e Cell PUSCH with retrans Tput
    #M55304C05001 a 28: Initial transmission volume on PDSCH with 256QAM MCS table using MCS x, i.e Cell PDSCH without retrans Tput
    #M55304C06001 a 28: Initial and retransmission volume on PDSCH with 256QAM MCS table using MCS x, i.e Cell PDSCH with retrans Tput

    ${NRCELL_ID}                       set variable       1
    # ${counter_values_M55319C02009}  Retrieve Latest Single Counter Value From Pm File with CellID    ${LATEST_FILE}    M55319C02009   ${NRCELL_ID}
    # ${counter_values_M55319C00001}  Retrieve Latest Single Counter Value From Pm File with CellID    ${LATEST_FILE}    M55319C00001   ${NRCELL_ID}
    ${counter_values_M55319C02009}     Retrieve Latest Single Counter Value From Pm File    ${LATEST_FILE}    M55319C02009
    ${counter_values_M55319C00001}     Retrieve Latest Single Counter Value From Pm File    ${LATEST_FILE}    M55319C00001
    BuiltIn.Log   ***DL PDCP SDU volume transmitted for NSA Bearer - QoS Group 09 (M55319C02009) = ${counter_values_M55319C02009}   console=yes
    BuiltIn.Log   ***Duration of the measurement period for the PDCP Report 1 (M55319C00001) = ${counter_values_M55319C00001}       console=yes

    ${Tput_PDCP_DL}                    set variable        ${counter_values_M55319C02009}
    ${MEAS_PERIOD_NR_PDCP_REPORT1}     set variable        ${counter_values_M55319C00001}

    ${tputDL}=              evaluate        8 * ${Tput_PDCP_DL} / (1000 * ${MEAS_PERIOD_NR_PDCP_REPORT1})
    Dated log          TPUT PDCP DL = ${tputDL} Mbps

    ${counter_values_M55319C06009}     Retrieve Latest Single Counter Value From Pm File     ${LATEST_FILE}   M55319C06009
    BuiltIn.Log   ***UL PDCP SDU volume received for NSA Bearer - QoS Group 09 (M55319C02009) = ${counter_values_M55319C06009}   console=yes
    ${Tput_PDCP_UL}                    set variable        ${counter_values_M55319C06009}

    ${tputUL}=              evaluate        8 * ${Tput_PDCP_UL} / (1000 * ${MEAS_PERIOD_NR_PDCP_REPORT1})
    Dated log          TPUT PDCP uL = ${tputUL} Mbps

    ${dl_min_tput}           evaluate    round(${dl_expected_tput}) * 0.9
    ${ul_min_tput}           evaluate    round(${ul_expected_tput}) * 0.9

    Should be true    ${tputDL} >= ${dl_min_tput}
    Should be true    ${tputUL} >= ${ul_min_tput}

# WA for cqi TM
# enb_endc_param id=1 serving_cell_index_range_scg=5:31
Add Scell Range To NSA
    [Arguments]                    ${alias}=default
    Log To Console    add scell range to NSA...
    wts.Execute Egate Command
    ...    cmd=enb_endc_param id=1 serving_cell_index_range_scg=5:31     alias=${alias}

# ex
# Override CSI profile
# csi_override_testmode_nr profile_id=1 cqi=15 cqi_mode=fixed ri=1 ri_mode=fixed
# csi_override_testmode_nr profile_id=1' | pass_regexp='csi_override_testmode_nr Parameters
# and activate CSI profile  ( id = UeId)
# ue_testmode_set_nr id=11 scell=5 testmode=csi_override profile_id=1 action=activate

Associate UEs to testmode
    [Documentation]    :
    ...
    ...    :param id:          specified UE ID
    ...    :param scell:       carrier Aggregation serving cell (carrier component, CC). Primary is for scell index 0.
    ...                        Secondary is for scell indexes 1-7.
    ...    :param testmode:    testmode to be used
    ...    :param profile_id:  test profile id
    ...    :param action:      triggers the activation or the deactivation of the test mode (activate or deactivate)
    ...
    [Arguments]    ${id}    ${testmode}    ${profile_id}    ${action}    ${scell}=0       ${alias}=default
    ${command}=    Set variable    ue_testmode_set_nr id=${id} scell=${scell} testmode=${testmode} profile_id=${profile_id} action=${action}
    wts.Execute Egate Command      cmd=${command}      alias=${alias}
    Sleep    1s    reason=wait command to be executed
    BuiltIn.Log    ${action} testmode ${testmode} for UE=${id} scell=${scell} and profile_id ${profile_id}    console=True

Override and Activate UE CSI profile
    [Arguments]        ${profile_id}= 1   ${UeId}=1   ${nr_cqi}=15    ${nr_cqi_mode}=fixed  ${cqi_min}=1     ${cqi_max}=15
    ...                      ${nr_ri}=1    ${nr_ri_mode}=fixed    ${alias}=default
    Log To Console    Override and Activate UE CSI profile...
    ${cmd_egate}=    Catenate    csi_override_testmode_nr profile_id=${profile_id} cqi=${nr_cqi} cqi_mode=${nr_cqi_mode} cqi_min=${cqi_min}
    ...                                                                            cqi_max=${cqi_max} ri=${nr_ri} ri_mode=${nr_ri_mode}
    wts.Execute Egate Command    cmd=${cmd_egate}       alias=${alias}
    ${cmd}=   Catenate   csi_override_testmode_nr profile_id=${profile_id}
    ${pattern}     Set Variable        csi_override_testmode_nr Parameters
    ${output}    wts.Execute Egate Command And Wait For Data    cmd=${cmd}
    ...    pass_regexp=${pattern}    timeout=5     alias=${alias}
    ${output}    String.Get Lines Matching Regexp    ${output}    ${pattern}    partial_match=True
    Dated log        ${cmd}
    Log To Console    \n${output}
    BuiltIn.Log     Channel State Information for UE${UeId} is updated with cqi=${nr_cqi} cqi_mode=${nr_cqi_mode} ri=${nr_ri} ri_mode=${nr_ri_mode}
    Log To Console   Channel State Information for UE${UeId} is updated with cqi=${nr_cqi} cqi_mode=${nr_cqi_mode} ri=${nr_ri} ri_mode=${nr_ri_mode}
    Log To Console   Associate UE to testmode...
    Associate UEs to testmode    id=${ue_id}    testmode=csi_override    profile_id=${profile_id}    action=activate    scell=5      alias=${alias}
    Log To Console    set_UE_CQI_Testmode_is_ok

# ue_cqi_param id=1 on=nr nr_cqi=8 nr_cqi_mode=fixed nr_cqi_min=1 nr_cqi_max=15 nr_cqi_step=1 nr_cqi_period=10 scell=5
NSA UE Testmode Cqi param
    [Arguments]    ${UeId}    ${nr_cqi}    ${nr_cqi_mode}    ${nr_cqi_period}       ${alias}=default
    [Documentation]    This keyword is used to set UE CQI Testmode after NSA L3 Call on eGate.
    ...    | Input Parameters | Man. | Description |
    ...    | nr_cqi | Yes | cqi |
    ...    | nr_cqi_mode | Yes | cqi mode |
    ...    | nr_cqi_period | Yes | cqi period |
    ...    Example:
    ...    | NSA UE Testmode CQI param | 8 | fixed | 10
    Log To Console    add UE testmode Cqi param...
    ${cmd}    Catenate    ue_cqi_param id=${UeId} on=nr nr_cqi=${nr_cqi} nr_cqi_mode=${nr_cqi_mode} nr_cqi_min=1 nr_cqi_max=15
    ...                        nr_cqi_step=1 nr_cqi_period=${nr_cqi_period} scell=5
    ${output}    wts.Execute Egate Command    cmd=${cmd}       alias=${alias}
    Should Not Contain    ${output}    UE may be OFF or killed
    Dated log        ${cmd}
    Log To Console    set_UE_CQI_Testmode_is_ok

NSA UE Testmode NR Profile
    [Arguments]    ${ul_sinr_profile_index}    ${sinr_target_srs}    ${sinr_target_pusch}    ${sinr_target_pucch}    ${sinr_target_preamble}
    [Documentation]    This keyword is used to set UE Testmode after NSA L3 Call on eGate.
    ...    | Input Parameters | Man. | Description |
    ...    | ul_sinr_profile_index | Yes | ulsinr profile index |
    ...    | sinr_target_srs | Yes | sinr_target_srs |
    ...    | sinr_target_pusch | Yes | sinr_target_pusch |
    ...    | sinr_target_pucch | Yes | sinr_target_pucch |
    ...    | sinr_target_preamble | Yes | sinr_target_preamble |
    ...    Example:
    ...    | NSA UE Testmode NR Profile | 1 | 100 | 100 | 100 | 100 |
    Log To Console    add UE testmode NR profile...
    ${cmd}    Catenate    ul_sinr_testmode_nr profile_id=${ul_sinr_profile_index} sinr_target_srs=${sinr_target_srs}
    ...    sinr_target_pusch=${sinr_target_pusch} sinr_target_pucch=${sinr_target_pucch} sinr_target_preamble=${sinr_target_preamble}
    ${output}    wts.Execute Egate Command    cmd=${cmd}
    Should Not Contain    ${output}    UE may be OFF or killed
    Log To Console    set_UE_Testmode_is_ok

Test case setup
    [Arguments]         ${testParam}

    # SCF.xml is used by procedure verifyFeatureActivation
    ${test_scf_file}             OAM Get SCF File            dir=${testCaseDir}      file=SCF.xml
    Set Suite Variable              ${test_scf_file}
    Dated Log                  Current 1586 SCF file stored to ${test_scf_file}
    Run Keyword And Ignore Error    OperatingSystem.Copy File    ${test_scf_file}     ${LOG_PATH}

Test specific setup 1586 J1
    [Arguments]         ${testParam}
    Log to Console like Next Step     0     Test Specific Setup 1586 J ${testParam.seq.bandwidth}

    # iPHY gscn update depending of chBwDl
    Dated Log      iPHY gscn update with ${testParam.scfFile.nrcell.gscn} : chBwDl=${testParam.scfFile.nrcellfdd.chBwDl}
    common_Dss_Keywords.Set Context_AP IPHY    ${testParam}

    # default configuration is 10MHz case , nothing to do in this case
    Run Keyword If   '${testParam.seq.bandwidth}'!='10MHz'   common_Dss_Keywords.Modify Bandwidth Parameters for WTS   ${testParam}


Test Setup 1586 J
    [Arguments]         ${testParam}

    Log to Console like Next Step     0     Test Setup 1586 J ${testParam.seq.bandwidth}

    run keyword       5GC001586_Kw_TestSetup.Upload 1586-J Configuration

    run keyword and ignore error      common_Dss_Keywords.Remove RAD param for Link Adaptation on swconfig if present

    # intialize  cellDepType with scf value
    ${testParam.Context.cellDepType}=   5GC001586_Kw_TestSetup.get cellDepType from SCF
    # eNBid = 2 and gNBId = 1 if SANSA
    run Keyword if     '${testParam.Context.cellDepType}' == 'SA+NSA'    update eNbId and gNBId In Context   ${testParam}   2   1
    ${testParam.scfFile.nrdsslte.eNodeBId}     set variable      ${testParam.Context.eNBId}

    # need to adapt minNrDssRatio for SA !!!!
    # computed sfn = 21% in case of SA and = 11% in case of NSA
    # ${testParam.scfFile.lteNrDssDlRatio.minNrDssRatio}   Run Keyword If   '${testParam.Context.cellDepType}' == 'SA+NSA'   set variable   25

    Run Keyword If                 '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'      5GC001586_Kw_TestSetup.Set SCF 1586 M1  ${testParam}
    Run Keyword If                 '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'      Modify 1586 searchSpaceDedicated related Parameters    ${testParam}
    # 04/07/2022 : WA for PR638673
    # Need to desactivate the dynamic UL Overload Control functionality introduced by feature CB006784-5G-A
    # => WA for PR638673 : the gain of 1586-J1 can be seen with 3 UEs only if dynamic UL Overload Control functionality is desactivated
    # Beware that SHOULD_UPDATE_RAD=0 by default (CRT test)
    ${1586_swconfig_gnb}=      Run Keyword If        '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'      Set 1586 J Specific RAD     ${testParam}
    Run Keyword If                 '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'      5GC001586_Kw_TestSetup.Set Specific RAD & scf parameters  ${testParam}
    ...                                                                                                                      ${1586_swconfig_gnb}

    # iPHY gscn update depending of chBwDl
    Dated Log      iPHY gscn update with ${testParam.scfFile.nrcell.gscn} : chBwDl=${testParam.scfFile.nrcellfdd.chBwDl}
    common_Dss_Keywords.Set Context_AP IPHY    ${testParam}

    # default configuration is 10MHz case , nothing to do in this case
    Run Keyword If   '${testParam.seq.bandwidth}'!='10MHz'   common_Dss_Keywords.Modify Bandwidth Parameters for WTS   ${testParam}

    ${isOAMRebooted}    Run Keyword If       '${SHOULD_UPDATE_SCF_AND_RAD}' == '1'       SSH Was OAM Rebooted       ${GNB_DU}     timeout=60

    # Save current SCF file used during test cases
    ${current_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF_used_for_1586_J_${testParam.seq.bandwidth}_Tests.xml
    Set Suite Variable              ${current_scf_file}
    Dated Log New Line         Current 1586-J SCF file stored to ${current_scf_file}

    # Get swconfig file that will be used during 1586-M tests
    # 21092023 => Bypassed for the moment !!!
    # ${alias_gnb}                    SSH Wait For Connect                ${GNB_DU.sys[0].M}
    ${alias_gnb}=  Wait until keyword succeeds     10 min     10 sec
    ...     common_Dss_Keywords.Connect to gNB Common Unit  gnb_id=0  du_id=0    comu_id=0
    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${LOG_PATH}/swconfig_used_for_1586_J_${testParam.seq.bandwidth}_Tests.txt
    ...                             connection=${alias_gnb}
    Dated Log                  Current 1586-J swconfig file stored to ${LOG_PATH}/swconfig_used_for_1586_J_${testParam.seq.bandwidth}_Tests.txt

    # Get EPC file configuration that will be used during 1586-M tests
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.download_file               remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${LOG_PATH}/basic_wts_used_for_1586_J_${testParam.seq.bandwidth}_Tests.cfg
    ...                             connection=${alias_epc}

    # Get AP configuration file that will be used during 1586-M tests
    ${ap_configfile}                Get XML AirPhoneConfig Path
    run Keyword if      '${ap_configfile}' != '${empty}'     csn.download_file       remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${LOG_PATH}/ApOamConfig_used_for_1586_J_${testParam.seq.bandwidth}_Tests.xml
    ...                             connection=${alias_epc}

    Dated Log  Current 1586-J basic file ${tl.core.cfg_filename} stored to ${LOG_PATH}/basic_wts_used_for_1586_J_${testParam.seq.bandwidth}_Test.cfg
    Dated Log  Current 1586-J ApOamConfig file stored to ${LOG_PATH}/ApOamConfig_used_for_1586_J_${testParam.seq.bandwidth}_Tests.xml

Teardown 1586-J
    [Arguments]            ${testParam}      ${alias}=${HOST_EPCSIM.alias}

    BuiltIn.Log      \nTest ${TEST_NAME} 1586 ending   console=yes

    # get Alarm at the end of the test and store it into a file
    Dated log New Line  OAM Get Active Alarms to Save into file
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}

    ${active_alarms}     OAM Get Active Alarms                   oam=${GNB_DU.oam}    textFormat=${False}

    ${len}    Get Length    ${active_alarms}
    ${alarm_id_list}    Create List
    ${alarm_name_list}    Create List
    ${faultId}=     set variable if    ${isAiC}        fault_id
    ...                                                faultId
    ${faultName}=     set variable if    ${isAiC}      fault_name
    ...                                                faultName
    FOR    ${i}    IN RANGE    ${len}
          ${tmp_id}    Get From Dictionary    ${active_alarms[${i}]}    ${faultId}
          ${tmp_name_id}    Get From Dictionary    ${active_alarms[${i}]}    ${faultName}
          Append To List    ${alarm_id_list}    ${tmp_id}
          Append To List    ${alarm_name_list}    ${tmp_name_id}
    # Dated log     Active alarms: alarm_id_list=${alarm_id_list}
    # Dated log     Active alarms: alarm_name_list=${alarm_name_list}
    END
    Append To File    ${testCaseDir}/OAM_Alarms_After_${TEST_NAME}.txt     Active Alarms Id List:\n${alarm_id_list}\n\n
    Append To File    ${testCaseDir}/OAM_Alarms_After_${TEST_NAME}.txt     Active Alarms Name List:\n${alarm_name_list}\n\n

    OAM Disconnect                          ${GNB_DU.oam}

    Run Keyword And Ignore Error     Collect EGATE console Logs

    # Save current SCF file used during test cases
    ${current_scf_file}             OAM Get SCF File            dir=${testCaseDir}      file=SCF_used_for_1586_${testParam.seq.bandwidth}_Tests.xml
    Set Suite Variable              ${current_scf_file}
    Dated Log New Line         Current 1586 SCF file stored to ${current_scf_file}

    # Get swconfig file used during 1586-M tests
    ${alias_gnb}                    SSH Wait For Connect                ${GNB_DU.sys[0].M}
    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${testCaseDir}/swconfig_used_for_1586_${testParam.seq.bandwidth}_Tests.txt
    ...                             connection=${alias_gnb}
    Dated Log                  Current 1586 swconfig file stored to ${testCaseDir}/swconfig_used_for_1586_${testParam.seq.bandwidth}_Tests.txt

    # Get EPC file configuration used during 1586-M tests
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.download_file               remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${testCaseDir}/basic_wts_used_for_1586_${testParam.seq.bandwidth}_Tests.cfg
    ...                             connection=${alias_epc}

    # Get AP configuration file used during 1586-M tests
    ${ap_configfile}                Get XML AirPhoneConfig Path
    run Keyword if      '${ap_configfile}' != '${empty}'     csn.download_file         remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${testCaseDir}/ApOamConfig_used_for_1586_${testParam.seq.bandwidth}_Tests.xml
    ...                             connection=${alias_epc}

    ${msg}=   Catenate    Current 1586-J basic file ${tl.core.cfg_filename} stored
    ...                      to ${testCaseDir}/basic_wts_used_for_1586_${testParam.seq.bandwidth}_Tests.cfg
    Dated Log    ${msg}
    Dated Log  Current 1586-J ApOamConfig file stored to ${testCaseDir}/ApOamConfig_used_for_1586_${testParam.seq.bandwidth}_Tests.xml
    # Restore WTS cfg file name
    Run Keyword If   '${Param.seq.bandwidth}'!='10MHz'    restoreFilename
    ${subdirectory}=    common_Dss_Keywords.Prepare Logs Directory Path    subdir=WTS
    run Keyword and ignore error     wts.collect_egate_log_files    unzip=${False}    subdirectory=${subdirectory}    alias=${alias}
    wts.teardown_all_aliases_for_egate
    wts.teardown_all_aliases_for_edaemon
    # check here that there is no DSS alarm at the end of the test
    Check Dss active Alarm Should not be present
    Collect Logs if needed   ${alias}
    set Suite Variable    ${testCaseDir}    None

Check BTS status in WEM for cOAM
    [Documentation]   This keyword is used to Check BTS status in WEM for cOAM.
    ...    author: Ch SAMSON
    [Arguments]     ${cell_id}=0
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=    coam.get_bts_statuses    timeout=30    connection=${GNB_DU.oam.httpAlias}
    Dated log      =======> Current bts status is ${bts_status}
    should be equal    ${bts_status['operationalState']}     Enabled         ignore_case=true
    Should Contain Any      ${bts_status['proceduralState']}    configured   OnAir     msg=ENB is not on air, Current status is ${bts_status}
    ...                                                                                ignore_case=true
    should be equal    ${bts_status['blockingState']}       Unblocked            ignore_case=true

    ${cell_info}=    coam.get_cells_info    cell_type=nr    timeout=30    connection=${GNB_DU.oam.httpAlias}
    Dated log      =======> Current cell(s) info is ${cell_info}
    FOR    ${elem}    IN    @{cell_info}
#    ${cell_info}=    set variable   ${cell_info[${cell_id}]['status']}
        Should be equal    ${elem['status']['operationalState']}    Enabled    ignore_case=true
        Should be equal    ${elem['status']['proceduralStatus']}    configured    ignore_case=true
        Should be equal    ${elem['status']['administrativeState']}    Unlocked    ignore_case=true
    END

    OAM Disconnect                  ${GNB_DU.oam}

Restart TL wo WTS clear
    [Documentation]                 Entry point for the restart of a TL, Classical only , without WTS clear
    [Arguments]                     ${GNBCallback}=None                     ${APCallback}=None
    ...                             ${isOAMRebooted}=False
    Private Restart Gnb Classical           GNBCallback=${GNBCallback}          APCallback=${APCallback}
    ...                             isOAMRebooted=${isOAMRebooted}


reset TL if BTS not OnAir
    [Arguments]  ${connection}=${GNB_DU.oam}
    ${aliasGNB}                     OAM Connect                             ${connection}
    ${bts_status}=  coam.get_bts_statuses   connection=${connection.httpAlias}
    OAM Disconnect                  ${GNB_DU.oam}
    Dated log     BTS procedural state is now: ${bts_status["proceduralState"]}
    ${gnb_status}=     evaluate    '${bts_status["proceduralState"]}'.lower()
    Run Keyword If  '${gnb_status}'!='OnAir'.lower() and '${gnb_status}'!='Configured'.lower()
    ...          Run Keywords       Log To Console  \n BTS procedural state is now: ${bts_status["proceduralState"]} ==> Reset TL     AND
    ...                             Restart TL wo WTS clear     AND
    ...                             run keyword and ignore error        5GC001586_Kw_TestSetup.Upload 1586 Configuration          AND
    ...                             run keyword and ignore error        common_Dss_Keywords.Start WTS        egate_alias_default   AND
    ...                             run keyword and ignore error        common_Dss_command.X2Ap link Setup     egate_alias_default


Get gNB cell 5g On air
    [Documentation]       get gNB 5g cell On air
    Return From Keyword If    "${WAIT_5G_CELL_ONAIR}" == "0"
    common_Dss_Keywords.Log to Console like Next Step     0     Get gNB 5g cell OnAir
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=  coam.get_bts_statuses   connection=${GNB_DU.oam.httpAlias}
    OAM Disconnect                  ${GNB_DU.oam}
    Log To Console  \n BTS procedural state is now: ${bts_status["proceduralState"]}
    ${gnb_status}=     evaluate    '${bts_status["proceduralState"]}'.lower()
    Return From Keyword If    '${gnb_status}'=='OnAir'.lower() or '${gnb_status}'=='Configured'.lower()
    run keyword and ignore error        5GC001586_Kw_TestSetup.Upload 1586 Configuration
    run keyword and ignore error        common_Dss_Keywords.Start WTS        egate_alias_default
    run keyword and ignore error        common_Dss_command.X2Ap link Setup     egate_alias_default
    run keyword and ignore error        wait until keyword succeeds    2min    30s      Check BTS status in WEM for cOAM
    Dated log new line         =======> Restart TL if needed to get Cell Is OnAir/Configured
    run keyword and ignore error        reset TL if BTS not OnAir
    run keyword and ignore error        wait until keyword succeeds    5min    30s      Check BTS status in WEM for cOAM

Check BTS and Cell status in WEM for cOAM On Air
    [Documentation]   This keyword is used to Check BTS status in WEM for cOAM.
    ...    author: Ch SAMSON
    [Arguments]     ${cell_id}=0
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    ${bts_status}=    coam.get_bts_statuses    timeout=30    connection=${GNB_DU.oam.httpAlias}
    Dated log      =======> Current bts status is ${bts_status}
    should be equal         ${bts_status['operationalState']}     Enabled         ignore_case=true
    Should Contain Any      ${bts_status['proceduralState']}      OnAir     msg=ENB is not on air, Current status is ${bts_status['proceduralState']}
    ...                                                                     ignore_case=true
    should be equal         ${bts_status['blockingState']}        Unblocked       ignore_case=true

    ${cell_full_info}=    coam.get_cells_info    cell_type=nr    timeout=30    connection=${GNB_DU.oam.httpAlias}
    ${cell_info}=    set variable   ${cell_full_info[${cell_id}]['status']}
    Dated log      =======> Current cell(s) info is ${cell_info}
    Should be equal    ${cell_info['operationalState']}     Enabled      ignore_case=true
    Should be equal    ${cell_info['proceduralStatus']}     configured   ignore_case=true
    Should be equal    ${cell_info['administrativeState']}  Unlocked     ignore_case=true

    OAM Disconnect                  ${GNB_DU.oam}
    ${msg}=   Catenate    Cell${cell_id} operationalState=${cell_info['operationalState']}, proceduralStatus=${cell_info['proceduralStatus']}
    ...                   administrativeState=${cell_info['administrativeState']}
    Dated log    ${msg}

Verify cell setup with COAM to remove
    [Documentation]     : [PRIVATE]
    ...     Verify Specific Cell status and BTS Cell setup status
    ...
    ...     cell_id:   Id of cell,
    ...     timeout:   Time to wait for positive procedure result
    ...
    [Arguments]     ${oam_alias}    ${cell_id}=0   ${timeout}=30
    ${cell_status}=    coam.get_cells_info    cell_type=nr     timeout=${timeout}    connection=${oam_alias}
    ${P_internal_cell_dist_id}=  Set Variable   ${cell_status[${cell_id}]['id']['internal']}
    ${cell_status}=    Set variable  ${cell_status[${cell_id}]['status']}
    Should be equal    ${cell_status['operationalState']}         Enabled         ignore_case=true
    Should be equal    ${cell_status['proceduralStatus']}         configured      ignore_case=true
    Should be equal    ${cell_status['blockingState']}            Unblocked       ignore_case=true
    Should Contain Any    ${cell_status['usageState']}            Active          ignore_case=true
    Should be equal    ${cell_status['administrativeState']}      Unlocked        ignore_case=true
    ${bts_status}=     coam.get_bts_statuses    timeout=${timeout}    connection=${oam_alias}
    Should be equal    ${bts_status['operationalState']}          Enabled         ignore_case=true
    Should be equal    ${bts_status['proceduralState']}           OnAir     msg=GNB is not on air, Current status is ${bts_status['proceduralState']}
    ...                                                                     ignore_case=true
    Should be equal    ${bts_status['blockingState']}             Unblocked       ignore_case=true

    ${msg}=   Catenate    Cell ${cell_id} [${P_internal_cell_dist_id}], operationalState=${cell_status['operationalState']},
    ...                   proceduralStatus=${cell_status['proceduralStatus']},
    ...                   administrativeState=${cell_status['administrativeState']},
    ...                   blockingState=${cell_status['blockingState']},
    ...                   usageState=${cell_status['usageState']}
    Dated log    ${msg}
    Dated log    BTS procedural state is now: ${bts_status['proceduralState']}
    [Return]  ${P_internal_cell_dist_id}

Verify that cells are onair with COAM to remove
    [Documentation]     [PRIVATE]
    [Arguments]      ${oam_alias}   ${num_of_cells}=1
    FOR    ${cell_id}    IN RANGE    ${num_of_cells}
        ${_internal_cell_dist_id}=  Verify cell setup with COAM   oam_alias=${oam_alias}   cell_id=${cell_id}
        Append to list  ${P_INTERNAL_CELL_DIST_ID}     ${_internal_cell_dist_id}
    END

Wait gNB cell 5g On air to remove
    [Documentation]       Wait gNB cell 5g On air
    [Arguments]     ${num_of_cells}=1
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    # wait until keyword succeeds    5min    20s      Check BTS and Cell status in WEM for cOAM On Air   cell_id=${cell_id}
    wait until keyword succeeds    5min    20s      Verify that cells are onair with COAM   oam_alias=${GNB_DU.oam.httpAlias}
    ...                                                                                     num_of_cells=${num_of_cells}
    [Teardown]         OAM Disconnect                  ${GNB_DU.oam}

