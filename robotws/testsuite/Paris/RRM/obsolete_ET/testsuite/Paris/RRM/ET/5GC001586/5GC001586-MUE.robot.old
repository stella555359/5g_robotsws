# Patterns  pour DL ratio = 70 %
# Fixed Normal Subframes Pattern	    40000400004000040000
# Fixed Mbsn Subframes Pattern	        20008000080000800008
# Allocated Normal Subframes	        3b9ee3b9ee3b9ee3b9ee

# Patterns pour DL ratio = 30 %
# Fixed Normal Subframes Pattern	40000400004000040000
# Fixed Mbsn Subframes Pattern	    20008000080000800008
# Allocated Normal Subframes	    2888a2088a2088a20888
# 0010100010-0010001010-0010000010-0010001010-0010000010-0010001010-0010000010-0010001000

# Patterns pour DL ratio = 50 %
# Fixed Normal Subframes Pattern	40000400004000040000
# Fixed Mbsn Subframes Pattern	    20008000080000800008
# Allocated Normal Subframes	    2b9aa2a9aa2a9aa2a8aa

# SA case
# Patterns  pour DL ratio = 70 %
# Fixed Normal Subframes Pattern	    fixedMbsfnSubframes (Bytes):  42000430004300043000
# Fixed Mbsn Subframes Pattern	        fixedNormalSubframes (Bytes): 20008000082000800008
# Allocated Normal Subframes	                                      9FFFB4FFBC7FBCF7BCFF

${PATTERN_DL_70_SA_1}       1001101110-1111101010-0100101110-1110101100-0111101110-1111001110-0111101110-0111101110
${PATTERN_DL_70_SA}         0001101110-0111101010-0000101110-0110101100-0011101110-0111001110-0011101110-0111101110
${PATTERN_DL_70_SA_OK}      0011100010-0111101110-0011100010-0111101110-0011100010-0111101110-0011100010-0111101110

# DL Pattern %
${PATTERN_DL_12_PRACH12}    0010000000-0001001000-0000000000-0000001000-0000000000-0000001000-0000000000-0000001000
${PATTERN_DL_12_PRACH13}    0010000010-0000000010-0010000000-0000000010-0010000000-0000000010-0010000000-0000000010
${PATTERN_DL_30}            0010100010-0010001010-0010000010-0010001010-0010000010-0010001010-0010000010-0010001000
${PATTERN_DL_50}            0010101110-0110101010-0010101010-0110101010-0010101010-0110101010-0010101010-0010101010
${PATTERN_DL_70}            0011101110-0111101110-0011101110-0111101110-0011101110-0111101110-0011101110-0111101110

@{P_INTERNAL_CELL_DIST_ID}

