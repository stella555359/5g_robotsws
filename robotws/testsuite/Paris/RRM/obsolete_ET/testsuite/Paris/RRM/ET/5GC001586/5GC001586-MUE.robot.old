# 1586-K BW= 10MHz
# TC1 ; DL RATIO = 70 (Dl pattern) et k2max =0xffff (RAD param)
TC_testsetup_1586-K_10MHZ
    [Tags]    FULL_RUN   FULL_CALL   10MHZ    1586K     1586J2
	...       CRT
    Test Setup 1586 J    ${TestDSS10Mhz_1586_J_DL_RATIO_70}


[1][1.0] 5GC001586_J_TC_11_NSA_PDCCH_UL_dynamic_AL_AL4_To_AL2_10Mhz
    [Tags]    FULL_RUN  1586J2_TC11  FULL_CALL  10MHZ   1586J2
	...       CRT
    [Documentation]      TC11 1586-J2 BW= 10MHz, DL RATIO = 70%, K2max = 0xffff, rdDssUlDciAggregationThreshold = 10,
    ...                   dssMaxNumberOfDlDcis = 1, 2Ues (Ue1 Cqi=8 and Ue2 Cqi=5)
    [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    ...                       common_Dss_Keywords.Get testcase log directory    AND
    ...                       5GC001586_Keywords.Clean Up Env                   AND
    ...                       common_Dss_Keywords.Prepare Test Name             AND
    ...                       common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp     AND
    ...                       depends     TC_testsetup_1586-K_10MHZ
    ${tc_name}    Set variable    TestLine_preparation
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'    Run Keywords
    ...           5GC001586_Kw_TestSetup.Test Line Preparation for NSA Only    ${TestDSS10Mhz_1586_M1}   AND
    ...           5GC001586_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_1586_M1}
    ${tc_name}    Set variable    TC_testsetup_1586-K_10MHZ
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'
    ...           Test Setup 1586 J    ${TestDSS10Mhz_1586_J_DL_RATIO_70}
    ${msg}=    Catenate     "TC11 1586-J2: sw release used [${convert_version}], BW = 10MHz,"
    ...                     " DL RATIO = 70%, K2max = 0xffff, rdDssUlDciAggregationThreshold = 10, dssMaxNumberOfDlDcis = 1"
    ...                     " Ue1 Cqi=8 , Ue2 Cqi=15"
    Log Test description  ${msg}
    Test case setup     ${TestDSS10Mhz_1586_J_DL_RATIO_70}
    Update K2max with     rdExtendK2Max=0xffff
    # Update rdDssUlDciAggregationThreshold with      rdDssUlDciAggregationThreshold=10
    robot_extension.Run Keyword And Warn On Failure     btslog.Start Btslog
    dss_call_2Ue_w_cqi_diff   ${TestDSS10Mhz_1586_J_DL_RATIO_70}   TC1_1586J2_10MHZ
    ${resultDir}=     common_Dss_Keywords.Get Testcase Log Directory
    ${UeList}    nps_1586_tools.get_rntis     ${resultDir}
    # ${UeId1}   Convert To Integer   61
    # ${UeId2}   Convert To Integer   283
    ${UeId1}   set variable     @{UeList}[0]
    ${UeId2}   set variable     @{UeList}[1]
    Dated log     verify_5GC001586_UL_AL_Based_Cqi for ${UeId1} and ${UeId2}
    ${output}=     nps_1586_tools.Verify QC Test Case    verify_5GC001586_UL_AL_Based_Cqi   rnti_ue=${UeId2}
    should contain	                ${output}	                            passed
    ${output}=     nps_1586_tools.Verify QC Test Case    verify_5GC001586_UL_AL_Based_Cqi   rnti_ue=${UeId1}
    should contain	                ${output}	                            passed
    [Teardown]    run keywords      GenericTest.Display diagnosis     AND
    ...                             common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
    ...                             robot_extension.Run Keyword And Warn On Failure    btslog.Stop Btslog    target_dir=${testCaseDir}   AND
    ...                             Teardown 1586-J     ${TestDSS10Mhz_1586_J_DL_RATIO_70}     TC1_1586J2_10MHZ

[1][1.0] 5GC001586_J_TC_13_Verify_PM_Counters_UL_dynamic_AL_AL4_To_AL2_10Mhz
    [Tags]    FULL_RUN  1586J2_TC13  FULL_CALL  10MHZ   1586J2  PMCounters
	...       CRT
    [Documentation]      TC13 1586-J2 BW= 10MHz, DL RATIO = 70%, K2max = 0xffff, rdDssUlDciAggregationThreshold = 10, dssMaxNumberOfDlDcis = 1
    ...                   AL2 used PDCCH (M55308C19002) , AL4 used PDCCH (M55308C19003)
    [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    ...                       common_Dss_Keywords.Get testcase log directory    AND
    ...                       5GC001586_Keywords.Clean Up Env                   AND
    ...                       common_Dss_Keywords.Prepare Test Name             AND
    ...                       common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp     AND
    ...                       depends     TC_testsetup_1586-K_10MHZ
    ${tc_name}    Set variable    TestLine_preparation
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if     '${tc_status}'!='PASS'     Run Keywords
    ...                          5GC001586_Kw_TestSetup.Test Line Preparation for NSA Only    ${TestDSS10Mhz_1586_J_DL_RATIO_70}   AND
    ...                          5GC001586_Kw_TestSetup.Test Line Preparation    ${TestDSS10Mhz_1586_J_DL_RATIO_70}
    ${tc_name}    Set variable    TC_testsetup_1586-K_10MHZ
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'
    ...           Test Setup 1586 J    ${TestDSS10Mhz_1586_J_DL_RATIO_70}
    ${msg}=    Catenate     "TC13 1586-J2: sw release used [${convert_version}], BW = 10MHz,"
    ...                     " DL RATIO = 70%, K2max = 0xffff, rdDssUlDciAggregationThreshold = 10, dssMaxNumberOfDlDcis = 1"
    ...                     " AL2 used PDCCH (M55308C19002) , AL4 used PDCCH (M55308C19003)"
    Log Test description  ${msg}
    Test case setup     ${TestDSS10Mhz_1586_J_DL_RATIO_70}
    Update K2max with     rdExtendK2Max=0xffff
    # Update rdDssUlDciAggregationThreshold with      rdDssUlDciAggregationThreshold=10
    robot_extension.Run Keyword And Warn On Failure     btslog.Start Btslog
    dss_call_2Ue_w_cqi_diff   testParam=${TestDSS10Mhz_1586_J_DL_RATIO_70}   w_stopTraffic=false    w_Trace=false   alias=tc_counters
    Wait for counters    sleep_timer=15min
    # Collect PM
    Get pm counters 1586J2
    # M55308C19001 (AL1) (no variation)
    Check if M55308C19001 is 0
    # M55308C19004 (AL8)(no variation)
    Check if M55308C19004 is 0
    # M55308C19002(PM for AL2) and M55308C19003 (PM for AL4)
    Check M55308C19002+M55308C19003
    Dated Log     Stop UL Traffic on 3 Ues...
    TC 1586-j Stop Ul Traffic on 3 Ues       ${TestDSS10Mhz_1586_J_DL_RATIO_70}
    [Teardown]      run keywords
    ...                common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}     AND
    ...                robot_extension.Run Keyword And Warn On Failure    btslog.Stop Btslog    target_dir=${testCaseDir}   AND
    ...                5GC001586_C_Keywords.Teardown 1586 Get PM Cpt    ${TestDSS10Mhz_1586_J_DL_RATIO_70}    alias=tc_counters

