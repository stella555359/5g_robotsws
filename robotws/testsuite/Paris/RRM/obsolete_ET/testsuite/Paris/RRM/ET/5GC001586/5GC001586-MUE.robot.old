Start capture Backhaul XP for CellSetup DSS
    ${capture_BH_GNB}=             set Backhaul Capture                     prefix=BH.XP.CellSetup
    set test variable              ${capture_BH_GNB}
    ${capture_BH_GNB}=             Initialize Filter XP message Capture     capture=${capture_BH_GNB}
    common_Dss_Keywords.Start capture Backhaul XP for DSS New               capture=${capture_BH_GNB}   suffix=DssCellSetup

Stop capture for Backhaul XP CellSetup DSS
    common_Dss_Keywords.Stop capture for Backhaul XP DSS New     capture=${capture_BH_GNB}   w_pdml=False
    ...                                                          lua_path=/home/ute/tools/luashark/generated_luashark-9.1800.330/luashark.lua
    ...                                                          suffix=DssCellSetup

TC 1586-J CellSetup 2
    [Documentation]                Generic test for 1586-C: test purpose is to setup X2, Xp and DSS
    [Arguments]                    ${param}     ${alias}=default
    Init Sequence                  ${param}
    5GC001586_Ue_command.Setup WTS and wait for S1 link     ssh_alias=WTS_${alias}
    Step                      5GC001586_Ue_command.Start WTS                       argument=${alias}
    Step                      5GC001586_Ue_command.Check wts in active state       argument=${alias}     depends=5GC001586_Ue_command.Start WTS
    Step                      Start capture Backhaul XP for CellSetup DSS
    Step                      5GC001586_Ue_command.Wait Xp link Up                 argument=${alias}     depends=5GC001586_Ue_command.Start WTS
    Step                      5GC001586_Ue_command.X2Ap link Setup                 argument=${alias}     depends=5GC001586_Ue_command.Start WTS
    Step                      common_Dss_command.DSS_CRM_Cell_Setup     argument=${alias}        depends=5GC001586_Ue_command.Wait Xp link Up
    Step                      Stop capture for Backhaul XP CellSetup DSS
    # Wait gNB cell 5g On air with globalCellId=1
    Critical Step             common_Dss_CellSetup.Wait gNB cell 5g On air      globalCellId=1
    Critical Step             5GC001586_Ue_command.Verify AP Classical Cell Setup
    [Teardown]               GenericTest.Display diagnosis

TC 1586-J CellSetup
    [Documentation]                Generic test for 1586-C: test purpose is to setup X2, Xp and DSS
    [Arguments]                    ${param}     ${alias}=default
    Init Sequence                  ${param}
    common_Dss_Keywords.Start WTS         egate_alias=${alias}    shouldUseLua=${False}
    Step                           5GC001586_Keywords.Wait Xp link Up     argument=${alias}        depends=common_Dss_Keywords.Start WTS
    Step                           common_Dss_command.X2Ap link Setup     argument=${alias}        depends=common_Dss_Keywords.Start WTS
    Step                           5GC001586_Keywords.DSS_Cell_Setup      argument=${alias}        depends=5GC001586_Keywords.Wait Xp link Up
    # Wait gNB cell 5g On air with globalCellId=1
    Critical Step                  common_Dss_CellSetup.Wait gNB cell 5g On air     globalCellId=1
    Critical Step                  5GC001586_Ue_command.Verify AP Classical Cell Setup
    [Teardown]               GenericTest.Display diagnosis

TC 1586-j 5gCall and Ul Traffic with 3 Ues
    [Documentation]                Test purpose is to test 5g DSS Call
    [Arguments]                    ${param}
    Init Sequence                  ${param}

    UE Attach Enb                   ueSetting=${UE_PROFILE1}
    Critical Step     UE Attach Gnb         ueSetting=${UE_PROFILE1}
    # ${output}=           common_Dss_SA_NSA.Read WTS Output For Pattern And Print matching Lines    ${UE_attach_pattern}    ${Timeout_NSA}
    # Critical Step        common_Dss_SA_NSA.5G Ue Attach Check      ${output}
    Traffic UE UL  ueSetting=${UE_PROFILE1}  throughput=${param.seq.ul_throughput}
    ...             duration=1  shouldBeStop=False  shouldBeCheck=False  deviation=15

    UE Attach Enb                   ueSetting=${UE_PROFILE2}
    Critical Step     UE Attach Gnb          ueSetting=${UE_PROFILE2}
    # ${output}=           common_Dss_SA_NSA.Read WTS Output For Pattern And Print matching Lines    ${UE_attach_pattern}    ${Timeout_NSA}
    # Critical Step        common_Dss_SA_NSA.5G Ue Attach Check      ${output}
    Traffic UE UL  ueSetting=${UE_PROFILE2}  throughput=${param.seq.ul_throughput}
    ...             duration=1  shouldBeStop=False  shouldBeCheck=False  deviation=15

    UE Attach Enb                   ueSetting=${UE_PROFILE3}
    Critical Step    UE Attach Gnb            ueSetting=${UE_PROFILE3}
    # ${output}=             common_Dss_SA_NSA.Read WTS Output For Pattern And Print matching Lines    ${UE_attach_pattern}    ${Timeout_NSA}
    # Critical Step        common_Dss_SA_NSA.5G Ue Attach Check      ${output}
    Traffic UE UL  ueSetting=${UE_PROFILE3}  throughput=${param.seq.ul_throughput}
    ...              duration=10  shouldBeStop=False  shouldBeCheck=False  deviation=15

    [Teardown]           GenericTest.Display diagnosis


Fetch common OAM SW version
    [Documentation]    :
    ...    Only used by KW "Fetch Current gNB SW Version"
    ...    [PRIVATE]
    [Arguments]    ${gnb_id}=0  ${bts_host}=${EMPTY}
    ${bts_host}=  Set Variable if  '${bts_host}'=='${EMPTY}'  ${tl.gnbs[${gnb_id}].cu.oam_http_connection_details.addr}  ${bts_host}
    admin.connect_to    bts_host=${bts_host}    name=gnb
    ${gnb_sw_version}=    admin.get_sw_version    connection=gnb
    admin.teardown    connection=gnb
    ${gnb_sw_version}=    nps_1586_tools.reform_coam_sw_version    ${gnb_sw_version}
    set global variable    ${TLConfig.release.name}      ${gnb_sw_version}
    [Return]    ${gnb_sw_version}

Get TTI traces
    Dated Log         Start TTI Traces in Streaming Mode
    ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traced Sleep    1s      msg=Waiting for TTI Traces
    Dated log         Stop TTI Traces in Streaming Mode...
    ttitrace.Stop TTI Traces in Streaming Mode      tti_trace_path=${testCaseDir}
    Dated log         Decode TTI Traces...
    nps_ttitraces_tools.decode_tti_traces_using_TtitraceReaderEvtDec    desired_storage_directory=${testCaseDir}    num_of_events=10000

Get TTI traces 2
    [Arguments]     ${time}=1s    ${event_nr_max}=10000   ${w_convert_pcap_to_excelCsv}=True
    ${tm}    Get Current Date
    ${tm}=    Remove String    ${tm.replace(' ','-')}    .
    Dated Log         Start TTI Traces in Streaming Mode
    ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Traced Sleep    ${time}      msg=Waiting for TTI Traces
    Dated log         Stop TTI Traces in Streaming Mode...
    ${tti_trace_path}=     ttitrace.Stop TTI Traces in Streaming Mode    tti_trace_path=${testCaseDir}/TtiTrace-${time}-${tm}
    Dated log         Decode TTI Traces...
    nps_ttitraces_tools.decode_tti_traces_using_TtitraceReaderEvtDec       desired_storage_directory=${testCaseDir}/TtiTrace-${time}-${tm}
    ...                                                                    num_of_events=${event_nr_max}
    run keyword if   '${w_convert_pcap_to_excelCsv}'=='True'    run keywords
    ...               Dated log    Convert TTI trace from pcap to excelCsv...    AND
    ...               Run keyword and continue on failure     ttitrace.Convert TTI trace from pcap to excelCsv     input_file_path=${tti_trace_path}
    ...                                                                    output_file_path=${testCaseDir}/TtiTrace-${time}-${tm}
    [return]     ${testCaseDir}/TtiTrace-${time}-${tm}

Get NumOfLayers from TTI traces
    [Arguments]           ${resultDir}      ${UeList}
    ${NumOfLayers_UeId1}    set variable    None
    ${NumOfLayers_UeId2}    set variable    None
    ${NumOfLayers_UeId3}    set variable    None
    ${Ue_index}    Set Variable    ${1}
    FOR  ${ueId}   IN   @{UeList}
        ${samples_value}     nps_1586_tools.get_numOfLayers     ${resultDir}    ${ueId}   method="Expand array item Field"
        Set test variable  ${NumOfLayers_UeId${Ue_index}}  ${samples_value}
        ${Ue_index}    Evaluate    ${Ue_index}+1
    END
    [return]   ${NumOfLayers_UeId1}  ${NumOfLayers_UeId2}  ${NumOfLayers_UeId3}

Get aggregationLevel from TTI traces
    [Arguments]           ${resultDir}      ${UeList}
    ${aggregationLevel_UeId1}   set variable    None
    ${aggregationLevel_UeId2}   set variable    None
    ${aggregationLevel_UeId3}   set variable    None
    ${Ue_index}    Set Variable    ${1}
    FOR  ${ueId}   IN   @{UeList}
        ${samples_value}     nps_1586_tools.get_aggregationLevel     ${resultDir}    ${ueId}
        Set test variable  ${aggregationLevel_UeId${Ue_index}}  ${samples_value}
        ${Ue_index}    Evaluate    ${Ue_index}+1
    END
    [return]   ${aggregationLevel_UeId1}  ${aggregationLevel_UeId2}  ${aggregationLevel_UeId3}

Check UL Per Slot Ue Numbers
    [Arguments]    ${tti_csv_dir}    ${number}
    ${file_name}    Set Variable    ${tti_csv_dir}/msg_all.csv
    ${result}    Set Variable    ${False}
    ${result}    Verify UL Per Slot Ue Numbers In Target File    ${file_name}    ${number}
    Should Be True    ${result}==${True}

Verify UL Per Slot Ue Numbers In Target File
    [Arguments]    ${tti_csv_name}    ${number}
    [Documentation]    tti csv file contains all msg, please refer to 'decode tti traces' in tools.py for more infos
    ${times}    Evaluate    ${number}-1
    ${full_pattern}=   Catenate   SEPARATOR=   ulFdSchedData;eventHeader;onAirTime;sfn;(?P<sfn>\\d+);slot;(?P<slot>\\d+).+\\n(?:ulFdSchedData;
    ...                                        eventHeader;onAirTime;sfn;(?P=sfn);slot;(?P=slot).+\\n){${times}}
    ${full_patt}    Set Variable    ${full_pattern}
    ${rnti_patt}    Set Variable    ulFdSchedData;eventHeader;onAirTime;sfn;\\d+;slot;\\d+;rnti;(?P<rnti>\\d+)
    ${content}    OperatingSystem.Get File    ${tti_csv_name}
    ${matches}    String.Get Regexp Matches    ${content}    ${full_patt}
    ${check_result}    Set Variable    ${False}
    FOR    ${item}    IN    @{matches}
        ${rnti_vals}    String.Get Regexp Matches    ${item}    ${rnti_patt}    rnti
        ${count}    Evaluate    len(set(${rnti_vals}))
        ${check_result}    Run Keyword And Return Status    Should Be Equal As Integers    ${count}    ${number}
        Exit For Loop If    ${check_result}==${True}
    END
    [Return]    ${check_result}

Verify UE tput as expected
    [Documentation]
    [Arguments]    ${tput_value}    ${expect_tput_value}    ${deviation}=${tput_deviation}
    run keyword if    ${expect_tput_value}==${0}    run keywords
    ...    should be true    ${tput_value}>=0    AND   return from keyword

    ${min}    evaluate    ${expect_tput_value}*(1-${deviation})
    ${max}    evaluate    ${expect_tput_value}*(1+${deviation})
    ${is_tput_as_expected}    evaluate    ${min} <= ${tput_value} <= ${max}
    ${msg}=     Run Keyword If     '${is_tput_as_expected}'=='True'
    ...    Catenate     \t${green} UL Tput for all Ues REACHED: expected = ${expect_tput_value} Mbps,
    ...                            current = ${tput_value} Mbps ${normal}
    ...    ELSE
    ...    Catenate     \t${red} UL Tput for all Ues NOT REACHED: expected = ${expect_tput_value} Mbps,
    ...                          current = ${tput_value} Mbps ${normal}
    Log to Console         ${msg}
    should be true    '${is_tput_as_expected}'=='True'    Tput is not as expected!

Verify UL Qos Load Ind as expected
    [Documentation]
    [Arguments]    ${ul_qos_load_value}    ${expect_ul_qos_load_value}    ${deviation}=${ul_Qos_Load_deviation}
    run keyword if    ${expect_ul_qos_load_value}==${0}    run keywords
    ...    should be true    ${ul_qos_load_value}>=0    AND   return from keyword

    ${min}    evaluate    ${expect_ul_qos_load_value}*(1-${deviation})
    ${max}    evaluate    ${expect_ul_qos_load_value}*(1+${deviation})
    ${is_ul_qos_load_as_expected}    evaluate    ${min} <= ${ul_qos_load_value} <= ${max}
    Run Keyword If                  '${is_ul_qos_load_as_expected}'=='True'
    ...    Log to Console            \t${green} Average UL DSS Ratio REACHED: expected = 100 % , current = ${ul_qos_load_value} % ${normal}
    ...    ELSE
    ...    Log to Console            \t${red} Average UL DSS RATIO NOT REACHED: expected = 100 %, current = ${ul_qos_load_value} % ${normal}
    should be true    '${is_ul_qos_load_as_expected}'=='True'    UL Qos load Indication is not as expected!

TC 1586-j 5gCall and Ul Traffic with 3 Ues using ute_wtssim
    [Documentation]                Test purpose is to test 5g DSS Call
    [Arguments]       ${param}      ${alias}=default     ${msg}=""     ${expect_tput_value}=0    ${w_stopTraffic}=True   ${w_stopWTS}=True
    Init Sequence                  ${param}
    ${throughput_for_ue1}   set variable    0
    ${throughput_for_ue2}   set variable    0
    ${throughput_for_ue3}   set variable    0
    ${avg_ul_MeasuredNgbrNnbrLoad}   set variable    0
    TC 1586-J CellSetup 2             ${param}   alias=${alias}
    Dated log         dss 5gCall and UL Traffic with 3Ues
    Dated log     =========> LTE Attach on ue_id=${UE_PROFILE1.ue}
    5GC001586_Ue_command.LTE Attach        ${UE_PROFILE1.ue}     alias=${alias}
    Dated log     =========> 5g Attach on ue_id=${UE_PROFILE1.ue}
    ${output}=   5GC001586_Ue_command.5G Attach         ${UE_PROFILE1}      alias=${alias}
    Critical Step      5GC001586_Ue_command.5G Ue Attach Check     ${output}
    Dated log     =========> NSA Start UL Traffic on ue_id=${UE_PROFILE1.ue} with ${param.seq.ul_throughput}M
    5GC001586_Ue_command.NSA Start UL Traffic   ue_id=${UE_PROFILE1.ue}
    ...                                         bearer_id=${UE_PROFILE1.bearer}
    ...                                         mbps=${param.seq.ul_throughput}
    ...                                         trf_id=${UE_PROFILE1.trf_id}       alias=${alias}

    Dated log     =========> LTE Attach on ue_id=${UE_PROFILE2.ue}
    5GC001586_Ue_command.LTE Attach        ${UE_PROFILE2.ue}     alias=${alias}
    Dated log     =========> 5g Attach on ue_id=${UE_PROFILE2.ue}
    ${output}=   5GC001586_Ue_command.5G Attach         ${UE_PROFILE2}      alias=${alias}
    Critical Step      5GC001586_Ue_command.5G Ue Attach Check     ${output}
    Dated log     =========> NSA Start UL Traffic on ue_id=${UE_PROFILE2.ue} with ${param.seq.ul_throughput}M
    5GC001586_Ue_command.NSA Start UL Traffic   ue_id=${UE_PROFILE2.ue}
    ...                                         bearer_id=${UE_PROFILE2.bearer}
    ...                                         mbps=${param.seq.ul_throughput}
    ...                                         trf_id=${UE_PROFILE2.trf_id}       alias=${alias}

    Dated log     =========> LTE Attach on ue_id=${UE_PROFILE3.ue}
    5GC001586_Ue_command.LTE Attach        ${UE_PROFILE3.ue}     alias=${alias}
    Dated log     =========> 5g Attach on ue_id=${UE_PROFILE3.ue}
    ${output}=   5GC001586_Ue_command.5G Attach         ${UE_PROFILE3}      alias=${alias}
    Critical Step      5GC001586_Ue_command.5G Ue Attach Check     ${output}
    Dated log     =========> NSA Start UL Traffic on ue_id=${UE_PROFILE3.ue} with ${param.seq.ul_throughput}M
    5GC001586_Ue_command.NSA Start UL Traffic   ue_id=${UE_PROFILE3.ue}
    ...                                         bearer_id=${UE_PROFILE3.bearer}
    ...                                         mbps=${param.seq.ul_throughput}
    ...                                         trf_id=${UE_PROFILE3.trf_id}       alias=${alias}

    Traced Sleep    60s

    Dated log     =========> get ul throughput for ue (0x${UE_PROFILE1.ue}, 0x${UE_PROFILE2.ue}, 0x${UE_PROFILE3.ue})
    ${throughput_for_ue1}=    nps_1586_tools.get_bearer_stats   ue=0x${UE_PROFILE1.ue}   bearer=${UE_PROFILE1.bearer}    direction=ul  alias=${alias}
    dated log     ul throughput for ue1 is ${throughput_for_ue1} Mbps
    ${throughput_for_ue2}=    nps_1586_tools.get_bearer_stats   ue=0x${UE_PROFILE2.ue}   bearer=${UE_PROFILE2.bearer}    direction=ul  alias=${alias}
    dated log     ul throughput for ue2 is ${throughput_for_ue2} Mbps
    ${throughput_for_ue3}=    nps_1586_tools.get_bearer_stats   ue=0x${UE_PROFILE3.ue}   bearer=${UE_PROFILE3.bearer}    direction=ul  alias=${alias}
    dated log     ul throughput for ue3 is ${throughput_for_ue3} Mbps
    ${all_throughput_for_ue}     evaluate    ${throughput_for_ue1}+${throughput_for_ue2}+${throughput_for_ue3}
    dated log     ul throughput for all ue is ${all_throughput_for_ue} Mbps

    Run Keyword if       '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'         Get TTI traces
    ${resultDir}=     common_Dss_Keywords.Get Testcase Log Directory
    ${TbSizeAvg}      Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'    nps_1586_tools.Get TbSize Avg      ${resultDir}
    ...                           ELSE     set variable   {0}
    ${UeList}         Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'    nps_1586_tools.get_rntis_from_ulFdSchedData          ${resultDir}
    ...                           ELSE     set variable    ${empty}
    ${NumOfLayers_UeId1}  ${NumOfLayers_UeId2}  ${NumOfLayers_UeId3}   Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'
    ...                                                                                Get NumOfLayers from TTI traces   ${resultDir}    ${UeList}
    ${aggregationLevel_UeId1}  ${aggregationLevel_UeId2}  ${aggregationLevel_UeId3}    Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'
    ...                                                                                Get aggregationLevel from TTI traces  ${resultDir}  ${UeList}

    Start capture Backhaul for DSS
    Traced Sleep    1s      msg=Waiting for Xp pcap traces
    ${XpPdmlFile}    Stop capture Backhaul for DSS
    Dated log             Point AF_PATH and ENB_BUILD to local luashark XP package
    Point AF_PATH to local luashark XP package
    Point ENB_BUILD to local luashark XP package
    Dated log                       Check UL Qos Load Indication MeasuredNgbrNnbrLoad ...
    ${status}   ${avg_ul_MeasuredNgbrNnbrLoad}=   Run Keyword and Ignore Error   5GC001586_Keywords.Check UL Qos Load Indication MeasuredNgbrNnbrLoad
    ...                                                                                              ${XpPdmlFile}
    ...                                                                                              value=100
    ...                                                                                              with_verdict=False

    ${UeId1}=    Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'   set variable     @{UeList}[0]
    ...                      ELSE      set variable     None
    ${UeId2}=    Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'   set variable     @{UeList}[1]
    ...                      ELSE      set variable     None
    ${UeId3}=    Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'   set variable     @{UeList}[2]
    ...                      ELSE      set variable     None

    # "TC; BW; Ue1; Ue2; Ue3; Ue Tput Sum; tbSize Avg; NumOfLayers; aggregationLevel; avg_ul_MeasuredNgbrNnbrLoad; desciption "
    ${text}   catenate     ${TEST_NAME};  ${param.seq.bandwidth};  ${throughput_for_ue1};
    ...           ${throughput_for_ue2};  ${throughput_for_ue3};  ${all_throughput_for_ue};  ${TbSizeAvg};
    ...           ${NumOfLayers_UeId1} [rnti=${UeId1}];  ${NumOfLayers_UeId2} [rnti=${UeId2}]; ${NumOfLayers_UeId3} [rnti=${UeId3}];
    ...           ${aggregationLevel_UeId1} [rnti=${UeId1}];  ${aggregationLevel_UeId2} [rnti=${UeId2}]; ${aggregationLevel_UeId3} [rnti=${UeId3}];
    ...           ${avg_ul_MeasuredNgbrNnbrLoad};  ${msg}; ${current_sw_version_for_lua_gNB};
    Dated log             ${text}
    Log Test results      ${text}

    Run Keyword if    '${w_stopTraffic}'=='True'     5GC001586_Ue_command.NSA Stop Traffic     ue_id=${UE_PROFILE1.ue}
    ...                                       bearer_id=${UE_PROFILE1.bearer}
    ...                                       dir=ul
    ...                                       trf_id=${UE_PROFILE1.trf_id}      alias=${alias}
    Run Keyword if    '${w_stopTraffic}'=='True'     5GC001586_Ue_command.NSA Stop Traffic     ue_id=${UE_PROFILE2.ue}
    ...                                       bearer_id=${UE_PROFILE2.bearer}
    ...                                       dir=ul
    ...                                       trf_id=${UE_PROFILE2.trf_id}      alias=${alias}
    Run Keyword if    '${w_stopTraffic}'=='True'     5GC001586_Ue_command.NSA Stop Traffic     ue_id=${UE_PROFILE3.ue}
    ...                                       bearer_id=${UE_PROFILE3.bearer}
    ...                                       dir=ul
    ...                                       trf_id=${UE_PROFILE3.trf_id}      alias=${alias}

    Dated log     =========> Test if Expected ul Tput For all Ues is reached
    ${expect_tput}=    Evaluate    float(${expect_tput_value})
    Verify UE tput as expected      tput_value=${all_throughput_for_ue}    expect_tput_value=${expect_tput}

    Dated log     =========> Test if Expected ul Qos Load Indication is reached
    # 100 %
    ${expect_UL_Qos_load_Ind_value}    set variable    100
    ${expect_UL_Qos_load_Ind}=    Evaluate    float(${expect_UL_Qos_load_Ind_value})
    Verify UL Qos Load Ind as expected      ul_qos_load_value=${avg_ul_MeasuredNgbrNnbrLoad}    expect_ul_qos_load_value=${expect_UL_Qos_load_Ind}

    [Teardown]           run Keywords     GenericTest.Display diagnosis   AND
    ...                                   Run Keyword if   '${w_stopWTS}' == 'True'    5GC001586_Ue_command.Stop WTS     egate_alias=${alias}

TC 1586-j 5gCall and Ul Traffic with 4 Ues using ute_wtssim
    [Documentation]                Test purpose is to test 5g DSS Call
    [Arguments]                    ${param}      ${alias}=default     ${msg}=""     ${expect_tput_value}=0    ${w_stopTraffic}=True
    Init Sequence                  ${param}
    ${throughput_for_ue1}   set variable    0
    ${throughput_for_ue2}   set variable    0
    ${throughput_for_ue3}   set variable    0
    ${avg_ul_MeasuredNgbrNnbrLoad}   set variable    0
    TC 1586-J CellSetup 2             ${param}   alias=${alias}
    Dated log         dss 5gCall and UL Traffic with 4Ues
    Dated log     =========> LTE Attach on ue_id=${UE_PROFILE1.ue}
    5GC001586_Ue_command.LTE Attach        ${UE_PROFILE1.ue}     alias=${alias}
    Dated log     =========> 5g Attach on ue_id=${UE_PROFILE1.ue}
    ${output}=   5GC001586_Ue_command.5G Attach         ${UE_PROFILE1}      alias=${alias}
    Critical Step      5GC001586_Ue_command.5G Ue Attach Check     ${output}
    Dated log     =========> NSA Start UL Traffic on ue_id=${UE_PROFILE1.ue} with ${param.seq.ul_throughput}M
    5GC001586_Ue_command.NSA Start UL Traffic   ue_id=${UE_PROFILE1.ue}
    ...                                         bearer_id=${UE_PROFILE1.bearer}
    ...                                         mbps=${param.seq.ul_throughput}
    ...                                         trf_id=${UE_PROFILE1.trf_id}       alias=${alias}

    Dated log     =========> LTE Attach on ue_id=${UE_PROFILE2.ue}
    5GC001586_Ue_command.LTE Attach        ${UE_PROFILE2.ue}     alias=${alias}
    Dated log     =========> 5g Attach on ue_id=${UE_PROFILE2.ue}
    ${output}=   5GC001586_Ue_command.5G Attach         ${UE_PROFILE2}      alias=${alias}
    Critical Step      5GC001586_Ue_command.5G Ue Attach Check     ${output}
    Dated log     =========> NSA Start UL Traffic on ue_id=${UE_PROFILE2.ue} with ${param.seq.ul_throughput}M
    5GC001586_Ue_command.NSA Start UL Traffic   ue_id=${UE_PROFILE2.ue}
    ...                                         bearer_id=${UE_PROFILE2.bearer}
    ...                                         mbps=${param.seq.ul_throughput}
    ...                                         trf_id=${UE_PROFILE2.trf_id}       alias=${alias}

    Dated log     =========> LTE Attach on ue_id=${UE_PROFILE3.ue}
    5GC001586_Ue_command.LTE Attach        ${UE_PROFILE3.ue}     alias=${alias}
    Dated log     =========> 5g Attach on ue_id=${UE_PROFILE3.ue}
    ${output}=   5GC001586_Ue_command.5G Attach         ${UE_PROFILE3}      alias=${alias}
    Critical Step      5GC001586_Ue_command.5G Ue Attach Check     ${output}
    Dated log     =========> NSA Start UL Traffic on ue_id=${UE_PROFILE3.ue} with ${param.seq.ul_throughput}M
    5GC001586_Ue_command.NSA Start UL Traffic   ue_id=${UE_PROFILE3.ue}
    ...                                         bearer_id=${UE_PROFILE3.bearer}
    ...                                         mbps=${param.seq.ul_throughput}
    ...                                         trf_id=${UE_PROFILE3.trf_id}       alias=${alias}

    Dated log     =========> LTE Attach on ue_id=${UE_PROFILE4.ue}
    5GC001586_Ue_command.LTE Attach        ${UE_PROFILE4.ue}     alias=${alias}
    Dated log     =========> 5g Attach on ue_id=${UE_PROFILE4.ue}
    ${output}=   5GC001586_Ue_command.5G Attach         ${UE_PROFILE4}      alias=${alias}
    Critical Step      5GC001586_Ue_command.5G Ue Attach Check     ${output}
    Dated log     =========> NSA Start UL Traffic on ue_id=${UE_PROFILE4.ue} with ${param.seq.ul_throughput}M
    5GC001586_Ue_command.NSA Start UL Traffic   ue_id=${UE_PROFILE4.ue}
    ...                                         bearer_id=${UE_PROFILE4.bearer}
    ...                                         mbps=${param.seq.ul_throughput}
    ...                                         trf_id=${UE_PROFILE4.trf_id}       alias=${alias}

    Traced Sleep    60s

    Dated log     =========> get ul throughput for ue (0x${UE_PROFILE1.ue}, 0x${UE_PROFILE2.ue}, 0x${UE_PROFILE3.ue}, 0x${UE_PROFILE4.ue})
    ${throughput_for_ue1}=    nps_1586_tools.get_bearer_stats   ue=0x${UE_PROFILE1.ue}   bearer=${UE_PROFILE1.bearer}    direction=ul  alias=${alias}
    dated log     ul throughput for ue1 is ${throughput_for_ue1} Mbps
    ${throughput_for_ue2}=    nps_1586_tools.get_bearer_stats   ue=0x${UE_PROFILE2.ue}   bearer=${UE_PROFILE2.bearer}    direction=ul  alias=${alias}
    dated log     ul throughput for ue2 is ${throughput_for_ue2} Mbps
    ${throughput_for_ue3}=    nps_1586_tools.get_bearer_stats   ue=0x${UE_PROFILE3.ue}   bearer=${UE_PROFILE3.bearer}    direction=ul  alias=${alias}
    dated log     ul throughput for ue3 is ${throughput_for_ue3} Mbps
    ${throughput_for_ue4}=    nps_1586_tools.get_bearer_stats   ue=0x${UE_PROFILE4.ue}   bearer=${UE_PROFILE4.bearer}    direction=ul  alias=${alias}
    dated log     ul throughput for ue4 is ${throughput_for_ue4} Mbps
    ${all_throughput_for_ue}     evaluate    ${throughput_for_ue1}+${throughput_for_ue2}+${throughput_for_ue3}+${throughput_for_ue4}
    dated log     ul throughput for all ue is ${all_throughput_for_ue} Mbps

    Run Keyword if       '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'         Get TTI traces
    ${resultDir}=     common_Dss_Keywords.Get Testcase Log Directory
    ${TbSizeAvg}      Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'    nps_1586_tools.Get TbSize Avg      ${resultDir}
    ...                           ELSE     set variable   {0}
    ${UeList}         Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'    nps_1586_tools.get_rntis_from_ulFdSchedData          ${resultDir}
    ...                           ELSE     set variable    ${empty}
    ${NumOfLayers_UeId1}  ${NumOfLayers_UeId2}  ${NumOfLayers_UeId3}   Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'
    ...                                                                                Get NumOfLayers from TTI traces   ${resultDir}    ${UeList}
    ${aggregationLevel_UeId1}  ${aggregationLevel_UeId2}  ${aggregationLevel_UeId3}    Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'
    ...                                                                                Get aggregationLevel from TTI traces  ${resultDir}  ${UeList}

    Start capture Backhaul for DSS
    Traced Sleep    1s      msg=Waiting for Xp pcap traces
    ${XpPdmlFile}    Stop capture Backhaul for DSS
    Dated log             Point AF_PATH and ENB_BUILD to local luashark XP package
    Point AF_PATH to local luashark XP package
    Point ENB_BUILD to local luashark XP package
    Dated log                       Check UL Qos Load Indication MeasuredNgbrNnbrLoad ...
    ${status}   ${avg_ul_MeasuredNgbrNnbrLoad}=   Run Keyword and Ignore Error   5GC001586_Keywords.Check UL Qos Load Indication MeasuredNgbrNnbrLoad
    ...                                                                                              ${XpPdmlFile}
    ...                                                                                              value=100
    ...                                                                                              with_verdict=False

    ${UeId1}=    Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'   set variable     @{UeList}[0]
    ...                      ELSE      set variable     None
    ${UeId2}=    Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'   set variable     @{UeList}[1]
    ...                      ELSE      set variable     None
    ${UeId3}=    Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'   set variable     @{UeList}[2]
    ...                      ELSE      set variable     None
    ${UeId4}=    Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'   set variable     @{UeList}[3]
    ...                      ELSE      set variable     None

    # "TC; BW; Ue1; Ue2; Ue3; Ue Tput Sum; tbSize Avg; NumOfLayers; aggregationLevel; avg_ul_MeasuredNgbrNnbrLoad; desciption "
    ${text}   catenate     ${TEST_NAME};  ${param.seq.bandwidth};  ${throughput_for_ue1};
    ...           ${throughput_for_ue2};  ${throughput_for_ue3};  ${throughput_for_ue4}; ${all_throughput_for_ue};  ${TbSizeAvg};
    ...           ${NumOfLayers_UeId1} [rnti=${UeId1}];  ${NumOfLayers_UeId2} [rnti=${UeId2}]; ${NumOfLayers_UeId3} [rnti=${UeId3}];
    ...           ${aggregationLevel_UeId1} [rnti=${UeId1}];  ${aggregationLevel_UeId2} [rnti=${UeId2}]; ${aggregationLevel_UeId3} [rnti=${UeId3}];
    ...           ${avg_ul_MeasuredNgbrNnbrLoad};  ${msg}; ${current_sw_version_for_lua_gNB};
    Dated log             ${text}
    Log Test results      ${text}

    Run Keyword if    '${w_stopTraffic}'=='True'     5GC001586_Ue_command.NSA Stop Traffic     ue_id=${UE_PROFILE1.ue}
    ...                                       bearer_id=${UE_PROFILE1.bearer}
    ...                                       dir=ul
    ...                                       trf_id=${UE_PROFILE1.trf_id}      alias=${alias}
    Run Keyword if    '${w_stopTraffic}'=='True'     5GC001586_Ue_command.NSA Stop Traffic     ue_id=${UE_PROFILE2.ue}
    ...                                       bearer_id=${UE_PROFILE2.bearer}
    ...                                       dir=ul
    ...                                       trf_id=${UE_PROFILE2.trf_id}      alias=${alias}
    Run Keyword if    '${w_stopTraffic}'=='True'     5GC001586_Ue_command.NSA Stop Traffic     ue_id=${UE_PROFILE3.ue}
    ...                                       bearer_id=${UE_PROFILE3.bearer}
    ...                                       dir=ul
    ...                                       trf_id=${UE_PROFILE3.trf_id}      alias=${alias}
    Run Keyword if    '${w_stopTraffic}'=='True'     5GC001586_Ue_command.NSA Stop Traffic     ue_id=${UE_PROFILE4.ue}
    ...                                       bearer_id=${UE_PROFILE4.bearer}
    ...                                       dir=ul
    ...                                       trf_id=${UE_PROFILE4.trf_id}      alias=${alias}

    Dated log     =========> Test if Expected ul Tput For all Ues is reached
    ${expect_tput}=    Evaluate    float(${expect_tput_value})
    Verify UE tput as expected      tput_value=${all_throughput_for_ue}    expect_tput_value=${expect_tput}

    Dated log     =========> Test if Expected ul Qos Load Indication is reached
    # 100 %
    ${expect_UL_Qos_load_Ind_value}    set variable    100
    ${expect_UL_Qos_load_Ind}=    Evaluate    float(${expect_UL_Qos_load_Ind_value})
    Verify UL Qos Load Ind as expected      ul_qos_load_value=${avg_ul_MeasuredNgbrNnbrLoad}    expect_ul_qos_load_value=${expect_UL_Qos_load_Ind}

    [Teardown]           run Keywords     GenericTest.Display diagnosis   AND
    ...                                   5GC001586_Ue_command.Stop WTS     egate_alias=${alias}

TC 1586-j 5gCall and Ul Traffic with 1 Ue using ute_wtssim
    [Documentation]                Test purpose is to test 5g DSS Call
    [Arguments]                    ${param}      ${alias}=default     ${msg}=""     ${expect_tput_value}=0
    Init Sequence                  ${param}
    ${throughput_for_ue1}   set variable    0
    ${throughput_for_ue2}   set variable    0
    ${throughput_for_ue3}   set variable    0
    ${avg_ul_MeasuredNgbrNnbrLoad}   set variable    0
    TC 1586-J CellSetup 2             ${param}   alias=${alias}
    Dated log         dss 5gCall and UL Traffic with 1Ue
    Dated log     =========> LTE Attach on ue_id=${UE_PROFILE1.ue}
    5GC001586_Ue_command.LTE Attach        ${UE_PROFILE1.ue}     alias=${alias}
    Dated log     =========> 5g Attach on ue_id=${UE_PROFILE1.ue}
    ${output}=     5GC001586_Ue_command.5G Attach         ${UE_PROFILE1}      alias=${alias}
    Critical Step      5GC001586_Ue_command.5G Ue Attach Check     ${output}
    Dated log     =========> NSA Start UL Traffic on ue_id=${UE_PROFILE1.ue} with ${param.seq.ul_throughput}M
    5GC001586_Ue_command.NSA Start UL Traffic   ue_id=${UE_PROFILE1.ue}
    ...                                         bearer_id=${UE_PROFILE1.bearer}
    ...                                         mbps=${param.seq.ul_throughput}
    ...                                         trf_id=${UE_PROFILE1.trf_id}       alias=${alias}

    Traced Sleep    60s

    Dated log     =========> get ul throughput for ue (0x${UE_PROFILE1.ue})
    ${throughput_for_ue1}=    nps_1586_tools.get_bearer_stats   ue=0x${UE_PROFILE1.ue}   bearer=${UE_PROFILE1.bearer}    direction=ul  alias=${alias}
    dated log     ul throughput for ue1 is ${throughput_for_ue1} Mbps
    ${all_throughput_for_ue}     evaluate    ${throughput_for_ue1}+${throughput_for_ue2}+${throughput_for_ue3}
    dated log     ul throughput for all ue is ${all_throughput_for_ue} Mbps

    Run Keyword if       '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'         Get TTI traces
    ${resultDir}=     common_Dss_Keywords.Get Testcase Log Directory
    ${TbSizeAvg}      Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'    nps_1586_tools.Get TbSize Avg      ${resultDir}
    ...                           ELSE     set variable   {0}
    ${UeList}         Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'    nps_1586_tools.get_rntis_from_ulFdSchedData          ${resultDir}
    ...                           ELSE     set variable    ${empty}
    ${NumOfLayers_UeId1}  ${NumOfLayers_UeId2}  ${NumOfLayers_UeId3}   Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'
    ...                                                                                Get NumOfLayers from TTI traces   ${resultDir}    ${UeList}
    ${aggregationLevel_UeId1}  ${aggregationLevel_UeId2}  ${aggregationLevel_UeId3}    Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'
    ...                                                                                Get aggregationLevel from TTI traces  ${resultDir}  ${UeList}

    Start capture Backhaul for DSS
    Traced Sleep    1s      msg=Waiting for Xp pcap traces
    ${XpPdmlFile}    Stop capture Backhaul for DSS
    Dated log             Point AF_PATH and ENB_BUILD to local luashark XP package
    Point AF_PATH to local luashark XP package
    Point ENB_BUILD to local luashark XP package
    Dated log                       Check UL Qos Load Indication MeasuredNgbrNnbrLoad ...
    ${status}   ${avg_ul_MeasuredNgbrNnbrLoad}=   Run Keyword and Ignore Error   5GC001586_Keywords.Check UL Qos Load Indication MeasuredNgbrNnbrLoad
    ...                                                                       ${XpPdmlFile}
    ...                                                                       value=100
    ...                                                                       with_verdict=False

    ${UeId1}=    Run Keyword if  '${UL_TPUT_CHECK_BASED_TTITRACE}'=='1'   set variable     @{UeList}[0]
    ...                      ELSE      set variable     None
    ${UeId2}=         set variable     None
    ${UeId3}=         set variable     None

    # "TC; BW; Ue1; Ue2; Ue3; Ue Tput Sum; tbSize Avg; NumOfLayers; aggregationLevel; avg_ul_MeasuredNgbrNnbrLoad; desciption "
    ${text}   catenate     ${TEST_NAME};  ${param.seq.bandwidth};  ${throughput_for_ue1};
    ...           ${throughput_for_ue2};  ${throughput_for_ue3};  ${all_throughput_for_ue};  ${TbSizeAvg};
    ...           ${NumOfLayers_UeId1} [rnti=${UeId1}];  ${NumOfLayers_UeId2} [rnti=${UeId2}]; ${NumOfLayers_UeId3} [rnti=${UeId3}];
    ...           ${aggregationLevel_UeId1} [rnti=${UeId1}];  ${aggregationLevel_UeId2} [rnti=${UeId2}]; ${aggregationLevel_UeId3} [rnti=${UeId3}];
    ...           ${avg_ul_MeasuredNgbrNnbrLoad};  ${msg}; ${current_sw_version_for_lua_gNB};
    Dated log             ${text}
    Log Test results      ${text}

    5GC001586_Ue_command.NSA Stop Traffic     ue_id=${UE_PROFILE1.ue}
    ...                                       bearer_id=${UE_PROFILE1.bearer}
    ...                                       dir=ul
    ...                                       trf_id=${UE_PROFILE1.trf_id}      alias=${alias}

#    No check on Expected ul Tput in this case ( 1Ue testcase )
#    Dated log     =========> Test if Expected ul Tput For all Ues is reached
#    ${expect_tput}=    Evaluate    float(${expect_tput_value})
#    Verify UE tput as expected      tput_value=${all_throughput_for_ue}    expect_tput_value=${expect_tput}

    [Teardown]           run Keywords     GenericTest.Display diagnosis   AND
    ...                                   5GC001586_Ue_command.Stop WTS     egate_alias=${alias}


TC 1586-j Stop Ul Traffic on 3 Ues
    [Documentation]                Test purpose is to stop ul traffic
    [Arguments]                    ${param}
    Init Sequence                  ${param}

    Traffic Stop                    ueSetting=${UE_PROFILE1}      dir=ul
    Traffic Stop                    ueSetting=${UE_PROFILE2}      dir=ul
    Traffic Stop                    ueSetting=${UE_PROFILE3}      dir=ul
    [Teardown]           GenericTest.Display diagnosis

Set SCF prachConfigurationIndex
    [Arguments]          ${prachConfigurationIndex}
    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}
#      TestParam is ${testParam}
# MRBTS-69/NRBTS-2/NRCELL-1/NRDSSLTE-1

    &{modify_param}    Create Dictionary
    ...    parameter=prachConfigurationIndex
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1
    ...    value=${prachConfigurationIndex}

    @{modify_param}    Create List    ${modify_param}

    BuiltIn.Log      \nParameters to modify:\n @{modify_param}   console=yes
    OAM Set Params    modify_param=@{modify_param}

Set SCF dssMaxNumberOfDlDcis
