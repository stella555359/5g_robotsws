    Dated log New Line                       NRCELL_DIST_NAME=${NRCELL_DIST_NAME}

    &{modify_param1}    Create Dictionary
    ...    parameter=dssMaxNumberOfDlDcis
    ...    dist_name=MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-1/NRDSSLTE-1
    ...    value=${dssMaxNumberOfDlDcis}

    @{modify_param}    Create List    ${modify_param1}

    BuiltIn.Log      \nParameters to modify:\n @{modify_param}   console=yes
    OAM Set Params    modify_param=@{modify_param}

Update rdDssUlDciAggregationThreshold with
   [Arguments]                    ${rdDssUlDciAggregationThreshold}=15
    ${cprt_rdDssUlDciAggregationThreshold}=   Run Keyword If  '${branch}' == '20A'  create dictionary   field=0x590093
    ...                                                                                                 value=${rdDssUlDciAggregationThreshold}
    ...   ELSE      create dictionary     field=0x590095      value=${rdDssUlDciAggregationThreshold}

    ${swconfig_gnb}=                 Create List           ${cprt_rdDssUlDciAggregationThreshold}
    Set Fields in swconfig DU       param_list=${swconfig_gnb}

# ${SWCONFIG_FILE}                    swconfig.txt
#${SWCONFIG_PATH}                    /ffs/run/${SWCONFIG_FILE}
Private Set Fields in swconfig DU
    [Documentation]                 Generic service to set a list of parameters into swconfig file
    ...                             param_list should be a list od dictionaries, each containing a "field" and a "value"
    [Arguments]                     ${param_list}                           ${host}=192.168.255.129
    ${local_file}                   set variable                            ${LOG_PATH}/swconfig.txt
    ${remote_file}                  set variable                            /ffs/run/swconfig.txt
    # 21092022 : bypassed for the moment
    # ${alias}                        SSH Wait For Connect                    host=${host}
   ${alias}=  Wait until keyword succeeds     10 min     10 sec
    ...     common_Dss_Keywords.Connect to gNB Common Unit  gnb_id=0  du_id=0    comu_id=0
    csn.download_file               remote_path=${remote_file}
    ...                             local_path=${local_file}
    ...                             connection=${alias}

    # Adding newline at the end of the file to avoid appending data on the same line
    # (this happens if the last line does not have newline char at the end)
    run                             echo "" >> ${local_file}

    setFieldsInFile                 srcFile=${local_file}                   paramList=${param_list}
    csn.upload_file                 local_path=${local_file}
    ...                             remote_path=${remote_file}
    ...                             connection=${alias}
    SSH Exec                        command=crasign ${remote_file}           alias=${alias}

Update K2max with
   [Arguments]                    ${rdExtendK2Max}=5
    # ${l2ps_rdExtendK2Max_0x580226}=       create dictionary                  field=0x580226          value=${RadParam_rdExtendK2Max_0x580226}
    ${l2ps_rdExtendK2Max}=   Run Keyword If  '${branch}' == '20A'  create dictionary  field=0x580226  value=${rdExtendK2Max}
    ...    ELSE     create dictionary      field=0x580221          value=${rdExtendK2Max}

    ${swconfig_gnb}=                 Create List           ${l2ps_rdExtendK2Max}
    # 21092022 : bypassed  for the moment
    # Set Fields in swconfig DU       param_list=${swconfig_gnb}
    Private Set Fields in swconfig DU      param_list=${swconfig_gnb}

Update DSS DL pattern with
   [Arguments]                    ${testParam}     ${dl_allocated_normal_subframes}

   ${testParam_dss}                 Tools.Dictionary Get              ${testParam}
   ${testParam_dss.seq.dl_allocated_normal_subframes}      set Variable     ${dl_allocated_normal_subframes}
   set suite variable    ${testParam_dss}
   [Return]      ${testParam_dss}

Save swconfig file used
  [Arguments]                    ${testParam}
    # Get swconfig file that will be used during 1586 tests
    ${alias_gnb}                    SSH Wait For Connect                ${GNB_DU.sys[0].M}
    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${LOG_PATH}/swconfig_used_for_1586_J_${testParam.seq.bandwidth}_Tests.txt
    ...                             connection=${alias_gnb}
    Run Keyword And Ignore Error  OperatingSystem.Move File  ${LOG_PATH}/swconfig_used_for_1586_J_${testParam.seq.bandwidth}_Test.txt  ${testCaseDir}
    Dated Log                  Current 1586-J swconfig file stored to ${testCaseDir}/swconfig_used_for_1586_J_${testParam.seq.bandwidth}_Test.txt
    # Save current SCF file used during test cases
    ${current_scf_file}             OAM Get SCF File            dir=${testCaseDir}     file=SCF_used_for_1586_J_${testParam.seq.bandwidth}_Test.xml
    Set Suite Variable              ${current_scf_file}
    Dated Log                  Current 1586 SCF file stored to ${current_scf_file}

Prepare TL for TTITraces
    [Documentation]    :
    ...    This keyword helps to download and install MULTI packages needed for TTITraces
    ...
    nps_ttitraces_tools.install_multidynamic_if_needed
    # nps_1586_tools.install_multidynamic_if_needed_local_version

Log Test description
  [Arguments]                    ${text}
    Run Keyword And Ignore Error    OperatingSystem.touch    ${testCaseDir}/TestDescription_${SUITE_NAME}_${TEST_NAME}.txt
    Run Keyword And Ignore Error    OperatingSystem.run      echo ${text} > ${testCaseDir}/TestDescription_${SUITE_NAME}_${TEST_NAME}.txt

# "TC; BW; Ue1; Ue2; Ue3; Ue Tput Sum; tbSize Avg; NumOfLayers; aggregationLevel; avg_ul_MeasuredNgbrNnbrLoad; desciption "
Create Header Csv Test result
  [Arguments]                    ${text}=""
    ${text}    catenate   "TC Name; BW; Ue1(Mbps); Ue2(Mbps); Ue3(Mbps); Ue Tput Sum(Mbps); tbSize Avg (bits); NumOfLayers; NumOfLayers;"
    ...                   "NumOfLayers; aggregationLevel; aggregationLevel; aggregationLevel; avg_ul_MeasuredNgbrNnbrLoad %; description; "
    ...                   "Sw version;"
    Run Keyword And Ignore Error    OperatingSystem.touch    ${LOG_PATH}/TestResults_${SUITE_NAME}.csv
    Run Keyword And Ignore Error    OperatingSystem.run      echo ${text} > ${LOG_PATH}/TestResults_${SUITE_NAME}.csv
    set suite variable      ${csv_file_results}       ${LOG_PATH}/TestResults_${SUITE_NAME}.csv

Log Test results
  [Arguments]                    ${text}
    Run Keyword And Ignore Error    OperatingSystem.run      echo "${text}" >> ${LOG_PATH}/TestResults_${SUITE_NAME}.csv

dss_call_3Ue
    [Arguments]                    ${testParam}     ${alias}=default
    Init Sequence                  ${testParam}
    5GC001586_Keywords.Restart     OwnTLReset=${False}     GNBCallback=5GC001586_Keywords.Set Reset Loop Counter
    Dated Log         Start Bip and Xp capture for 1586...
    Start capture Bip and Xp for 1586
    Dated Log         Dss Cellsetup with DL pattern ${testParam.seq.dl_allocated_normal_subframes}...
    TC 1586-J CellSetup             ${testParam}   alias=${alias}
    Dated Log         Start TTI Traces in Streaming Mode
    ttitrace.Start TTI Traces in Streaming Mode      filter_bitmap2=0x0
    Dated log         dss 5gCall and UL Traffic with 3Ues
    TC 1586-j 5gCall and Ul Traffic with 3 Ues                ${testParam}
    [Teardown]    Stop and collect all needed traces     ${testParam}

dss_call_3Ue_using_ute_wtssim
