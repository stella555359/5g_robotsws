###################
# for 20Mhz case
###################

# 2022/01/05 : add TC for RCA https://jiradc.ext.net.nokia.com/browse/MNRCA-44864
# 2023/09/01 : replace with 5GC001586-MUE-ABIO.robot
[1][1.0] PRV_5GC001586_TC_05_3UEs_20MHZ_1586-J_TEST_M55308C18002_MAX_SCHED_UE_PUSCH
    [Tags]    FULL_RUN  TC5  FULL_CALL  20MHZ    1586J1
    [Documentation]     TC5 1586-J1 BW= 20MHz, 3Ues, DL/UL RATIO = 70%, K2max = 6, dssMaxNumberOfDlDcis = 1,
    ...                 test of MAX_SCHED_UE_PUSCH PM counter (M55308C18002)
    # [Setup]   Run Keywords    set Suite Variable    ${testCaseDir}    None      AND
    # ...       common_Dss_Keywords.Get testcase log directory    AND
    # ...       5GC001586_Keywords.Clean Up Env                   AND
    # ...       common_Dss_Keywords.Prepare Test Name             AND
    # ...       set Suite Variable    ${ul_expect_tput_value}           66                                   AND
    # ...       common_Dss_Keywords.Start Tcpdump on TestPc    interface=eth3    option=-s0 sctp or icmp     AND
    # ...       depends     TC_testsetup_1586-J_20MHZ

    ${tc_name}    Set variable    TestLine_preparation
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if     '${tc_status}'!='PASS'   Run Keywords
    ...                          5GC001586_Kw_TestSetup.Test Line Preparation for NSA Only    ${TestDSS20Mhz_1586_J_DL_RATIO_70}   AND
    ...                          5GC001586_Kw_TestSetup.Test Line Preparation    ${TestDSS20Mhz_1586_J_DL_RATIO_70}    AND
    ...                          5GC001586_Kw_TestSetup.Test Line Preparation for scf    ${TestDSS20Mhz_1586_J_DL_RATIO_70}
    ${tc_name}    Set variable    TC_testsetup_1586-J_20MHZ
    ${tc_status}    getTcStatusByName    name=${tc_name}
    Run keyword if    '${tc_status}'!='PASS'
    ...           Test Setup 1586 J    ${TestDSS20Mhz_1586_J_DL_RATIO_70}
    ${msg}   Catenate   "TC5 1586-J1: sw release used [${convert_version}], BW = 20MHz, 3Ues, DL/UL RATIO = 70%, K2max = 6,
    ...                  dssMaxNumberOfDlDcis = 1, test of MAX_SCHED_UE_PUSCH PM counter - M55308C18002"
    Log Test description  ${msg}
    Test case setup     ${TestDSS20Mhz_1586_J_DL_RATIO_70}
    Test specific setup 1586 J1     ${TestDSS20Mhz_1586_J_DL_RATIO_70}
    Update K2max with     rdExtendK2Max=6
    ${actIncreasedFdmUsersPerSlot_initial}=    get actIncreasedFdmUsersPerSlot from SCF
    ${actIncreasedFdmUsersPerSlot_initial_lower}=     evaluate    '${actIncreasedFdmUsersPerSlot_initial}'.lower()
    # SCF parameter NRBTS.NRCELL.actIncreasedFdmUsersPerSlot is False means feature CB006667 is deasctivated
    Set Specifc Scf Param actIncreasedFdmUsersPerSlot with "false" value and update into "${TestDSS20Mhz_1586_J_DL_RATIO_70}"
    Dated log       DL pattern into TestParam is ${TestDSS20Mhz_1586_J_DL_RATIO_70.seq.dl_allocated_normal_subframes}
    ${tti_trace_used_previously}   set variable   ${UL_TPUT_CHECK_BASED_TTITRACE}
    Set global variable    ${UL_TPUT_CHECK_BASED_TTITRACE}   1
    robot_extension.Run Keyword And Warn On Failure     btslog.Start Btslog
    dss_call_3Ue_using_ute_wtssim   ${TestDSS20Mhz_1586_J_DL_RATIO_70}   TC5_3UEs_1586J1_ON_20MHZ   ${msg}
    ...                             expect_tput_value=${ul_expect_tput_value}   w_stopTraffic=False   w_stopWTS=False
    # get 1s TTI trace
    ${tti_trace_path}      Get TTI traces 2     time=1s     event_nr_max=10000    w_convert_pcap_to_excelCsv=False
    # Sleep 15 mn in case of GP overlap - Traffic is still ongoing
    dated log    Wait 15 minutes for counters GP overlap
    ${status}  ${msg}=        robot_extension.Run Keyword And Warn On Failure        robot_extension.Run Specific Custom KW
    ...                                  5GC001586_Ue_command.Display PDSCH and PUSCH ue_stats_nr for 3 Ues using ute_wtssim
    ...                                              CallType=NSA
    ...                                              DlTput=0
    ...                                              UlTput=${ul_expect_tput_value}
    ...                                              alias=TC5_3UEs_1586J1_ON_20MHZ
    dated log    End of Wait 15 minutes for counters GP overlap
    # Traced Sleep   15 minutes     msg=counters GP overlap
    # Collect PM counter M55308C18002 : Maximum number of Scheduled (FDM and MU-MIMO) UEs on PUSCH per slot
    Get pm counter M55308C18002
    Check if M55308C18002 is "2"
    common_Dss_Keywords.Check Tput over GP period   nb_cell=1    dl_expected_tput=0    ul_expected_tput=${ul_expect_tput_value}
    # check 2 UE PUSCH sched in ul slot ....
    # 17/01/2022 : Acceptance criteria based on counter are enough + sfn anf fn not allways at same column in csv !!!
    Run Keyword and Ignore Error     Check UL Per Slot Ue Numbers   tti_csv_dir=${tti_trace_path}   number=2
    [Teardown]    Run Keywords         Set global variable    ${UL_TPUT_CHECK_BASED_TTITRACE}    ${tti_trace_used_previously}      AND
    ...             Set Specifc Scf Param actIncreasedFdmUsersPerSlot with "${actIncreasedFdmUsersPerSlot_initial_lower}" value   AND
    ...             Update actIncreasedFdmUsersPerSlot with   ${TestDSS20Mhz_1586_J_DL_RATIO_70}   ${actIncreasedFdmUsersPerSlot_initial_lower}  AND
    ...             common_Dss_Keywords.Collect PM Counters file coam   target_dir=${testCaseDir}     AND
    ...             common_Dss_Keywords.Stop Tcpdump on TestPc    interface=eth3    target_dir=${testCaseDir}   AND
    ...             robot_extension.Run Keyword And Warn On Failure    btslog.Stop Btslog    target_dir=${testCaseDir}   AND
    ...             robot_extension.Run Keyword And Warn On Failure    5GC001586_Ue_command.Stop WTS     egate_alias=TC5_3UEs_1586J1_ON_20MHZ   AND
    ...             Teardown 1586-J      ${TestDSS20Mhz_1586_J_DL_RATIO_70}    TC5_3UEs_1586J1_ON_20MHZ

# Test
#     common_Dss_Keywords.Get testcase log directory
#     ${number}    set variable    2
#     ${times}     Evaluate    ${number}-1
#     ${full_pattern}=   Catenate     ulFdSchedData;eventHeader;onAirTime;sfn;(?P<sfn>\\d+);slot;(?P<slot>\\d+).+\\n(?:ulFdSchedData;eventHeader;
#     ...                             onAirTime;sfn;(?P=sfn);slot;(?P=slot).+\\n){1}
#     ${full_patt}    Set Variable    ${full_pattern}
#     ${rnti_patt}    Set Variable    ulFdSchedData;eventHeader;onAirTime;sfn;\\d+;slot;\\d+;rnti;(?P<rnti>\\d+)
#     ${string}=  catenate   ulFdSchedData;eventHeader;onAirTime;sfn;10;slot;11;rnti;1036\nulFdSchedData;eventHeader;onAirTime;
#     ...                    sfn;10;slot;11;rnti;1039\n
#     ${matches}=   get regexp matches  ${string}   ${full_patt}
#     Dated log     matches=${matches}
#     ${check_result}    Set Variable    ${False}
#     FOR    ${item}    IN    @{matches}
#         ${rnti_vals}    String.Get Regexp Matches    ${item}    ${rnti_patt}    rnti
#         ${count}    Evaluate    len(set(${rnti_vals}))
#        ${check_result}    Run Keyword And Return Status    Should Be Equal As Integers    ${count}    ${number}
#        Exit For Loop If    ${check_result}==${True}
#    END

