*** Keywords ***

TC 2558-C SA Attach
    [Documentation]     Generic test for SA attach with PRB blanking
    [Arguments]         ${param}

    Init Sequence       ${param}

    Critical Step       Commission SCF From Config Folder
    Critical Step       Restart TL
    # Critical Step       Start Mirroring And Traces AP
    Run Keyword If      not ${isAic}
    ...      Step       Lock_Unused_Cells
    Critical Step       Start Mirroring And Traces gNB
    Critical Step       CallSetup.Setup Wtsemu SA    nbCell=1
    Critical Step       Check AP Cell Setup Is Completed
    Critical Step       CallSetup.UE Register
    Critical step       CallSetup.Launch PDU Session
    Critical Step       Stop Mirroring And Traces gNB
    # Critical Step       Stop Mirroring And Traces AP
    # Critical Step       Validation SA Cplane Attach 2558-C
    Critical Step       Validation L2L1 SA Attach 2558-C

TC 2558-C SA Traffic DL UL
    [Documentation]     Generic test for SA traffic with PRB blanking
    [Arguments]         ${param}

    Init Sequence       ${param}

    Critical Step       Commission SCF From Config Folder
    Critical Step       Restart TL
    Run Keyword If      not ${isAic}
    ...      Step       Lock_Unused_Cells
    Critical Step       CallSetup.Setup Wtsemu SA    nbCell=1
    Critical Step       Check AP Cell Setup Is Completed
    Critical Step       CallSetup.UE Register
    Critical step       CallSetup.Launch PDU Session
    # Critical Step       Start Mirroring And Traces AP
    Critical Step       Start Mirroring And Traces gNB
    Critical Step       Start DL traffic SA
    Critical Step       Start UL traffic SA
    Critical Step       Stop Mirroring And Traces gNB
    # Critical Step       Stop Mirroring And Traces AP
    Critical Step       Validation L2L1 2558-C If TRS Muting SA

TC 2558-C SA Traffic DL UL VR
    [Documentation]     Generic test for SA traffic with PRB blanking
    [Arguments]         ${param}

    Init Sequence       ${param}
    Critical Step       Set MRBTSID and NRBTSID 2558-C
    Critical Step       Setup AP IPHY Vran
    Critical Step       Setup WTS CFG Vran
    Critical Step       Setup SCF Vran
    Critical Step       Restart TL
    # Critical Step       CallSetup.Setup Wtsemu SA    nbCell=${FDD_SA_Cell_nb}
    Critical Step       CallSetup.Setup Wtsemu SA
    #vbo#comment for debugging#Critical Step       Check AP Cell Setup Is Completed
    # Critical Step       UE Setup With Capa
    Critical Step       CallSetup.UE Register
    Critical step       CallSetup.Launch PDU Session
    Critical Step       Start DL traffic SA
    Critical Step       Start UL traffic SA

Initialisation Variables 2558-C SA 15MHz Low Edge Max
    [Documentation]   All global variables needed for the checks in L2L1. Variables are set according to the number of blanking PRB configuration.
    ...    nbrOfBlankedPRBsHighEdgeDL=0
    ...    nbrOfBlankedPRBsHighEdgeUL=0
    ...    nbrOfBlankedPRBsLowEdgeDL=26
    ...    nbrOfBlankedPRBsLowEdgeUL=26
    [Arguments]    ${param}
    Dated Log New Line     [Initialisation Variables for TC: 2558-C SA 15MHz Low Edge Max]
    ${total_prb_bw}   Set Variable If      '${param.chBwDl}' == '10MHz'    52
    ...                                    '${param.chBwDl}' == '15MHz'    79
    ...                                    '${param.chBwDl}' == '20MHz'    106
    Set Suite Variable    ${total_prb_bw}
    Dated Log    -----> Bandwidth is ${param.chBwDl} and the total of PRB available in BW is ${total_prb_bw}.\n
    #blanking area location acording to nbrOfBlankedPRBsLowEdge and nbrOfBlankedPRBsHighEdge
    ${blanking_area_crb_low}       Evaluate      ${param.nbrOfBlankedPRBsLowEdgeDL}-1
    ${blanking_area_crb_high}      Evaluate      ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeDL}
    Set Suite Variable     ${blanking_area_crb_low}
    Set Suite Variable     ${blanking_area_crb_high}
    Dated Log    -----> Blanking area: [crb0<xxxxxxxxx>crb${blanking_area_crb_low}<--BW-->crb${blanking_area_crb_high}].Shall not be used !
    #Overlapping TC or not. No overlap allowed in SA
    Set Suite Variable     ${IsOverlapping}     False
    # For CSI RS for measurment and tracking (TRS)
    # From SPEC : set to 4*ROUNDUP(offsetPrbDl/4). For OffsetPrbDl see [5G_RAN_CP_36783]
    # From SPEC see [5G_RAN_CP_11056]
    ${csi_rs_size}        Set Variable If     '${param.chBwDl}' == '10MHz'    52
    ...                                       '${param.chBwDl}' == '15MHz'    80
    ...                                       '${param.chBwDl}' == '20MHz'    108
    Set Suite Variable    ${csi_rs_size}
    ${trs_size}    Set Variable If
    ...            '${param.trsMutingInBlankedPRBsEnabled}' == 'true'     ${blanking_area_crb_high}
    ...            '${param.trsMutingInBlankedPRBsEnabled}' == 'false'    ${csi_rs_size}
    Set Suite Variable   ${trs_size}

    #RAT0 allocation for PDSCH
    #From SPEC: In case of blanking. All RBGs containing at least one blanked PRB are excluded from PDSCH scheduling
    Set Suite Variable    ${rat0_start}     ${32}
    Set Suite Variable    ${rat0_end}       ${79}
    Set Suite Variable    ${rat0_size}      ${47}
    #RAT1 allocation for PUSCH and pdsch for msg2.
    #From SPEC: Blanked PRB are excluded from PUSCH scheduling
    Set Suite Variable        ${rat1_start}     ${param.nbrOfBlankedPRBsLowEdgeUL}
    ${rat1_end}    Evaluate   ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeUL}-1
    Set Suite Variable        ${rat1_end}
    #PDCCH
    Set Suite Variable    ${l1l2_coreset0}        0x07f8000000000000
    Set Suite Variable    ${l1l2_coreset_init}    ${l1l2_coreset0}
    Set Suite Variable    ${l1l2_coreset_dedi}    ${l1l2_coreset0}
    #Msg 1
    ${prach_prb_offset}     Evaluate    ${param.StartUl}+${param.msg1FrequencyStart}
    Set Suite Variable    ${prach_prb_offset}
    #SRS Configuration : 5G_RAN_CP_36175
    ${available_ul_prb}    Evaluate             ${total_prb_bw}-${param.nbrOfBlankedPRBsLowEdgeUL}-${param.nbrOfBlankedPRBsHighEdgeUL}
    ${c_srs}               Set Variable If     ${available_ul_prb} < ${24}    1
    ...                                        ${available_ul_prb} >= ${24} and ${available_ul_prb} < ${32}     7
    ...                                        ${available_ul_prb} >= ${32} and ${available_ul_prb} < ${52}     9
    ...                                        ${available_ul_prb} >= ${52} and ${available_ul_prb} < ${79}     14
    ...                                        ${available_ul_prb} >= ${79} and ${available_ul_prb} < ${106}    20
    ...                                        ${available_ul_prb} == ${106}    9
    Set Suite Variable    ${freq_pos}     ${0}
    Set Suite Variable    ${freq_shift}   ${prach_prb_offset}
    Set Suite Variable    ${c_srs}
    Set Suite Variable    ${b_srs}        ${0}
    Set Suite Variable    ${b_hop}        ${0}

Initialisation Variables 2558-C SA 20MHz Both Edge Max
    [Documentation]   All global variables needed for the checks in L2L1. Variables are set according to the number of blanking PRB configuration.
    ...    nbrOfBlankedPRBsHighEdgeDL=12
    ...    nbrOfBlankedPRBsHighEdgeUL=12
    ...    nbrOfBlankedPRBsLowEdgeDL=14
    ...    nbrOfBlankedPRBsLowEdgeUL=14
    [Arguments]    ${param}
    Dated Log New Line     [Initialisation Variables for TC: 2558-C SA 20MHz Both Edge Max]
    ${total_prb_bw}   Set Variable If      '${param.chBwDl}' == '10MHz'    52
    ...                                    '${param.chBwDl}' == '15MHz'    79
    ...                                    '${param.chBwDl}' == '20MHz'    106
    Set Suite Variable    ${total_prb_bw}
    Dated Log    -----> Bandwidth is ${param.chBwDl} and the total of PRB available in BW is ${total_prb_bw}.\n
    #blanking area location acording to nbrOfBlankedPRBsLowEdge and nbrOfBlankedPRBsHighEdge
    ${blanking_area_crb_low}       Evaluate      ${param.nbrOfBlankedPRBsLowEdgeDL}-1
    ${blanking_area_crb_high}      Evaluate      ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeDL}
    Set Suite Variable     ${blanking_area_crb_low}
    Set Suite Variable     ${blanking_area_crb_high}
    Dated Log    -----> Blanking area location:[crb0<xxx>crb${blanking_area_crb_low}<--BW-->crb${blanking_area_crb_high}<xxx>crb${total_prb_bw}(-1)]
    #Overlapping TC or not. No overlap allowed in SA
    Set Suite Variable     ${IsOverlapping}     False
    # For CSI RS for measurment and tracking (TRS)
    # From SPEC : set to 4*ROUNDUP(offsetPrbDl/4). For OffsetPrbDl see [5G_RAN_CP_36783]
    # From SPEC see [5G_RAN_CP_11056]
    ${csi_rs_size}        Set Variable If     '${param.chBwDl}' == '10MHz'    52
    ...                                       '${param.chBwDl}' == '15MHz'    80
    ...                                       '${param.chBwDl}' == '20MHz'    108
    Set Suite Variable    ${csi_rs_size}
    ${trs_size}    Set Variable If
    ...            '${param.trsMutingInBlankedPRBsEnabled}' == 'true'     ${blanking_area_crb_high}
    ...            '${param.trsMutingInBlankedPRBsEnabled}' == 'false'    ${csi_rs_size}
    Set Suite Variable   ${trs_size}

    #RAT0 allocation for PDSCH
    #From SPEC: In case of blanking. All RBGs containing at least one blanked PRB are excluded from PDSCH scheduling
    Set Suite Variable    ${rat0_start}     ${16}
    Set Suite Variable    ${rat0_end}       ${87}
    Set Suite Variable    ${rat0_size}      ${72}
    #RAT1 allocation for PUSCH and pdsch for msg2.
    #From SPEC: Blanked PRB are excluded from PUSCH scheduling
    Set Suite Variable        ${rat1_start}     ${param.nbrOfBlankedPRBsLowEdgeUL}
    ${rat1_end}    Evaluate   ${total_prb_bw}-${param.nbrOfBlankedPRBsHighEdgeUL}-1
    Set Suite Variable        ${rat1_end}
    #PDCCH
    Set Suite Variable    ${l1l2_coreset0}        0x07f8000000000000
    Set Suite Variable    ${l1l2_coreset_init}    ${l1l2_coreset0}
    Set Suite Variable    ${l1l2_coreset_dedi}    ${l1l2_coreset0}
    #Msg 1
    ${prach_prb_offset}     Evaluate    ${param.StartUl}+${param.msg1FrequencyStart}
    Set Suite Variable    ${prach_prb_offset}
    #SRS Configuration : 5G_RAN_CP_36175
    ${available_ul_prb}    Evaluate             ${total_prb_bw}-${param.nbrOfBlankedPRBsLowEdgeUL}-${param.nbrOfBlankedPRBsHighEdgeUL}
    ${c_srs}               Set Variable If     ${available_ul_prb} < ${24}    1
    ...                                        ${available_ul_prb} >= ${24} and ${available_ul_prb} < ${32}     7
    ...                                        ${available_ul_prb} >= ${32} and ${available_ul_prb} < ${52}     9
    ...                                        ${available_ul_prb} >= ${52} and ${available_ul_prb} < ${79}     14
    ...                                        ${available_ul_prb} >= ${79} and ${available_ul_prb} < ${106}    20
    ...                                        ${available_ul_prb} == ${106}    9
    Set Suite Variable    ${freq_pos}     ${0}
    Set Suite Variable    ${freq_shift}   ${prach_prb_offset}
    Set Suite Variable    ${c_srs}
    Set Suite Variable    ${b_srs}        ${0}
    Set Suite Variable    ${b_hop}        ${0}

Setup SCF Vran
    Dated Log       ====== Setup SCF Vran ======
    ${SCF_PATH_2558_DU}              OAM Get SCF File                oam=${GNB_DU.oam}        file=SCF_Setup_2558_DU.xml
    ${SCF_PATH_2558_CU}              OAM Get CU SCF File             file=SCF_Setup_2558_CU.xml
    Set Suite Variable              ${SCF_PATH_2558_DU}
    Set Suite Variable              ${SCF_PATH_2558_CU}
    SCF StartSession                scf_file=${SCF_PATH_2558_DU}     second_scf_file=${SCF_PATH_2558_CU}

    # vDu params config
    SCF Set element                 dist_name=${nrcell_dist_name}
    ...                             element_name=gscnOrSsPbchArfcn
    ...                             element_value=${param.gscn}
    ...                             aicListEntity=vdu    scope=both    bestEffort=${True}
    SCF Set element                 dist_name=${nrcell_dist_name}
    ...                             element_name=msg1FrequencyStart
    ...                             element_value=${param.msg1FrequencyStart}
    ...                             aicListEntity=vdu    scope=both    bestEffort=${True}
    SCF Set element                 dist_name=${nrcell_dist_name}
    ...                             element_name=dmrsTypeAPosition
    ...                             element_value=${param.dmrsTypeAPosition}
    ...                             aicListEntity=vdu    scope=both    bestEffort=${True}

    SCF Remove list                 dist_name=${bwp4_dist_name}    list_name=locationAndBandwidthUl
    ...                             aicListEntity=vdu    scope=both
    SCF Add list                    dist_name=${bwp4_dist_name}    list_name=locationAndBandwidthUl
    ...                             aicListEntity=vdu    scope=both
    &{locationAndBandwidthUl}       Create Dictionary
    ...                             cRbSizeUl=n80
    ...                             cRbStartUl=crb14
    SCF Add items to list           dist_name=${bwp4_dist_name}    list_name=locationAndBandwidthUl
    ...                             elements=&{locationAndBandwidthUl}
    ...                             aicListEntity=vdu    scope=both

    # vDu & vCu common params config
    SCF Set element                 dist_name=${nrcell_dist_name}
    ...                             element_name=freqBandIndicatorNR
    ...                             element_value=${param.freqBandIndicatorNR}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${nrcell_fdd_ch_dist_name}
    ...                             element_name=nrarfcnDl
    ...                             element_value=${param.nrarfcnDl}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${nrcell_fdd_ch_dist_name}
    ...                             element_name=nrarfcnUl
    ...                             element_value=${param.nrarfcnUl}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${nrcell_dist_name}
    ...                             element_name=actPRBBlanking
    ...                             element_value=${param.actPRBBlanking}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${nrcell_dist_name}
    ...                             element_name=nbrOfBlankedPRBsLowEdgeDL
    ...                             element_value=${param.nbrOfBlankedPRBsLowEdgeDL}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${nrcell_dist_name}
    ...                             element_name=nbrOfBlankedPRBsLowEdgeUL
    ...                             element_value=${param.nbrOfBlankedPRBsLowEdgeUL}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${nrcell_dist_name}
    ...                             element_name=nbrOfBlankedPRBsHighEdgeDL
    ...                             element_value=${param.nbrOfBlankedPRBsHighEdgeDL}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF Set element                 dist_name=${nrcell_dist_name}
    ...                             element_name=nbrOfBlankedPRBsHighEdgeUL
    ...                             element_value=${param.nbrOfBlankedPRBsHighEdgeUL}
    ...                             aicListEntity=vduvcu    scope=both    bestEffort=${True}

    SCF StopSession                 scf_file=${SCF_PATH_2558_DU}     second_scf_file=${SCF_PATH_2558_CU}
    Dated Log                         Modifications completed.\n
    Oam.OAM Perform Full Commissioning          scf_file=${SCF_PATH_2558_DU}
    Run Keyword If                 ${isAic}
    ...                            Oam.OAM Perform Full Commissioning    scf_file=${SCF_PATH_2558_CU}    oam=${GNB_CU.oam}

    Run keyword if                  ${isAic}
    ...                             Wait Vcu And Vdu Available

    Run Keyword If                  not ${isAic}
    ...                             WA Airscale Wait For Ready              ${GNB_DU}



Setup AP IPHY Vran
    ${1st_FDD_cell_id}                      Set Variable    ${FDD_Cell_list[0].nrCellId}

    Dated Log       ====== Setup AP IPHY Vran, modif in cell ${1st_FDD_cell_id}, to set gscn to be : ${param.gscn} ======
    WtsXmlConfig.startSession       file=iphy
    WtsXmlConfig.setTextUsingIndex    path=//GSCN    val=${param.gscn}    idx=${1st_FDD_cell_id}
    WtsXmlConfig.stopSession        file=iphy


Setup WTS CFG Vran
    ${1st_FDD_cell_id}                      Set Variable    ${FDD_Cell_list[0].nrCellId}
    ${1st_FDD_cell_SA_ue_param_id}          Set Variable    51

    Dated Log       ====== Setup WTS CFG Vran, modif in cell ${1st_FDD_cell_id} :  ======
    WtsCfgConfig.startSession
    ${oldValue}          getParam           prefix=set_cell id=${1st_FDD_cell_id}         param=nr_arfcn
    replaceValue         prefix=set_cell id=${1st_FDD_cell_id}
    ...                  param=nr_arfcn
    ...                  oldValue=${oldValue}
    ...                  newValue=${param.nrarfcnUl}:${param.nrarfcnDl}
    Dated log            Basic file arfcn value changed for Cell-${1st_FDD_cell_id} from ${oldValue} --> ${param.nrarfcnUl}:${param.nrarfcnDl}

    #vbo#not needed for FDD#${oldValue}          getParam           prefix=set_cell id=${1st_FDD_cell_id}         param=gscn
    #vbo#not needed for FDD#replaceValue         prefix=set_cell
    #vbo#not needed for FDD#...                  param=gscn
    #vbo#not needed for FDD#...                  oldValue=${oldValue}
    #vbo#not needed for FDD#...                  newValue=${param.gscnOrSsPbchArfcn}
    #vbo#not needed for FDD#Dated log    Basic file gscn value changed for Cell-${1st_FDD_cell_id} from ${oldValue} --> ${param.gscnOrSsPbchArfcn}

    # set ue_nr_capa
    ${oldValue}          getParam           prefix=ue_param id=${1st_FDD_cell_SA_ue_param_id}       param=ue_nr_capabilities
    Dated Log            Basic file ue ${1st_FDD_cell_SA_ue_param_id} ue capa nr original value : ${oldValue}
    replaceValue         prefix=ue_param id=${1st_FDD_cell_SA_ue_param_id}
    ...                  param=ue_nr_capabilities
    ...                  oldValue=${oldValue}
    ...                  newValue=${param.ue_nr_capa}
    Dated Log            Basic file ue ${1st_FDD_cell_SA_ue_param_id} nr capa from ${oldValue} --> ${param.ue_nr_capa}

    WtsCfgConfig.stopSession         rename=modified


Validation SA Cplane Attach 2558-C
    Dated Log    [Validating CPlane configuration in L3L2]
    ${pdml_l3l2}    Generate Pdml From Pcap    pcap_file=${capture_gnb_l3l2.path}
    Check In L3L2 TRS Cell Setup Configuration   pdml_file=${pdml_l3l2}
    Check In L3L2 SRS User Setup        pdml_file=${pdml_l3l2}
    ...    value_shift=${freq_shift}
    ...    value_pos=${freq_pos}
    ...    value_csrs=${c_srs}
    ...    value_bsrs=${b_srs}
    ...    value_bhop=${b_hop}

Validation L2L1 SA Attach 2558-C
    Dated Log    ****************[Validation of SA attach in L2L1]*************
    ${nbr_prach}   Get Number Prach Attempt In L2L1
    Set Suite Variable     ${nbr_prach}
    Check In L2L1 Pdcch Attach Configuration NSA SA
    Check In L2L1 Pdsch Attach Configuration SA
#    Check In L2L1 Pusch Attach Configuration NSA SA
    Check In L2L1 Pucch Attach Configuration NSA SA
    Check In L2L1 Reference Signal Attach Configuration NSA SA
    Dated Log    **********************[Validation completed]*****************

Validation L2L1 2558-C SA Traffic DL
    Dated Log    ****************[Validation of SA DL traffic in L2L1]*************
    Check In L2L1 Pdsch Traffic DL NSA SA
    Run Keyword If     '${param.trsMutingInBlankedPRBsEnabled}' == 'true'
    ...                Check In L2L1 Reference Signal Attach Configuration NSA SA
    Dated Log    **********************[Validation completed]*****************

Validation L2L1 2558-C SA Traffic UL
    Dated Log    ****************[Validation of SA UL traffic in L2L1]*************
    Check In L2L1 Pusch Traffic UL NSA SA
    Dated Log    **********************[Validation completed]*****************

Validation L2L1 2558-C If TRS Muting SA
    Run Keyword If     '${param.trsMutingInBlankedPRBsEnabled}' == 'true'
    ...                Check In L2L1 Reference Signal Attach Configuration NSA SA

UE Setup With Capa
    # ${wts_command}      Set Variable        ue_register id=1 ue_nr_capabilities=${UE_NR_CAPA_20MHz}
    wtsemu.ue_register      id=1       ue_nr_capabilities=${UE_NR_CAPA_20MHz}
    Sleep               1s

Start DL traffic SA
    #SA_keywords_2.Traffic DL SA         rate=2    time=30
    Traffic.Traffic UE DL        ueSetting=${BASIC_UE_SA}   throughput=2     duration=30

Start UL traffic SA
    #SA_keywords_2.Traffic UL SA         rate=2    time=30
    Traffic.Traffic UE UL        ueSetting=${BASIC_UE_SA}   throughput=2     duration=30

