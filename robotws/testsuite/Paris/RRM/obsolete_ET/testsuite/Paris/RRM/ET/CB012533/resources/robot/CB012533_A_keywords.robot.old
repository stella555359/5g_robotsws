*** Keywords ***

CB012533_A_B1_3
    [Documentation]        Test to check that online modification of NIDD Rnd parameters is applied on NRCELL1
    ...                    while UE DL Traffic is on-going .
    [Arguments]            ${param}
    Init Sequence        ${param}
    # STEP               CB012533_A Configuration                                             #  execution duration approximately 5"
    STEP                 Delta commissioning of Json       json_file=${json_scf_CB012533-A}   #  execution duration approximately 3"30
    STEP                 WtsConfiguration of Srs Beam
    Critical Step        Restart TL
    STEP                 CB012533 Setup Mirroring     prefix=CB012533-A_dftBeam_cellsetupreq
    STEP                 CB012533 Start Capture CPRT
    STEP                 Cell Setup
    STEP                 CB012533 Stop Capture CPRT
    STEP                 Check DlSrsBm parameters      ${CAPTURE_CPRT}    ${DlSrsBmConfig}
    ${listOfUes}         Build UEs list SA Multi UEs
    STEP                 SA Attach and Start Traffic Multi UEs       ${param}    ${listOfUes}
    STEP                 CB012533 Setup Mirroring     prefix=CB012533-A_dftBeam_cellreconfigurationreq
    STEP                 CB012533 Start Capture CPRT
    # ymerlin
    # Debugging missing cellreconfigurationreq into CPRT Log (SysLog isDftBeamDiffThresholdHChange=1) when applying online modifications
    # Method 1 :
    # STEP                 Online Modification of DftBeam parameters     # cellreconfigurationreq not triggered
    # Method 2 :
    # STEP                 Delta commissioning of Json     json_file=${json_scf_dftBeamDiffThreshold}  # cellreconfigurationreq triggered
    # Method 3 :
    STEP                 Set dftBeamDiffTreshold Parameters             # cellreconfigurationreq triggered
    STEP                 CB012533 Stop Capture CPRT
    STEP                 Check dftBeamDiffThreshold parameters      ${CAPTURE_CPRT}    ${dftBeamDiffThreshold}
    [Teardown]           Run Keywords       Produce Scout data      AND
    ...                                     GenericTest.Display diagnosis


CB012533_A Configuration
    [Documentation]               Dedicated KW to commission gNB either with delta json file and or online modification
    ...                           1 TDD cell with SRS beam + 1 TDD cell without SRS beam
    [Arguments]
    ${scf_suite_setup_backup}        OAM Get SCF File           file=SCF_Suite_Setup_Backup.xml
    Set Suite Variable               ${scf_suite_setup_backup}
    Dated Log                        Current file ${scf_suite_setup_backup} saved
    ${current_scf}                   String.Replace string    ${scf_suite_setup_backup}    _Suite_Setup_Backup.xml    ${EMPTY}
    ${updated_scf}                   catenate    SEPARATOR=${EMPTY}    ${current_scf}_Modification_on_line_srsForBeamMgmt.xml
    ${std_output}=                   Run    cp ${scf_suite_setup_backup} ${updated_scf}
    SCF StartSession               scf_file=${updated_scf}
    ${dist_name_nrcell}        Set Variable    MRBTS-1/NRBTS-1/NRCELL-1
    &{srsForBeamMgmt}          Create Dictionary
    ...                        bSRS=2
    ...                        comb=comb2
    ...                        cSRS=49
    ...                        srsPowerThresholdForDlBm=-1200
    ...                        srsPowerThresholdForUlBm=-1320
    ...                        srsTypeAllocForDlBm=antenna switching or codebook
    ...                        srsUePeriodicity=slots40

    SCF Set element            dist_name=${dist_name_nrcell}    element_name=actDlSrsBm     element_value=true    scope=Classical
    SCF Set element            dist_name=${dist_name_nrcell}    element_name=actUlSrsBm     element_value=true    scope=Classical
    SCF Remove List            dist_name=${dist_name_nrcell}    list_name=srsForBeamMgmt    scope=Classical
    SCF Add list               dist_name=${dist_name_nrcell}    list_name=srsForBeamMgmt    scope=Classical
    SCF Add items to list      dist_name=${dist_name_nrcell}    list_name=srsForBeamMgmt    elements=&{srsForBeamMgmt}
    ...                        scope=Classical

    &{periodicCsiAcquisition}    Create Dictionary
    ...                          csiReportPeriodicity=slots320
    ...                          csirsNumberWithinReportPeriod_Set1=1
    ...                          csirsPower=3
    ...                          maxCsirsNumber=4
    ...                          scramblingIdStep=3

    SCF Remove List            dist_name=${dist_name_nrcell}    list_name=periodicCsiAcquisition    scope=Classical
    SCF Add list               dist_name=${dist_name_nrcell}    list_name=periodicCsiAcquisition    scope=Classical
    SCF Add items to list      dist_name=${dist_name_nrcell}    list_name=periodicCsiAcquisition    elements=&{periodicCsiAcquisition}
    ...                        scope=Classical
    # SCF Set element in List    dist_name=${dist_name_nrcell}    list_name=periodicCsiAcquisition    element_name=csirsPower    element_value=3
    # If element doesn't exist into Scf, SWENG Automatically add missing object
    SCF Add element    dist_name=${dist_name_nrcell}    element_name=actUeCsirsCoexistCellCsirs      element_value=false    scope=Classical
    SCF Set element    dist_name=${dist_name_nrcell}    element_name=actUeCsirsCoexistCellCsirs      element_value=false    scope=Classical
    SCF Set element    dist_name=${dist_name_nrcell}    element_name=dftBeamDiffThresholdH           element_value=15     scope=Classical
    SCF Set element    dist_name=${dist_name_nrcell}    element_name=dftBeamDiffThresholdV           element_value=15     scope=Classical
    SCF Set element    dist_name=${dist_name_nrcell}    element_name=dlMimoMode           element_value=8x4 Closed Loop Spatial Multiplexing
    SCF Set element    dist_name=${dist_name_nrcell}    element_name=mMimoAntArrayMode    element_value=Full 64TRX Array (4x8x2)
    SCF StopSession                             scf_file=${updated_scf}
    OAM Perform Full Commissioning              scf_file=${updated_scf}
    OAM wait available
    ${scf_delta_configuration}     OAM Get SCF File         file=CB012533-A_Scf_srsForBeamMgmt_Online_Modification.xml

WtsConfiguration of Srs Beam
    [Documentation]
    WtsCfgConfig.startSession
    ${line}             getIndexUsingParam   prefix=uec_param    paramId=id    paramVal=1
    # Add Test Mode Srs beam
    WtsCfgConfig.setConfigLine          configuration=${srs_beam_pos}       line=${line+1}
    WtsCfgConfig.setConfigLine          configuration=${test_mode_srs}      line=${line+2}
    WtsCfgConfig.stopSession            rename=modified
    Modify Field in WtsEmu Cfg File     field=SA_UE_CAPABILITIES_TDD    value=${nr_capas_srs_beam}

Set dftBeamDiffTreshold Parameters
    [Documentation]    Dedicated KW to modify some parameters in the database of the OAM set in arguments
    ${dist_name}       Set Variable    MRBTS-1/NRBTS-1/NRCELL-1
    &{modify_param1}   Create Dictionary
    ...                parameter=dftBeamDiffThresholdH
    ...                dist_name=${dist_name}
    ...                value=30
    &{modify_param2}   Create Dictionary
    ...                parameter=dftBeamDiffThresholdV
    ...                dist_name=${dist_name}
    ...                value=0
    @{modiflist}       Create List
    Append To List     ${modiflist}    ${modify_param1}   ${modify_param2}
    OAM Set Params     ${modiflist}

Delta commissioning of Json
    [Documentation]      Dedicated KW to commission gNB with delta json file
    [Arguments]          ${json_file}
    sbts_coam.connect_to    name=${gnb_alias}
    Run Keywords    coam_parameter.perform_scf_delta_commission    delta_file=${json_file}     connection=${gnb_alias}
    ...    AND
    ...             OAM wait available
    sbts_coam.teardown            connection=${gnb_alias}

Online Modification of DftBeam parameters
    [Documentation]        Dedicated KW to commission gNB by setting parameter into Scf file
    ${scf_suite_setup}     OAM Get SCF File     file=CB012533-A_before_Online_modification_of_DftBeam_params.xml
    Set Suite Variable               ${scf_suite_setup}
    Dated Log                        SCF file = ${scf_suite_setup}
    SCF StartSession               scf_file=${scf_suite_setup}
    ${dist_name}        Set Variable    MRBTS-1/NRBTS-1/NRCELL-1
    # Display current setting of dftBeamDiffTresholdH and dftBeamDiffTresholdV
    ${dftBeamDiffTresholdH}    SCF Get Single Value    dist_name=${dist_name}    p_name=dftBeamDiffThresholdH    scope=Classical
    ${dftBeamDiffTresholdV}    SCF Get Single Value    dist_name=${dist_name}    p_name=dftBeamDiffThresholdV    scope=Classical
    Dated log   dftBeamDiffThresholdH : ${dftBeamDiffTresholdH}
    Dated log   dftBeamDiffThresholdV : ${dftBeamDiffTresholdV}
    Dated Log    Modify on line dftBeamDiffTresholdH and dftBeamDiffTresholdV
    SCF Set element    dist_name=${dist_name}    element_name=dftBeamDiffThresholdH      element_value=30     scope=Classical
    SCF Set element    dist_name=${dist_name}    element_name=dftBeamDiffThresholdV      element_value=0      scope=Classical
    # OAM Set Params
    ${dftBeamDiffTresholdH}    SCF Get Single Value    dist_name=${dist_name}    p_name=dftBeamDiffThresholdH
    ${dftBeamDiffTresholdV}    SCF Get Single Value    dist_name=${dist_name}    p_name=dftBeamDiffThresholdV
    Dated log     dftBeamDiffThresholdH : ${dftBeamDiffTresholdH}
    Dated log     dftBeamDiffThresholdV : ${dftBeamDiffTresholdV}
    SCF StopSession                             scf_file=${scf_suite_setup}
#   OAM Perform Full Commissioning              scf_file=${scf_suite_setup}
#   OAM wait available
    OAM Get SCF File                            file=CB012533-A_SCF_updated_online_modification_of_dftBeamDiffThreshold.xml

Check DlSrsBm parameters
    [Documentation]
    ...     Actions:        Take trace CPRT-L2PS
    ...     Checks:         Check in message l2_ps_cell_cellsetup_req the field dftBeamDiffThresholdV  and dftBeamDiffThresholdH
    ...     Verdict:        Check the value configured after the cell setup
    [Arguments]    ${CAPTURE_CPRT}    ${FieldShowName}
    Dated Log    Checking dftBeamDiffThresholdV and H in itf_l2_ps_cell_cellsetupreq structure
    Dated Log    convert pcap to pdml with filter itf_l2_ps_cell_cellsetupreq/itf_l2_ps_cell_DlSrsBmConfig
    Dated Log    pcap file : ${CAPTURE_CPRT}
    ${pdml}                     analyzer.pcap_to_pdml      ${CAPTURE_CPRT.path}
    ${msg_field}       Set Variable    @{FieldShowName.keys()}
    Dated log new line                 Getting some captured value in itf_l2_ps_cell_DlSrsBmConfig
    FOR     ${Field}   IN           @{msg_field}
            ${Value}          set variable    ${FieldShowName["${Field}"]}
            Dated Log         --- Check ${Field} = ${Value}
            analyzer.check_exists_once     pdmlFile=${pdml}
            ...                            packetName=itf_l2_ps_cell_DlSrsBmConfig
            ...                            path=${Field}
            ...                            value=${Value}
            ...                            kind=showname
            ...                            test=MATCH
    END
    [return]    ${pdml}

Check dftBeamDiffThreshold parameters
    [Documentation]
    ...     Actions:        Take trace CPRT-L2PS
    ...     Verdict:        Check dftBeamDiffThresholdV and dftBeamDiffThresholdH values after procedure of cell reconfiguration request
    [Arguments]    ${CAPTURE_CPRT}    ${FieldShowName}
    Dated Log    Checking dftBeamDiffThresholdV and H in itf_l2_ps_cell_cellreconfigurationreq structure
    Dated Log    convert pcap to pdml with filter itf_l2_ps_cell_cellreconfigurationreq
    Dated Log    pcap file : ${CAPTURE_CPRT}
    ${pdml}                     analyzer.pcap_to_pdml      ${CAPTURE_CPRT.path}
    ${msg_field}       Set Variable    @{FieldShowName.keys()}
    Dated log new line                 Getting some captured value in itf_l2_ps_cell_DlSrsBmConfig
    FOR     ${Field}   IN           @{msg_field}
            ${Value}          set variable    ${FieldShowName["${Field}"]}
            Dated Log         --- Check ${Field} = ${Value}
            analyzer.check_exists_once     pdmlFile=${pdml}
            ...                            packetName=itf_l2_ps_cell_cellreconfigurationreq
            ...                            path=${Field}
            ...                            value=${Value}
            ...                            kind=showname
            ...                            test=MATCH
    END
    [return]    ${pdml}
