Library             OperatingSystem
Library             Collections
Library             DateTime
Library             taf.transport.ssh    WITH NAME    csn
Library             taf.config.scf       WITH NAME    scf
Library             taf.sbts.oam.coam.admin           WITH NAME    coam
Library             taf.lteemu           WITH NAME    lteemu
Library             ute_wtssim           WITH NAME    wts
Library             ../../../resources/python/luashark_tools.py
Library             luashark_tools.analyzer       WITH NAME       analyzer
Library             ../../../../../resources/SWENG/python/StringTool.py
Library             ../../../../../resources/SWENG/python/OsTool.py

Resource             ../../../../../resources/SWENG/robot/Counters.robot
Resource             ../../../../../resources/SWENG/robot/Capture.robot

Resource          ../../../../../resources/SWENG/robot/Connect.robot
Resource          ../../../../../resources/SWENG/robot/Restart.robot




*** Variables ***
${reporting_time_interval}    1
${ru_mode}    NR_Only
${digital_output_rate}     Bitrate_115dot2K
${BB_selector}    0
${PRB_offset}    0
${test_type}    PUSCH
@{Beam_ID}          0
${Digital_out_type}     SerialRs
${FRC_index}    G_FR2_A3_4
${ul_dmrs_mapping_type}    A
${timeout}    5
*** Keywords ***

    # Start Keyword for TCs

CB009222_TDD_test_model_pusch_performance
    [Arguments]           ${param}
    [Documentation]       Test Model for PUSCH Performance
    Set Suite Variable     ${param}
    Init Sequence          ${param}
    Critical Step          Restart TL
    Critical Step          Activate Test dedicated Mode           depends=Restart TL
	Step                   setup Mirroring for BIP capture
    Critical Step          Start Capture CPRT                     depends=Activate Test dedicated Mode
    Step                   Start PUSCH Performance Test           argument=${param}
    Step                   Stop Capture CPRT                      depends=Start Capture CPRT
    Step                   Stop PUSCH Performance Test            argument=${param}
    Step                   Check digitalOutputEnable flag In CpRtCm_StartConformanceTestReq   argument=${param}
    [Teardown]            Teardown TC


CB009222_TDD_test_model_pusch_performance_all_FrcIndex
    [Arguments]           ${param}
    [Documentation]       Test Model for PUSCH Performance
    Set Suite Variable     ${param}
    Init Sequence          ${param}
    Critical Step          Restart TL
    Critical Step          Activate Test dedicated Mode           depends=Restart TL
    Step                   Start PUSCH Performance Test All frcIndex            argument=${param}
    [Teardown]            Teardown TC


Teardown TC
    Dated log           Test ending
    Produce Scout Data
    [Teardown]          GenericTest.Display diagnosis


Teardown If TC Failed
    #vbo#adding message for debugging wo/ other action
    Dated log           Teardown because TC Failed
    Run Keyword If    not ${isAic}    Setup.Get Sos Report

Get Coam Alias
    coam.Connect To   bts_host=${tl.gnbs[0].cu.oam_http_connection_details.addr}   bts_port=3600  name=cOAM
    ${rtId}                         Get Runtime Id
    ${tCellId}                      Set Variable    1
    ${cOAM}                         Set Variable    cOAM
    Set Suite Variable    ${rtId}
    Set Suite Variable    ${tCellId}
    Set Suite Variable    ${cOAM}


Start PUSCH Performance Test
    [Documentation]         Prepare capture CPRT and gNB, start and stop downlink Test
    [Arguments]             ${param}

    coam.Connect To   bts_host=${tl.gnbs[0].cu.oam_http_connection_details.addr}   bts_port=3600  name=cOAM
    ${rtId}                         Get Runtime Id
    ${tCellId}                      Set Variable    1

    ${my_response}=    coam.start_5g_uplink_ccm_test_pusch
    ...                dist_name=/MRBTS-1/RAT-1/RUNTIME_VIEW-${rtId}/MRBTS_R-${rtId}/NRBTS_R-${tCellId}/NRCELL_R-${tCellId}
    ...                interval=${param.reporting_time_interval}
    ...                beam_pattern_id=${Beam_ID}
    ...                ru_mode=${param.RU_mode}
    ...                nrarfcn_ul=${param.nrarfcn}
    ...                nrarfcn_dl=${param.nrarfcn}
    ...                phys_cell_id=${param.phys_cell_id}
    ...                digital_out_type=${param.digital_out_type}
    ...                prb_offset=${param.PRB_offset}
    ...                digital_out_rate=${param.digital_out_rate}
    ...                frc_index=${param.frc_index}
    ...                is_ptrs_fr2_enabled=false
    ...                ul_dmrs_mapping_type=${param.mapping_type}
    ...                digital_output_enable=${param.digital_Output_Enable}
    ...                act_high_speed_cell=${param.Act_high_speed_cell}
    ...                connection=cOAM

