    Should Contain        ${status}    Succeeded


Stop PUSCH Performance Test
    [Documentation]         Prepare capture CPRT and gNB, start and stop downlink Test
    [Arguments]             ${param}
    ${rtId}                         Get Runtime Id
    ${tCellId}                      Set Variable    1
    coam.Connect To   bts_host=${tl.gnbs[0].cu.oam_http_connection_details.addr}   bts_port=3600  name=cOAM
    ${my_response}=    coam.Stop 5g Uplink Ccm Test
    ...                dist_name=/MRBTS-1/RAT-1/RUNTIME_VIEW-${rtId}/MRBTS_R-${rtId}/NRBTS_R-${tCellId}/NRCELL_R-${tCellId}
    ...                connection=cOAM

    Dated Log             Response=:${my_response}

    ${my_result_node}=    Get From Dictionary    ${my_response}        resultNode
    ${my_parameters}=     Get From Dictionary    ${my_result_node}     parameters
    ${status}=            Get From Dictionary    ${my_parameters}      status
    Log to console        ${status}
    Should Contain        ${status}    Succeeded


Check digitalOutputEnable flag In CpRtCm_StartConformanceTestReq
    [Documentation]
    ...     Check the following ramater values in CpRtCm_StartConformanceTestReq
    ...    - harqEnable: digitalOutputEnable value set on WebEm
    ...    - frcIndex: frcIndex value set on WebEm
    ...

    [Arguments]             ${param}
    ...                     ${frc_index}=G_FR1_A3_12
    Dated log                      path: ${CaptureCPRT.path}
    ${pdmlFile}=                   analyzer.pcap_to_pdml           ${CaptureCPRT.path}

    @{msg_field}    Create List     frcIndex
    ...                             harqEnable

    @{listPacketMatch}              Get Packet Match List
    ...                             pdmlFile=${pdmlFile}
    ...                             packetName=itf_l2_ps_tm_cell_startconformancetestreq_t
    ...                             pathList=@{msg_field}

    ${packet}                       set variable                  ${listPacketMatch[0]}

    ${output_frcIndex}              Get Value In Packet Match
    ...                             ${packet}
    ...                             field=frcIndex
    ...                             kind=showname
    Dated log                      output_frcIndex: ${output_frcIndex}
    Should contain                  ${output_frcIndex}        ${frc_index}

    ${output_harqEnable}            Get Value In Packet Match
    ...                             ${packet}
    ...                             field=harqEnable
    ...                             kind=showname

    Dated log                       harqEnable: ${output_harqEnable}
    Should contain                  ${output_harqEnable}        ${param.digital_Output_Enable}



Start PUSCH Performance Test All frcIndex

     [Documentation]
    ...     Check the following ramater values in CpRtCm_StartConformanceTestReq
    ...    - harqEnable: digitalOutputEnable value set on WebEm
    ...    - frcIndex: frcIndex value set on WebEm
    ...

    [Arguments]             ${param}
    FOR     ${frx_index_mode}    IN     @{frc_index_TDD_full_list}
        Dated log                    frx_index_mode: ${frx_index_mode}
        Start Capture CPRT    frc_index}=${frx_index_mode}
        ${param.frc_index}    Set Variable    ${frx_index_mode}
        Start PUSCH Performance Test    ${param}
        Sleep     10
        Stop PUSCH Performance Test    ${param}
        sleep     10
        Stop Capture CPRT
        Check digitalOutputEnable flag In CpRtCm_StartConformanceTestReq     ${param}    frc_index=${frx_index_mode}
    END






setup Mirroring for BIP capture
    [Tags]    ActivateL1L2traces
    ${Capture_BIP_GNB}    Run Keyword If    not ${isAic}
    ...                                     Capture L1L2 Set Upon Config
    ...                               ELSE
    ...                                     Capture L1L2 Set Upon Config        airscale=${GNB_DU}
    ${Capture_BIP_AP}                       Capture L1L2 Set Upon Config        ${AP_DU}
    Run Keyword If    ${isAic}              Capture Init    ${Capture_BIP_GNB}  withTN=True
    set suite variable                      ${Capture_BIP_GNB}
    set suite variable                      ${Capture_BIP_AP}



Start Capture CPRT
     [Arguments]             ${frc_index}=G_FR1_A3_12

    ${CaptureCPRT}                  Capture CPRT Set Upon Config            airscale=${GNB_DU}
    ${CaptureCPRT.filter}           Get Filter For SCTP

    Capture Init    ${CaptureCPRT}
    ${CaptureCPRT.prefix}           set Variable              ${frc_index}

    Capture Start                   ${CaptureCPRT}
    Set Suite Variable              ${CaptureCPRT}

Stop Capture CPRT
    Capture Stop                    ${CaptureCPRT}
