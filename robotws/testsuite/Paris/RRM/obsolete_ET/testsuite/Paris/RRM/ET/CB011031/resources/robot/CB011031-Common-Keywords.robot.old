# Update configuration #

Update gNB swconfig
# Update swconfig.txt in gNB
    ${SherpaVector}=        Create Dictionary      field=0x580117     value=7
    ${modSwconfgnb}=           Create List            ${SherpaVector}
    SetConfig.Set Fields in swconfig DU       param_list=${modSwconfgnb}
    Dated log          Rad Parameters modified:\n ${modSwconfgnb}


Update WTS basic_setup
    [Documentation]
    ...     Conditions:     it needs no conditions
    ...     Actions:        it modifies basic.cfg WTS file for CB011031
    ...     Checks:         it needs no checks
    ...     Verdict:        the parameters of the cells are modified
    [Arguments]             ${allcells_mod}

    WtsCfgConfig.startSession

    FOR    ${cell}    IN    @{allcells_mod}
        ${oldValue}          getParam
        ...                  prefix=set_cell
        ...                  param=nr_arfcn
        ...                  occurrence=${cell.cellnum}
        replaceValue         prefix=set_cell
        ...                  param=nr_arfcn
        ...                  oldValue=${oldValue}
        ...                  newValue=${cell.nr_arfcn}:${cell.nr_arfcn}
        ...                  occurrence=${cell.cellnum}
        #...                  newValue=${testParam.wtsXmlFile.ulNrArfcn}:${testParam.wtsXmlFile.dlNrArfcn}

        ${oldValue}          getParam
        ...                  prefix=set_cell
        ...                  param=gscn
        ...                  occurrence=${cell.cellnum}                       # ${2}
        replaceValue         prefix=set_cell
        ...                  param=gscn
        ...                  oldValue=${oldValue}
        ...                  newValue=${cell.gscn}
        ...                  occurrence=${cell.cellnum}
    END

    WtsCfgConfig.stopSession         rename=modified


Update AP and gNB config
