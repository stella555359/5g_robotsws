# --------------------------------------------------------------------------------------------------------------------------------------------------
# Capture #
Captures Init
    [Documentation]
    ...     Conditions:     it needs no conditions
    ...     Actions:        it configures the parameters to initialize the captures for L1L2, CORE and CPRT
    ...     Checks:         it needs no checks
    ...     Verdict:        the parameters for the captures are initialized

    ${capture_l1l2}=                            Capture L1L2 Set Upon Config    airscale=${GNB_DU}
    ${capture_core}=    Run Keyword If    ${isAic}
    ...                                         Capture CORE Set Upon Config    airscale=${GNB_CU}
    ...                            ELSE         Capture CORE Set Upon Config    airscale=${GNB_DU}
    ${capture_cprt}=                            Capture CPRT Set Upon Config    airscale=${GNB_DU}
    Capture Init                                ${capture_l1l2}    #withTN=True
    Capture Init                                ${capture_core}    #withTN=True
    Capture Init                                ${capture_cprt}    #withTN=True
    Set Suite Variable                          ${capture_l1l2}
    Set Suite Variable                          ${capture_core}
    Set Suite Variable                          ${capture_cprt}




Captures Start
    [Documentation]
    ...     Conditions:     it is based on the arguments ${action_core} ${action_cprt} ${action_l1l2}
    ...     Actions:        it starts the captures for L1L2 and/or CORE and/or CPRT depends on an argument
    ...     Checks:         it needs no checks
    ...     Verdict:        the captures are started
    [Arguments]             ${action_core}=${False}    # Capture CORE is not started by default
    ...                     ${action_cprt}=${False}    # Capture CPRT is not started by default
    ...                     ${action_l1l2}=${False}    # Capture L1L2 is not started by default

    Run Keyword If    ${action_core}            Capture Start    capture=${capture_core}
    Run Keyword If    ${action_cprt}            Capture Start    capture=${capture_cprt}
    Run Keyword If    ${action_l1l2}            Capture Start    capture=${capture_l1l2}


Captures Stop
    [Documentation]
    ...     Conditions:     it is based on the arguments ${action_core} ${action_cprt} ${action_l1l2}
    ...     Actions:        it stops the captures for L1L2 and/or CORE and/or CPRT depending on an argument
    ...     Checks:         it needs no checks
    ...     Verdict:        the captures are stopped
    [Arguments]             ${action_core}=${True}     # Capture CORE is stopped by default
    ...                     ${action_cprt}=${True}     # Capture CPRT is stopped by default
    ...                     ${action_l1l2}=${True}     # Capture L1L2 is stopped by default

    Run Keyword If    ${action_l1l2}    Run Keywords    Capture Stop    capture=${capture_l1l2}
    ...    AND                                  Dated Log           capture_l1l2= ${capture_l1l2}
    Run Keyword If    ${action_core}            Capture Stop    capture=${capture_core}
    Run Keyword If    ${action_cprt}            Capture Stop    capture=${capture_cprt}

# --------------------------------------------------------------------------------------------------------------------------------------------------
# Analyze pcap and pdml

CB011031 Create Filter Message List L1L2
    [Documentation]
    ...     Conditions:
    ...     Actions:
    ...     Checks:
    ...     Verdict:

    # dictionaries for message definition
    ${dict_filter_1}=    Create Dictionary    message_filter=dldata_ssblocksendreql1sw    filter_name=_dldata_ssblocksendreql1sw
    ${dict_filter_2}=    Create Dictionary    message_filter=dldata_pdschpayloadtbsendreql1sw or dldata_pdschsendreql1sw
    ...                                       filter_name=_dldata_pdschpayloadtbsendreql1sw
    ${dict_filter_3}=    Create Dictionary    message_filter=dldata_csirssendreql1sw    filter_name=_dldata_csirssendreql1sw
    #${dict_no_filter}=                          Create Dictionary    message_filter=${EMPTY}    filter_name=_no_filter
    # list of messages for filtering
    ${list_filters_messages}=                   Create List    ${dict_filter_1}
    ...                                                        ${dict_filter_2}
    ...                                                        ${dict_filter_3}
    #...                                                        ${dict_no_filter}
    [Return]    ${list_filters_messages}


CB011031 Analyze pcap and pdml
    [Documentation]
    ...     Conditions:
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${pcap_file}    # input filename for analysing
    ...                     ${list_message_filter}

    Dated Log                                   ===> Analyze pcap and pdml of ${pcap_file}
    Dated Log                                   ===> list of messages before filtering: ${list_message_filter}
    FOR    ${current_elem}    IN    @{list_message_filter}
        # current_elem.message_filter
        Dated Log                               ===> filtering and pdml generation for ${current_elem.message_filter}
        ${pcap_file_filtered}=                  analyzer.filter_pcap    pcapInFile=${pcap_file}
        ...			                                                filterName=${current_elem.filter_name}
        ...			                                                filterExp=${current_elem.message_filter}
        Set To Dictionary                       ${current_elem}    pcap_file_filtered    ${pcap_file_filtered}
        ${pdml_file_result}                     analyzer.pcap_to_pdml    ${pcap_file_filtered}
        Set To Dictionary                       ${current_elem}    pdml_file_result    ${pdml_file_result}
    END
    # THQ ajout du pcap pas filtre
    ${pdml_file_total_result}                   analyzer.pcap_to_pdml    ${pcap_file}
    ${dict_total_pcap}    Create Dictionary     pdml_file_total_result=${pdml_file_total_result}
    Append To List    ${list_message_filter}    ${dict_total_pcap}
    Dated Log                                   ===> list of messages AFTER filtering: ${list_message_filter}


Create Packet Dictionary
    [Documentation]
    ...     Conditions:
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${packet_str}

    ${packet_str_splitted}=                     Split String    ${packet_str}    separator=${SPACE}
    ${packet_nb_elem}=                          Get Length    ${packet_str_splitted}
    ${packet_dict}=                             Create Dictionary
    FOR    ${iteration}    IN RANGE    0    ${packet_nb_elem}
        ${packet_param}=                        Get From List    ${packet_str_splitted}    ${iteration}
        ${packet_param_splitted}=               Split String    ${packet_param}    separator==
        Set To Dictionary    ${packet_dict}    ${packet_param_splitted[0]}    ${packet_param_splitted[1]}
    END
    [Return]    ${packet_dict}


# --------------------------------------------------------------------------------------------------------------------------------------------------
# Verifications in messages

Check dlData ssblocksendreq slot
    [Documentation]
    ...     Conditions:
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${pdml_file}        # input filename for analysing
    ...                     ${fields}           # input fields to filter before checking
    ...                     ${subcellid}
    ...                     ${expblck}
    ...                     ${packet_end}=-1    # -1 is the default value for parsing all packets
    ...                     ${packet_name}=dldata_ssblocksendreql1sw

    Dated Log New Line                          ===> checks in dlData_ssblocksendreq for cell1
    @{listPacketMatch}                          Get Packet Match List    pdmlFile=${pdml_file}
        ...                                                         packetName=${packet_name}
        ...                                                         pathList=@{fields}
        ...                                                         startPacket=${1}
        ...                                                         endPacket=${${packet_end}}    #check done among the first packet_end packets
        ...                                                         filter='subcellid$'==${subcellid}
    ${nbOfPacketFound}=                         get length    ${listPacketMatch}
    Dated Log                                   ===> number of packet ${packet_name} with subcellid=${subcellid} is ${nbOfPacketFound}
    Should Be True                              ${nbOfPacketFound} != 0

    ${nb_match}                                 Set Variable    0
    FOR    ${current_packet}    IN    @{listPacketMatch}
        ${packet_str}=                          Packet Match to Str    packetMatch=${current_packet}    fields=${fields}
        ${packet_dict}=                         Create Packet Dictionary    packet_str=${packet_str}
        ${sfn_found}=                           Get From Dictionary    ${packet_dict}    sfn
        ${sfnrem_found}=                        Evaluate    ${sfn_found} % ${expblck.sfnmod}
        ${slot_found}=                          Get From Dictionary    ${packet_dict}    slot
        ${pos_found_OK}=                        Set Variable    (${slot_found} == ${expblck.slot} and ${sfnrem_found} == ${expblck.sfnrem})
        ${actSsb_found}=                        Get From Dictionary    ${packet_dict}    activeSsBlocks
        ${thrLsb_found}=                        Get From Dictionary    ${packet_dict}    threeLsbSsbIndex
        ${nb_match}=    Run Keyword If    ${pos_found_OK} and ${actSsb_found}==${expblck.actSsb} and ${thrLsb_found}==${expblck.thrLsb}
        ...                                 Evaluate    ${nb_match} + 1
        ...                         ELSE    Evaluate    ${nb_match} + 0    # THQ Bidouille pour robot
    END

    Dated Log    ===> ${nb_match} packets match the expected checks on SSB among the ${nbOfPacketFound} packets
    Should Be True                              ${nb_match} == ${nbOfPacketFound}


Check SIB1
    [Documentation]
    ...     Conditions:
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${pdml_file}        # input filename for analysing
    ...                     ${fields}           # input fields to filter before checking
    ...                     ${subcellid}
    ...                     ${expsib}
    ...                     ${packet_end}=-1    # -1 is the default value for parsing all packets
    ...                     ${packet_name}=dldata_pdschpayloadtbsendreql1sw

    Dated Log New Line                          ===> checks in SIB1 for cell1
    @{listPacketMatch}                          Get Packet Match List    pdmlFile=${pdml_file}
        ...                                                packetName=${packet_name}
        ...                                                pathList=@{fields}
        ...                                                startPacket=${1}
        ...                                                endPacket=${${packet_end}}    #check done among the first packet_end packets
        ...                                                filter='subcellid$'==${subcellid}     # THQ and 'c1$'==systeminformationBlockType1
    ${nbOfPacketFound}=                         get length    ${listPacketMatch}
    Dated Log                                   ===> number of packet ${packet_name} with subcellid=${subcellid} and SIB1 is ${nbOfPacketFound}
    Should Be True                              ${nbOfPacketFound} != 0

    ${nb_match}                                 Set Variable    0
    ${nb_wrong}                                 Set Variable    0

    FOR    ${current_packet}    IN    @{listPacketMatch}
        ${slot_found}                           Set Variable    255
        ${packet_str}=                          Packet Match to Str    packetMatch=${current_packet}    fields=${fields}
        ${packet_dict}=                         Create Packet Dictionary    packet_str=${packet_str}
        ${sfn_found}=                           Get From Dictionary    ${packet_dict}    sfn
        ${sfnrem_found}=                        Evaluate    ${sfn_found} % ${expsib.sfnmod}
        ${slot_found}=                          Get From Dictionary    ${packet_dict}    slot
        ${inOneGroup_found}=    Run Keyword If    ${slot_found} == ${expsib.slot}
        ...                                       Get From Dictionary    ${packet_dict}    inOneGroup
        ...                                  ELSE    Set Variable    0
        ${chk_found_OK}                         Set Variable    (${sfnrem_found}==${expsib.sfnrem} and ${inOneGroup_found}==${expsib.inOneGroup})
        ${chk_found_KO}                         Set Variable    (${sfnrem_found}!=${expsib.sfnrem} or ${inOneGroup_found}!=${expsib.inOneGroup})
        ${nb_match}=    Run Keyword If    ${slot_found} == ${expsib.slot} and ${chk_found_OK}
        ...                                 Evaluate    ${nb_match} + 1
        ...                         ELSE    Evaluate    ${nb_match} + 0    # THQ Bidouille pour robot
        ${nb_wrong}=    Run Keyword If    ${slot_found} == ${expsib.slot} and ${chk_found_KO}
        ...                                 Evaluate    ${nb_wrong} + 1
        ...                         ELSE    Evaluate    ${nb_wrong} + 0    # THQ Bidouille pour robot
    END

    # THQ check en l'absence de call
    Dated Log    ===> ${nb_match} packets match the expected checks on SIB1 among the ${nbOfPacketFound} packets
    Should Be True                              ${nb_match} != 0 and ${nb_wrong} == 0


Check OSI
    [Documentation]
    ...     Conditions:
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${pdml_file}        # input filename for analysing
    ...                     ${fields}           # input fields to filter before checking
    ...                     ${subcellid}
    ...                     ${expsib}
    ...                     ${packet_end}=-1    # -1 is the default value for parsing all packets
    ...                     ${packet_name}=dldata_pdschpayloadtbsendreql1sw

    Dated Log New Line                          ===> checks in ${fields[3]} for cell1
    # ${sib}                                      Set Variable    sib-TypeAndInfo item
    @{listPacketMatch}                          Get Packet Match List    pdmlFile=${pdml_file}
        ...                                                         packetName=${packet_name}
        ...                                                         pathList=@{fields}
        ...                                                         startPacket=${1}
        ...                                                         endPacket=${${packet_end}}    #check done among the first packet_end packets
        ...                                                         filter='subcellid$'==${subcellid}     # THQ and '${sib}$'==${fields[3]}
    ${nbOfPacketFound}=                         get length    ${listPacketMatch}
    Dated Log                              ===> number of packet ${packet_name} with subcellid=${subcellid} and ${fields[3]} is ${nbOfPacketFound}
    Should Be True                              ${nbOfPacketFound} != 0

    ${nb_match}                                 Set Variable    0
    ${nb_wrong}                                 Set Variable    0

    FOR    ${current_packet}    IN    @{listPacketMatch}
        ${slot_found}                           Set Variable    255
        ${sfnrem_found}                         Set Variable    255
        ${packet_str}=                          Packet Match to Str    packetMatch=${current_packet}    fields=${fields}
        ${packet_dict}=                         Create Packet Dictionary    packet_str=${packet_str}
        ${sfn_found}=                           Get From Dictionary    ${packet_dict}    sfn
        ${sfnrem_found}=                        Evaluate    ${sfn_found} % ${expsib.sfnmod}
        ${slot_found}=                          Get From Dictionary    ${packet_dict}    slot
        ${slot_found_OK}                        Set Variable    (${slot_found} == ${expsib.slot0} or ${slot_found} == ${expsib.slot1})
        ${mediumBitmap_found}=    Run Keyword If    ${slot_found_OK} and ${sfnrem_found} == ${expsib.sfnrem}
        ...                                           Get From Dictionary    ${packet_dict}    mediumBitmap
        ...                                   ELSE    Set Variable    0
        ${nb_match}=    Run Keyword If    ${slot_found_OK} and ${sfnrem_found}==${expsib.sfnrem} and ${mediumBitmap_found}==${expsib.mediumBitmap}
        ...                                 Evaluate    ${nb_match} + 1
        ...                         ELSE    Evaluate    ${nb_match} + 0    # THQ Bidouille pour robot
        ${nb_wrong}=    Run Keyword If    ${slot_found_OK} and ${sfnrem_found}==${expsib.sfnrem} and ${mediumBitmap_found}!=${expsib.mediumBitmap}
        ...                                 Evaluate    ${nb_wrong} + 1
        ...                         ELSE    Evaluate    ${nb_wrong} + 0    # THQ Bidouille pour robot
    END

    # THQ check en l'absence de call
    Dated Log    ===> ${nb_match} packets match the expected checks on ${fields[3]} among the ${nbOfPacketFound} packets
    Should Be True                              ${nb_match} != 0 and ${nb_wrong} == 0


Check dlData csirssendreq
    [Documentation]
    ...     Conditions:
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${pdml_file}        # input filename for analysing
    ...                     ${fields}           # input fields to filter before checking
    ...                     ${subcellid}
    ...                     ${expcsirs}
    ...                     ${packet_end}=-1    # -1 is the default value for parsing all packets
    ...                     ${packet_name}=dldata_csirssendreql1sw

    Dated Log New Line                          ===> checks in dlData_csirssendreq for cell1

    @{listPacketMatch}                          Get Packet Match List    pdmlFile=${pdml_file}
        ...                                                         packetName=${packet_name}
        ...                                                         pathList=@{fields}
        ...                                                         startPacket=${1}
        ...                                                         endPacket=${${packet_end}}    #check done among the first packet_end packets
        ...                                                         filter='subcellid$'==${subcellid}     # THQ and '${fields[3]}$'
    ${nbOfPacketFound}=                         get length    ${listPacketMatch}
    Dated Log                                   ===> number of packet ${packet_name} with subcellid=${subcellid} is ${nbOfPacketFound}
    Should Be True                              ${nbOfPacketFound} != 0

    ${nb_match}                                 Set Variable    0

    FOR    ${current_packet}    IN    @{listPacketMatch}
        ${slot_found}                           Set Variable    255
        ${startSymbol_found}                    Set Variable    255
        ${startPrb_found}                       Set Variable    255
        ${packet_str}=                          Packet Match to Str    packetMatch=${current_packet}    fields=${fields}
        ${packet_dict}=                         Create Packet Dictionary    packet_str=${packet_str}
        # THQ    ${sfn_found}=                           Get From Dictionary    ${packet_dict}    sfn
        ${slot_found}=                          Get From Dictionary    ${packet_dict}    slot
        ${startSymbol_found}=                   Get From Dictionary    ${packet_dict}    startSymbol
        ${startPrb_found}=                      Get From Dictionary    ${packet_dict}    startPrb
        ${slot_found_OK}    Set Variable    (${slot_found} == ${expcsirs.slot0} or ${slot_found} == ${expcsirs.slot1})
        # Dated Log           ===> slot_found_OK = ${slot_found_OK}
        ${start_found_OK}   Set variable    (${startSymbol_found} == ${expcsirs.startSymbol} and ${startPrb_found} == ${expcsirs.startPrb})
        # Dated Log           ===> start_found_OK = ${start_found_OK}
        ${nb_match}=     Run Keyword If    (${slot_found_OK} and ${start_found_OK})
        ...                                  Evaluate    ${nb_match} + 1
        ...                          ELSE    Evaluate    ${nb_match} + 0    # THQ Bidouille pour robot
    END

    Dated Log    ===> ${nb_match} packets match the expected checks on CSI-RS among the ${nbOfPacketFound} packets
    Should Be True                              ${nb_match} == ${nbOfPacketFound}


Check dlData csirssendreq in csv
    [Documentation]
    ...     Conditions:
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${pcapFile}        # input filename for analysing
    ...                     ${subcellid}

    Dated Log New Line                          ===> checks in dlData_csirssendreq for cell1

    #Build csv file for dldata_csirssendreq
    set test variable                 ${csirsFilteredFile}           csirsFiltered.csv
    set test variable                 ${csvPath}      ${LOG_PATH}/${csirsFilteredFile}

    ${cmd_mcshark}      Catenate    tshark -r
    ...                 ${pcapFile.path}
    ...                 -T fields -Y "dldata_csirssendreql1sw and 3gpp.subcellid == ${subcellid}" -e _ws.col.info
    ...                 -e 3gpp.sfn
    ...                 -e 3gpp.slot
    ...                 -e 3gpp.subcellid
    ...                 -e DlData_CsiRsResourceL1sw_t.startSymbol
    ...                 -e DlData_CsiRsResourceL1sw_t.startPrb
    ...                 -E header=y -E separator=';' > ${csvPath}
    Run                 ${cmd_mcshark}

    Run      command=sed -i -e 's/ //g' ${csvPath}

    ${startSymbCheck}    Set variable    ${expCsiRs_0.startSymbol},${expCsiRs_1.startSymbol}
    ${startPrbCheck}    Set variable    ${expCsiRs_0.startPrb},${expCsiRs_1.startPrb}

    ${results}              CheckCsirsCsv    csvPathName=${csvPath}    expSlot0=${expCsiRs_0.slot0}    expSlot1=${expCsiRs_0.slot1}
    ...                                      expStartSymb=${startSymbCheck}    expStartPrb=${startPrbCheck}

    Dated Log    ===> ${results}[nbcsirs] CSI-RS packets
    Dated Log    ===> ${results}[nbExpSlot0] CSI-RS packets in slot ${expCsiRs_0.slot0}
    Dated Log    ===> ${results}[nbExpSlot1] CSI-RS packets in slot ${expCsiRs_0.slot1}
    Dated Log    ===> ${results}[nbOtherSlot] CSI-RS packets in other slot than ${expCsiRs_0.slot0} and ${expCsiRs_0.slot1}
    Dated Log    ===> ${results}[nbExpStartSymb] CSI-RS packets with expected StartSymbol
    Dated Log    ===> ${results}[nbOtherStartSymb] CSI-RS packets with NON expected StartSymbol
    Dated Log    ===> ${results}[nbExpStartPrb] CSI-RS packets with expected StartPrb
    Dated Log    ===> ${results}[nbOtherStartPrb] CSI-RS packets with NON expected StartPrb

    Should Be True        ${results}[nbcsirs] > 0 and ${results}[nbExpSlot0] > 0 and ${results}[nbExpSlot1] > 0
    ${nbSlotOk}        Evaluate        ${results}[nbExpSlot0] + ${results}[nbExpSlot1]
    Should Be True        ${nbSlotOk} == ${results}[nbcsirs] and ${results}[nbExpStartSymb] == ${results}[nbcsirs]
    ...                   and ${results}[nbExpStartPrb] == ${results}[nbcsirs]


Check RRC Setup
    [Documentation]
    ...     Conditions:
    ...     Actions:
    ...     Checks:
    ...     Verdict:
    [Arguments]             ${crtChk}        # input criterions

    Run     cp ${tl.core.dir_path}/egate_console.log /tmp/egate_consW.log

    ${nbRrcSetup}    Run     grep -i 'message c1 : rrcSetup :' /tmp/egate_consW.log | wc -l
    Should Be True    ${nbRrcSetup} != 0

    FOR    ${elem}    IN    @{crtChk}
        ${nbf}    Run     grep -i '${elem.chn}' /tmp/egate_consW.log | wc -l
        ${expf}    Evaluate    ${nbRrcSetup} * ${elem.nb}
        Dated Log    ===> ${nbf} '${elem.chn}' in ${nbRrcSetup} RRC Setup
        Should Be True    ${nbf} == ${expf}
    END


# --------------------------------------------------------------------------------------------------------------------------------------------------
# Counters

Sleep Until PM Availability_011031
    [Arguments]             ${pm_granularity_period}=300
    ...                     ${pm_availability_delay}=60

    Dated Log                                   ===> sleep until PM availability is started
    ${time_of_start}=                           Evaluate    int(time.time())    time
    ${time_of_next_pm_period}=                  Evaluate    (int(${time_of_start} / ${pm_granularity_period}) + 2) * ${pm_granularity_period}
    ${time_of_pm_availability}=                 Evaluate    ${time_of_next_pm_period} + ${pm_availability_delay}
    ${duration_until_pm_availability}=          Evaluate    ${time_of_pm_availability} - ${time_of_start}
    ${timeout_string}=                          Catenate    ${duration_until_pm_availability}  sec
    ${date_of_pm_availability}=                 Convert date    ${time_of_pm_availability}
    Dated Log                                   ===> PM should be available in ${timeout_string}, at ${date_of_pm_availability}
    Sleep                                       ${timeout_string}
    Dated Log                                   ===> sleep until PM availability is ended

Collect PM Counters File_011031
    [Documentation]                 KW to get counters and store in specific directory with day date

    ${date}                          Get Current Date
    ${date_in_dir_name}              Convert Date         ${date}     result_format=%d%m%Y_%H%M
    ${log_path_pm}                   Set Variable         ${LOG_PATH}/PM_${date_in_dir_name}
    BuiltIn.Log              The PM counters file collected from gnb will be stored under : ${log_path_pm}
    ${pm_latest}                    Counters.Collect PM files from BTS    ${log_path_pm}
    set Suite Variable              ${LATEST_FILE}       ${pm_latest}
    set Suite Variable              ${log_path_pm}
    BuiltIn.Log     Latest pm counters file : ${LATEST_FILE}


Compare PM Counter_011031
    [Documentation]   Compare data volume between Cell1 and Cell2
    [Arguments]             ${count}    ${dir}    ${dev}


    ${vol1}=    Counters.Retrieve Latest Single Counter Value From Pm File with CellID    ${LATEST_FILE}    ${count}    1
    ${vol2}=    Counters.Retrieve Latest Single Counter Value From Pm File with CellID    ${LATEST_FILE}    ${count}    2
    ${vol1ad}    Evaluate    (1 + ${dev}/100) * ${vol1}

    Dated Log           PM Counter ${dir} data volume with deviation Cell1 ${vol1ad} Check above Cell2 ${vol2}
    Should Be True      ${vol1ad} >= ${vol2}



# --------------------------------------------------------------------------------------------------------------------------------------------------
# TC CB011031_A_02

K_CB011031_A_2
    [Documentation]
    ...     Conditions:     it is based on the arguments ${config_blanking} ${dict_ues} ${is_capture} ${param} ${test_name}
    ...     Actions:        it performs the call setup for multi-ues with traffic on different cells
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues with traffic and PRB blanking are passed
    [Arguments]             ${dict_ues}
    ...                     ${is_capture}
    ...                     ${param}
    ...                     ${test_name}

    Init Sequence                               ${param}
    Dated Log New Line                          ===> test name is ${test_name}
    Run Keyword If    ${SUITE_DEBUG_MODE}       Set Debug Mode

    # THQ a remettre Restart TL ou laisser dans kw de modif config ???
    Critical Step                               Restart TL

    # Configure new ue's dynamically
    ${initial_nb_ue}=                           get length    ${dict_ues}
    Run Keyword If    ${initial_nb_ue} < ${param.total_nb_ue}    Configure New Ues    ${dict_ues}
    ...                                                             ${initial_nb_ue}
    ...                                                             ${param.total_nb_ue}
    ...                                                             ${dict_settings_ue_default}
    # Configure the current setting for all the ues
    ${param.total_nb_ue}=                       get length    ${dict_ues}
    Dated Log New Line                          ===> configure the setting for all the ${param.total_nb_ue} ue's
    @{list_ue}=                                 Create List
    FOR    ${current_id}    IN RANGE    0    ${param.total_nb_ue}
        # ${current_ue}=                          Evaluate                ${current_id} + 1
        ${current_ue_setting}=                  Copy Dictionary         ${BASIC_UE_SA}
        #id for a sa ue starts at 1 into basic_setup.cfg#
        Set To Dictionary                       ${current_ue_setting}    ue    ${dict_ues[${current_id}].ueid}
        Set To Dictionary                       ${current_ue_setting}    trf_id    1
        Set To Dictionary                       ${current_ue_setting}    pdu    1
        Set To Dictionary                       ${current_ue_setting}    target_gnb    ${param.target_gnb}

        # Dispatching the ue on the requested original cell for the call establishment
        Set To Dictionary                       ${current_ue_setting}    target_cells    ${dict_ues[${current_id}].original_cell}
        # Set the correct requested throughput per ue
        Set To Dictionary                       ${current_ue_setting}    throughput    ${dict_ues[${current_id}].throughput}
        Set To Dictionary                       ${current_ue_setting}    throughput_gbr    ${dict_ues[${current_id}].throughput_gbr}
        Set To Dictionary                       ${current_ue_setting}    throughput_ul    ${dict_ues[${current_id}].throughput_ul}
        Append To List                          ${list_ue}    ${current_ue_setting}
    END
    Dated Log New Line                          ===> ue's list is ${list_ue}
    Check Multi Ues Setting In List             list_multi_ue=${list_ue}
    Traced Sleep                                duration=15s    msg=Wtsemu system start-up to give radio modules time to start up

    # Start SYSLOG capture during call setup
    ${syslog}=                                  SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_call_setup

    # Setup wtsemu SA for all the ues
    Step                                        CallSetup.Setup Wtsemu SA    nbUe=${param.total_nb_ue}
    ...                                                             nbCell=${4}
    ...                                                             nbSaUe=${param.total_nb_ue}
    ...                                                             shouldUseLua=${False}
    ...                                                             list_of_UE_tobe_created=${list_ue}
    # WA to avoid degradation on cells
    Traced Sleep                                duration=15s    msg=setting the X2 link as WA to avoid degradation on cells
    Step                                        CallSetup.WTS Set X2 Link

    # Capture TTI traces during call setup
    Start TTI Logs    # TQ a commenter

    # Captures Init and Start to avoid exceeded traffic - Capture L1L2 before traffic for verification
    Run Keywords                               Captures Init
    ...    AND    Step
    ...                                        Captures Start    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${False}
    ...                                                             action_l1l2=${is_capture.is_capture_l1l2}
    ...    AND                                 Traced Sleep    duration=1s    msg=call with traffic for L1L2 trace    # THQ 1s au lieu de 8
    ...    AND    Step                         Captures Stop    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${False}
    ...                                                             action_l1l2=${is_capture.is_capture_l1l2}

    ${list_l1l2_messages_filters}=             CB011031 Create Filter Message List L1L2
    Run Keyword If    not ${CALL_SETUP_ONLY} and ${is_capture.is_capture_l1l2}    Run Keywords    Step    CB011031 Analyze pcap and pdml
    ...                                                             pcap_file=${capture_l1l2.path}
    ...                                                             list_message_filter=${list_l1l2_messages_filters}
    ...    AND    Step                         Check dlData ssblocksendreq slot
    ...                                        pdml_file=${list_l1l2_messages_filters[${pos_filter_dlData ssblocksendreql1sw}].pdml_file_result}
    ...                                                             fields=${dlData_ssblocksendreq_check_11031_A2}
    ...                                                             subcellid=0
    ...                                                             expblck=${expSsb}
    ...                                                             packet_end=256    # THQ 128    #-1
          # THQ check csirs fait en csv
    #...    AND    Step                         Check dlData csirssendreq
    #...                                        pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_csirssendreql1sw}].pdml_file_result}
    #...                                                             fields=${csiRs_0_check_11031_A2}
    #...                                                             subcellid=0
    #...                                                             expcsirs=${expCsiRs_0}
    #...                                                             packet_end=256    # THQ 128    #-1
            # THQ attendre evolution SWENG
    #...    AND    Step                         Check dlData csirssendreq
    #...                                        pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_csirssendreql1sw}].pdml_file_result}
    #...                                                             fields=${csiRs_1_check_11031_A2}
    #...                                                             subcellid=0
    #...                                                             expcsirs=${expCsiRs_1}
    #...                                                             packet_end=256    # THQ 128    #-1
    ...    AND    Step                Check SIB1
    ...                               pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschpayloadtbsendreql1sw}].pdml_file_result}
    ...                                                             fields=${sib1_check_11031_A2}
    ...                                                             subcellid=0
    ...                                                             expsib=${expSib1}
    ...                                                             packet_end=256    # THQ 128    #-1
    ...    AND    Step                Check OSI
    ...                               pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschpayloadtbsendreql1sw}].pdml_file_result}
    ...                                                             fields=${sib2_check_11031_A2}
    ...                                                             subcellid=0
    ...                                                             expsib=${expSib2}
    ...                                                             packet_end=256    # THQ 128    #-1
    ...    AND    Step                Check OSI
    ...                               pdml_file=${list_l1l2_messages_filters[${pos_filter_dldata_pdschpayloadtbsendreql1sw}].pdml_file_result}
    ...                                                             fields=${sib4_check_11031_A2}
    ...                                                             subcellid=0
    ...                                                             expsib=${expSib4}
    ...                                                             packet_end=256    # THQ 128    #-1
    ...    AND    Step                         Check dlData csirssendreq in csv
    ...                                        pcapFile=${capture_l1l2}
    ...                                        subcellid=0

    # Start Capture CPRT before call setup
    Run Keyword If    ${is_capture.is_capture_cprt}     Step    Captures Start    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${is_capture.is_capture_cprt}
    ...                                                             action_l1l2=${False}

    # Register and launch PDU for all the ue's
    #FOR    ${current_elem}    IN    @{list_ue}
    #    Step                                    CallSetup.UE Register    ue=${current_elem.ue}
    #    ...                                     depends=CallSetup.Setup Wtsemu SA
    #    Step                                    CallSetup.Launch PDU Session    ue=${current_elem.ue}
    #    ...                                                         pdu=${current_elem.pdu}
    #    ...                                                         gw=${current_elem.ue}
    #    ...                                     depends=CallSetup.UE Register
    #END
    ${firstUe}                              Set Variable    ${list_ue[0].ue}
    Step                                    CallSetup.UE Register    ue=${firstUe}
    ...                                     depends=CallSetup.Setup Wtsemu SA
    Step                                    CallSetup.Launch PDU Session    ue=${firstUe}
    ...                                                         pdu=${list_ue[0].pdu}
    ...                                                         gw=${firstUe}
    ...                                     depends=CallSetup.UE Register

    Step                                        Stop and Get TTI Logs    trace_name=${test_name}_call_setup
    Step                                        SYSLOG Stop    syslog=${syslog}

    # Stop Capture CPRT after call setup for initial verification
    Run Keyword If    ${is_capture.is_capture_cprt}    Step    Captures Stop    action_core=${is_capture.is_capture_core}
    ...                                                             action_cprt=${is_capture.is_capture_cprt}
    ...                                                             action_l1l2=${False}

    Step                                         Check RRC Setup    crtChk=${rrcStpChk}


    # Capture Sherpa after call setup for initial verification
    ${enable_sherpa}=                           Set Variable        ${SHERPA_TRACE}
    Run Keyword If    ${enable_sherpa} == ${True}    Run Keywords    Step     Activate Sherpa
    ...    AND                                  Traced Sleep    duration=8s    msg=capture after call setup
    ...    AND                                  Deactivate Sherpa and Stop Collect
    ...    AND    Step                          Upload and decode sherpa pcap files    Sherpa_logs_local_path=${trace_dir}    duration=0

#
    # THQ Sleep Until PM Availability    # Wait end of PM period containing cell setup
#
    # Start SYSLOG capture during traffic establishment
    ${syslog}=    Run Keyword If    not ${CALL_SETUP_ONLY}    SYSLOG Start    host=${GNB_DU.sys[0].M}    name=${test_name}_traffic

    ${secondUe}                              Set Variable    ${list_ue[1].ue}
    Step                                    CallSetup.UE Register    ue=${secondUe}
    ...                                     depends=CallSetup.Setup Wtsemu SA
    Step                                    CallSetup.Launch PDU Session    ue=${secondUe}
    ...                                                         pdu=${list_ue[1].pdu}
    ...                                                         gw=${firstUe}    # THQ same gw as first UE on purpose
    ...                                     depends=CallSetup.UE Register

    # PDU session modify reserved for the ue's configured with GBR traffic
    # ${nb_ue_traffic_gbr}=                       Get Number Of Ue Configured With GBR Traffic    dict_ues=${list_ue}

    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput_gbr} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY}    Run Keywords
        ...    Step                             CallSetup.UE PDU Session Modify    ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         qfta=2
        ...                                                         by=amf
        ...                                     depends=CallSetup.Launch PDU Session
        ...    AND    Step                      CallSetup.UE PDU Session Modify    ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         qfta=3
        ...                                                         by=amf
        ...                                     depends=CallSetup.Launch PDU Session
    END

    # Start the DL GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput_gbr} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY}
        ...    Step                             DL Traffic GBR SA Not Stopped    param=${param}    current_ue_setting=${current_elem}
        ...                                     depends=CallSetup.Launch PDU Session
    END

    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{list_ue}
        Run Keyword If    ${current_elem.throughput} > ${NO_THROUGHPUT} and not ${CALL_SETUP_ONLY}
        ...    Step                             ${param.dir} Traffic Not Stopped    param=${param}    current_ue_setting=${current_elem}
        ...                                     depends=CallSetup.Launch PDU Session
    END


    # Capture TTI traces during traffic for verification
    Run Keyword If    not ${CALL_SETUP_ONLY}    Run Keywords    Start TTI Logs
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic for TTI trace
    ...    AND    Step                          Stop and Get TTI Logs    trace_name=${test_name}_traffic
    # Capture Sherpa during traffic for verification
    ${enable_sherpa}=                           Set Variable        ${SHERPA_TRACE}
    Run Keyword If    not ${CALL_SETUP_ONLY} and ${enable_sherpa} == ${True}    Run Keywords    Step    Activate Sherpa
    ...    AND                                  Traced Sleep    duration=8s    msg=call with traffic for Sherpa trace
    ...    AND                                  Deactivate Sherpa and Stop Collect
    ...    AND    Step                          Upload and decode sherpa pcap files    Sherpa_logs_local_path=${trace_dir}    duration=0


    # Waiting time added for observation and allow generation of multiple count periods
    #FOR    ${iteration_pm}    IN RANGE    0    ${param.pm_waiting_period}
    #    Sleep Until PM Availability
    #    ${pm_path}=                             Counters.Collect PM files from BTS    ${LOG_PATH}/PM
    #    # THQ Run Keyword If    not ${CALL_SETUP_ONLY}    Step    Check Counter And KPI Constraints    ${pm_path}
    #    # THQ...                                                         ${test_name}
    #    # THQ...                                                         localKpiFileName=CB009915_KPI_Definitions.csv
    #END

    # Stop syslog and check counters
    Run Keyword If    not ${CALL_SETUP_ONLY}    Run Keywords    Step    SYSLOG Stop    syslog=${syslog}
    ...    AND                                  Sleep Until PM Availability_011031
    ...    AND                                  Step    Collect PM Counters File_011031
    ...    AND                                  Step    Compare PM Counter_011031    count=M55309C01001    dir=DL    dev=${param.dldev}
    ...    AND                                  Step    Compare PM Counter_011031    count=M55309C02001    dir=UL    dev=${param.uldev}


    # THQ Run Keyword If    not ${CALL_SETUP_ONLY}    Step    SYSLOG Stop    syslog=${syslog}

    # Deregister all the ue's
    Step                                        Traced Sleep    duration=3s    msg=deregistering    depends=CallSetup.UE Register
    FOR    ${current_elem}    IN    @{list_ue}
        Step                                    CallSetup.UE Deregister    id=${current_elem.ue}
        ...                                                         ue_deregister_type=switch_off
        ...                                                         by=ue
        ...                                     depends=CallSetup.UE Register
    END

    [Teardown]      Display diagnosis    # THQ a decommenter
# --------------------------------------------------------------------------------------------------------------------------------------------------

