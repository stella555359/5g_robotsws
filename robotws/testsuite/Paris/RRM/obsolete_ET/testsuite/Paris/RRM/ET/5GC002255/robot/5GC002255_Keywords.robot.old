setup 2255
    ${yamlPath}    Set Variable    ${CURDIR}/../../../../../../custom-config/IBCA/5GC002255/SBTS00/custom_config_2255_BOOAPLOO.yaml
    Suite Setup from scratch        yamlPathname=${yamlPath}
    ...                             listBackupFiles=${FD_ALL}
    ...                             keepAllUeDataInCfgFile=${True}

    Init Variables
    5GC002255_Keywords.Get Original WTS Config

Init Variables
    &{MIRROR_L2_GNB}                create dictionary
    ...                             sport1=21                               sport2=29
    ...                             dport=3                                 host=${GNB_DU.sys[0].M}
    Set Suite Variable              ${MIRROR_L2_GNB}
    ${slaveHost}                    Call method
    ...                             ${GNB_DU}                               getSysSlaveHost
    ${CAPTURE_L2_GNB}               newCapture
    ...                                 host=${slaveHost}
    ...                                 interface=etha01
    ...                                 prefix=L2Traces
    ${CAPTURE_L2_GNB.withTN}        Set Variable                            ${True}
    Set Suite Variable              ${CAPTURE_L2_GNB}

teardown 2255
    CallSetup.Empty Buffer For Egate
    Traced sleep   10s  msg=wait 10s for flush
    5GC002255_Keywords.Collect EGATE console Logs
	Setup.Suite Teardown       reset_ap=${True}
	5GC002255_Keywords.Put back original config files

Check Cell on Air
    coam.connect to   bts_host=${tl.gnbs[0].cu.oam_http_connection_details.addr}   name=coam_admin
    &{bts_info}    coam.Get Bts Statuses    connection=coam_admin
    Should Be Equal    ${bts_info['proceduralState']}    onAir    ignore_case=true 

