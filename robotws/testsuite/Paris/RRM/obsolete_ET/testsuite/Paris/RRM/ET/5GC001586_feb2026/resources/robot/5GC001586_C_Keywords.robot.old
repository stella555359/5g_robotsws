Check No DL Cell Subcarrier Resource Coordination Failure
    [Arguments]    ${pdmlFile}
    ${cmd}=      Catenate     grep -n -i "enDssDlSubframeResourceAllocationFail" ${pdmlFile} |
    ...                        wc -l > ${LOG_PATH}/nbr_enDssDlSubframeResourceAllocationFail_parsed_${TEST_NAME}.txt
    OperatingSystem.Run      ${cmd}
    ${output}    OperatingSystem.Run     cat ${LOG_PATH}/nbr_enDssDlSubframeResourceAllocationFail_parsed_${TEST_NAME}.txt
    Should Be True    ${output}==0

# to check UL_Cell_Subcarrier_Resource_Coordination_Update
Check UL Cell Subcarrier Resource Coordination Update procedure
    [Arguments]    ${pdmlFile}
    ${cmd}=     Catenate    grep -n -i "enDssUlCellSubcarrierResourceCoordinationUpdateInd" ${pdmlFile} |
    ...                      wc -l > ${LOG_PATH}/nbr_enDssUlCellSubcarrierResourceCoordinationUpdateInd_parsed_${TEST_NAME}.txt
    OperatingSystem.Run      ${cmd}
    ${output}    OperatingSystem.Run     cat ${LOG_PATH}/nbr_enDssUlCellSubcarrierResourceCoordinationUpdateInd_parsed_${TEST_NAME}.txt
    Should Be True    ${output}==1

Check UL and DL Qos Load Indication
   [Arguments]    ${pdmlFile}
   #  LOG_PATH instea of OUTPUT
    OperatingSystem.Run      grep -n -i "enDssDlQosLoadInd" ${pdmlFile} | wc -l > ${LOG_PATH}/nbr_enDssDlQosLoadInd_parsed_${TEST_NAME}.txt
    OperatingSystem.Run      grep -n -i "enDssUlQosLoadInd" ${pdmlFile} | wc -l > ${LOG_PATH}/nbr_enDssUlQosLoadInd_parsed_${TEST_NAME}.txt
    ${output_dl}    OperatingSystem.Run     cat ${LOG_PATH}/nbr_enDssDlQosLoadInd_parsed_${TEST_NAME}.txt
    ${output_ul}    OperatingSystem.Run     cat ${LOG_PATH}/nbr_enDssUlQosLoadInd_parsed_${TEST_NAME}.txt
    Should Be True    (${output_dl}>20)&(${output_ul}>20)

# enDssUlQosLoadInd
