*** Keywords ***
# robocop: off=unused-argument
# robocop: off=possible-variable-overwriting
Test Setup 1586 C and Save scf and swconfig
    [Documentation]                Generic test for 1586-C: test setup
    [Arguments]                    ${param}

    #   upload scf file, xml and cfg for DSS
    #   set specific RAD param for DSS
    #   set scf for 10Mhz
    #   set scf for DSS specific parameters
    5GC001586_Kw_TestSetup.Test Setup 1586 C    ${param}

    # Save current SCF file used during test cases
    ${current_scf_file}             OAM Get SCF File            dir=${LOG_PATH}      file=SCF_used_for_1586_Tests.xml
    Set Suite Variable              ${current_scf_file}
    Dated Log New Line         Current 1586 SCF file stored to ${current_scf_file}

    # Get swconfig file that will be used during 1586-C tests
    ${alias_gnb}                    SSH Wait For Connect                ${GNB_DU.sys[0].M}
    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${LOG_PATH}/swconfig_used_for_1586_Tests.txt
    ...                             connection=${alias_gnb}
    Dated Log                  Current 1586 swconfig file stored to ${LOG_PATH}/swconfig_used_for_1586_Tests.txt

    # Get EPC file configuration that will be used during 1586-M tests
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.download_file               remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${LOG_PATH}/basic_wts_used_for_1586_M_${param.seq.bandwidth}_Tests.cfg
    ...                             connection=${alias_epc}

    # Get AP configuration file that will be used during 1586-M tests
    ${ap_configfile}                Get XML AirPhoneConfig Path
    run Keyword if      '${ap_configfile}' != '${empty}'     csn.download_file         remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${LOG_PATH}/ApOamConfig_used_for_1586_M_${param.seq.bandwidth}_Tests.xml
    ...                             connection=${alias_epc}

    Dated Log     Current 1586 basic file ${tl.core.cfg_filename} stored to ${LOG_PATH}/basic_wts_used_for_1586_D_${param.seq.bandwidth}_Tests.cfg
    Dated Log     Current 1586 ApOamConfig file stored to ${LOG_PATH}/ApOamConfig_used_for_1586_D_${param.seq.bandwidth}_Tests.xml

TC 1586-C-CellSetup
    [Documentation]                Generic test for 1586-C: test purpose is to setup X2, Xp and DSS
    [Arguments]                    ${param}
    Init Sequence                  ${param}
    #   Critical Step                  WTS Clear
    5GC001586_Keywords.Restart     OwnTLReset=${False}    GNBCallback=5GC001586_Keywords.Set Reset Loop Counter
    Step                           Start capture Backhaul for DSS                                      depends=5GC001586_Keywords.Restart
    Step                           common_Dss_Keywords.Start WTS          argument=default             depends=Start capture Backhaul for DSS
    Step                           5GC001586_Keywords.Wait Xp link Up     argument=default             depends=common_Dss_Keywords.Start WTS
    Step                           common_Dss_command.X2Ap link Setup     argument=default             depends=common_Dss_Keywords.Start WTS
    # DSS_Cell_Setup use ${param} variable initialized into the Init Sequence Kw
    Step                           5GC001586_Keywords.DSS_Cell_Setup                depends=5GC001586_Keywords.Wait Xp link Up
    ${pdmlFile}                    Run Keyword if      '${TRACE_SHOULD_BE_STOP_AFTER_CELLSETUP}' == '1'            Stop capture Backhaul for DSS
    Run Keyword if     ('${TRACE_SHOULD_BE_STOP_AFTER_CELLSETUP}' == '1') and ('${CELLSETUP_SHOULD_BE_CHECK}' == '1')        Check DSS CellSetup
    ...                                                                                                                       pdmlFile=${pdmlFile}
    Critical Step                  5GC001586_Ue_command.Verify AP Classical Cell Setup
    [Teardown]                      GenericTest.Display diagnosis

TC 1586-C-UL_Cell_SubCarrier_Allocation_Failure_case
    [Documentation]                Test purpose is to test UL_Cell_SubCarrier_Allocation_Failure_case
    [Arguments]                    ${param}     ${alias}=default
    Init Sequence                  ${param}
    Run Keyword if                 ('${TRACE_SHOULD_BE_STOP_AFTER_CELLSETUP}' == '1')       Start capture Backhaul for DSS
    # 1st Check... => forbiden
    # 28/07/2020 : PR523247 : no check whether received allocation falls within allocated range
    # DSS UL Cell Resource Allocation Failure    ${ULNbrOfPrb}=0x00000025   ${msg1FrequencyStart}=${param.scfFile.nrcell.msg1FrequencyStart}
    # 2nd Check....
    # check UL Allocation Failure in case of msg1FrequancyStart is not into the Rach static Zone
    ${StartPrb}                     Evaluate                    ${param.scfFile.nrcell.msg1FrequencyStart}+1
    ${NbrPrb}                       toDecimalStr                0x00000015
    ${UL_CELL_RESOURCE_ALLOCATION_PARAMS.StartPrb}  set Variable   ${StartPrb}
    ${UL_CELL_RESOURCE_ALLOCATION_PARAMS.NbrPrb}  set Variable   ${NbrPrb}
    ${UL_CELL_RESOURCE_ALLOCATION_PARAMS.alias}  set Variable   ${alias}
    Step                            DSS UL Cell Resource Allocation Failure          argument=${UL_CELL_RESOURCE_ALLOCATION_PARAMS}
    # 3nd Check...
    # before 1586-K, l2ps shall insure that the receiving range includes 6PRB starting from PrachPrbOffset (i.e. msg1FrequencyStart)
    ${StartPrb}       Evaluate   ${param.scfFile.nrcell.msg1FrequencyStart}
    ${NbrPrb}         toDecimalStr     0x00000005
    ${UL_CELL_RESOURCE_ALLOCATION_PARAMS.StartPrb}  set Variable   ${StartPrb}
    ${UL_CELL_RESOURCE_ALLOCATION_PARAMS.NbrPrb}  set Variable   ${NbrPrb}
    ${UL_CELL_RESOURCE_ALLOCATION_PARAMS.alias}  set Variable   ${alias}
    Step                            DSS UL Cell Resource Allocation Failure     argument=${UL_CELL_RESOURCE_ALLOCATION_PARAMS}

    # this case is not checked by L2PS
    # L2PS check only that the static zone  [Msg1FrqStart , Msg1FrqStart +5]  is included into the UL alloc received by CRM
    # ${StartPrb}                     Evaluate                    ${param.scfFile.nrcell.msg1FrequencyStart}-1
    # ${NbrPrb}                       toDecimalStr                0x00000015
    # ${UL_CELL_RESOURCE_ALLOCATION_PARAMS.StartPrb}  set Variable   ${StartPrb}
    # ${UL_CELL_RESOURCE_ALLOCATION_PARAMS.NbrPrb}  set Variable   ${NbrPrb}
    # ${UL_CELL_RESOURCE_ALLOCATION_PARAMS.alias}  set Variable   ${alias}
    # Step                            DSS UL Cell Resource Allocation Failure          argument=${UL_CELL_RESOURCE_ALLOCATION_PARAMS}

    Run Keyword if                 ('${TRACE_SHOULD_BE_STOP_AFTER_CELLSETUP}' == '1')       Stop capture Backhaul for DSS
   [Teardown]                      Specific teardown 1586-C    alias=default

Specific teardown 1586-C
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}
    Dated Log             Test ${TEST_NAME} 1586-C ending
    # Run Keyword If        '${get_snapshot}' == '1'           Dated log New Line     Get GNB logs from OAM (snapshot)
    # Run Keyword If        '${get_snapshot}' == '1'           Run Keyword And Ignore Error           Get GNB Logs from Coam
    GenericTest.Display diagnosis


