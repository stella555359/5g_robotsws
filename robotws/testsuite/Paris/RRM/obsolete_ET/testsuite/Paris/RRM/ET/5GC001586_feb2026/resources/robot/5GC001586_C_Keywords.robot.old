# to check that we have a lot of enDssDlCellSubframeResourceCoordinationReq without rsp
Check Nbr enDssUlCellSubcarrierResourceCoordinationReq
    [Arguments]    ${pdmlFile}
    ${cmd}=      Catenate    egrep -n -i enDssUlCellSubcarrierResourceCoordinationReq ${pdmlFile} | wc -l
    ...                          > ${LOG_PATH}/nbr_enDssUlCellSubcarrierResourceCoordinationReq_parsed.txt
    OperatingSystem.Run     ${cmd}
    ${output}    OperatingSystem.Run     cat ${LOG_PATH}/nbr_enDssUlCellSubcarrierResourceCoordinationReq_parsed.txt
    Should Be True    ${output}>5

# [1]5GC001586_C_TC_11_5GC001586-C_NSA_Check_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_timeout
TC 1586-C-Check_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_timeout
    [Documentation]                1586-C : test purpose is Check_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_timeout
