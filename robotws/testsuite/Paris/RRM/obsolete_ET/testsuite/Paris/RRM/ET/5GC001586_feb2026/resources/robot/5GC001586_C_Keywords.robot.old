Test SgNB Addition PRACH
    CallSetup.SgNB Addition to ENB          ueSetting=${UE_SIMPLE_CellDSS}

Verify AP Classical for 1 UE attach
	${output}           SSH Wait For Connect and Cmd
	...                 command=grep crnti /tmp/startup_l3.log
	...                 host=${AP_DU.sys[0].M}
    run keyword if      should contain	    ${output}	        ueFsId=0, crnti=
    Dated log           5G attach successful for UE 1

Test Verify Attach
    Verify AP Classical for 1 UE attach

Test DL traffic for 1 Ue
    Traffic UEs DL                   ueSettingList=@{UE_SIMPLE_CellDSS}
    ...                              throughput=3
Test UL traffic for 1 Ue
    Traffic UEs UL                   ueSettingList=@{UE_SIMPLE_CellDSS}
    ...                              throughput=3

Test UL DL traffic for 1 Ue
   Traffic UE UL DL                 ueSetting=${UE_SIMPLE_CellDSS}
    ...                             throughput=2


################################################################################################################################
#              For testing purpose
################################################################################################################################

Get Software Version_2
    [Documentation]      Return software version
    ...     alias:   AdminConnection object or if used, string name alias
    coam.connect to   bts_host=${tl.gnbs[0].cu.oam_http_connection_details.addr}   name=coam_admin
    ${software_info}=    coam.get_software_info     connection=coam_admin

    Dated Log New Line  sw_info=${software_info}

    ${sw_version}=       set variable    ${software_info['Active SW version']}
    ${sw_version_package}=       nps_sweng_luashark_analyzer.get_sw_package_2   sw_version=${sw_version}

    Dated Log New Line   Get current sw version package = ${sw_version_package}
    [Return]             ${sw_version_package}
    [Teardown]    coam.teardown    connection=coam_admin


################################################################################################################################
#              END :  For Testing purpose
