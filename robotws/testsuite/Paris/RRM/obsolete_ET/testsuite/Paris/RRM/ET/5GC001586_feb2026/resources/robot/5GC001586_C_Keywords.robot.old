# PM Cpt Test case
TC 1586-C_NSA_Check DSS DL And UL PM counters
    [Documentation]                1586-C : test purpose is to test PM 1586-C counters
    [Arguments]                    ${param}
    Init Sequence                  ${param}
    5GC001586_Keywords.Restart     OwnTLReset=${False}     GNBCallback=5GC001586_Keywords.Set Reset Loop Counter
    Step                           Start capture Backhaul for DSS                      depends=5GC001586_Keywords.Restart
    Step                           common_Dss_Keywords.Start WTS                  argument=tc_counters     depends=5GC001586_Keywords.Restart
    Step                           5GC001586_Keywords.Check wts in active state   argument=tc_counters     depends=common_Dss_Keywords.Start WTS
    Step                           5GC001586_Keywords.Wait Xp link Up             argument=tc_counters     depends=common_Dss_Keywords.Start WTS
    Step                           common_Dss_command.X2Ap link Setup             argument=tc_counters     depends=common_Dss_Keywords.Start WTS
    #  parameter ${param} for DSS_Cell_Setup is initialized by Init Sequence KW
    Step                           5GC001586_Keywords.DSS_Cell_Setup      argument=tc_counters        depends=5GC001586_Keywords.Wait Xp link Up
    Step                           Stop capture Backhaul for DSS                                      depends=Start capture Backhaul for DSS
    # Wait gNB cell 5g On air with globalCellId=1
    Critical Step                  common_Dss_CellSetup.Wait gNB cell 5g On air     globalCellId=1
    Critical Step                  5GC001586_Ue_command.Verify AP Classical Cell Setup
    5GC001586_Keywords.Start/Stop BIP/backaul Traces  call_location=before_attach  collector_name=${collector_name}_attach
    Critical Step                  5GC001586_C_Keywords.Test SgNB Addition PRACH
    5GC001586_Keywords.Start/Stop BIP/backaul Traces  call_location=after_attach  collector_name=${collector_name}_attach
    Traffic UE UL      ueSetting=${UE_SIMPLE_CellDSS}  throughput=${param.seq.ul_throughput}
    ...                duration=10s  shouldBeStop=False    shouldBeCheck=False
    # ...                duration=${param.seq.timeDuration}  shouldBeStop=False    shouldBeCheck=False
    # Sleep 15 mn in case of GP overlap - Traffic is still ongoing
    dated log    Wait 15 minutes for counters GP overlap
    ${status}  ${msg}=        robot_extension.Run Keyword And Warn On Failure        robot_extension.Run Specific Custom KW
    ...                                  5GC001586_Ue_command.Display PDSCH and PUSCH ue_stats_nr
    ...                                              ue_id=${UE_SIMPLE_CellDSS.ue}
    ...                                              CallType=NSA
    ...                                              DlTput=0
    ...                                              UlTput=${param.seq.ul_throughput}
    ...                                              alias=tc_counters
    dated log    End of Wait 15 minutes for counters GP overlap
    # Traced Sleep  15 minutes      msg=counters GP overlap

    # Collect PM
    Run Keyword If        '${check_counters}' == '1'    Step        5GC001586_Keywords.Collect PM Counters File     depends=Traffic UE UL
    Run Keyword If        '${check_counters}' == '1'    Step        5GC001586_Keywords.Check 1586 Counters          depends=Collect PM Counters File

    Run Keyword If        '${check_counters}' == '1'    common_Dss_Keywords.Check Tput over GP period    nb_cell=1
    ...                                                                                                  dl_expected_tput=0
    ...                                                                                                  ul_expected_tput=17.7

    # Traffic Stop                    ueSetting=${UE_SIMPLE_CellDSS}  dir=ul
    [Teardown]         Run Keywords    GenericTest.Display diagnosis     AND
    ...                                5GC001586_Keywords.Collect PM Counters file coam    TEST_LOG_PATH=${testCaseDir}
    # the global Teardown Kw is managed in the TEST_CASE !!!
    # ...                                Teardown 1586 Get PM Cpt    ${param}    alias=tc_counters


Teardown 1586 Get PM Cpt
    [Arguments]             ${testParam}        ${alias}=${HOST_EPCSIM.alias}

    BuiltIn.Log      \nTest 1586-C/-D ending   console=yes

    # get Alarm at the end of the test and store it into a file
    Dated log New Line  OAM Get Active Alarms to Save into file
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}

    ${active_alarms}     OAM Get Active Alarms                   oam=${GNB_DU.oam}    textFormat=${False}

    ${len}    Get Length    ${active_alarms}
    ${alarm_id_list}    Create List
    ${alarm_name_list}    Create List
    ${faultId}=     set variable if    ${isAiC}        fault_id
    ...                                                faultId
    ${faultName}=     set variable if    ${isAiC}      fault_name
    ...                                                faultName
    FOR    ${i}    IN RANGE    ${len}
          ${tmp_id}    Get From Dictionary    ${active_alarms[${i}]}    ${faultId}
          ${tmp_name_id}    Get From Dictionary    ${active_alarms[${i}]}    ${faultName}
          Append To List    ${alarm_id_list}    ${tmp_id}
          Append To List    ${alarm_name_list}    ${tmp_name_id}
    # Dated log     Active alarms: alarm_id_list=${alarm_id_list}
    # Dated log     Active alarms: alarm_name_list=${alarm_name_list}
    END
    Append To File    ${testCaseDir}/OAM_Alarms_After_${TEST_NAME}.txt     Active Alarms Id List:\n${alarm_id_list}\n\n
    Append To File    ${testCaseDir}/OAM_Alarms_After_${TEST_NAME}.txt     Active Alarms Name List:\n${alarm_name_list}\n\n

    OAM Disconnect                          ${GNB_DU.oam}

    # collect PM file after the test
    5GC001586_Keywords.Collect PM Counters file coam

    Run Keyword And Ignore Error     common_Dss_Keywords.Collect EGATE console Logs

    # Restore WTS cfg file name
    Run Keyword If   '${Param.seq.bandwidth}'!='10MHz'      restoreFilename

    # Save current SCF file used during test cases
    ${current_scf_file}             OAM Get SCF File            dir=${testCaseDir}      file=SCF_used_for_1586_${testParam.seq.bandwidth}_Tests.xml
    Set Suite Variable              ${current_scf_file}
    Dated Log New Line         Current 1586 SCF file stored to ${current_scf_file}

    # Get swconfig file used during 1586-M tests
    ${alias_gnb}                    SSH Wait For Connect                ${GNB_DU.sys[0].M}
    csn.download_file               remote_path=${SWCONFIG_PATH}
    ...                             local_path=${testCaseDir}/swconfig_used_for_1586_${testParam.seq.bandwidth}_Tests.txt
    ...                             connection=${alias_gnb}
    Dated Log                  Current 1586 swconfig file stored to ${testCaseDir}/swconfig_used_for_1586_${testParam.seq.bandwidth}_Tests.txt

    # Get EPC file configuration used during 1586-M tests
    ${alias_epc}                    SSH Wait For Connect                ${HOST_EPCSIM}
    csn.download_file               remote_path=${tl.core.dir_path}/${tl.core.cfg_filename}
    ...                             local_path=${testCaseDir}/basic_wts_used_for_1586_${testParam.seq.bandwidth}_Tests.cfg
    ...                             connection=${alias_epc}

    # Get AP configuration file used during 1586-M tests
    ${ap_configfile}                Get XML AirPhoneConfig Path
    run Keyword if      '${ap_configfile}' != '${empty}'     csn.download_file        remote_path=${tl.core.dir_path}/${ap_configfile}
    ...                             local_path=${testCaseDir}/ApOamConfig_used_for_1586_${testParam.seq.bandwidth}_Tests.xml
    ...                             connection=${alias_epc}

    ${msg}=   Catenate    Current 1586-J basic file ${tl.core.cfg_filename} stored
    ...                      to ${testCaseDir}/basic_wts_used_for_1586_${testParam.seq.bandwidth}_Tests.cfg
    Dated Log    ${msg}
    Dated Log  Current 1586-J ApOamConfig file stored to ${testCaseDir}/ApOamConfig_used_for_1586_${testParam.seq.bandwidth}_Tests.xml

    # check here that there is no DSS alarm at the end of the test
    Check Dss active Alarm Should not be present

    common_Dss_Keywords.Get Gnb Snapshot if TestCase Failed

    # wts.Stop and Collect Wts logs
    wts.teardown_all_aliases_for_egate
    wts.teardown_all_aliases_for_edaemon


###################################################################################################################################################
#   DSS specific procedure
###################################################################################################################################################

# 10:32:38.101 WARN: ENB-1: Cell 1: Received EN DSS UL Subcarrier Resource Allocation Failure SequenceNumber=1 Cause=Unspecified

DSS UL Cell Resource Allocation Failure
    [Arguments]                 ${UL_CELL_RESOURCE_ALLOCATION_PARAMS}
    # ${ULNbrOfPrb}=0x00000025
    sleep   2
    # wts.execute egate command    cmd=enb_dss_resource_allocation enb=1 cell=1 tgt_enb=2 tgt_cell=1 dir=UL ...
    # ...                allocation_start_time=immediate ul_allocated_prb_list=4,27

    # ULPrbStart and ULNbrOfPrb are an int

    # ${ULNbrOfPrb_decimal}              toDecimalStr     ${ULNbrOfPrb}
    # ULPrbStart is an int
    # ${ULPrbStart_decimal}              toDecimalStr     ${ULPrbStart}

    ${msg}=     Catenate    \tDSS UL Cell Resource Allocation with StartPrb=${UL_CELL_RESOURCE_ALLOCATION_PARAMS.StartPrb} and
    ...                                                                 NbrOfPRB=${UL_CELL_RESOURCE_ALLOCATION_PARAMS.NbrPrb}
    Dated Log New Line       ${msg}

    # ratio is 37 *100 / 50 = 75 %
    # wts.execute egate command    cmd=enb_dss_resource_allocation enb=1 cell=1 tgt_enb=2 tgt_cell=1 dir=UL ...
    # ...                               allocation_start_time=immediate ul_allocated_prb_list=4,37
    # ${output}=   wts.execute egate command and wait for data    cmd=enb_dss_resource_allocation enb=1 ...
    # ...           cell=1 tgt_enb=2 tgt_cell=1 dir=UL allocation_start_time=immediate ul_allocated_prb_list=4,37
    # ...           pass_regexp=Received EN DSS UL Subcarrier Resource Allocation Failure   timeout=25
    ${cmd}=     Catenate    enb_dss_resource_allocation enb=1 cell=1 tgt_enb=2 tgt_cell=1 dir=UL
    ...                          allocation_start_time=immediate
    ...                          ul_allocated_prb_list=${UL_CELL_RESOURCE_ALLOCATION_PARAMS.StartPrb},${UL_CELL_RESOURCE_ALLOCATION_PARAMS.NbrPrb}
    ${output}=   wts.execute egate command and wait for data    cmd=${cmd}
    ...                                                         pass_regexp=Received EN DSS UL Subcarrier Resource Allocation Failure
    ...                                                         timeout=25   alias=${UL_CELL_RESOURCE_ALLOCATION_PARAMS.alias}
    log to console    ${output}
    log to console  \n***DSS UL Cell Resource Allocation Failure completed***

##################################################################################################################################################
# UL_Cell_Subcarrier_Resource_Coordination_Update
##################################################################################################################################################


UL_Cell_Subcarrier_Resource_Coordination_Update
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    Log to console  \n***DSS Phase-II UL_Cell_Subcarrier_Resource_Coordination_Update ***
    sleep   2
    wts.execute egate command    cmd=enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2    alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_cell_param enb=1 id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM    alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:1    alias=${alias}
    sleep   2
    ${cmd}=   Catenate      enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1
    ...                                  assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=70
    wts.execute egate command    cmd=${cmd}   alias=${alias}
    sleep   2
  # to simulate the EN DSS UL QoS LOAD INDICATION not sent into DL coord rsp
    wts.execute egate command    cmd=enb_crm_param id=1 ul_qos_load_meas_timer=none    alias=${alias}
    sleep   5
#    wts.execute egate command    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1
    #  EN DSS UL Cell Subcarrier Resource Coordination success on remote NE
    ${cmd}=   Catenate     enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2
    ...                                                  tgt_cell=1
    wts.execute egate command and wait for data    cmd=${cmd}    pass_regexp=EN DSS UL Cell Subcarrier Resource Coordination success on remote NE
    ...                                            timeout=25    alias=${alias}

    # wait for DL & UL Coordination
    Dated Log           \tEN DSS DL & UL Cell Subcarrier Resource Coordination success on remote NE
    # sleep   25

    #  DL alloc  with pattern 0011001010-0110001110-0011001010-0110001110
    # allocatedNormalSubframes (Bytes): 3298e3298e3298e3298e
    ${cmd}=    Catenate    enb_dss_resource_allocation enb=1 cell=1 tgt_enb=2 tgt_cell=1 dir=DL
    ...                      allocation_start_time=immediate
    ...                      dl_allocated_normal_subframes=0011001010-0110001110-0011001010-0110001110-0011001010-0110001110-0011001010-0110001110
    wts.execute egate command    cmd=${cmd}    alias=${alias}

    #   10:53:02.483 INF: ENB-1: Received DSS DL Subframe Cell Resource Allocation Response SequenceNumber=0
    # expect "DSS DL Subframe Cell Resource Allocation Response"

    # UL alloc  with pattern (  prachPrbOffset = 4 into Ul coordination because of msg1StartFrequency=4 into scf file)
    # wts.execute egate command    cmd=enb_dss_resource_allocation enb=1 cell=1 tgt_enb=2 tgt_cell=1 dir=UL ...
    # ...                           allocation_start_time=immediate ul_allocated_prb_list=4,20    alias=${alias}

    # move after the UL Coord update  - CSAMSON - 20112020
    # wts.execute egate command    cmd=enb_dss_resource_allocation enb=1 cell=1 tgt_enb=2 tgt_cell=1 dir=UL ...
    # ...              allocation_start_time=immediate ul_allocated_prb_list=${Param.scfFile.nrcell.msg1FrequencyStart},20    alias=${alias}

    sleep   2

    # to simulate on Crm an eNB Coordination request, so, the coordination update will be sent to gNB
    wts.execute egate command    cmd=enb_crm_param id=1 ul_qos_load_meas_timer=80    alias=${alias}
    sleep   1

    ${cmd}=     Catenate      enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1
    ...                           assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=70
    wts.execute egate command    cmd=${cmd}    alias=${alias}
    # expect "EGATE>"

    # wts.execute egate command    cmd=enb_dss_cell_resource_coordination enb=1 cell=1 tgt_enb=2 tgt_cell=1 dir=UL    ...
    # ...                 pass_regexp=Update Indication : EN DSS UL Cell Subcarrier Resource Coordination: both NEs synchronized ...
    # ...                 timeout=15    alias=${alias}
    wts.execute egate command and wait for data    cmd=enb_dss_cell_resource_coordination enb=1 cell=1 tgt_enb=2 tgt_cell=1 dir=UL
    ...                             pass_regexp=Update Indication : EN DSS UL Cell Subcarrier Resource Coordination: both NEs synchronized
    ...                             timeout=15    alias=${alias}
    # expect "EGATE>"
    # expect "DSS UL Subframe Cell Resource Allocation Response"
    Dated Log           \tExpect EN DSS UL Cell Subcarrier Resource Coordination Update

    ${cmd}=     Catenate       enb_dss_resource_allocation enb=1 cell=1 tgt_enb=2 tgt_cell=1 dir=UL
    ...                                       allocation_start_time=immediate ul_allocated_prb_list=${Param.scfFile.nrcell.msg1FrequencyStart},20
    wts.execute egate command    cmd=${cmd}   alias=${alias}

    sleep   5

    # UL alloc  with pattern (  prachPrbOffset = 4 into Ul coordination because of msg1StartFrequency=4 into scf file)
    # wts.execute egate command    cmd=enb_dss_resource_allocation enb=1 cell=1 tgt_enb=2 tgt_cell=1 dir=UL allocation_start_time=immediate ...
    # ...                              ul_allocated_prb_list=4,20    alias=${alias}

# expect "14:38:24.164 INF: ENB-1: Cell 1: Update Indication : EN DSS UL Cell Subcarrier Resource Coordination: both NEs synchronized"

    log to console  \n***DSS UL_Cell_Subcarrier_Resource_Coordination_Update completed***

###################################################################################################################################################
# UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait
# ul coord failed case with "non_matching_resource_reservation"
#   send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=failure ...
# ...      ul_cell_resource_coordination_cause=non_matching_resource_reservation \r"
#   wts.execute egate command    cmd=crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=failure ...
# ...      ul_cell_resource_coordination_cause=non_matching_resource_reservation
###################################################################################################################################################

UL_Cell_Subcarrier_Resource_Coordination_Normal_case
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    Log to console  \n***DSS Phase-II UL_Cell_Subcarrier_Resource_Coordination_Normal_case ***
    sleep   2

    wts.execute egate command    cmd=crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=normal    alias=${alias}

    sleep       2

    log to console  \n***DSS UL_Cell_Subcarrier_Resource_Coordination_Normal_case completed***


UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    Log to console  \n***DSS Phase-II UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait ***
    sleep   2

    # wts.execute egate command    cmd=enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2   alias=${HOST_EPCSIM.alias}
    wts.execute egate command    cmd=enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2   alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_cell_param enb=1 id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM   alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:1     alias=${alias}
    sleep   2
    ${cmd}=     Catenate      enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1
    ...                               assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=70
    wts.execute egate command    cmd=${cmd}   alias=${alias}
    sleep   2

    wts.execute egate command    cmd=enb_crm_param id=1 cell_resource_coordination_failure_ttw=1    alias=${alias}

    sleep   1

# ul coord failed case
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=failure ...
# ...     ul_cell_resource_coordination_cause=dss_configuration_error \r"
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=failure ...
# ...     ul_cell_resource_coordination_cause=non_matching_resource_reservation \r"
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=failure ...
# ...     ul_cell_resource_coordination_cause=resource_conflict \r"

# ul coord failed case with no_rsp
#    wts.execute egate command    cmd=crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=no_rsp
    ${cmd}=   Catenate     crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=failure
    ...                    ul_cell_resource_coordination_cause=non_matching_resource_reservation
    wts.execute egate command    cmd=${cmd}   alias=${alias}

    sleep       5

# expect  "EN DSS UL Cell Subcarrier Resource Coordination Failure"
# 17:51:04.097 INF: ENB-1: Cell 1: EN DSS DL Cell Subframe Resource Coordination success on remote NE
# 17:51:04.099 WARN: ENB-1: Cell 1: Abnormal case (CRM): EN DSS UL Cell Subcarrier Resource Coordination Failure has been triggered
    # wts.execute egate command    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1     alias=${alias}
    ${cmd}=      Catenate      enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1
    wts.execute egate command and wait for data    cmd=${cmd}   pass_regexp=EN DSS DL Cell Subframe Resource Coordination success on remote NE
    ...                                            alias=${alias}

    # wts.execute egate command and wait for data   cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1
    #               pass_regexp=EN DSS UL Cell Subcarrier Resource Coordination Failure has been triggered

    log to console  \n***DSS UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait completed***

#################################################################################################################################################
# UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case2_w_no_time_to_wait
# ul coord failed case
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=
#                                                 failure ul_cell_resource_coordination_cause=dss_configuration_error \r"
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=
#                                                 failure ul_cell_resource_coordination_cause=non_matching_resource_reservation \r"
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=
#                                                 failure ul_cell_resource_coordination_cause=resource_conflict \r"
#################################################################################################################################################

UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case2_w_no_time_to_wait
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    Log to console  \n***DSS Phase-II UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case2_w_no_time_to_wait ***
    sleep   2

    wts.execute egate command    cmd=enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2    alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_cell_param enb=1 id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM     alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:1      alias=${alias}
    sleep   2
    ${cmd}=     Catenate    enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1
    ...                                          assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=70
    wts.execute egate command    cmd=${cmd}    alias=${alias}
    sleep   2

# no time to wait
    # wts.execute egate command    cmd=enb_crm_param id=1 cell_resource_coordination_failure_ttw=0
    wts.execute egate command    cmd=enb_crm_param id=1 cell_resource_coordination_failure_ttw=1     alias=${alias}

    sleep   1

# ul coord failed case
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=
#                                                            failure ul_cell_resource_coordination_cause=dss_configuration_error \r"
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=
#                                                          failure ul_cell_resource_coordination_cause=non_matching_resource_reservation \r"
# send "crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=
#                                                          failure ul_cell_resource_coordination_cause=resource_conflict \r"

# ul coord failed case with no_rsp
    ${cmd}=    Catenate     crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=failure
    ...                                                  ul_cell_resource_coordination_cause=resource_conflict
    wts.execute egate command    cmd=${cmd}     alias=${alias}

    # sleep   15
    sleep   5

    # wts.execute egate command    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1    alias=${alias}
    wts.execute egate command and wait for data    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1
    ...                                            pass_regexp=EN DSS DL Cell Subframe Resource Coordination success on remote NE   alias=${alias}

#   pass_regexp=Partnership activated on both partners timeout=15

# expect "Partnership activated on both partners"

# expect "Coordination"
    log to console  \n***DSS UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case2_w_no_time_to_wait completed***

#################################################################################################################################################
# UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_timeout
# DSS CellSetup + UL CEll Coordination Procedure Failure case (No resp to UL Coord Request from CRMSim)
# crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=no_rsp
#################################################################################################################################################

UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_timeout
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    Log to console  \n***DSS Phase-II UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_timeout ***
    sleep   2

# [session 2]: enb_xp_param id=1 ignore_xp=off xp_listening_socket=on
# [session 2]: enb_xp_param id=1 xp_peers=2
# [session 2]: enb_xp_link_up enb=1 target=2
# [session 2]: enb_x2_link_up enb=1 target=2
# [session 2]: enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2
# [session 2]: enb_cell_param enb=1 id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM
# [session 2]: enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:1
# [session 2]: enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1 assigned_ul_minimum_share_to_nr=20
#                      assigned_ul_maximum_share_to_nr=40
# [session 2]: enb_crm_param id=1 cell_resource_coordination_failure_ttw=1
# [session 2]: crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=no_rsp
# [session 2]: enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1

    wts.execute egate command    cmd=enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2    alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_cell_param enb=1 id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM    alias=${alias}
    sleep   2
    wts.execute egate command    cmd=enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:1     alias=${alias}
    sleep   2
    ${cmd}=    Catenate      enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1
    ...                                                        assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=40
    wts.execute egate command    cmd=${cmd}    alias=${alias}
    sleep    2
    wts.execute egate command    cmd=enb_crm_param id=1 cell_resource_coordination_failure_ttw=1    alias=${alias}
    sleep   2
    wts.execute egate command    cmd=crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=no_rsp    alias=${alias}
    sleep   2
    # wts.execute egate command    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1    alias=${alias}
    wts.execute egate command and wait for data    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1
    ...                                            pass_regexp=EN DSS DL Cell Subframe Resource Coordination success on remote NE   alias=${alias}
    # sleep   20
    sleep   5
    log to console  \n***DSS UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_timeout***

####################################################################################################################################################
# CRM_connection_lost_during_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination
####################################################################################################################################################
CRM_connection_lost_during_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}

    Log to console  \n***DSS Phase-II CRM_connection_lost_during_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination ***
    sleep   2

    wts.execute egate command    cmd=enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2    alias=${alias}
    Sleep   2
    wts.execute egate command    cmd=enb_cell_param enb=1 id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM     alias=${alias}
    Sleep   2
    wts.execute egate command    cmd=enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:1     alias=${alias}
    sleep   2
    ${cmd}=    Catenate      enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1 assigned_dl_minimum_share_to_nr=15
    ...                                                        assigned_dl_maximum_share_to_nr=70 assigned_dl_minimum_share_to_lte=15
    ...                                                        assigned_dl_maximum_share_to_lte=70 assigned_ul_minimum_share_to_nr=20
    ...                                                        assigned_ul_maximum_share_to_nr=70
    wts.execute egate command    cmd=${cmd}     alias=${alias}
    sleep   5
    wts.execute egate command    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1     alias=${alias}

    # wts.execute egate command and wait for data cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1
    #                                                pass_regexp=CRM Partnership Creation timeout=15
    sleep   20

    wts.execute egate command    cmd=link_drop link=xp by=enb:1 to=gnb:2     alias=${alias}

    sleep   2

    wts.execute egate command    cmd=enb_xp_link_up enb=1 target=2     alias=${alias}

    sleep    2

    log to console  \n***DSS CRM_connection_lost_during_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination ***


