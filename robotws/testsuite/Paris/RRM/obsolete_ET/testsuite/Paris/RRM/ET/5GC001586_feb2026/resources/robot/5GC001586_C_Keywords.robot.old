TC 1586-C-ULOnly_2
    [Documentation]                Generic test for 1586-C: test purpose is to test UL Tput Only
    [Arguments]                    ${param}
    Init Sequence                  ${param}
    # Capture L1L2 Set Upon Config  => means that gnbMirroring.sh will be use
    ${CaptureBIP}                   Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    # set a specific name to keep the trace
    ${CaptureBIP.prefix}   set Variable   L1L2_BIP_GNB_FS
    ${CaptureBIP.withTN}   set Variable   True
    # ${CaptureBIP.interface}      set Variable	       etha01
    # ${CaptureBIP.target.host}           set Variable	       ${GNB_DU.sys[0].M}
    ${CaptureBIP.filter}        Get msgId from lua package      ${param.seq.filtermsg}
    Dated log          CaptureBIP.filter = ${CaptureBIP.filter}
    Set Suite Variable       ${CaptureBIP}

    ${CaptureXP}                Capture L1L2 Set Upon Config             airscale=${GNB_DU}
    ${CaptureXP.prefix}         set Variable   XP_GNB_FS
    ${CaptureXP.withTN}         set Variable   True
    # ${CaptureXP.filter}         set variable      host 10.0.1.111 and udp
    # not host 4.7.254.1  filter part is to filter GTP traffic because of UL Tput
    ${CaptureXP.filter}         set variable      host 10.0.1.111 and udp and not host 4.7.254.1
    Set Suite Variable       ${CaptureXP}

    #define options of gnbMirroring.sh (BIP and BH)
    # ${OPT_GNB_MIRRORING_DSS}                 Tools.Dictionary Get              ${OPT_GNB_MIRRORING}
    # ${OPT_GNB_MIRRORING_DSS.mirroring_mode}             set Variable	       'manual'
    # ${OPT_GNB_MIRRORING_DSS.l2_l1_bip}                 set Variable	       'true'
    # ${OPT_GNB_MIRRORING_DSS.backhaul_mirroring}        set Variable	       'true'
    # Set Suite Variable              ${OPT_GNB_MIRRORING_DSS}
    # Execute Mirror Script with options for DSS      ${CAPTURE_L1L2_GNB_FS_ASIK_DSS.scriptDef}    ${OPT_GNB_MIRRORING_DSS}
    Capture Init                  ${CaptureBIP}

    # Dated log     SSH on ${GNB_DU.sys[0].M.sshId}
    ${aliasASIKGNB}      Run Keyword If     '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'      SSH Wait For Connect      ${GNB_DU.sys[0].M}
    ${tput_log_file_path_gnb}    Run Keyword If  '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'  5GC001586_Keywords.Start tput log capture  gnb_index=0
    ...                                                                                                                  asik_alias=${aliasASIKGNB}

    Capture Start                  ${CaptureXP}
    Traffic UE UL    ueSetting=${UE_SIMPLE_CellDSS}  throughput=${param.seq.ul_throughput}
    ...              duration=${param.seq.timeDuration}  shouldBeStop=True
    ...              shouldBeCheck=${param.seq.shouldBeCheck}  deviation=10
    ...              captureCallback=Callback Capture L1L2
    ...              capture=${CaptureBIP}  captureDuration=10000ms
    Capture Stop                   ${CaptureXP}

    #define options of gnbMirroring.sh (BIP) - to deactivate
    # ${OPT_GNB_MIRRORING_DSS}                 Tools.Dictionary Get              ${OPT_GNB_MIRRORING}
    # ${OPT_GNB_MIRRORING_DSS.mirroring_mode}            set Variable	       'local'
    # ${OPT_GNB_MIRRORING_DSS.l2_l1_bip}                 set Variable	       'true'
    # ${OPT_GNB_MIRRORING_DSS.backhaul_mirroring}        set Variable	       'false'
    # Set Suite Variable              ${OPT_GNB_MIRRORING_DSS}
    # Execute Mirror Script with options for DSS      ${CAPTURE_L1L2_GNB_FS_ASIK_DSS.scriptDef}    ${OPT_GNB_MIRRORING_DSS}

    ${aliasASIKGNB}       Run Keyword If       '${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'       SSH Wait For Connect      ${GNB_DU.sys[0].M}
    Run Keyword If    ${UL_DL_TPUT_CHECK_BASED_AASYSLOG}' == '1'   5GC001586_Keywords.Check Throughput from aasyslog   asik_alias=${aliasASIKGNB}
    ...                                                                                   tput_log_file_path_gnb_combined=${tput_log_file_path_gnb}
    Run Keyword If       '${UL_TPUT_SHOULD_BE_CHECK}' == '1'         5GC001586_Keywords.Convert and Check Xp      ${CaptureXP}
    Run Keyword If       '${UL_TPUT_SHOULD_BE_CHECK}' == '1'         5GC001586_Keywords.Convert and Check Bip     ${CaptureBIP}

    [Teardown]   GenericTest.Display diagnosis


