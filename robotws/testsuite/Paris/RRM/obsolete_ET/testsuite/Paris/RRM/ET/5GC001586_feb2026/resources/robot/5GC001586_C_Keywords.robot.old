#        L1L2_BIP_GNB_FS_UL_TPUT.5GC001586_C_TC_03_5GC001586-C_NSA_Check_UL_Tput.pdml | grep value
Check UL Qos Load Indication MeasuredNgbrNnbrLoad_to_remove
   [Arguments]    ${pdmlFile}   ${value}=00
    #  LOG_PATH instea of OUTPUT
    ${cmd}=   Catenate      grep -n -i enDssUlQosLoadMeasurement.MeasuredNgbrNnbrLoad ${pdmlFile} | grep -n -i 'value="${value}"' |
    ...                            wc -l > ${LOG_PATH}/nbr_enDssUlQosLoadIndMeasuredNgbrNnbrLoad_parsed.txt
    # OperatingSystem.Run      grep -n -i enDssUlQosLoadInd ${pdmlFile} | grep -n -i 'value="${value}"' | wc -l ...
    # ...     > ${LOG_PATH}/nbr_enDssUlQosLoadIndValue_parsed.txt
    OperatingSystem.Run     ${cmd}
    ${output_ul}    OperatingSystem.Run     cat ${LOG_PATH}/nbr_enDssUlQosLoadIndMeasuredNgbrNnbrLoad_parsed.txt
    Should Be True    (${output_ul}>20)

TC 1586-C-UL_Cell_Subcarrier_Resource_Coordination_Update_procedure
    [Documentation]                1586-C : test purpose is UL_Cell_Subcarrier_Resource_Coordination_Update
    [Arguments]                    ${param}      ${alias}=default
    Init Sequence                  ${param}
    WTS Clear
    5GC001586_Keywords.Restart       OwnTLReset=${False}     GNBCallback=5GC001586_Keywords.Set Reset Loop Counter
    Step             common_Dss_Keywords.Start WTS         argument=${alias}              depends=5GC001586_Keywords.Restart
    Step             5GC001586_Keywords.Wait Xp link Up     argument=${alias}            depends=common_Dss_Keywords.Start WTS
    Step             common_Dss_command.X2Ap link Setup     argument=${alias}            depends=common_Dss_Keywords.Start WTS
    Step             Start capture Backhaul for DSS                                      depends=5GC001586_Keywords.Wait Xp link Up
    Step             UL_Cell_Subcarrier_Resource_Coordination_Update   argument=${alias}     depends=Start capture Backhaul for DSS
    ${pdmlFile}      Stop capture Backhaul for DSS
    Step      Check UL Cell Subcarrier Resource Coordination Update procedure   argument=${pdmlFile}
    ...                                                                         depends=UL_Cell_Subcarrier_Resource_Coordination_Update
    Step             Check UL and DL Qos Load Indication    argument=${pdmlFile}     depends=UL_Cell_Subcarrier_Resource_Coordination_Update
    5GC001586_Keywords.Check UL Qos Load Indication MeasuredNgbrNnbrLoad  ${pdmlFile}   value=00    remove_zero_value=False
    Step             Check No DL Cell Subcarrier Resource Coordination Failure   argument=${pdmlFile}
    [Teardown]    GenericTest.Display diagnosis

Verify DSS Coordination Failure Phase2
   [Arguments]                     ${pdmlFile}   ${enDssFailureCause}
   run Keyword if    '${mcshark_present}'=='${False}'    Verify DSS Coordination Failure   pdmlFile=${pdmlFile}
   ...                                                                                        enDssFailureCause=${enDssFailureCause}
   ...  ELSE                                             Verify DSS Coordination Failure using MCShark   pdmlFile=${pdmlFile}
   ...                                                                                        enDssFailureCause=${enDssFailureCause}

TC 1586-C-Check_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait
    [Documentation]                1586-C : test purpose is UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait
    [Arguments]                    ${param}      ${alias}=default
    Init Sequence                  ${param}
    WTS Clear
    Step        common_Dss_Keywords.Start WTS         argument=${alias}       # depends=Restart
    Step        5GC001586_Keywords.Wait Xp link Up     argument=${alias}            depends=common_Dss_Keywords.Start WTS
    Step        common_Dss_command.X2Ap link Setup     argument=${alias}            depends=common_Dss_Keywords.Start WTS
    Step        Start capture Backhaul for DSS                            depends=5GC001586_Keywords.Wait Xp link Up
    Step        UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case1_w_time_to_wait   argument=${alias}
    ...                                                                                           depends=Start capture Backhaul for DSS
    sleep              4
    ${pdmlFile}    Stop capture Backhaul for DSS
    Verify DSS Coordination Failure Phase2   pdmlFile=${pdmlFile}   enDssFailureCause=non_matching_resource_reservation
    Step                           common_Dss_Keywords.Check DSS Active Alarms     argument=7519
    sleep             2
    # to clear the OAM DSS 7519 alarm
    # UL_Cell_Subcarrier_Resource_Coordination_Normal_case   ${alias}
    # to check alarm 7519 not present
    # Check Clear DSS Active Alarms     fault_id=7519
    [Teardown]      Run Keywords    UL_Cell_Subcarrier_Resource_Coordination_Normal_case   ${alias}
    ...    AND    common_Dss_Keywords.Check Clear DSS Active Alarms     fault_id=7519
    ...    AND    GenericTest.Display diagnosis
#    [Teardown]                      Teardown 1586        alias=${alias}

TC 1586-C-Check_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_Case2_w_no_time_to_wait
