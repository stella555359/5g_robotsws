# [session 2]: enb_x2_link_up enb=1 target=2
# [session 2]: enb_dss_param id=1 feature_flag=on message_sets=V1,DMS2
# [session 2]: enb_cell_param enb=1 id=1 lte_nr_dss_mode=DL_CRS_TDM_UL_FDM
# [session 2]: enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:1
# [session 2]: enb_crm_cell_resource_reservation enb=1 cell=1 tgt_enb=2 tgt_cell=1 ...
# ...            assigned_ul_minimum_share_to_nr=20 assigned_ul_maximum_share_to_nr=40
# [session 2]: enb_crm_param id=1 cell_resource_coordination_failure_ttw=1
# [session 2]: crm_management_abnormal_cases enb=1 cell=1 ul_cell_resource_coordination_req_action=no_rsp
# [session 2]: enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=1

# to check the removal procedure
Check removal procedure
    [Arguments]    ${pdmlFile}
    # 0x12 is the msg Id the DSS Removal msg
    ${cmd}=     Catenate     grep -n -i "XpDssMessage-Discriminator (Uint32): 0x00000012" ${pdmlFile} | wc -l
    ...                                                        > ${LOG_PATH}/nbr_removal_procedure_parsed.txt
    OperatingSystem.Run        ${cmd}
    ${output}    OperatingSystem.Run     cat ${LOG_PATH}/nbr_removal_procedure_parsed.txt
    Should Be True    ${output}==1

Check removal procedure Using MCShark
    [Arguments]    ${pdmlFile}
    # 0x12 is the msg Id the DSS Removal msg
    # with MCShark : xp_dss_messages_XpDssMessage_t.discriminator" showname="discriminator (Uint32): 18
    ${cmd}=     Catenate     grep -n -i "xp_dss_messages_XpDssMessage_t.discriminator" ${pdmlFile} | grep -i "discriminator (Uint32): 18" | wc -l
    ...                                                        > ${LOG_PATH}/nbr_removal_procedure_parsed.txt
    OperatingSystem.Run        ${cmd}
    ${output}    OperatingSystem.Run     cat ${LOG_PATH}/nbr_removal_procedure_parsed.txt
    Should Be True    ${output}==1

Check removal procedure Phase2
   [Arguments]                     ${pdmlFile}
   run Keyword if    '${mcshark_present}'=='${False}'    Check removal procedure   pdmlFile=${pdmlFile}
   ...  ELSE                                             Check removal procedure using MCShark   pdmlFile=${pdmlFile}

TC 1586-C_NSA_CRM_connection_lost_during_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination_Procedure
    [Documentation]                1586-C : test purpose is Check_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination_Procedure_Failure_timeout
    [Arguments]                    ${param}     ${alias}=default
    Init Sequence                  ${param}
    WTS Clear
    Step            common_Dss_Keywords.Start WTS          argument=${alias}
    Step            5GC001586_Keywords.Wait Xp link Up     argument=${alias}            depends=common_Dss_Keywords.Start WTS
    Step            common_Dss_command.X2Ap link Setup     argument=${alias}            depends=common_Dss_Keywords.Start WTS
    Step            Start capture Backhaul for DSS                            depends=5GC001586_Keywords.Wait Xp link Up
    Step            CRM_connection_lost_during_EN_DSS_UL_Cell_Subcarrier_Resource_Coordination    argument=${alias}
    ...                                                                                           depends=Start capture Backhaul for DSS
