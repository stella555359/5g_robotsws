#                                                        Test Mode #
CB008662_Define_AirPhone_Test_Modes
    Dated Log                 Defining test modes
    # Enable PDSCH decoding for SSB and TRS
    wtsemu.ue_testmode_decode_muxphychan         decode_mux_phy_chan=decode_PDSCH
    # Set CQI value to have a predfinied DL MCS (~22)
    wtsemu.csi_override_testmode_nr              profile_id=1    cqi=10
    # Define default values for BLER profiles
    # DL RedundancyVersion=0 => NACK, RV=2 => NACK, RV=3 => ACK
    wtsemu.bler_testmode_nr                      profile_id=1    num_harq_nack=2

CB008662_Define_UL_SINR_Test_Mode
    [Arguments]              ${sinr_target_pusch}=-350   ${noise_pusch}=-750
    Dated Log                Set UL SINR Target    
    Dated Log               - UL SINR Target: ${sinr_target_pusch}
    Dated Log               - UL Noise Pusch: ${noise_pusch}
    wtsemu.ul_sinr_testmode_nr             profile_id=1             
	...                                    sinr_target_pusch=${sinr_target_pusch}    
	...                                    noise_pusch=${noise_pusch}
    wtsemu.ul_sinr_testmode_nr             profile_id=1 
    ...                                    pathloss=80
    wtsemu.ul_sinr_testmode_nr             profile_id=1
	Sleep     2s

CB008662_Enable_CQI_Test_Mode
    Dated Log                Enabling CQI test mode for UE1
    # Enable CQI test modes to reduce MCS
    wtsemu.ue_testmode_set_nr    id=1    testmode=csi_override    profile_id=1    action=activate

CB008662_Disable_CQI_Test_Mode
    Dated Log               Disabling CQI test mode for UE1
    # Enable CQI test modes to reduce MCS
    wtsemu.ue_testmode_set_nr    id=1    testmode=csi_override    profile_id=1    action=deactivate

CB008662_Enable_DL_Bler_Test_Mode
    Dated Log               Enabling DL HARQ BLER test mode for UE1
    # Enable DL BLER
    wtsemu.ue_testmode_set_nr    id=1    profile_id=1    testmode=bler    action=activate

CB008662_Disable_DL_Bler_Test_Mode
    Dated Log                Disabling DL HARQ BLER test mode for UE1
    # Disable DL BLER
    wtsemu.ue_testmode_set_nr    id=1    profile_id=1    testmode=bler    action=deactivate

CB008662_Define_UL_Bler_Test_Mode
    Dated Log                Enabling UL BLER test mode for UE1
    # Enable UL BLER
    # Define bit error profile to have RV0 NACK, RV2 NACK, RV3 ACK
    # BLER profile to have systematic NACK for RV=0, 2, 3 and ACK for RV=1
    # Define Uplink BLER bit error profile to have RV0 NACK, RV2 NACK, RV3 ACK
    wtsemu.bler_testmode_nr    profile_id=1
#   ...                        ul_bler=100,100,100,100,100,100,100,100
#   ...                        ul_bler_bit_error=100,80,60,40,0,0,0,0
    ...                        ul_bler_bit_error=100,100,100,20,0,60,100,0
    ...                        ul_bler_bit_error_periodicity=3
    ...                        ul_bler_bit_error_duration=0

CB008662_Define_UL_Cell_Noise    
    Dated Log                Define UL Cell Noise Test Mode
    Dated Log                        - UL noise target: ${UL_SINR_Value}[2][noise_pusch]\n
    wtsemu.ul_cell_noise_testmode_nr    profile_id=1
    ...                                 noise_pucch=-750
    ...                                 noise_pusch=-750
    ...                                 noise_prach=-750
    ...                                 noise_srs=-750
#   ...                                 noise_pusch=${UL_SINR_Value}[2][noise_pusch]

CB008662_Enable_UL_Cell_Noise
    Dated Log                Enable UL Cell Noise Test Mode
    wtsemu.cell_testmode_set_nr     profile_id=1
    ...                             cell_id=1
    ...                             gnb=2
    ...                             testmode=ul_cell_noise
    ...                             action=activate

CB008662_Enable_UL_SINR_Test_Mode
    Dated Log                 Enabling UL SINR test mode for UE1
    wtsemu.ue_testmode_set_nr       id=1    profile_id=1    testmode=ul_sinr    scell=primary    action=activate 


   
CB008662_Enable_UL_Bler_Test_Mode
    Dated Log                 Enabling UL BLER test mode for UE1
    wtsemu.ue_testmode_set_nr       id=1    testmode=bler    profile_id=1    action=activate

