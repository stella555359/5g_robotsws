*** Variables ***
# Defines the maximum number of NACKs received at gNB for a HARQ process,
# after which the next retransmission shall use the PRB/MCS of initial transmission
${RD_AdaptiveReTxNackCountAddr}      0x580678
${RD_AdaptiveReTxNackCountValue}     2
${MaxAdaptiveReTxErrorRatio}         4

# UL BLER level must be the same at the beginning and end of the loop
&{SINR_Level_1}                           sinr_target_pusch=-402        noise_pusch=-660
&{SINR_Level_2}                           sinr_target_pusch=-408        noise_pusch=-660
&{SINR_Level_3}                           sinr_target_pusch=-414        noise_pusch=-660
&{SINR_Level_4}                           sinr_target_pusch=-414        noise_pusch=-660
&{SINR_Level_5}                           sinr_target_pusch=-408        noise_pusch=-660
&{SINR_Level_6}                           sinr_target_pusch=-402        noise_pusch=-660

@{UL_SINR_Value}                          ${SINR_Level_1}   ${SINR_Level_2}     ${SINR_Level_3}
...                                       ${SINR_Level_4}   ${SINR_Level_5}     ${SINR_Level_6}

#CB8862 Adaptives PM counters 
&{CB8662_Initial_and_retransmission_PDSCH_64qam_MCS30}      PM_ID=M55304C02030
...                                                         CELL_1_Expected=0
&{CB8662_Initial_and_retransmission_PDSCH_64qam_MCS31}      PM_ID=M55304C02031
...                                                         CELL_1_Expected=1000000
&{Successful_PDSCH_transmissions_64qam_MCS30}               PM_ID=M55300C02030
...                                                         CELL_1_Expected=0
&{Successful_PDSCH_transmissions_64qam_MCS31}               PM_ID=M55300C02031
...                                                         CELL_1_Expected=0
&{Unsuccessful_PDSCH_transmissions_64qam_MCS30}             PM_ID=M55300C03030
...                                                         CELL_1_Expected=0
&{Unsuccessful_PDSCH_transmissions_64qam_MCS31}             PM_ID=M55300C03031
...                                                         CELL_1_Expected=0
&{CB8662_Initial_and_retransmission_PUSCH_64qam_MCS30}      PM_ID=M55304C04030
...                                                         CELL_1_Expected=0
&{CB8662_Initial_and_retransmission_PUSCH_64qam_MCS31}      PM_ID=M55304C04031
...                                                         CELL_1_Expected=0
&{Successful_PUSCH_transmissions_64qam_MCS30}               PM_ID=M55302C05030
...                                                         CELL_1_Expected=0
&{Successful_PUSCH_transmissions_64qam_MCS31}               PM_ID=M55302C05031
...                                                         CELL_1_Expected=0
&{Unsuccessful_PUSCH_transmissions_64qam_MCS30}             PM_ID=M55302C03030
...                                                         CELL_1_Expected=0
&{Unsuccessful_PUSCH_transmissions_64qam_MCS31}             PM_ID=M55302C03031
...                                                         CELL_1_Expected=0

# KPI Constraint file
