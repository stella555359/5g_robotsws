Verify PRB Demand is within a range of min and max values
    [Documentation]
    [Arguments]             ${nrCell_id}
    ...                     ${direction}
    ...                     ${traffictype}
    ...                     ${min_prb_value}
    ...                     ${max_prb_value}
    ...                     ${result_req}=True
    ${sherpa_file_name}     Set Variable        PrbPoolingAllocationReport_45_.csv
    ${file_path_report}=    Catenate    ${direction}_${sherpa_file_name} 
    Dated Log New Line      ${file_path_report}
    Dated Log New Line      Verify ${traffictype} PRB Demand in ${direction} for NRCELLID: ${nrCell_id} is equal or greater than ${min_prb_value}
    ${min_result}           Verify value with operator in csv Files with Prerequisite
    ...                                         CsvName=${file_path_report}
    ...                                         ColumnName=${traffictype}
    ...                                         valuetocheck=${min_prb_value}
    ...                                         check_operator=<=
    ...                                         directory=${sherpa_output_path}
    ...                                         colum_prereq=${COL_NAME_NRCELLID}
    ...                                         regex_prereq=${nrCell_id}    
    Dated Log New Line      Verify ${traffictype} PRB Demand in ${direction} for NRCELLID: ${nrCell_id} is equal or lower than ${max_prb_value}   
    ${max_result}           Verify value with operator in csv Files with Prerequisite
    ...                                         CsvName=${file_path_report}
    ...                                         ColumnName=${traffictype}
    ...                                         valuetocheck=${max_prb_value}
    ...                                         check_operator=>=
    ...                                         directory=${sherpa_output_path}
    ...                                         colum_prereq=${COL_NAME_NRCELLID}
    ...                                         regex_prereq=${nrCell_id} 
    Run Keyword If          ${min_result} == True and ${max_result} == True
    ...      Dated Log New Line    ${traffictype} of the NRCell: ${nrCell_id} is in the range ${min_prb_value} and ${max_prb_value} PRB
    ...      ELSE        
    ...      Dated Log New Line    ${traffictype} of the NRCell: ${nrCell_id} is outside the range :${min_prb_value} and ${max_prb_value} PRB
    should be true          ${min_result} == ${result_req} 
    should be true          ${max_result} == ${result_req}

CB008940 Verification of DL PRB Allocation
#   Verification of the PRB Allocated to cellId=0x4001 in DL is within range min and max values
    Verify PRB Allocated is within a range of 2 min and max values
        ...                                                         nrCell_id=0x4001
        ...                                                         direction=Dl
        ...                                                         min_prb_value=210
        ...                                                         max_prb_value=230
#   Verification of the PRB Allocated to cellId=0x4002 in DL is within range min and max values
    Verify PRB Allocated is within a range of 2 min and max values
        ...                                                         nrCell_id=0x4002
        ...                                                         direction=Dl
        ...                                                         min_prb_value=250
        ...                                                         max_prb_value=273  
#   Verification of the PRB Allocated to cellId=0x4003 in DL is within range min and max values
    Verify PRB Allocated is within a range of 2 min and max values
        ...                                                         nrCell_id=0x4003
        ...                                                         direction=Dl
        ...                                                         min_prb_value=250
        ...                                                         max_prb_value=273              

CB008940 Verification of UL PRB Allocation
#   Verification of the PRB Allocated to cellId=0x4001 in UL is within range min and max values
    Verify PRB Allocated is within a range of 2 min and max values
        ...                                                         nrCell_id=0x4001
        ...                                                         direction=Ul
        ...                                                         min_prb_value=80
        ...                                                         max_prb_value=95
#   Verification of the PRB Allocated to cellId=0x4002 in UL is within range min and max values
    Verify PRB Allocated is within a range of 2 min and max values
        ...                                                         nrCell_id=0x4002
        ...                                                         direction=Ul
        ...                                                         min_prb_value=80
        ...                                                         max_prb_value=95    
#   Verification of the PRB Allocated to cellId=0x4003 in UL is within range min and max values
    Verify PRB Allocated is within a range of 2 min and max values
        ...                                                         nrCell_id=0x4003
        ...                                                         direction=Ul
        ...                                                         min_prb_value=80
        ...                                                         max_prb_value=95

Verify PRB Allocated is within a range of 2 min and max values
    [Documentation]
    [Arguments]             ${nrCell_id}
    ...                     ${direction}
    ...                     ${min_prb_value}
    ...                     ${max_prb_value}
    ...                     ${result_req}=True
    ${sherpa_file_name}     Set Variable        PrbPoolingAllocationReport_45_.csv
    ${file_path_report}=    Catenate    ${direction}_${sherpa_file_name} 
    Dated Log   ${file_path_report}
    Dated Log New Line      ${file_path_report}
    Dated Log New Line      Verify the number of PRB allocated ${direction} by BBRM to NRCELLID=${nrCell_id}
    ${min_result}           Verify value with operator in csv Files with Prerequisite
    ...                                         CsvName=${file_path_report}
    ...                                         ColumnName=${COL_NAME_NUMPRBALLOC}
    ...                                         valuetocheck=${min_prb_value}
    ...                                         check_operator=<=
    ...                                         directory=${sherpa_output_path}
    ...                                         colum_prereq=${COL_NAME_NRCELLID}
    ...                                         regex_prereq=${nrCell_id}    
    ${max_result}           Verify value with operator in csv Files with Prerequisite
    ...                                         CsvName=${file_path_report}
    ...                                         ColumnName=${COL_NAME_NUMPRBALLOC}
    ...                                         valuetocheck=${max_prb_value}
    ...                                         check_operator=>=
    ...                                         directory=${sherpa_output_path}
    ...                                         colum_prereq=${COL_NAME_NRCELLID}
    ...                                         regex_prereq=${nrCell_id} 
    Run Keyword If          ${min_result} == True and ${max_result} == True
    ...    Dated Log New Line    PRB Allocated to the NRCell:${nrCell_id} in ${direction} is included between:${min_prb_value} & ${max_prb_value}
    ...    ELSE        
    ...    Dated Log New Line    PRB Allocated to the NRCell:${nrCell_id} in ${direction} is outside range:${min_prb_value} & ${max_prb_value}
    should be true          ${min_result} == ${result_req} 
    should be true          ${max_result} == ${result_req}


TTI Trace Collection
    ${TTIdir}      Get TTI Trace Path                 dir_suffix=CB8940-Q-B2
    Dated Log New Line            Start TTI traces capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2
    Traced Sleep    5 seconds    msg=TTI capture
    ${TTIpcap}      Stop TTI Traces in Streaming mode    tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTiTrace_CB8940_CB8662
    Dated Log New Line            Convert TTItrace to json and csv
    # ${TTIjson}      Convert TTItrace from pcap to others    input_file_path=${TTIpcap}
