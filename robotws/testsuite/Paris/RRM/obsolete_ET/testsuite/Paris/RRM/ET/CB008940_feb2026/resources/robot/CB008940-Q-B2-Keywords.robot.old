*** Keywords ***

TC 8940 Interaction with CB008662 DL Retransmission
    [Documentation]
    ...     Conditions:     it is based on the arguments ${param} ${vendor_custom} ${dict_ues} ${nrCell}
    ...     Actions:        it performs the call setup for 3 UES on NrCell belonging to the same L1SubPool with nonGBR traffic
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues and PRB pooling are passed 
    [Arguments]             ${param}
    ...                     ${vendor_custom}
    ...                     ${dict_ues}
    ...                     ${nrCell}
    
    Init Sequence           ${param}
    Step                    CB008940-Q-B2-Keywords.Set RAD Params Of 8940-Q-B2
    Critical Step           Deploy Vendor File Config     vendor_param=${vendor_custom}           is_perform_full_commissioning=${True}
    Dated Log New Line      ${vendor_custom}

    # Configure new ue's dynamically
    ${initial_NbOfUe}       get length          ${dict_ues}
    Run Keyword If          ${initial_NbOfUe} < ${param.totalNbOfUe}    Configure New Ues         ${dict_ues}    
    ...                                                                                           ${initial_NbOfUe}
    ...                                                                                           ${param.totalNbOfUe}
    ...                                                                                           ${dict_settings_ue_default}
    # Configure the current setting for all the ue's
    ${param.totalNbOfUe}    get length          ${dict_ues}
    Step                    Dated Log           Configure the setting for the ${param.totalNbOfUe} ue's
    @{listOfUes}            Create List
    FOR    ${current_id}    IN RANGE    0    ${param.totalNbOfUe}
        ${current_ue}=                Evaluate                      ${current_id} + 1
        ${current_ueSetting}=         Copy Dictionary               ${BASIC_UE_SA}
        Set To Dictionary             ${current_ueSetting}          ue                  ${current_ue}
        Set To Dictionary             ${current_ueSetting}          pdu                 1
        Set To Dictionary             ${current_ueSetting}          trf_id              ${current_ue}
        Set To Dictionary             ${current_ueSetting}          target_gnb          ${param.targetGnb}
        # Dispatching each ue on the requested original cell for the call establishment
        Set To Dictionary             ${current_ueSetting}          target_cells        ${dict_ues[${current_id}].originalCell}
        # Set the correct requested throughput per ue
        Set To Dictionary             ${current_ueSetting}          DL_throughput          ${dict_ues[${current_id}].DL_throughput}
        Set To Dictionary             ${current_ueSetting}          DL_throughput_GBR      ${dict_ues[${current_id}].DL_throughput_GBR}
        Set To Dictionary             ${current_ueSetting}          UL_throughput       ${dict_ues[${current_id}].UL_throughput}
        Append To List                ${listOfUes}                  ${current_ueSetting}
    END
    Dated Log New Line                UE_List=${listOfUes}
    CB008940-Common-Keywords.Check Multi Ues Setting In List        multiUesList=${listOfUes}

    # Setup wtsemu SA for all the ue's
    Traced Sleep            duration=60s                            msg=before setup Wtsemu SA to give radio modules time to start
    Critical Step           CallSetup.Setup Wtsemu SA               nbUe=${param.totalNbOfUe}
    ...                                                             nbSaUe=${param.totalNbOfUe}
    ...                                                             shouldUseLua=${True}
    ###...                                                          nbCell=${param.totalNbOfCell}
    ...                                                             list_of_UE_tobe_created=${listOfUes}
    CB008662_Define_AirPhone_Test_Modes
    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{listOfUes}
                            Critical Step       CallSetup.UE Register
        ...                                                         ue=${current_elem.ue}
        ###...                                                      nwslice=1
        ###...                                                      timeout=30
        ...                 depends=CallSetup.Setup Wtsemu SA
                            Critical Step       CallSetup.Launch PDU Session
        ...                                                         ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         gw=${current_elem.ue}
        ###...                                                      nwslice=1
        ...                 depends=CallSetup.UE Register
    END
    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        set test variable   ${current_elem}
        ${dir}=   set Variable If    ${current_elem.DL_throughput} > ${0}    DL
        ...                                                                  NONE
        ${kw to run}=   Catenate   ${dir} Traffic SA Not Stopped with "${current_elem.DL_throughput}"Mbps "${param.duration}"s duration
        ...                        and "${param.deviation}" percent deviation
        Run Keyword If      ${current_elem.DL_throughput} > ${0}
        ...      Critical Step     ${kw to run}       depends=CallSetup.Launch PDU Session

        ${dir}=   set Variable If    ${current_elem.UL_throughput} > ${0}    UL
        ...                                                                  NONE
        ${kw to run}=   Catenate   ${dir} Traffic SA Not Stopped with "${current_elem.UL_throughput}"Mbps "${param.duration}"s duration
        ...                        and "${param.deviation}" percent deviation
        Run Keyword If      ${current_elem.UL_throughput} > ${0}
        ...      Critical Step     ${kw to run}       depends=CallSetup.Launch PDU Session
    END

    # PDU session modify reserved for the ue's configured with GBR traffic
    ${nbOfUe_traffic_GBR}=   CB008940-Q-B2-Keywords.Get Number Of Ue Configured With GBR Traffic    dict_ues=${listOfUes}
    FOR    ${current_elem}    IN    @{listOfUes}
        Run Keyword If    ${current_elem.DL_throughput_GBR} > ${0}    Run Keywords
        ...                 Critical Step    CallSetup.UE PDU Session Modify
        ...                                                         ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         qfta=2
        ...                                                         by=amf
        ...                                  depends=CallSetup.Launch PDU Session
        ...    AND
        ...                 Critical Step    CallSetup.UE PDU Session Modify
        ...                                                         ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         qfta=3
        ...                                                         by=amf
        ...                                  depends=CallSetup.Launch PDU Session
    END

    # Start the GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        set test variable   ${current_elem}
        ${dir}=   set Variable If    ${current_elem.DL_throughput_GBR} > ${0}    DL
        ...                                                                      NONE
        ${kw to run}=   Catenate    ${dir} Traffic GBR SA Not Stopped with "${current_elem.DL_throughput_GBR}"Mbps "${param.duration}"s duration
        ...                         and "${param.deviation}" percent deviation
        Run Keyword If      '${current_elem.DL_throughput_GBR}' != '0'
        ...    Critical Step   ${kw to run}    depends=CallSetup.Launch PDU Session
    END

    CB008662_Enable_CQI_Test_Mode
    CB008662_Enable_DL_Bler_Test_Mode
    Activate Sherpa On All Cells
    Dated Log New Line            Start Sherpa Traces
    Traced Sleep                    2 seconds
    Dated Log New Line            Stop Sherpa Traces 
    Stop Sherpa Collection   
    TTI Trace Collection
    Collect CB8662 PM Files
    Step          Traced Sleep        duration=10s        msg=deregistering    depends=CallSetup.UE Register    
    # Unregister all the ue's
    FOR    ${current_elem}    IN    @{listOfUes}
        Run Keyword If      ${current_elem.target_cells} != ${nrCell}
        ...                 Step      CallSetup.UE Deregister       id=${current_elem.ue}
        ###...                                                      ue_deregister_type=switch_off
        ###...                                                      by=ue
        ...                                                         depends=CallSetup.UE Register
    END
    # BLER profile deactivation
    Calling Panda Extract Csv For PRB Pooling
    CB008662_Disable_DL_Bler_Test_Mode
    # CQI test mode deactivation
    CB008662_Disable_CQI_Test_Mode
    Dated Log       Latest pm counters file : ${LATEST_PM_FILE}
    Step    KPI Evaluate    pmFile=${LATEST_PM_FILE}   constraintsFile=${constraints_CB008662_DL}    failOnError=${True}   
    Step    CB008940-Common-Keywords.Verification of Pool Id within PRB Pooling Report    pool_id=12    subpool_id=0
    Step    CB008940-Common-Keywords.Verification of Pool Id within PRB Pooling Report    pool_id=12    subpool_id=1
    Step    CB008940-Common-Keywords.Verification of BB Pooling Mode within PRB Pooling Allocation Report    pool_id=12
    Step    CB008940-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4001    subpool_id=0
    Step    CB008940-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4002    subpool_id=1
    Step    CB008940-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4003    subpool_id=0
    Step    CB008940 Verification of DL PRB Demand
    Step    CB008940 Verification of UL PRB Demand
    Step    CB008940 Verification of DL PRB Allocation
    Step    CB008940 Verification of UL PRB Allocation

TC 8940 Interaction with CB008662 UL Retransmission
    [Documentation]
    ...     Conditions:     it is based on the arguments ${param} ${vendor_custom} ${dict_ues} ${nrCell}
    ...     Actions:        it performs the call setup for 3 UES on NrCell belonging to the same L1SubPool with nonGBR raffic
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues and PRB pooling are passed 
    [Arguments]             ${param}
    ...                     ${vendor_custom}
    ...                     ${dict_ues}
    ...                     ${nrCell}

    Init Sequence           ${param}
    Step                    CB008940-Q-B2-Keywords.Set RAD Params Of 8940-Q-B2
    Critical Step           Deploy Vendor File Config     vendor_param=${vendor_custom}           is_perform_full_commissioning=${True}
    Dated Log New Line      ${vendor_custom}
    # Configure new ue's dynamically
    ${initial_NbOfUe}       get length          ${dict_ues}
    Run Keyword If          ${initial_NbOfUe} < ${param.totalNbOfUe}    Configure New Ues         ${dict_ues}    
    ...                                                                                           ${initial_NbOfUe}
    ...                                                                                           ${param.totalNbOfUe}
    ...                                                                                           ${dict_settings_ue_default}
    # Configure the current setting for all the ue's
    ${param.totalNbOfUe}    get length          ${dict_ues}
    Step                    Dated Log           Configure the setting for the ${param.totalNbOfUe} ue's
    @{listOfUes}            Create List
    FOR    ${current_id}    IN RANGE    0    ${param.totalNbOfUe}
        ${current_ue}=                Evaluate                      ${current_id} + 1
        ${current_ueSetting}=         Copy Dictionary               ${BASIC_UE_SA}
        Set To Dictionary             ${current_ueSetting}          ue                  ${current_ue}
        Set To Dictionary             ${current_ueSetting}          pdu                 1
        Set To Dictionary             ${current_ueSetting}          trf_id              ${current_ue}
        Set To Dictionary             ${current_ueSetting}          target_gnb          ${param.targetGnb}
        # Dispatching each ue on the requested original cell for the call establishment
        Set To Dictionary             ${current_ueSetting}          target_cells        ${dict_ues[${current_id}].originalCell}
        # Set the correct requested throughput per ue
        Set To Dictionary             ${current_ueSetting}          DL_throughput          ${dict_ues[${current_id}].DL_throughput}
        Set To Dictionary             ${current_ueSetting}          DL_throughput_GBR      ${dict_ues[${current_id}].DL_throughput_GBR}
        Set To Dictionary             ${current_ueSetting}          UL_throughput       ${dict_ues[${current_id}].UL_throughput}
        Append To List                ${listOfUes}                  ${current_ueSetting}
    END
    Dated Log New Line                UE_List=${listOfUes}
    CB008940-Common-Keywords.Check Multi Ues Setting In List        multiUesList=${listOfUes}

    # Setup wtsemu SA for all the ue's
    Traced Sleep            duration=60s                           msg=before setup Wtsemu SA to give radio modules time to start
    Critical Step           CallSetup.Setup Wtsemu SA               nbUe=${param.totalNbOfUe}
    ...                                                             nbSaUe=${param.totalNbOfUe}
    ...                                                             shouldUseLua=${True}
    ###...                                                          nbCell=${param.totalNbOfCell}
    ...                                                             list_of_UE_tobe_created=${listOfUes}
    CB008662_Define_AirPhone_Test_Modes
    CB008662_Define_UL_SINR_Test_Mode
    CB008662_Define_UL_Bler_Test_Mode
    CB008662_Define_UL_Cell_Noise
    # Register and launch PDU for all the ue's
    FOR    ${current_elem}    IN    @{listOfUes}
                            Critical Step       CallSetup.UE Register
        ...                                                         ue=${current_elem.ue}
        ###...                                                      nwslice=1
        ###...                                                      timeout=30
        ...                 depends=CallSetup.Setup Wtsemu SA
                            Critical Step       CallSetup.Launch PDU Session
        ...                                                         ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         gw=${current_elem.ue}
        ###...                                                      nwslice=1
        ...                 depends=CallSetup.UE Register
    END

    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        set test variable   ${current_elem}
        ${dir}=   set Variable If    ${current_elem.DL_throughput} > ${0}    DL
        ...                                                                  NONE
        ${kw to run}=   Catenate   ${dir} Traffic SA Not Stopped with "${current_elem.DL_throughput}"Mbps "${param.duration}"s duration
        ...                        and "${param.deviation}" percent deviation
        Run Keyword If      ${current_elem.DL_throughput} > ${0}
        ...      Critical Step     ${kw to run}       depends=CallSetup.Launch PDU Session

        ${dir}=   set Variable If    ${current_elem.UL_throughput} > ${0}    UL
        ...                                                                  NONE
        ${kw to run}=   Catenate   ${dir} Traffic SA Not Stopped with "${current_elem.UL_throughput}"Mbps "${param.duration}"s duration
        ...                        and "${param.deviation}" percent deviation
        Run Keyword If      ${current_elem.UL_throughput} > ${0}
        ...      Critical Step     ${kw to run}       depends=CallSetup.Launch PDU Session
    END

    # PDU session modify reserved for the ue's configured with GBR traffic
    ${nbOfUe_traffic_GBR}=   CB008940-Q-B2-Keywords.Get Number Of Ue Configured With GBR Traffic    dict_ues=${listOfUes}
    FOR    ${current_elem}    IN    @{listOfUes}
        Run Keyword If    ${current_elem.DL_throughput_GBR} > ${0}    Run Keywords
        ...                 Critical Step    CallSetup.UE PDU Session Modify
        ...                                                         ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         qfta=2
        ...                                                         by=amf
        ...                                  depends=CallSetup.Launch PDU Session
        ...    AND
        ...                 Critical Step    CallSetup.UE PDU Session Modify
        ...                                                         ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         qfta=3
        ...                                                         by=amf
        ...                                  depends=CallSetup.Launch PDU Session
    END

    # Start the GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        set test variable   ${current_elem}
        ${dir}=   set Variable If    ${current_elem.DL_throughput_GBR} > ${0}    DL
        ...                                                                      NONE
        ${kw to run}=   Catenate    ${dir} Traffic GBR SA Not Stopped with "${current_elem.DL_throughput_GBR}"Mbps "${param.duration}"s duration
        ...                         and "${param.deviation}" percent deviation
        Run Keyword If      '${current_elem.DL_throughput_GBR}' != '0'
        ...    Critical Step   ${kw to run}    depends=CallSetup.Launch PDU Session
    END

    CB008662_Enable_UL_SINR_Test_Mode
    CB008662_Enable_UL_Bler_Test_Mode
    CB008662_Enable_UL_Cell_Noise
    Dated Log New Line            Start Sherpa Traces
    Sherpa.Activate Sherpa
    Traced Sleep                    2 seconds
    Dated Log New Line            Stop Sherpa Traces    
    Stop Sherpa Collection
    TTI Trace Collection
    Collect CB8662 PM Files
    Step          Traced Sleep        duration=10s        msg=deregistering    depends=CallSetup.UE Register    
    # Unregister all the ue's
    FOR    ${current_elem}    IN    @{listOfUes}
        Run Keyword If      ${current_elem.target_cells} != ${nrCell}
        ...                 Step      CallSetup.UE Deregister       id=${current_elem.ue}
        ###...                                                      ue_deregister_type=switch_off
        ###...                                                      by=ue
        ...                                                         depends=CallSetup.UE Register
    END
    Calling Panda Extract Csv For PRB Pooling
    # BLER profile deactivation by Steps
    CB008662_Disable_DL_Bler_Test_Mode
    Dated Log       Latest pm counters file : ${LATEST_PM_FILE}
    Step    KPI Evaluate    pmFile=${LATEST_PM_FILE}   constraintsFile=${constraints_CB008662_UL}    failOnError=${True}
    Step    CB008940-Common-Keywords.Verification of Pool Id within PRB Pooling Report    pool_id=12    subpool_id=0
    Step    CB008940-Common-Keywords.Verification of Pool Id within PRB Pooling Report    pool_id=12    subpool_id=1
    Step    CB008940-Common-Keywords.Verification of BB Pooling Mode within PRB Pooling Allocation Report    pool_id=12
    Step    CB008940-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4001    subpool_id=0
    Step    CB008940-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4002    subpool_id=1
    Step    CB008940-Common-Keywords.Verification of BB Pooling cell distribution within PRB Pooling Report    nrCell_id=0x4003    subpool_id=0
    Step    CB008940 Verification of DL PRB Demand
    Step    CB008940 Verification of UL PRB Demand
    Step    CB008940 Verification of DL PRB Allocation
    Step    CB008940 Verification of UL PRB Allocation

#---------------------------------------------------------------------------------------------------------------------------------------------------
CB008940 Verification of DL PRB Demand
    Dated Log New Line    Verification of DL PRB Demand for each cell
    Step    Verify PRB Demand is within a range of min and max values
    ...                                                         nrCell_id=0x4001
    ...                                                         direction=Dl
    ...                                                         traffictype=${COL_NAME_NOGBRPRBREQUEST} 
    ...                                                         min_prb_value=40
    ...                                                         max_prb_value=60

    Step    Verify PRB Demand is within a range of min and max values
    ...                                                         nrCell_id=0x4001
    ...                                                         direction=Dl
    ...                                                         traffictype=${COL_NAME_GBRPRBREQUEST}
    ...                                                         min_prb_value=40
    ...                                                         max_prb_value=100    

    Step    Verify PRB Demand is within a range of min and max values
    ...                                                         nrCell_id=0x4002
    ...                                                         direction=Dl
    ...                                                         traffictype=${COL_NAME_NOGBRPRBREQUEST} 
    ...                                                         min_prb_value=40
    ...                                                         max_prb_value=60

    Step    Verify PRB Demand is within a range of min and max values
    ...                                                         nrCell_id=0x4002
    ...                                                         direction=Dl
    ...                                                         traffictype=${COL_NAME_GBRPRBREQUEST}
    ...                                                         min_prb_value=40
    ...                                                         max_prb_value=100 

    Step    Verify PRB Demand is within a range of min and max values
    ...                                                         nrCell_id=0x4003
    ...                                                         direction=Dl
    ...                                                         traffictype=${COL_NAME_NOGBRPRBREQUEST} 
    ...                                                         min_prb_value=40
    ...                                                         max_prb_value=60

    Step    Verify PRB Demand is within a range of min and max values
    ...                                                         nrCell_id=0x4003
    ...                                                         direction=Dl
    ...                                                         traffictype=${COL_NAME_GBRPRBREQUEST}
    ...                                                         min_prb_value=40
