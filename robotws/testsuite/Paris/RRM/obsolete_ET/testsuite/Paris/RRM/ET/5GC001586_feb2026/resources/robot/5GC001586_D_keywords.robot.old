########################################################################################################
# Keywords for Capturing Pcap
#########################################################################################################

Start Capture GNB Asik
    [Tags]      CAPTURE
    [Arguments]                 ${prefix}=TC
    ${CAPTURE_CORE}            Capture CORE Set Upon Config
    ${CAPTURE_CORE.prefix}  set Variable    ${prefix}_CORE_GNB_SYS0_M_FP0

    # Get SCF File (SCF.xml) in test setup
    ${current_scf_fullname}    set Variable      ${LOG_PATH}/SCF.xml
    scf.load_scf	 ${current_scf_fullname}
    ${ipAddr}	 scf.get_value_from_scf   p_name=localIpAddr
    ...              dist_name=MRBTS-${MRBTS_ID}/TNLSVC-1/TNL-1/IPNO-1/IPIF-1/IPADDRESSV4-1
    ${ipAddress_XPIFREMOTE}	 scf.get_value_from_scf   p_name=ipAddress
    ...              dist_name=MRBTS-${MRBTS_ID}/MNL-1/MNLENT-1/XPAP-1/XPIF-1/XPIFREMOTE-1

    ${filter}       Catenate      '(src ${ipAddr} and dst ${ipAddress_XPIFREMOTE}) or (src ${ipAddress_XPIFREMOTE} and dst ${ipAddr})'
    ${CAPTURE_CORE.filter}               set variable        ${filter}
    Dated log          CAPTURE_CORE.filter = ${CAPTURE_CORE.filter}

    Set Suite Variable       ${CAPTURE_CORE}
    Capture init             ${CAPTURE_CORE}
    Capture start            ${CAPTURE_CORE}
    ${CAPTURE_CPRT}         Capture CPRT Set Upon Config
    ${CAPTURE_CPRT.prefix}  set Variable     ${prefix}_NODECPRT_GNB
    Set Suite Variable       ${CAPTURE_CPRT}
    Capture init             ${CAPTURE_CPRT}
    Capture start            ${CAPTURE_CPRT}
    pcap.Point to luashark scripts via AF_PATH variable

Stop Capture GNB Asik
    [Tags]      CAPTURE
    Capture stop            ${CAPTURE_CORE}
    Capture stop            ${CAPTURE_CPRT}


############################################################### End Keywords for Capturing #########################################""

