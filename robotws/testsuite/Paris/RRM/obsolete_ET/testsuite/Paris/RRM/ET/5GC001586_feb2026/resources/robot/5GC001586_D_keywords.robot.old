####################################################################################################################################################
# Check BIPs Traces and Xp traces
####################################################################################################################################################

1586-D Check DL Qos Load Indication MeasuredNgbrNnbrLoad
    [Arguments]    ${pdmlFile}      #${value}=4d
    Dated log           ${pdmlFile}         #and  ${value}

    ${cmd}=    Catenate     cat ${pdmlFile} | grep -i 'dssDlQosLoadMeasurement.measuredNgbrNnbrLoad' | grep 'measuredNgbrNnbrLoad (Uint8)' |
    ...                                             awk '{print $9}' | sed -e 's/value="//g' | sed -e 's/"/ /g' | awk '{print $1}'
    ${MeasuredNgbrNnbrLoad}=    OperatingSystem.Run    ${cmd}
    @{lines}    Split To Lines    ${MeasuredNgbrNnbrLoad}
    Remove Values From List     ${lines}     00
    ${length}=    get length     ${lines}
    @{MeasuredNgbrNnbrLoad}    Evaluate    map(lambda x: int(x, 16), @{lines})
    Dated log   MeasuredNgbrNnbrLoad = @{MeasuredNgbrNnbrLoad} and length = ${length}
    ${avg_dl_MeasuredNgbrNnbrLoad}    Evaluate    round(round(sum(@{MeasuredNgbrNnbrLoad}), 1)/round(${length}, 1), 1)

    # ${ul_MeasuredNgbrNnbrLoad_average_hex}=    nps_sweng_tools.calculate_average_of_list_in_file
    # ...                  ${LOG_PATH}/nbr_enDssUlQosLoadIndMeasuredNgbrNnbrLoad_Value_parsed_${TEST_NAME}.txt
    # ${ul_MeasuredNgbrNnbrLoad_average_int}=      Convert To Integer       0x${ul_MeasuredNgbrNnbrLoad_average_hex}
    # ${ul_MeasuredNgbrNnbrLoad_average_int_2}=      Convert To Integer       0x${ul_MeasuredNgbrNnbrLoad_average_int}

    Log many          [DATA TRANSFER] dssDlQosLoadMeasurement MeasuredNgbrNnbrLoad average: ${avg_dl_MeasuredNgbrNnbrLoad}
    Log To Console    \t\t\tDownlink dssDlQosLoadMeasurement.MeasuredNgbrNnbrLoad Avg:\t\t ${avg_dl_MeasuredNgbrNnbrLoad} %

    # to improve with a specific param for dl_ratio, in this case 70%
    ${min}=                         Evaluate                                100 * (100 - 10) / 100
    ${max}=                         Evaluate                                100 * (100 + 10) / 100
    ${status}=                      Evaluate                                ${min} <= ${avg_dl_MeasuredNgbrNnbrLoad} <= ${max}
    Run Keyword If                  '${status}'=='True'
    ...    Dated Log                Average DL DSS Ratio REACHED: expected = 100 % , current = ${avg_dl_MeasuredNgbrNnbrLoad}
    ...    ELSE
    ...    Dated Log                Average DL DSS RATIO NOT REACHED: expected = 100 %, current = ${avg_dl_MeasuredNgbrNnbrLoad}
    Run Keyword If                  '${status}'!='True'                     Fail    DL DSS Ratio

    ${cmd}=    Catenate       grep -n -i dssDlQosLoadMeasurement.measuredNgbrNnbrLoad ${pdmlFile} |
    ...                                grep -n -i 'value="${param.seq.Dl_MeasuredNgbrNnbrLoad}"' |
    ...                                wc -l > ${LOG_PATH}/dssDlQosLoadMeasurement.measuredNgbrNnbrLoad_parsed_${TEST_NAME}.txt
    OperatingSystem.Run         ${cmd}
    # ${value}=49
    # OperatingSystem.Run      grep -n -i enDssUlQosLoadMeasurement.MeasuredNgbrNnbrLoad ${pdmlFile}
    # | grep -n -i 'value="${value}"' | wc -l > ${LOG_PATH}/nbr_enDssUlQosLoadIndMeasuredNgbrNnbrLoad_parsed.txt
    ${output_dl}    OperatingSystem.Run     cat ${LOG_PATH}/dssDlQosLoadMeasurement.measuredNgbrNnbrLoad_parsed_${TEST_NAME}.txt
#    Should Be True    (${output_dl}>0)

# Info;sfn;slot;rnti;csirsTrackingSlotOffset
Extract Usefull info from itf_l2_ps_cell_cellgroupsetupreq Pcap
    [Arguments]                     ${File}
    [Documentation]                 Extract itf_l2_ps_cell_cellgroupsetupreq info from Pcap

    Dated log                   Extract itf_l2_ps_cell_cellgroupsetupreq info from PCAP file [${File}]

    set test variable   ${pcapprocessed_itf_l2_ps_cell_cellgroupsetupreq}    pcapprocessed_Extract_pcapprocessed_itf_l2_ps_cell_cellgroupsetupreq.txt
    set test variable   ${pcapprocessed_itf_l2_ps_cell_cellgroupsetupreq_path}  ${testCaseDir}/${pcapprocessed_itf_l2_ps_cell_cellgroupsetupreq}
    ${cmd_mcshark}    Catenate      tshark -r
    ...        ${File} -T fields -Y "itf_l2_ps_cell_cellgroupsetupreq" -e _ws.col.Info
    ...           -e 3gpp.sfn
    ...           -e 3gpp.slot
    ...           -e 3gpp.rnti
    ...           -e itf_l2_ps_cell_CsiRsTrackingResource.csirsTrackingSlotOffset
    ...           -E header=y -E separator=';' > ${pcapprocessed_itf_l2_ps_cell_cellgroupsetupreq_path}
    Run       ${cmd_mcshark}
    # remove space if present
    Run      command=sed -i -e 's/ //g' ${pcapprocessed_itf_l2_ps_cell_cellgroupsetupreq_path}

    ${extract_col_info}   OperatingSystem.grep file        ${pcapprocessed_itf_l2_ps_cell_cellgroupsetupreq_path}   _ws.col.Info
    ${pattern}=      set variable      itf_l2_ps_cell_CellGroupSetupReq
    ${extract}  OperatingSystem.grep file  ${pcapprocessed_itf_l2_ps_cell_cellgroupsetupreq_path}
    ...                                    ${pattern}
    run keyword if  len($extract)==0     fail   itf_l2_ps_cell_CellGroupSetupReq not found
    OperatingSystem.copy file    ${pcapprocessed_itf_l2_ps_cell_cellgroupsetupreq_path}  ${testCaseDir}/msg_itf_l2_ps_cell_cellgroupsetupreq_pcap.csv

Verify csirsTrackingSlotOffset based on syscom traces
    [Arguments]                   ${csirsTrackingSlotOffset_to_verify}=1
    Dated log     ==========> verify_csirsTrackingSlotOffset_Info from itf_l2_ps_cell_cellgroupsetupreq syscom pcap file
    ${pattern}=     set variable      itf_l2_ps_cell_CellGroupSetupReq
    ${output}=      nps_1586_tools.verify_csirsTrackingSlotOffset_Info     pattern=${pattern}
    ...                                                                    csirsTrackingSlotOffset_to_verify=${csirsTrackingSlotOffset_to_verify}
    [return]    ${output}

Check csirsTrackingSlotOffset Info from Syscom Pcap
    [Documentation]                test purpose is to test csirsTrackingSlotOffset info from syscom pcap
    [Arguments]                    ${capture}    ${csirsTrackingSlotOffset_to_verify}=1
    Extract Usefull info from itf_l2_ps_cell_cellgroupsetupreq Pcap        ${capture}
    ${output}                      Verify csirsTrackingSlotOffset based on syscom traces
    ...                                                                      csirsTrackingSlotOffset_to_verify=${csirsTrackingSlotOffset_to_verify}
    should contain	                ${output}	                            passed
    [return]    ${output}

1586-D Check ssbpos on l2_cell_group_setupreq Pcap
