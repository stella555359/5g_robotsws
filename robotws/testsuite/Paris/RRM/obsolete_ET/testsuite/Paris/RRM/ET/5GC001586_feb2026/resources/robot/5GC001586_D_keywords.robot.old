    ...           value=${param.seq.SlotOffsetValue_1}
    analyzer.check_list             pdmlFile=${pdmlFile}
    ...           packetName=itf_l2_ps_cell_cellgroupsetupreq
    ...           path=.*/itf_l2_ps_cell_cellgroupsetupreq.3./itf_l2_ps_cell_CellGroupSetupReq.csirsTrackingResource_item_3.csirsTrackingSlotOffset$
    ...           value=${param.seq.SlotOffsetValue_2}
    analyzer.check_list             pdmlFile=${pdmlFile}
    ...           packetName=itf_l2_ps_cell_cellgroupsetupreq
    ...           path=.*/itf_l2_ps_cell_cellgroupsetupreq.2./itf_l2_ps_cell_CellGroupSetupReq.csirsTrackingResource_item_3.csirsTrackingSymbol$
    ...           value=${param.seq.SymbolValue_1}
    analyzer.check_list             pdmlFile=${pdmlFile}
    ...           packetName=itf_l2_ps_cell_cellgroupsetupreq
    ...           path=.*/itf_l2_ps_cell_cellgroupsetupreq.3./itf_l2_ps_cell_CellGroupSetupReq.csirsTrackingResource_item_3.csirsTrackingSymbol$
    ...           value=${param.seq.SymbolValue_2}

1586-D Check ssbpos on RRC reconf Pcap
    [Arguments]                     ${capture}
    [Documentation]                 Check ssbposition parameter fron msg SgNBAdditionRequestAcknowledge
    Dated log                       pdml files generation and analysis from [${capture.path}] ...
    ${pdmlFile}                     analyzer.pcap_to_pdml                  ${capture.path}
    analyzer.check_list             pdmlFile=${pdmlFile}
    ...          packetName=SgNBAdditionRequestAcknowledge         #itf_l2_ps_cell_cellsetupreq
    ...          path=.*/nr-rrc.nzp_CSI_RS_ResourceToAddModList/_.3./nr-rrc.NZP_CSI_RS_Resource_element/nr-rrc.periodicityAndOffset/nr-rrc.slots80$
    ...          value=${param.seq.slots80Value_1}
    analyzer.check_list             pdmlFile=${pdmlFile}
    ...          packetName=SgNBAdditionRequestAcknowledge         #itf_l2_ps_cell_cellsetupreq
    ...          path=.*/nr-rrc.nzp_CSI_RS_ResourceToAddModList/_.4./nr-rrc.NZP_CSI_RS_Resource_element/nr-rrc.periodicityAndOffset/nr-rrc.slots80$
    ...          value=${param.seq.slots80Value_2}
