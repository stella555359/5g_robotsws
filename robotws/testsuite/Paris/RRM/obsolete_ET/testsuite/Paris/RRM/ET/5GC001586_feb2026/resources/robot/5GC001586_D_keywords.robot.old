################################################################################################################################################
#Test case for 1586-D
#################################################################################################################################################

TC Verify_Cell_Setup_updates_SSB_Position
    [Documentation]                1586-D Test case for ssb position and for checking DL load indication for 15Mhz and 20Mhz
    [Arguments]                    ${param}         ${egate_alias}=default
    Init Sequence                  ${param}
    5GC001586_Keywords.Restart     OwnTLReset=${False}     GNBCallback=5GC001586_Keywords.Set Reset Loop Counter
    Step              Start Capture GNB Asik        argument=TC_Verify_Cell_Setup_updates_${egate_alias}     depends=5GC001586_Keywords.Restart
    Step              common_Dss_Keywords.Start WTS         argument=${egate_alias}       depends=Start Capture GNB Asik
    Step              5GC001586_Keywords.Wait Xp link Up    argument=${egate_alias}       depends=common_Dss_Keywords.Start WTS
    Step              common_Dss_command.X2Ap link Setup    argument=${egate_alias}       depends=common_Dss_Keywords.Start WTS
   # DSS_Cell_Setup use ${param} variable initialized into the Init Sequence Kw
    Step              5GC001586_Keywords.DSS_Cell_Setup     argument=${egate_alias}       depends=5GC001586_Keywords.Wait Xp link Up
	Step              5GC001586_Ue_command.Verify AP Classical Cell Setup      depends=5GC001586_Keywords.DSS_Cell_Setup
    # Wait gNB cell 5g On air with globalCellId=1
    Critical Step     common_Dss_CellSetup.Wait gNB cell 5g On air     globalCellId=1
    Critical Step     5GC001586_Keywords.Test SgNB Addition PRACH      depends=5GC001586_Ue_command.Verify AP Classical Cell Setup
    Traffic UE DL     ueSetting=${UE_SIMPLE_CellDSS}  throughput=60  duration=1s  shouldBeStop=False    shouldBeCheck=False   deviation=15
    run keyword and ignore error   Stop Capture GNB Asik
    Point AF_PATH to current sw package
    Point ENB_BUILD to luashark sw package
    # run keyword and ignore error    1586-D Check ssbpos on l2_cell_group_setupreq Pcap         ${CAPTURE_CPRT}
    Step    Check csirsTrackingSlotOffset Info from Syscom Pcap    capture=${CAPTURE_CPRT.path}
    ...                                                            csirsTrackingSlotOffset_to_verify=${param.seq.SlotOffsetValue_1}
    Step    Check csirsTrackingSlotOffset Info from Syscom Pcap    capture=${CAPTURE_CPRT.path}
    ...                                                            csirsTrackingSlotOffset_to_verify=${param.seq.SlotOffsetValue_2}
    # 25/08/2023 : only keep high level acceptance criteria (meaning check of attach and Traffic OK)
    # run keyword and ignore error    1586-D Check ssbpos on RRC reconf Pcap                     ${CAPTURE_CORE}
    Point AF_PATH to local luashark XP package
    Point ENB_BUILD to local luashark XP package
    ${capture_BH_GNB}=             set Backhaul Capture                     prefix=BH.XP
    set global variable              ${capture_BH_GNB}
    ${capture_BH_GNB}=             Initialize Filter XP message Capture     capture=${capture_BH_GNB}
    common_Dss_Keywords.Start capture Backhaul XP for DSS New               capture=${capture_BH_GNB}    suffix=CheckQosLoadInd
    Traced Sleep   3s     msg=DL Traffic to test DL Qos load Indication
    ${pdmlFile}           common_Dss_Keywords.Stop capture for Backhaul XP DSS New     capture=${capture_BH_GNB}
    ...                                         lua_path=/home/ute/tools/luashark/generated_luashark-9.1800.330/luashark.lua
    ...                                         suffix=CheckQosLoadInd
    Step          1586-D Check DL Qos Load Indication MeasuredNgbrNnbrLoad     depends=5GC001586_Keywords.Test SgNB Addition PRACH
    ...                            argument=${pdmlFile}
    Step          5GC001586_Keywords.Start capture Bip and Xp for 1586          argument=BIP_L1L2_BH_w_DLTput_${egate_alias}
    Traced Sleep   2s     mgs=take BIP L1L2 and BH pcap traces with DL Tput
    Step              5GC001586_Keywords.Stop capture Bip and Xp for 1586              depends=5GC001586_Keywords.Start capture Bip and Xp for 1586
    Traffic Stop          ueSetting=${UE_SIMPLE_CellDSS}  dir=dl
    [Teardown]        Run keywords     GenericTest.Display diagnosis        AND
    ...                      Run Keyword And Ignore Error    OperatingSystem.File Should Exist   ${CAPTURE_CORE.path}      AND
    ...                      Run Keyword And Ignore Error    OperatingSystem.Copy File    ${CAPTURE_CORE.path}    ${testCaseDir}


TC Check the EN_ DSS_DL_QoS_Load_Indication_procedure
    [Documentation]                1586-D Test case for checking DL load indication for 15Mhz and 20Mhz
    [Arguments]                    ${param}         ${egate_alias}
    Init Sequence                  ${param}
    5GC001586_Keywords.Restart       OwnTLReset=${False}    GNBCallback=5GC001586_Keywords.Set Reset Loop Counter
    Step                   common_Dss_Keywords.Start WTS          argument=${egate_alias}       depends=5GC001586_Keywords.Restart
    Step                   5GC001586_Keywords.Wait Xp link Up     argument=${egate_alias}       depends=common_Dss_Keywords.Start WTS
    Step                   common_Dss_command.X2Ap link Setup     argument=${egate_alias}       depends=common_Dss_Keywords.Start WTS
    # DSS_Cell_Setup use ${param} variable initialized into the Init Sequence Kw
    Step                   5GC001586_Keywords.DSS_Cell_Setup     argument=${egate_alias}        depends=5GC001586_Keywords.Wait Xp link Up
	Step                   5GC001586_Ue_command.Verify AP Classical Cell Setup      depends=5GC001586_Keywords.DSS_Cell_Setup
    Critical Step          5GC001586_Keywords.Test SgNB Addition PRACH
    Step                   common_Dss_Keywords.Start capture Backhaul for DSS              depends=5GC001586_Keywords.Test SgNB Addition PRACH
    Traffic UE DL          ueSetting=${UE_SIMPLE_CellDSS}  throughput=40  duration=3s  shouldBeStop=False    shouldBeCheck=False   deviation=15
    ${pdmlFile}            5GC001586_Keywords.Stop capture Backhaul for DSS to rework
    Step                   1586-D Check DL Qos Load Indication MeasuredNgbrNnbrLoad
    ...                            depends=common_Dss_Keywords.Stop capture Backhaul for DSS to rework
    ...                            argument=${pdmlFile}
    Traffic Stop           ueSetting=${UE_SIMPLE_CellDSS}  dir=dl
    [Teardown]             GenericTest.Display diagnosis


TC Check_UL_Tput
    [Documentation]                Generic test for 1586-D: test purpose is to test UL Tput Only
    [Arguments]                    ${param}         ${egate_alias}
    Init Sequence                  ${param}
    5GC001586_Keywords.Restart      OwnTLReset=${False}    GNBCallback=5GC001586_Keywords.Set Reset Loop Counter
    Step                 common_Dss_Keywords.Start WTS          argument=${egate_alias}       depends=5GC001586_Keywords.Restart
    Step                 5GC001586_Keywords.Wait Xp link Up     argument=${egate_alias}       depends=common_Dss_Keywords.Start WTS
    Step                 common_Dss_command.X2Ap link Setup     argument=${egate_alias}       depends=common_Dss_Keywords.Start WTS
    # DSS_Cell_Setup use ${param} variable initialized into the Init Sequence Kw
    Step                 5GC001586_Keywords.DSS_Cell_Setup      argument=${egate_alias}       depends=5GC001586_Keywords.Wait Xp link Up
    # Wait gNB cell 5g On air with globalCellId=1
	Step                 common_Dss_CellSetup.Wait gNB cell 5g On air      argument=1         depends=5GC001586_Keywords.DSS_Cell_Setup
	Step                 5GC001586_Ue_command.Verify AP Classical Cell Setup                  depends=5GC001586_Keywords.DSS_Cell_Setup
    Critical Step        5GC001586_Keywords.Test SgNB Addition PRACH                  depends=5GC001586_Ue_command.Verify AP Classical Cell Setup
    5GC001586_Keywords.TC 1586-UL_Tput_and_check       ${param}
    [Teardown]           GenericTest.Display diagnosis


TC Check_EN_DSS_UL_Cell_Subcarrier_Resource_Allocation_Procedure_Failure_case
    [Documentation]                1586-D Test case for checking failure case
    [Arguments]                    ${param}         ${egate_alias}
    Init Sequence                  ${param}
    5GC001586_Keywords.Restart        OwnTLReset=${False}     GNBCallback=5GC001586_Keywords.Set Reset Loop Counter
    Step                 common_Dss_Keywords.Start WTS          argument=${egate_alias}       depends=5GC001586_Keywords.Restart
    Step                 5GC001586_Keywords.Wait Xp link Up     argument=${egate_alias}       depends=common_Dss_Keywords.Start WTS
    Step                 common_Dss_command.X2Ap link Setup     argument=${egate_alias}       depends=common_Dss_Keywords.Start WTS
    Step                 5GC001586_Keywords.DSS_Cell_Setup      argument=${egate_alias}       depends=5GC001586_Keywords.Wait Xp link Up
    5GC001586_C_Keywords.TC 1586-C-UL_Cell_SubCarrier_Allocation_Failure_case           ${param}    ${egate_alias}
    [Teardown]            GenericTest.Display diagnosis


Teardown 1586-D
    [Arguments]                 ${alias}=${HOST_EPCSIM.alias}
    BuiltIn.Log      \nTest 1586 ending   console=yes

    # Restore WTS cfg file name
    Run Keyword If   '${Param.seq.bandwidth}'!='10MHz'      restoreFilename

    Run Keyword If  '${TEST STATUS}' == 'FAIL'     5GC001586_Keywords.Collect Logs    ${alias}
    ...    ELSE    Pass Execution If    '${TEST STATUS}' == 'PASS'    Not collect logs

    # OAM Disconnect                          ${GNB_DU.oam}

    # wts.stop_and_collect_wts_logs   subdirectory=${LOG_PATH}
    wts.teardown_all_aliases_for_egate
    wts.teardown_all_aliases_for_edaemon

#################################################################################################################################################
#End Test case for 1586-D
#################################################################################################################################################

