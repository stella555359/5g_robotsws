${TC_4UL_4DL_20MHz_cfg}             ${CURDIR}/../config/TC_4UL_4DL_20MHz_basic.cfg

# Define the UE Fs Id pour each UE (used in check Attach):
${ueFsId_1}                         10
${ueFsId_2}                         11
${ueFsId_3}                         12
${ueFsId_4}                         13

# Define the MaxNumberOfCellGroup Parameters:
${LO_LO_NrCellGroup}                6                                       # value when pooling is not activated
${LO_LO_NrCellGroup_pooling}        12                                      # value when pooling is activated

# Define the Number Of Cells:
${NB_CELLS}                         4

# Define UE profiles. One UE per cells.
&{UE_SIMPLE_Cell1}                  ue=11                                   profile=1
...                                 bearer=2                                testMode=False
...                                 trf_id=1                                burst=${None}
...                                 trf_dl_id=4                             trf_ul_id=1
...                                 target_gnb=2                            target_cells=1
...                                 pdu=${None}                             qfi=${None}
...                                 testModeValue=csi_report_override       type=l3
...                                 throughput=${DEFAUT_THROUGHPUT}         period_ms=${None}
...                                 throughput_dl=${DEFAUT_THROUGHPUT}      throughput_ul=${DEFAUT_THROUGHPUT}
&{UE_SIMPLE_Cell2}                  ue=12                                   profile=1
...                                 bearer=2                                testMode=False
...                                 trf_id=1                                burst=${None}
...                                 trf_dl_id=5                             trf_ul_id=2
...                                 target_gnb=2                            target_cells=2
...                                 pdu=${None}                             qfi=${None}
...                                 testModeValue=csi_report_override       type=l3
...                                 throughput=${DEFAUT_THROUGHPUT}         period_ms=${None}
...                                 throughput_dl=${DEFAUT_THROUGHPUT}      throughput_ul=${DEFAUT_THROUGHPUT}
&{UE_SIMPLE_Cell3}                  ue=13                                   profile=1
...                                 bearer=2                                testMode=False
