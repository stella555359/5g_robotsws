########################  Step A KWs  ########################
CB008830A SCF config
    [Arguments]                 ${actDlDataDmrsFdm}=true    ${Thres64QamMcs}=20    ${Thres256QamMcs}=20    ${HighSpeed}=false

    OAM Get SCF Files
    ${TC_file_name}             getFormattedTestName
    ${DU_SCF}                   Set Variable    ${LOG_PATH}/SCF_DU_${TC_file_name}.xml
    ${std_output}               Run         cp ${SCF_SETUP_PATH} ${DU_SCF}

    SCF StartSession            scf_file=${DU_SCF}

    # Common configuration on both cells
    FOR    ${TDDcell}    IN RANGE    0    2
        ${cellDistName}             Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${TDD_Cell_list[${TDDcell}].nrCellId}

        SCF Set element             dist_name=${cellDistName}
        ...                         element_name=dlDmrsType
        ...                         element_value=Type2

        SCF Set element in List     dist_name=${cellDistName}      list_name=dlDataDmrsFdm
        ...                         element_name=actDlDataDmrsFdm
        ...                         element_value=${actDlDataDmrsFdm}

        SCF Set element in List     dist_name=${cellDistName}      list_name=dlDataDmrsFdm
        ...                         element_name=dlDataDmrsFdmThres64QamMcs
        ...                         element_value=${Thres64QamMcs}

        SCF Set element in List     dist_name=${cellDistName}      list_name=dlDataDmrsFdm
        ...                         element_name=dlDataDmrsFdmThres256QamMcs
        ...                         element_value=${Thres256QamMcs}

        SCF Set element             dist_name=${cellDistName}
        ...                         element_name=actPdschAtSsbSlots
        ...                         element_value=true

        SCF Set element             dist_name=${cellDistName}
        ...                         element_name=actPdschRmCsirsForTracking
        ...                         element_value=true

        SCF Set element             dist_name=${cellDistName}
        ...                         element_name=actAdaptiveReTxResMcs
        ...                         element_value=false

        SCF Set element             dist_name=${cellDistName}
        ...                         element_name=actDlLowPAPRoptimizedPrecoding
        ...                         element_value=false

        SCF Set element             dist_name=${cellDistName}
        ...                         element_name=actEnhancedPDSCHSchSplSlot
        ...                         element_value=false

        SCF Set element             dist_name=${cellDistName}
        ...                         element_name=actDlMuMimoEnh
        ...                         element_value=false

        SCF Set element             dist_name=${cellDistName}
        ...                         element_name=actVoNR
        ...                         element_value=false

        SCF Set element             dist_name=${cellDistName}
        ...                         element_name=actLAForHiReliab
        ...                         element_value=false

        Run Keyword If              "${HighSpeed}" == "true"    Run Keywords
        ...                            SCF Set element                  dist_name=${cellDistName}
        ...                            element_name=actHighSpeedCell    element_value=true
        ...                            AND
        ...                            SCF Set element in List          dist_name=${cellDistName}    list_name=ulPtrs
        ...                            element_name=actUlPtrs           element_value=true
        ...                            AND
        ...                            SCF Set element                  dist_name=${cellDistName}
        ...                            element_name=ulDMRSAdditionalPosition    element_value=Automatic
        ...                            AND
        ...                            SCF Set element                  dist_name=${cellDistName}
        ...                            element_name=dlDMRSAdditionalPosition    element_value=Two additional DMRS
    END

    ${cell_1_DistName}          Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${TDD_Cell_list[0].nrCellId}
    ${cell_2_DistName}          Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${TDD_Cell_list[1].nrCellId}
    ${cell_1_Grp_DistName}      OAM Get NR Cell GROUP    NRCellId=${TDD_Cell_list[0].nrCellId}

    # Disable BF on first cell
    SCF Set element             dist_name=${cell_1_DistName}
    ...                         element_name=actBeamforming
    ...                         element_value=false

    SCF Set element             dist_name=${cell_1_DistName}
    ...                         element_name=numberOfRxBeamforming
    ...                         element_value=2Rx

    SCF Set element in List     dist_name=${cell_1_DistName}      list_name=beamSet
    ...                         element_name=basicBeamSet
    ...                         element_value=beamSet_1

    SCF Set element             dist_name=${cell_1_Grp_DistName}
    ...                         element_name=numberOfTransmittedSsBlocks
    ...                         element_value=1 beam

    # Specific configuration of first cell
    SCF Set element             dist_name=${cell_1_DistName}
    ...                         element_name=actDl256Qam
    ...                         element_value=true

    SCF Set element             dist_name=${cell_1_DistName}
    ...                         element_name=dmrsTypeAPosition
    ...                         element_value=pos2

    Run Keyword If              "${HighSpeed}" != "true"
    ...                         SCF Set element    dist_name=${cell_1_DistName}
    ...                         element_name=dlDMRSAdditionalPosition
    ...                         element_value=One additional DMRS

    # Specific configuration of second cell
    SCF Set element             dist_name=${cell_2_DistName}
    ...                         element_name=actDl256Qam
    ...                         element_value=false

    SCF Set element             dist_name=${cell_2_DistName}
    ...                         element_name=dmrsTypeAPosition
    ...                         element_value=pos3

    Run Keyword If              "${HighSpeed}" != "true"
    ...                         SCF Set element    dist_name=${cell_2_DistName}
    ...                         element_name=dlDMRSAdditionalPosition
    ...                         element_value=One additional DMRS

    SCF StopSession             scf_file=${DU_SCF}
    Set Suite Variable          ${DU_SCF}


#===== check KWs =====
CB008830A TTI check RACH DCI10
    [Arguments]            ${TTIpcap}

    Dated Log New Line     ===> convert TTI trace ${TTIpcap}
    ${TTIjson}             Convert TTI trace from pcap to others    input_file_path=${TTIpcap}
    ${TTIcsv}              decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=100000

    ${nbCheck}             checkAntennaPort_RACH_DCI10    jsonPathName=${TTIjson}
    Should Be True         ${nbCheck}>0


CB008830A TTI check antennaPort
    [Arguments]            ${TTIpcap}    ${RntiDmrsT1List}    ${Thres64QamMcs}=20    ${Thres256QamMcs}=20

    Dated Log New Line     ===> convert TTI trace ${TTIpcap}
    ${TTIjson}             Convert TTI trace from pcap to others    input_file_path=${TTIpcap}
    ${TTIcsv}              decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=100000

    ${nbCheck}             checkAntennaPort_SUMIMO    jsonPathName=${TTIjson}               RntiDmrsT1List=${RntiDmrsT1List}
    ...                                                McsThreshold64Qam=${Thres64QamMcs}    McsThreshold256Qam=${Thres256QamMcs}
    Should Be True         ${nbCheck}>0


CB008830A TTI check antennaPort with DlDataDmrsFdm False
    [Arguments]            ${TTIpcap}    ${RntiDmrsT1List}

    Dated Log New Line     ===> convert TTI trace ${TTIpcap}
    ${TTIjson}             Convert TTI trace from pcap to others    input_file_path=${TTIpcap}
    ${TTIcsv}              decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson}    num_of_events=100000

    ${nbCheck}             checkAntennaPort_noDMRSFDM    jsonPathName=${TTIjson}    RntiDmrsT1List=${RntiDmrsT1List}
    Should Be True         ${nbCheck}>0


CB008830A Verification Of DMRS behaviour for a given Ue
    [Documentation]
    ...     Conditions:     it is based on the argument ${ProfileDMRS_UE_1}
    ...     Actions:        it verifies the DMRS Type, antennaPort, mcs and the number of Cdm Goup Without Data in dldata_pdschsendreq msg
    ...     Checks:         it checks PDSCH IEs values related to DMRS for a given Ue
    ...     Verdict:        PDSCH IEs values are as expected
    [Arguments]             ${ue_DMRSprofile}
    ${filter_exp}           Set Variable    (dldata_pdschsendreq)&&(3gpp.rnti==${ue_DMRSprofile.rnti})
    Dated log               Filter by (dldata_pdschsendreq)&&(3gpp.rnti== ${ue_DMRSprofile.rnti} )
    ${pcapFiltered}         analyzer.filter_pcap
    ...                     pcapInFile=${CaptureL1L2.path}
    ...                     filterName=dldata_pdschsendreq_UEn
    ...                     filterExp=${filter_exp}
    Dated log               Convert pcap to pdml file [pdschsendreq filtered]...
    ${pdml}=                analyzer.pcap_to_pdml    ${pcapFiltered}
    @{ListOfPdschSendReqIEs}           Create List      dlDmrsConfigType        rnti      antPort
    ...     mcs       numOfDmrsCdmGroupWithoutData
    @{lisOfPdschSendReq}            Get Packet Match List
    ...                             pdmlFile=${pdml}
    ...                             packetName=dldata_pdschsendreq
    ...                             pathList=@{ListOfPdschSendReqIEs}
    ...                             startPacket=${1}
    ...                             endPacket=${16}
    ${lenPdschSendReq}              get length          ${lisOfPdschSendReq}
    Dated Log New Line              Total number of PdschSendReq msgs: ${lenPdschSendReq}
    should be true                  ${lenPdschSendReq}!=0
    Dated Log  =====> Start check PDSCH IEs
    #Check PDCCH IEs
    FOR    ${packet}   IN                      @{lisOfPdschSendReq}
           #dlDmrsConfigType
           ${dlDmrsConfigType}                 Get Value In Packet Match
           ...                                 packetMatch=${packet}
           ...                                 field=dlDmrsConfigType
           should be true                      ${dlDmrsConfigType}==${ue_DMRSprofile.dlDmrsConfigType}
           #rnti
           ${rnti}                             Get Value In Packet Match
           ...                                 packetMatch=${packet}
           ...                                 field=rnti
           should be true                      ${rnti}==${ue_DMRSprofile.rnti}
           #antPort
           ${antPort}                          Get Value In Packet Match
           ...                                 packetMatch=${packet}
           ...                                 field=antPort
           should be true                      ${antPort}==${ue_DMRSprofile.antPort}
           #mcs
           ${mcs}                              Get Value In Packet Match
           ...                                 packetMatch=${packet}
           ...                                 field=mcs
           should be true                      ${mcs}>=${ue_DMRSprofile.mcs}
           #numOfDmrsCdmGroupWithoutData
           ${numOfDmrsCdmGroupWithoutData}     Get Value In Packet Match
           ...                                 packetMatch=${packet}
           ...                                 field=numOfDmrsCdmGroupWithoutData
           should be true                      ${numOfDmrsCdmGroupWithoutData}==${ue_DMRSprofile.numOfDmrsCdmGroupWithoutData}
    END

Configuration CB008830-A7

    # Open connection towards cOAM
    sbts_coam.connect_to          name=${gnb_alias}
    # Apply the delta scf according to the TL Topology
    Run Keyword If                  '${GNB_DU.bb[0].M.boardType}'=='ABIO'
    ...                             Run keywords    coam_parameter.perform_scf_delta_commission
    ...                             delta_file=${A7_delta_file_LO}
    ...                             connection=${gnb_alias}
    ...                             skip_parameter_relation_errors=True
    ...                             AND    Dated Log    Perform Scf delta commissioning with Json : ${A7_delta_file_LO}

    ...         ELSE IF             '${GNB_DU.bb[0].M.boardType}'=='ABIP'
    ...                             Run keywords    coam_parameter.perform_scf_delta_commission
    ...                             delta_file=${A7_delta_file_MP}
    ...                             connection=${gnb_alias}
    ...                             skip_parameter_relation_errors=True
     ...                            AND    Dated Log    Perform Scf delta commissioning with Json : ${A7_delta_file_MP}
    ...         ELSE                Return from keyword                     FAIL

    OAM wait available
    OAM Get SCF Files
    ${TC_file_name}             getFormattedTestName
    ${DU_SCF}                   Set Variable    ${LOG_PATH}/SCF_DU_${TC_file_name}.xml
    ${std_output}               Run         cp ${SCF_SETUP_PATH} ${DU_SCF}
    sbts_coam.teardown            connection=${gnb_alias}

