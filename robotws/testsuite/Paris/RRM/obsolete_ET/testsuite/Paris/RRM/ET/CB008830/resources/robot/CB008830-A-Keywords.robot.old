*** Keywords ***
CB008830-A-1
    [Documentation]
    [Arguments]            ${UEdefListparam}

    Init Sequence          ${UEdefListparam}
    Critical Step          CB008830 define UEs            UEdefList=${UEdefListparam}
    Critical Step          CB008830A SCF config           actDlDataDmrsFdm=false
    Critical Step          CB008830 Full Commissioning    scf=${DU_SCF}
    Critical Step          WTS Setup                      shouldUseLua=False
    Critical Step          CB008830 set rank              ${UEs_list}
    Critical Step          CB008830 attach NSA UEs        UElist=${UEs_NSA_list}
    Critical Step          CB008830 attach SA UEs         UElist=${UEs_SA_list}
    Step                   CB008830 Start L1L2 Capture
    Step                   CB008830 start traffic DL      UElist=${UEs_list}
    Step                   CB008830 Stop L1L2 Capture
    Step                   CB008830 start TTI Capture     suffix=A01
    Step                   Traced Sleep                   duration=5s    msg=DL TTI traffic capture
    Step                   CB008830 stop TTI Capture      suffix=A01_Traffic
    Step                   Traced Sleep                   duration=60s    msg=DL traffic
    Step                   CB008830 stop traffic DL       UElist=${UEs_list}
    Step                   CB008830 get PM files
    Step                   CB008830 get RNTI DMRStype1    UElist=${UEs_list}
    Step                   CB008830A TTI check antennaPort with DlDataDmrsFdm False    TTIpcap=${TTIpcap}    RntiDmrsT1List=${UEs_DMRSt1_list}
    Step                   CB008830 check DL BLER         cellID=${TDD_Cell_list[0].nrCellId}    maxBLER=1
    Step                   CB008830 check DL BLER         cellID=${TDD_Cell_list[1].nrCellId}    maxBLER=1
    [Teardown]             Display diagnosis


CB008830-A-5
    [Documentation]
    [Arguments]            ${UEdefListparam}

    Init Sequence          ${UEdefListparam}
    Critical Step          CB008830 define UEs                UEdefList=${UEdefListparam}
    Critical Step          CB008830A SCF config
    Critical Step          CB008830 Full Commissioning        scf=${DU_SCF}
    Critical Step          WTS Setup                          shouldUseLua=False
    Critical Step          CB008830 set rank                  ${UEs_list}
    Step                   CB008830 start TTI Capture         suffix=A05
    Critical Step          CB008830 attach NSA UEs            UElist=${UEs_NSA_list}
    Critical Step          CB008830 attach SA UEs             UElist=${UEs_SA_list}
    Step                   CB008830 stop TTI Capture          suffix=A05_Attach
    ${TTI_Attach}          Set Variable                       ${TTIpcap}
    Step                   CB008830 Start L1L2 Capture
    Step                   CB008830 start traffic DL          UElist=${UEs_list}
    Step                   CB008830 Stop L1L2 Capture
    Step                   CB008830 start TTI Capture         suffix=A05
    Step                   Traced Sleep                       duration=5s     msg=DL TTI traffic capture
    Step                   CB008830 stop TTI Capture          suffix=A05_Traffic
    ${TTI_Traffic}         Set Variable                       ${TTIpcap}
    Step                   Traced Sleep                       duration=60s    msg=DL traffic
    Step                   CB008830 stop traffic DL           UElist=${UEs_list}
    Step                   CB008830 get PM files
    Step                   CB008830 get RNTI DMRStype1        UElist=${UEs_list}
    Step                   CB008830A TTI check RACH DCI10     TTIpcap=${TTI_Attach}
    Step                   CB008830A TTI check antennaPort    TTIpcap=${TTI_Traffic}    RntiDmrsT1List=${UEs_DMRSt1_list}
    Step                   CB008830 check DL BLER             cellID=${TDD_Cell_list[0].nrCellId}    maxBLER=1
    Step                   CB008830 check DL BLER             cellID=${TDD_Cell_list[1].nrCellId}    maxBLER=1
    [Teardown]             Display diagnosis

CB008830-A-7
    [Documentation]
    ...               UEs configurations :
    ...               +-----------------------+---------+---------+---------+---------+
    ...               |      UE # ID          |   UE1   |  UE11   |  UE2    |  UE12   |
    ...               +-----------------------+---------+---------+---------+---------+
    ...               |    Target Cell #      |   CELL1 |  CELL2  |  CELL1  |  CELL2  |
    ...               +-----------------------+---------+---------+---------+---------+
    ...               |   Cell Type TDD/FDD   |   SA    |    SA   |   NSA   |  NSA    |
    ...               +-----------------------+---------+---------+---------+---------+
    ...               |      UE Ranking       |  RANK4  |  RANK4  | RANK4   | RANK4   |
    ...               +-----------------------+---------+---------+---------+---------+
    ...               | supportedDMRS-TypeDL  |  Type 1 | Type 1  | Type 2  | Type 2  |
    ...               +-----------------------+---------+---------+---------+---------+
    [Arguments]            ${UEdefListparam}
    Init Sequence          ${UEdefListparam}
    Step                   CB008830 define UEs    UEdefList=${UEdefListparam}
    # Method 1 : Applied json file according to TL topology either ABIO or ABIP
    # Step                  Configuration CB008830-A7
    Critical Step          CB008830A SCF config
    Critical Step          CB008830 Full Commissioning       scf=${DU_SCF}
    Critical Step          WTS Setup                         shouldUseLua=False
    Step                   CB008830 set rank                 ${UEs_list}
    Step                   CB008830 attach SA UEs            UElist=${UEs_SA_list}
    Step                   CB008830 attach NSA UEs           UElist=${UEs_NSA_list}
    Step                   CB008830-Keywords.Get UE RNTIs
    Step                   CB008830 Start L1L2 Capture
    Step                   CB008830 start traffic DL        UElist=${UEs_list}
    Step                   CB008830 start TTI Capture        suffix=CB008830-A7
    Step                   CB008830 decrease traffic DL       UElist=${UEs_list}
    Step                   CB008830 stop TTI Capture         suffix=CB008830-A7
    ${TTI_Traffic}         Set Variable                       ${TTIpcap}
    Step                   CB008830 Stop L1L2 Capture
    Step                   CB008830 stop traffic DL         UElist=${UEs_list}
    Step                   CB008830 UE Deregister SA UEs    UElist=${UEs_SA_list}
    Step                   CB008830 Unregister NSA UEs      UElist=${UEs_NSA_list}
    Step                   CB008830 Verification Of DMRS behaviour for a given RNTI    ${RntiUe1_int}    ${ProfileDMRS_Type1}
    Step                   CB008830 Verification Of DMRS behaviour for a given RNTI    ${RntiUe11_int}   ${ProfileDMRS_Type1}
    Step                   CB008830 Verification Of DMRS behaviour for a given RNTI    ${RntiUe2_int}    ${ProfileDMRS_Type2}
    Step                   CB008830 Verification Of DMRS behaviour for a given RNTI    ${RntiUe12_int}    ${ProfileDMRS_Type2}
    Step                   CB008830 get RNTI DMRStype1        UElist=${UEs_list}
    Step                   CB008830A TTI check antennaPort    TTIpcap=${TTIpcap}    RntiDmrsT1List=${UEs_DMRSt1_list}
    Step                   CB008830 check DL BLER             cellID=${TDD_Cell_list[0].nrCellId}    maxBLER=1
    Step                   CB008830 check DL BLER             cellID=${TDD_Cell_list[1].nrCellId}    maxBLER=1
    [Teardown]             Display diagnosis

