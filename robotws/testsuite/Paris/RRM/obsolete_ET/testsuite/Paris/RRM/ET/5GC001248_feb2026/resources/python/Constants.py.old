#####################################################
# Configuration parameters (mainly for 1248-J)
#####################################################

# Accepatble threshold for number of packet lost over F1U or X2U
acceptable_lost_threshold = 500

# To enable counter verification at the end of the test
auto_1248_check_counters = True

# Lower bound and upper bound cell ID ranges
auto_1248_cell_lower_bound = 5
auto_1248_cell_upper_bound = 31
auto_1248_default_cell_bound = 8

# To be sure the GP has expired
auto_1248_gp_period = 5

#####################################################
# Debug parameters
#####################################################

#  BTS snapshot will be triggered at the end of the test
auto_1248_get_snapshot = True

# To enable debug to console
auto_1248_j_debug_scf_update = False
