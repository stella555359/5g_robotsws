import csv

# import math


def getSubcellCsv(csvPathName, phycells):
    """
    """
    nbcells = len(phycells)
    subcells = []

    for i in range(nbcells):
        subcells.append(255)

    for phyc in phycells:
        print('phycell=', phyc)

    ulcellSetupList = []

    with open(csvPathName) as csvfile:
        reader = csv.DictReader(csvfile, delimiter=';')
        for row in reader:
            ulcellSetupList.append(row)

    for msg in ulcellSetupList:
        for i in range(nbcells):
            if msg['UlCell_SetupReq_t.physCellId'] == phycells[i]:
                subcells[i] = msg['3gpp.subcellid']

    return subcells


def shift_sfn_slot_pair(pair, sfnMarg, slotMarg):
    """
    """
    newSfn = pair[0] + sfnMarg
    newSlot = pair[1] + slotMarg

    if newSlot >= 20:
        newSfn = newSfn + 1
        newSlot = newSlot % 20

    newSfn = newSfn % 1024

    new_pair = (newSfn, newSlot)

    return new_pair


def getcelldnrad(celldn):
    """
    """
    # celldn = "/MRBTS-1/RAT-1/RUNTIME_VIEW-4/MRBTS_R-4/NRBTS_R-1/NRCELL_R-2"
    celldnspl = celldn.rsplit("-", 1)
    print("celldnspl[0]:", celldnspl[0])
    print("celldnspl[1]:", celldnspl[1])
    return celldnspl[0]
