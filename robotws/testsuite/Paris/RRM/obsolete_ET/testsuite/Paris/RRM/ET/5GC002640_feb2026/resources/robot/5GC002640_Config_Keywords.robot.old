           Append To List     ${modiflist}          ${modify_param}
           Dated log    \n
    END
    OAM Set Params            ${modiflist}            # OAM need a list ....

Set_NRREL_info
    [Documentation]  
    ...              This KW will help to set Set_NRREL_info on line
    ...              need a dicionnary in parameter NRCELL-x=value like following:
    ...              &{NRREL-n=lcrid_TC03}    NRREL-2=4  ...
    ...
    ...              OAM request is done 1 time with a dictionnary created in a loop

    [Arguments]    ${NrRelList}
    Dated log  Arguments: "Set_NRREL_info set ${NrRelList}"
    @{modiflist}    Create List
    FOR    ${i}    IN   @{NrRelList}
           ${value}=         Get From Dictionary    ${NrRelList}      ${i}            # dico  key
           ${dn}             set variable           MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/${Primary}/${i}
           &{modify_param}   Create Dictionary
                             ...                    parameter=lcrId
                             ...                    dist_name=${dn}
                             ...                    value=${value}
           Dated log                                Parameters to modify:  #${modify_param}
           Dated log                                ${modify_param}
           Append To List     ${modiflist}          ${modify_param}
           Dated log    \n
    END
    Dated Log                 ${modiflist}
    OAM Set Params            ${modiflist}            # OAM need a list ....

Set MRBTSID and NRBTSID 2640-AB
    [Documentation]   (FORECASTED Not used)  will help to record new OAM object
    ${nrbts_dist_name}              Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    ${nrdu_dist_name}               Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRDU-1
    Set Suite Variable              ${nrbts_dist_name}
    Set Suite Variable              ${nrdu_dist_name}
    FOR    ${i}    IN RANGE    1  7
          ${nrcell_dist_name${i}}             Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${i}
        Set Suite Variable                      ${nrcell_dist_name${i}}
    END
    FOR    ${i}    IN RANGE    1  5
          ${nrrell_dist_name${i}}             Set Variable    MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRREL-${i}
        Set Suite Variable                      ${nrrell_dist_name${i}}
    END


Setup Config Files
    [Documentation]   (FORECASTED Not used)  Update config files (SCF, iphy.xml and basic.cfg) with needed information

    [Arguments]    ${test_name}
    ...            ${test_param}
    ...            ${tl_type}=${EMPTY}

    Dated log  Arguments 1: ${test_name}
    Dated log  Arguments 2: ${test_param}
    Dated log  Arguments 3: ${tl_type}
    Set MRBTSID and NRBTSID 2640-AB

    # copy the initial SCF_Setup.xml (previously backup by Suite Setup From Scratch)
    Set Suite Variable    ${test_scf_file_path}    ${LOG_PATH}/SCF_Test.xml
    ${output}    run    cp ${SCF_SETUP_PATH} ${test_scf_file_path}

    # XML config file where to take data to be inserted in SCF
    # (file name = <test name without [1] prefix>.xml, "+" is not accepted as filename in CI --> replace it by "_")
    ${test_cfg_file_name}    run    echo ${test_name}.xml | sed s/^\\\\[1\\\\]// | sed s/+/_/g
    ${test_cfg_file_path}    Set Variable    ${CURDIR}/../config/${test_cfg_file_name}

    # Add objects needed for the test to the copied SCF
    Get Data From Config Xml File And Add to Scf    ${test_cfg_file_path}    ${test_scf_file_path}

    Set Specific Parameters In SCF    scf_file=${test_scf_file_path}
    ...                               test_param=${test_param}
    ...                               nrbts_dname=${nrbts_dist_name}
    ...                               nrdu_dname=${nrdu_dist_name}
    ...                               nrcell_dname=${nrcell_dist_name}              #### est ce que je passe les 6 references ?
    ...                               nrrell_dname=${nrrell_dist_name}

    Update WTS Cfg File    ${test_param.nrarfcnUl}
    ...                    ${test_param.nrarfcnDl}
    ...                    ${test_param.ue_nr_capa}

    Update Iphy Xml Cfg File    ${test_param.gscn}

Set Specific Parameters In SCF
    [Documentation]   (FORECASTED Not used) will be used if scf is recrated from another one
    [Arguments]    ${scf_file}
    ...            ${test_param}
    ...            ${nrbts_dname}
    ...            ${nrdu_dname}
    ...            ${nrcell_dname}
    ...            ${nrrell_dname}
    Dated log  Arguments 1: ${scf_file}   
    Dated log  Arguments 2: ${test_param}
    Dated log  Arguments 3: ${nrbts_dname}
    Dated log  Arguments 4: ${nrdu_dname}
    Dated log  Arguments 5: ${nrcell_dname}
    Dated log  Arguments 6: ${nrrell_dname}
    SCF StartSession    scf_file=${scf_file}

    # Update BWP list to use the objects define in the configuration XML files
    ${list_name}               Set Variable    cellBwpList

    SCF Remove List            dist_name=${nrcell_dname}
    ...                        list_name=${list_name}

    SCF Add List               dist_name=${nrcell_dname}
    ...                        list_name=${list_name}

    ${item_dict}               Create Dictionary
    Set To Dictionary          ${item_dict}    bwpDN=${test_param.firstBwpDN}
    Set To Dictionary          ${item_dict}    cellBwpId=${test_param.firstCellBwpId}
    SCF Add Items To List      dist_name=${nrcell_dname}
    ...                        list_name=${list_name}
    ...                        elements=${item_dict}

    ${item_dict}               Create Dictionary
    Set To Dictionary          ${item_dict}    bwpDN=${test_param.secondBwpDN}
    Set To Dictionary          ${item_dict}    cellBwpId=${test_param.secondCellBwpId}
    SCF Add Items To List      dist_name=${nrcell_dname}
    ...                        list_name=${list_name}
    ...                        elements=${item_dict}

    # nrbts update

    SCF Set element    dist_name=${nrbts_dname}
    ...                element_name=actLteNrDss
    ...                element_value=${test_param.actLteNrDss}

    #24R2 evolution
    # SCF Set element    dist_name=${nrbts_dname}
    # ...                element_name=actGeneralConnectivitySilver
    # ...                element_value=${test_param.actGeneralConnectivitySilver}

    # SCF Set element    dist_name=${nrbts_dname}
    # ...                element_name=actGeneralConnectivityGold
    # ...                element_value=${test_param.actGeneralConnectivityGold}

    # nrcell group update

    SCF Set element    dist_name=${nrcellgrp_dname}
    ...                element_name=scs
    ...                element_value=${test_param.scs}

    # nrcell update

    SCF Set element    dist_name=${nrcell_fdd_dname}
    ...                element_name=nrarfcnDl
    ...                element_value=${test_param.nrarfcnDl}

    SCF Set element    dist_name=${nrcell_fdd_dname}
    ...                element_name=chBwUl
    ...                element_value=${test_param.chBwUl}

    SCF Set element    dist_name=${nrcell_fdd_dname}
    ...                element_name=nrarfcnUl
    ...                element_value=${test_param.nrarfcnUl}

    SCF Set element    dist_name=${nrcell_fdd_dname}
    ...                element_name=chBwDl
    ...                element_value=${test_param.chBwDl}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=${gscnParameterName}
    ...                element_value=${test_param.gscn}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=ssbScs
    ...                element_value=${test_param.ssbScs}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=type0CoresetConfigurationIndex
    ...                element_value=${test_param.type0CoresetConfigurationIndex}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=lteNrDssMode
    ...                element_value=${test_param.lteNrDssMode}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=aggregationLevel
    ...                element_value=${test_param.aggregationLevel}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=actPRBBlanking
    ...                element_value=${test_param.actPRBBlanking}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=nbrOfBlankedPRBsHighEdgeDL
    ...                element_value=${test_param.nbrOfBlankedPRBsHighEdgeDL}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=nbrOfBlankedPRBsHighEdgeUL
    ...                element_value=${test_param.nbrOfBlankedPRBsHighEdgeUL}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=nbrOfBlankedPRBsLowEdgeDL
    ...                element_value=${test_param.nbrOfBlankedPRBsLowEdgeDL}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=nbrOfBlankedPRBsLowEdgeUL
    ...                element_value=${test_param.nbrOfBlankedPRBsLowEdgeUL}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=msg1FrequencyStart
    ...                element_value=${test_param.msg1FrequencyStart}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=dmrsTypeAPosition
    ...                element_value=${test_param.dmrsTypeAPosition}

    SCF Set element    dist_name=${nrcell_dname}
    ...                element_name=trsMutingInBlankedPRBsEnabled
    ...                element_value=${test_param.trsMutingInBlankedPRBsEnabled}

    #FTS bouchon 2/3 SCF StopSession    scf_file=${scf_file}
    #     manque commissioning    !!!!!!!

Set SCF Context DSS
    [Documentation]    (FORECASTED Not used) present here as a collection if automatisation
    ...                of this part becomes mandatory
    ${SCF_MODIFIED}         OAM Change String in SCF          oldVal=MRBTS-1/NRBTS-1     newVal=MRBTS-1/NRBTS-2
    SCF StartSession                scf_file=${SCF_MODIFIED}

    ${dist_name}         Set Variable    MRBTS-1
    SCF Set element    dist_name=${dist_name}    element_name=btsName  element_value=5GC002640-F
    
    ${dist_name}         Set Variable    MRBTS-1/NRBTS-2
    #24R2 evolution
    # SCF Set element    dist_name=${dist_name}    element_name=actGeneralConnectivityGold  element_value=true
    SCF Set element    dist_name=${dist_name}    element_name=actLteNrDss   element_value=true
    SCF Set element    dist_name=${dist_name}    element_name=sCellActivationMethod   element_value=blind

    ${dist_name}         Set Variable    MRBTS-1/NRBTS-2/NRCELL-1
    SCF Set element    dist_name=${dist_name}    element_name=sCellDeactivationTimerGNB   element_value=infinity
    SCF Set element    dist_name=${dist_name}    element_name=srPeriodicity   element_value=slots80

    ${dist_name}         Set Variable    MRBTS-1/NRBTS-2/NRCELL-2
    SCF Set element    dist_name=${dist_name}    element_name=actPRBBlanking   element_value=true
    SCF Set element    dist_name=${dist_name}    element_name=actPdschAtSsbSlots   element_value=true
    SCF Set element    dist_name=${dist_name}    element_name=actPdschRmCsirsForTracking   element_value=true
    SCF Set element    dist_name=${dist_name}    element_name=lteNrDssMode   element_value=DL_CRS_TDM_UL_FDM
    SCF Set element    dist_name=${dist_name}    element_name=msg1FrequencyStart   element_value=9
    SCF Set element    dist_name=${dist_name}    element_name=nbrOfBlankedPRBsHighEdgeDL   element_value=2
    SCF Set element    dist_name=${dist_name}    element_name=nbrOfBlankedPRBsHighEdgeUL   element_value=2
    SCF Set element    dist_name=${dist_name}    element_name=pagingOffset   element_value=2
    SCF Set element    dist_name=${dist_name}    element_name=pucchF3ModulationScheme   element_value=pi2bpsk
    SCF Set element    dist_name=${dist_name}    element_name=trsMutingInBlankedPRBsEnabled   element_value=true
    SCF Set element    dist_name=${dist_name}    element_name=type0SearchSpaceConfigurationIndex   element_value=15
    SCF Set element    dist_name=${dist_name}    element_name=sCellDeactivationTimerGNB   element_value=infinity
    SCF Set element    dist_name=${dist_name}    element_name=srPeriodicity   element_value=slots80

    SCF Remove list    dist_name=${dist_name}    list_name=cellBwpList
    SCF Add list       dist_name=${dist_name}    list_name=cellBwpList

    &{cellBwpList}     Create Dictionary    bwpDN=MRBTS-1/NRBTS-2/BWP_PROFILE-162   cellBwpId=0
    SCF Add items to list   dist_name=${dist_name}    list_name=cellBwpList   elements=${cellBwpList}
    &{cellBwpList}     Create Dictionary    bwpDN=MRBTS-1/NRBTS-2/BWP_PROFILE-173   cellBwpId=1
    SCF Add items to list   dist_name=${dist_name}    list_name=cellBwpList   elements=${cellBwpList}

    SCF Set element in List    dist_name=${dist_name}    list_name=csirsForTracking     element_name=csirsTrackingPeriod   element_value=40ms

    ${dist_name}         Set Variable    MRBTS-1/NRBTS-2/NRCELL-2/NRREL-0
    SCF Set element    dist_name=${dist_name}    element_name=gNbId   element_value=2

    ${dist_name}         Set Variable    MRBTS-1/NRBTS-2/NRSYSINFO_PROFILE-2
    SCF Set element    dist_name=${dist_name}    element_name=siWindowLength   element_value=s160
    SCF Set element    dist_name=${dist_name}    element_name=systemInformationTargetRate   element_value=0

    SCF Remove list    dist_name=${dist_name}    list_name=sibSchedulingList
    SCF Add list       dist_name=${dist_name}    list_name=sibSchedulingList

    &{sibSchedulingList}     Create Dictionary    sibBroadcastStatus=broadcasting   sibPeriodicity=rf64   sibScope=cellSpecific   sibType=sibType2
    SCF Add items to list   dist_name=${dist_name}    list_name=sibSchedulingList   elements=${sibSchedulingList}
    &{sibSchedulingList}     Create Dictionary    sibBroadcastStatus=broadcasting   sibPeriodicity=rf64   sibScope=cellSpecific   sibType=sibType3
    SCF Add items to list   dist_name=${dist_name}    list_name=sibSchedulingList   elements=${sibSchedulingList}
    &{sibSchedulingList}     Create Dictionary    sibBroadcastStatus=broadcasting   sibPeriodicity=rf64   sibScope=cellSpecific   sibType=sibType4
    SCF Add items to list   dist_name=${dist_name}    list_name=sibSchedulingList   elements=${sibSchedulingList}
    &{sibSchedulingList}     Create Dictionary    sibBroadcastStatus=broadcasting   sibPeriodicity=rf64   sibScope=cellSpecific   sibType=sibType5
    SCF Add items to list   dist_name=${dist_name}    list_name=sibSchedulingList   elements=${sibSchedulingList}

	${dist_name}         Set Variable    MRBTS-1/NRBTS-2/NRPMRNL-1
	SCF Set element    dist_name=${dist_name}    element_name=miNrEnDssPerCell   element_value=5min

    SCF StopSession      scf_file=${SCF_MODIFIED}
    Dated Log    ----> Modifications completed.\n

    #BOUCHON ON UTILISE LA CONFIG TELLE QUELLE PRMEIER TEMPS OAM Perform Full Commissioning          scf_file=${SCF_MODIFIED}
    WA Airscale Wait For Ready                  ${GNB_DU}
    Dated Log    ----> Airscale Ready.\n

