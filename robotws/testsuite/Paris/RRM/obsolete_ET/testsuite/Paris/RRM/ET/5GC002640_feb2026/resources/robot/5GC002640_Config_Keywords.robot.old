*** Keywords ***
#****************************** Keywords for Test Line configuration ***************************************
PM_StatisticsInterval
    [Documentation]  
    ...              This KW will help to set
    ...             		firstLevelSchedulerStatisticsInterval &
    ...                     secondLevelSchedulerStatisticsInterval  value on line

    [Arguments]    ${value}
    Dated Log       "LevelSchedulerStatisticsInterval set >${value}<"
    ${dn}           set variable           MRBTS-1/TNLSVC-1/PMTNLINT-1
    ${result}       set variable           ${value}

    @{modiflist}    Create List
    &{modify_param}   Create Dictionary
    ...               parameter=firstLevelSchedulerStatisticsInterval
    ...               dist_name=${dn}
    ...               value=${result}
    Dated log                                Parameters to modify:  #${modify_param}
    Dated log                                ${modify_param}
    Append To List     ${modiflist}          ${modify_param}
    Dated log    \n

    Dated Log       "debug modiflist >${modiflist}<"
    OAM Set Params            ${modiflist}          # OAM need a list ....

    @{modiflist}    Create List
    &{modify_param}   Create Dictionary
    ...               parameter=secondLevelSchedulerStatisticsInterval
    ...               dist_name=${dn}
    ...               value=${result}
    Dated log                                Parameters to modify:  #${modify_param}
    Dated log                                ${modify_param}
    Append To List     ${modiflist}          ${modify_param}
    Dated log    \n

    Dated Log       "debug modiflist >${modiflist}<"
    OAM Set Params            ${modiflist}          # OAM need a list ....

    ${dn}           set variable           MRBTS-1/MNL-1/MNLENT-1/PMCADM-1
    @{modiflist}    Create List
    &{modify_param}   Create Dictionary
    ...               parameter=reportingIntervalPm
    ...               dist_name=${dn}
    ...               value=${result}
    Dated log                                Parameters to modify:  #${modify_param}
    Dated log                                ${modify_param}
    Append To List     ${modiflist}          ${modify_param}
    Dated log    \n

    Dated Log       "debug modiflist >${modiflist}<"
    OAM Set Params            ${modiflist}          # OAM need a list ....
 
Set_sCellDeactivationTimerGNB
    [Documentation]  
    ...              This KW will help to set sCellDeactivationTimerGNB value on line
    ...              OAM request is done 1 time with a dictionnary created in a loop

    [Arguments]    ${value}
    Dated Log       "sCellDeactivationTimerGNB set >${value}<"
    #essai a effacer ${result}=      Convert To Integer 	${value}
    ${result}       set variable                    ${value}

    @{modiflist}    Create List
    FOR    ${i}     IN RANGE    1    7
           ${dn}             set variable           MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${i}
           &{modify_param}   Create Dictionary
                             ...                    parameter=sCellDeactivationTimerGNB
                             ...                    dist_name=${dn}
                             ...                    value=${result}
           Dated log                                Parameters to modify:  #${modify_param}
           Dated log                                ${modify_param}
           Append To List     ${modiflist}          ${modify_param}
           Dated log    \n
    END
    Dated Log       "debug modiflist >${modiflist}<"
    OAM Set Params            ${modiflist}          # OAM need a list ....

Set_sCellActivationMethod
    [Documentation]  
    ...              This KW will help to set sCellActivationMethod on line
    ...              OAM request is done 1 time with a dictionnary created in a loop

    [Arguments]    ${value}
    Dated Log      "Set_sCellActivationMethod set ${value}"
    @{modiflist}    Create List
           ${dn}             set variable           MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
           &{modify_param}   Create Dictionary
                             ...                    parameter=sCellActivationMethod
                             ...                    dist_name=${dn}
                             ...                    value=${value}
           Dated log                                Parameters to modify:  #${modify_param}
           Dated log                                ${modify_param}
           Append To List     ${modiflist}          ${modify_param}
           Dated log    \n

    OAM Set Params            ${modiflist}            # OAM need a list ....

Set_iniNumSCellsToActivate
    [Documentation]  
    ...              This KW will help to set iniNumSCellsToActivate on line
    ...              OAM request is done 1 time with a dictionnary created in a loop

    [Arguments]    ${value}
    Dated Log      "Set_iniNumSCellsToActivate set ${value}"
    @{modiflist}    Create List
    FOR    ${i}    IN RANGE    1    7
           ${dn}             set variable           MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${i}
           &{modify_param}   Create Dictionary
                             ...                    parameter=iniNumSCellsToActivate
                             ...                    dist_name=${dn}
                             ...                    value=${value}
           Dated log                                Parameters to modify:  #${modify_param}
           Dated log                                ${modify_param}
           Append To List     ${modiflist}          ${modify_param}
           Dated log    \n
    END
    OAM Set Params            ${modiflist}            # OAM need a list ....

Commission SCF From Config Folder
    [Documentation]  FORECAST Commission SCF from config folder.
    ...              This KW is not yes used  
    Dated Log    [Commissioning SCF of the feature]
    OAM Perform Full Commissioning    ${test_scf_file_path}
    # If gNB was rebooted after re-commissioning, wait until it's ready again.
    Airscale Wait for Ready    ${GNB_DU}
    Dated Log      -----> Commissioning completed

carrierAggregationSupportList set to 600
    [Documentation]  This KW will help to set carrierAggregationSupportList on line
    ...              to ca_Fdd_Any_Sa (600)  uppon 
    ...              3: ca_Fdd_Fdd,
    ...              200: ca_Fdd_Fr1Tdd_Sa,
    ...              This KW structure help to eventually address several parameters

    Dated Log    "carrierAggregationSupportList set"

    @{CASL}=                        create list    ca_Fdd_Fdd    ca_Fdd_Fr1Tdd_Sa    ca_Fdd_Any_Sa
    ${dn}                           set variable   MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRDU-1
    ${param}                        set variable   carrierAggregationSupportList

    &{modify_param1}                Evaluate  {'dist_name':'${dn}','parameter':'${param}','value':${CASL}}

    @{modify_param}                 Create List    ${modify_param1}

    Dated log                       Parameters to modify:  #${modify_param}
    Dated log                       ${modify_param1}

    OAM Set Params      ${modify_param}


#****************************** Keywords for setup and teardown ***************************************
Set Context_WTS CFG cell
    [Documentation]      This KW help to set enb set_cell id value
    WtsCfgConfig.startSession
    ${oldValue}          getParam           prefix=set_cell    param=id
    replaceValue         prefix=set_cell
    ...                  param=id
    ...                  oldValue=${oldValue}
    ...                  newValue=${param.set_cell_enb_id}
    ...                  occurrence=1

    WtsCfgConfig.stopSession         rename=modified

#****************************** Keywords for config files setup ***************************************
maxNumScellsDl
    [documentation]   	Maximum number of secondary cells for DL carrier aggregation
    ...                 maximum number of secondary cells (S-Cells) a gNB can configure in the 5G UE for DL carrier
    ...                 aggregation in addition to the primary cell (P-Cell).
    ...                 MRBTS-1/NRBTS-1
    [Arguments]    ${value}
    @{modiflist}    Create List
    ${dn}             set variable           MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    &{modify_param}   Create Dictionary
                        ...                    parameter=maxNumScellsDl
                        ...                    dist_name=${dn}
                        ...                    value=${value}
    Dated log                                Parameters to modify:  #${modify_param}
    Dated log                                ${modify_param}
    Append To List     ${modiflist}          ${modify_param}
    Dated log    \n
    OAM Set Params           ${modiflist}            # OAM need a list ....

maxNumScellsDlFr1
    [documentation]   	maxNumScellsDlFr1 setting
    ...                 It indicates the maximum number of FR1 secondary cells (S-Cells) a gNB can configure in the 5G
    ...                 UE for DL carrier aggregation in addition to the primary cell (P-Cell).
    ...                 It is only applied to 4CC and above CA.Maximum number of secondary cells for DL carrier aggregation
    ...                 MRBTS-1/NRBTS-1/primarycell
    #attention il y a une dependance avec un autre parametre dont je ne me souviens plus le nom (passage a true) 
    #=> a faire 
    [Arguments]    ${value}
    @{modiflist}     Create List
    @{modiflist2}    Create List

    #24R2 evolution
    # #actGeneralConnectivityGold need to be set to true prior maxNumScellsDlFr1
    # ${dn}             set variable           MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}
    # &{modify_param}   Create Dictionary
    #                     ...                    parameter=actGeneralConnectivityGold 
    #                     ...                    dist_name=${dn}
    #                     ...                    value=true
    # Dated log                                Parameters to modify:  #${modify_param}
    # Dated log                                ${modify_param}
    # Append To List     ${modiflist}          ${modify_param}
    # Dated log    \n
    # OAM Set Params            ${modiflist}            # OAM need a list ....

    ${dn}             set variable           MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/${param.nrcellPrimary}
    &{modify_param2}   Create Dictionary
                        ...                    parameter=maxNumScellsDlFr1 
                        ...                    dist_name=${dn}
                        ...                    value=${value}
    Dated log                                Parameters to modify:  #${modify_param}
    Dated log                                ${modify_param2}
    
    Append To List     ${modiflist2}          ${modify_param2}
    OAM Set Params            ${modiflist2}            # OAM need a list ....

weightForSCellSelection
    [Documentation]  
    ...              This KW will help to set weightForSCellSelection on line
    ...              need a dicionnary in parameter NRCELL-x=value like following:
    ...              &{NrRelweightForSCellSelection_List}    NRCELL-1=60    NRCELL-2=80    NRCELL-3=50   ...
    ...
    ...              OAM request is done 1 time with a dictionnary created in a loop

    [Arguments]    ${NrRelList}
    Dated Log      "weightForSCellSelection set ${NrRelList}"
    @{modiflist}    Create List
    FOR    ${i}    IN   @{NrRelList}
           ${value}=         Get From Dictionary    ${NrRelList}      ${i}            # dico  key
           ${dn}             set variable           MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/${i}
           &{modify_param}   Create Dictionary
                             ...                    parameter=weightForSCellSelection
                             ...                    dist_name=${dn}
                             ...                    value=${value}
           Dated log                                Parameters to modify:  #${modify_param}
           Dated log                                ${modify_param}
           Append To List     ${modiflist}          ${modify_param}
           Dated log    \n
    END
    OAM Set Params            ${modiflist}            # OAM need a list ....

