&{startPrb12_2_ue1}          format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=16
&{startPrb12_3_ue1}          format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=32
&{startPrb12_4_ue1}          format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=48

&{startPrb13_1_ue1}          format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=0
&{startPrb13_2_ue1}          format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=16
&{startPrb13_3_ue1}          format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=32
&{startPrb13_4_ue1}          format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=48

&{startPrb12_1_ue2}          format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=16
&{startPrb12_2_ue2}          format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=32
&{startPrb12_3_ue2}          format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=48
&{startPrb12_4_ue2}          format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=64

&{startPrb13_1_ue2}          format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=16
&{startPrb13_2_ue2}          format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=32
&{startPrb13_3_ue2}          format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=48
&{startPrb13_4_ue2}          format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=64

&{startPrb12_1_ue2_d}        format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=10
&{startPrb12_2_ue2_d}        format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=26
&{startPrb12_3_ue2_d}        format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=42
&{startPrb12_4_ue2_d}        format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=58

&{startPrb13_1_ue2_d}        format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=10
&{startPrb13_2_ue2_d}        format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=26
&{startPrb13_3_ue2_d}        format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=42
&{startPrb13_4_ue2_d}        format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=58

&{startPrb13_1_diff}         format2=2    nbOfPrb=16    startSymbolIndex=13  startPRB=17
&{startPrb12_2_not16}        format2=2    nbOfPrb=16    startSymbolIndex=12  startPRB=15

@{UEseq1}                ${startPrb12_1_ue1}    ${startPrb12_2_ue1}     ${startPrb12_3_ue1}     ${startPrb12_4_ue1}
...                      ${startPrb13_1_ue1}    ${startPrb13_2_ue1}     ${startPrb13_3_ue1}     ${startPrb13_4_ue1}
@{UEseq2}                ${startPrb12_1_ue2}    ${startPrb12_2_ue2}     ${startPrb12_3_ue2}     ${startPrb12_4_ue2}
...                      ${startPrb13_1_ue2}    ${startPrb13_2_ue2}     ${startPrb13_3_ue2}     ${startPrb13_4_ue2}
@{UEseq2_prb13Diff}      ${startPrb12_1_ue2}    ${startPrb12_2_ue2}     ${startPrb12_3_ue2}     ${startPrb12_4_ue2}
...                      ${startPrb13_1_diff}   ${startPrb13_2_ue2}     ${startPrb13_3_ue2}     ${startPrb13_4_ue2}
@{UEseq1_deltaNot16}     ${startPrb12_1_ue1}    ${startPrb12_2_not16}   ${startPrb12_3_ue1}     ${startPrb12_4_ue1}
...                      ${startPrb13_1_ue1}    ${startPrb13_2_ue1}     ${startPrb13_3_ue1}     ${startPrb13_4_ue1}
@{UEseq2_diffUE1}        ${startPrb12_1_ue2_d}  ${startPrb12_2_ue2_d}   ${startPrb12_3_ue2_d}   ${startPrb12_4_ue2_d}
...                      ${startPrb13_1_ue2_d}  ${startPrb13_2_ue2_d}   ${startPrb13_3_ue2_d}   ${startPrb13_4_ue2_d}
@{UEList1}               ${UEseq1}                      ${UEseq2}
@{UEList_prb13diff}      ${UEseq1}                      ${UEseq2_prb13diff}
@{UEList_deltaNot16}     ${UEseq1_deltaNot16}           ${UEseq2}
@{UEList_DiffUEs}        ${UEseq1}                      ${UEseq2_diffUE1}

*** Test Cases ***
TU
    My Attach UE Multi      ${Test2}

TU 2
    Dated log               Start
    Check UE List           UEList NORMAL       ${UEList1}
    Check UE List           PRB13 Diff          ${UEList_prb13diff}
    Check UE List           Delta Not 16        ${UEList_deltaNot16}
    Check UE List           Delta UE1 UE2       ${UEList_DiffUEs}

*** Keywords ***
Check UE List
    [Arguments]         ${str}      ${UEList}
    Dated log           TEST CASE : ${str}
    ${ue}               set variable        0
    ${UeRrcList}        create list
    FOR     ${UEseq}        IN      @{UEList}
        ${ue}           evaluate        ${ue}+${1}
        ${UeRRC}        Check UE Seq    ${ue}       ${UESeq}
        Append to list  ${UeRrcList}    ${UeRRC}
        ${res}          checkStartPrbTddFdmForUe    UErrc=${UeRRC}
        ...             technology=TDD
        Dated log       ${EMPTY} ${EMPTY} Check on UE ${ue}=${res}
    END
    Check Start Prb Between UEs     UeRrcList=${UeRrcList}

Check UE Seq
    [Arguments]         ${ue}   ${UESeq}
    ${UeRRC}                    newUErrcConfigChecking      ${ue}
    FOR     ${seq}      IN      @{UESeq}
       AddStartPrbTddFDM        UErrc=${UeRRC}
       ...                      format2=${seq.format2}
       ...                      nbOfPrb=${seq.nbOfPrb}
       ...                      startSymbolIndex=${seq.startSymbolIndex}
       ...                      startPRB=${seq.startPRB}
    END
    [Return]                    ${UeRRC}

My Attach UE Multi
    [Arguments]           ${testParam}
    ${UeRrcList}          create list
    FOR      ${idUE}      IN RANGE      1        ${testParam.seq.totalUE}+1
         ${name}          Set Variable           SCTP_CLASSICAL_GNB_ADDITION_UE${idUE}.pcap
         Dated log        idUE=${idUE} PCAP=${name}
         Run keyword if                          ${testParam.checkPucch}
         ...                                     Test Check PUCCH
         ...                                        ue=${idUE}
         ...                                        pcapFile=/ebs/bhoche/FeatureCNI_FDM/${name}
         ...                                        technology=TDD
    END
    Check Start Prb Between UEs                  UeRrcList=${UeRrcList}
