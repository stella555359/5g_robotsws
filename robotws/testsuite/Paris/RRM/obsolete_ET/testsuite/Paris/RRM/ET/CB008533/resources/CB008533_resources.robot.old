Library     OperatingSystem
Library     ute_fsmaccess
Library     ute_wtssim
Library     ta_emss
Library     ta_logcollector
Library     ta_messaging
Library     ta5g_pm_counters
Library     ta5g_testline_management
Library     taf.collectors.l2stream3     WITH NAME  tcl
Library     taf.collectors.core          WITH NAME  tcc
Library     taf.converters.eventdecoder  WITH NAME  tce
Library    taf.sw.scout                  WITH NAME  scout
Library    taf.sw.reporting_portal       WITH NAME  reporting_portal

Resource    ../../resources_KRK/robot/common_keywords.robot
Library     ../../resources_KRK/python/traffic_handling.py
Library     CB008533_tti_trace_keywords.py
Library     CB008533_resources.py
Variables   ta5g_global_var
Variables   ta_messaging_filters.py


*** Variables ***
${ENABLE_CP_RT_DEBUG_LOGS}=     0x590072=1 #ENABLE CP_RT DEBUG LOGS
${ENABLE_CP_NRT_DEBUG_LOGS}=    0x41001b=1 #ENABLE CP_NRT DEBUG LOGS
${PM_COUNTERS_PERIOD_DIVIDER}=  0x340000=5 #shorten PM counters collecting period
${PM_COUNTERS_PERIOD_SECOND_DIVIDER}=  0x9D0000=5 #shorten PM counters collecting period
@{SWCONFIG_FLAGS_LIST}=  ${ENABLE_CP_RT_DEBUG_LOGS}  ${ENABLE_CP_NRT_DEBUG_LOGS}  ${PM_COUNTERS_PERIOD_DIVIDER}  ${PM_COUNTERS_PERIOD_SECOND_DIVIDER}
#${airphone_xml}=                ${EXECDIR}${/}..${/}robotws${/}custom-config${/}Krakow${/}CB008533${/}AirPhone_FDD_TDD_6Cells_L1B_SANSA_4CC_CA.xml
#${lc_config}=                   ${EXECDIR}${/}..${/}robotws${/}custom-config${/}Krakow${/}CB008533${/}lc_config.yaml

*** Keywords ***
# ------------ EMSSIM and EPCSIM connection, Aliases and others precondition ------------
Change weightForSCellSelection for Cell-2 and Cell-4
    Configure    {'MOC': 'NRCELL', 'ID': 2, 'weightForSCellSelection': '40'}
    Configure    {'MOC': 'NRCELL', 'ID': 4, 'weightForSCellSelection': '20'}
    BuiltIn.sleep  10

# ------------ Register and Deregister NR-UE ------------
Establish PDU session for NR-UE${UE_ID} message flow check
    Expect message flow
    ...    gNB2:F1AP_UEContextSetupRequest (CUtoDURRCInformation is present) as UEContextSetupRequest
    ...    gNB2:F1AP_UEContextSetupResponse (DUtoCURRCInformation is present) as UEContextSetupResponse
    ...    gNB2:F1AP_UEContextModificationRequest (SCell-ToBeSetupMod-List is present) as UEContextModificationRequest
    ...    gNB2:F1AP_UEContextModificationResponse (sCellToAddModList is present) as UEContextModificationResponse
    ...    gNB2:F1AP_UEContextModificationRequest as UEContextModificationRequest_2nd
    ...    gNB2:F1AP_UEContextModificationResponse (sCellToAddModList is present) as UEContextModificationResponse_2nd
    ...    UE_${UE_ID}:NR-RRC_RRCReconfiguration as RRCReconfiguration
    ...    UE_${UE_ID}:NR-RRC_RRCReconfigurationComplete as RRCReconfigurationComplete
    ...    UE_${UE_ID}:NR-RRC_RRCReconfiguration as RRCReconfiguration_2nd
    ...    UE_${UE_ID}:NR-RRC_RRCReconfigurationComplete as RRCReconfigurationComplete_2nd
    ...    alias=Established_PDU_UE${UE_ID}   overall_timeout=20

# ------------ Throughput ------------
Wait ${seconds}s for throughput stable
    BuiltIn.sleep  ${seconds}

# ------------ TTI Traces collection ------------
Start TTI trace collection
    ${configurations}=  tcc.Load Configurations    ${CURDIR}/CB008533_tti_trace_collectors.yaml
    tcc.Create Collectors    names=l2stream3    configurations=${configurations['collectors']}
    tcl.Set Suite Alias     alias=l2stream3
    tcc.Setup Collectors    names=l2stream3
    tcc.Start Collectors    names=l2stream3
    Log to console    ${\n}TTI traces collecting started

Stop TTI trace collection
    Log to console    Stopping TTI traces collecting
    tcc.Stop Collectors    names=l2stream3
    tcc.Collect Collectors    names=l2stream3
    tcc.Teardown Collectors    names=l2stream3

Convert TTI trace from pcap
    [Arguments]  ${format}  ${directory_name}
    Log to console    Converting TTI traces to ${format}
    tce.Create eventDecoder Converter
    ...  name=ttitrace_converter
    ...  input_file_path=${OUTPUTDIR}/${SUITENAME}/${TESTNAME}/l2stream3/tcpdump/tcpdump.pcap
    ...  output_file_format=${format}
    ...  output_file_path=${OUTPUTDIR}/${SUITENAME}/${TESTNAME}/output
    tce.Convert
    ...  name=ttitrace_converter
    Remove Directory  ${OUTPUTDIR}/${SUITENAME}/${TESTNAME}/${directory_name}/    recursive=True
    Move Files	    ${OUTPUTDIR}/${SUITENAME}/${TESTNAME}/output*     ${OUTPUTDIR}/${SUITENAME}/${TESTNAME}/${directory_name}/
    Move Directory	${OUTPUTDIR}/${SUITENAME}/${TESTNAME}/l2stream3/  ${OUTPUTDIR}/${SUITENAME}/${TESTNAME}/${directory_name}/

Collect TTI Traces during ${duration} seconds and save to directory ${directory_name}
    ${parent_directory}  Set variable  ${directory_name}
    Set Test Variable  ${parent_directory}
    Start TTI trace collection
    Log to console    Collecting duration is ${duration}
    BuiltIn.sleep  ${duration}
    Stop TTI trace collection
    Convert TTI trace from pcap  format=excelCsv  directory_name=${directory_name}

# ------------ ta_messaging messages verification ------------

Verify SCell-ToBeSetupMod-List IE whether TDD Cell and FDD Cell were selected to 4CC CA for NR-UE${UE_ID}
    Verify That Message Fulfills Query
    ...      ${selected_SCells_for_FTTF_4CC_CA_in_UE_CON_MOD_REQ}
    ...  message_alias=UEContextModificationRequest
    ...  flow_alias=Established_PDU_UE${UE_ID}

Verify sCellToAddModList IE whether TDD Cells and FDD Cell were added as SCells for NR-UE${UE_ID}
    Verify That Message Fulfills Query
    ...      ${added_SCells_for_FTTF_4CC_CA_in_UE_CON_MOD_RESP}
    ...  message_alias=UEContextModificationResponse_2nd
    ...  flow_alias=Established_PDU_UE${UE_ID}

Verify sCellToAddModList IE whether TDD Cells and FDD Cell with higher weightForSCellSelection were added as SCells for NR-UE${UE_ID}
    Verify That Message Fulfills Query
    ...      ${added_SCells_for_FTTF_4CC_CA_in_UE_CON_MOD_RESP_Cell_2_higher_weight}
    ...  message_alias=UEContextModificationResponse_2nd
    ...  flow_alias=Established_PDU_UE${UE_ID}

Verify spCellConfig and sCellToAddModList IEs whether maxMIMO-Layers DL and UL configuration was correct for NR-UE${UE_ID}
    Verify That Message Fulfills Query
    ...      ${maxMIMO_Layers_for_FTTF_4CC_CA_in_UE_CON_MOD_RESP}
    ...  message_alias=UEContextModificationResponse_2nd
    ...  flow_alias=Established_PDU_UE${UE_ID}

Verify whether pCSI and HARQ AN and CRI of the best CSI-RS reporting configuration was sent for SCell-2 for FTTF 4CC CA NR-UE${UE_ID}
    Verify That Message Fulfills Query
    ...      ${CSIReportConfigToAddModList_for_BF_enabled_with_BR_for_FTTF_4CC_CA_in_UE_CON_MOD_RESP_for_SCell_2_and_SCell_3}
    ...  message_alias=UEContextModificationResponse_2nd
    ...  flow_alias=Established_PDU_UE${UE_ID}

Verify resourceSetToAddModList IE whether PUCCH resources were allocated correctly for BF enabled for FTTF 4CC CA NR-UE${UE_ID}
    Verify That Message Fulfills Query
#    ...      ${resourceSetToAddModList_for_BF_enabled_for_FTTF_4CC_CA_in_UE_CON_MOD_RESP_for_SCell_2_and_SCell_3}
    ...      ${resourceSetToAddModList_for_BF_enabled_for_FTTF_4CC_CA_in_UE_CON_MOD_RESP_for_SCell_2_and_SCell_3_mod}
    ...  message_alias=UEContextModificationResponse_2nd
    ...  flow_alias=Established_PDU_UE${UE_ID}
    Verify starting PRB for set1 resources are different

Verify SCellToAddModList IE whether each SCell has CSI-RS configuration
    Verify That Message Fulfills Query
    ...      ${CSIRS_configuration_for_each_SCell}
    ...  message_alias=UEContextModificationResponse_2nd
    ...  flow_alias=Established_PDU_UE1

Verify allowedBC-ListMRDC IE whether CA_n71A-n5A-n77A-n41A band combination was selected to 4CC CA for NR-UE${UE_ID}
    Verify That Message Fulfills Query
    ...      ${BandComb_Index_and_allowedFeatureSetsList_for_FTTF_3CC_CA_in_UE_CON_MOD_REQ}
    ...  message_alias=UEContextModificationRequest
    ...  flow_alias=Established_PDU_UE${UE_ID}

Verify allowedBC-ListMRDC IE whether CA_n71A-n5A-n77A-n41A band combination was selected to 4CC CA with higher weight for NR-UE${UE_ID}
    Verify That Message Fulfills Query
    ...      ${BandComb_Index_and_allowedFeatureSetsList_for_FTTF_3CC_CA_in_UE_CON_MOD_REQ_with_higher_weight}
    ...  message_alias=UEContextModificationRequest
    ...  flow_alias=Established_PDU_UE${UE_ID}

