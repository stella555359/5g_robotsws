# -------------- DSS Setup --------------
Setup DSS
    Activate XP Link
    BuiltIn.sleep  2
    Activate XP Link
    BuiltIn.sleep  30
    Setup DSS on Cell1
    BuiltIn.sleep  10
    Setup DSS on Cell2
    BuiltIn.sleep  10
    Setup DSS on Cell3
    BuiltIn.sleep  10


Activate XP Link
    Execute egate command
    ...    cmd=enb_xp_param id=1 ignore_xp=off xp_listening_socket=on
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_xp_param id=1 xp_peers=2
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_xp_link_up enb=1 target=2
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_x2_link_up enb=1 target=2
    BuiltIn.sleep    2


Setup DSS on Cell1
    Execute egate command
    ...    cmd=enb_dss_param id=1 feature_flag=on message_sets=V1,DMS3
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_cell_param id=1 enb=1 antenna_ports_num=2 lte_nr_dss_mode=DSS_PHASE_3
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_cell_dss_feature enb=1 id=1 nr_dl_peak_rate_increase=on
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_cell_dss_feature enb=1 id=1 superfast_allocation=on
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_cell_dss_param id=1 enb=1 dl_resource_sharing_algo=dl_buffer_level_based
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_dss_configure_partnership enb=1 cell=1 dss_peer=2:3
    BuiltIn.sleep    2
    Setup on egate cell resource reservation on enb1 cell1 gnb2 cell3
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_crm_param id=1 dl_qos_load_meas_timer=200 ul_qos_load_meas_timer=200
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_dss_establish_partnership enb=1 cell=1 tgt_enb=2 tgt_cell=3
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_dss_dl_cell_resource_reservation enb=1 cell=1
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_dss_ul_cell_resource_reservation enb=1 cell=1
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_dss_dl_cell_resource_reservation enb=1 cell=1 prb_area_reservation_list=0,0,0-10-none+0,0,5-10-none+0,0,9-10-none
    BuiltIn.sleep    2
    Setup on egate dl cell resource reservation on enb1 cell1
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_dss_dl_cell_resource_reservation enb=1 cell=1 min_lte_nr_dss_ratio=30 max_lte_nr_dss_ratio=100
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_dss_cell_resource_coordination enb=1 cell=1 tgt_enb=2 tgt_cell=3 dir=DL
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_dss_ul_cell_resource_reservation enb=1 cell=1 minimum_prb_share=30 maximum_prb_share=70
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_dss_cell_resource_coordination enb=1 cell=1 tgt_enb=2 tgt_cell=3 dir=UL
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_crm_status enb=1 cell=1
    BuiltIn.sleep    2
    Setup on egate high allocation on enb1 cell1 gnb2 cell3
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_dss_resource_allocation enb=1 cell=1 tgt_enb=2 tgt_cell=3 dir=UL allocation_start_time=immediate ul_allocated_prb_list=6,30
    BuiltIn.sleep    2


Setup DSS on Cell2
    Execute egate command
    ...    cmd=enb_dss_param id=1 feature_flag=on message_sets=V1,DMS3
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_cell_param id=2 enb=1 antenna_ports_num=2 lte_nr_dss_mode=DSS_PHASE_3
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_cell_dss_feature enb=1 id=2 nr_dl_peak_rate_increase=on
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_cell_dss_feature enb=1 id=2 superfast_allocation=on
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_cell_dss_param id=2 enb=1 dl_resource_sharing_algo=dl_buffer_level_based
    BuiltIn.sleep    2
    Execute egate command
    ...    cmd=enb_dss_configure_partnership enb=1 cell=2 dss_peer=2:5
    BuiltIn.sleep    2
    Setup on egate cell resource reservation on enb1 cell2 gnb2 cell5
    BuiltIn.sleep    2
