Check PRB Assignment CB008940-L MicroDTX
    [Arguments]    ${ttitraceFilename}=${EMPTY}   ${ttitracepath}=/tmp/
    run Keyword if   '${ttitraceFilename}'!='${EMPTY}'    run Keywords  Check PRB Assignment CB008940-L MicroDTX Based FilePkl   ${ttitraceFilename}
    ...                                                                                                                          ${ttitracepath}
    ...                                             AND         return from Keyword

Check PRB Assignment CB008940-L MicroDTX Version2
    [Arguments]    ${TTITraceDict}   ${ttitraceFilename}=${EMPTY}   ${ttitracepath}=/tmp/
    run Keyword if   '${ttitraceFilename}'!='${EMPTY}'    run Keywords  Check PRB Assignment CB008940-L MicroDTX Based FilePkl   ${ttitraceFilename}
    ...                                                                                                                          ${ttitracepath}
    ...                                             AND         return from Keyword
    Set Log Level    NONE
    ${DL_PRB_Alloc_BBRM_total}    ${DL_PRB_Alloc_BBRM_total_Several_SFN}     Get DL PRB Alloc BBRM CB008940     ${TTITraceDict}
    Set Log Level    TRACE
    # dated log      DL_PRB_Alloc_BBRM_total=${DL_PRB_Alloc_BBRM_total}
    # dated log      DL_PRB_Alloc_BBRM_total_Several_SFN=${DL_PRB_Alloc_BBRM_total_Several_SFN}
    display_list_parameters_w_name    ${DL_PRB_Alloc_BBRM_total}  name=DL_PRB_Alloc_BBRM_total     msg=Check PRB Assignment CB008940-L MicroDTX
    display_list_parameters_w_name    ${DL_PRB_Alloc_BBRM_total_Several_SFN}  name=DL_PRB_Alloc_BBRM_total_Several_SFN
    ...                                                                       msg=Check PRB Assignment CB008940-L MicroDTX
    ${DL_PRB_Alloc_BBRM}        Get from list     ${DL_PRB_Alloc_BBRM_total}        1
    ${DL_PRB_Alloc_BBRM_Minus6}     Get from list     ${DL_PRB_Alloc_BBRM_total}        0
    ${msgToLog}     Catenate   Based on ${consTraceColor}dlAllocatedPooledResourcesData${defColor} Event: first SFN is ${DL_PRB_Alloc_BBRM['sfn']}:
    ...     DL PRBs Alloc BBRM UE1: PRB Alloc: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]}${defColor},
    ...     hasZabPrivilege: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['hasZabPrivilege'][0]}${defColor},
    ...     UE2: PRB Alloc: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]}${defColor},
    ...     hasZabPrivilege: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['hasZabPrivilege'][1]}${defColor},
    ...     UE3: PRB Alloc: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]}${defColor},
    ...     hasZabPrivilege: ${consTraceColorYellow}${DL_PRB_Alloc_BBRM['hasZabPrivilege'][2]}${defColor}
    dated log    ------> ${msgToLog}
    ${SFN}      Get From Dictionary     ${DL_PRB_Alloc_BBRM}        sfn
    ${SFNToCheck}       Evaluate      str(int(${SFN})+1)
    ${Assigned_PRB}     Get MicroDTX Assigned PRB CB008940      ${TTITraceDict}       ${SFNToCheck}
    ${msg}=  Catenate   Based on ${consTraceColor}dlDtxOptimData${defColor} Event,
    ...                 Check MicroDtx PRB Assignment CB008940-L : Assigned_PRB=${consTraceColor}${Assigned_PRB}${defColor}
    dated log    ------> ${consTraceColorBgYellow}${consTraceColorBlack}SFNToCheck=${SFNToCheck}${defColor}
    dated log    ------> ${msg}
    ${numAllocCellPrbDlMicroDTX}        Get from list     ${Assigned_PRB}        0
    ${Cond1}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}'!='${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell1 => result is ${Cond1}
    ${Cond2}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}'!='${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell2 => result is ${Cond2}
    ${Cond3}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}'!='${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell3 => result is ${Cond3}
    # for cell0 , no dlDtxOptimData present in TtiTraces as with NonGBR=1200Mbps , no MicroDTX seen
    # should be True     ${Cond1}
    # ...     msg=${consTraceColorRed} prbAvailableInfo in Event dlDtxOptimData is ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]} for Cell0${defColor}
    ${msg}  Catenate   prbAvailableInfo in Event dlDtxOptimData is not as expected [${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]}] for Cell1
    should be True     ${Cond2}       msg=${consTraceColorRed}${msg}${defColor}
    ${msg}  Catenate   prbAvailableInfo in Event dlDtxOptimData is not as expected [${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]}] for Cell2
    should be True     ${Cond3}       msg=${consTraceColorRed}${msg}${defColor}

    ${SFNToCheck}       Evaluate      str(int(${SFN})+2)
    ${Assigned_PRB}     Get MicroDTX Assigned PRB CB008940      ${TTITraceDict}       ${SFNToCheck}
    ${msg}=  Catenate   Based on ${consTraceColor}dlDtxOptimData${defColor} Event,
    ...                 Check MicroDtx PRB Assignment CB008940-L : Assigned_PRB=${consTraceColor}${Assigned_PRB}${defColor}
    dated log    ------> ${consTraceColorBgYellow}${consTraceColorBlack}SFNToCheck=${SFNToCheck}${defColor}
    dated log    ------> ${msg}
    ${numAllocCellPrbDlMicroDTX}        Get from list     ${Assigned_PRB}        0
    ${Cond1}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}' != '${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell1 => result is ${Cond1}
    ${Cond2}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}'!='${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell2 => result is ${Cond2}
    ${Cond3}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}'!='${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell3 => result is ${Cond3}
    # for cell0 , no dlDtxOptimData present in TtiTraces as with NonGBR=1200Mbps , no MicroDTX seen
    # should be True     ${Cond1}
    # ...     msg=${consTraceColorRed} prbAvailableInfo in Event dlDtxOptimData is ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]} for Cell0${defColor}
    ${msg}  Catenate   prbAvailableInfo in Event dlDtxOptimData is not as expected [${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]}] for Cell1
    should be True     ${Cond2}       msg=${consTraceColorRed}${msg}${defColor}
    ${msg}  Catenate   prbAvailableInfo in Event dlDtxOptimData is not as expected [${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]}] for Cell2
    should be True     ${Cond3}       msg=${consTraceColorRed}${msg}${defColor}

    ${SFNToCheck}       Evaluate      str(int(${SFN})+3)
    ${Assigned_PRB}     Get MicroDTX Assigned PRB CB008940      ${TTITraceDict}       ${SFNToCheck}
    ${msg}=  Catenate   Based on ${consTraceColor}dlDtxOptimData${defColor} Event,
    ...                 Check MicroDtx PRB Assignment CB008940-L : Assigned_PRB=${consTraceColor}${Assigned_PRB}${defColor}
    dated log    ------> ${consTraceColorBgYellow}${consTraceColorBlack}SFNToCheck=${SFNToCheck}${defColor}
    dated log    ------> ${msg}
    ${numAllocCellPrbDlMicroDTX}        Get from list     ${Assigned_PRB}        0
    ${Cond1}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}' != '${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][0]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell1 => result is ${Cond1}
    ${Cond2}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}'!='${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][1]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell2 => result is ${Cond2}
    ${Cond3}   run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}'!='${0}'
    ...                   Evaluate   ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]} == ${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDlMicroDTX['numAllocCellPrbDl'][2]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition for Cell3 => result is ${Cond3}
    # for cell0 , no dlDtxOptimData present in TtiTraces as with NonGBR=1200Mbps , no MicroDTX seen
    # should be True     ${Cond1}
    # ...     msg=${consTraceColorRed} prbAvailableInfo in Event dlDtxOptimData is ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]} for Cell0${defColor}
    ${msg}  Catenate   prbAvailableInfo in Event dlDtxOptimData is not as expected [${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]}] for Cell1
    should be True     ${Cond2}       msg=${consTraceColorRed}${msg}${defColor}
    ${msg}  Catenate   prbAvailableInfo in Event dlDtxOptimData is not as expected [${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]}] for Cell2
    should be True     ${Cond3}       msg=${consTraceColorRed}${msg}${defColor}

    ${SFNToCheck}       Evaluate      str(int(${SFN})+1)
    Set Log Level    NONE
    Check numOfPrb dlFdSchedData CB008940    DL_PRB_Alloc_BBRM=${DL_PRB_Alloc_BBRM}   TTITraceDict=${TTITraceDict}   SFNToCheck=${SFNToCheck}
    Set Log Level    TRACE
    ${SFNToCheck}       Evaluate      str(int(${SFN})+2)
    Set Log Level    NONE
    Check numOfPrb dlFdSchedData CB008940    DL_PRB_Alloc_BBRM=${DL_PRB_Alloc_BBRM}   TTITraceDict=${TTITraceDict}   SFNToCheck=${SFNToCheck}
    Set Log Level    TRACE
    [teardown]   Set Log Level    TRACE

Check PRB Assignment CB008940-L MicroDTX Based FilePkl
    [Arguments]   ${FilePcap}   ${ttitracepath}
    ${FilePkl}=   Run keyword and continue on failure     Extract TTI Trace and Convert to Pickle For MicroDtx
    ...                                                                         ttitraceFilename=${FilePcap}
    ...                                                                         ttitracepath=${ttitracepath}
    Run keyword and continue on failure     CB008940-lib.verify_TTITraces_for_CB008940_MicroDtx_C1   path_to_pickle=${FilePkl}

Check numOfPrb dlFdSchedData CB008940
    [Arguments]    ${DL_PRB_Alloc_BBRM}   ${TTITraceDict}   ${SFNToCheck}
    ${Assigned_PRB}     Get numOfPrb dlFdSchedData CB008940      ${TTITraceDict}       ${SFNToCheck}
    Set Log Level    TRACE
    ${msg}=  Catenate   Based on ${consTraceColor}dlFdSchedData${defColor} Event,
    ...                 Check numOfPrb CB008940 : Assigned_PRB=${consTraceColor}${Assigned_PRB}${defColor}
    dated log    ------> ${consTraceColorBgYellow}${consTraceColorBlack}SFNToCheck=${SFNToCheck}${defColor}
    dated log    ------> ${msg}
    dated log    ------> DL_PRB_Alloc_BBRM=${DL_PRB_Alloc_BBRM}
    display_dictionnary_parameters_w_name    ${DL_PRB_Alloc_BBRM}     name=DL_PRB_Alloc_BBRM     msg=Check numOfPrb dlFdSchedData CB008940
    ${numAllocCellPrbDl}        Get from list     ${Assigned_PRB}        0
    ${Cond1}   run Keyword if   '${numAllocCellPrbDl['numAllocCellPrbDl'][0]}'!='${0}'
    ...                   Evaluate   int(${numAllocCellPrbDl['numAllocCellPrbDl'][0]}) <= int(${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]})
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDl['numAllocCellPrbDl'][0]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition numOfPrb dlFdSchedData for Cell1 => result is ${Cond1}
    ${Cond2}   run Keyword if   '${numAllocCellPrbDl['numAllocCellPrbDl'][1]}'!='${0}'
    ...                   Evaluate   int(${numAllocCellPrbDl['numAllocCellPrbDl'][1]}) <= int(${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]})
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDl['numAllocCellPrbDl'][1]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition numOfPrb dlFdSchedData for Cell2 => result is ${Cond2}
    ${Cond3}   run Keyword if   '${numAllocCellPrbDl['numAllocCellPrbDl'][2]}'!='${0}'
    ...                   Evaluate   int(${numAllocCellPrbDl['numAllocCellPrbDl'][2]}) <= int(${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]})
    ...           ELSE    Set Variable   ${True}
    run Keyword if   '${numAllocCellPrbDl['numAllocCellPrbDl'][2]}' != '${0}'
    ...                   dated log    Evaluate Acceptance condition numOfPrb dlFdSchedData for Cell3 => result is ${Cond3}
    ${msg}=   Catenate   ${numAllocCellPrbDl['numAllocCellPrbDl'][0]} <= ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][0]} NOT as expected
    should be True     ${Cond1}       msg=${consTraceColorRed}${msg}${defColor}
    ${msg}=   Catenate   ${numAllocCellPrbDl['numAllocCellPrbDl'][1]} <= ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][1]} NOT as expected
    should be True     ${Cond2}       msg=${consTraceColorRed}${msg}${defColor}
    ${msg}=   Catenate   ${numAllocCellPrbDl['numAllocCellPrbDl'][2]} <= ${DL_PRB_Alloc_BBRM['numAllocCellPrbDl'][2]} NOT as expected
    should be True     ${Cond3}       msg=${consTraceColorRed}${msg}${defColor}

Check Alarm Cleared All cells
    [Arguments]     ${nbCell}=0
    # 7506	gNB CpRtCell configuration update failure
    # 4540  5G cell update failure
    ${aliasGNB}                     OAM Connect                             ${GNB_DU.oam}
    Set Test Variable     ${aliasGNB}
    FOR    ${Cell_Id}    IN RANGE    0    ${nbCell}
        robot_extension.Run Keyword And Warn On Failure    Check Alarm Cleared
        ...                                           parameters=faultId=7506,severity=Critical,impactedCellsList[?]=${Cell_Id}
        robot_extension.Run Keyword And Warn On Failure    Check Alarm Cleared
        ...                                           parameters=faultId=4540,severity=Critical,impactedCellsList[?]=${Cell_Id}
    END
    # robot_extension.Run Keyword And Warn On Failure   OAM Disconnect                          ${GNB_DU.oam}

Check Alarm Cleared
    [Arguments]    ${parameters}=faultId=49,severity=Critical
    coam.assert_alarm_inactive    parameters=${parameters}    timeout=5   connection=${aliasGNB}

Get PDSCH and PUSCH ue_stats_nr
   [arguments]     ${ue_id}=1   ${DLthroughput}=0    ${ULthroughput}=0   ${CallType}=NSA
   ${scell_idx}   set variable if    '${CallType}'=='NSA'     8
   ...                                                        0
   ${DLTput_unit}   set variable if    '${DLthroughput}'=='0'     Kbps
    ...                                                           Mbps
   ${ULTput_unit}   set variable if    '${ULthroughput}'=='0'     Kbps
    ...                                                           Mbps
   ${Ue_Avg_PDSCH_Tput}=    run Keyword if    '${DLthroughput}'!='0'    Get PDSCH ue_stats_nr   ue_id=${ue_id}   scell_idx=${scell_idx}
   ...                                                                                          unit=${DLTput_unit}
   ...  ELSE                set variable   0
   sleep   1s
   ${Ue_Avg_PUSCH_Tput}=    run Keyword if    '${ULthroughput}'!='0'    Get PUSCH ue_stats_nr   ue_id=${ue_id}   scell_idx=${scell_idx}
   ...                                                                                          unit=${ULTput_unit}
   ...  ELSE                set variable   0
   ${msg}  Catenate   Ue_Avg_PDSCH_Tput=${consTraceColor}${Ue_Avg_PDSCH_Tput}${DLTput_unit}${defColor} for ${consTraceColor}ue_id=${ue_id}${defColor}
   Dated log     =======> ${msg}
   ${msg}  Catenate   Ue_Avg_PUSCH_Tput=${consTraceColor}${Ue_Avg_PUSCH_Tput}${ULTput_unit}${defColor} for ${consTraceColor}ue_id=${ue_id}${defColor}
   Dated log     =======> ${msg}
   [return]     ${Ue_Avg_PDSCH_Tput}    ${Ue_Avg_PUSCH_Tput}

Get PDSCH UE Stats for Given CC WA
    [documentation]   WA to CleanUp egate Console...
    [Arguments]    ${ue_id}=1    ${scell_idx}=0
    # Log to Console    PDSCH UE stats for given CC
    # wtsemu.script    file=${run_script_log_set}    entry=sim_log_set_flush()
    wtsemu.ue_stats_nr   id=${ue_id}    type=pdsch    scell=${scell_idx}
    ${output}    wtsemu.read_wtsemu_output_until    expected=UE-${ue_id}: NR PDSCH Throughput   timeout=10
    [Return]      ${output}

GET UE PDSCH Stats
   [Arguments]     ${ue_id}=1    ${expected}=NR PDSCH Throughput    ${w_logToConsole}=False
    ${output}    wtsemu.read_wtsemu_output_until_prompt    timeout=10
    # TRY2 : ${output}    wtsemu.read_wtsemu_output_until_re    expected=${expected}   timeout=10
    # TRY3 : ${output}    wtsemu.read_wtsemu_output_until    expected=${expected}   timeout=10
    ${result}    Get Lines Matching Regexp    ${output}    UE-${ue_id}: NR PDSCH Throughput    partial_match=${TRUE}
    Run Keyword if   '${w_logToConsole}' == 'True'    Log to Console    ${output}
    should contain    ${output}    Average
    [Return]      ${output}

Get PDSCH UE Stats for Given CC
    [Arguments]    ${ue_id}=1    ${scell_idx}=0
    # Log to Console    PDSCH UE stats for given CC
    # wtsemu.script    file=${run_script_log_set}    entry=sim_log_set_flush()
    wtsemu.ue_stats_nr   id=${ue_id}    type=pdsch    scell=${scell_idx}
    wtsemu.Sim Log Set
    ${output}    Wait Until Keyword Succeeds     1 min    2 sec    GET UE PDSCH Stats    ue_id=${ue_id}   expected=Average
    [Return]      ${output}

Get AVG DL DATA TRAFFIC For Given CC
    [Arguments]    ${ue_id}=1    ${scell_idx}=0     ${unit}=Mbps    ${w_logToConsole}=False
    ${pdsch_ue_stats}    Get PDSCH UE Stats for Given CC    ${ue_id}    ${scell_idx}
	${avg_tput}   avg_dl_data.get_avg_dl_data_traffic    ${pdsch_ue_stats}    ${unit}
	Run Keyword if   '${w_logToConsole}' == 'True'    Log to Console    ${avg_tput}
    [Return]      ${avg_tput}

