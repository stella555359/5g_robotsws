Update Basic Configuration File for actDlSrsBm Test Mode
    dated log   ----------> Update Basic Configuration File for actDlSrsBm with cell_testmode_set_nr (${tl.core.dir_path}/${tl.core.cfg_filename})
    Load Wts Cfg    ${tl.core.dir_path}/${tl.core.cfg_filename}
    # /opt/iphy/latest/basic_setup.cfg
    wts.insert      cell_srs_beam_pos_nr profile_id=1 num_of_ue_positions=4 azimuth=-40,-13,13,40    after    uec_param id=1
    wts.insert      cell_testmode_set_nr cell_id=3 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate    after    cell_srs_beam_pos_nr
    wts.insert      cell_testmode_set_nr cell_id=2 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate    after    cell_srs_beam_pos_nr
    wts.insert      cell_testmode_set_nr cell_id=1 gnb=2 testmode=cell_srs_beam_pos profile_id=1 action=activate    after    cell_srs_beam_pos_nr
    wts.insert  sim_param_set NR_PDCP_CIPHERING=distributed NR_PDCP_TRUNCATE_DL_SIZE=47 NR_PDCP_BUNDLE_DL_MAX_SIZE=1200 NR_PDCP_BUNDLE_DL_TIMEOUT=100
    ...         after    cell_srs_beam_pos_nr
    Save Wts Cfg    ${tl.core.dir_path}/${tl.core.cfg_filename}
    # /opt/iphy/latest/basic_setup.cfg
    Return From Keyword

