${Cells_NIDD_delta_file}     ${path_config_L}/Delta_Configuration_scf_MRBTS-1_Update_NIDD_3Cells.json

${kill_btslog}     timeout 5 sudo kill -9 $(ps -ef|grep btslog|grep -v grep|awk '{print $2}') 1>/dev/null 2>&1
${kill_dpkg}       timeout 5 sudo kill -9 $(ps -ef|grep dpkg|grep tti-dec.deb|grep -v grep|awk '{print $2}') 1>/dev/null 2>&1
${kill_sherpa}     timeout 5 sudo kill -9 $(ps -ef|grep ./Sherpa|grep -v grep|grep -v run|awk '{print $2}') 1>/dev/null 2>&1
# ps -el | grep Sherpa | grep -v grep | grep -v run

&{P_UETYPE}                                                         &{EMPTY}

*** Keywords ***
# robocop: off=unused-argument
# robocop: off=possible-variable-overwriting

My Restart Gnb Classical
    [Documentation]                 INTERNAL USAGE
    ...                             Restart sequence for case GNB is in classical configuration
    ...                             Start CPRT traces before Wait F1..... for debug purpose...
    [Arguments]                     ${GNBCallback}=None                     ${APCallback}=None
    ...                             ${isOAMRebooted}=False                  ${F1waitTime}=15min
    Dated log                       Restart Gnb Classical :isOAMRebooted=${isOAMRebooted}
    Run Keyword if                  ${isOAMRebooted}==False
    ...                             Airscale Soft Reboot                    ${GNB_DU}
    Airscale Soft Reboot            ${AP_DU}
    Dated Log                       Waiting for airscales to come back
    sleep                           2m
    ${gnb_status}=                  WA Airscale Wait For Ready              ${GNB_DU}
    Run Keyword If                  '${gnb_status}'!='Ready'                Fail    GNB is not ready
    ${ap_status}=                   WA Airscale Wait For Ready              ${AP_DU}
    Run Keyword If                  '${gnb_status}'!='Ready'                Fail    AP is not ready
    Run Keyword if   '${w_generic_capture}' == 'True'         Step      Captures CB008940 Init   prefix=CellSetup.Attach.SA.Traffic
    Run Keyword if   '${w_generic_capture}' == 'True'         Step      Captures Start      actionCORE=${isCaptureCORE}
    ...                                                                                     actionCPRT=${isCaptureCPRT}
    ...                                                                                     actionL1L2=${isCaptureL1L2}
    Get TL Info Struct
    Run Keyword if                  '${GNBCallback}'!='None'                ${GNBCallback}
    Run Keyword if                  '${APCallback}'!='None'                 ${APCallback}
    WA DCI Wait for service         ${AP_DU}
    # Skipping Wait for DCI (Feature 6765-D activated on GNB side)
    # WA DCI Wait for service         ${GNB_DU}
    F1 Wait Link Classical          timeout=${F1waitTime}
    GNSS Check and run
    IRfHead Check Service

Get Number Of Ue Configured With GBR Traffic
    [Documentation]
    ...     Conditions:     it is based on the argument ${dict_ues}
    ...     Actions:        it returns the number of ue's configured with GBR traffic
    ...     Checks:         it checks that the requested GBR throughput for the ue's is different from 0
    ...     Verdict:        the number of ue's configured with GBR traffic is returned
    [Arguments]             ${dict_ues}

    ${current_value}        Set Variable        0
    FOR    ${current_ue}    IN      @{dict_ues}
        ${current_value}=     Run Keyword If    ${current_ue.DL_throughput_GBR} > ${NO_THROUGHPUT}
        ...                                               Evaluate    ${current_value} + 1
        ...                               ELSE            Evaluate    ${current_value} + 0
    END
    Dated Log               The number of ue's configured with GBR traffic is ${current_value}
    [Return]                ${current_value}

Get dlsubcellid for cellId by spool with COAM
    [Documentation]     [PRIVATE]
    [Arguments]      ${oam_alias}
    ${cells_status}=    coam.get_cells_info    cell_type=nr     timeout=30    connection=${oam_alias}
    #  subCellList=['Subcell-0 (DL)', 'Subcell-0 (UL)', 'Subcell-3 (DL)', 'Subcell-3 (UL)', 'Subcell-4 (DL)', 'Subcell-5 (DL)']
    ${dlsubcellSpool0List}=  Create List
    ${dlsubcellSpool1List}=  Create List
    FOR    ${cell}    IN    @{cells_status}
        ${subcellList_CellId}=  set Variable    ${cell['subCellList']}
        ${subcellList_PhysicalCellId}=   set Variable     ${cell['physicalCellId']}
        run Keyword if   '${subcellList_PhysicalCellId}' == '50'     dated log    subcellList_Cell50 = ${subcellList_CellId}
        run Keyword if   '${subcellList_PhysicalCellId}' == '51'     dated log    subcellList_Cell51 = ${subcellList_CellId}
        run Keyword if   '${subcellList_PhysicalCellId}' == '52'     dated log    subcellList_Cell52 = ${subcellList_CellId}
        ${dlsubcellSpool0List}   run Keyword if   '${subcellList_PhysicalCellId}' == '50' or '${subcellList_PhysicalCellId}' == '52'
        ...                  extract_dll1sp_from_COAM    ${subcellList_CellId}   ${dlsubcellSpool0List}
        ...                         ELSE                set Variable             ${dlsubcellSpool0List}
        ${dlsubcellSpool1List}   run Keyword if   '${subcellList_PhysicalCellId}' == '51'
        ...                  extract_dll1sp_from_COAM    ${subcellList_CellId}   ${dlsubcellSpool1List}
        ...                         ELSE                set Variable             ${dlsubcellSpool1List}
    END
    [return]   ${dlsubcellSpool0List}   ${dlsubcellSpool1List}

Get ulsubcellid for cellId by spool with COAM
    [Documentation]     [PRIVATE]
    [Arguments]      ${oam_alias}
    ${cells_status}=    coam.get_cells_info    cell_type=nr     timeout=30    connection=${oam_alias}
    #  subCellList=['Subcell-0 (DL)', 'Subcell-0 (UL)', 'Subcell-3 (DL)', 'Subcell-3 (UL)', 'Subcell-4 (DL)', 'Subcell-5 (DL)']
    ${ulsubcellSpool0List}=  Create List
    ${ulsubcellSpool1List}=  Create List
    FOR    ${cell}    IN    @{cells_status}
        ${subcellList_CellId}=  set Variable    ${cell['subCellList']}
        ${subcellList_PhysicalCellId}=   set Variable     ${cell['physicalCellId']}
        run Keyword if   '${subcellList_PhysicalCellId}' == '50'     dated log    subcellList_Cell50 = ${subcellList_CellId}
        run Keyword if   '${subcellList_PhysicalCellId}' == '51'     dated log    subcellList_Cell51 = ${subcellList_CellId}
        run Keyword if   '${subcellList_PhysicalCellId}' == '52'     dated log    subcellList_Cell52 = ${subcellList_CellId}
        ${ulsubcellSpool0List}   run Keyword if   '${subcellList_PhysicalCellId}' == '50' or '${subcellList_PhysicalCellId}' == '52'
        ...                  extract_ull1sp_from_COAM    ${subcellList_CellId}   ${ulsubcellSpool0List}
        ...                         ELSE                set Variable             ${ulsubcellSpool0List}
        ${ulsubcellSpool1List}   run Keyword if   '${subcellList_PhysicalCellId}' == '51'
        ...                  extract_ull1sp_from_COAM    ${subcellList_CellId}   ${ulsubcellSpool1List}
        ...                         ELSE                set Variable             ${ulsubcellSpool1List}
    END
    [return]   ${ulsubcellSpool0List}   ${ulsubcellSpool1List}

TC CB008940
    [Documentation]
    ...     test template for CB008940
    ...     Conditions:     it is based on the arguments ${param}  ${dictParam}  ${vendor_custom} ${dict_ues} ${nrCell}
    ...     Actions:        it performs the call setup for multi-ues on different cells with DL traffic then cell addition
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        calls for multi ues and PRB pooling are passed
    [Arguments]             ${param}
    ...                     ${dictParam}
    ...                     ${vendor_custom}
    ...                     ${dict_ues}
    ...                     ${nrCell}
    ...                     ${kw Set RAD Params}=${EMPTY}
    ...                     ${kw NIDD Set}=${EMPTY}
    ...                     ${kw NIDD Check}=${EMPTY}
    ...                     ${kw Set TestMode}=${EMPTY}
    ...                     ${NIDD_8940_PARAMS}=${NIDD_8940_Q_L_PARAMS}
    ...                     ${Kw_Convert_TtiTrace_From_csv_to_Dict_Test}=Convert TTI trace from csv to dict CB008940
    ...                     ${kw Check SCF parameters}=verify_SCF_Paramaters
    ...                     ${kw Specific Check}=${EMPTY}
    ...                     ${Kw TestLine Preparation}=TL_Preparation_CB008940_SCF
    ...                     ${Json test configuration}=${EMPTY}

    Init Sequence           ${param}
    Run Keyword If    '${Json test configuration}'!='${EMPTY}'    load Json test data   ${Json test configuration}   ${dict_ues}   ${vendor_custom}
    StringTool.printLineWithTitle     title=Display NIDD PARAMETERS of the Test TO SET
    FOR    ${item}    IN    @{NIDD_8940_PARAMS}
         continue for loop if     'list_name' in ${item}
         ${msg_display}=    StringTool.getHeaderLine    ${item}[dist_name]/${item}[pname]     ${item}[value]
         dated log      ${msg_display}
         # dated log    dist_name=${item}[dist_name] pname=${item}[pname] value=${item}[value]
    END
    StringTool.printLineWithTitle     title=-
    Step         Init CB008940 Test Variables    vendor_custom=${vendor_custom}    dict_ues=${dict_ues}
    Step         Run Keyword     ${kw Set RAD Params}

    Run Keyword if     '${SHOULD_BE_COMMISSIONED_GNB_FIRST}'=='1' and '${UPDATE_SCF}'=='1'
    ...                                                       Run Keywords                  coam_parameter.perform_scf_delta_commission
    ...                                                                                     delta_file=${Cells_NIDD_delta_file}
    ...                                                                                     connection=coam_gnb
    # Wait end of commissioning
    ...                                                         AND
    ...                                                                                     OAM wait available

    # Set NIDD PARAM If Needed
    Run Keyword If    '${kw NIDD Set}'!='${EMPTY}'        ${kw NIDD Set}   list=${NIDD_8940_PARAMS}
    # return from Keyword

    # Check if NIDD PARAM are as expected
    Run Keyword If    '${kw NIDD Check}'!='${EMPTY}'      ${kw NIDD Check}  list=${NIDD_8940_PARAMS}

    Run Keyword if     '${SHOULD_BE_COMMISSIONED_GNB_FIRST}'=='1' and '${UPDATE_SCF}'=='1'
    ...                          Run Keywords       ${Kw TestLine Preparation}      output_scf=${test_scf_file}
    ...                              AND            Set Suite Variable              ${test_scf_file}
    Run Keyword if     '${SHOULD_BE_COMMISSIONED_GNB_FIRST}'=='1'
    ...           Critical Step    CB008940-Q-L-Common-Keywords.Deploy Vendor File Config     vendor_param=${vendor_custom}
    ...                                                                              is_perform_full_commissioning=${True}
    ...   ELSE    run Keywords     Dated Log new line       ${consTraceColorRed}BEWARE that Deploy Vendor File Config is already DONE!!! ${defColor}
    ...               AND          Dated Log                ${consTraceColor}=== Restart TL === ${defColor}
    # ...               AND          My Restart Gnb Classical    isOAMRebooted=False     F1waitTime=4min
    ...               AND          Restart TL               isOAMRebooted=False     F1waitTime=4min

    ${ret}   ${bts_status}=  run Keyword and ignore Error     get bts status with COAM     oam_alias=coam_gnb
    dated log    get bts status with COAM return is ${ret.lower()} with bts_status=${bts_status.lower()}
    Run Keyword If     '${ret.lower()}'=='pass' and '${bts_status.lower()}'!='configured'   Run Keywords
    ...         Dated Log new line       ${consTraceColorRed}bts status is not Configured [current state is ${bts status}]!!! ${defColor}
    ...               AND          Dated Log                ${consTraceColor}=== Restart TL === ${defColor}
    ...               AND          Restart TL               isOAMRebooted=False     F1waitTime=10min

    dated log      ${consTraceColorBgYellow}${consTraceColorBlack}------> Display Bbrm info from SysLogs AFTER Commissioning / TL Restart${defColor}
    robot_extension.Run Keyword And Warn On Failure         Display Bbrm configuration from Syslogs
    robot_extension.Run Keyword And Warn On Failure         Check l1Subpool Assignment in Syslogs

    # Prepare the delta files
    ${originalScfFile}      OAM Get SCF File    file=SCF-original.xml
    ${deltaCreateFile}      Replace String      ${originalScfFile}    original    create
    ${deltaDeleteFile}      Replace String      ${originalScfFile}    original    delete

    # Configure new ue's dynamically
    ${initial_NbOfUe}       get length          ${dict_ues}
    Run Keyword If          ${initial_NbOfUe} < ${param.totalNbOfUe}    Configure New Ues         ${dict_ues}
    ...                                                                                           ${initial_NbOfUe}
    ...                                                                                           ${param.totalNbOfUe}
    ...                                                                                           ${dict_settings_ue_default}

    # Configure the current setting for all the ue's
    ${param.totalNbOfUe}    get length          ${dict_ues}
    Step                    Configure the setting for the ${param.totalNbOfUe} UEs
    @{listOfUes}            Create List
    FOR    ${current_id}    IN RANGE    0    ${param.totalNbOfUe}
        ${current_ue}=                Evaluate                      ${current_id} + 1
        ${current_ueSetting}=         Copy Dictionary               ${BASIC_UE_SA}
        Set To Dictionary             ${current_ueSetting}          ue                  ${current_ue}
        Set To Dictionary             ${current_ueSetting}          pdu                 1
        Set To Dictionary             ${current_ueSetting}          trf_id              1
        Set To Dictionary             ${current_ueSetting}          target_gnb          ${param.targetGnb}
        Set To Dictionary             ${current_ueSetting}          size                ${dict_ues[${current_id}].packet_size}

        # Dispatching each ue on the requested original cell for the call establishment
        Set To Dictionary             ${current_ueSetting}          target_cells        ${dict_ues[${current_id}].originalCell}
        # Set the correct requested throughput per ue
        Set To Dictionary             ${current_ueSetting}          DL_throughput          ${dict_ues[${current_id}].DL_throughput}
        Set To Dictionary             ${current_ueSetting}          DL_throughput_GBR      ${dict_ues[${current_id}].DL_throughput_GBR}
        Set To Dictionary             ${current_ueSetting}          UL_throughput          ${dict_ues[${current_id}].UL_throughput}

        Append To List                ${listOfUes}                  ${current_ueSetting}
    END
    # Dated Log New Line                UE_List=${listOfUes}
    display_list_parameters_w_name      ${listOfUes}   name=Ue   msg=Display Of listOfUes
    CB008940-Common-Keywords.Check Multi Ues Setting In List        multiUesList=${listOfUes}

    set test Variable     ${listOfUes}
    Run Keyword if   '${w_generic_capture}' == 'True'         Step      Captures CB008940 Init   prefix=CellSetup.Attach.SA.Traffic
    Run Keyword if   '${w_generic_capture}' == 'True'         Step      Captures Start      actionCORE=${isCaptureCORE}
    ...                                                                                     actionCPRT=${isCaptureCPRT}
    ...                                                                                     actionL1L2=${isCaptureL1L2}

    # ${kw Set TestMode} is a robot Kw that allow to modify cfg file
    Run Keyword If    '${kw Set TestMode}'!='${EMPTY}'       ${kw Set TestMode}
    Run Keyword if    ${w_Basic_Call_to_Setup_Wtsemu} == ${True}      Modify Ue Capa for WTS    ue_nr_capa_value=${ue_nr_capabilities_SRS_w_VOIP_SA}

    Run Keyword if      ${w_Basic_Call_to_Setup_Wtsemu} == ${True}
    ...         Critical Step           Basic Call to Setup Wtsemu SA           nbUe=${param.totalNbOfUe}
    ...                                                             nbSaUe=${param.totalNbOfUe}
    ...                                                             nbCell=${param.totalNbOfCell}
    ...                                                             bypassX2Setup=${True}
    ...                                                             shouldUseLua=${True}
    ...                                                             list_of_UE_tobe_created=${listOfUes}
    ...                                                             bypassSIB=${True}
    # ...                                                             Kw_TM=${kw Set TestMode}
    ...   ELSE
    ...         Critical Step           CallSetup.Setup Wtsemu SA               nbUe=${param.totalNbOfUe}
    ...                                                             nbSaUe=${param.totalNbOfUe}
    ...                                                             nbCell=${param.totalNbOfCell}
    ...                                                             bypassX2Setup=${True}
    ...                                                             shouldUseLua=${True}
    ...                                                             list_of_UE_tobe_created=${listOfUes}
    ...                                                             bypassSIB=${False}

    dated log      ${consTraceColorBgYellow}${consTraceColorBlack}------> Display Bbrm info from SysLogs AFTER CellSetup${defColor}
    robot_extension.Run Keyword And Warn On Failure         Check l1Subpool Assignment in Syslogs
    robot_extension.Run Keyword And Warn On Failure         Display Bbrm configuration from Syslogs

    ${num_of_cells}=    Get Cell Number
    Critical Step       Wait gNB cells 5g On air    ${num_of_cells}

    ${ret}   ${dll1spcells}    robot_extension.Run Keyword And Warn On Failure         Get dlsubcellid for cellId by spool with COAM
    ...                                                                                                                 oam_alias=coam_gnb
    ${ret}   ${ull1spcells}    robot_extension.Run Keyword And Warn On Failure         Get ulsubcellid for cellId by spool with COAM
    ...                                                                                                                 oam_alias=coam_gnb
    Set Suite Variable      ${dll1spcells}
    Set Suite Variable      ${ull1spcells}
    dated log   dlsubcellSpool0List=${dll1spcells[0]}
    dated log   dlsubcellSpool1List=${dll1spcells[1]}
    dated log   ulsubcellSpool0List=${ull1spcells[0]}
    dated log   ulsubcellSpool1List=${ull1spcells[1]}
    # set test variable    ${dll1spcells[0]}
    # set test variable    ${dll1spcells[1]}
    # set test variable    ${ull1spcells[0]}
    # set test variable    ${ull1spcells[1]}

    ${num_of_cells_string}=    Convert to String    ${num_of_cells}
    Run Keyword if      ${w_Basic_Call_to_Setup_Wtsemu} == ${True}    UE Cell Setup Check       nbCell=${num_of_cells_string}
    Run Keyword if      ${w_Basic_Call_to_Setup_Wtsemu} == ${False}   Step                      CallSetup.WTS Set X2 Link

    # Register and launch PDU for all the ue's except for which define on the deleted cell
    FOR    ${current_elem}    IN    @{listOfUes}
        # Run Keyword If      ${current_elem.target_cells} != ${nrCell}    Run Keywords
        Run Keywords
        ...                 Critical Step       CallSetup UE register UeId "${current_elem.ue}" on Target cell "${current_elem.target_cells}"
        ...                                     depends=CallSetup.Setup Wtsemu SA
        ...    AND
        ...                 Critical Step     CallSetup.Launch PDU Session
        ...                                                         ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         gw=${current_elem.ue}
        ###...                                                      nwslice=1
        ...                                   depends=CallSetup UE register UeId
    END

    # Start the non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        set test variable   ${current_elem}
        ${dir}=   set Variable If    ${current_elem.DL_throughput} > ${0}    DL
        ...                                                                  NONE
        ${kw to run}=   Catenate   ${dir} Traffic SA Not Stopped with "${current_elem.DL_throughput}"Mbps "${param.duration}"s duration
        ...                        and "${param.deviation}" percent deviation
        Run Keyword If      ${current_elem.DL_throughput} > ${0}
        ...      Critical Step     ${kw to run}       depends=CallSetup.Launch PDU Session

        ${dir}=   set Variable If    ${current_elem.UL_throughput} > ${0}    UL
        ...                                                                  NONE
        ${kw to run}=   Catenate   ${dir} Traffic SA Not Stopped with "${current_elem.UL_throughput}"Mbps "${param.duration}"s duration
        ...                        and "${param.deviation}" percent deviation
        Run Keyword If      ${current_elem.UL_throughput} > ${0}
        ...      Critical Step     ${kw to run}       depends=CallSetup.Launch PDU Session
    END

    # PDU session modify reserved for the ue's configured with GBR traffic
    ${nbOfUe_traffic_GBR}=   CB008940-Q-L-Common-Keywords.Get Number Of Ue Configured With GBR Traffic    dict_ues=${listOfUes}
    FOR    ${current_elem}    IN    @{listOfUes}
        Run Keyword If    ${current_elem.DL_throughput_GBR} > ${0}    Run Keywords
        ...                 Critical Step    CallSetup.UE PDU Session Modify
        ...                                                         ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         qfta=2
        ...                                                         by=amf
        ...                                  depends=CallSetup.Launch PDU Session
        ...    AND
        ...                 Critical Step    CallSetup.UE PDU Session Modify
        ...                                                         ue=${current_elem.ue}
        ...                                                         pdu=${current_elem.pdu}
        ...                                                         qfta=3
        ...                                                         by=amf
        ...                                  depends=CallSetup.Launch PDU Session
    END

    # Start the GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        set test variable   ${current_elem}
        ${dir}=   set Variable If    ${current_elem.DL_throughput_GBR} > ${0}    DL
        ...                                                                      NONE
        ${kw to run}=   Catenate    ${dir} Traffic GBR SA Not Stopped with "${current_elem.DL_throughput_GBR}"Mbps "${param.duration}"s duration
        ...                         and "${param.deviation}" percent deviation
        Run Keyword If      '${current_elem.DL_throughput_GBR}' != '0'
        ...    Critical Step   ${kw to run}    depends=CallSetup.Launch PDU Session
    END

    Run Keyword if   '${w_generic_capture}' == 'True'       Step        Captures CB008940 Stop

    ${tti_trace_path}    ${tti_trace_dict}=    run Keyword if   '${w_GetTtiTrace}' == 'True' and '${GetTtiTraceTime}' != '0'
    ...               Process TTI Traces    Kw_Convert_TtiTrace_From_csv_to_Dict=${Kw_Convert_TtiTrace_From_csv_to_Dict_Test}

    # add here Specific Check based on TtiTraces
    ${Log Level}    set Variable If   '${kw Specific Check}'!='${EMPTY}'   TRACE
    ...                                                                    NONE
    run Keyword if   '${w_GetTtiTrace}' == 'True' and '${GetTtiTraceTime}' != '0' and '${kw Specific Check}'!='${EMPTY}'
    ...        Run Keywords                 Set Log Level    ${Log Level}
    ...          AND                        Step      ${kw Specific Check}
    # ...                                                                        ${tti_trace_dict}
    ...                                                                        ttitraceFilename=ttitrace_streaming.pcap
    ...                                                                        ttitracepath=${tti_trace_path}
    ...                                                                        depends=CallSetup.Launch PDU Session
    ...          AND                        Set Log Level    TRACE

    ${FilePkl}=           run Keyword if   '${w_GetTtiTrace}' == 'True' and '${GetTtiTraceTime}' != '0'
    ...      Run keyword and continue on failure      Convert TTI Traces to Dataframe and store as pickle   ttitraceFilename=ttitrace_streaming.pcap
    ...                                                                                                     ttitracepath=${tti_trace_path}

    ${L1L2_Pcap_File}=   run Keyword if     '${w_GetL1L2Bip}' == 'True' and '${Getl1l2TraceTime}' != '0'    Get L1L2 traces
    ...                                                                                 time=${GetL1L2TraceTime}
    ...                                                                                 prefix=L1L2Bip.wDLTput
    ...                                                                                 msg=take BIP L1L2 traces with DL Tput
    run Keyword if   '${L1L2_Pcap_File}' != 'None'      Run Keywords     Dated log    gzip -f ${L1L2_Pcap_File}.pcap
    ...                                                         AND      Run    gzip -f ${L1L2_Pcap_File}.pcap

    # Generate Verdict...
    run Keyword if   '${w_GetTtiTrace}' == 'True' and '${GetTtiTraceTime}' != '0'      Step      Generate Test Verdict
    ...                                                                                                         ${FilePkl}   ${vendor_custom}
    ...                                                                                                         ${dictExpectedValues}
    ...                                                                                                         ${kw Check SCF parameters}

    # Capture Sherpa
    set test variable   ${TEST NAME OK}   ${TEST NAME}
    ${tm}    Get Current Date
    ${tm}=    Remove String    ${tm.replace(' ','-')}    .
    ${TEST NAME}     Catenate      SherpaTraces-${GetSherpaTraceTime}-${tm}
    set test variable     ${TEST NAME}
    Run Keyword If    '${enable_sherpa}' == 'True'         Run Keywords    Step      Activate Sherpa
    ...    AND        Step                      Sleep with duration "${GetSherpaTraceTime}"s and msg "Sherpa pcap Traces"
    ...    AND        Step                      Private Deactivate Sherpa and Stop Collect     desired_storage_directory=${testCaseDir}
    ...                                                                                        keep_pcap_file=${True}
    ...    AND        Run Keyword And Ignore Error      Upload and decode sherpa pcap files    Sherpa_logs_local_path=${testCaseDir}
    ...                                                                                keep_pcap_file=${True}     duration=0
    ...    AND        Run Keyword And Ignore Error      Calling Panda Extract Csv For PRB Pooling
    set Test variable   ${TEST NAME}    ${TEST NAME OK}
    Run Keyword If    '${enable_sherpa}' == 'True'      set test variable     ${path_traces_Sherpa}    ${sherpa_output_path}

    # Generate Verdict...
    Run Keyword If    '${enable_sherpa}' == 'True'   Step      Generate Test Verdict Using Sherpa
    ...                                                                 path_traces_Sherpa=${path_traces_Sherpa}
    ...                                                                 depends=Private Deactivate Sherpa and Stop Collect

    # if  '${ENABLE_CHECK_COUNTERS}'=='1' => 'Display PDSCH and PUSCH ue_stats_nr for UEList' allow to Wait 15 min
    Run Keyword And Ignore Error     Display PDSCH and PUSCH ue_stats_nr for UEList   UEsList=${listOfUes}

    # Collect PM only if  '${ENABLE_CHECK_COUNTERS}'=='1'
    robot_extension.Run Keyword And Warn On Failure      CB008940-Q-L-Common-Keywords.Collect PM Counters and process throughput using PM counters

    # to bypass UE Deregister if needed
    @{listOfUes}    run Keyword if    '${w_ue_detach}' == 'False'    Create List
    ${len}=   Get Length   ${listOfUes}
    run Keyword if    '${len}' != '${0}'    Step    Traced Sleep   duration=3s   msg=deregistering     depends=CallSetup.UE Register
    # Deregister all the ue's
    FOR    ${current_elem}    IN    @{listOfUes}
        Run Keyword If      ${current_elem.target_cells} != ${nrCell}
        ...                 Step      CallSetup.UE Deregister       id=${current_elem.ue}
        ###...                                                      ue_deregister_type=switch_off
        ###...                                                      by=ue
        ...                                                         depends=CallSetup.UE Register
    END
    [Teardown]   Teardow Kw

Generate Test Verdict
    [Arguments]    ${FilePkl}   ${vendor_custom}   ${expected_avg_values}   ${kw Check SCF parameters}
    ${VENDORFILE_maxNumScheUePdschL1Pool_default}   Get From Dictionary       ${vendor_custom}     maxNumScheUePdschL1Pool
    ${VENDORFILE_maxNumScheUePdschL1Sp_default}     Get From Dictionary       ${vendor_custom}     maxNumScheUePdschL1Sp
    ${VENDORFILE_maxNumLayerPrbL1Sp_default}        Get From Dictionary       ${vendor_custom}     maxNumLayerPrbL1Sp
    ${VENDORFILE_maxNumStreamPrbL1Sp_default}       Get From Dictionary       ${vendor_custom}     maxNumStreamPrbL1Sp
    ${VENDORFILE_maxNumWbStreamPrbL1Sp_default}     Get From Dictionary       ${vendor_custom}     maxNumWbStreamPrbL1Sp
    ${VENDORFILE_ul_maxNumStreamPrbL1Sp_csSize32_default}     Get From Dictionary       ${vendor_custom}     ul_maxNumStreamPrbL1Sp_csSize32
    ${VENDORFILE_ul_maxNumStreamPrbL1Sp_csSize64_default}     Get From Dictionary       ${vendor_custom}     ul_maxNumStreamPrbL1Sp_csSize64
    ${min_l1PoolStreamPrbCapacity}=                 Evaluate         int(2*${VENDORFILE_maxNumStreamPrbL1Sp_default} * (100 - 5) / 100)
    ${max_l1PoolStreamPrbCapacity}=                 Evaluate         int(2*${VENDORFILE_maxNumStreamPrbL1Sp_default} * (100 + 5) / 100)
    ${expected_avg_total_prbs_spool1}               Get From Dictionary       ${dictExpectedValues}     expected_avg_total_prbs_spool1
    ${expected_avg_total_prbs_spool2}               Get From Dictionary       ${dictExpectedValues}     expected_avg_total_prbs_spool2
    ${expected_avg_total_prbsstream_spool1}         Get From Dictionary       ${dictExpectedValues}     expected_avg_total_prbsstream_spool1
    ${expected_avg_total_prbsstream_spool2}         Get From Dictionary       ${dictExpectedValues}     expected_avg_total_prbsstream_spool2
    ${expected_avg_total_prbs_spool1_int}           Convert To Integer	  ${expected_avg_total_prbs_spool1}
    ${expected_avg_total_prbs_spool2_int}           Convert To Integer	  ${expected_avg_total_prbs_spool2}
    ${expected_avg_total_prbsstream_spool1_int}     Convert To Integer	  ${expected_avg_total_prbsstream_spool1}
    ${expected_avg_total_prbsstream_spool2_int}     Convert To Integer	  ${expected_avg_total_prbsstream_spool2}
    ${cond}=   Evaluate
    ...        '${VENDORFILE_ul_maxNumStreamPrbL1Sp_csSize32_default}'!='None' and '${VENDORFILE_ul_maxNumStreamPrbL1Sp_csSize64_default}'!= 'None'
    ${ul_maxNumStreamPrbL1pool}=    run Keyword if   ${cond}
    ...     Evaluate    int(${VENDORFILE_ul_maxNumStreamPrbL1Sp_csSize32_default} + ${VENDORFILE_ul_maxNumStreamPrbL1Sp_csSize64_default})
    ...                               ELSE    set Variable   0
    ${min_ul_l1PoolStreamPrbCapacity}=   run Keyword if   ${cond}        Evaluate         int(${ul_maxNumStreamPrbL1pool} * (100 - 5) / 100)
    ...                                    ELSE                          set Variable     0
    ${max_ul_l1PoolStreamPrbCapacity}=   run Keyword if   ${cond}        Evaluate         int(${ul_maxNumStreamPrbL1pool} * (100 + 5) / 100)
    ...                                    ELSE                          set Variable     0
    Run keyword and continue on failure                 CB008940-lib.${kw Check SCF parameters}
    Run keyword and continue on failure                 CB008940-Q-L-Common-Keywords.verify CellSetup SysCom Traces    isCaptureCPRT=${isCaptureCPRT}
    Run Keyword If   ${isCaptureCPRT}    robot_extension.Run Keyword And Warn On Failure
    ...            CB008940-Q-L-Common-Keywords.Extract Cell Mapping Info from cellSetup Pcap     File=${testCaseDir}/${CaptureCPRT.name}.pcap
    robot_extension.Run Keyword And Warn On Failure     CB008940-lib.verify_TTITraces_for_7113
    robot_extension.Run Keyword And Warn On Failure     CB008940-lib.verify_TTITraces_for_8940
    Run keyword and continue on failure                 CB008940-lib.verify_TTITraces_for_CB008940_C1    ${expected_avg_total_prbs_spool1_int}
    ...                                                                                                  ${expected_avg_total_prbs_spool2_int}
    ...                                                                                                  ${expected_avg_total_prbsstream_spool1_int}
    ...                                                                                                  ${expected_avg_total_prbsstream_spool2_int}
    Run keyword and continue on failure                 CB008940-lib.verify_TTITraces_for_CB008940_C2    ${expected_avg_total_prbsstream_spool1_int}
    ...                                                                                                  ${expected_avg_total_prbsstream_spool2_int}
    ...                                                                                                  ${min_l1PoolStreamPrbCapacity}
    ...                                                                                                  ${max_l1PoolStreamPrbCapacity}
    ${CB007113 Allowed}=   Is CB007113 Allowed
    Run Keyword If   '${CB007113 Allowed}'=='True' and '${w_CB007113_Check}'=='True'
    ...                                             Run keyword and continue on failure     CB008940-lib.verify_TTITraces_for_CB007113_C1
    ...                                                                                                  ${min_ul_l1PoolStreamPrbCapacity}
    ...                                                                                                  ${max_ul_l1PoolStreamPrbCapacity}
    ${output_dtx_statistics}=   Run keyword and continue on failure     get_dtx_statistics_physCellId_ul    ${FilePkl}
    ${result}=  StringTool.getHeaderLine   output_dtx_statistics_physCellId_ul   ${output_dtx_statistics}
    dated log      ${result}
    ${output_dtx_statistics}=   Run keyword and continue on failure     get_dtx_statistics_physCellId_dl    ${FilePkl}
    ${result}=  StringTool.getHeaderLine   output_dtx_statistics_physCellId_dl   ${output_dtx_statistics}
    dated log      ${result}

