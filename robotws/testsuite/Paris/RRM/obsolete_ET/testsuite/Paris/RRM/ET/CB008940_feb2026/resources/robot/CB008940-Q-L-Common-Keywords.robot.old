# NRCELL.actCellCsiRsImTddNonBf is set to ??FALSE (CB007601)
# NRCELL.actAdaptiveReTxresMcs is set to "FALSE" (CB008662)
# NRCELL.actCsiRsMultiplexing is set to "TRUE"
# NRCELL.actDlSrsBm is set to "TRUE" (CB8247)
