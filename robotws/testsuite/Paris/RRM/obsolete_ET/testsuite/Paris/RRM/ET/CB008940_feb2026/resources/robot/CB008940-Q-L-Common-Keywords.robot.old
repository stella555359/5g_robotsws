   ${beamsMuted}=    Get NRCELL beamSet Param from SCF   param=beamsMuted   CellId=${cellId}
   ${modiflist}=  Run Keyword if   '${beamsMuted.lower()}'!='0'   Set NRCELL beamSet Param ListParam    cellId=${cellId}
   ...                                                                                               param_name=beamsMuted
