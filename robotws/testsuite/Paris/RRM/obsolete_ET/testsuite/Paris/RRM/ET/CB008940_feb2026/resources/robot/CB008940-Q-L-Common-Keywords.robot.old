   ...                                                                                               modiflist=${modiflist}
   ...   ELSE     set Variable    ${modiflist}
   ${lowerEdgeAngle}=    Get NRCELL beamSet Param from SCF   param=lowerEdgeAngle   CellId=${cellId}
