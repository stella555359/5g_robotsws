Verification of Number PRB Allocated within PRB Pooling Report Q06
    [Documentation]
    ...     Conditions:     it is based on the arguments ${num_min_prb} ${num_max_prb} ${num_prb_alloc} ${prereq_data} ${prereq_value} ${result_req}
    ...                     ${check_operator}
    ...     Actions:        it verifies all the numMinPrbAlloc, numMaxPrbAlloc and numPrbAlloc values of the recommended data
    ...     Checks:         it checks the values within PRB Pooling Allocation SubPool Report
    ...     Verdict:        numMinPrbAlloc, numMaxPrbAlloc and numPrbAlloc values are as expected
    [Arguments]             ${num_min_prb}=${NUM_MIN_PRB_DEFAULT}
    ...                     ${num_max_prb}=${NUM_MAX_PRB_DEFAULT}
    ...                     ${num_prb_alloc}=${NUM_MAX_PRB_DEFAULT}
    ...                     ${prereq_data}=${COL_NAME_SUBPOOLID}
    ...                     ${prereq_value}=0
    ...                     ${result_req}=True
    ...                     ${check_operator}===
    ...                     ${direction}=Dl

    ${file_path_report}     Set Variable        ${direction}_PrbPoolingAllocationReport_45_.csv
    # numMinPrbAlloc
    @{listOfValues}         Create List         ${num_min_prb}
    Dated Log New Line      Check if ${COL_NAME_NUMMINPRBALLOC}=${listOfValues} for ${prereq_data}=${prereq_value}
    Dated Log               ${file_path_report}
    ${verif_result}         Verify Value List In csv File Column
    ...                                         CsvName=${file_path_report}
    ...                                         Column_name=${COL_NAME_NUMMINPRBALLOC}
    ...                                         value_list=${listOfValues}
    ...                                         prereq_column=${prereq_data}
    ...                                         prereq_column_val=${prereq_value}
    Run Keyword If          ${verif_result} == True
    ...                     Dated Log    ${direction} Num Min PRB Alloc is equal to ${num_min_prb} for ${prereq_data}=${prereq_value}
    ...         ELSE        Dated Log    ${direction} Num Min PRB Alloc IS NOT EQUAL TO ${num_min_prb} for ${prereq_data}=${prereq_value}
    should be true          ${verif_result} == True
    # numMaxPrbAlloc
    @{listOfValues}         Create List         ${num_max_prb}
    Dated Log New Line      Check if ${COL_NAME_NUMMAXPRBALLOC}=${listOfValues} for ${prereq_data}=${prereq_value}
    Dated Log               ${file_path_report}
    ${verif_result}         Verify Value List In csv File Column
    ...                                         CsvName=${file_path_report}
    ...                                         Column_name=${COL_NAME_NUMMAXPRBALLOC}
    ...                                         value_list=${listOfValues}
    ...                                         prereq_column=${prereq_data}
    ...                                         prereq_column_val=${prereq_value}
    Run Keyword If          ${verif_result} == True
    ...                     Dated Log    ${direction} Num Max PRB Alloc is equal to ${num_max_prb} for ${prereq_data}=${prereq_value}
    ...         ELSE        Dated Log    ${direction} Num Max PRB Alloc IS NOT EQUAL TO ${num_max_prb} for ${prereq_data}=${prereq_value}
    should be true          ${verif_result} == True


Check sum of PRB allocated within PRB Pooling Report Q06
    [Arguments]             ${direction}=Dl
    ...                     ${valToCheck}=2400
    ...                     ${deviation}=12

    ${file_path_report} =      set variable    ${sherpa_output_path}/tcpdump/${Direction}_PrbPoolingAllocationReport_45_.csv
#    @{PrbAllocatedColumn}                      Get all values NumAllocStreamPrb column       file=${file_path_report}
#    ...                                             ColumnName=PrbAllocated

    tafSherpaCsvReader.setup_reader    ${file_path_report}
    tafSherpaCsvReader.print all
    @{PrbAllocatedColumn}              tafSherpaCsvReader.Get Values For Column       column=PrbAllocated

    ${PrbAlloc_LenList}=  Get Length    ${PrbAllocatedColumn}
    ${endOfSum}=        Evaluate      ${PrbAlloc_LenList} - 1
#    Dated Log    length ofNumAllocStreamPrbColumn List is    ${PrbAlloc_LenList}
#    Log    ${PrbAlloc_LenList}

    ${i_C0}        Set Variable        0
    ${i_C1}        Set Variable        1
    ${i_C2}        Set Variable        2
    ${valToCheckMin}    Evaluate    ${valToCheck} - ${deviation}
    FOR      ${i}   IN           @{PrbAllocatedColumn}
#            Log    @{NumAllocStreamPrbColumn}[${index_SP0}]
#            Log    @{NumAllocStreamPrbColumn}[${index_SP1}]
            ${sum}    Evaluate     4 * (@{PrbAllocatedColumn}[${i_C0}] + @{PrbAllocatedColumn}[${i_C1}] + @{PrbAllocatedColumn}[${i_C2}])
            Should Be True    ${sum} <= ${valToCheck} and ${sum} >= ${valToCheckMin}
            ${i_C0}=                             Evaluate     ${i_C0} + 3
            ${i_C1}=                             Evaluate     ${i_C1} + 3
            ${i_C2}=                             Evaluate     ${i_C2} + 3
            Exit For Loop If    ${i_C0}>=${endOfSum}
    END


Check 8940 PM Counters Q06

    [Documentation]   Check the counters for DL-MUMIMO feature related to 2 UE rank 4
    [Arguments]         ${val}

    Sleep        600s

    ${date}                         Get Current Date
    ${date_in_dir_name}             Convert Date         ${date}     result_format=%d%m%Y_%H%M
    Collect PM Counters File        pm_files_path=${LOG_PATH}/PM_${date_in_dir_name}

    ${DLMuMimoC1_8l}=    Counters.Retrieve Latest Single Counter Value From Pm File with CellID    ${LATEST_FILE}    M55308C34011    1
    Dated Log         PM Counter M55308C34011 ${DLMuMimoC1_8l} in cell 1
    ${DLSuMimoC1_4l}=    Counters.Retrieve Latest Single Counter Value From Pm File with CellID    ${LATEST_FILE}    M55308C34004    1
    Dated Log         PM Counter M55308C34004 ${DLSuMimoC1_4l} in cell 1
    ${DLMuMimoC1_2UE}=    Counters.Retrieve Latest Single Counter Value From Pm File with CellID    ${LATEST_FILE}    M55308C34011    1
    Dated Log         PM Counter M55308C34013 ${DLMuMimoC1_2UE} in cell 1
    Should Be True    0 < ${DLMuMimoC1_8l}
    ${levelOfMuMimo}    Evaluate    ${DLMuMimoC1_8l} * 100/(${DLMuMimoC1_8l}+${DLSuMimoC1_4l})
    Dated Log         Check percentage of DL MU-MIMO ${levelOfMuMimo} above ${val}
    Should Be True    ${val} <= ${levelOfMuMimo}
    Dated Log         Check PM Counter M55308C34013 ${DLMuMimoC1_2UE} equal to PM Counter M55308C34011 ${DLMuMimoC1_8l} in cell 1
    Should Be True    ${DLMuMimoC1_2UE}==${DLMuMimoC1_8l}


