    ...                                   action=activate

    wtsemu.ue_testmode_set_nr             id=2
    ...                                   testmode=csi_override
    ...                                   profile_id=5
    ...                                   scell=0
    ...                                   action=activate


SA Start Traffic Multi UEs NonGBR Q06
    [Arguments]       ${listOfUes}    ${dict_ues}

    FOR    ${current_elem}    IN    @{listOfUes}
        Dated Log New Line     === SA Register UE ${current_elem.ue} on cell ${current_elem.target_cells} ===
        CallSetup.UE Register                                   ue=${current_elem.ue}

        CallSetup.Launch PDU Session                            ue=${current_elem.ue}
        ...                                                     pdu=${current_elem.pdu}
        ...                                                     gw=${current_elem.ue}
    END

# Start the Non GBR traffic for all the ue's when requested
    FOR    ${current_elem}    IN    @{listOfUes}
        Run Keyword If      ${current_elem.DL_throughput} > ${NO_THROUGHPUT}     Run Keywords
        ...    Dated Log New Line
        ...         === Launch DL ${current_elem.DL_throughput}Mbits/s NonGBR traffic UE ${current_elem.ue} on cell ${current_elem.target_cells} ===
        ...    AND       DL Traffic SA Not Stopped Q06
        ...                                                     param=${paramsQ06}
        ...                                                     ueSetting=${current_elem}
        Run Keyword If      ${current_elem.UL_throughput} > ${NO_THROUGHPUT}     Run Keywords
        ...    Dated Log New Line
        ...         === Launch UL ${current_elem.UL_throughput}Mbits/s NonGBR traffic UE ${current_elem.ue} on cell ${current_elem.target_cells} ===
        ...    AND       UL Traffic SA Not Stopped Q06
        ...                                                     param=${paramsQ06}
        ...                                                     ueSetting=${current_elem}
    END

    sleep        30s
    wtsemu.ue_stats_nr                    id=1-4
    ...                                   type=pdsch
    ...                                   scell=0
    sleep        10s
    wtsemu.ue_stats_nr                    id=1-4
    ...                                   type=pusch
    ...                                   scell=0


DL Traffic SA Not Stopped Q06
    [Documentation]
    ...     Conditions:     it is based on the arguments ${param} ${ueSetting}
    ...     Actions:        it manages the DL traffic on the UE
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        DL traffic is passed
    [Arguments]             ${param}
    ...                     ${ueSetting}=${BASIC_UE_SA}

    Set To Dictionary       ${ueSetting}        trf_id    1
    Traffic UE DL           ueSetting=${ueSetting}
    ...                               throughput=${ueSetting.DL_throughput}
    ...                               captureCallback=None
    ...                               capture=None
    ...                               captureDuration=0
    ...                               duration=${param.duration}
    ...                               shouldBeStop=False
    ...                               deviation=${param.deviation}
    ...                               shouldBeCheck=False


UL Traffic SA Not Stopped Q06
    [Documentation]
    ...     Conditions:     it is based on the arguments ${param} ${ueSetting}
    ...     Actions:        it manages the DL traffic on the UE
    ...     Checks:         it checks nothing more than already done on lib.
    ...     Verdict:        DL traffic is passed
    [Arguments]             ${param}
    ...                     ${ueSetting}=${BASIC_UE_SA}

    Set To Dictionary       ${ueSetting}        trf_id    1
    Traffic UE UL           ueSetting=${ueSetting}
    ...                               throughput=${ueSetting.UL_throughput}
    ...                               captureCallback=None
    ...                               capture=None
    ...                               captureDuration=0
    ...                               duration=${param.duration}
    ...                               shouldBeStop=False
    ...                               deviation=${param.deviation}
    ...                               shouldBeCheck=False


Verification of Stream PRB within PRB Pooling Subpool Q06
    [Arguments]             ${direction}=Dl
    ...                     ${valToCheck}=2400
    ...                     ${deviation}=2

    ${file_path_report} =      set variable    ${sherpa_output_path}/tcpdump/${Direction}_PrbPoolingAllocationSubpool_45_.csv
#    @{NumAllocStreamPrbColumn}                      Get all values NumAllocStreamPrb column       file=${file_path_report}
#    ...                                             ColumnName=NumAllocStreamPrb

    tafSherpaCsvReader.setup_reader    ${file_path_report}
    tafSherpaCsvReader.print all
    @{NumAllocStreamPrbColumn}              tafSherpaCsvReader.Get Values For Column       column=NumAllocStreamPrb

    ${PrbAlloc_LenList}=  Get Length    ${NumAllocStreamPrbColumn}
    ${endOfSum}=        Evaluate      ${PrbAlloc_LenList} - 1
#    Dated Log    length ofNumAllocStreamPrbColumn List is    ${PrbAlloc_LenList}
#    Log    ${PrbAlloc_LenList}

    ${i_SP0}        Set Variable        0
    ${i_SP1}        Set Variable        1
    ${valToCheckMin}    Evaluate    ${valToCheck} - ${deviation}

    FOR      ${i}   IN           @{NumAllocStreamPrbColumn}
#            Log    @{NumAllocStreamPrbColumn}[${index_SP0}]
#            Log    @{NumAllocStreamPrbColumn}[${index_SP1}]
            ${sum}        Evaluate     @{NumAllocStreamPrbColumn}[${i_SP0}] + @{NumAllocStreamPrbColumn}[${i_SP1}]
            Should Be True    ${sum} <= ${valToCheck} and ${sum} >= ${valToCheckMin}

            ${i_SP0}=                             Evaluate     ${i_SP0} + 2
            ${i_SP1}=                             Evaluate     ${i_SP1} + 2
            Exit For Loop If    ${i_SP0}>=${endOfSum}
    END


Verification of BB Pooling cell distribution within PRB Pooling Report Q06
    [Documentation]
    ...     Conditions:     it is based on the argument ${nrCell_id} ${subpool_id} ${result_req}
    ...     Actions:        it verifies the sub pool id distribution for NRCell
    ...     Checks:         it checks the sub pool id value for NRCell within PRB Pooling Allocation SubPool Report
    ...     Verdict:        distribution is as expected
    [Arguments]             ${nrCell_id}
    ...                     ${subpool_id}=0
    ...                     ${result_req}=True
    ...                     ${direction}=Dl

    ${file_path_report}     Set Variable        ${direction}_PrbPoolingAllocationReport_45_.csv
    # subpool_id
    @{list_values}          Create List         ${subpool_id}
    Dated Log New Line      Check if ${COL_NAME_SUBPOOLID}=${list_values} for ${COL_NAME_NRCELLID}=${nrCell_id}
    Dated Log               ${file_path_report}
    ${verif_result}         Verify Value List In csv File Column
    ...                                         CsvName=${file_path_report}
    ...                                         Column_name=${COL_NAME_SUBPOOLID}
    ...                                         value_list=${list_values}
    ...                                         prereq_column=${COL_NAME_NRCELLID}
    ...                                         prereq_column_val=${nrCell_id}
    Run Keyword If          ${verif_result} == True
    ...                     Dated Log    ${direction} cell distribution is equal to ${COL_NAME_SUBPOOLID}=${list_values} for NRCell
    ...         ELSE        Dated Log    ${direction} cells distribution IS NOT EQUAL TO ${COL_NAME_SUBPOOLID}=${list_values} for NRCell
    should be true          ${verif_result} == ${result_req}



Check Min Max Allocated PRBs Q06
