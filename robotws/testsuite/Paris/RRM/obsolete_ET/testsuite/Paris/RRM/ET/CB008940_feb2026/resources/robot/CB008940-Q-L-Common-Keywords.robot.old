   ${modiflist}=  Run Keyword if   '${nrBtsBeamRefinementP2.lower()}'!='true'   Set NRCELL beamSet Param ListParam    cellId=${cellId}
   ...                                                                                               param_name=nrBtsBeamRefinementP2
