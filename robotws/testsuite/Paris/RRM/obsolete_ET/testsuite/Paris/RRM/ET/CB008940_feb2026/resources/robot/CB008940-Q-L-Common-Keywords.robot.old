    ${scf_update_8940}    SCF Enable CB008940    input_scf=${current_scf_fullname}    output_scf=${output_scf}
    ...                                          btsName=${FullbtsName[0:78]}
    dated log   TL_Preparation_CB008940_Q_SCF Kw : SCF To commit ${scf_update_8940}
    set suite variable     ${test_scf_file}   ${scf_update_8940}
    [Return]     ${scf_update_8940}

TL_Preparation_CB008940_L_MicroDTX_SCF
    [Arguments]    ${output_scf}

    Run Keywords                  coam_parameter.perform_scf_delta_commission
    ...                           delta_file=${Cells_delta_file}
    ...                           connection=coam_gnb
    # Wait end of commissioning
    ...                           AND
    ...                           OAM wait available

    ${Current_btsName}=   set Variable   ${Host Name}
    ${PartOfBtsName}=    set Variable   CB008940 8x8 CL DL MIMO 1Cell 8X4 CL MIMO 2Cells BeamSet_6 MicroDtx
    ${FullbtsName}=      set Variable   CB008940 - ${Current_btsName} - ${PartOfBtsName}
    ${test_scf_file}           COAM Get SCF      file=SCF.xml    w_setup_admin=False   alias=coam_gnb
    ${current_scf_fullname}    set Variable      ${test_scf_file}
    ${CsvFilename}      Remove String      ${current_scf_fullname}     .xml
    ${output_scf}       set Variable       ${CsvFilename}_modified_for_CB008940.xml
    ${scf_update_8940}    SCF Enable CB008940 MicroDtx    input_scf=${current_scf_fullname}    output_scf=${output_scf}
    ...                                          btsName=${FullbtsName[0:78]}
    dated log   TL_Preparation_CB008940_L_MicroDTX_SCF Kw : SCF To commit ${scf_update_8940}
    set suite variable     ${test_scf_file}   ${scf_update_8940}
    [Return]     ${scf_update_8940}

