    Set Element    dist_name=${MR_NR_CELL_NAME_CELL3}   p_name=dlMimoMode        value=4x4 or 4x2 Closed Loop Spatial Multiplexing
    FOR    ${item}    IN    @{CB009836_LIST_NAME_PARAMS_TO_ADD_CFG10}
