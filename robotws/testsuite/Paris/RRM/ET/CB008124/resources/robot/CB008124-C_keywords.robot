...               Creation Date               : 16-Mar-2023
...               Last Modified by            : Yann HERVE
...               Modification:
...                       16-Mar-2022         | Creation
...                       24-Jul-2023         | Disable -CA as L.A. is triggered when NACK are received
...                                           | because of AP test mode. It triggers CG modification and
...                                           | changes expected counters values (-CA was enabled by default after -C
...                                           | automated script delivery)
...                       20-May-2024         | Decrease ULCG BLER rate generated by test mode.
...                                           | Otherwise the ULCG L.A. algorithm is triggered and it leads
...                                           | to unexpected ULCG modification and even deactivation because
...                                           | num of NACKs (2) exceed threshold over measurement period (20 ULCG transmissions)
...                                           | For an unknown reason this algorithm was not triggeded before. Was there
...                                           | any change (fix ???) done on gNB side in the meantime ? Anyway, decreasing BLER
...                                           | (10 % to 4 %) avoids to trigger ULCG L.A. algorithm.
...                                           | Corresponding PMs were also re-tuned accordingly.
...                                           | I have also extended a little bit the UL traffic duration to have more samples
...                                           | as BLER was decreased.

Resource                         ./CB008124_keywords.robot
Resource                         ../../../resources/common/TtiTrace/ttitrace.robot
Resource                         ../../../../../resources/SWENG/robot/KPIs.robot


*** Variables ***
${rdHARQDisableIncrRedundancyUl}                0x580180
${rdEnableUlCgDebug_1}                          0x58057E
${rdEnableUlCgDebug_2}                          0x58057A
${delta_file_cb008124_adaptive_retrans}         testsuite/Paris/RRM/ET/CB008124/config/Delta_Configuration_scf_Adaptive_Retrans_Interaction.json
${adaptive_retrans_interaction_constraints}     testsuite/Paris/RRM/ET/CB008124/config/CB008124_adaptive_retrans_interaction_constraints.csv
${rdEnableDisableLA}                            0x5806E8


${gnb_alias}                                    gnb_under_test

${UL_throughput}                                4
# GP duration in seconds (hardcoded)
${gp_duration}                                  300
${TputVolMargin}                                5


*** Keywords ***
CB008124_TC_C_10_B13_ulCgMaxNumUeUl_online_change_TDD
    ${duplexModeTC}                   Set Variable       TDD
    set Suite Variable                ${duplexModeTC}
    &{ULCGconfig}                     copy dictionary    ${ULCG_defaultConf}
    ${ULCGconfig.ulCgMaxNumPrbs}      Set Variable       20
    ${ULCGconfig.ulCgPrbStartOffset}  Set Variable       0
    ${ULCGconfig.ulCgMaxNumUeUl}      Set Variable       1
    ${ULCGconfig.grantedPacketSize}   Set Variable       1500
    ${ULCGconfig.maxNumPrbs}          Set Variable       8
    ${ULCGconfig.periodicity}         Set Variable       ms2

    CB008124 Create UECG UEnonCG      nbUECG=2

    ${SCF_list}                       CB008124 Get SCF File
    CB008124 SCF config               scf_file=${SCF_list}    actUlCgType2=true    ULCGconfig=${ULCGconfig}

    Dated Log new line                ${trcColor}=== Perform full commissioning ${defColor}
    ${DU_SCF}                         Set Variable    ${SCF_list}[0]
    OAM Perform Full Commissioning    scf_file=${DU_SCF}
    OAM wait available

    CB008124 cell setup

    # TTI capture configuration
    ${TTIdir}                     Get TTI Trace Path     dir_suffix=C10

    &{UE1_CG}                     copy dictionary    ${BASIC_UE_SA}

    &{UE2_CG}                     copy dictionary    ${BASIC_UE_SA}
    ${UE2_CG.ue}                  Set Variable       2

    # Start TTI trace capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2

    Dated Log New Line            ${trcColor}=== Attach UE1 CG ${defColor}
    CB008124 Attach               ueSetting=${UE1_CG}    CPRTcapture=${True}

    Dated Log New Line            ${trcColor}=== Attach UE2 CG ${defColor}
    CB008124 Attach               ueSetting=${UE2_CG}    CPRTcapture=${True}

    Dated Log New Line            ${trcColor}=== Start UL traffic UE1 CG ${defColor}
    ${UL_UE1}                     Evaluate    4
    Traffic UE UL                 ueSetting=${UE1_CG}
    ...                           throughput=${UL_UE1}
    ...                           shouldBeStop=False
    ...                           shouldBeCheck=False
    ...                           duration=0

    ${TimeStart_UL_UE1}           Set Variable           ${TIME_LAST_TRAFFIC_START}

    Dated Log New Line            ${trcColor}=== Start UL traffic UE2 CG ${defColor}
    ${UL_UE2}                     Evaluate    3
    Traffic UE UL                 ueSetting=${UE2_CG}
    ...                           throughput=${UL_UE2}
    ...                           shouldBeStop=False
    ...                           shouldBeCheck=False
    ...                           duration=0

    ${TimeStart_UL_UE2}           Set Variable           ${TIME_LAST_TRAFFIC_START}

    Traced Sleep                  30                     msg=TTI capture start UL CG

    # Stop TTI trace capture
    ${TTIpcap_attachStartULCG}    Stop TTI Traces in Streaming mode
    ...                           tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTITrace_C10_attachStartULCG

    CB008124 get PM files
    ${cnt_peakCGact1}             Retrieve Latest Single Counter Value From Pm File with CellID
    ...                           ${pm_latest}    ${CGcounter_PEAK_CG_ACT_UE}    ${TDD_Cell_list[0].nrCellId}


    # Start TTI trace capture
    Start TTI Traces in Streaming mode    src_ip=10.0.1.2

    Dated Log new line            ${trcColor}--- Modify on line ulCgMaxNumUeUl ${defColor}
    ${cellDistName}               Set Variable         MRBTS-${MRBTS_ID}/NRBTS-${NRBTS_ID}/NRCELL-${TDD_Cell_list[0].nrCellId}
    &{NIDD_ulCgMaxNumUeUl_val}    Create Dictionary    ulCgMaxNumUeUl=2
    &{NIDD_ulCGType2_object}      Evaluate
    ...                           {'dist_name':'${cellDistName}','parameter':'ulConfiguredGrantType2','value':[&{NIDD_ulCgMaxNumUeUl_val}]}
    @{param_list}                 Create List          ${NIDD_ulCGType2_object}
    OAM Set Params                ${param_list}

    Traced Sleep                  10                     msg=TTI capture after ulCgMaxNumUeUl modification

    # Stop TTI trace capture
    ${TTIpcap_ulCgMaxNumUeUl}     Stop TTI Traces in Streaming mode
    ...                           tti_trace_path=${TTIdir}
    ...                           tti_trace_filename=TTITrace_C10_ulCgMaxNumUeUl_upd

    Dated Log New Line            ${trcColor}=== Stop UL traffic and detach UE1 ${defColor}
    Traffic Stop                  ueSetting=${UE1_CG}     dir=ul
    UE Deregister                 id=${UE1_CG.ue}
    ${TimeStop_UL_UE1}            Set Variable           ${TIME_LAST_TRAFFIC_STOP}

    Dated Log New Line            ${trcColor}=== Stop UL traffic and detach UE2 ${defColor}
    Traffic Stop                  ueSetting=${UE2_CG}           dir=ul
    UE Deregister                 id=${UE2_CG.ue}
    ${TimeStop_UL_UE2}            Set Variable           ${TIME_LAST_TRAFFIC_STOP}


    CB008124 get PM files
    ${cnt_peakCGact2}             Retrieve Latest Single Counter Value From Pm File with CellID
    ...                           ${pm_latest}    ${CGcounter_PEAK_CG_ACT_UE}    ${TDD_Cell_list[0].nrCellId}

    ${TTIjson_attachStartULCG}    Convert TTItrace from pcap to others
    ...                           input_file_path=${TTIpcap_attachStartULCG}
    ${TTIcsv_attachStartULCG}     decode_tti_traces_json_using_TtitraceReaderEvtDec   jsonPathName=${TTIjson_attachStartULCG}   num_of_events=200000

    ${TTIjson_ulCgMaxNumUeUl}     Convert TTItrace from pcap to others
    ...                           input_file_path=${TTIpcap_ulCgMaxNumUeUl}
    ${TTIcsv_ulCgMaxNumUeUl}      decode_tti_traces_json_using_TtitraceReaderEvtDec    jsonPathName=${TTIjson_ulCgMaxNumUeUl}    num_of_events=200000


    ${timeDiffUE1}                Subtract Date From Date    ${TimeStop_UL_UE1}    ${TimeStart_UL_UE1}
    ${trafficDurationUE1}         Convert To Integer    ${timeDiffUE1}
    ${expectedDataVolUE1}         Evaluate    ${UL_UE2}*1000000*${trafficDurationUE1}/8

    ${timeDiffUE2}                Subtract Date From Date    ${TimeStop_UL_UE2}    ${TimeStart_UL_UE2}
    ${trafficDurationUE2}         Convert To Integer    ${timeDiffUE2}
    ${expectedDataVolUE2}         Evaluate    ${UL_UE1}*1000000*${trafficDurationUE2}/8

    ${expectedDataVol}            Evaluate    ${expectedDataVolUE1}+${expectedDataVolUE2}
    ${expectedDataVolMargin}      Evaluate    ${expectedDataVol} - ${expectedDataVol}*${TputVolMargin}/100
    ${status_UL_dataVolume}       CB008124 check UL Data Volume    expectedDataVolBytes=${expectedDataVolMargin}
    ...                                                            cellId=${TDD_Cell_list[0].nrCellId}

    ${status_UL_BLER}             CB008124 check UL BLER    maxBLER=1    cellId=${TDD_Cell_list[0].nrCellId}

    Should Be True                ${cnt_peakCGact1}==1 and ${cnt_peakCGact2}==2 and ${status_UL_dataVolume} and ${status_UL_BLER}


CB008124_TC_C_12_B15_Interaction_adaptive_retrans
    ${duplexModeTC}               Set Variable       FDD
    set Suite Variable            ${duplexModeTC}

    CB008124 Create UECG UEnonCG      nbUECG=1

    Dated Log                     ${trcColor}---> Starting gNB commissioning ${defColor}
    # Disable IR in UL because of CgBler AP test mode is not compliant with IR
    ${radp_DisableIR}             Create Dictionary    field=${rdHARQDisableIncrRedundancyUl}          value=1
    ${radp_UlCG_Debug_1}          Create Dictionary    field=${rdEnableUlCgDebug_1}                    value=0x200
    ${radp_UlCG_Debug_2}          Create Dictionary    field=${rdEnableUlCgDebug_2}                    value=0x3
    ${radp_Disable_L_A}           Create Dictionary    field=${rdEnableDisableLA}                      value=0
    ${list_rad_param}             Create List          ${radp_DisableIR}           ${radp_UlCG_Debug_1}
    ...                                                ${radp_UlCG_Debug_2}        ${radp_Disable_L_A}
    Set Fields in swconfig DU     param_list=${list_rad_param}

    # Open connection towards cOAM
    sbts_coam.connect_to          name=${gnb_alias}

    Run Keywords                  coam_parameter.perform_scf_delta_commission
    ...                           delta_file=${delta_file_cb008124_adaptive_retrans}
    ...                           connection=${gnb_alias}
    # Wait end of commissioning
    ...                           AND
    ...                           OAM wait available

    sbts_coam.teardown            connection=${gnb_alias}
    Dated log                     ${trcColor}---> Restart TL ${defColor}
    Restart TL

    CB008124 cell setup
    # Cellsetup is now done, Sherpa can be enabled if needed
    Run Keyword If                ${enable_sherpa} == ${True}           Activate Sherpa

    ${zoi}                      ZOI Start
    ${zoi_end_remain}=          ZOI Remaining Sec                       ${zoi}
    ${start_loop_remaining}=    Evaluate                                ${zoi_end_remain} - ${gp_duration}
    # In order to have a complete GP, the script waits for the beginning of the next GP
    # before starting the scenario.
    Traced Sleep                  ${start_loop_remaining} seconds
    ...                           msg=Waiting ${start_loop_remaining} seconds before starting scenario

    CB008124 Attach               ueSetting=${BASIC_UE_SA}

    Dated Log New Line            ${trcColor}=== Start UL traffic ${defColor}
    Traffic UE UL                 ueSetting=${BASIC_UE_SA}
    ...                           throughput=${UL_throughput}
    ...                           shouldBeStop=False
    ...                           shouldBeCheck=False
    ...                           duration=0

    # Add BLER to only ULCG PUSH with CgBler test mode (2 NACKs, so 3 transmissions)
    wtsemu.cg_testmode_nr         profile_id=1
    ...                           CgBler=40

    wtsemu.ue_testmode_set_nr     id=1
    ...                           scell=0
    ...                           profile_id=1
    ...                           testmode=configured_grant
    ...                           action=activate

    Traced Sleep                  120        msg=UL traffic

    Traffic Stop                  ueSetting=${BASIC_UE_SA}           dir=ul

    # Disable AP test mode
    wtsemu.ue_testmode_set_nr     id=1
    ...                           scell=1
    ...                           profile_id=1
    ...                           testmode=configured_grant
    ...                           action=deactivate

    Dated Log New Line            ${trcColor}=== Detach UE ${defColor}
    UE Deregister                 id=${BASIC_UE_SA.ue}

    Dated log New Line            ${trcColor}=== Starting collecting PM ${defColor}
    ZOI Wait End                  zoi=${zoi}
    ${pm_path}                    Counters.Collect PM files from BTS    ${LOG_PATH}/PM

    # KPIs and counters checks
    ${pm_path}                    Counters.Collect PM files from BTS    ${LOG_PATH}/PM
    KPI Evaluate                  pmFile=${pm_path}
    ...                           constraintsFile=${adaptive_retrans_interaction_constraints}
    ...                           failOnError=${True}
