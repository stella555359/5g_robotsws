TC 1227 SA Call of n UE
    [Documentation]                 Keyword to attach n UEs on n target cells with/wo DL/UL traffic
    ...                             NOTE: If both DL and UL throughput are not null,
    ...                             DL and UL traffic are launched simultaneously
    ...                             NOTE: Keyword "Multi Cells Setup SANSA 1227" must be be called before
   ...                              running this step to initiate Lua config file with nb of UE
    [Arguments]
#   ${CellID}                  set variable            ${NRCELL_ID_LIST[${Cell}-1]}
#   Returns NRCELL_ID_LIST=[1, 2, 3, 4, 5, 6, None, None, None]
    ${UEsList}                 Build UEs list          CallType=${CallType}     UEnb=${UEnb}    CellID=${CellID}
    ${UEnb_attached}            Evaluate                0
#   Multi Cells Setup SANSA 1227    CallType=${CallType}    UEsList=${UEsList}
    FOR    ${loopIND}    IN RANGE    1    ${LoopNb}+1
        ${UEsAttached}         UE Attach    UEsList=${UEsList}    CallType=${CallType}
        Sleep                  5s
        Run Keyword If         ${TrafficDuration} != 0
        ...                    Traffic    UEsList=${UEsAttached}    Duration=${TrafficDuration}    DLtput=${DLthroughput}    ULtput=${ULthroughput}
        Sleep                  5s
        UE Detach              UEsList=${UEsAttached}
        ${UE_attached_loop}    get length         ${UEsAttached}
#       ${UEnb_attached}       Evaluate           ${UEnb_attached} + ${UE_attached_loop}
    END

TC 1227 SA Call of 2 UEs with nonGBR UL DL Traffic
    [Documentation]                 Keyword to attach/detach 2 UEs on target_cells defined in the dictionary ${UEsList_nonGBR}
    ...                             and run nonGBR DL Traffic during 20 second with 2 different traffic profiles
    [Arguments]
#   ${UEsList_nonGBR}              Build UEs list SA NonGBR     UEnb=2
    ${UEList_1_nonGBR}             Build UE List_1 NonGBR       # Initialize WTS lua config file with 2 UEs per cell & different Traffic Profile
    ${UEList_2_nonGBR}             Build UE List_2 NonGBR       # Create a UE List with different Traffic Profile for Traffic UEs DL
    ${UEList_3_nonGBR}             Build UE List_3 NonGBR       # Create a UE List with different Traffic Profile for Traffic UEs UL
    Multi Cells Setup SANSA 1227    CallType=${CallType}    UEsList=${UEList_1_nonGBR}     # Lua config file with 4 UE traffic profile=UEsList_nonGBR
    # Cellsetup is now completed
    Activate Sherpa On All Cells
    Dated Log New Line      Setting up WTS with LUA configuration file with the following UEs setting List : ${UEList_1_nonGBR}
    FOR    ${loopIND}    IN RANGE    1    ${LoopNb}+1
        ${UEsAttached}         UE Attach    UEsList=${UEList_1_nonGBR}    CallType=${CallType}
    END
    Traffic UEs DL    ueSettingList=${UEList_2_nonGBR}    duration=20    shouldBeStop=False    shouldBeCheck=True    protocol=udp
    # ...  UE1 start non GBR traffic DL=50 Mbps & UE2 start non GBR traffic DL=100 Mbps during unlimitted time.
    Traffic UEs UL    ueSettingList=${UEList_3_nonGBR}    duration=20    shouldBeStop=True    shouldBeCheck=True    protocol=udp
#    Traffic UEs UL DL    ueSettingList=${UEList_1_nonGBR}    ulThroughput=20    # dlThroughput=50
#    ...                  duration=10    shouldBeStop=True    shouldBeCheck=True    protocol=udp
    FOR    ${loopIND}    IN RANGE    1    ${LoopNb}+1
        UE Detach              UEsList=${UEsAttached}
        ${UE_attached_loop}    get length         ${UEsAttached}
    END
    Stop Sherpa Collection

TC 1227 SA Call of 2 UEs with GBR UL DL Traffic
    [Documentation]                 Keyword to Attach/Detach 2 UEs on target_cells defined in the dictionary ${UEList_1_GBR}
    ...                             and run GBR DL Traffic during 20 second with 2 different traffic profiles
    [Arguments]
    ${UEList_1_GBR}             Build UE List_1 GBR
    Dated Log New Line      Setting up WTS with LUA configuration file with the following UEs setting List : ${UEList_1_GBR}
    # Config1227.Modify WTS Cfg
    Multi Cells Setup SANSA 1227    CallType=${CallType}    UEsList=${UEList_1_GBR}     # Init Lua config file
    # Cellsetup is now completed
    Activate Sherpa On All Cells
    UE Register                     ue=1
    Launch PDU Session              ue=1    pdu=1    gw=1    nwslice=1
    UE PDU Session Modify           ue=1    pdu=1    qfta=2    by=amf
    UE PDU Session Modify           ue=1    pdu=1    qfta=3    by=amf
    Dated Log New Line       UE1 : GBR Traffic DL=10Mbps + UL=20Mbps
    wtsemu.trf_data_start    ue=1    pdu=1    qfi=1    trf_id=5    dir=dl    mbps=1
    wtsemu.trf_data_start    ue=1    pdu=1    qfi=2    trf_id=6    dir=dl    mbps=9     protocol=tcp
    wtsemu.trf_data_start    ue=1    pdu=1    qfi=3    trf_id=7    dir=dl    mbps=10    protocol=udp
    wtsemu.trf_data_start    ue=1    pdu=1    qfi=3    trf_id=7    dir=ul    mbps=20    protocol=udp
    Sleep                  15s
    ${traffic_ue1_dl_qfi_2}      Get Average Traffic Rate    ue=1  pdu=1  qfi=2  trf_id=6  dir=dl
    ${traffic_ue1_dl_qfi_3}      Get Average Traffic Rate    ue=1  pdu=1  qfi=3  trf_id=7  dir=dl
    ${traffic_ue1_ul_qfi_3}      Get Average Traffic Rate    ue=1  pdu=1  qfi=3  trf_id=7  dir=ul
    Dated Log New Line      UE1 Traffic Dl Qfi=2 : ${traffic_ue1_dl_qfi_2}
    Dated Log New Line      UE1 Traffic Dl Qfi=3 : ${traffic_ue1_dl_qfi_3}
    Dated Log New Line      UE1 Traffic Ul Qfi=3 : ${traffic_ue1_ul_qfi_3}
    UE Register                     ue=2
    Launch PDU Session              ue=2    pdu=1    gw=2    nwslice=1
    UE PDU Session Modify           ue=2    pdu=1    qfta=2    by=amf
    UE PDU Session Modify           ue=2    pdu=1    qfta=3    by=amf
    Dated Log New Line       UE2 : GBR Traffic DL=20Mbps + UL=10Mbps
    wtsemu.trf_data_start    ue=2    pdu=1    qfi=1    trf_id=5    dir=dl    mbps=1
    wtsemu.trf_data_start    ue=2    pdu=1    qfi=2    trf_id=6    dir=dl    mbps=9     protocol=tcp
    wtsemu.trf_data_start    ue=2    pdu=1    qfi=3    trf_id=7    dir=dl    mbps=20    protocol=udp
    wtsemu.trf_data_start    ue=2    pdu=1    qfi=3    trf_id=7    dir=ul    mbps=10    protocol=udp
    Sleep                  15s
    ${traffic_ue2_dl_qfi_2}      Get Average Traffic Rate    ue=2  pdu=1  qfi=2  trf_id=6  dir=dl
    ${traffic_ue2_dl_qfi_3}      Get Average Traffic Rate    ue=2  pdu=1  qfi=3  trf_id=7  dir=dl
    ${traffic_ue2_ul_qfi_3}      Get Average Traffic Rate    ue=2  pdu=1  qfi=3  trf_id=7  dir=ul
    Dated Log New Line      UE2 Traffic Dl Qfi=2 : ${traffic_ue2_dl_qfi_2}
    Dated Log New Line      UE2 Traffic Dl Qfi=3 : ${traffic_ue2_dl_qfi_3}
    Dated Log New Line      UE2 Traffic Ul Qfi=3 : ${traffic_ue2_ul_qfi_3}
    Dated Log New Line      UE1 & UE2 Stop GBR DL + UL Traffic
    wtsemu.Trf Data Stop    ue=1    pdu=1    qfi=3    trf_id=7    dir=dl
    wtsemu.Trf Data Stop    ue=1    pdu=1    qfi=3    trf_id=7    dir=ul
    wtsemu.Trf Data Stop    ue=1    pdu=1    qfi=2    trf_id=6    dir=dl
    wtsemu.Trf Data Stop    ue=1    pdu=1    qfi=1    trf_id=5    dir=dl
    wtsemu.Trf Data Stop    ue=2    pdu=1    qfi=1    trf_id=5    dir=dl
    wtsemu.Trf Data Stop    ue=2    pdu=1    qfi=2    trf_id=6    dir=dl
    wtsemu.Trf Data Stop    ue=2    pdu=1    qfi=3    trf_id=7    dir=dl
    wtsemu.Trf Data Stop    ue=2    pdu=1    qfi=3    trf_id=7    dir=ul
    UE Deregister    id=1
    UE Deregister    id=2
    Sleep                  2s
    Stop Sherpa Collection

