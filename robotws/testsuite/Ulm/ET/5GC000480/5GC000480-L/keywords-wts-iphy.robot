Update Wts File For TC 480L ${mode}
    [Documentation]    [PRIVATE]    update wts cfg file for 480L
    ...       :Autor: Sylvia Schneider
    Log To Console    \nupdate wts ${mode}
    ${wtsconfig}   Get WTS Config    target_dir=${resultBaseDir}
    wts.Load Wts Cfg             ${wtsconfig}
    wts.Modify    enb_endc_param id=1   serving_cell_index_range_scg=8:11
    wts.Delete   set_cell id=1 gnb=2
    wts.Delete   set_cell id=2 gnb=2
    wts.Insert   set_cell id=1 gnb=2 nr_arfcn=2071675:2071675 gscn=22446 eci=0x000021f pci=16:2 tac=200    after    set_gnb id=2
    wts.Modify   set_cell id=1 gnb=2   proxy=$PROXY_SERVER_IP:9999|$PROXY_SERVER_IP:8888 nrci=0x01 tdd_cell=on mandatory_for_activation=off
    wts.Insert   set_cell id=2 gnb=2 nr_arfcn=${nrcell2_nrarfcn_${mode}}:${nrcell2_nrarfcn_${mode}}     after    set_cell id=1 gnb=2
    wts.Modify   set_cell id=2 gnb=2   gscn=${nrcell2_gscn_${mode}} eci=0x000021f pci=17:0 tac=200 proxy=$PROXY_SERVER_IP:9999|$PROXY_SERVER_IP:8888
    wts.Modify   set_cell id=2 gnb=2   nrci=0x02 tdd_cell=on mandatory_for_activation=off
    wts.Insert   set_cell id=3 gnb=2 nr_arfcn=2075003:2075003 gscn=22458 eci=0x000021f pci=17:1 tac=200    after    set_cell id=2 gnb=2
    wts.Modify   set_cell id=3 gnb=2   proxy=$PROXY_SERVER_IP:9999|$PROXY_SERVER_IP:8888 nrci=0x03 tdd_cell=on mandatory_for_activation=off
    wts.Insert   set_cell id=4 gnb=2 nr_arfcn=2076667:2076667 gscn=22464 eci=0x000021f pci=17:2 tac=200    after    set_cell id=3 gnb=2
    wts.Modify   set_cell id=4 gnb=2   proxy=$PROXY_SERVER_IP:9999|$PROXY_SERVER_IP:8888 nrci=0x04 tdd_cell=on mandatory_for_activation=off

    wts.Modify    ue_param id=101   ue_nr_capabilities=${${mode}_nr_cap} ue_eutra_nr_capabilities=${${mode}_eu_cap}
    wts.Modify    ue_param id=102   ue_nr_capabilities=${contiguous_nr_cap} ue_eutra_nr_capabilities=${contiguous_eu_cap}

    wts.Save Wts Cfg              ${resultBaseDir}/basic_wts_480L.cfg
    Log To Console    wts cfg saved as ${resultBaseDir}/basic_wts_480L.cfg
    wts_ue.Upload Customized WTS Config    config_path=${resultBaseDir}/basic_wts_480L.cfg



Update Iphy File ${mode}
    [Documentation]    [PRIVATE]    update iphy file
    ...       :Autor: Sylvia Schneider
    Log To Console    update iphy file ${mode}
    ${ACU_alias}    connect.Connect To Airphone Common Unit
    ssh.Execute    cp /ffs/run/simmode/new_iphy.xml /ffs/run/simmode/new_iphy_orig.xml    connection=${ACU_alias}
    ssh.Download File    /rom/simmode/new_iphy.xml    ${resultBaseDir}/new_iphy.xml    connection=${ACU_alias}

    ${contents}    Get File    ${resultBaseDir}/new_iphy.xml
    Log To Console    remove 2nd RMOD
    ${all_parts}    Split String      ${contents}     </vcellList>
    ${cont_upd1}   Catenate         SEPARATOR=</vcellList>   ${all_parts}[0]   ${all_parts}[2]
    Create File    ${resultBaseDir}/new_iphy_upd_1st.xml    ${cont_upd1}

    Log To Console    update and add cells
    ${cont_upd2}    Split String      ${cont_upd1}     vcell>
    ${cell1}    Replace String Using Regexp          ${cont_upd2}[1]         GSCN>.*<\/GSCN>   GSCN>22446<\/GSCN>
    ${cell2}    Set Variable    ${cont_upd2}[1]
    ${cell2}    Replace String Using Regexp          ${cell2}                cell>.*<\/cell>   cell>2.2<\/cell>
    ${cell2}    Replace String Using Regexp          ${cell2}                phy_cell_id>.*<\/phy_cell_id>   phy_cell_id>51<\/phy_cell_id>
    ${cell2}    Replace String Using Regexp          ${cell2}                GSCN>.*<\/GSCN>   GSCN>${nrcell2_gscn_${mode}}<\/GSCN>
    ${cell3}    Set Variable    ${cont_upd2}[1]
    ${cell3}    Replace String Using Regexp          ${cell3}                cell>.*<\/cell>   cell>2.3<\/cell>
    ${cell3}    Replace String Using Regexp          ${cell3}                phy_cell_id>.*<\/phy_cell_id>   phy_cell_id>52<\/phy_cell_id>
    ${cell3}    Replace String Using Regexp          ${cell3}                GSCN>.*<\/GSCN>   GSCN>22458<\/GSCN>
    ${cell4}    Set Variable    ${cont_upd2}[1]
    ${cell4}    Replace String Using Regexp          ${cell4}                cell>.*<\/cell>   cell>2.4<\/cell>
    ${cell4}    Replace String Using Regexp          ${cell4}                phy_cell_id>.*<\/phy_cell_id>   phy_cell_id>53<\/phy_cell_id>
    ${cell4}    Replace String Using Regexp          ${cell4}                GSCN>.*<\/GSCN>   GSCN>22464<\/GSCN>


    ${new contents}      Catenate         SEPARATOR=vcell>     ${cont_upd2}[0]   ${cell1}
    ${new contents}      Catenate         SEPARATOR=${EMPTY}   ${new contents}   vcell><
    ${new contents}      Catenate         SEPARATOR=vcell>     ${new contents}   ${cell2}
    ${new contents}      Catenate         SEPARATOR=${EMPTY}   ${new contents}   vcell><
    ${new contents}      Catenate         SEPARATOR=vcell>     ${new contents}   ${cell3}
    ${new contents}      Catenate         SEPARATOR=${EMPTY}   ${new contents}   vcell><
    ${new contents}      Catenate         SEPARATOR=vcell>     ${new contents}   ${cell4}

    ${new contents}      Catenate         SEPARATOR=vcell>   ${new contents}   ${cont_upd2}[2]

    Create File    ${resultBaseDir}/new_iphy_upd.xml    ${new contents}
    ssh.Upload File       ${resultBaseDir}/new_iphy_upd.xml    /rom/simmode/new_iphy.xml   connection=${ACU_alias}


