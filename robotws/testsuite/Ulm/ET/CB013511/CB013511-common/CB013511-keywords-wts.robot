Upload Wts Cfg File
    [Documentation]    [PRIVATE]    upload wts cfg file
    ...       :Author: Sylvia Schneider
    [Arguments]   ${wts_file}
    Log To Console    \nupload wts file ${wts_file}
    wts_ue.Upload Customized WTS Config    config_path=${wts_file}


Update Wts File For A_SE_TC02_TC03
    [Documentation]    [PRIVATE]    Update Wts File For A_SE_TC02_TC03
    ...       :Author: Sylvia Schneider
    Log To Console    \nupdate wts
    ${wtsconfig}   wts_ue.Get WTS Config    target_dir=${resultBaseDir}
    wts.Load wts cfg             ${wtsconfig}

    wts.Modify    set_cell id=1 bw=10MHz enb=1    earfcn=900:18900
    wts.Insert    set_cell id=2 bw=10MHz enb=1 eci=0x1234602    after    set_cell id=1 bw=10MHz enb=1
    wts.Modify    set_cell id=2 bw=10MHz enb=1    pci=4:0 tac=222 proxy=$SERVER_IP:12220 earfcn=900:18900

    wts.Modify    ue_param id=111    ue_nr_capabilities=${SA_5CCspec} ue_eutra_nr_capabilities=${EUTRA_MRDC_3bands}
    wts.Modify    ue_param id=112    ue_nr_capabilities=${S21_NR} ue_eutra_nr_capabilities=${S21_MRDC}

    wts.Save Wts Cfg              ${resultBaseDir}/basic_wts_CB013511_A_SE_TC02_TC03.cfg
    Log To Console    wts cfg saved as ${resultBaseDir}/basic_wts_CB013511_A_SE_TC02_TC03.cfg
    Upload Wts Cfg File     ${resultBaseDir}/basic_wts_CB013511_A_SE_TC02_TC03.cfg


