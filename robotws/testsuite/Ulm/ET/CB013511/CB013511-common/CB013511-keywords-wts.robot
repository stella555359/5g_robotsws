Update Wts File For A_SE_TC04
    [Documentation]    [PRIVATE]    Update Wts File For A_SE_TC04
    ...       :Author: Sylvia Schneider
    Create IPs For Simulated gNB
    Log To Console    \nupdate wts
    ${wtsconfig}   wts_ue.Get WTS Config    target_dir=${resultDir}
    wts.Load Wts Cfg             ${wtsconfig}

    wts.Insert    set ENB3_S1_ADDR="10.0.1.140"     after    set ENB1_S1_ADDR="10.0.1.136"
    wts.Insert    set ENB3_X2_ADDR="10.0.1.138"     after    set ENB1_X2_ADDR="10.0.1.137"
    wts.Insert    set ENB3_X2U_ADDR="10.0.1.139"    after    set ENB_X2U_ADDR="10.0.1.135"

    wts.Insert    set_enb id=3 plmn=310:260 s1=$ENB3_S1_ADDR enb_id_macro=0x12347    after    set_enb id=1
    wts.Modify    set_enb id=3    daemon=$DAEMON_IP:$DAEMON_PORT x2=$ENB3_X2_ADDR x2u=$ENB3_X2U_ADDR
    wts.Modify    set_enb id=3    type=simulated x2_peers=none
    wts.Insert    enb_param id=3 drb_id_begin=3 endc_capable_qci=all   after   enb_param id=1

    wts.Modify    set_cell id=1 bw=10MHz enb=1   earfcn=900:18900
    wts.Insert    set_cell id=2 bw=10MHz enb=1 eci=0x1234602 pci=4:0 tac=222 proxy=$SERVER_IP:12220   after  set_cell id=1 bw=10MHz enb=1
    wts.Modify    set_cell id=2 bw=10MHz enb=1   earfcn=900:18900
    wts.Insert    set_cell id=1 bw=10MHz enb=3 eci=0x1234701 pci=4:1 tac=222 proxy=$SERVER_IP:12221  after  set_cell id=2 bw=10MHz enb=1
    wts.Modify    set_cell id=1 bw=10MHz enb=3   earfcn=900:18900

    wts.Insert    enb_endc_param id=3 control_flow_period=3gpp1 use_nr_ran_cont=on   after   enb_endc_param id=1
    wts.Modify    enb_endc_param id=3    serving_cell_index_range_scg=8:14

    wts.Modify    ue_param id=111    ue_nr_capabilities=${SA_5CCspec} ue_eutra_nr_capabilities=${EUTRA_MRDC_3bands_TC05}

    wts.Save Wts Cfg              ${resultDir}/basic_wts_CB013511_A_SE_TC04.cfg
    Log To Console    wts cfg saved as ${resultDir}/basic_wts_CB013511_A_SE_TC04.cfg
    Upload Wts Cfg File     ${resultDir}/basic_wts_CB013511_A_SE_TC04.cfg


Create IPs For Simulated gNB
    [Documentation]    [PRIVATE]    Create IPs For Simulated gNB
    ...       :Author: Sylvia Schneider
    Log To Console    \ncreate IPs 10.0.1.138, 10.0.1.139, 10.0.1.140 on VM eth3
    ute_workarounds.Configure IP On VM    ip=10.0.1.138      interface=eth3
    ute_workarounds.Configure IP On VM    ip=10.0.1.139      interface=eth3
    ute_workarounds.Configure IP On VM    ip=10.0.1.140      interface=eth3

