Update wts file for TC CB008127-CD
    [Documentation]    [PRIVATE]    update wts cfg file for CB008127-CD
    ...       :Autor: Sylvia Schneider
    Log To Console    \nupdate wts
    ${wtsconfig}   Get WTS Config    target_dir=${resultBaseDir}
    wts.Load wts cfg             ${wtsconfig}

    wts.Insert    set GNB3_X2_ADDR="10.0.1.3"    after    set GNB_NG_ADDR="10.0.1.2"
    wts.Insert    set GNB3_S1U_ADDR="10.0.1.4"   after    set GNB3_X2_ADDR="10.0.1.3"
    wts.Insert    set GNB3_X2U_ADDR="10.0.1.5"   after    set GNB3_S1U_ADDR="10.0.1.4"

    wts.Modify    set_gnb id=2          gnb_id=0x01:22
    wts.Modify    set_cell id=2 gnb=2   gscn=7995 nr_arfcn=647666:647666

    wts.Insert    set_gnb id=3 type=simulated plmn=311:489 s1u=$GNB3_S1U_ADDR x2=$GNB3_X2_ADDR:36422       after   set_cell id=4 gnb=2
    wts.Modify    set_gnb id=3   gnb_id=0x26:28 daemon=$DAEMON_IP:$DAEMON_PORT x2_peers=none plmnList=311:489,311:388
    wts.Insert    set_cell id=1 gnb=3 nr_arfcn=636666:636666 gscn=7880 pci=16:0 tac=200     after   set_gnb id=3
    wts.Modify    set_cell id=1 gnb=3   proxy=$GNB3_X2_ADDR:9999|$GNB3_X2_ADDR:8890 nrci=0x01 tdd_cell=on mandatory_for_activation=off

    wts.Modify    ue_param id=101    ue_nr_capabilities=${NSA_UE_CAP_TDD_Profile1}
    wts.Modify    ue_param id=102    ue_nr_capabilities=${NSA_UE_CAP_TDD_Profile2}
    wts.Modify    ue_param id=103    ue_nr_capabilities=${NSA_UE_CAP_TDD_Profile3}

    wts.Save wts cfg              ${resultBaseDir}/basic_wts_CB008127_CD.cfg
    Log To Console    wts cfg saved as ${resultBaseDir}/basic_wts_CB008127_CD.cfg


