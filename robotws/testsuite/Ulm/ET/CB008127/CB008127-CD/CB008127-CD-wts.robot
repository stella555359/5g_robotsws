Update wts file for TC CB008127-CD add cell2 and eNB9
    [Documentation]    [PRIVATE]    update wts cfg file for CB008127-CD add cell2 and eNB9
    ...       :Autor: Sylvia Schneider
    Log To Console    \nupdate wts add cell2 and eNB9
    wts.Load wts cfg             ${resultBaseDir}/basic_wts_CB008127_CD.cfg
    wts.Insert    set_cell id=2 enb=1 eci=0x1234602 pci=4:0 tac=222 proxy=$DAEMON_IP:12221|$DAEMON_IP:8889    after   set_cell id=1 enb=1
    wts.Modify    set_cell id=2 enb=1   earfcn=2000:20000 mapped_earfcn=4200:22200 tdd_cell=on mandatory_for_activation=off

    wts.Insert    set ENB9_X2_ADDR="10.0.1.6"    after    set GNB3_S1U_ADDR="10.0.1.4"
    wts.Insert    set ENB9_X2U_ADDR="10.0.1.7"   after    set ENB9_X2_ADDR="10.0.1.6"
    wts.Insert    set ENB9_S1_ADDR="10.0.1.8"    after    set ENB9_X2U_ADDR="10.0.1.7"

    wts.Insert    set_enb id=9 plmn=311:489 s1=$ENB9_S1_ADDR enb_id_macro=0x12349 daemon=$DAEMON_IP:$DAEMON_PORT    after   set_cell id=1 gnb=3
    wts.Modify    set_enb id=9   x2=$ENB9_X2_ADDR x2u=$ENB9_X2U_ADDR type=simulated x2_peers=1
    wts.Insert    enb_param id=9 drb_id_begin=3 endc_capable_qci=9    after   set_enb id=9
    wts.Insert    set_cell id=9 enb=9 eci=0x1234901 pci=9:2 tac=222 proxy=$CONTAINER_IP:12211 earfcn=2000:20000     after   enb_param id=9
    wts.Modify    set_cell id=9    mapped_earfcn=4200:22200 tdd_cell=on mandatory_for_activation=off
    wts.Insert    enb_endc_param id=9 control_flow_period=3gpp1 use_nr_ran_cont=on                                  after   set_cell id=9

    wts.Save wts cfg              ${resultDir}/basic_wts_CB008127_CD_add_cell2_eNB9.cfg
    Log To Console    wts cfg saved as ${resultDir}/basic_wts_CB008127_CD_add_cell2_eNB9.cfg


