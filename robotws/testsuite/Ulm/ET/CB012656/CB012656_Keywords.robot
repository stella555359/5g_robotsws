Verify RRC Release Contains cellReselectionPriorities IE with Expected Target Frequencies
    [Documentation]    This keyword verifies whether expected NRARFCNs and LTE ARFCNs are present in Cell Reselection Priorities List when a UE gets
    ...   released from the network. When the idleMMSteeringAlgo is UL CA aware, then one of the NRARFCNs that is eligible for primary candidate get
    ...   priority 7 and other eligible primary candidates get 6.8, 6.6 and so on. Since priority 7 target is picked based on WRR, it may not be same
    ...   when execute the same scenario multiple times. When the idleMMSteeringAlgo is UL and DL CA aware, UL CA aware (CB012656) gets precedence
    ...   DL CA aware (CB007516).
    [Arguments]   ${steer_freq_1}   ${steer_freq_2}   ${steer_freq_3}   ${dl_freq_1}   ${dl_freq_2}   ${sib-1_freq}   ${lte_freq_1}=2175
    ...           ${lte_freq_2}=3100   ${lte_freq_3}=3625   ${lte_freq_4}=66886   ${lte_freq_5}=300   ${prio1}=6   ${sub_prio1}=4   ${prio2}=6
    ...           ${sub_prio2}=2   ${prio3}=6   ${sub_prio3}=0   ${prio4}=5   ${sub_prio4}=6   ${dl_freq_3}=${EMPTY}   ${steer_freq_4}=${EMPTY}
    ...           ${freq_5}=${EMPTY}   ${prio5}=${EMPTY}
    ${log_content}=             Get File       ${EGATE_CONSOLE_LOG}
    @{cellReselectionPriorities_ie}=    Create List
    @{target_steer_freq_list}=    Create List    ${steer_freq_1}   ${steer_freq_2}   ${steer_freq_3}
    IF    '${steer_freq_4}' != ''    Append To List    ${target_steer_freq_list}    ${steer_freq_4}
    FOR   ${target}   IN   @{target_steer_freq_list}
        ${exp_steer_prim_sec_nr_target_1}=      Catenate     SEPARATOR=${empty}       carrierFreq\\s${target},\\n\\s+cellReselectionPriority\\s7\\n
        ${exp_steer_prim_sec_nr_target_2}=      Catenate     SEPARATOR=${empty}       carrierFreq\\s${target},\\n\\s+cellReselectionPriority\\s6,\\n
        ...     \\s+cellReselectionSubPriority\\soDot8\\n
        ${exp_steer_prim_sec_nr_target_3}=      Catenate     SEPARATOR=${empty}       carrierFreq\\s${target},\\n\\s+cellReselectionPriority\\s6,\\n
        ...     \\s+cellReselectionSubPriority\\soDot6\\n
        ${target_1}=          Set Variable   ${exp_steer_prim_sec_nr_target_1}
        ${target_2}=          Set Variable   ${exp_steer_prim_sec_nr_target_2}
        ${target_3}=          Set Variable   ${exp_steer_prim_sec_nr_target_3}
        ${exp_steer_prim_sec_nr_target_4}=      Catenate     SEPARATOR=${empty}       carrierFreq\\s${target},\\n\\s+cellReselectionPriority\\s6,\\n
        ...     \\s+cellReselectionSubPriority\\soDot4\\n
        ${target_4}=    Set Variable If    '${steer_freq_4}' != '${EMPTY}'    ${exp_steer_prim_sec_nr_target_4}    ${EMPTY}
        @{target_freqs}=      Create List    ${target_1}   ${target_2}   ${target_3}
        IF    '${target_4}' != ''    Append To List    ${target_freqs}    ${target_4}
        FOR   ${freqPriorityListNR}   IN   @{target_freqs}
            ${steer_arfcn_present}=   Run Keyword And Return Status   Should Match Regexp     ${log_content}      ${freqPriorityListNR}
            IF   ${steer_arfcn_present}    Append To List    ${cellReselectionPriorities_ie}   True
        END
        ${freqPriorNR_arfcnpresent}=    Get Length    ${cellReselectionPriorities_ie}
        IF   ${freqPriorNR_arfcnpresent} != 1    FAIL    Cell Reselection Priorities IE not (or many times) found in RRC Release message
        @{cellReselectionPriorities_ie}=    Create List
    END
    ${exp_lte_sib_minus_1_targets}=      Catenate     SEPARATOR=${empty}      carrierFreq\\s${lte_freq_1},\\n\\s+cellReselectionPriority\\s5,\\n\\s+
    ...   cellReselectionSubPriority\\soDot4\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s${lte_freq_2},\\n\\s+cellReselectionPriority\\s5\\n\\s+},\\n\\s+{
    ...   \\n\\s+carrierFreq\\s${lte_freq_3},\\n\\s+cellReselectionPriority\\s2,\\n\\s+cellReselectionSubPriority\\soDot8\\n\\s+},\\n\\s+{\\n\\s+
    ...   carrierFreq\\s${lte_freq_4},\\n\\s+cellReselectionPriority\\s2\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s${lte_freq_5},\\n\\s+
    ...   cellReselectionPriority\\s1,\\n\\s+cellReselectionSubPriority\\soDot4\\n
    ${exp_dlca_sec_nr_target_1}=      Catenate     SEPARATOR=${empty}    carrierFreq\\s${dl_freq_1},\\n\\s+cellReselectionPriority\\s${prio1},\\n\\s+
    ...   cellReselectionSubPriority\\soDot${sub_prio1}\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s${dl_freq_2},\\n\\s+cellReselectionPriority\\s${prio2}
    ${exp_dlca_sec_nr_target_2}=      Catenate     SEPARATOR=${empty}    ,\\n\\s+cellReselectionSubPriority\\soDot${sub_prio2}\\n\\s+},\\n\\s+{\\n
    ...   \\s+carrierFreq\\s${dl_freq_3},\\n\\s+cellReselectionPriority\\s${prio3}
    ${exp_dlca_sec_nr_targets}=    Set Variable If    '${dl_freq_3}' != ''    ${exp_dlca_sec_nr_target_1}${exp_dlca_sec_nr_target_2}
    ...   ${exp_dlca_sec_nr_target_1}
    ${dl_targets}=    Set Variable If    '${sub_prio3}' != '0'
    ...      ${exp_dlca_sec_nr_targets},\\n\\s+cellReselectionSubPriority\\soDot${sub_prio3}\\n\\s+}    ${exp_dlca_sec_nr_targets}
    ${sib_minus_one_nr}=      Catenate     SEPARATOR=${empty}       carrierFreq\\s${sib-1_freq},\\n\\s+cellReselectionPriority\\s${prio4},\\n
    ...    \\s+cellReselectionSubPriority\\soDot${sub_prio4}\\n
    ${sib_minus_1_targets}=    Set Variable If    '${freq_5}' != ''
    ...      ${sib_minus_one_nr}\\s+},\\n\\s+{\\n\\s+carrierFreq\\s${freq_5},\\n\\s+cellReselectionPriority\\s${prio5}    ${sib_minus_one_nr}
    @{target_nr_lte_freqs}=     Create List    ${dl_targets}   ${sib_minus_1_targets}   ${exp_lte_sib_minus_1_targets}
    FOR   ${dlfreqsecListNR}   IN   @{target_nr_lte_freqs}
        ${nr_lte_arfcn_present}=   Run Keyword And Return Status   Should Match Regexp     ${log_content}      ${dlfreqsecListNR}
        IF   ${nr_lte_arfcn_present} == False    FAIL    Expected Cell Reselection Priorities IE not found in RRC Release message
    END

Trigger AMF Initiated RRC Release
    [Documentation]    This keyword is to trigger AMF Initiated RRC Release. This will be captured and assigned to a vraiable and later check
    ...    whether expected ARFCNs are present in cell reselection priorities IE.
    [Arguments]   ${ue_id}   ${ue_deregister_type}=switch_off   ${by}=ue   ${timeout}=10
    ${ca_aware_resel}   wts_ue.Send Egate Command and verify output   cmd=ue_deregister id=${ue_id} ue_deregister_type=${ue_deregister_type} by=${by}
    ...   timeout=${timeout}  pass_regexp=UE${ue_id}: detached
    BuiltIn.Log   UE${ue_id} deregistration is successful   console=${P_console}
    Create File    /opt/iphy/latest/cellReselectionPriorities.log    ${ca_aware_resel}

Trigger UE Assistance Info based RRC Connected to RRC Inactive Transition
    [Documentation]    gNB triggers RRC release with suspendConfig when UE inactivity timer expires. This keyword wait for the timer to expire and
    ...   then check whether UE is moved to RRC Inactive state.
    [Arguments]   ${ue_id}
    ${ca_aware_resel}   wts_ue.Send Egate Command and verify output   cmd=ue_assistance_send_nr ue_id=${ue_id} PreferredRRCState=inactive
    ...   pass_regexp=UE${ue_id}:.*Processing RRC release with suspendConfig. Moving UE to NR_RRC_INACTIVE state.
    BuiltIn.Log   UE${ue_id} Processed RRC release with suspendConfig and UE moved to NR_RRC_INACTIVE state   console=${P_console}
    Create File    /opt/iphy/latest/cellReselectionPriorities.log    ${ca_aware_resel}

Verify whether gNB Triggers RRC Release
    [Documentation]    gNB Triggers RRC Release when UE Inactivity timer expires. This keyword wait for the timer to expire and then check whether
    ...   UE is moved to RRC Idle state.
    [Arguments]   ${ue_id}   ${timeout}=6
    ${ca_aware_resel}   wts_ue.Send Egate Command and verify output   cmd=ue_disp id=${ue_id}  timeout=${timeout}  pass_regexp=UE${ue_id}: IS IDLE
    BuiltIn.Log   Received UE Context Release Complete from GNB-2   console=${P_console}
    Create File    /opt/iphy/latest/cellReselectionPriorities.log    ${ca_aware_resel}

Send A4 Measurement Report and Verify whether gNB Triggers RRC Release with High Prio LTE Frequency
    [Documentation]    UE sends A4 MR when it gets configured with A4 measurement event, then gNB triggers CB008696.
    [Arguments]   ${ue_id}   ${meas_id}=5
    ${cmd}=       Set variable     ue_measurement_send_nr event=A4 srsrp_nr=70 phycell_id=52 nrsrp_nr=80 nrsrq_nr=60 id=${ue_id} meas_id=${meas_id}
    ${ca_aware_resel}   wts_ue.Send Egate Command and verify output   cmd=${cmd}  pass_regexp=UE${ue_id}: IS IDLE
    BuiltIn.Log   Received UE Context Release Complete from GNB-2   console=${P_console}
    Create File    /opt/iphy/latest/cellReselectionPriorities.log    ${ca_aware_resel}
    Verify RRC Release Contains cellReselectionPriorities IE with High Priority for LTE Target

Verify RRC Release Contains cellReselectionPriorities IE with High Priority for LTE Target
    [Documentation]    When UE gets released and CB008696 gets triggered, then LTE ARFCN for which UE sends A4 MR gets high priority 7 and all other
    ...   supported targets (LTE ARFCNs and NRARFCNs) get SIB-1 priority.
    [Arguments]
    ${log_content}=             Get File       ${EGATE_CONSOLE_LOG}
    ${exp_lte_targets}=      Catenate     SEPARATOR=${empty}      carrierFreq\\s300,\\n\\s+cellReselectionPriority\\s7\\n\\s+},\\n\\s+{\\n\\s+
    ...   carrierFreq\\s2175,\\n\\s+cellReselectionPriority\\s5,\\n\\s+cellReselectionSubPriority\\soDot4\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s3100,
    ...   \\n\\s+cellReselectionPriority\\s5\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s3625,\\n\\s+cellReselectionPriority\\s2,\\n\\s+
    ...   cellReselectionSubPriority\\soDot8\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s66886,\\n\\s+cellReselectionPriority\\s2\\n\\s+}
    ${exp_nr_targets}=      Catenate     SEPARATOR=${empty}       carrierFreq\\s518910,\\n\\s+cellReselectionPriority\\s5,\\n\\s+
    ...   cellReselectionSubPriority\\soDot6\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s127450,\\n\\s+cellReselectionPriority\\s5,\\n\\s+cellReselection
    ...   SubPriority\\soDot2\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s531870,\\n\\s+cellReselectionPriority\\s4,\\n\\s+cellReselectionSubPriority
    ...   \\soDot4\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s431090,\\n\\s+cellReselectionPriority\\s3,\\n\\s+cellReselectionSubPriority\\soDot8\\n\\s+},
    ...   \\n\\s+{\\n\\s+carrierFreq\\s392410,\\n\\s+cellReselectionPriority\\s3\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s516990,\\n\\s+cellReselection
    ...   Priority\\s1,\\n\\s+cellReselectionSubPriority\\soDot2\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s655968,\\n\\s+cellReselectionPriority\\s0,\\n
    ...   \\s+cellReselectionSubPriority\\soDot6\\n\\s+},\\n\\s+{\\n\\s+carrierFreq\\s636576,\\n\\s+cellReselectionPriority\\s0
    ${lte_targets_list}=       Set Variable   ${exp_lte_targets}
    ${nr_targets_list}=       Set Variable   ${exp_nr_targets}
    @{target_nr_lte_freqs}=     Create List    ${lte_targets_list}   ${nr_targets_list}
    FOR   ${freq_list_lte_nr}   IN   @{target_nr_lte_freqs}
        ${nr_lte_arfcn_present}=   Run Keyword And Return Status   Should Match Regexp     ${log_content}      ${freq_list_lte_nr}
        IF   ${nr_lte_arfcn_present} == False    FAIL    Expected Cell Reselection Priorities IE not found in RRC Release message
    END

Move idle or detached UE to another cell
    [Documentation]    This keyword is used to revert the location of the UE as configured in basi setup config file. (If the test case fails before
    ...   this keyword, anyways bring the testline on air after reset, so decided to keep the change location command just after the test).
    [Arguments]   ${ue_id}   ${gnb}   ${cell}
    wts_ue.Send Egate Command and verify output   cmd=ue_change_location id=${ue_id} enb=${gnb} cell=${cell}
    ...    pass_regexp=location updated to eNB-${gnb} cell ${cell}

Update RFSP parameter in Initial Context Setup
    [Documentation]    To update online changeable AMF Initial Context Setup RFSP parameter to send RFSP during context setup
    [Arguments]   ${ue_id}  ${indexToRFSP}
    wts_ue.Send Egate Command and verify output  cmd=amf_ue_ics_param id=1 ue=${ue_id} indexToRFSP=${indexToRFSP}

Verify whether gNB includes Release 16 UL Tx Switching Request in UE Capability Enquiry
    [Documentation]    To verify whether gNB requests UE to send r16 UL Tx Swicthing capability information by including uplinkTxSwitchRequest-r16 as
    ...   true in capabilityRequestFilterCommon of UE Capability Enquiry message.
    wts_ue.send egate command and verify output    set_log flush
    Verify sequence in Egate file  ${VERIFY_EGATE_LOG}  uplinkTxSwitchRequest-r16 true
    BuiltIn.Log    The gNB includes uplinkTxSwitchRequest in capabilityRequestFilterCommon of UE Capability Enquiry message.
