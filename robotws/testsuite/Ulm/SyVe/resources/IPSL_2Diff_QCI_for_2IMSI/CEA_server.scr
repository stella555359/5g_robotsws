IpslVersion 2.0;
Script CEA_Server;
Activated By Message(CER);                       /* |<--- CER         ----| */

#include "_include.h"

BeginScript
  Put(Modify(Pool("CEA", MSG_Universal))         /* |---- CEA         --->| */
          ResultCode := 2001;
          OriginHost := ORIGIN_HOST;
          OriginRealm := ORIGIN_REALM;
          IP4_HostIPAddress := HOST_IP;
          VendorId := 28458;
          ProductName := "NSN Diameter Stack";
          Insert c_P_AuthApplicationId;
          AuthApplicationId := 16777238;
          Insert c_P_SupportedVendorId;
          SupportedVendorId := 10415;
          Insert c_P_SupportedVendorId;
          SupportedVendorId(2) := 12645;
          Insert c_P_SupportedVendorId;
          SupportedVendorId(3) := 4329;
          Insert c_P_SupportedVendorId;
          SupportedVendorId(4) := 9;
          Insert c_P_SupportedVendorId;
          SupportedVendorId(5) := 2011;
          /* Vendor-Specific-Application set automatically */
          Insert c_P_FirmwareRevision;
          FirmwareRevision := 1;

        EndModify);

  Send;

EndScript;
