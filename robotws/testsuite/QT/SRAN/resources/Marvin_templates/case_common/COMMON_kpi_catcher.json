{
    "name": "Invalid negative KPI values",
    "description": "Fail on negative KPI values unless kpi or unit is defined in exclude lists, EDA MNRCA-60316",
    "tags": [],
    "domain": "KPI",
    "algorithm": "negative-kpi-counter-detector",
    "trigger": "test_case_collection_ended",
    "rule": {
      "kpi": {
        "exclude_kpi_id": [
        	"NR_5356b",
        	"NR_5023b",
        	"NR_5032e",
        	"NR_5033b"
        ],
        "exclude_kpi_unit": [
          "dBm",
          "dB",
          "1.0E-1 dBm",
          "1.0E-1 dB",
          "0.001 CQI"
        ]
      }
    }
}
