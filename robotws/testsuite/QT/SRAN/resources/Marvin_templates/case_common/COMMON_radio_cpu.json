{
  "name": "Common radio run CPU analysis",
  "tags": [],
  "domain": "CPU",
  "algorithm": "generic-cpu-and-mem-analyzer",
  "trigger": "radio_cpu_memory_data_available",
  "rule": {
    "radio_cpu_chosen_reference": {
      "exclude_first_x_mins": 30,
      "difference_range": {
        "process": {
          "overflow": {
            "fail": 10,
            "warning": 2.5
          }
        },
        "system": {
          "overflow": {
            "fail": 10,
            "warning": 2.5
          }
        }
      }
    }
  }
}

