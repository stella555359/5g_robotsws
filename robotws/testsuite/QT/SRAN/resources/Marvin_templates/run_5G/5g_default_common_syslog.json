{
  "name": "Default 5G generic syslog filterset",
  "domain": "Syslog",
  "algorithm": "syslog-filter-analyzer",
  "tags": [
    {
      "name": "5G",
      "type": "RAT"
    }
  ],
  "rule": {
    "result_label": "Common",
    "filters": [
      {
        "name": "SET1",
        "description": "Startup - Baseband module detection issues",
        "regex_pattern": "192\\.168\\.255.*(Detector 10 .*BBMOD.* active|BBMOD.*Enter.*to (UnexpectedlyLost|Failed) state|WRN/.*Reporting fault SocFspSubUnitLostUnitLost|CommunicationFailureAl.*BBMOD|Detector (4019|1806).*BBMOD.* active)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET2",
        "description": "Startup - RF module detection issues",
        "regex_pattern": "192\\.168\\.255.*(Detector 10 RU_Startup.*RMOD_R.* active)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET3",
        "description": "Startup - Commissioning (SCF) issues",
        "regex_pattern": "192\\.168\\.255.*(StartupManager.*UNCOMMISSIONED)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET4",
        "description": "Runtime - RF module connection lost",
        "regex_pattern": "192\\.168\\.255.*(Detector 10 RU_Runtime.*RMOD_R.* active)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET6",
        "description": "Runtime - DSP/Application Process/Kernel crashes",
        "regex_pattern": "192\\.168\\.255.*(GPIO reset executed|\\*\\* FATAL |DSP cores crashed|Core declared dead|ERR: DSP crash info|Killed process|core dumped|dumped core|Supervision detected|\\.core\\.xz completed |crash.andler|.ssertion |EAaErrorFatality\\_System|EAaErrorFatality\\_Supervision|EAaErrorFatality\\_Fatal|DspCrash|MAC Assert|L2 ASSERT|MACPS Assert|handleCoreDumpCompleted|Kernel panic|Fatal exception|FATAL ERROR|Core was generated by|Segmentation fault|coreDumping.*crashinfo|lfs\\-coredump.sh in|unhandled exception|handleM.abFatalError|isolateM.ab|M.AB Crash|halt_dsp|DSP HALTED|ERR.*CriticalSwComponentFailureAl)",
        "ignore_regex_pattern": "vlib_node_add_next_with_slot|barrier_no_close_before",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET7",
        "description": "Runtime - Unexpected BTS/BBMOD/Virtual Node reset",
        "regex_pattern": "192\\.168\\.255.*(causing reboot|causes reboot|calling ddal_watchdog_reboot\\(\\)|BTS reset requested|MaxResetLoopCounter|HWA/SUPERVISOR.*(VirtualNode.*state changed to FAILED|failure in virtual node)|Virtual node.*failed unexpectedly|Executing recovery.*eset)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET8",
        "description": "Runtime - DSP/Application Process/Kernel errors",
        "regex_pattern": "192\\.168\\.255.*(ERR.*(CCS|LFS).*(Kernel|CCSRT |AaRTOS|AaError|AaPro|CCSDaemon)| ERR.*\\(pid\\:|CCSRT.*ERR\\:|Exception stack|dump_stack|calltrace|call trace|Call Trace|Tainted|ERR.*Preparing Error Exception Report|kernel NULL pointer|kernel.*Internal error|CriticalError)",
        "ignore_regex_pattern": "failed to register to AaTrbl|Please report to.*kernel.org|PrintDumpReceiv ERR/CCS/AaSysLog.*INF/|ERR.*CCSRT.*Got SIGTERM",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": "!=",
          "limit": 0,
          "verdict": "warning"
        }
      },
      {
        "name": "SET9",
        "description": "Runtime - Memory outage issues",
        "regex_pattern": "192\\.168\\.255.*(Out of memory |invoked oom-killer|No space left|Memory allocation.*failed|Not enough memory|ERR/.*File Quota exceeded.*removing files failed|kernel.*?oom-kill)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET11",
        "description": "Runtime - Radio Link failures (detection)",
        "regex_pattern": "192\\.168\\.255.*(INF/.*(RLF_|rlf\\=))",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "warning"
        }
      },
      {
        "name": "SET12",
        "description": "Runtime - Radio Link failures (call drops)",
        "regex_pattern": "192\\.168\\.255.*(Received.*RadioLinkFailure|WRN.*RadioLinkFailure|Cause to.*is:ECAUSE_RADIOLINKFAILURE)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET14",
        "description": "Runtime - Platform file system issues",
        "regex_pattern": "192\\.168\\.255.*(Failed to mount nfs mount|Unexpected user of FS)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": "!=",
          "limit": 0,
          "verdict": "warning"
        }
      },
      {
        "name": "SET15",
        "description": "Runtime - Event allocation failures",
        "regex_pattern": "192\\.168\\.255.*((failed|Unable).*to allocate event|Event allocation failed)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET16",
        "description": "Runtime - Bearer setup failures",
        "regex_pattern": "192\\.168\\.255.*(WRN/.*Timeout on bearer.*reached|Sending bearer setup failure|BearerContextSetupFailure sent|WRN.*(SRB1 allocation failed|no enough resource to setup drb|BearerContextSetupFailure|Bearer.*leaked for ue)|ERR.*(Bearer Pools are Full|allocate srb failed|Failed to allocate SRB.*resources)|bearer setup.*failed|RABSetup failed due|Received.*BearerErrorInd)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": true,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "warning"
        }
      },
      {
        "name": "SET17",
        "description": "Runtime - Possible Hanging Resources",
        "regex_pattern": "192\\.168\\.255.*(CRNTI mismatch|context already exists|status Nok from Datamanager|ERR\\/.*crnti.*not (match|found)|hanging bearer|ERR\\/.*not found or.*already in use|WRN.*(UE.*not.*(found|in database)|No such.*in UE DB|UE.*already in database)|(ERR/|WRN/).*nknown RNTI|(WRN|warning).*Cannot.*(find ue|remove UE from any cell)|ERR.*(unknownOrAlreadyAllocatedGnbCuUeF1apid)|ECause5G_ObjectAlreadyExists)",
        "ignore_regex_pattern": "measurement report dropped|Band index for own band|Cat\\-M UE not found in Harq buffer",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "warning"
        },
        "criteria2": {
          "operator": ">",
          "limit": 10,
          "verdict": "fail"
        }
      },
      {
        "name": "SET18",
        "description": "Runtime - L1 software crashes / stucks",
        "regex_pattern": "192\\.168\\.255.*(l1_application.*(unhandled exception|EM ERROR|FATAL)|fault in l1_application|L1SW.*(Cannot find srs req|leka_rx stuck detected|is_decoder_pusb_stuck|is_pucch_f2f3_stuck|State_Crashing|Fatal Error|Isolate.*crashed)|(asp|asc..(b|c)|fsp)\\-.*systemd.*(Start operation timed out)|ERR.*(leka_tx|LEKA TX).*stuck|(asp|asc..(b|c)|fsp).*Sending alarm.*2087|(asp|asc..(b|c)|fsp)\\-.*exception handler|(Processing fault|Sending alarm).*2087.*L1|ERR/ctrlTestability.*logIdCrashHandling|handleM.abFatalError|M.AB (C|c)rash)",
        "ignore_regex_pattern": "CrashTestFlag",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET19",
        "description": "Runtime - L1 software issues",
        "regex_pattern": "192\\.168\\.255.*(cpri.*invalid link id|INF/ctrlTestability.*logIdCrashHandling)",
        "ignore_regex_pattern": "configuration is already present|HW trace initialized",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "warning"
        }
      },
      {
        "name": "SET20",
        "description": "Runtime - L1 software call trace",
        "regex_pattern": "192\\.168\\.255.*(((asp|asc..(b|c)).*root|INF/(logger|root)).*( \\#.* in |hread.*\\(LWP))",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "warning"
        }
      },
      {
        "name": "SET21",
        "description": "Runtime - Communication issues between nodes/devices",
        "regex_pattern": "192\\.168\\.255.*(ERR\\/.*SRIO )",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 4,
          "verdict": "warning"
        }
      },
      {
        "name": "SET22",
        "description": "Runtime - SCTP link failures",
        "regex_pattern": "192\\.168\\.255.*(ERR/.*(SctpEventHandler.*Connection broken down|SCTP connection is broken))",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
        }
      },
      {
        "name": "SET23",
        "description": "Runtime - Snapshot collection started",
        "regex_pattern": "192\\.168\\.255.*(\\[SnapshotCollection\\] received ack of snapshot collect|startSnapShot|SNAPSHOT_COLLECT_IND-1 trying to commit)",
        "ignore_regex_pattern": "",
        "ignore_verdict": true,
        "initial_hide": false
      },
      {
        "name": "SET24",
        "description": "Runtime - Snapshot collection finished",
        "regex_pattern": "192\\.168\\.255.*(trying to remove requested object basing on distname.*SNAPSHOT_COLLECT|endSnapShot|Trying to create RESULT under.*SNAPSHOT_COLLECT_IND-1)",
        "ignore_regex_pattern": "",
        "ignore_verdict": true,
        "initial_hide": false
      },
      {
        "name": "SET25",
        "description": "Runtime - Snapshot file download errors",
        "regex_pattern": "192\\.168\\.255.*(DownloadFileTask.*failed with message)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
        "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "warning"
        }
      },
      {
        "name": "SET26",
        "description": "Runtime - Site recommissioning requested",
        "regex_pattern": "192\\.168\\.255.*(scenario.*Recommissioning|MplanePlanActivator.*Activation.*scf)",
        "ignore_regex_pattern": "",
        "ignore_verdict": true,
        "initial_hide": false
      },
      {
        "name": "SET27",
        "description": "Runtime - Site reset requested",
        "regex_pattern": "192\\.168\\.255.*(received ENTITY_RESET_REQ.*reason|Restart.*performSiteRestart)",
        "ignore_regex_pattern": "",
        "ignore_verdict": true,
        "initial_hide": false
      },
      {
        "name": "SET28",
        "description": "Runtime - Faults and alarms",
        "regex_pattern": "192\\.168\\.255.*(handle_LomFaultReq faultId =|FRI.*Detector.* active)",
        "ignore_regex_pattern": "becomes|Check case",
        "ignore_verdict": true,
        "initial_hide": true
      },
	    {
        "name": "SET29",
        "description": "Runtime - Antenna calibration failures",
        "regex_pattern": "192\\.168\\.255.*(totalPipeNumber|brokenPipeNumber)",
        "ignore_regex_pattern": "",
        "ignore_verdict": false,
        "initial_hide": false,
		    "criteria": {
          "operator": ">",
          "limit": 0,
          "verdict": "fail"
		    }
      }
    ]
  }
}
