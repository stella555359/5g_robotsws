*** Test Cases ***

CB00xxxx_FHGW
    [Tags]    CRT    FHGW    demo
    [Timeout]    30 minutes
    [Documentation]
    ...    Author: yuyan.xu@nokia-sbell.com
    ...    history change: <date>,<who>,<what and how>
    ...    8.25.2022,yuyan.xu@nokia-sbell.com, draft
    [Setup]    Case Precondition    ReIntegrate_FHGW=True
    ${delta_plan_path_FHGW_template}    Set Variable    ${plan_path}/FHGW_Provision_Template.xml
    ${delta_plan_name_FHGW}          Set Variable    FHGW-${FHGW_id}-delta-plan
    ${integrated_ids_FHGW}    Create List    FHGW-${FHGW_id}

    #CM Upload
    CM Parameter Upload NOM Open API    ${integrated_ids_FHGW}

    #FHGW Provision
    ${timestamp}    Generate Formatted Timestamp
    Set Test Variable    ${delta_plan_path_FHGW}    ${TEST_LOG_DIRECTORY}/${delta_plan_name_FHGW}_${timestamp}.xml
    ${PARAM_VALUE}    Set Variable    fhgw_11085
    ${file_content}    Get File    ${delta_plan_path_FHGW_template}
    ${file_content}    Replace Variables    ${file_content}
    Create File    ${delta_plan_path_FHGW}    ${file_content}
    CM Plan Import NOM Open API    ${delta_plan_path_FHGW}    ${delta_plan_name_FHGW}_${timestamp}
    CM Plan Provision NOM Open API    ${delta_plan_name_FHGW}_${timestamp}
    Wait Until Keyword Succeeds    10x    10s    Check CM Parameter Value From NOM Actual Plan
    ...    ${integrated_ids_FHGW}    FHGW-11085    fhgwName=fhgw_11085

    [Teardown]    Case Postcondition


