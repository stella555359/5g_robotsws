configure create pcf-profile 1
configure pcf-profile 1 generate-ref true
configure pcf-profile 1 create-res 201
configure pcf-profile 1 release-res 204
configure pcf-profile 1 update-res 200
configure pcf-profile 1 match-imsi 262030000000000 262039999999999
configure create node pcf 1
configure node pcf 1 server-service 10.56.218.70:8080
configure node pcf 1 client-addr 10.56.218.70
configure node pcf 1 add-profile 1
proc node pcf 1 start-service
proc node pcf 1 start-client
configure create custom-data 33 
configure custom-data 33 json add-object "/smPolicyDecision" 
configure custom-data 33 json add-object "/smPolicyDecision/qosDecs" 
configure custom-data 33 json add-object "/smPolicyDecision/qosDecs/qosIdForDefault1" 
configure custom-data 33 json add-string "/smPolicyDecision/qosDecs/qosIdForDefault1/qosId" qosIdForDefault1 
configure custom-data 33 json add-number "/smPolicyDecision/qosDecs/qosIdForDefault1/5qi" 9 
configure custom-data 33 json add-object "/smPolicyDecision/qosDecs/qosIdForDefault1/arp" 
configure custom-data 33 json add-number "/smPolicyDecision/qosDecs/qosIdForDefault1/arp/priorityLevel" 9 
configure custom-data 33 json add-string "/smPolicyDecision/qosDecs/qosIdForDefault1/maxbrUl" "10 Mbps" 
configure custom-data 33 json add-string "/smPolicyDecision/qosDecs/qosIdForDefault1/maxbrDl" "10 Mbps" 
configure custom-data 33 json add-bool "/smPolicyDecision/qosDecs/qosIdForDefault1/qnc" "false"  
configure custom-data 33 json add-object "/smPolicyDecision/traffContDecs" 
configure custom-data 33 json add-object "/smPolicyDecision/traffContDecs/tcIdForDefault1" 
configure custom-data 33 json add-string "/smPolicyDecision/traffContDecs/tcIdForDefault1/tcId" tcIdForDefault1 
configure custom-data 33 json add-string "/smPolicyDecision/traffContDecs/tcIdForDefault1/flowStatus" ENABLED
configure custom-data 33 json add-object "/smPolicyDecision/pccRules" 
configure custom-data 33 json add-object "/smPolicyDecision/pccRules/5QI9" 
configure custom-data 33 json add-string "/smPolicyDecision/pccRules/5QI9/pccRuleId" 5QI9 
configure custom-data 33 json add-array "/smPolicyDecision/pccRules/5QI9/flowInfos" 
configure custom-data 33 json add-object "/smPolicyDecision/pccRules/5QI9/flowInfos/0" 
configure custom-data 33 json add-string "/smPolicyDecision/pccRules/5QI9/flowInfos/0/flowDescription" "permit out 17 from 10.56.221.13 to any" 
configure custom-data 33 json add-string "/smPolicyDecision/pccRules/5QI9/flowInfos/0/flowDescription" "permit in 17 from any to 10.56.221.13" 
configure custom-data 33 json add-string "/smPolicyDecision/pccRules/5QI9/flowInfos/0/flowDirection" BIDIRECTIONAL
configure custom-data 33 json add-number "/smPolicyDecision/pccRules/5QI9/precedence" 10 
configure custom-data 33 json add-array "/smPolicyDecision/pccRules/5QI9/refQosData" 
configure custom-data 33 json add-string "/smPolicyDecision/pccRules/5QI9/refQosData/-" qosIdForDefault1 
configure custom-data 33 json add-array "/smPolicyDecision/pccRules/5QI9/refTcData" 
configure custom-data 33 json add-string "/smPolicyDecision/pccRules/5QI9/refTcData/-" tcIdForDefault1 
configure custom-data 33 json add-array "/smPolicyDecision/lastReqRuleData" 
configure custom-data 33 json add-object "/smPolicyDecision/lastReqRuleData/0" 
configure custom-data 33 json add-array "/smPolicyDecision/lastReqRuleData/0/refPccRuleIds" 
configure custom-data 33 json add-string "/smPolicyDecision/lastReqRuleData/0/refPccRuleIds/-" 5QI9 
configure custom-data 33 json add-array "/smPolicyDecision/policyCtrlReqTriggers" 
configure custom-data 33 json add-string "/smPolicyDecision/policyCtrlReqTriggers/-" PRA_CH
configure custom-data 33 json add-string "/smPolicyDecision/policyCtrlReqTriggers/-" SCNN_CH
configure custom-data 33 json add-string "/smPolicyDecision/policyCtrlReqTriggers/-" AN_CH_COR
configure custom-data 33 json add-string "/smPolicyDecision/policyCtrlReqTriggers/-" UE_IP_CH
configure custom-data 33 json add-string "/smPolicyDecision/policyCtrlReqTriggers/-" DEF_QOS_CH
configure custom-data 33 json add-string "/smPolicyDecision/policyCtrlReqTriggers/-" AC_TY_CH
configure custom-data 33 json add-string "/smPolicyDecision/policyCtrlReqTriggers/-" SE_AMBR_CH
configure custom-data 33 json add-string "/smPolicyDecision/policyCtrlReqTriggers/-" QOS_NOTIF
configure pcf-profile 1 policy-notification-data 33
proc node pcf 1 policy-update-notify all   
exit