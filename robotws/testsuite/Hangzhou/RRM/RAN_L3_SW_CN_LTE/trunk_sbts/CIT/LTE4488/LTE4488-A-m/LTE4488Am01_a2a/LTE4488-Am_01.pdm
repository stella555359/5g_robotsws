[CP2]
#selectedBandCombination 1:1
ethernet.ip.sctp.x2ap
	ethernet.ip.destination = 10.0.1.2
	ethernet.ip.source = 10.0.1.11
	ethernet.ip.sctp.x2ap.value = SgNBAdditionRequestAcknowledge
