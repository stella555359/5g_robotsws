Set ue parameters before attach
    [Arguments]    ${ue_id}=1
    execute egate command    gnb_endc_param id=7 use_nr_ran_cont=true scg_dl_dist_percent=0 include_reestablish_pdcp=on
    execute uex command    ue_param id=${ue_id} dual_conn=eutra_nr pdcp_sn_extension=18bit
    execute uex command    ue_param id=${ue_id} nr_supported_bands=78
    execute uex command    ue_cqi_param id=${ue_id} scell=0-3 rank=4 cell=both
    execute egate command    gnb_endc_param id=8 use_nr_ran_cont=true scg_dl_dist_percent=0 include_reestablish_pdcp=on
    execute egate command    enb_param id=2 endc_capable_qci=6,8
    execute egate command    enb_x2_link_up enb=2 target=7    is up
    execute egate command    enb_x2_link_up enb=3 target=7    is up

UE Attach To ENB1
    [Arguments]    ${ue_eutra_nr_capabilities}    ${ue_eutra_capabilities}=${empty}    ${ue_id}=1
    ${V_3}  catenate  ue_attach id=${ue_id} ue_nr_capabilities=${ue_nr_capabilities} \ ue_eutra_nr_capabilities=${ue_eutra_nr_capabilities} \
    ...  ue_eutra_capabilities=${ue_eutra_capabilities} cell=1
    execute uex command    ${V_3}

Trigger Dynamic ENDC
    [Arguments]    ${ue_id}=1    ${X:Y}=disable
    expect message flow
    ...    ENB_1:X2AP_SgNBAdditionRequest(${sgnbaddition1})
    ...    GNB_7:X2AP_SgNBAdditionRequestAcknowledge(${selectedBandCombination1})
    ...    alias=sgaddition_flow    overall_timeout=60
    execute egate command    gnb_endc_param id=7 selected_band_combination_nr=${X:Y}
    execute uex command  ue_measurement_send id=${ue_id} meas_id_blacklist=18 event=B1_NR phycell_id=1 nrsrp=60
    flow occurred as expected    alias=sgaddition_flow

Trigger InterENB HO For ENB1 To ENB2
    [Arguments]    ${ue_id}=1
    expect message flow
    ...    ENB_1:X2AP_HandoverRequest
    ...    alias=ho_flow    overall_timeout=600
    execute uex command    ue_ho id=${ue_id} enb=2 cell=21
    flow occurred as expected    alias=ho_flow

