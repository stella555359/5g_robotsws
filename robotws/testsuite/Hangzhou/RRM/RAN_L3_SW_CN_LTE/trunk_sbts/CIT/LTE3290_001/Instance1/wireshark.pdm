[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#HO TO UTRAN
ethernet.ip.sctp.s1ap
  ethernet.ip.source=${BTS_INFO.IP}
  ethernet.ip.destination=${MME1_INFO.IP}
  ethernet.ip.sctp.s1ap.s1ap_pdu=0
# procedureCode: id-HandoverPreparation (0)
  ethernet.ip.sctp.s1ap.procedure_code=0
#	HandoverType: ltetoutran (1)
  ethernet.ip.sctp.s1ap.id-HandoverType.ProtocolIE-Field.value.HandoverType = 1
# radioNetwork: time-critical-handover (17)
  ethernet.ip.sctp.s1ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 17
# SRVCCHOIndication: pSandCS (0)
  ethernet.ip.sctp.s1ap.id-SRVCCHOIndication.ProtocolIE-Field.value.SRVCCHOIndication = 0

ethernet.ip.sctp.s1ap
  ethernet.ip.source=${MME1_INFO.IP}
  ethernet.ip.destination=${BTS_INFO.IP}
  ethernet.ip.sctp.s1ap.s1ap_pdu=1
# procedureCode: id-HandoverPreparation (0)
  ethernet.ip.sctp.s1ap.procedure_code=0
  ethernet.ip.sctp.s1ap.value = HandoverCommand
#	HandoverType: ltetoutran (1)
  ethernet.ip.sctp.s1ap.id-HandoverType.ProtocolIE-Field.value.HandoverType = 1
  
ethernet.ip.sctp.s1ap
  ethernet.ip.source=${MME1_INFO.IP}
  ethernet.ip.destination=${BTS_INFO.IP}
  ethernet.ip.sctp.s1ap.s1ap_pdu=0
# procedureCode: id-UEContextRelease (23)
  ethernet.ip.sctp.s1ap.procedure_code=23
#	radioNetwork: successful-handover (2) in UEContextReleaseCommand
  ethernet.ip.sctp.s1ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 2
  
