[Global]



RELATION: CP1

BLOCKSIZE: -1

[CP1]
#####################################################

#intialContextSetupRequest contains MDT allowed flag and UE1 was select to do interMDT session

####################################################
ethernet.ip.sctp.s1ap
	ethernet.ip.sctp.s1ap.value = InitialContextSetupRequest
	#ManagementBasedMDTallowed: allowed (0)
	ethernet.ip.sctp.s1ap.id-ManagementBasedMDTAllowed.ProtocolIE-Field.value.ManagementBasedMDTAllowed = 0
ethernet.ip.tcp.nsnti
	ethernet.ip.tcp.nsnti.MsgData.TraceReportData.TraceMessage.TraceRecSessionID = 0000
    #ethernet.ip.tcp.nsnti.MsgData.TraceReportData.TraceMessage.TraceData.LTE Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.c1.measurementReport-r8.measResults.measId = 14
    ethernet.ip.tcp.nsnti.MsgData.TraceReportData.TraceMessage.TraceData.LTE Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcConnectionReconfiguration.criticalExtensions.c1.rrcConnectionReconfiguration-r8.measConfig.measIdToAddModList.Item 4.MeasIdToAddMod.measId = 14

#####################################################

#UE2 was do cell trace session

####################################################
ethernet.ip.tcp.nsnti
	ethernet.ip.tcp.nsnti.MsgData.TraceReportData.TraceMessage.TraceRecSessionID = 0001

#####################################################

#intialContextSetupRequest contains MDT allowed flag and UE3 was select to do intraMDT session

####################################################
ethernet.ip.sctp.s1ap
	ethernet.ip.sctp.s1ap.value = InitialContextSetupRequest
	#ManagementBasedMDTallowed: allowed (0)
	ethernet.ip.sctp.s1ap.id-ManagementBasedMDTAllowed.ProtocolIE-Field.value.ManagementBasedMDTAllowed = 0
ethernet.ip.tcp.nsnti
	ethernet.ip.tcp.nsnti.MsgData.TraceReportData.TraceMessage.TraceRecSessionID = 0002
	#ethernet.ip.tcp.nsnti.MsgData.TraceReportData.TraceMessage.TraceData.LTE Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.c1.measurementReport-r8.measResults.measId = 9
	ethernet.ip.tcp.nsnti.MsgData.TraceReportData.TraceMessage.TraceData.LTE Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcConnectionReconfiguration.criticalExtensions.c1.rrcConnectionReconfiguration-r8.measConfig.measIdToAddModList.Item 4.MeasIdToAddMod.measId = 9

#####################################################

#intialContextSetupRequest contains MDT allowed flag and UE4 not select to do intraMDT session cause not support GNSS

####################################################
ethernet.ip.sctp.s1ap
	ethernet.ip.sctp.s1ap.value = InitialContextSetupRequest
	#ManagementBasedMDTallowed: allowed (0)
	ethernet.ip.sctp.s1ap.id-ManagementBasedMDTAllowed.ProtocolIE-Field.value.ManagementBasedMDTAllowed = 0
ethernet.ip.tcp.nsnti
	ethernet.ip.tcp.nsnti.MsgData.TraceReportData.TraceMessage.TraceRecSessionID = 0003

#####################################################

#intialContextSetupRequest contains MDT allowed flag and UE5 was select to do interMDT session

####################################################
ethernet.ip.sctp.s1ap
	ethernet.ip.sctp.s1ap.value = InitialContextSetupRequest
	#ManagementBasedMDTallowed: allowed (0)
	ethernet.ip.sctp.s1ap.id-ManagementBasedMDTAllowed.ProtocolIE-Field.value.ManagementBasedMDTAllowed = 0
ethernet.ip.tcp.nsnti
	ethernet.ip.tcp.nsnti.MsgData.TraceReportData.TraceMessage.TraceRecSessionID = 0004
	#ethernet.ip.tcp.nsnti.MsgData.TraceReportData.TraceMessage.TraceData.LTE Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.c1.measurementReport-r8.measResults.measId = 9
