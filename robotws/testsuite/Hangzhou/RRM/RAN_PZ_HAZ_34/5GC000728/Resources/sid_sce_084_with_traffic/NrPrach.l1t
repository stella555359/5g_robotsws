<?xml version="1.1"?>
<!DOCTYPE format PUBLIC "-//prisma//DTD Format 2.0//EN" "http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/dtd/xmlFormat-2.dtd">
<?xml-stylesheet type="text/xsl" href="http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/xsl/htmlFormat.xsl"?>

<format name="NrPrach" show="NR PRACH Test" version="1.0">
    <group name="NrPrach" show="NR NPRACH Test" priority="250">
        <integer name="Version" show="Version" writable="false" default="5" cformat="uint32"> </integer>
        <integer name="TestType" show="Test Type" writable="false" default="256" cformat="uint32"> </integer>
        <enum name="startSymbolIndex" show="startSymbolIndex" cformat="uint32">
            <option value="0">s0</option>
            <option value="2">s2</option>
        </enum>
        <enum name="preambleFormat" show="preambleFormat" cformat="uint32">
            <option value="0">fA2</option>
            <option value="1">fB2</option>
            <option value="2">fB4</option>
            <option value="3">fA3</option>
        </enum>
        <integer name="prach-FreqOccasion" show="prach-FreqOccasion" writable="true" default="0" min="0" max="23" step="0" cformat="uint32"> 
        PRACH frequency domain occasion index (see 3GPP 38.211 v15.1.0)
        </integer>
        <integer name="pInd" show="pInd" writable="true" default="1" min="0" max="56" step="0" cformat="uint32"> 
        Preamble index
        </integer>
        <integer name="Attenuation" show="Attenuation" writable="true" default="0" min="0" max="30" step="0" cformat="uint32"> 
        Attenuation value in dB (0 dB .. 30 dB)
        </integer>
    </group>
</format>
