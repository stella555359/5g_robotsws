<?xml version="1.1"?>
<!DOCTYPE format PUBLIC "-//prisma//DTD Format 2.0//EN" "http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/dtd/xmlFormat-2.dtd">
<?xml-stylesheet type="text/xsl" href="http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/xsl/htmlFormat.xsl"?>

<format name="NrPdcch" show="NR PDCCH Test" version="1.0">
  <group name="NrPdcch" show="NR PDCCH Test" priority="250">

    <integer name="Version" show="Version" writable="false" default="4" min="1" max="2147483647" step="0" cformat="uint32">
        Test version
    </integer>

    <integer name="testType" show="Test Type" writable="false" default="3" min="1" max="2147483647" step="0" cformat="uint32">
        Test type
    </integer>

    <integer name="cellId" show="PDCCH-DMRS-Sequence-Id" writable="false" default="0" min="0" max="1007" step="0" cformat="uint32"> 
        Cell id or virtual cell id used to initialize DMRS sequence
    </integer>

    <integer name="rnti" show="RNTI" writable="true" default="200" min="1" max="65535" step="0" cformat="uint32">
        Configured RNTI 
    </integer>

    <integer name="numCoreset" show="Number of CORESET per UE" writable="false" default="1" min="1" max="1" step="0" cformat="uint32">
        Only one coreset supported
    </integer>

    <integer name="numSymbols" show="Number of consecutive symbols" writable="false" default="1" min="1" max="1" step="0" cformat="uint32">
        Only one symbol supported
    </integer>

    <integer name="firstSymbol" show="Starting symbol" writable="true" default="0" min="0" max="0" step="0" cformat="uint32">
        Only symbol 0 supported
    </integer>
    
    <integer name="coresetIndex" show="CORESET Index p" writable="true" default="0" min="0" max="3" step="0" cformat="uint32">
        Control resource set index 'p'
    </integer>    
    
    <integer name="dciLen1" show="DCI min length" writable="true" default="36" min="16" max="96" step="0" cformat="uint32">
        DCI minimum size (in bits, without CRC) 
    </integer>
    
    <integer name="dciLen2" show="DCI max length" writable="true" default="56" min="32" max="192" step="0" cformat="uint32">
        DCI maximum size (in bits, without CRC) 
    </integer>
    

    <bitfield name="rbBitmap1" show="RB bitmap for Common Space" format="%016x" bits="45" default="000000000000ffff" writable="true" exportable="false" null="false" index="false" cformat="uint64">
        Common Space CORESET Resource block bitmap CORESET-freq-dom, a string of bit with length equal to floor(N_RB/6), where N_RB is the number of Resource Blocks in DL resource grid
        <bit index="44" show="RBs 264-269"/>
        <bit index="43" show="RBs 258-263"/>
        <bit index="42" show="RBs 252-257"/>
        <bit index="41" show="RBs 246-251"/>
        <bit index="40" show="RBs 240-245"/>
        <bit index="39" show="RBs 234-239"/>
        <bit index="38" show="RBs 228-233"/>
        <bit index="37" show="RBs 222-227"/>
        <bit index="36" show="RBs 216-221"/>
        <bit index="35" show="RBs 210-215"/>
        <bit index="34" show="RBs 204-209"/>
        <bit index="33" show="RBs 198-203"/>
        <bit index="32" show="RBs 192-197"/>
        <bit index="31" show="RBs 186-191"/>
        <bit index="30" show="RBs 180-185"/>
        <bit index="29" show="RBs 174-179"/>
        <bit index="28" show="RBs 168-173"/>
        <bit index="27" show="RBs 162-167"/>
        <bit index="26" show="RBs 156-161"/>
        <bit index="25" show="RBs 150-155"/>
        <bit index="24" show="RBs 133-149"/>
        <bit index="23" show="RBs 138-143"/>
        <bit index="22" show="RBs 132-137"/>
        <bit index="21" show="RBs 126-131"/>
        <bit index="20" show="RBs 120-125"/>
        <bit index="19" show="RBs 114-119"/>
        <bit index="18" show="RBs 108-113"/>
        <bit index="17" show="RBs 102-107"/>
        <bit index="16" show="RBs 96-101"/>
        <bit index="15" show="RBs 90-95"/>
        <bit index="14" show="RBs 84-89"/>
        <bit index="13" show="RBs 78-83"/>
        <bit index="12" show="RBs 72-77"/>
        <bit index="11" show="RBs 66-71"/>
        <bit index="10" show="RBs 60-65"/>
        <bit index="9" show="RBs 54-59"/>
        <bit index="8" show="RBs 48-53"/>
        <bit index="7" show="RBs 42-47"/>
        <bit index="6" show="RBs 36-41"/>
        <bit index="5" show="RBs 30-35"/>
        <bit index="4" show="RBs 24-29"/>
        <bit index="3" show="RBs 18-23"/>
        <bit index="2" show="RBs 12-17"/>
        <bit index="1" show="RBs 6-11"/>
        <bit index="0" show="RBs 0-5"/>
    </bitfield>
    
    <bitfield name="rbBitmap2" show="RB bitmap for UeSpecific" format="%016x" bits="45" default="000000000000ffff" writable="true" exportable="false" null="false" index="false" cformat="uint64">
        Ue Specific CORESET Resource block bitmap CORESET-freq-dom, a string of bit with length equal to floor(N_RB/6), where N_RB is the number of Resource Blocks in DL resource grid
        <bit index="44" show="RBs 264-269"/>
        <bit index="43" show="RBs 258-263"/>
        <bit index="42" show="RBs 252-257"/>
        <bit index="41" show="RBs 246-251"/>
        <bit index="40" show="RBs 240-245"/>
        <bit index="39" show="RBs 234-239"/>
        <bit index="38" show="RBs 228-233"/>
        <bit index="37" show="RBs 222-227"/>
        <bit index="36" show="RBs 216-221"/>
        <bit index="35" show="RBs 210-215"/>
        <bit index="34" show="RBs 204-209"/>
        <bit index="33" show="RBs 198-203"/>
        <bit index="32" show="RBs 192-197"/>
        <bit index="31" show="RBs 186-191"/>
        <bit index="30" show="RBs 180-185"/>
        <bit index="29" show="RBs 174-179"/>
        <bit index="28" show="RBs 168-173"/>
        <bit index="27" show="RBs 162-167"/>
        <bit index="26" show="RBs 156-161"/>
        <bit index="25" show="RBs 150-155"/>
        <bit index="24" show="RBs 133-149"/>
        <bit index="23" show="RBs 138-143"/>
        <bit index="22" show="RBs 132-137"/>
        <bit index="21" show="RBs 126-131"/>
        <bit index="20" show="RBs 120-125"/>
        <bit index="19" show="RBs 114-119"/>
        <bit index="18" show="RBs 108-113"/>
        <bit index="17" show="RBs 102-107"/>
        <bit index="16" show="RBs 96-101"/>
        <bit index="15" show="RBs 90-95"/>
        <bit index="14" show="RBs 84-89"/>
        <bit index="13" show="RBs 78-83"/>
        <bit index="12" show="RBs 72-77"/>
        <bit index="11" show="RBs 66-71"/>
        <bit index="10" show="RBs 60-65"/>
        <bit index="9" show="RBs 54-59"/>
        <bit index="8" show="RBs 48-53"/>
        <bit index="7" show="RBs 42-47"/>
        <bit index="6" show="RBs 36-41"/>
        <bit index="5" show="RBs 30-35"/>
        <bit index="4" show="RBs 24-29"/>
        <bit index="3" show="RBs 18-23"/>
        <bit index="2" show="RBs 12-17"/>
        <bit index="1" show="RBs 6-11"/>
        <bit index="0" show="RBs 0-5"/>
    </bitfield>    

    <enum name="dumpSubf" show="Subframe Number (dump)" cformat="uint32">
        <option value="0">0</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
        <option value="6">6</option>
        <option value="7">7</option>
        <option value="8">8</option>
        <option value="9">9</option>
    </enum>           
    <enum name="dumpSlot" show="Slot Number (dump)" default="1" cformat="uint32">
        <option value="0">0</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
        <option value="6">6</option>
        <option value="7">7</option>
    </enum>           
    <enum name="DecRepeat" show="Number of decoded PDCCH" default="2" cformat="uint32">
        <option value="0">One</option>
        <option value="1">Two</option>
        <option value="2">Continuous Loop</option>
    </enum>     
    <enum name="Verbosity" show="PDCCH high verbosity" cformat="uint32">
        <option value="0">OFF</option>
        <option value="1">ON</option>
    </enum> 
   </group>
  
</format>
