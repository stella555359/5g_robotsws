EndIf;


If RequestType = 2 Then
/* Diameter server responds with a CCA Update4 message to the GGSN */

  Put(Modify(Pool("CCA", MSG_Universal))         /* |---- CCA         --->| */
          SessionId := Sid;
          OriginHost := "ipsl-gx";
          OriginRealm := "nsn.com";
          AuthApplicationId := 16777238;

          Insert c_P_BearerControlMode;
          BearerControlMode := 2;

          CCRequestNumber := RequestNumber;
          CCRequestType := 2;

          Insert c_P_DefaultEPSBearerQoS;
          Insert DefaultEPSBearerQoS.c_P_AllocationRetentionPriority;
          PriorityLevel(1) := 2;
          Insert DefaultEPSBearerQoS.c_P_QoSClassIdentifier;
          QoSClassIdentifier(1) := 9;

          Insert c_P_EventTrigger;
          EventTrigger(1) := 1;
          Insert c_P_EventTrigger;
          EventTrigger(2) := 2;
          Insert c_P_EventTrigger;
          EventTrigger(3) := 4;
          Insert c_P_EventTrigger;
          EventTrigger(4) := 5;
          Insert c_P_EventTrigger;
          EventTrigger(5) := 6;
          Insert c_P_EventTrigger;
          EventTrigger(6) := 7;
          Insert c_P_EventTrigger;
          EventTrigger(7) := 8;
          Insert c_P_EventTrigger;
          EventTrigger(8) := 9;
          Insert c_P_EventTrigger;
          EventTrigger(9) := 10;
          Insert c_P_EventTrigger;
          EventTrigger(10) := 12;
          Insert c_P_EventTrigger;
          EventTrigger(11) := 13;
          Insert c_P_EventTrigger;
          EventTrigger(12) := 15;
          Insert c_P_EventTrigger;
          EventTrigger(13) := 16;
          Insert c_P_EventTrigger;
          EventTrigger(14) := 20;
          Insert c_P_EventTrigger;
          EventTrigger(15) := 26;

          Insert c_P_ResultCode;
          ResultCode := 2001;

  EndModify);
  Send;

EndIf;

If RequestType = 3 Then

  Put(Modify(Pool("CCA", MSG_Universal))         /* |---- CCA         --->| */
          SessionId := Sid;
          OriginHost := "ipsl-gx";
          OriginRealm := "nsn.com";
          AuthApplicationId := 16777238;
          CCRequestNumber := RequestNumber;
          CCRequestType := 3;

          Insert c_P_OriginStateId;
          OriginStateId := 11;

          Insert c_P_ResultCode;
          ResultCode := 2001;

  EndModify);
  Send;
EndIf;

EndScript;
