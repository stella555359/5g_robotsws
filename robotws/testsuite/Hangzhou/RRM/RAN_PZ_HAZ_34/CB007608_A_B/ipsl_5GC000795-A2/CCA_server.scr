
/* Generated with DIA03 for creating dedicated bearer*/


IpslVersion 2.0;

Script CCA_server;

Activated By Message(CCR);                       /* |<--- CCR         ----| */

Var

  RequestType              : Integer;
  RequestNumber            : Integer;
  Sid                      : String;
  OHost                    : String;
  ORealm                   : String;
  Supported_Features_InHex : String;
BeginScript

RequestType   := GetPar(CCRequestType);
RequestNumber := GetPar(CCRequestNumber);
Sid           := GetPar(SessionId);
OHost         := GetPar(OriginHost);
ORealm        :=GetPar(OriginRealm);
Supported_Features_InHex:="\x00\x00\x01\x0a\x40\x00\x00\x0c\x00\x00\x28\xaf\x00\x00\x02\x75\x80\x00\x00\x10\x00\x00\x28\xaf\x00\x00\x00\x01\x00\x00\x02\x76\x80\x00\x00\x10\x00\x00\x28\xaf\x00\x00\x00\x4b";

If RequestType = 1 Then
/* Diameter server responds with a CCA Initial message to the GGSN */

  Put(Modify(Pool("CCA", MSG_Universal))         /* |---- CCA         --->| */
          SessionId := Sid;
          OriginHost := "ipsl-gx";
          OriginRealm := "nsn.com";
          AuthApplicationId := 16777238;

          Insert c_P_BearerControlMode;
          BearerControlMode := 2;

          CCRequestNumber := 0;
          CCRequestType := 1;

          Insert c_P_SupportedFeatures;
          SupportedFeatures := Supported_Features_InHex;







/*          Insert c_P_EventTrigger;
          EventTrigger(1) := 1;
          Insert c_P_EventTrigger;
          EventTrigger(2) := 2;
          Insert c_P_EventTrigger;
          EventTrigger(3) := 4;
          Insert c_P_EventTrigger;
          EventTrigger(4) := 5;
          Insert c_P_EventTrigger;
          EventTrigger(5) := 6;
          Insert c_P_EventTrigger;
          EventTrigger(6) := 7;
          Insert c_P_EventTrigger;
          EventTrigger(7) := 8;
          Insert c_P_EventTrigger;
          EventTrigger(8) := 9;
          Insert c_P_EventTrigger;
          EventTrigger(9) := 10;
          Insert c_P_EventTrigger;
          EventTrigger(10) := 12;
          Insert c_P_EventTrigger;
          EventTrigger(11) := 13;
          Insert c_P_EventTrigger;
          EventTrigger(12) := 15;
          Insert c_P_EventTrigger;
          EventTrigger(13) := 16;
          Insert c_P_EventTrigger;
          EventTrigger(14) := 20;
          Insert c_P_EventTrigger;
          EventTrigger(15) := 26;
          0000027480000038000028af0000010a4000000c000028af0000027580000010000028af000000010000027680000010000028af0000000b;
  */
          Insert c_P_Online;
          Online := 0;
          Insert c_P_OriginStateId;
          OriginStateId := 11;

          Insert c_P_ResultCode;
          ResultCode := 2001;

  EndModify);
  Send;




 //add
  StartTimer(timer, 500);
  WaitFor Timer(timer);

  Put(Modify(Pool("RAR", MSG_Universal))         /* |---- RAR         --->| */
          SessionId := Sid;
          OriginHost := "ipsl-gx";
          OriginRealm := "nsn.com";
          DestinationHost := OHost;
          DestinationRealm := ORealm;
          AuthApplicationId := 16777238;

          Insert c_P_OriginStateId;
          OriginStateId := 11;

          Insert c_P_ChargingRuleInstall;

          Insert ChargingRuleInstall.c_P_ChargingRuleDefinition;
          ChargingRuleName := "\x32";

          Insert ChargingRuleDefinition.c_P_FlowInformation;

          Insert FlowInformation.c_P_FlowDescription;
          FlowDescription := "permit in 17 from assigned 1-65535 to any 50006";
//          FlowDescription := "permit in 17 from 10.0.0.0/8 1-65535 to 10.56.111.0/24 50006";
//          FlowDescription := "permit in ip from assigned to 10.69.80.79";
          Insert ChargingRuleDefinition.c_P_FlowInformation;
          Insert FlowInformation(2).c_P_FlowDescription;
          FlowDescription(2) := "permit out 17 from any 1-65535 to assigned 50006";
//          FlowDescription(2) := "permit out 17 from 10.56.111.0/24 5006 to 10.0.0.0/8 1-65535";
//          FlowDescription(2) := "permit out ip from 10.69.80.79 to assigned";

          Insert ChargingRuleDefinition.c_P_Precedence;
          Precedence := 4;

          Insert ChargingRuleDefinition.c_P_RatingGroup;
          RatingGroup := 50;
          Insert ChargingRuleDefinition.c_P_FlowStatus;
          FlowStatus := 2 /* 2 = ENABLED */;
          Insert ChargingRuleDefinition.c_P_ReportingLevel;
          ReportingLevel := 1 /* 1 = RATING_GROUP_LEVEL */;


          Insert ChargingRuleDefinition.c_P_QoSInformation;
          //Insert QoSInformation.c_P_GuaranteedBitrateUL;
          //GuaranteedBitrateUL := 64000;
          //Insert QoSInformation.c_P_GuaranteedBitrateDL;
          //GuaranteedBitrateDL := 64000;
          Insert QoSInformation.c_P_MaxRequestedBandwidthUL;
          MaxRequestedBandwidthUL := 4096000;
          Insert QoSInformation.c_P_MaxRequestedBandwidthDL;
          MaxRequestedBandwidthDL := 4096000;
          Insert QoSInformation.c_P_AllocationRetentionPriority;
          PriorityLevel := 1;
          Insert QoSInformation.c_P_QoSClassIdentifier;
          QoSClassIdentifier := 6;

          ReAuthRequestType := 0;
      EndModify);
  Send;
  WaitFor Message(RAA);                          /* |<--- RAA         ----| */



  StartTimer(timer, 500);
  WaitFor Timer(timer);

  Put(Modify(Pool("RAR", MSG_Universal))         /* |---- RAR         --->| */
          SessionId := Sid;
          OriginHost := "ipsl-gx";
          OriginRealm := "nsn.com";
          DestinationHost := OHost;
          DestinationRealm := ORealm;
          AuthApplicationId := 16777238;

          Insert c_P_OriginStateId;
          OriginStateId := 11;

          Insert c_P_ChargingRuleInstall;

          Insert ChargingRuleInstall.c_P_ChargingRuleDefinition;
          ChargingRuleName := "\x33";

          Insert ChargingRuleDefinition.c_P_FlowInformation;

          Insert FlowInformation.c_P_FlowDescription;
//          FlowDescription := "permit in ip from assigned to 10.69.80.79";
//          FlowDescription := "permit in 17 from 10.0.0.0/8 1-65535 to 10.56.111.0/24 5008";
          FlowDescription := "permit in 17 from assigned 1-65535 to any 50008";
          Insert ChargingRuleDefinition.c_P_FlowInformation;
          Insert FlowInformation(2).c_P_FlowDescription;
//          FlowDescription(2) := "permit out ip from 10.69.80.79 to assigned";
//          FlowDescription(2) := "permit out 17 from 10.56.111.0/24 5008 to 10.0.0.0/8 1-65535";
          FlowDescription(2) := "permit out 17 from any 1-65535 to assigned 50008";
          Insert ChargingRuleDefinition.c_P_Precedence;
          Precedence := 4;

          Insert ChargingRuleDefinition.c_P_RatingGroup;
          RatingGroup := 50;
          Insert ChargingRuleDefinition.c_P_FlowStatus;
          FlowStatus := 2 /* 2 = ENABLED */;
          Insert ChargingRuleDefinition.c_P_ReportingLevel;
          ReportingLevel := 1 /* 1 = RATING_GROUP_LEVEL */;


          Insert ChargingRuleDefinition.c_P_QoSInformation;
          //Insert QoSInformation.c_P_GuaranteedBitrateUL;
          //GuaranteedBitrateUL := 64000;
          //Insert QoSInformation.c_P_GuaranteedBitrateDL;
          //GuaranteedBitrateDL := 64000;
          Insert QoSInformation.c_P_MaxRequestedBandwidthUL;
          MaxRequestedBandwidthUL := 4096000;
          Insert QoSInformation.c_P_MaxRequestedBandwidthDL;
          MaxRequestedBandwidthDL := 4096000;
          Insert QoSInformation.c_P_AllocationRetentionPriority;
          PriorityLevel := 1;
          Insert QoSInformation.c_P_QoSClassIdentifier;
          QoSClassIdentifier := 8;

          ReAuthRequestType := 0;
      EndModify);
  Send;
  WaitFor Message(RAA);                          /* |<--- RAA         ----| */



