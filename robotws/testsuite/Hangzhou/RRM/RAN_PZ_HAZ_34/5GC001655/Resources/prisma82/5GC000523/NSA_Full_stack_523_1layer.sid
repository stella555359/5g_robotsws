    <format name="bbCfg" show="BB Debug facilities" version="1.0">
      <group name="bbCfg" show="BB Debug facilities" priority="250">
        <subgroup name="bbCfg" show="BB Debug facilities" priority="250">
          <integer name="Version" show="Version" writable="false" exportable="false" null="false" index="false" default="1" min="1" max="2147483647" step="0">Xml version</integer>
          <bitfield name="DlBaseVerbosity" show="Downlink verbosity" writable="true" exportable="false" null="false" index="false" default="0000000000000000" format="%016x" bits="15">
            BB Downlink basic verbosity
            <bit index="14" show="DL CELL configuration" />
            <bit index="13" show="DL RNTI parser configuration" />
            <bit index="12" show="DL RNTI measure set configuration" />
            <bit index="11" show="DL RNTI configuration" />
            <bit index="10" show="DL HARQ" />
            <bit index="9" show="LDPC decoder" />
            <bit index="8" show="PDSCH" />
            <bit index="7" show="CSI reference signal" />
            <bit index="6" show="Equalizer" />
            <bit index="5" show="DCI" />
            <bit index="4" show="Polar decoder" />
            <bit index="3" show="PDCCH" />
            <bit index="2" show="SSB (PSS-SSS-PBCH)" />
            <bit index="1" show="BB-AP driver interface" />
            <bit index="0" show="BB-L2 messages" />
          </bitfield>
          <bitfield name="UlBaseVerbosity" show="Uplink verbosity" writable="true" exportable="false" null="false" index="false" default="0000000000000000" format="%016x" bits="12">
            BB Uplink basic verbosity
            <bit index="11" show="UL CELL configuration" />
            <bit index="10" show="UL RNTI parser configuration" />
            <bit index="9" show="UL RNTI measure set configuration" />
            <bit index="8" show="UL RNTI configuration" />
            <bit index="7" show="DL_HARQ feedback" />
            <bit index="6" show="CSI reporting" />
            <bit index="5" show="Power control" />
            <bit index="4" show="SR" />
            <bit index="3" show="SRS" />
            <bit index="2" show="PUCCH" />
            <bit index="1" show="PUSCH" />
            <bit index="0" show="L2-BB messages" />
          </bitfield>
          <bitfield name="EventVerbosity" show="Event triggered verbosity" writable="true" exportable="false" null="false" index="false" default="0000000000000000" format="%016x" bits="17">
            Event triggered verbosity verbosity
            <bit index="16" show="Reserved 1" />
            <bit index="15" show="Reserved 0" />
            <bit index="14" show="A grant has been discarded for some reason" />
            <bit index="13" show="Power detected on PDCCH but no grant decoded" />
            <bit index="12" show="CRC error on the last PDSCH segment" />
            <bit index="11" show="First CRC error on a PDSCH multiplexed with CSI" />
            <bit index="10" show="First CRC error on a retransmission (RV != 0)" />
            <bit index="9" show="First CRC error on PDSCH 4x4 MIMO 256QAM" />
            <bit index="8" show="First CRC error on PDSCH 4x4 MIMO 64QAM" />
            <bit index="7" show="first CRC error on PDSCH 4x4 MIMO 16QAM" />
            <bit index="6" show="First CRC error on PDSCH 4x4 MIMO QPSK" />
            <bit index="5" show="First CRC error on PDSCH 2x2 MIMO 256QAM" />
            <bit index="4" show="First CRC error on PDSCH 2x2 MIMO 64QAM" />
            <bit index="3" show="First CRC error on PDSCH 2x2 MIMO 16QAM" />
            <bit index="2" show="First CRC error on PDSCH 2x2 MIMO QPSK" />
            <bit index="1" show="100th CRC error on PDSCH" />
            <bit index="0" show="First CRC error on PDSCH" />
          </bitfield>
        </subgroup>
      </group>
    </format>
