    <format name="l2Cfg" show="L2 Debug facilities" version="1.0">
      <group name="l2Cfg" show="L2 Debug facilities" priority="250">
        <subgroup name="l2Cfg" show="L2 Debug facilities" priority="250">
          <integer name="Version" show="Version" writable="false" exportable="false" null="false" index="false" default="1" min="1" max="2147483647" step="0">Xml version</integer>
          <bitfield name="L2_nr5g_RlcMac_Verbosity" show="NR RLC/MAC verbosity" writable="true" exportable="false" null="false" index="false" default="00000000" format="%08x" bits="32">
            L2_nr5g RlcMac Verbosity
            <bit index="31" show="Bit 32" />
            <bit index="30" show="Bit 31" />
