            <bit index="12" show="RLC STATUS" />
            <bit index="11" show="Uplink Scheduler" />
            <bit index="10" show="L2-L1 Interface" />
            <bit index="9" show="AMM Verbose" />
            <bit index="8" show="AMM Basic" />
            <bit index="7" show="Secondary Cells" />
            <bit index="6" show="RLC Basic" />
            <bit index="5" show="Uplink HARQ" />
            <bit index="4" show="Uplink SPS" />
            <bit index="3" show="L2 Timing Advance" />
            <bit index="2" show="MAC Buffer Status Report" />
            <bit index="1" show="L2 Scheduling Request" />
            <bit index="0" show="MAC Basic Configuration" />
          </bitfield>
          <bitfield name="L2_nr5g_pdcp_Verbosity" show="NR PDCP verbosity" writable="true" exportable="false" null="false" index="false" default="00000000" format="%08x" bits="32">
            L2_nr5g Pdcp Verbosity
            <bit index="31" show="Bit 32" />
            <bit index="30" show="Bit 31" />
            <bit index="29" show="Bit 30" />
            <bit index="28" show="Bit 29" />
            <bit index="27" show="Bit 28" />
            <bit index="26" show="Bit 27" />
