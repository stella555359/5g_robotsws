<?xml version="1.1"?>
<!DOCTYPE format PUBLIC "-//prisma//DTD Format 2.0//EN" "http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/dtd/xmlFormat-2.dtd">
<?xml-stylesheet type="text/xsl" href="http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/xsl/htmlFormat.xsl"?>

<format name="NrUplinkFile" show="NR uplink waveform from file" version="1.0">
    <group name="NrUplinkFile" show="NR uplink waveform from file" priority="250">
        <integer name="Version" show="Version" writable="false" default="2" cformat="uint32"> </integer>
        <integer name="testType" show="Test Type" writable="false" default="258" cformat="uint32"> </integer>
        <enum name="numAnt" show="Number of antennas" cformat="uint32">
            <option value="1">one antenna</option>
            <option value="2">two antennas</option>
        </enum>
        <enum name="SubcarrierSpacing" show="Uplink Subcarrier Spacing" cformat="uint32">
            Subcarrier spacing (numerology)
            <option value="0">kHz15</option>
            <option value="1">kHz30</option>
            <option value="2">kHz60</option>
            <option value="3">kHz120</option>
            <option value="4">kHz240</option>
        </enum>
        <formatted name="FileName" show="File name with complete path on LSU" format="string" maxLen="256" default="" null="false"> </formatted> 
    </group>
</format>
