<?xml version="1.1"?>
<!DOCTYPE format PUBLIC "-//prisma//DTD Format 2.0//EN" "http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/dtd/xmlFormat-2.dtd">
<?xml-stylesheet type="text/xsl" href="http://memo.prisma/svn/guitools/mssimsuite_gui/netbeans_platform/trunk/xsl/htmlFormat.xsl"?>

<format name="NrPdsch" show="NR PDSCH Test" version="1.0">
    <group name="NrPdsch" show="Higher Layers Pdsch Config" priority="250">
        <integer name="Version" show="Version" writable="false" default="15" cformat="uint32"> </integer>
        <integer name="TestType" show="Test Type" writable="false" default="2" cformat="uint32"> </integer>
        <integer name="scrId" show="Data scrambling Identity" default="-1" min="-1" max="65535" step="0" cformat="int32"> 
        Data-scrambling-Identity for PDSCH scrambling (-1 to use disable)
        </integer>     
        <integer name="nscid" show="nscid value" default="0" min="0" max="1" step="0" cformat="uint32"></integer>
        <enum name="xoh" show="Xoh-PDSCH" writable="false" default="0" cformat="uint32">
            <option value="0">0</option>
            <option value="1">6</option>
            <option value="2">12</option>
            <option value="3">28</option>
        </enum>        
    </group>   

    <group name="OtherInfo" show="Other info" priority="250">          
        <enum name="LDPCiter" show="LDPC decoder iterations" default="3" cformat="uint32">
            <option value="0">AUTO</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="8">8</option>
            <option value="10">10</option>
        </enum>
        <enum name="dumpSubf" show="Subframe (dump)" cformat="uint32">
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="7">7</option>
            <option value="8">8</option>
            <option value="9">9</option>
        </enum>           
        <enum name="dumpSlot" show="Slot (dump)" default="1" cformat="uint32">
            Please respect slot/scs restrictions (i.e. max 2 slots with 30khz) 
            <option value="0">0</option>
            <option value="1">1 (>15khz)</option>
            <option value="2">2 (>30khz)</option>
            <option value="3">3 (>30khz)</option>
            <option value="4">4 (120khz)</option>
            <option value="5">5 (120khz)</option>
            <option value="6">6 (120khz)</option>
            <option value="7">7 (120khz)</option>
        </enum>           
        <enum name="DecRepeat" show="Number of decoded slots" default="2" cformat="uint32">
            <option value="0">One</option>
            <option value="1">Two</option>
            <option value="2">Infinite Loop</option>
        </enum>
        <enum name="Verbosity" show="PDSCH verbosity" cformat="uint32">
        Please set OFF when throughput is more than 10mbit
            <option value="0">OFF</option>
            <option value="1">ON</option>
            <option value="2">HIGH</option>
        </enum>
        <enum name="DCIflag" show="DCI simulation Flag" default="1" cformat="uint32">
            Enable/Disable DCI simulation. 
            <option value="0">Simulation OFF</option>
            <option value="1">Simulation ON</option>
            <dependence group="DCI" values="Simulator ON" enable="true" />
            <dependence group="FrameStructure" values="Simulator ON" enable="true" />
            <dependence group="DCI" values="Simulator OFF" enable="false" />
            <dependence group="FrameStructure" values="Simulator OFF" enable="false" />
        </enum>               
    </group>
    
    <group name="DCI" show="DCI Simulation" priority="250">        
        <integer name="rarnti" show="RA-RNTI" writable="true" default="0" min="1" max="65535" step="0" cformat="uint32"> 
        RA-RNTI: PDSCH decoding is attemped using this RNTI until a valid RAR has been received. Set it to 0 if you want to use only the C-RNTI 
        </integer>
        <integer name="rnti" show="C-RNTI" writable="true" default="200" min="1" max="65535" step="0" cformat="uint32"> </integer>
        <integer name="antPorts" show="Antenna port configuration" writable="true" default="0" min="0" max="31" step="0" cformat="uint32"> </integer>
        <integer name="mcs" show="Modulation and coding scheme" writable="true" default="0" min="0" max="27" step="0" cformat="uint32"> </integer>
        <enum name="resAllocType" show="Resource-allocation-config" default="1" cformat="uint32">
            Resource allocation scheme info (0:bitmap 1:contiguous)
            <option value="0">0 (bitmap)</option>
            <option value="1">1 (contiguous)</option>
        </enum>
        <integer name="startRB" show="Starting RB index" writable="true" default="0" min="0" max="272" step="0" cformat="uint32"> 
        Starting Resource Block. Used when ResAllocationCfg is 1.
        </integer>
        <integer name="nRB" show="Amount of allocated resource blocks" writable="true" default="2" min="1" max="273" step="0" cformat="uint32">
        Number of Consecutive Resource Blocks. Used when ResAllocationCfg is 1.
        </integer>        
        <bitfield name="RBbitmap" show="Allocation Bitmap" format="%08x" bits="18" default="00000FFF" writable="true" exportable="false" null="false" index="false" cformat="uint32">
            RBG bitmap (1 bit per RBG): 38.214, 5.1.2.2.1
            Used when ResAllocationCfg is 0. (rbgSize fixed to 0)
            <bit index="17" show="RBG 17"/>
            <bit index="16" show="RBG 16"/>
            <bit index="15" show="RBG 15"/>
            <bit index="14" show="RBG 14"/>
            <bit index="13" show="RBG 13"/>
            <bit index="12" show="RBG 12"/>
            <bit index="11" show="RBG 11"/>
            <bit index="10" show="RBG 10"/>
            <bit index="9" show="RBG 9"/>
            <bit index="8" show="RBG 8"/>
            <bit index="7" show="RBG 7"/>
            <bit index="6" show="RBG 6"/>
            <bit index="5" show="RBG 5"/>
            <bit index="4" show="RBG 4"/>
            <bit index="3" show="RBG 3"/>
            <bit index="2" show="RBG 2"/>
            <bit index="1" show="RBG 1"/>
            <bit index="0" show="RBG 0"/>
        </bitfield>           
        <enum name="McsTable" show="MCS Table" cformat="uint32">
            <option value="0">0 (64QAM)</option>
            <option value="1">1 (256QAM)</option>
        </enum>
        <enum name="rv" show="Redundancy version" writable="false" default="0" cformat="uint32">
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
        </enum>
        <enum name="dmrsPower" show="DMRS power delta compared to PDSCH" default="1" cformat="uint32">
            <option value="0">0db</option>
            <option value="1">3db</option>
            <option value="2">6db</option>
        </enum>            
        <enum name="dmrsAddPos" show="DMRS-Add-Pos" cformat="uint32">
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
        </enum>    
        <enum name="MappingType" show="PDSCH Mapping Type" writable="false" cformat="uint32">
            <option value="0">A</option>
            <option value="1">B</option>
        </enum> 
        <enum name="PTRS_DlCfg" show="PTRS DownlinkConfig ON/OFF" cformat="uint32">
            <option value="0">OFF</option>
            <option value="1">ON</option>
        </enum>
        <enum name="PTRS_Freq" show="PTRS Freq Density" default="2" cformat="uint32">
            PTRS RB density in frequency (0FF / 24 / 48)
            <option value="0">OFF</option>
            <option value="1">2RB</option>
            <option value="2">4RB</option>
        </enum>        
        <bitfield name="PTRS_Map" show="PTRS symbol bitmap" format="%08x" bits="14" default="00003ffa" writable="true" exportable="false" null="false" index="false" cformat="uint32">
            PTRS symbol bitmap (1 bit per PTRS symbol)
            <bit index="13" show="symb 13"/>
            <bit index="12" show="symb 12"/>
            <bit index="11" show="symb 11"/>
            <bit index="10" show="symb 10"/>
            <bit index="9" show="symb 9"/>
            <bit index="8" show="symb 8"/>
            <bit index="7" show="symb 7"/>
            <bit index="6" show="symb 6"/>
            <bit index="5" show="symb 5"/>
            <bit index="4" show="symb 4"/>
            <bit index="3" show="symb 3"/>
            <bit index="2" show="symb 2"/>
            <bit index="1" show="symb 1"/>
            <bit index="0" show="symb 0"/>
        </bitfield>       
        <enum name="PTRS_REoffset" show="PTRS RE offset" default="4" cformat="uint32">
            PTRS RE offset in the RB
            <option value="0">RE 0</option>
            <option value="1">RE 1</option>
            <option value="2">RE 2</option>
            <option value="3">RE 3</option>
            <option value="4">RE 4</option>
            <option value="5">RE 5</option>
            <option value="6">RE 6</option>
            <option value="7">RE 7</option>
            <option value="8">RE 8</option>
            <option value="9">RE 9</option>
            <option value="10">RE 10</option>
            <option value="11">RE 11</option>            
        </enum>         
    </group>
   <group name="FrameStructure" show="Frame Structure" priority="250">
        <enum name="lStart_0" show="PDSCH starting symbol (slot type 0)" cformat="uint32">
            <option value="0">s1</option>
            <option value="1">s2</option>
        </enum>
        <enum name="lEnd_0" show="PDSCH last symbol (slot type 0)" default="4" cformat="uint32">
            <option value="0">s7</option>
            <option value="1">s8</option>
            <option value="2">s9</option>
            <option value="3">s10</option>
            <option value="4">s11</option>
            <option value="5">s12</option>
            <option value="6">s13</option>
        </enum>         
        <bitfield name="slotsMap1_0" show="Rx slots (type 0) (0..63)" format="%016x" bits="64" default="fffffffffffffffe" writable="true" exportable="false" null="false" index="false" cformat="uint64">
            Slots for transmitting PDSCH (slot type 0)
            <bit index="63" show="slot 63"/>
            <bit index="62" show="slot 62"/>
            <bit index="61" show="slot 61"/>
            <bit index="60" show="slot 60"/>
            <bit index="59" show="slot 59"/>
            <bit index="58" show="slot 58"/>
            <bit index="57" show="slot 57"/>
            <bit index="56" show="slot 56"/>
            <bit index="55" show="slot 55"/>
            <bit index="54" show="slot 54"/>
            <bit index="53" show="slot 53"/>
            <bit index="52" show="slot 52"/>
            <bit index="51" show="slot 51"/>
            <bit index="50" show="slot 50"/>
            <bit index="49" show="slot 49"/>
            <bit index="48" show="slot 48"/>
            <bit index="47" show="slot 47"/>
            <bit index="46" show="slot 46"/>
            <bit index="45" show="slot 45"/>
            <bit index="44" show="slot 44"/>
            <bit index="43" show="slot 43"/>
            <bit index="42" show="slot 42"/>
            <bit index="41" show="slot 41"/>
            <bit index="40" show="slot 40"/>
            <bit index="39" show="slot 39"/>
            <bit index="38" show="slot 38"/>
            <bit index="37" show="slot 37"/>
            <bit index="36" show="slot 36"/>
            <bit index="35" show="slot 35"/>
            <bit index="34" show="slot 34"/>
            <bit index="33" show="slot 33"/>
            <bit index="32" show="slot 32"/>
            <bit index="31" show="slot 31"/>
            <bit index="30" show="slot 30"/>
            <bit index="29" show="slot 29"/>
            <bit index="28" show="slot 28"/>
            <bit index="27" show="slot 27"/>
            <bit index="26" show="slot 26"/>
            <bit index="25" show="slot 25"/>
            <bit index="24" show="slot 24"/>
            <bit index="23" show="slot 23"/>
            <bit index="22" show="slot 22"/>
            <bit index="21" show="slot 21"/>
            <bit index="20" show="slot 20"/>
            <bit index="19" show="slot 19"/>
            <bit index="18" show="slot 18"/>
            <bit index="17" show="slot 17"/>
            <bit index="16" show="slot 16"/>
            <bit index="15" show="slot 15"/>
            <bit index="14" show="slot 14"/>
            <bit index="13" show="slot 13"/>
            <bit index="12" show="slot 12"/>
            <bit index="11" show="slot 11"/>
            <bit index="10" show="slot 10"/>
            <bit index="9" show="slot 9"/>
            <bit index="8" show="slot 8"/>
            <bit index="7" show="slot 7"/>
            <bit index="6" show="slot 6"/>
            <bit index="5" show="slot 5"/>
            <bit index="4" show="slot 4"/>
            <bit index="3" show="slot 3"/>
            <bit index="2" show="slot 2"/>
            <bit index="1" show="slot 1"/>
            <bit index="0" show="slot 0"/>
        </bitfield>        
        <bitfield name="slotsMap2_0" show="Rx slots (type 0) (64..79)" format="%08x" bits="16" default="00000000" writable="true" exportable="false" null="false" index="false" cformat="uint32">
            Slots for transmitting PDSCH (slot type 0)
            <bit index="15" show="slot 79"/>
            <bit index="14" show="slot 78"/>
            <bit index="13" show="slot 77"/>
            <bit index="12" show="slot 76"/>
            <bit index="11" show="slot 75"/>
            <bit index="10" show="slot 74"/>
            <bit index="9" show="slot 73"/>
            <bit index="8" show="slot 72"/>
            <bit index="7" show="slot 71"/>
            <bit index="6" show="slot 70"/>
            <bit index="5" show="slot 69"/>
            <bit index="4" show="slot 68"/>
            <bit index="3" show="slot 67"/>
            <bit index="2" show="slot 66"/>
            <bit index="1" show="slot 65"/>
            <bit index="0" show="slot 64"/>
        </bitfield>
        <enum name="lStart_1" show="PDSCH starting symbol (slot type 1)" cformat="uint32">
            <option value="0">s1</option>
            <option value="1">s2</option>
        </enum>
        <enum name="lEnd_1" show="PDSCH last symbol (slot type 1)" default="2" cformat="uint32">
            <option value="0">s7</option>
            <option value="1">s8</option>
            <option value="2">s9</option>
            <option value="3">s10</option>
            <option value="4">s11</option>
            <option value="5">s12</option>
            <option value="6">s13</option>
        </enum>         
        <bitfield name="slotsMap1_1" show="Rx slots (type 1) (0..63)" format="%016x" bits="64" default="0000000000000000" writable="true" exportable="false" null="false" index="false" cformat="uint64">
            Slots for transmitting PDSCH (slot type 1)
            <bit index="63" show="slot 63"/>
            <bit index="62" show="slot 62"/>
            <bit index="61" show="slot 61"/>
            <bit index="60" show="slot 60"/>
            <bit index="59" show="slot 59"/>
            <bit index="58" show="slot 58"/>
            <bit index="57" show="slot 57"/>
            <bit index="56" show="slot 56"/>
            <bit index="55" show="slot 55"/>
            <bit index="54" show="slot 54"/>
            <bit index="53" show="slot 53"/>
            <bit index="52" show="slot 52"/>
            <bit index="51" show="slot 51"/>
            <bit index="50" show="slot 50"/>
            <bit index="49" show="slot 49"/>
            <bit index="48" show="slot 48"/>
            <bit index="47" show="slot 47"/>
            <bit index="46" show="slot 46"/>
            <bit index="45" show="slot 45"/>
            <bit index="44" show="slot 44"/>
            <bit index="43" show="slot 43"/>
            <bit index="42" show="slot 42"/>
            <bit index="41" show="slot 41"/>
            <bit index="40" show="slot 40"/>
            <bit index="39" show="slot 39"/>
            <bit index="38" show="slot 38"/>
            <bit index="37" show="slot 37"/>
            <bit index="36" show="slot 36"/>
            <bit index="35" show="slot 35"/>
            <bit index="34" show="slot 34"/>
            <bit index="33" show="slot 33"/>
            <bit index="32" show="slot 32"/>
            <bit index="31" show="slot 31"/>
            <bit index="30" show="slot 30"/>
            <bit index="29" show="slot 29"/>
            <bit index="28" show="slot 28"/>
            <bit index="27" show="slot 27"/>
            <bit index="26" show="slot 26"/>
            <bit index="25" show="slot 25"/>
            <bit index="24" show="slot 24"/>
            <bit index="23" show="slot 23"/>
            <bit index="22" show="slot 22"/>
            <bit index="21" show="slot 21"/>
            <bit index="20" show="slot 20"/>
            <bit index="19" show="slot 19"/>
            <bit index="18" show="slot 18"/>
            <bit index="17" show="slot 17"/>
            <bit index="16" show="slot 16"/>
            <bit index="15" show="slot 15"/>
            <bit index="14" show="slot 14"/>
            <bit index="13" show="slot 13"/>
            <bit index="12" show="slot 12"/>
            <bit index="11" show="slot 11"/>
            <bit index="10" show="slot 10"/>
            <bit index="9" show="slot 9"/>
            <bit index="8" show="slot 8"/>
            <bit index="7" show="slot 7"/>
            <bit index="6" show="slot 6"/>
            <bit index="5" show="slot 5"/>
            <bit index="4" show="slot 4"/>
            <bit index="3" show="slot 3"/>
            <bit index="2" show="slot 2"/>
            <bit index="1" show="slot 1"/>
            <bit index="0" show="slot 0"/>
        </bitfield>        
        <bitfield name="slotsMap2_1" show="Rx slots (type 1) (64..79)" format="%08x" bits="16" default="00000000" writable="true" exportable="false" null="false" index="false" cformat="uint32">
            Slots for transmitting PDSCH (slot type 1)
            <bit index="15" show="slot 79"/>
            <bit index="14" show="slot 78"/>
            <bit index="13" show="slot 77"/>
            <bit index="12" show="slot 76"/>
            <bit index="11" show="slot 75"/>
            <bit index="10" show="slot 74"/>
            <bit index="9" show="slot 73"/>
            <bit index="8" show="slot 72"/>
            <bit index="7" show="slot 71"/>
            <bit index="6" show="slot 70"/>
            <bit index="5" show="slot 69"/>
            <bit index="4" show="slot 68"/>
            <bit index="3" show="slot 67"/>
            <bit index="2" show="slot 66"/>
            <bit index="1" show="slot 65"/>
            <bit index="0" show="slot 64"/>
        </bitfield>
    </group>    
</format>
