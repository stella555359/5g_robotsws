<?xml version="1.0" encoding="UTF-8"?>
<scxml id="feature1877_772_C_SA_XN_HandOverInterGNB" author="rduthu" date="2020/05/15 12:36:40" type="CUSTOM" loop="true" description="Check NG Traces for a SA L3 Call and release done with cDRX activated" formatversion="1.0">
    <param>
        <varkeystring id="TsharkMessage" value="event.Tshark.Message"/>
        <varinteger id="XNCounter" value="0"/>
        <varinteger id="XnSetupFailureCounter" value="0"/>
    </param>
    <onexit>def writeInFile(counterDict):
    fileDict = {}
    try:
        with open(&quot;DetectedUseCases.log&quot;, &quot;r&quot;) as file:
            for line in file:
                key, value = line.split(':')
                fileDict[key] = int(value)
    except:
        pass
    with open(&quot;DetectedUseCases.log&quot;, &quot;w&quot;) as file:
        for element in counterDict:
            try:
                fileDict[element] += counterDict[element]
            except:
                fileDict[element] = counterDict[element]
        for element in fileDict:
            file.write(element + ': ' + str(fileDict[element]) + '\n')


counterToWrite = {'XNCounter': XNCounter.getValue()}
writeInFile(counterToWrite)

counterToWrite = {'XnSetupFailureCounter': XnSetupFailureCounter.getValue()}
writeInFile(counterToWrite)</onexit>
    <state id="HandoverRequest" xpos="233" ypos="1332">
