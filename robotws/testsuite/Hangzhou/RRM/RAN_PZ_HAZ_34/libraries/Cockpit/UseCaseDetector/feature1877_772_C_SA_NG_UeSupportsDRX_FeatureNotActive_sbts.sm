<?xml version="1.0" encoding="UTF-8"?>
<scxml id="feature1877_772_C_SA_NG_UeSupportsDRX_FeatureNotActive" author="rduthu" date="2020/11/04 10:02:51" type="CUSTOM" loop="true" description="Check NG Traces for a SA L3 Call and release done with cDRX activated" formatversion="1.0">
    <param>
        <varinteger id="NGCounter" value="0"/>
        <varkeystring id="TsharkMessage" value="event.Tshark.Message"/>
    </param>
    <onexit>def writeInFile(counterDict):
    fileDict = {}
    try:
        with open(&quot;DetectedUseCases.log&quot;, &quot;r&quot;) as file:
            for line in file:
                key, value = line.split(':')
                fileDict[key] = int(value)
    except:
        pass
    with open(&quot;DetectedUseCases.log&quot;, &quot;w&quot;) as file:
        for element in counterDict:
            try:
                fileDict[element] += counterDict[element]
            except:
                fileDict[element] = counterDict[element]
        for element in fileDict:
            file.write(element + ': ' + str(fileDict[element]) + '\n')


counterToWrite = {'NGCounter': NGCounter.getValue()}
writeInFile(counterToWrite)</onexit>
    <state id="DownlinkNASTransportAuthenticationRequest" xpos="225" ypos="756">
