<?xml version="1.0" encoding="UTF-8"?>
<scxml id="feature1877_772_C_SA_XN_Handover_Target_GNB" author="rduthu" date="2020/05/12 13:11:18" type="CUSTOM" loop="true" description="Check NG Traces for a SA L3 Call and release done with cDRX activated" formatversion="1.0">
    <param>
        <varkeystring id="TsharkMessage" value="event.Tshark.Message"/>
        <varinteger id="XNCounter" value="0"/>
        <varinteger id="XnSetupFailureCounter" value="0"/>
    </param>
    <onexit>def writeInFile(counterDict):
    fileDict = {}
    try:
        with open(&quot;DetectedUseCases.log&quot;, &quot;r&quot;) as file:
            for line in file:
                key, value = line.split(':')
                fileDict[key] = int(value)
    except:
        pass
    with open(&quot;DetectedUseCases.log&quot;, &quot;w&quot;) as file:
        for element in counterDict:
            try:
                fileDict[element] += counterDict[element]
            except:
                fileDict[element] = counterDict[element]
        for element in fileDict:
            file.write(element + ': ' + str(fileDict[element]) + '\n')


counterToWrite = {'XNCounter': XNCounter.getValue()}
writeInFile(counterToWrite)

counterToWrite = {'XnSetupFailureCounter': XnSetupFailureCounter.getValue()}
writeInFile(counterToWrite)</onexit>
    <state id="HandoverRequest" xpos="226" ypos="1155">
        <transition event="&quot;HandoverRequestAcknowledge_element&quot; in TsharkMessage &#10;" target="HandoverRequestAcknowledge"/>
        <onenter>XNCounter.setValue(XNCounter.getValue()+1)</onenter>
    </state>
    <state id="HandoverRequestAcknowledge" xpos="229" ypos="1350">
        <transition event="&quot;UEContextRelease_element&quot; in TsharkMessage &#10;" target="UEContextRelease"/>
        <onenter>XNCounter.setValue(XNCounter.getValue()+1)</onenter>
    </state>
    <initial id="INIT" xpos="218" ypos="278">
        <transition event=" &quot;XnSetupRequest_element&quot; in TsharkMessage&#10;" target="XnSetupRequest"/>
    </initial>
    <state id="NGRANNodeConfigurationUpdate" xpos="225" ypos="756">
        <transition event="&quot;NGRANNodeConfigurationUpdateAcknowledge_element&quot; in TsharkMessage &#10;" target="NGRANNodeConfigurationUpdateAcknowledge"/>
        <onenter>XNCounter.setValue(XNCounter.getValue()+1)</onenter>
    </state>
    <state id="NGRANNodeConfigurationUpdateAcknowledge" xpos="227" ypos="923">
        <transition event="&quot;HandoverRequest_element&quot; in TsharkMessage&#10;" target="HandoverRequest"/>
        <onenter>XNCounter.setValue(XNCounter.getValue()+1)</onenter>
    </state>
    <final id="UEContextRelease" xpos="233" ypos="1527" type="SUCCESS">
        <onenter>XNCounter.setValue(XNCounter.getValue()+1)</onenter>
    </final>
    <final id="XnSetupFailure" xpos="591" ypos="447" type="SUCCESS">
        <onenter>XnSetupFailureCounter.setValue(XnSetupFailureCounter.getValue()+1)</onenter>
    </final>
    <state id="XnSetupRequest" xpos="222" ypos="445">
        <transition event=" &quot;XnSetupFailure_element&quot; in TsharkMessage&#10;" target="XnSetupFailure"/>
        <transition event=" &quot;XnSetupResponse_element&quot; in TsharkMessage&#10;" target="XnSetupResponse"/>
    </state>
    <state id="XnSetupResponse" xpos="223" ypos="604">
