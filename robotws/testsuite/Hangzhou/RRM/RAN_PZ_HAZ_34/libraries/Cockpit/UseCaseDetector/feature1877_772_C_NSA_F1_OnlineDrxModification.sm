<?xml version="1.0" encoding="UTF-8"?>
<scxml id="feature1877_772_C_NSA_F1_OnlineDrxModification" author="rduthu" date="2020/05/15 17:40:50" type="CUSTOM" loop="false" description="" formatversion="1.0">
    <param>
        <varinteger id="F1Counter" value="0"/>
        <varinteger id="True_UE1_DrxLongCycleStartOffset" value="0"/>
        <varkeystring id="TsharkMessage" value="event.Tshark.Message"/>
        <varinteger id="UE1_DrxLongCycleStartOffset" value="0"/>
        <varinteger id="UE2_DrxLongCycleStartOffset" value="0"/>
    </param>
    <onexit>def writeInFile(counterDict):
    fileDict = {}
    try:
        with open(&quot;DetectedUseCases.log&quot;, &quot;r&quot;) as file:
            for line in file:
                key, value = line.split(':')
                fileDict[key] = int(value)
    except:
        pass
    with open(&quot;DetectedUseCases.log&quot;, &quot;w&quot;) as file:
        for element in counterDict:
            try:
                fileDict[element] += counterDict[element]
            except:
                fileDict[element] = counterDict[element]
        for element in fileDict:
            file.write(element + ': ' + str(fileDict[element]) + '\n')


counterToWrite = {'F1Counter': F1Counter.getValue()}
writeInFile(counterToWrite)

True_UE1_DrxLongCycleStartOffset.setValue( UE1_DrxLongCycleStartOffset.getValue() - UE2_DrxLongCycleStartOffset.getValue())

counterToWrite = {'UE1_DrxLongCycleStartOffset': True_UE1_DrxLongCycleStartOffset.getValue()}
writeInFile(counterToWrite)

counterToWrite = {'UE2_DrxLongCycleStartOffset': UE2_DrxLongCycleStartOffset.getValue()}
writeInFile(counterToWrite)</onexit>
