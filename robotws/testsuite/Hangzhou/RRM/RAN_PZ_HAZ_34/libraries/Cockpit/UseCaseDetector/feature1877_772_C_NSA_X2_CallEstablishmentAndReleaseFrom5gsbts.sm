<?xml version="1.0" encoding="UTF-8"?>
<scxml id="feature1877_772_C_NSA_X2_CallEstablishmentAndRelease" author="rduthu" date="2020/05/02 17:19:29" type="CUSTOM" loop="true" description="Check X2 Traces for a NSA L3 Call and release done with cDRX activated" formatversion="1.0">
    <param>
        <varkeystring id="TsharkMessage" value="event.Tshark.Message"/>
        <varinteger id="X2Counter" value="0"/>
    </param>
    <onexit>def writeInFile(counterDict):
    fileDict = {}
    try:
        with open(&quot;DetectedUseCases.log&quot;, &quot;r&quot;) as file:
            for line in file:
                key, value = line.split(':')
                fileDict[key] = int(value)
    except:
        pass
    with open(&quot;DetectedUseCases.log&quot;, &quot;w&quot;) as file:
        for element in counterDict:
            try:
                fileDict[element] += counterDict[element]
            except:
                fileDict[element] = counterDict[element]
        for element in fileDict:
            file.write(element + ': ' + str(fileDict[element]) + '\n')


counterToWrite = {'X2Counter': X2Counter.getValue()}
writeInFile(counterToWrite)</onexit>
    <initial id="INIT" xpos="231" ypos="377">
        <transition event="&quot;SgNBAdditionRequest_element&quot; in TsharkMessage&#10;and TsharkMessage.getField__source;layers;x2ap;x2ap.X2AP_PDU_tree;x2ap.initiatingMessage_element;x2ap.value_element;x2ap.SgNBAdditionRequest_element;x2ap.protocolIEs_tree;Item7:id\lMeNBtoSgNBContainer;x2ap.ProtocolIE_Field_element;x2ap.value_element;x2ap.MeNBtoSgNBContainer_tree;nr\lrrc.CG_ConfigInfo_element;nr\lrrc.criticalExtensions_tree;nr\lrrc.c1_tree;nr\lrrc.cg_ConfigInfo_element;nr\lrrc.ue_CapabilityInfo_tree;nr\lrrc.UE_CapabilityRAT_ContainerList_tree;Item1;nr\lrrc.UE_CapabilityRAT_Container_element;nr\lrrc.ue_CapabilityRAT_Container_tree;...;nr\lrrc.mac_ParametersXDD_Diff_element;nr\lrrc.longDRX_Cycle == 0&#10;&#10;" target="SgNbAdditionrequest"/>
    </initial>
    <final id="SNStatusTransfer" xpos="245" ypos="2267" type="SUCCESS">
        <onenter>X2Counter.setValue(X2Counter.getValue()+1)</onenter>
    </final>
    <state id="SgNBAdditionRequestAcknowledge_RRCReconfiguration" xpos="232" ypos="827">
        <transition event="&quot;SgNBReconfigurationComplete_element&quot; in TsharkMessage &#10;and &quot;nr-rrc.rrcReconfigurationComplete_element&quot; in TsharkMessage.getField__source;layers;x2ap;x2ap.X2AP_PDU_tree;x2ap.initiatingMessage_element;x2ap.value_element;x2ap.SgNBReconfigurationComplete_element;x2ap.protocolIEs_tree;Item2:id\lResponseInformationSgNBReconfComp;x2ap.ProtocolIE_Field_element;x2ap.value_element;x2ap.ResponseInformationSgNBReconfComp_tree;x2ap.success_SgNBReconfComp_element;x2ap.meNBtoSgNBContainer_tree;nr\lrrc.RRCReconfigurationComplete_element;nr\lrrc.criticalExtensions_tree" target="SgNBReconfigurationComplete_RRCReconfigurationComplete"/>
        <onenter>X2Counter.setValue(X2Counter.getValue()+1)</onenter>
