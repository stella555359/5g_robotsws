    <state id="SgNbAdditionrequest" xpos="235" ypos="583">
        <transition event="&quot;SgNBAdditionRequestAcknowledge_element&quot; in TsharkMessage&#10;and TsharkMessage.getField__source;layers;x2ap;x2ap.X2AP_PDU_tree;x2ap.successfulOutcome_element;x2ap.value_element;x2ap.SgNBAdditionRequestAcknowledge_element;x2ap.protocolIEs_tree;Item2:id\lE\lRABs\lAdmitted\lToBeAdded\lSgNBAddReqAckList;x2ap.ProtocolIE_Field_element;x2ap.value_element;x2ap.E_RABs_Admitted_ToBeAdded_SgNBAddReqAckList_tree;Item0:id\lE\lRABs\lAdmitted\lToBeAdded\lSgNBAddReqAck\lItem;x2ap.ProtocolIE_Single_Container_element;x2ap.value_element;x2ap.E_RABs_Admitted_ToBeAdded_SgNBAddReqAck_Item_element;x2ap.e_RAB_ID == 5&#10;and ( TsharkMessage.getField__source;layers;x2ap;x2ap.X2AP_PDU_tree;x2ap.successfulOutcome_element;x2ap.value_element;x2ap.SgNBAdditionRequestAcknowledge_element;x2ap.protocolIEs_tree;Item3:id\lSgNBtoMeNBContainer;x2ap.ProtocolIE_Field_element;x2ap.value_element;x2ap.SgNBtoMeNBContainer_tree;nr\lrrc.CG_Config_element;nr\lrrc.criticalExtensions_tree;nr\lrrc.c1_tree;nr\lrrc.cg_Config_element;nr\lrrc.scg_CellGroupConfig_tree;nr\lrrc.RRCReconfiguration_element;nr\lrrc.criticalExtensions_tree;nr\lrrc.rrcReconfiguration_element;nr\lrrc.secondaryCellGroup_tree;nr\lrrc.CellGroupConfig_element;nr\lrrc.rlc_BearerToAddModList_tree;Item0;nr\lrrc.RLC_BearerConfig_element;nr\lrrc.servedRadioBearer_tree;nr\lrrc.drb_Identity == 5&#10;or TsharkMessage.getField__source;layers;x2ap;x2ap.X2AP_PDU_tree;x2ap.successfulOutcome_element;x2ap.value_element;x2ap.SgNBAdditionRequestAcknowledge_element;x2ap.protocolIEs_tree;Item3:id\lSgNBtoMeNBContainer;x2ap.ProtocolIE_Field_element;x2ap.value_element;x2ap.SgNBtoMeNBContainer_tree;nr\lrrc.CG_Config_element;nr\lrrc.criticalExtensions_tree;nr\lrrc.c1_tree;nr\lrrc.cg_Config_element;nr\lrrc.scg_CellGroupConfig_tree;nr\lrrc.RRCReconfiguration_element;nr\lrrc.criticalExtensions_tree;nr\lrrc.rrcReconfiguration_element;nr\lrrc.secondaryCellGroup_tree;nr\lrrc.CellGroupConfig_element;nr\lrrc.rlc_BearerToAddModList_tree;Item0;nr\lrrc.RLC_BearerConfig_element;nr\lrrc.servedRadioBearer_tree;nr\lrrc.drb_Identity == 4 )&#10;" target="SgNBAdditionRequestAcknowledge_RRCReconfiguration"/>
