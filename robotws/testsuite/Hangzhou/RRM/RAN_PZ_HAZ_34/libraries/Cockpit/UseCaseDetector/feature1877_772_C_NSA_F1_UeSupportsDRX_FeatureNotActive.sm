<?xml version="1.0" encoding="UTF-8"?>
<scxml id="feature1877_772_C_NSA_F1_UeSupportsDRX_FeatureNotActive" author="rduthu" date="2020/05/02 20:42:40" type="CUSTOM" loop="true" description="Check F1 Traces for a NSA L3 Call and release done with cDRX activated" formatversion="1.0">
    <param>
        <varinteger id="F1Counter" value="0"/>
        <varkeystring id="TsharkMessage" value="event.Tshark.Message"/>
    </param>
    <onexit>def writeInFile(counterDict):
    fileDict = {}
    try:
        with open(&quot;DetectedUseCases.log&quot;, &quot;r&quot;) as file:
            for line in file:
                key, value = line.split(':')
                fileDict[key] = int(value)
    except:
        pass
    with open(&quot;DetectedUseCases.log&quot;, &quot;w&quot;) as file:
        for element in counterDict:
            try:
                fileDict[element] += counterDict[element]
            except:
                fileDict[element] = counterDict[element]
        for element in fileDict:
            file.write(element + ': ' + str(fileDict[element]) + '\n')


counterToWrite = {'F1Counter': F1Counter.getValue()}
writeInFile(counterToWrite)</onexit>
    <initial id="INIT" xpos="245" ypos="393">
        <transition event="&quot;UEContextSetupResponse_element&quot; in TsharkMessage&#10;and ( TsharkMessage.getField__source;layers;f1ap;f1ap.F1AP_PDU_tree;f1ap.successfulOutcome_element;f1ap.value_element;f1ap.UEContextSetupResponse_element;f1ap.protocolIEs_tree;Item2:id\lDUtoCURRCInformation;f1ap.ProtocolIE_Field_element;f1ap.value_element;f1ap.DUtoCURRCInformation_element;f1ap.cellGroupConfig_tree;nr\lrrc.CellGroupConfig_element;nr\lrrc.rlc_BearerToAddModList_tree;Item0;nr\lrrc.RLC_BearerConfig_element;nr\lrrc.servedRadioBearer_tree;nr\lrrc.drb_Identity == 5&#10;or TsharkMessage.getField__source;layers;f1ap;f1ap.F1AP_PDU_tree;f1ap.successfulOutcome_element;f1ap.value_element;f1ap.UEContextSetupResponse_element;f1ap.protocolIEs_tree;Item2:id\lDUtoCURRCInformation;f1ap.ProtocolIE_Field_element;f1ap.value_element;f1ap.DUtoCURRCInformation_element;f1ap.cellGroupConfig_tree;nr\lrrc.CellGroupConfig_element;nr\lrrc.rlc_BearerToAddModList_tree;Item0;nr\lrrc.RLC_BearerConfig_element;nr\lrrc.servedRadioBearer_tree;nr\lrrc.drb_Identity == 4 )&#10;&#10;" target="UEContextSetupResponse_Call"/>
    </initial>
    <state id="UEContextModificationResponse_Call" xpos="255" ypos="824">
        <transition event="&quot;UEContextReleaseComplete_element&quot; in TsharkMessage&#10;and &quot;successfulOutcome_element&quot; in TsharkMessage&#10;and TsharkMessage.getField__source;layers;f1ap;f1ap.F1AP_PDU_tree;f1ap.successfulOutcome_element;f1ap.value_element;f1ap.UEContextReleaseComplete_element;f1ap.protocolIEs_tree;Item0:id\lgNB\lCU\lUE\lF1AP\lID;f1ap.ProtocolIE_Field_element;f1ap.criticality  == 0&#10;and TsharkMessage.getField__source;layers;f1ap;f1ap.F1AP_PDU_tree;f1ap.successfulOutcome_element;f1ap.value_element;f1ap.UEContextReleaseComplete_element;f1ap.protocolIEs_tree;Item1:id\lgNB\lDU\lUE\lF1AP\lID;f1ap.ProtocolIE_Field_element;f1ap.criticality  == 0&#10;" target="UEContextReleaseComplete"/>
        <onenter>F1Counter.setValue(F1Counter.getValue()+1)</onenter>
    </state>
    <final id="UEContextReleaseComplete" xpos="258" ypos="1066" type="SUCCESS">
        <onenter>F1Counter.setValue(F1Counter.getValue()+1)</onenter>
    </final>
    <state id="UEContextSetupResponse_Call" xpos="249" ypos="624">
        <transition event="&quot;UEContextModificationResponse_element&quot; in TsharkMessage&#10;and TsharkMessage.getField__source;layers;f1ap;f1ap.F1AP_PDU_tree;f1ap.successfulOutcome_element;f1ap.value_element;f1ap.UEContextModificationResponse_element;f1ap.protocolIEs_tree;Item2:id\lDUtoCURRCInformation;f1ap.ProtocolIE_Field_element;f1ap.value_element;f1ap.DUtoCURRCInformation_element;f1ap.cellGroupConfig_tree;nr\lrrc.CellGroupConfig_element;nr\lrrc.mac_CellGroupConfig_element;per.extension_bit == 0&#10;" target="UEContextModificationResponse_Call"/>
        <onenter>F1Counter.setValue(F1Counter.getValue()+1)</onenter>
    </state>
</scxml>
