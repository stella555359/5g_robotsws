<?xml version="1.0" encoding="UTF-8"?>
<scxml id="feature1877_772_C_NSA_X2_OnlineDrxModification" author="rduthu" date="2020/05/18 07:36:36" type="CUSTOM" loop="false" description="" formatversion="1.0">
    <param>
        <varinteger id="True_X2UE1_DrxLongCycleStartOffset" value="0"/>
        <varkeystring id="TsharkMessage" value="event.Tshark.Message"/>
        <varinteger id="X2Counter" value="0"/>
        <varinteger id="X2UE1_DrxLongCycleStartOffset" value="0"/>
        <varinteger id="X2UE2_DrxLongCycleStartOffset" value="0"/>
    </param>
    <onexit>def writeInFile(counterDict):
    fileDict = {}
    try:
        with open(&quot;DetectedUseCases.log&quot;, &quot;r&quot;) as file:
            for line in file:
                key, value = line.split(':')
                fileDict[key] = int(value)
    except:
        pass
    with open(&quot;DetectedUseCases.log&quot;, &quot;w&quot;) as file:
        for element in counterDict:
            try:
                fileDict[element] += counterDict[element]
            except:
                fileDict[element] = counterDict[element]
        for element in fileDict:
            file.write(element + ': ' + str(fileDict[element]) + '\n')


counterToWrite = {'X2Counter': X2Counter.getValue()}
writeInFile(counterToWrite)

True_X2UE1_DrxLongCycleStartOffset.setValue(X2UE1_DrxLongCycleStartOffset.getValue() - X2UE2_DrxLongCycleStartOffset.getValue())

counterToWrite = {'UE1_DrxLongCycleStartOffset': True_X2UE1_DrxLongCycleStartOffset.getValue()}
writeInFile(counterToWrite)

counterToWrite = {'UE2_DrxLongCycleStartOffset': X2UE2_DrxLongCycleStartOffset.getValue()}
writeInFile(counterToWrite)</onexit>
