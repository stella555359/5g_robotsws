CB009485_C001_Monitoring of MBA Trace Session content related to segmentation of UE radio capability information
    [Documentation]
    ...    1. The purpose of this test case is to check following scenarios:
    ...    nonGBR DRX can be installed again after measGap setup and release.
    ...    2. Test Case Steps:
    ...    Step 1: UE register and attach to cell-1 with 5QI-5 bearer setup => NRDRB_5QI[a1]->NRDRB[b1]->nrDrxDN = NRDRX-1.
    ...    3. Expect Result
    ...    Step 1: UE attached and bearer 5QI-5 setup, and nonGBR DRX profile NRDRX-1 is installed for the UE. Event A2 is configured to UE.
    [Tags]    QC_46914    B011
	Clear Counter Files    wait=${False}
	#OnlineParamChange    ${CellTrace_rrconly}
	Register UE-1
	Check Counters    ${PM_COUNTER_C001}
	Register UE-2 and establish PDU session with 5 segments
	Check Counters    ${PM_COUNTER_C001_UE2_30}

*** Keywords ***
Perform Steps After Onair
    Start TCE    ${TCE_PORT}

Check AP Debug Log
    [Arguments]         ${grep_text}
    ${debug_check}      Run    cat ${SAVE LOG DIRECTORY}/PM_counters_*/PM_*/* | grep "INFO - ${grep_text}"
    Should Contain      ${debug_check}    ${grep_text}

Register UE-1
    [Arguments]    ${ue_id}=1
    start to capture wireshark log    attach_${ue_id}
     Execute Egate Command    ue_param id=${ue_id} ueCapInfomsg_Segment_Threshold=4500
	 BuiltIn.Log    UE${ue_id} Attach And Waiting L3 Call OK...    console=${True}
     Execute Egate Command    ue_enb_param id=${ue_id} ue_history_list=1
     Execute Egate Command    ue_change_location id=${ue_id} enb=2 cell=1
     Execute Egate Command    ue_register id=${ue_id}    pass_regexp=Received REGISTRATION COMPLETE
     Execute Egate Command    set_pdu_param ue=${ue_id} pdu=1 trf_type=internal
     Execute Egate Command    ue_pdu_session_setup ue=${ue_id} pdu=1 nwslice=1 gw=1    pass_regexp=Initial Context Setup Successful
     ...    timeout=20s    sleep_time=5

Register UE-2 and establish PDU session with 5 segments
    [Arguments]    ${cell_id}=1
    FOR    ${ue_id}    IN RANGE    2    ${UE_NUM}
	    start to capture wireshark log    attach_${ue_id}
        Execute Egate Command    ue_param id=${ue_id} ueCapInfomsg_Segment_Threshold=4500
	    BuiltIn.Log    UE${ue_id} Attach And Waiting L3 Call OK...    console=${True}
        Execute Egate Command    ue_enb_param id=${ue_id} ue_history_list=1
        Execute Egate Command    ue_change_location id=${ue_id} enb=2 cell=${cell_id}
        Execute Egate Command    ue_register id=${ue_id}    pass_regexp=Received REGISTRATION COMPLETE
        Execute Egate Command    set_pdu_param ue=${ue_id} pdu=1 trf_type=internal
        Execute Egate Command    ue_pdu_session_setup ue=${ue_id} pdu=1 nwslice=1 gw=1    pass_regexp=Initial Context Setup Successful
        ...    timeout=20s    sleep_time=5
        #UE PeriodicUeMeas Config    ue_id=${ue_id}    source_carrierfreq=${source_carrierfreq}
        #UE Start Trf    ue_id=${ue_id}
	END

UE Attach And Waiting L3 Call OK
    [Arguments]    ${ue_id}=1    ${cell_id}=2
    BuiltIn.Log    UE${ue_id} Attach And Waiting L3 Call OK...    console=${True}
    Execute Egate Command    ue_enb_param id=${ue_id} ue_history_list=1
    Execute Egate Command    ue_change_location id=${ue_id} enb=2 cell=${cell_id}
    Execute Egate Command    ue_register id=${ue_id}    pass_regexp=Received REGISTRATION COMPLETE
    Execute Egate Command    set_pdu_param ue=${ue_id} pdu=1 trf_type=internal
    Execute Egate Command    ue_pdu_session_setup ue=${ue_id} pdu=1 nwslice=1 gw=1    pass_regexp=Initial Context Setup Successful    timeout=20s
    ...    sleep_time=5
    #UE PeriodicUeMeas Config    ue_id=${ue_id}    source_carrierfreq=${source_carrierfreq}
    UE Start Trf    ue_id=${ue_id}

UE PeriodicUeMeas Config
    [Arguments]    ${ue_id}=1    ${source_carrierfreq}=635616
    BuiltIn.Log    UE${ue_id} PeriodicUeMeas Config...    console=${True}
    ${Periodical_meas_id}=    Get Nr Meas Id For Specific Type And Frequency    ue_id=${ue_id}    carrierfreq=${source_carrierfreq}
    ...    event_type=Periodical
    Should Not Be Empty    ${Periodical_meas_id}
    ${cmd}     Catenate    ue_measurement_send_nr id=${ue_id} meas_id=${Periodical_meas_id} report_type=periodical
    ...    srsrp_nr=${ue_id} srsrq_nr=30 ssinr_nr=30 srs_result=0:50:50:50
    Execute Egate Command    ${cmd}    pass_regexp=For Periodic MeasId = .* MeasReportQuantity from RRC-reconfiguration

UE Start Trf
    [Documentation]
    ...    Max Throughput For each Cell:
    ...    NRCELLGRP      NRCELL      DL tput       UL tput
    ...    NRCELLGRP-0    NRCELL-1    92.2 Mbps     67.2 Mbps
    ...    NRCELLGRP-1    NRCELL-2    131.8 Mbps    34.0 Mbps
    ...    NRCELLGRP-2    NRCELL-3    92.6 Mbps     67.2 Mbps
