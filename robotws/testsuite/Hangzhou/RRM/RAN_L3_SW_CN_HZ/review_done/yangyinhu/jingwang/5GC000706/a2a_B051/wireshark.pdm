[Global]
RELATION: CP1&CP2&CP3&CP4&CP5
BLOCKSIZE: -1

[CP1]
# Check UE-capability received IndependentGap from context setup request
# filter: nr-rrc.independentGapConfig == 0 and f1ap.procedureCode == 5
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 5
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.CUtoDURRCInformation.uE-CapabilityRAT-ContainerList.UE-CapabilityRAT-ContainerList.Item 0.UE-CapabilityRAT-Container.ue-CapabilityRAT-Container.UE-NR-Capability.measAndMobParameters.measAndMobParametersCommon.independentGapConfig = 0

# Check PDU session in ICS Response
# filter: ngap.NGAP_PDU == 1 and ngap.pDUSessionID == 1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.InitialContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtRes.Item 0.PDUSessionResourceSetupItemCxtRes.pDUSessionID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU = 1

[CP2]
# Check measurementReport A2 MeaID 1
# filter: f1ap.procedureCode == 13 and nr-rrc.c1 == 0 and nr-rrc.measId == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 13
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measId = 1

# Check measurementReport A3 MeaID 4
# filter: f1ap.procedureCode == 13 and nr-rrc.c1 == 0 and nr-rrc.measId == 4
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 13
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.11  ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.11  ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measId = 4

# Check Handover Request and Acknowledge
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest = *

ethernet.ip.sctp
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.procedureCode = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge = *

[CP3]
# Check DRX setup in RRC reconfiguration
# filter: nr-rrc.drx_Config == 1 and f1ap.procedureCode == 5 and nr-rrc.milliSeconds == 0 and nr-rrc.drx-InactivityTimer == 0 and nr-rrc.drx_HARQ_RTT_TimerDL == 0 and nr-rrc.drx_HARQ_RTT_TimerUL == 0  nr-rrc.drx_RetransmissionTimerDL == 0 and nr-rrc.drx_RetransmissionTimerUL == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 5
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-onDurationTimer.milliSeconds = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-InactivityTimer = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-HARQ-RTT-TimerDL = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-HARQ-RTT-TimerUL = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-RetransmissionTimerDL = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-RetransmissionTimerUL = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-LongCycleStartOffset = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-SlotOffset = 0

[CP4]
#Check DRX release after A2 in RRC reconfiguration
# filter: f1ap.procedureCode == 5 and nr-rrc.drx_Config == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 5

[CP5]
# Check gap FR1 setup in RRCReconfiguration
# filter: f1ap.procedureCode == 12 and nr-rrc.gapFR1 == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 12
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapFR1 = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapFR1.setup.gapOffset = 8
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapFR1.setup.mgl = 5
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapFR1.setup.mgrp = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapFR1.setup.mgta = 2



