[Global]
RELATION: CP1 & CP2
BLOCKSIZE: -1

[CP1]
# Analysis Wireshark Log For HO

# "{MeasConfig}" x2ap.X2AP_PDU == 1 && x2ap.procedureCode == 27 && nr-rrc.physCellId == 50 && nsetapx.nodeType == 0
# {value} = 137667 267.206376     10.0.1.2 → 10.42.188.191 X2AP 754 SgNBAdditionRequestAcknowledge, RRC Reconfiguration
# "{MeasConfig1}" x2ap.X2AP_PDU == 1 && x2ap.procedureCode == 27 && nr-rrc.srb_Identity == 3 && nsetapx.nodeType == 0
# {value} = 137667 267.206376     10.0.1.2 → 10.42.188.191 X2AP 754 SgNBAdditionRequestAcknowledge, RRC Reconfiguration
# ===================Msg: 1 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequestAcknowledge
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.rlc-BearerToAddModList.Item 1.RLC-BearerConfig.servedRadioBearer.srb-Identity = 3
    ethernet.ip.sctp.x2ap.procedure_code = 27

# "{MeasReport}" nsetapx.asn1_MsgId == 23
# {value} = 160550 319.585111     10.0.1.2 → 10.42.188.191 NR RRC 141 Measurement Report

# "{MeasConfig2}" f1ap.F1AP_PDU == 0 && f1ap.procedureCode == 7 && nr-rrc.srb_Identity == 3
# {value} = 160585 319.588126 fd5f:4268:2387:a881:40:43ff:fe80:1084 fd5f:4268:2387:a881:40:43ff:fe80:1085 F1AP 168 UEContextModificationRequest, RRC Reconfiguration
# ===================Msg: 2904 start================
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.sourceConfigSCG.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.rlc-BearerToAddModList.Item 1.RLC-BearerConfig.servedRadioBearer.srb-Identity = 3
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 7

[CP2]
# Analysis Wireshark Log For C_RNTI, C-RNTI is expected to be changed.
# ===================Msg: 1775 start================
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 3 = id-C-RNTI
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 3.ProtocolIE-Field.value.C-RNTI = ${newUE_Identity}

# ===================Msg: 2923 start================
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 4 = id-C-RNTI
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 4.ProtocolIE-Field.value.C-RNTI = ${newUE_Identity_After_HO}
