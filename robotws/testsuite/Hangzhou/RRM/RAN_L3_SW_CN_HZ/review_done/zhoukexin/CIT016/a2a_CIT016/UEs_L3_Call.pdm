[Global]
RELATION: CP1&CP2&CP3
BLOCKSIZE: -1

[CP1]
#unlock cell1 checking GNBDUConfigurationUpdate
ethernet.ipv6.sctp.f1ap    
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Served-Cells-To-Add-List.Item 0.ProtocolIE-SingleContainer.value.Served-Cells-To-Add-Item.gNB-DU-System-Information.mIB-message.MIB.intraFreqReselection = 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.GNBDUConfigurationUpdateAcknowledge.protocolIEs.Item 0 = id-TransactionID

ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Served-Cells-To-Modify-List.Item 0.ProtocolIE-SingleContainer.value.Served-Cells-To-Modify-Item.gNB-DU-System-Information.mIB-message.MIB.intraFreqReselection = 0
ethernet.ipv6.sctp.f1ap    
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.GNBDUConfigurationUpdateAcknowledge.protocolIEs.Item 0 = id-TransactionID

[CP2]
#Checking endcConfigurationUpdate
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = ENDCConfigurationUpdate
ethernet.ip.sctp.x2ap	
    ethernet.ip.sctp.x2ap.value = ENDCConfigurationUpdateAcknowledge
	
[CP3]	
#configured A3 rsrp + Non srb3 + CBRA in UEContextSetupRequest
ethernet.ipv6.sctp.f1ap
   ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.ssbFrequency = 636576
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 2
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA3.a3-Offset.rsrp = 10
	



