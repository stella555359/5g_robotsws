[Global]
RELATION: CP1 & CP2 & CP3 & CP4 & CP5
BlOCKSIZE: -1

[CP1]
#Xn setup
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.XnSetupRequest = *
ethernet.ip.sctp.xnap
	ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.XnSetupResponse = *
	
[CP2]
#x2 setup
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = ENDCX2SetupResponse
	
[CP3]
#F1 setup
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.F1SetupRequest = *
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.F1SetupResponse = *

[CP4]
#E1 setup
ethernet.ipv6.sctp.e1ap
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.GNB-CU-UP-E1SetupRequest = *
ethernet.ipv6.sctp.e1ap
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.GNB-CU-UP-E1SetupResponse = *
	
[CP5]
#NG setup
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGSetupRequest = *
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse = *
