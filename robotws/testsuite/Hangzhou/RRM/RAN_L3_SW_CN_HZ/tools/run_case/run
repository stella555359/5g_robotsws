#! /bin/bash
# (1) get input
case_path=$1
exec_date=$(date "+%Y.%m.%d.%H%M%S")
#exec_date='2021.11.08.015233'

# (2) get tool path
run_case_path=$(pwd)

echo -n '\n\n\n\n\n###########################################################################\n'
ps -ef | grep python | grep -v grep | cut -c 9-15 | sudo xargs kill -9
cd /home/ute
echo -n 'current ptah:'
pwd
sleep 1

# (3) swtich to <test_repo> ENV, only /bin/bash have source /bin/sh not have
source /home/ute/test_repo/bin/activate
echo 'exec source to <test_repo> ENV successful'
sleep 1

# (4) run robot
robot -L trace $1 > ${run_case_path}/${exec_date}_run.log 2>&1 &
echo 'exec robot successful'

# (5) save logs
echo 'log was in:'${run_case_path}''${exec_date}'_run.log'
echo -n '###########################################################################\n\n'
sleep 1
tail -200f ${run_case_path}/${exec_date}_run.log
