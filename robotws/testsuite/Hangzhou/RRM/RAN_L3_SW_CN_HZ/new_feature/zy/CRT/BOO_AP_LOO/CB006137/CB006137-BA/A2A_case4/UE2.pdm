[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#dlToUlContributionRatio is 100, ulDlDataSlotRatio is 1/4
#cell11: FDD N66,20M,
#cell13: FDD N66,30M,
#cell1: TDD N41,60M,
#cell2: TDD N78,80M
#UE-2: N71*a-N66a-N66a; N71*a-N41a*; N71a*-N78a*;   *means UL capability
#according to algorithm N71a*-N78a* is selected  TDD Cell-2 as DL/UL Scell
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = ${Cell2_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell2_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.scs-SpecificCarrierList.None.carrierBandwidth = ${Cell2_carrierBandwidth}
