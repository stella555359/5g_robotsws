[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#dlToUlContributionRatio is 80
#UE1/2 capability: N71*a-N66a-N66a, N71a*-N78a*; for N78 ChannelBWs-UL rightmost bit set to 0; UL 80M not supported
#attach UE1 and create PDU session, send A1 RSRP< a1ThresholdSCellAddSsbRsrpTDD,FDD Cell-13 and FDD Cell-11 as DL Scell configured
#send A1 RSRP > a1ThresholdSCellAddSsbRsrpTDD, Scell change to TDD Cell-2 as DL scell with full BWP
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell2_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = ${Cell2_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.scs-SpecificCarrierList.None.carrierBandwidth = ${Cell2_carrierBandwidth}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.downlinkBWP-ToAddModList.None.bwp-Common.genericParameters.locationAndBandwidth = ${cell2_large_BWP}