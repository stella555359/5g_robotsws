[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#UE-2: TDD cell-3 add as DL&UL scell

DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = ${Cell3_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.41 = 41
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.scs-SpecificCarrierList.None.carrierBandwidth = ${TDD_PRB_for_30M}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.scs-SpecificCarrierList.None.carrierBandwidth = ${TDD_PRB_for_30M}

