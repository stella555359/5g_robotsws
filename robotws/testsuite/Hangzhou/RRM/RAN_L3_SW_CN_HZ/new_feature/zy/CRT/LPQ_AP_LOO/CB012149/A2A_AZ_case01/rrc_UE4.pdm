[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
# 1:check ultxswitch capability query
DL-DCCH-Message
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.CONTAINING.capabilityRequestFilterCommon.uplinkTxSwitchRequest-r16 = true
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.ue-CapabilityEnquiryExt = ue-CapabilityEnquiryExt
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.ue-CapabilityRAT-RequestList.None.rat-Type = nr

# 2:Scell_Addition by A161 > a1ThresholdSCellAddSsbRsrpTDD
#   ->index 4 / normal BC#4: N41a*-N66a*-N78a=9125000 / 16385+16397*+16386
#   scell1 CELL2(PCI 51)
#   scell2 CELL13(PCI 60) with ul
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellIndex = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 51
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellIndex = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = 60
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup.maxRank = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup_1.srs-ResourceToAddModList.None.nrofSRS-Ports = port1
