[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#UE-1:N71*a-N41a*,N71*a-N66a;supportedBandCombinationList-BandCombination.powerClass-v1530=pc2 p-NR-FR1 is 26db
#scell change from FDD to TDD,TDD Cell-1 as DL/UL Scell.
#UE-1:pMaxUeCapFr1:ue-PowerClass pc3 for FDD band,ue-PowerClass pc2 for TDD band pmax:pcell:20 scell:26
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = ${Cell1_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell1_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.scs-SpecificCarrierList.None.carrierBandwidth = ${Cell1_carrierBandwidth}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.p-Max = 26
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.physicalCellGroupConfig.p-NR-FR1 = 26