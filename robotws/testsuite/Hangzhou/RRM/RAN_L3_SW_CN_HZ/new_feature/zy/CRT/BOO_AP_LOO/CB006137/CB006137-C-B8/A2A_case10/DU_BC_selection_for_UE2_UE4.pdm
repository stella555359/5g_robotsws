[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#UE-2 and UE-4: CPCL send BC1: FS1 and BC2: FS1 to CPRT in UEContextModificationRequest for scell addition
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.configRestrictInfo.allowedBC-ListMRDC = 2 items
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.configRestrictInfo.allowedBC-ListMRDC.Item 0.BandCombinationInfo.bandCombinationIndex = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.configRestrictInfo.allowedBC-ListMRDC.Item 1.BandCombinationInfo.bandCombinationIndex = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.configRestrictInfo.allowedBC-ListMRDC.Item 1.BandCombinationInfo.allowedFeatureSetsList.Item 0.FeatureSetEntryIndex = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.configRestrictInfo.allowedBC-ListMRDC.Item 0.BandCombinationInfo.allowedFeatureSetsList.Item 0.FeatureSetEntryIndex = 1

#UE-1 and UE-3: CPRT selected BC2:FS1 for scell addition in UEContextModificationResponse
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.SelectedBandCombinationIndex = 0001
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.iE-Extensions.Item 1.ProtocolExtensionField.extensionValue.SelectedFeatureSetEntryIndex = 00

