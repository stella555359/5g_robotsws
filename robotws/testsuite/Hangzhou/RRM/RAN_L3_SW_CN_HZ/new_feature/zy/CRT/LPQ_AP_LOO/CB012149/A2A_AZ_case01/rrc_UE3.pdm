[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
# 1:check ultxswitch capability query
DL-DCCH-Message
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.CONTAINING.capabilityRequestFilterCommon.uplinkTxSwitchRequest-r16 = true
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.ue-CapabilityEnquiryExt = ue-CapabilityEnquiryExt
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.ue-CapabilityRAT-RequestList.None.rat-Type = nr

# 2:Scell_Addition by A1=51 > a1ThresholdSCellAddSsbRsrpFDD
#   ->index 8 / ultxswitch BC#4: N41a*-N66a*-N66a*=8500000 / 16385+16397*+16395

#   scell1 CELL11(PCI 60)
#   scell2 CELL13(PCI 62) with ul
#81817 active, change to be:
#   ->index 6 / ultxswitch BC#2: N41a*-N66a*-N71a*-N71a=8500000 / 16385+16395*+16396+16398
#   scell1 CELL11(PCI 61) with ul
#   scell2 CELL13(PCI 62)
#   scell3 CELL13(PCI 63)
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup_1.maxRank = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup_2.srs-ResourceToAddModList.None.nrofSRS-Ports = ports2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingPeriodLocation-r16 = FALSE
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingCarrier-r16 = carrier2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellIndex = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 61
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellIndex = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = 62
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_2.sCellIndex = 3
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_2.sCellConfigCommon.physCellId = 63
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup.maxRank = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup_1.srs-ResourceToAddModList.None.nrofSRS-Ports = port1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingPeriodLocation-r16 = TRUE
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingCarrier-r16 = carrier1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.uplinkTxSwitchingOption-r16 = switchedUL

# 3:online change ulTxSwitchingBoost=11

# 4:scell release
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkTxSwitching-r16_release = NULL
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToReleaseList.1 = 1

DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToReleaseList.2 = 2

UL-DCCH-Message
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None_1.measResultServingCell.physCellId = 63
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None_1.servCellId = 3

# 5:Scell_Addition by A1=61 > a1ThresholdSCellAddSsbRsrpTDD
#   ->index 4 / normal BC#4: N41a*-N66a*-N78a=8083300 / 16385+16395*+16386
#   scell1 CELL2(PCI 51)
#   scell2 CELL11(PCI 62) with ul
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellIndex = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 51
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellIndex = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = 62
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup.maxRank = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup_1.srs-ResourceToAddModList.None.nrofSRS-Ports = port1
