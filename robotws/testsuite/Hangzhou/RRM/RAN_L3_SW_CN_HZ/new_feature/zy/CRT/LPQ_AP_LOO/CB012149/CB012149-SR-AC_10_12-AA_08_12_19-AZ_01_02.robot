    UE Report InterFrequency A2 event    ue_id=1    carrierfreq=${Cell2_ssbFrequency}
    UE Report InterFrequency A3 event    ue_id=1    carrierfreq=${Cell1_ssbFrequency}    phycell_id=50

UE Report InterFrequency A2 event
    [Arguments]    ${ue_id}=1    ${carrierfreq}=${Cell1_ssbFrequency}    ${srsrp_nr}=34    ${srsrq_nr}=20
    ${measid}=    Get Nr Meas Id For Specific Type And Frequency    ue_id=${ue_id}    carrierfreq=${carrierfreq}    event_type=A2
    ${ret3}=    Execute Egate Command    ue_measurement_send_nr id=${ue_id} meas_id=${measid} event=A2 srsrp_nr=${srsrp_nr} srsrq_nr=${srsrq_nr}
    ...    pass_regexp=eventA3

UE Report InterFrequency A3 event
    [Arguments]    ${ue_id}=1    ${carrierfreq}=${Cell1_ssbFrequency}    ${srsrp_nr}=34    ${srsrq_nr}=20
    ...    ${phycell_id}=61    ${nrsrp_nr}=75    ${nrsrq_nr}=75
    ${measid}=    Get Nr Meas Id For Specific Type And Frequency    ue_id=${ue_id}    carrierfreq=${carrierfreq}    event_type=A3
    ${command}    Catenate    ue_measurement_send_nr id=${ue_id} meas_id=${measid} event=A3 srsrp_nr=${srsrp_nr}
    ...    srsrq_nr=${srsrq_nr} phycell_id=${phycell_id} nrsrp_nr=${nrsrp_nr} nrsrq_nr=${nrsrq_nr}
    ${ret3}=    Execute Egate Command
    ...    ${command}
    ...    pass_regexp=rrcReconfigurationComplete

Start Data
    [Arguments]    ${ue_id}
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=175 trf_id=1    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=175 trf_id=2    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=175 trf_id=3    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=175 trf_id=4    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=175 trf_id=5    UE ${ue_id}: UDP DL
    sleep    30s    #sleep for stable traffic

Stop Data
    [Arguments]    ${ue_id}
    Run Keywords    Execute Egate Command    trf_data_stop ue=${ue_id} pdu=1 qfi=1 trf_id=1
    ...    pass_regexp=Traffic was stopped
    ...    AND    Execute Egate Command    trf_data_stop ue=${ue_id} pdu=1 qfi=1 trf_id=2
    ...    pass_regexp=Traffic was stopped
    ...    AND    Execute Egate Command    trf_data_stop ue=${ue_id} pdu=1 qfi=1 trf_id=3
    ...    pass_regexp=Traffic was stopped
    ...    AND    Execute Egate Command    trf_data_stop ue=${ue_id} pdu=1 qfi=1 trf_id=4
    ...    pass_regexp=Traffic was stopped
    ...    AND    Execute Egate Command    trf_data_stop ue=${ue_id} pdu=1 qfi=1 trf_id=5
    ...    pass_regexp=Traffic was stopped

Trigger Scell Addition By A1
    [Arguments]    ${ue_id}    ${srsrp_nr}
    ${measid}=    Get Nr Meas Id For Specific Type And Frequency    ue_id=${ue_id}    carrierfreq=${Cell1_ssbFrequency}    event_type=A1
    Execute Egate Command    ue_measurement_send_nr id=${ue_id} meas_id=${measid} event=A1 srsrp_nr=${srsrp_nr} ssinr_nr=59 srsrq_nr=32
    ...    pass_regexp=rrcReconfigurationComplete

Trigger Scell Addition By A1 And Data
    [Arguments]    ${ue_id}    ${srsrp_nr}
    Start Data    ue_id=${ue_id}
    Trigger Scell Addition By A1    ue_id=${ue_id}    srsrp_nr=${srsrp_nr}

UE Register And Setup PDU Session
    [Arguments]    ${ue_id}    ${ue_capa}
    Execute Egate Command    ue_change_location id=${ue_id} enb=2 cell=1
    Execute Egate Command    ue_register id=${ue_id} ue_nr_capabilities=${ue_capa}    UE now in NG RM Register
    Execute Egate Command    set_pdu_param ue=${ue_id} pdu=1 trf_type=internal
    Execute Egate Command    ue_pdu_session_setup ue=${ue_id} pdu=1 gw=1 nwslice=1    QoS Routing Table

UE Deregister
    [Arguments]    ${ue_id}
    Execute Egate Command    ue_deregister id=${ue_id} ue_deregister_type=switch_off    UE${ue_id}: detached    timeout=10s

UE Register Setup PDU Trigger Scell Addition By A1
    [Arguments]    ${ue_capa}    ${ue_id}    ${srsrp_nr}
    UE Register And Setup PDU Session    ue_id=${ue_id}    ue_capa=${ue_capa}
    Trigger Scell Addition By A1    ue_id=${ue_id}    srsrp_nr=${srsrp_nr}

UE Register Setup PDU Trigger Scell Addition By A1 Then Deregister
    [Arguments]    ${ue_capa}    ${ue_id}    ${srsrp_nr}
    UE Register And Setup PDU Session    ue_id=${ue_id}    ue_capa=${ue_capa}
    Trigger Scell Addition By A1    ue_id=${ue_id}    srsrp_nr=${srsrp_nr}
    UE Deregister    ue_id=${ue_id}

UE Register Setup PDU Trigger Scell Addition By A1 And Data
    [Arguments]    ${ue_capa}    ${ue_id}    ${srsrp_nr}
    UE Register And Setup PDU Session    ue_id=${ue_id}    ue_capa=${ue_capa}
    Trigger Scell Addition By A1 And Data    ue_id=${ue_id}    srsrp_nr=${srsrp_nr}

Scell Release After Timer Expired
    [Arguments]    ${ue_id}
    Stop Data    ue_id=${ue_id}
    ${ret}=    Execute Egate Command    ue_disp id=${ue_id}    pass_regexp=${Scell_Release_After_Timer_Expired}
    ...    timeout=${${sCellInactivityReleaseTimer}+2}
    should not contain    ${ret}    maxRank
    should not contain    ${ret}    nrofSRS-Ports
    should not contain    ${ret}    uplinkTxSwitching-r16
    should not contain    ${ret}    uplinkTxSwitchingOption-r16

Scell 1 Release By RLQ
    [Arguments]    ${ue_id}
    Execute Egate Command    bler_testmode_nr profile_id=2 target_mcs=0 num_dl_pkts=10000
    ...    pass_regexp=CTRL_AP_TEST_BLER_NR
    ${cmd}    Catenate    ue_testmode_set_nr id=${ue_id} scell=1 testmode=bler action=activate profile_id=2
    ${ret}=    Execute Egate Command    ${cmd}    pass_regexp=${Scell_1_Release_By_RLQ}
    should not contain    ${ret}    maxRank
    should not contain    ${ret}    nrofSRS-Ports

Scell 2 Release By RLQ
    [Arguments]    ${ue_id}
    Execute Egate Command    bler_testmode_nr profile_id=2 target_mcs=0 num_dl_pkts=10000
    ...    pass_regexp=CTRL_AP_TEST_BLER_NR
    ${cmd}    Catenate    ue_testmode_set_nr id=${ue_id} scell=2 testmode=bler action=activate profile_id=2
    ${ret}=    Execute Egate Command    ${cmd}    pass_regexp=${Scell_2_Release_By_RLQ}
    should not contain    ${ret}    uplinkTxSwitchingOption-r16 switchedUL

Recover scell bad RLQ
    [Arguments]    ${profile_id}=2    ${ue_id}=1
    Execute Egate Command    ue_testmode_set_nr id=${ue_id} scell=1 testmode=bler action=deactivate profile_id=${profile_id}
    ...    pass_regexp=CTRL_AP_UE_TESTMODE_SET_NR
    Execute Egate Command    ue_testmode_set_nr id=${ue_id} scell=2 testmode=bler action=deactivate profile_id=${profile_id}
    ...    pass_regexp=CTRL_AP_UE_TESTMODE_SET_NR
    Execute Egate Command    bler_testmode_nr delete=true profile_id=${profile_id}
    ...    pass_regexp=CTRL_AP_TEST_BLER_NR

Make UE optimised ICS
    [Arguments]    ${ue_id}    ${ue_capabilities}
    Execute Egate Command    amf_ue_ics_param id=1 ue=${ue_id} include_ue_capabilities=on ue_capabilities=${ue_capabilities}

Trigger Scell Release By A2
    [Arguments]    ${ue_id}    ${scell}    ${scell_rsrp}    ${carrierfreq}
    ${measid}=    Get Nr Meas Id For Specific Type And Frequency    ue_id=${ue_id}    carrierfreq=${carrierfreq}
    ...    event_type=A2
    Execute Egate Command    ue_measurement_send_nr id=${ue_id} meas_id=${measid} event=A2 scell=${scell} scell_rsrp=${scell_rsrp} scell_rsrq=0
    ...    pass_regexp=rrcReconfigurationComplete

UE3 Scell Release By A2
    [Arguments]    ${ssbF_1}    ${ssbF_2}
    Trigger Scell Release By A2    ue_id=3    scell=1    scell_rsrp=39    carrierfreq=${ssbF_1}
    Trigger Scell Release By A2    ue_id=3    scell=2    scell_rsrp=39    carrierfreq=${ssbF_2}

UE3 3 Scell Release By A2
    [Arguments]    ${ssbF_1}    ${ssbF_2}    ${ssbF_3}
    Trigger Scell Release By A2    ue_id=3    scell=1    scell_rsrp=39    carrierfreq=${ssbF_1}
    Trigger Scell Release By A2    ue_id=3    scell=2    scell_rsrp=39    carrierfreq=${ssbF_2}
    Trigger Scell Release By A2    ue_id=3    scell=3    scell_rsrp=39    carrierfreq=${ssbF_3}
