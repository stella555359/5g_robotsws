[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#when NG link is dropped, F1AP sends reset info
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    arrival_time=_x

#NRCell is to be barred
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Cells-to-be-Barred-List.Item 0.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.cellBarred = 0
    arrival_time=x+30~x+31