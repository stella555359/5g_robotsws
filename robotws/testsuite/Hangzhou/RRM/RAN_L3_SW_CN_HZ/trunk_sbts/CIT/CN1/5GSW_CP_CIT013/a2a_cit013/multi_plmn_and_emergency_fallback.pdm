[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
# CIT013
#UE1 is registered and check plmn=311:489
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.value.RAN-UE-NGAP-ID = ${RAN_UE1_NGAP_ID}
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.value.GUAMI.pLMNIdentity = 134198

#UE2 is registered and check plmn=311:489
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.value.RAN-UE-NGAP-ID = ${RAN_UE2_NGAP_ID}
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.value.GUAMI.pLMNIdentity = 134198

#UE3 is registered and check plmn=311:402
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.value.RAN-UE-NGAP-ID = ${RAN_UE3_NGAP_ID}
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.value.GUAMI.pLMNIdentity = 134120

# CIT008
##check establishmentCause is emergency in rrcSetupRequest
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcSetupRequest.rrcSetupRequest.establishmentCause = 0

##check  Service type is Emergency services fallback (4) in NAS Service Request
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialUEMessage.protocolIEs.ProtocolIE-Field.value.NAS-PDU.Non-Access-Stratum 5GS (NAS)PDU.Plain NAS 5GS Message.Service type.Service type = 4

##check emergencyServiceTargetCN is epc (1)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.id = 24
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.value.EmergencyFallbackIndicator.emergencyServiceTargetCN = 1

#check FreqBandIndicatorEUTRA in UERadioCapability
ethernet.ip.sctp.ngap
   ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UERadioCapabilityInfoIndication.protocolIEs.ProtocolIE-Field.value.UERadioCapability.UERadioAccessCapabilityInformation.criticalExtensions.c1.ueRadioAccessCapabilityInformation.ue-RadioAccessCapabilityInfo.UE-CapabilityRAT-ContainerList.UE-CapabilityRAT-Container.ue-CapabilityRAT-Container.UE-NR-Capability.nonCriticalExtension.interRAT-Parameters.eutra.supportedBandListEUTRA.FreqBandIndicatorEUTRA = 3

##check eutraFrequency in rrcRelease
ethernet.ipv6.sctp.f1ap
   ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.redirectedCarrierInfo.eutra.eutraFrequency = 1300