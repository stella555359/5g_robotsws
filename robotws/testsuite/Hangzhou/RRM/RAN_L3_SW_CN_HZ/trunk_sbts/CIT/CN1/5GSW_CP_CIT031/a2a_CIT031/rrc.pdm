[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#Ue_Ho_To_target_gNB_Cell1, check scell release,measurement gap release and drx setup 
DL-DCCH-Message
    DL-DCCH-Message.rrcConnectionReconfiguration.rrcConnectionReconfiguration-r8.measConfig.setup.gapOffset_gp0 = 12

RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.CONTAINING.mac-CellGroupConfig.drx-Config_release = NULL

RRCReconfiguration	
    RRCReconfiguration.rrcReconfiguration.CONTAINING.sCellToReleaseList.9 = 9

DL-DCCH-Message
    DL-DCCH-Message.rrcConnectionReconfiguration.rrcConnectionReconfiguration-r8.measConfig.measGapConfig_release = NULL

RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.CONTAINING.mac-CellGroupConfig.setup.drx-SlotOffset = 0
	
#Add_gNB_Cell2_As_Scell_By_A1 and add pci51 as scell
RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 51
    RRCReconfiguration.rrcReconfiguration.CONTAINING.sCellToAddModList.None.sCellIndex = 9


#Ue_Ho_Back_target_gNB_Cell1, check scell release,measurement gap release and drx setup 
DL-DCCH-Message
    DL-DCCH-Message.rrcConnectionReconfiguration.rrcConnectionReconfiguration-r8.measConfig.setup.gapOffset_gp0 = 12

RRCReconfiguration	
    RRCReconfiguration.rrcReconfiguration.CONTAINING.mac-CellGroupConfig.drx-Config_release = NULL	
		
RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.CONTAINING.sCellToReleaseList.9 = 9
	
DL-DCCH-Message
    DL-DCCH-Message.rrcConnectionReconfiguration.rrcConnectionReconfiguration-r8.measConfig.measGapConfig_release = NULL

RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.CONTAINING.mac-CellGroupConfig.setup.drx-SlotOffset = 0

#Add_gNB_Cell1_As_Scell_By_A1, add pci50 as scell
RRCReconfiguration
	RRCReconfiguration.rrcReconfiguration.CONTAINING.sCellToAddModList.None.sCellIndex = 9
	RRCReconfiguration.rrcReconfiguration.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 50

#Release_gNB_Cell1_Scell_By_A2, A2 release Scell
RRCReconfiguration
	RRCReconfiguration.rrcReconfiguration.CONTAINING.sCellToReleaseList.9 = 9