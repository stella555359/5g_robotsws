[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#SgNBAdditionRequest
X2AP-PDU
    X2AP-PDU.SgNBAdditionRequest.protocolIEs.None_5.E-RABs-ToBeAdded-SgNBAddReqList.None.E-RABs-ToBeAdded-SgNBAddReq-Item.e-RAB-ID = 5
    X2AP-PDU.SgNBAdditionRequest.protocolIEs.None_5.E-RABs-ToBeAdded-SgNBAddReqList.None.E-RABs-ToBeAdded-SgNBAddReq-Item.drb-ID = 4

#SgNBAdditionRequestAcknowledge
X2AP-PDU
    X2AP-PDU.SgNBAdditionRequestAcknowledge.protocolIEs.None_2.E-RABs-Admitted-ToBeAdded-SgNBAddReqAckList.None.E-RABs-Admitted-ToBeAdded-SgNBAddReqAck-Item.e-RAB-ID = 5

#RRCReconfiguration
RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectId = 1
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigId = 1
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.timeToTrigger = ms480
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.measId = 1
    RRCReconfiguration.rrcReconfiguration.CONTAINING.spCellConfig.servCellIndex = 8
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.measObjectId = 1
    RRCReconfiguration.rrcReconfiguration.CONTAINING.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.78 = 78
    RRCReconfiguration.rrcReconfiguration.CONTAINING.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = 636576
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.hysteresis = 0
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.a2-Threshold_rsrp = 34
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.reportConfigId = 1
    RRCReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.freqBandIndicatorNR = 78

#Trigger A2 Measurement Report,gNB send SgNBModificationRequired
X2AP-PDU
    X2AP-PDU.SgNBModificationRequired.protocolIEs.None_2.value_Cause = : radioNetwork : rRM-purpose

# A2 rrcReconfiguration
RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA1.timeToTrigger = ms480
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA5.a5-Threshold1_rsrp = 10
    RRCReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectId = 2
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.reportConfigId = 2
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.measObjectId = 1
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigId = 3
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA5.a5-Threshold2_rsrp = 30
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA5.hysteresis = 0
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_1.measId = 3
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA1.a1-Threshold_rsrp = 36
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigId = 2
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_1.reportConfigId = 3
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA5.timeToTrigger = ms0
    RRCReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.ssbFrequency = 2071387
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_1.measObjectId = 2

# A2 Measurement Report successfully
X2AP-PDU
    X2AP-PDU.SgNBModificationConfirm.protocolIEs.None.value_UE-X2AP-ID = 1
    X2AP-PDU.SgNBModificationConfirm.protocolIEs.None_1.value_SgNB-UE-X2AP-ID = 0

#Trigger A5 Measurement Report
X2AP-PDU
    X2AP-PDU.SgNBChangeRequired.protocolIEs.None_3.value_Cause = : radioNetwork : action-desirable-for-radio-reasons

# After Trigger A5 Measurement Report start new AdditionRequest Procedure
X2AP-PDU
    X2AP-PDU.SgNBAdditionRequest.protocolIEs.None_5.E-RABs-ToBeAdded-SgNBAddReqList.None.E-RABs-ToBeAdded-SgNBAddReq-Item.e-RAB-ID = 5
    X2AP-PDU.SgNBAdditionRequest.protocolIEs.None_5.E-RABs-ToBeAdded-SgNBAddReqList.None.E-RABs-ToBeAdded-SgNBAddReq-Item.drb-ID = 4

#SgNBAdditionRequestAcknowledge
X2AP-PDU
    X2AP-PDU.SgNBAdditionRequestAcknowledge.protocolIEs.None_2.E-RABs-Admitted-ToBeAdded-SgNBAddReqAckList.None.E-RABs-Admitted-ToBeAdded-SgNBAddReqAck-Item.e-RAB-ID = 5

#A5 rrcReconfiguration
RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.hysteresis = 0
    RRCReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.ssbFrequency = 636576
    RRCReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None_1.measObjectNR.freqBandIndicatorNR = 261
    RRCReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None_1.measObjectNR.ssbFrequency = 2071387
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.reportConfigId = 1
    RRCReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.freqBandIndicatorNR = 78
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA2.hysteresis = 0
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.measId = 1
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.a2-Threshold_rsrp = 8

#A5SgNBChangeConfirm
X2AP-PDU
    X2AP-PDU.SgNBChangeConfirm.protocolIEs.None_2.E-RABs-ToBeReleased-SgNBChaConfList.None.E-RABs-ToBeReleased-SgNBChaConf-Item.e-RAB-ID = 5


#on simulate gNB Trigger A2 Measurement Report
UL-DCCH-Message
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.servCellId = 8
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measId = 1
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.physCellId = 384

#A2 Measurement Report rrcReconfiguration event A5 in addModlist
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_10.measObjectId = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_10.reportConfigId = 5
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_10.measId = 11

#on simulate gNB Trigger A5 measurement report
X2AP-PDU 
    X2AP-PDU.SgNBChangeRequired.protocolIEs.None_3.value_Cause = : radioNetwork : action-desirable-for-radio-reasons

#SgNBAdditionRequest
X2AP-PDU
    X2AP-PDU.SgNBAdditionRequest.protocolIEs.None_5.E-RABs-ToBeAdded-SgNBAddReqList.None.E-RABs-ToBeAdded-SgNBAddReq-Item.e-RAB-ID = 5

#SgNBAdditionRequestAcknowledge
X2AP-PDU
    X2AP-PDU.SgNBAdditionRequestAcknowledge.protocolIEs.None_2.E-RABs-Admitted-ToBeAdded-SgNBAddReqAckList.None.E-RABs-Admitted-ToBeAdded-SgNBAddReqAck-Item.e-RAB-ID = 5

#RRCReconfiguration
RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigId = 7
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.timeToTrigger = ms480
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.measId = 7
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.measObjectId = 3
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.hysteresis = 0
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.a2-Threshold_rsrp = 34
    RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.reportConfigId = 7
