[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
#this loop is for srb3, and cell=381 is drx=disable; cell=50, cell=51 are drx=enable
#ue in cell=50 handover to cell=381 with drx=setup info (intra-freq inter-gnb ho, if drx is setup at beginning, target gnb will release the drx)

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBChangeRequired
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup = None

ethernet.ip.sctp
    ethernet.ip.sctp.x2ap.value = UEContextRelease

#ue in cell=381 handover to cell=51, since 381 is simulate gnb, drx is disable, but cell=51 in real gnb is drx enable

ethernet.ip.sctp
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequest

ethernet.ip.sctp
    ethernet.ip.sctp.x2ap.value = SNStatusTransfer

ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup = None

#ue handover from cell=51 to cell=50 (intra-gnb ho, if drx is setup at beginning, release the drx before real ho)

ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config.release = NULL

ethernet.ip.sctp.x2ap
