[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#Verify addition successfully when UE supported both native band and alternative band on gNB,the native band will be selected
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequest
    ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.ue-CapabilityInfo.UE-CapabilityRAT-ContainerList.Item 0.UE-CapabilityRAT-Container.ue-CapabilityRAT-Container.UE-NR-Capability.rf-Parameters.supportedBandListNR.Item 0.BandNR.bandNR = 78
    ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.ue-CapabilityInfo.UE-CapabilityRAT-ContainerList.Item 0.UE-CapabilityRAT-Container.ue-CapabilityRAT-Container.UE-NR-Capability.rf-Parameters.supportedBandListNR.Item 1.BandNR.bandNR = 77
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequestAcknowledge
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 78

