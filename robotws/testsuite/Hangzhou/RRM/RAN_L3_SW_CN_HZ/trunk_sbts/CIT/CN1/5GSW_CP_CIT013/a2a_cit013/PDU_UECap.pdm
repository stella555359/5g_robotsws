[Global]
RELATION: CP1 | CP2
BlOCKSIZE: -1


[CP1]
##check UE Capacity id in InitialContextSetupRequest, id 117 means UE capacity
ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.id = 117
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.value.EmergencyFallbackIndicator.emergencyServiceTargetCN = 1

[CP2]
##check PDU session id in InitialContextSetupRequest, id 71 means pdu session
ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.id = 71
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.value.EmergencyFallbackIndicator.emergencyServiceTargetCN = 1
	

