[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
ethernet.ip.sctp.x2ap
    # SgNBAdditionRequestAcknowledge
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequestAcknowledge
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.rlc-BearerToAddModList.RLC-BearerConfig.servedRadioBearer.srb-Identity = 3
    #CFRA is n60
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.rach-ConfigCommon.setup.ssb-perRACH-OccasionAndCB-PreamblesPerSSB.one = 14

#HO from cell1 to cell2
ethernet.ip.sctp.f1ap
	ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 2.ProtocolIE-Field.value.SRBID = 3

#UEContextSetupRequest to target DU-2
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.NRCGI.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 0100  0000 0000  0010 .... decimal value 16386
	ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 5.ProtocolIE-Field.value.DRBs-ToBeSetup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-ToBeSetup-Item.dRBID = 4

#UEContextSetupResponse
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 4.ProtocolIE-Field.value.DRBs-Setup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-Setup-Item.dRBID = 4

ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.SRBID = 3

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequired

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationConfirm

#UEContextReleaseCommand
#radioNetwork:7(action-desirable-for-radio-reasons)
ethernet.ip.sctp.f1ap
	ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 7

## F1AP: UEContextReleaseComplete
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 1.ProtocolIE-Field.id = 41
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 6

ethernet.ip.sctp.f1ap
    # UEContextModificationResponse
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 51
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.rach-ConfigDedicated = 0

#HO from cell2 to cell1
ethernet.ip.sctp.f1ap
	ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 2.ProtocolIE-Field.value.SRBID = 3

#UEContextSetupRequest to target DU-2
ethernet.ip.sctp.f1ap
	ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.NRCGI.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 0100  0000 0000  0001 .... decimal value 16385
	ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 5.ProtocolIE-Field.value.DRBs-ToBeSetup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-ToBeSetup-Item.dRBID = 4

#UEContextSetupResponse
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 4.ProtocolIE-Field.value.DRBs-Setup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-Setup-Item.dRBID = 4

ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.SRBID = 3
	
#UEContextReleaseCommand
#radioNetwork:7(action-desirable-for-radio-reasons)
ethernet.ip.sctp.f1ap
	ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 7

## F1AP: UEContextReleaseComplete
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 1.ProtocolIE-Field.id = 41
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 6

ethernet.ip.sctp.f1ap
    # UEContextModificationResponse
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.rach-ConfigDedicated = 0
