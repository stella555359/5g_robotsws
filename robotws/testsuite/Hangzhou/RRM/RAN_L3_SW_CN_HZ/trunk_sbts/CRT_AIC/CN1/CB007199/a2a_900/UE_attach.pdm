[Global]
RELATION: CP1
BlOCKSIZE: -1
[CP1]
#NSA UE CALL
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequest
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequestAcknowledge
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBReconfigurationComplete
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SNStatusTransfer

#SA UE CALL
#rrc setup request
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcSetupRequest = *
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcSetupRequest.rrcSetupRequest.ue-Identity = 1
#rrc setup
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup.criticalExtensions = 0
#rrc Setup Complete
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcSetupComplete = None
#InitialUEMessage
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialUEMessage = *
#message-type = register complete
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkNASTransport.protocolIEs.ProtocolIE-Field.value.NAS-PDU.Non-Access-Stratum 5GS (NAS)PDU.Plain NAS 5GS Message.Message type = 0x43
#message-type = pdu session establishment request
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkNASTransport.protocolIEs.ProtocolIE-Field.value.NAS-PDU.Non-Access-Stratum 5GS (NAS)PDU.Plain NAS 5GS Message.Payload container.Plain NAS 5GS Message.Message type = 0xc1
#InitialContextSetupRequest
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest = *
#InitialContextSetupResponse
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.InitialContextSetupResponse = *
