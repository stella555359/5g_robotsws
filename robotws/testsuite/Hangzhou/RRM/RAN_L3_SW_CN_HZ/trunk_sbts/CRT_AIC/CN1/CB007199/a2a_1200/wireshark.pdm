[Global]

RELATION: CP1 | CP2

BlOCKSIZE: -1

[CP1]
#Verify BearerContextModificationRequired
ethernet.ip.sctp.e1ap
 ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequired.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequired.e-UTRAN-BearerContextModificationRequired.ProtocolIE-Field.value.DRB-Required-To-Modify-List-EUTRAN.DRB-Required-To-Modify-Item-EUTRAN.gNB-CU-UP-CellGroupRelatedConfiguration.GNB-CU-UP-CellGroupRelatedConfiguration-Item.cell-Group-ID = 1
 ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequired.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequired.e-UTRAN-BearerContextModificationRequired.ProtocolIE-Field.value.DRB-Required-To-Modify-List-EUTRAN.DRB-Required-To-Modify-Item-EUTRAN.gNB-CU-UP-CellGroupRelatedConfiguration.GNB-CU-UP-CellGroupRelatedConfiguration-Item.uL-Configuration = 0


#Verify SgNBModificationRequired, RRC Reconfiguration
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequired
    #ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig = 80
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions = 0
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-RB-Config.RadioBearerConfig.drb-ToAddModList.DRB-ToAddMod.pdcp-Config.moreThanOneRLC.primaryPath.cellGroup = 0
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-RB-Config.RadioBearerConfig.drb-ToAddModList.DRB-ToAddMod.pdcp-Config.moreThanOneRLC.ul-DataSplitThreshold = 23

#Verify SgNBModificationConfirm and RRCReconfigurationComplete
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationConfirm
	#ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer = 80
	ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer.RRCReconfigurationComplete.criticalExtensions.rrcReconfigurationComplete = *

#Verify BearerContextModificationConfirm
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationConfirm.protocolIEs.ProtocolIE-Field.id = 20

#Verify UEContextModificationRequest
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.ProtocolIE-Field.value.DRBs-ToBeModified-List.ProtocolIE-SingleContainer.value.DRBs-ToBeModified-Item.uLConfiguration.uLUEConfiguration = 0

#Verify UEContextModificationResponse
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.cellGroupId = 1

[CP2]
#Verify BearerContextModificationRequired
ethernet.ip.sctp.e1ap
 ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequired.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequired.e-UTRAN-BearerContextModificationRequired.ProtocolIE-Field.value.DRB-Required-To-Modify-List-EUTRAN.DRB-Required-To-Modify-Item-EUTRAN.gNB-CU-UP-CellGroupRelatedConfiguration.GNB-CU-UP-CellGroupRelatedConfiguration-Item.cell-Group-ID = 1
 ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequired.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequired.e-UTRAN-BearerContextModificationRequired.ProtocolIE-Field.value.DRB-Required-To-Modify-List-EUTRAN.DRB-Required-To-Modify-Item-EUTRAN.gNB-CU-UP-CellGroupRelatedConfiguration.GNB-CU-UP-CellGroupRelatedConfiguration-Item.uL-Configuration = 0


#Verify SgNBModificationRequired, RRC Reconfiguration
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequired
    #ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig = 80
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions = 0
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-RB-Config.RadioBearerConfig.drb-ToAddModList.DRB-ToAddMod.pdcp-Config.moreThanOneRLC.primaryPath.cellGroup = 0
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-RB-Config.RadioBearerConfig.drb-ToAddModList.DRB-ToAddMod.pdcp-Config.moreThanOneRLC.ul-DataSplitThreshold = 23

#Verify SgNBModificationConfirm and RRCReconfigurationComplete
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationConfirm
	#ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer = 80
	ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer.RRCReconfigurationComplete.criticalExtensions.rrcReconfigurationComplete = *

#Verify UEContextModificationRequest
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.ProtocolIE-Field.value.DRBs-ToBeModified-List.ProtocolIE-SingleContainer.value.DRBs-ToBeModified-Item.uLConfiguration.uLUEConfiguration = 0

#Verify BearerContextModificationConfirm
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationConfirm.protocolIEs.ProtocolIE-Field.id = 20

#Verify UEContextModificationResponse
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.cellGroupId = 1
