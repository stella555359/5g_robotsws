[Global]

RELATION: CP1

BLOCKSIZE: -1

[CP1]
###Intra-Frequency Inter-gNB HO From Real gNB To Sim gNB###
#HandoverRequest=xnap.HandoverRequest_element, radioNetwork: handover-desirable-for-radio-reasons (1)
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 0 = id-sourceNG-RANnodeUEXnAPID
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 0.ProtocolIE-Field.value.NG-RANnodeUEXnAPID = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 1

#HandoverRequestAcknowledge=xnap.HandoverRequestAcknowledge_element
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge = *
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 0 = id-sourceNG-RANnodeUEXnAPID
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.NG-RANnodeUEXnAPID = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 1 = id-targetNG-RANnodeUEXnAPID
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.NG-RANnodeUEXnAPID = 1

# Check UE context Release UEContextRelease on Source real GNB
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.UEContextRelease = *
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.UEContextRelease.protocolIEs.Item 0 = id-sourceNG-RANnodeUEXnAPID
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.UEContextRelease.protocolIEs.Item 0.ProtocolIE-Field.value.NG-RANnodeUEXnAPID = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.UEContextRelease.protocolIEs.Item 1 = id-targetNG-RANnodeUEXnAPID
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.UEContextRelease.protocolIEs.Item 1.ProtocolIE-Field.value.NG-RANnodeUEXnAPID = 1

# Check UE context Release Command, radioNetwork: normal-release (10)
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 10

###UE HO Back From Sim gNB To Real gNB###
#HandoverRequest=xnap.HandoverRequest_element, radioNetwork: handover-desirable-for-radio-reasons (1)
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 0 = id-sourceNG-RANnodeUEXnAPID
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 0.ProtocolIE-Field.value.NG-RANnodeUEXnAPID = 2
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 1

#RRCReconfiguration: nr-rrc.criticalExtensions==0 && nr-rrc.reportType==1 && nr-rrc.eventId ==2 && nr-rrc.a3_Offset ==0 && RRCReconfiguration=nr-rrc.resultsSSB_Indexes == 1 && nr-rrc.ssb_Index == 0
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions = 0
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 2
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType = 1
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 2
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.rrm-Config.candidateCellInfoList.Item 0.MeasResult2NR.measResultNeighCellListNR.Item 0.MeasResultNR.measResult.rsIndexResults.resultsSSB-Indexes = 1 item
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.HandoverPreparationInformation.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.rrm-Config.candidateCellInfoList.Item 0.MeasResult2NR.measResultNeighCellListNR.Item 0.MeasResultNR.measResult.rsIndexResults.resultsSSB-Indexes.Item 0.ResultsPerSSB-Index.ssb-Index = 0


# Check CFRA in UEContextSetupResponse
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.rach-ConfigDedicated.uplink.cfra.resources.ssb.ssb-ResourceList.Item 0.CFRA-SSB-Resource.ra-PreambleIndex = 60

#HandoverRequestAcknowledge=xnap.HandoverRequestAcknowledge_element
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge = *
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 0 = id-sourceNG-RANnodeUEXnAPID
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.NG-RANnodeUEXnAPID = 2
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 1 = id-targetNG-RANnodeUEXnAPID
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.NG-RANnodeUEXnAPID = *


#SNStatusTransfer_SA=xnap.SNStatusTransfer_element
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.SNStatusTransfer = *

#'PathSwitchRequest': 'ngap.NGAP_PDU == 0 and ngap.procedureCode == 25'
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 25

#PathSwitchRequestAcknowledge: ngap.nextHopChainingCount == 3 && ngap.NrencryptionAlgorithms.nea3 == 1 && ngap.NrintegrityProtectionAlgorithms.nia3 == 1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PathSwitchRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.UESecurityCapabilities.nRencryptionAlgorithms.128-NEA1 = Not supported
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PathSwitchRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.UESecurityCapabilities.nRencryptionAlgorithms.128-NEA2 = Not supported
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PathSwitchRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.UESecurityCapabilities.nRencryptionAlgorithms.128-NEA3 = Supported
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PathSwitchRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.UESecurityCapabilities.nRintegrityProtectionAlgorithms.128-NIA3 = Supported
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PathSwitchRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.UESecurityCapabilities.nRintegrityProtectionAlgorithms.128-NIA1 = Not supported
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PathSwitchRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.UESecurityCapabilities.nRintegrityProtectionAlgorithms.128-NIA2 = Not supported
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PathSwitchRequestAcknowledge.protocolIEs.Item 3.ProtocolIE-Field.value.SecurityContext.nextHopChainingCount = 3

# Check UE context Release UEContextRelease on Source GNB
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.UEContextRelease = *
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.UEContextRelease.protocolIEs.Item 0 = id-sourceNG-RANnodeUEXnAPID
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.UEContextRelease.protocolIEs.Item 0.ProtocolIE-Field.value.NG-RANnodeUEXnAPID = 2
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.UEContextRelease.protocolIEs.Item 1 = id-targetNG-RANnodeUEXnAPID
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.UEContextRelease.protocolIEs.Item 1.ProtocolIE-Field.value.NG-RANnodeUEXnAPID = *
