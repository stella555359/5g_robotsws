[Global]

RELATION: CP1

BlOCKSIZE: -1

[CP1]
#Verify drx setup in UEContextModificationResponse when UE attach
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1
	ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-onDurationTimer.milliSeconds = 8
	ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-InactivityTimer = 9
	ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-HARQ-RTT-TimerDL = 0
	ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-HARQ-RTT-TimerUL = 0
	ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-RetransmissionTimerDL = 6
	ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-RetransmissionTimerUL = 6
	ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-LongCycleStartOffset.ms80 = 0
	ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-SlotOffset = 0

#Verify drx setup in SgNBModificationRequired, RRC Reconfiguration
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequired
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1

#Verify SgNBModificationConfirm and RRCReconfigurationComplete
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationConfirm

#Verify SgNBModificationRequest
#Cause.radioNetwork = 46 means mcg-mobility
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequest
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 46
	ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.candidateCellInfoListMN.MeasResult2NR.ssbFrequency = 636576
	ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.candidateCellInfoListMN.MeasResult2NR.measResultServingCell.physCellId = 50
	ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.candidateCellInfoListMN.MeasResult2NR.measResultNeighCellListNR.MeasResultNR.physCellId = 51

#Verify drx release in UEContextModificationResponse
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config = 0

#Verify drx release and serve cell id=51 in SgNBModificationRequestAcknowledge, RRC Reconfiguration
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequestAcknowledge
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 0
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 51

#Verify serve cell id=51 in UEContextModificationResponse
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 51