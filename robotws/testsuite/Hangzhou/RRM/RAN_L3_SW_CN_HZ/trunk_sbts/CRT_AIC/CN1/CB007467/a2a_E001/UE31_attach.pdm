[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#SgNBAdditionRequest
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequest

#BearerContextSetupRequest
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 8

#BearerContextSetupResponse
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.successfulOutcome.procedureCode = 8

#UEContextSetupRequest
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 5

#UEContextSetupResponse
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 5

#SgNBAdditionRequestAcknowledge
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequestAcknowledge

#SgNBReconfigurationComplete
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBReconfigurationComplete

#SNStatusTransfer
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SNStatusTransfer

#BearerContextModificationRequest
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 9

#BearerContextModificationResponse
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.successfulOutcome.procedureCode = 9

