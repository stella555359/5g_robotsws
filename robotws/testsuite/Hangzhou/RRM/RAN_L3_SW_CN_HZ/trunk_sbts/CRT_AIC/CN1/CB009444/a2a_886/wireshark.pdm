[Global]



RELATION: CP1 & CP2 & CP3



BLOCKSIZE: -1







[CP1]

# Check the x2ap SecondaryRATDataUsageReport

ethernet.ip.sctp.x2ap

    ethernet.ip.sctp.x2ap.procedure_code = 38

    ethernet.ip.sctp.x2ap.value = SecondaryRATDataUsageReport



[CP2]

# Check the SgNBReleaseRequired with cause inactivity

ethernet.ip.sctp.x2ap

    ethernet.ip.sctp.x2ap.procedure_code = 32

    ethernet.ip.sctp.x2ap.value = SgNBReleaseRequired

    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 42



# Check the traffic which by comparing the value between wts and pcap

ethernet.ip.sctp.e1ap

    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.DataUsageReport.protocolIEs.Item 2.ProtocolIE-Field.value.Data-Usage-Report-List.Item 0.Data-Usage-Report-Item.dRB-Usage-Report-List.Item 0.DRB-Usage-Report-Item.usageCountUL = ${Bytes received} octets



[CP3]

# Check the e1ap DataUsageReport

ethernet.ip.sctp.e1ap

    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.DataUsageReport = *

    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 15



