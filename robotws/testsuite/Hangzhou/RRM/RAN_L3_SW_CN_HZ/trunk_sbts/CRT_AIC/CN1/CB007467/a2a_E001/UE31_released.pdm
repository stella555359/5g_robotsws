[Global]
RELATION: CP1 & CP2 & CP3
BLOCKSIZE: -1

[CP1]
#E1AP
#e1 all reset
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset = None
    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 4
    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 0

#e1 all reset Acknowledge
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.successfulOutcome.value.ResetAcknowledge = None

[CP2]
#F1AP
#f1 partial reset
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset = None
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${attach_UE31_GNB-CU-UE-F1AP-ID}
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-DU-UE-F1AP-ID = ${attach_UE31_GNB-DU-UE-F1AP-ID}

#f1 partial reset Acknowledge
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.UE-associatedLogicalF1-ConnectionListResAck.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${attach_UE31_GNB-CU-UE-F1AP-ID}
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.UE-associatedLogicalF1-ConnectionListResAck.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-DU-UE-F1AP-ID = ${attach_UE31_GNB-DU-UE-F1AP-ID}

[CP3]
#X2AP
#x2 partial reset
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = ENDCPartialResetRequired
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 11
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${attach_UE31_SgNB-UE-X2AP-ID}

#x2 partial reset Acknowledge
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = ENDCPartialResetConfirm
    ethernet.ip.sctp.x2ap.id-UEs-Admitted-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${attach_UE31_SgNB-UE-X2AP-ID}

