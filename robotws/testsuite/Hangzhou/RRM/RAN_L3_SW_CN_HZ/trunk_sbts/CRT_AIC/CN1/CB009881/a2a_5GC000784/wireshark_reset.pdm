[Global]

RELATION: CP1 | CP2

BlOCKSIZE: -1

[CP1]
#E1 RESET
#Cause: misc (3)
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause = 3
    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface = 1 item

ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.successfulOutcome.value.ResetAcknowledge = *

#NG SETUP
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGSetupRequest = *

ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse = *

[CP2]
#F1 RESET
#Cause: transport (1)
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause = 1
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface = 1 item

ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge = *

#NG SETUP
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGSetupRequest = *

ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse = *
