[Global]
RELATION: CP1&CP2&CP3&CP4&CP5
BlOCKSIZE: -1

[CP1]
# filter: f1ap.procedureCode == 0 and f1ap.ResetType == 1  and f1ap.gNB_CU_UE_F1AP_ID == ${sa4_ueID}
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${sa4_ueID}

[CP2]
# filter: ngap.AMF_UE_NGAP_ID == ${amf1_ngap_id} and ngap.RAN_UE_NGAP_ID == ${sa1_ueID} and ngap.ResetType == 1 and ngap.procedureCode == 20
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 20
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.aMF-UE-NGAP-ID = ${amf1_ngap_id}
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${sa1_ueID}

[CP3]
# filter: e1ap.procedureCode == 0 and e1ap.ResetType == 1
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
[CP4]
# filter: f1ap.procedureCode == 0 and f1ap.ResetType == 1 and f1ap.gNB_CU_UE_F1AP_ID == ${ue32_sgNB_X2APID} and f1ap.gNB_CU_UE_F1AP_ID == ${sa4_ueID}
# filter: f1ap.gNB_CU_UE_F1AP_ID == 24576 and f1ap.gNB_CU_UE_F1AP_ID == 32768 and f1ap.ResetType == 1
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${sa4_ueID}
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 1.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${ue32_sgNB_X2APID}


[CP5]
# filter: x2ap.procedureCode == 40 and x2ap.sgNB_ID == ${ue32_sgNB_X2APID}  and x2ap.radioNetwork == 11
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 11
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${ue32_sgNB_X2APID}
    ethernet.ip.sctp.x2ap.procedure_code = 40

