
[Global]
RELATION: CP1|CP2|CP3|CP4
BlOCKSIZE: -1

[CP1]
# filter: x2ap.sgNB_ID == 98304  and x2ap.meNB_ID == 1 and x2ap.radioNetwork == 11 and x2ap.procedureCode == 40
# radioNetwork = cell-not-available
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 11
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.meNB-ID = ${nsa1_enb_x2apId}
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${nsa1_gnb_x2apid}
    ethernet.ip.sctp.x2ap.procedure_code = 40

# filter: x2ap.sgNB_ID == 106496  and x2ap.meNB_ID == 2 and x2ap.radioNetwork == 11 and x2ap.procedureCode == 40
# radioNetwork = cell-not-available
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 1.UEsToBeResetList-Item.meNB-ID = ${nsa2_enb_x2apId}
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 1.UEsToBeResetList-Item.sgNB-ID = ${nsa2_gnb_x2apid}


