[Global]
RELATION: CP1&CP2
BlOCKSIZE: -1

[CP1]
#Check the F1-U address used by this UE in UEContextSetupResponse. For this UE F1-U_OP2 address is used here.
# filter: f1ap.transportLayerAddressIPv4 == 172.14.2.215
ethernet.ip.sctp.f1ap
	#ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 5.ProtocolIE-Field.value.DRBs-Setup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-Setup-Item.dLUPTNLInformation-ToBeSetup-List.Item 0.DLUPTNLInformation-ToBeSetup-Item.dLUPTNLInformation.gTPTunnel.transportLayerAddress.IPv4 transportLayerAddress = 172.14.2.215
	ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 5.ProtocolIE-Field.value.DRBs-Setup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-Setup-Item.dLUPTNLInformation-ToBeSetup-List.Item 0.DLUPTNLInformation-ToBeSetup-Item.dLUPTNLInformation.gTPTunnel.transportLayerAddress.IPv4 transportLayerAddress = 172.14.2.3

[CP2]
# filter: x2ap.SgNB_UE_X2AP_ID == ${ue34_sgNB_X2APID}
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequestAcknowledge
    ethernet.ip.sctp.x2ap.id-SgNB-UE-X2AP-ID.ProtocolIE-Field.value.SgNB-UE-X2AP-ID = ${ue34_sgNB_X2APID}
