[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: (nr-rrc.reestablishmentCause == 2) && (nr-rrc.physCellId == 51)
#rrcReestablishmentRequest
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.rrcReestablishmentRequest.ue-Identity.physCellId = 51
    ethernet.ip.sctp.f1ap.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.rrcReestablishmentRequest.reestablishmentCause = 2

# filter: ((xnap.procedureCode == 3) && (xnap.nr == 51)) && (xnap.NR_Cell_Identity == 0x0000000000004001)
# procedureCode: id-retrieveUEContext (3)
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.initiatingMessage.value.RetrieveUEContextRequest.protocolIEs.Item 1.UEContextID.rRRCReestablishment.failureCellPCI.nr = 51
    ethernet.ip.sctp.xnap.initiatingMessage.value.RetrieveUEContextRequest.protocolIEs.Item 3.ProtocolIE-Field.value.NG-RAN-Cell-Identity.nr = 0x000004001
    ethernet.ip.sctp.xnap.initiatingMessage.procedureCode = 3
    ethernet.ip.sctp.xnap.initiatingMessage.value.RetrieveUEContextRequest = None

# filter: (xnap.procedureCode == 3) && (ngap.radioNetwork == 35)
# procedureCode: id-retrieveUEContext (3)/radioNetwork: ue-context-transfer (35)
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.successfulOutcome.value.RetrieveUEContextResponse.protocolIEs.Item 4.ProtocolIE-Field.value.UEHistoryInformation.hOCauseValue.radioNetwork = 35
    ethernet.ip.sctp.xnap.successfulOutcome.procedureCode = 3
    ethernet.ip.sctp.xnap.successfulOutcome.value.RetrieveUEContextResponse = None

#filter e1ap.GNB_DU_ID == 16385
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.initiatingMessage.value.BearerContextSetupRequest = None
    ethernet.ip.sctp.e1ap.initiatingMessage.value.BearerContextSetupRequest.protocolIEs.Item 7.ProtocolIE-Field.value.GNB-DU-ID = 16385

ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.successfulOutcome.value.BearerContextSetupResponse = None

# filter: f1ap.nRCellIdentity == 00:00:04:00:10
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.initiatingMessage.value.UEContextSetupRequest = None
    ethernet.ip.sctp.f1ap.initiatingMessage.value.Item 2.ProtocolIE-Field.value.nRCellIdentity_pre = 0000040010

ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.successfulOutcome.value.UEContextSetupResponse = None

ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.initiatingMessage.value.XnUAddressIndication = None

ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.initiatingMessage.value.BearerContextModificationRequest = None

ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.successfulOutcome.value.BearerContextModificationResponse = None

ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.initiatingMessage.value.PathSwitchRequest = None

ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.successfulOutcome.value.PathSwitchRequestAcknowledge = None

ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.initiatingMessage.value.UEContextRelease = None



