[Global]
RELATION: CP1&CP2 
BLOCKSIZE: -1

[CP1]
#Reestablishment Request
# filter: ((nr-rrc.physCellId == 50) && (nr-rrc.c1 == 2)) && (nr-rrc.reestablishmentCause == 2)
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.ue-Identity.physCellId = 50

#filter: nr-rrc.selectedPLMN_Identity == 1
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcSetupComplete.criticalExtensions.rrcSetupComplete.selectedPLMN-Identity = 1	

# filter: ((pdcp-nr.maci_present == 1) && (f1ap.procedureCode == 13)) && (nas_5gs.mm.message_type == 0x43)
#Reestablishment Complete
ethernet.ip.sctp.f1ap	
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).Configuration.MAC-I Present = True

#filter: f1ap.GNB_DUConfigurationQuery == 0	
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.GNB-DUConfigurationQuery = 0
	
[CP2]
# filter: ((ngap.pDUSessionID == 1) && (ngap.procedureCode == 14)) && (ngap.NGAP_PDU == 1)
#InitialContextSetupResponse
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.InitialContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtRes.Item 0.PDUSessionResourceSetupItemCxtRes.pDUSessionID = 1