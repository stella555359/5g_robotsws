[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: ngap.procedureCode == 20(ngreset) and ngap.AMF_UE_NGAP_ID == ${AMF_UE_NGAP_ID_UE}
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 20
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.aMF-UE-NGAP-ID = ${AMF_UE_NGAP_ID_UE}

# filter: f1ap.procedureCode == 0(reset) and f1ap.gNB_CU_UE_F1AP_ID == ${RAN_UE_NGAP_ID_UE}
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${RAN_UE_NGAP_ID_UE}

# filter: e1ap.procedureCode == 0(reset) and e1ap.gNB_CU_CP_UE_E1AP_ID == ${RAN_UE_NGAP_ID_UE}
ethernet.ip.sctp.e1ap
    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ip.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalE1-ConnectionItem.gNB-CU-CP-UE-E1AP-ID = ${RAN_UE_NGAP_ID_UE}

