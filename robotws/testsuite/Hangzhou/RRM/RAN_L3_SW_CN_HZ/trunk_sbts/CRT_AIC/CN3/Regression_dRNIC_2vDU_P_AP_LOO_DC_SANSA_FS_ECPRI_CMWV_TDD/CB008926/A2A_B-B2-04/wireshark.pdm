[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: ngap.RAN_UE_NGAP_ID == 25 and ngap.AMF_UE_NGAP_ID == 1
#PDUSessionResourceModifyRequest and ErrorIndication
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 0.ProtocolIE-Field.value.AMF-UE-NGAP-ID = 25
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 1.ProtocolIE-Field.value.RAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_UE1}

# filter: ngap.RAN_UE_NGAP_ID == 25 and ngap.AMF_UE_NGAP_ID == 1 and ngap.radioNetwork == 15
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.ErrorIndication.protocolIEs.Item 0.ProtocolIE-Field.value.AMF-UE-NGAP-ID = 25
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.ErrorIndication.protocolIEs.Item 1.ProtocolIE-Field.value.RAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_UE1}
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.ErrorIndication.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 15

