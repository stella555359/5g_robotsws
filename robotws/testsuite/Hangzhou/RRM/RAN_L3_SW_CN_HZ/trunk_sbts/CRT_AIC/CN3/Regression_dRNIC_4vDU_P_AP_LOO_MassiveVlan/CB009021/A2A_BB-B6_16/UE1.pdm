[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#Check the F1-U address used by this UE in UEContextSetupResponse. For this UE F1-U_OP3 address is used here.
#filter: f1ap.transportLayerAddressIPv4 == 172.13.2.1
ethernet.ip.sctp.f1ap
	ethernet.ip.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 5.ProtocolIE-Field.value.DRBs-Setup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-Setup-Item.dLUPTNLInformation-ToBeSetup-List.Item 0.DLUPTNLInformation-ToBeSetup-Item.dLUPTNLInformation.gTPTunnel.transportLayerAddress.IPv4 transportLayerAddress = 172.13.2.1
