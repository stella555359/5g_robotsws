[Global]
RELATION: CP1&CP2&CP3
BlOCKSIZE: -1

[CP1]
# filter: f1ap.ResetType == 1 and f1ap.gNB_CU_UE_F1AP_ID == ${sa3_ueID} and f1ap.procedureCode == 0
ethernet.ip.sctp.f1ap
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${sa3_ueID}
	ethernet.ip.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 1.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${ue33_sgNB_X2APID}

[CP2]
# filter: ngap.ResetType == 1 and ngap.procedureCode == 20 and ngap.AMF_UE_NGAP_ID == ${amf2_ngap_id} and ngap.RAN_UE_NGAP_ID == ${sa2_ueID}
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 20
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.aMF-UE-NGAP-ID = ${amf2_ngap_id}
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${sa2_ueID}

[CP3]
# filter: x2ap.procedureCode == 40 and x2ap.sgNB_ID == ${ue33_sgNB_X2APID} and x2ap.radioNetwork == 11
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 11
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${ue33_sgNB_X2APID}
    ethernet.ip.sctp.x2ap.procedure_code = 40

