[Global]

RELATION: CP1


[CP1]

#first F1 partial reset is triggered with reason om-intervention for UE1
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${sa1_ueID}


#E1 reset for UE1
ethernet.ipv6.sctp.e1ap.E1AP-PDU
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0
#	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 4
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalE1-ConnectionItem.gNB-CU-CP-UE-E1AP-ID = ${sa1_ueID}

