[Global]

RELATION: CP1|CP2|CP3


[CP1]

#first F1 partial reset is triggered with reason om-intervention
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0

#E1 reset
ethernet.ipv6.sctp.e1ap.E1AP-PDU
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0

#X2 reset
ethernet.ip.sctp.x2ap
	ethernet.ip.sctp.x2ap.value = ENDCPartialResetRequired
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 11


#ng reset
ethernet.ip.sctp.ngap.NGAP-PDU
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1 = id-ResetType
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause = 0

[CP2]

#first F1 partial reset is triggered with reason om-intervention
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0


#E1 reset
ethernet.ipv6.sctp.e1ap.E1AP-PDU
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0

#ng reset
ethernet.ip.sctp.ngap.NGAP-PDU
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1 = id-ResetType
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause = 0

#X2 reset
ethernet.ip.sctp.x2ap
	ethernet.ip.sctp.x2ap.value = ENDCPartialResetRequired
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 11
	
[CP3]

#first F1 partial reset is triggered with reason om-intervention
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0

#X2 reset
ethernet.ip.sctp.x2ap
	ethernet.ip.sctp.x2ap.value = ENDCPartialResetRequired
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 11
	
#E1 reset
ethernet.ipv6.sctp.e1ap.E1AP-PDU
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0

#ng reset
ethernet.ip.sctp.ngap.NGAP-PDU
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1 = id-ResetType
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause = 0

	