[Global]
RELATION: CP1 & CP2 & CP3 & CP4 & CP5 & CP6
BLOCKSIZE: -1

[CP1]
#X2AP-PDU: ENDC Partial Reset Required     & CP2 & CP3
X2AP-PDU
    X2AP-PDU.ENDCPartialResetRequired.protocolIEs.None_1.value_Cause = : misc : unspecified
    X2AP-PDU.ENDCPartialResetRequired.protocolIEs.None.UEsToBeResetList.None.meNB-ID = ${invalid_ue31_MeNB_X2APID}
    X2AP-PDU.ENDCPartialResetRequired.protocolIEs.None.UEsToBeResetList.None.sgNB-ID = ${ue31_sgNB_X2APID}


