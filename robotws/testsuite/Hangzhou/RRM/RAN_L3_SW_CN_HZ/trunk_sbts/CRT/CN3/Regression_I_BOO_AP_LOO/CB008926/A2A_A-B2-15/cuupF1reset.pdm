[Global]

RELATION: CP1&CP2&(CP3|CP4)&(CP5|CP6)&(CP7|CP8)


[CP1]
#E1 reset
ethernet.ipv6.sctp.e1ap.E1AP-PDU
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0
#	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 4

[CP2]
#first F1 partial reset is triggered with reason om-intervention
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 3

[CP3]
#X2 reset
ethernet.ip.sctp.x2ap
	ethernet.ip.sctp.x2ap.value = ENDCPartialResetRequired
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 11
	ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${nsa_gnb_x2apid}
	ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.meNB-ID = ${nsa_enb_x2apId} 

[CP4]
#X2 reset
ethernet.ip.sctp.x2ap
	ethernet.ip.sctp.x2ap.value = ENDCPartialResetRequired
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 11
	ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${nsa_gnb_x2apid2}
	ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.meNB-ID = ${nsa_enb_x2apId2} 

[CP5]
#ng reset
ethernet.ip.sctp.ngap.NGAP-PDU
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1 = id-ResetType
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause = 0
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${sa1_ueID}

[CP6]
#ng reset
ethernet.ip.sctp.ngap.NGAP-PDU
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1 = id-ResetType
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause = 0
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${sa3_ueID}

[CP7]
#ng reset
ethernet.ip.sctp.ngap.NGAP-PDU
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1 = id-ResetType
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause = 0
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${sa2_ueID}

[CP8]
#ng reset
ethernet.ip.sctp.ngap.NGAP-PDU
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1 = id-ResetType
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause = 0
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${sa4_ueID}