
[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#allowedBCList has F+T CA combination
UE-MRDC-Capability
    UE-MRDC-Capability.rf-ParametersMRDC.appliedFreqBandListFilter.bandInformationNR_1.bandNR = 41
    UE-MRDC-Capability.rf-ParametersMRDC.appliedFreqBandListFilter.bandInformationNR.bandNR = 71
    UE-MRDC-Capability.rf-ParametersMRDC.appliedFreqBandListFilter.bandInformationEUTRA.bandEUTRA = 4

#EN-DC setup successfully, Pcell A1 measurement is configured
RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_2.reportConfigNR.eventTriggered.eventA1.timeToTrigger = ms320
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_2.reportConfigNR.eventTriggered.eventA1.a1-Threshold_rsrp = 70
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_2.reportConfigNR.eventTriggered.eventA1.hysteresis = 0
    

	