
[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#SgNB Modification Requiredmessage to MeNB to trigger add Scell
X2AP-PDU
    X2AP-PDU.SgNBModificationRequired.protocolIEs.None_2.value_Cause = : radioNetwork : rRM-purpose

#Scell addition is successful and A2 for scell release is configured
RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.hysteresis = 0
    RRCReconfiguration.rrcReconfiguration.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 50
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.a2-Threshold_rsrp = 50
    RRCReconfiguration.rrcReconfiguration.CONTAINING.sCellToAddModList.None.sCellIndex = 9
