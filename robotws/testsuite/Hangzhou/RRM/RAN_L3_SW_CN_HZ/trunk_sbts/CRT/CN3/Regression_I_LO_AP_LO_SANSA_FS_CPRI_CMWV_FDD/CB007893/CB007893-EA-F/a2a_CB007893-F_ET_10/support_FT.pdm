
[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#reconfigure to supprot F+T CA ,A1 is configured
X2AP-PDU
    X2AP-PDU.SgNBModificationRequest.protocolIEs.None_2.value_Cause = : radioNetwork : reduce-load
	
X2AP-PDU
    X2AP-PDU.SgNBModificationRequestAcknowledge.protocolIEs.None_3.value_RRC-Config-Ind = delta-config

RRCReconfiguration	
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA1.a1-Threshold_rsrp = 70
	RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA1.hysteresis = 0
	RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA1.timeToTrigger = ms320

UL-DCCH-Message	
    UL-DCCH-Message.rrcConnectionReconfigurationComplete.rrc-TransactionIdentifier = 0

X2AP-PDU	
   X2AP-PDU.SgNBReconfigurationComplete.protocolIEs.None_2.criticality = ignore