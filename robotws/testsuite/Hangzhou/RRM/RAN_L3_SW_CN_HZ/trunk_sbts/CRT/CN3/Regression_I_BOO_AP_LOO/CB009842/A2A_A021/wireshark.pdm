[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#E-CID MEASUREMENT INITIATION REQUEST:Measurement Quantity requested is ‘NR_Timing_Advance’,Report Characteristics IE set to On-Demand 
# filter: nrppa.measurementQuantitiesValue == 11 and nrppa.measurementQuantitiesValue == 6 and nrppa.measurementQuantitiesValue == 7 and nrppa.ReportCharacteristics == 0
ethernet.ip.sctp.ngap
  	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 2.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 11
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 1.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 7
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 0.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 6
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 1.ProtocolIE-Field.value.ReportCharacteristics = 0


# E-CIDMeasurementInitiationResponse
# filter: NR-TADV  and rsrp == 11 and rsrq == 11
ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 2.MeasuredResultsValue.choice-Extension.value.NR-TADV = *
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 1.MeasuredResultsValue.choice-Extension.value.ResultSS-RSRQ.Item 0.ResultSS-RSRQ-Item.valueSS-RSRQ-Cell = 11
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue.choice-Extension.value.ResultSS-RSRP.Item 0.ResultSS-RSRP-Item.valueSS-RSRP-Cell = 11

