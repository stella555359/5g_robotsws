[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
#USCB006137-BC#IWK2: interworking with full TX power in uplink transmission support (5GC002396)
#Step-1:Attach UE to the FDD NR cell, UE is configured to full power mode.
#Step-2:A1 measurement event for ULCA addition, UE is re-configured to non-full power mode.
#Step-3:A2 measurement event for Scell release, UE is re-configured to full power mode.
ethernet.ipv6.sctp.syscom
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.cellConfigurationForModification (DynamicVariableSizedArray).cellConfigurationForModification_item_0 (itf_l2_ps_CellConfigModifyParam_t).puschConfig (StaticVariableSizedArray).puschConfig_item_0 (itf_l2_ps_pusch_PuschConfig).ulFullPowerTransmissionR16 (itf_l2_ps_pusch_UlFullPowerTransmissionR16) = 3
	
ethernet.ipv6.sctp.syscom
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.cellConfigurationForModification (DynamicVariableSizedArray).cellConfigurationForModification_item_0 (itf_l2_ps_CellConfigModifyParam_t).puschConfig (StaticVariableSizedArray).puschConfig_item_0 (itf_l2_ps_pusch_PuschConfig).ulFullPowerTransmissionR16 (itf_l2_ps_pusch_UlFullPowerTransmissionR16) = 3