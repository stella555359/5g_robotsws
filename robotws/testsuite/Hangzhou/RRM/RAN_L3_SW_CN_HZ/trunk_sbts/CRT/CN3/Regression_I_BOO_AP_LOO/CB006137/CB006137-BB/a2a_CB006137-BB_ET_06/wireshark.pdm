[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
#if UE report ueAssistanceInformation with reducedCCsDL=0 reducedCCsUL=0, then MaxNumofActiveSCellsDL=0 and MaxNumofActiveSCellsUL=0 in itf_l2_ps_user_UserChangeInd.
#if UE report ueAssistanceInformation with reducedCCsDL=1 reducedCCsUL=0, then MaxNumofActiveSCellsDL=1 and MaxNumofActiveSCellsUL=0 in itf_l2_ps_user_UserChangeInd.
#if UE report ueAssistanceInformation with reducedCCsDL=2 reducedCCsUL=1, then MaxNumofActiveSCellsDL=2 and MaxNumofActiveSCellsUL=1 in itf_l2_ps_user_UserChangeInd.
#if UE report ueAssistanceInformation with reducedCCsDL=3 reducedCCsUL=1, then MaxNumofActiveSCellsDL=3 and MaxNumofActiveSCellsUL=1 in itf_l2_ps_user_UserChangeInd.
#if UE report ueAssistanceInformation without any IEs, then MaxNumofActiveSCellsDL=Not limited and MaxNumofActiveSCellsUL=Not limited in itf_l2_ps_user_UserChangeInd.
#The indication "Not limited" can be expressed with a numerical value greater than the maximum number of UE configurable SCells.
#if UE report the UEAssistanceInformation IE carries the OverheatingAssistance IE but without ReducedMaxCCs, then MaxNumofActiveSCellsDL=0 and MaxNumofActiveSCellsUL=0 in itf_l2_ps_user_UserChangeInd.

ethernet.ipv6.sctp.syscom
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsDl (Uint8) = 0
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsUl (Uint8) = 0
	
ethernet.ipv6.sctp.syscom
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsDl (Uint8) = 1
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsUl (Uint8) = 0
	
ethernet.ipv6.sctp.syscom
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsDl (Uint8) = 2
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsUl (Uint8) = 1
	
ethernet.ipv6.sctp.syscom
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsDl (Uint8) = 3
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsUl (Uint8) = 1
	
ethernet.ipv6.sctp.syscom
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsDl (Uint8) = 0
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsUl (Uint8) = 0
	
ethernet.ipv6.sctp.syscom
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsDl (Uint8) = ${Not_limited}
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userchangeind.itf_l2_ps_user_UserChangeInd_t.maxNumberOfActiveSCellsUl (Uint8) = ${Not_limited}