[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
# 1:first pdu setup to cell-1, check ultxswitch capability query
DL-DCCH-Message
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.CONTAINING.capabilityRequestFilterCommon.uplinkTxSwitchRequest-r16 = true
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.ue-CapabilityEnquiryExt = ue-CapabilityEnquiryExt
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.ue-CapabilityRAT-RequestList.None.rat-Type = nr

# 2:first pdu setup, check drx installed with drxprofile1
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-RetransmissionTimerDL = sl0
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-RetransmissionTimerUL = sl0
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-onDurationTimer_milliSeconds = ms10
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-InactivityTimer = ms80
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-HARQ-RTT-TimerDL = 0
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-HARQ-RTT-TimerUL = 0

# 3:Scell_Addition the first time, ultxswitch scell is cell13 and cell14
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 62
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingCarrier-r16 = carrier1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellIndex = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.66 = 66
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup.maxRank = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingCarrier-r16 = carrier2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = 63
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellIndex = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingPeriodLocation-r16 = TRUE
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.uplinkTxSwitchingOption-r16 = switchedUL
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingPeriodLocation-r16 = FALSE

# 4:send A2 report, check A3 configured with drx released and gap installed
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA3.timeToTrigger = ms320
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measGapConfig.setup.gapOffset = *
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.drx-Config_release = NULL

# 5:send A3 report, handover to cell-2, scell addition A1 installed
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_2.measId = 14
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.ssbFrequency = ${Cell2_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_2.reportConfigNR.eventTriggered.eventA1.a1-Threshold_rsrp = 50
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_2.reportConfigId = 9
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectId = 5
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_2.reportConfigId = 9

# 6:Scell_Addition on cell-2, ultxswitch scell is cell12 and cell13
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 61
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingCarrier-r16 = carrier1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellIndex = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.66 = 66
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup.maxRank = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingCarrier-r16 = carrier2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = 62
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellIndex = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingPeriodLocation-r16 = TRUE
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.uplinkTxSwitchingOption-r16 = switchedUL
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingPeriodLocation-r16 = FALSE

# 7:send A2,A3 report, handover to cell-1, scell addition A1 installed
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_2.measId = 22
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.ssbFrequency = ${Cell1_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_2.measObjectId = 10
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_2.reportConfigNR.eventTriggered.eventA1.a1-Threshold_rsrp = 50
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_2.reportConfigId = 15
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectId = 10
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_2.reportConfigId = 15

# 8:Scell_Addition on cell-1, normal CA, scell is cell13 and cell2
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 51
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellIndex = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = 62
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellIndex = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup.maxRank = 1
