[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#UE-1: allowedServingCells is config as 0 for SRB1 and SRB2  

DL-DCCH-Message

    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.mac-LogicalChannelConfig.ul-SpecificParameters.allowedServingCells.0 = 0
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None_2.mac-LogicalChannelConfig.ul-SpecificParameters.allowedServingCells.0 = 0
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.servedRadioBearer_srb-Identity = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None_2.servedRadioBearer_srb-Identity = 2

#UE-1: p-NR-FR1 is 23, p-Max is 23 in rrc msg 	
DL-DCCH-Message
    
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.physicalCellGroupConfig.p-NR-FR1 = 23
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.p-Max = 23
