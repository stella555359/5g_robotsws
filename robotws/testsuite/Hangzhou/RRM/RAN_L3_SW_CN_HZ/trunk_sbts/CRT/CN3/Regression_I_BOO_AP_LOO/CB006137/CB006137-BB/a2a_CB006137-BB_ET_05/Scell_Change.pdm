
[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#Periodic codebook and TAS SRS resources allocate for UL Scell when UE Scell supportedSRS-TxPortSwitch t1r2.
#The same UE's pCSI and periodic SRS cannot be on the same slot,regardless whether UE support parallelTxSRS-PUCCH-PUSCH(5G_CP_IF_RRC_8355) or not.
#in case TDD Scell having frame structure 5GC001208, SRS symbol on special slot 8 & slot 18 of each frame cannot be allocated to all the Scell UE,regardless whether UE support parallelTxSRS-PUCCH-PUSCH(5G_CP_IF_RRC_8355) or not.
