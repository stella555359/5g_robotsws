
[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#measuremnet via SRB3
UL-DCCH-Message
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.physCellId = 50
	
#SgNBModificationRequired form SgNB to Menb ,A2 to configure A3 mobility measurement
X2AP-PDU
    X2AP-PDU.SgNBModificationRequired.protocolIEs.None_2.value_Cause = : radioNetwork : rRM-purpose
	
X2AP-PDU
    X2AP-PDU.SgNBModificationRequest.protocolIEs.None_2.value_Cause = : radioNetwork : rRM-purpose
	
X2AP-PDU	
	X2AP-PDU.SgNBModificationRequestAcknowledge.protocolIEs.None_3.value_RRC-Config-Ind = delta-config
	
RRCReconfiguration	
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA3.a3-Offset_rsrp = 3


	
#Trigger A3 mobility measurement , HO successfully
  #SRB3 enable , A meaasurement report via NR instead of X2
UL-DCCH-Message
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultListNR.None.physCellId = 60
	
  #A1 for F+T CA scell addition is configured
RRCReconfiguration
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA1.hysteresis = 0
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA1.a1-Threshold_rsrp = 70
    RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA1.timeToTrigger = ms320

UL-DCCH-Message
    UL-DCCH-Message.rrcConnectionReconfigurationComplete.rrc-TransactionIdentifier = 0

X2AP-PDU
    X2AP-PDU.SgNBModificationRequired.protocolIEs.None_2.value_Cause = : radioNetwork : rRM-purpose
	
X2AP-PDU	
    X2AP-PDU.SgNBModificationRequest.protocolIEs.None_2.value_Cause = : radioNetwork : rRM-purpose

X2AP-PDU	
    X2AP-PDU.SgNBModificationConfirm.protocolIEs.None.criticality = ignore