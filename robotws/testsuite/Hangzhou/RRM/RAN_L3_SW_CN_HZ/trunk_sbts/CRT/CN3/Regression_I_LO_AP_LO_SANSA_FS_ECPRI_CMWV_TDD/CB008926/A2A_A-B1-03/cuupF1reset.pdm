

[Global]
RELATION: CP1


[CP1]
#om -interval E1 partial reset shall be triggered first, oam sent cpnrt_failureind to cpnrt  with failure poolid, then cpnrt start E1 reset, which ue is located at that poolid is not known for tester. oma send all failure pools to cpnb, cpnb send one by one to cpnrt.
ethernet.ipv6.sctp.e1ap.E1AP-PDU
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 3
#then f1 reset with cause : hardware-failure, cpnb receive failureind from oam, then cpnb start F1 intial parital reset with pools. 
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 2
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
