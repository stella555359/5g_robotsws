
[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#pcell change and re-establish EN-DC
  #Menb trigger sgNBModificationRequest
X2AP-PDU	
    X2AP-PDU.SgNBModificationRequest.protocolIEs.None_2.value_Cause = : radioNetwork : mCG-Mobility
	
  #SgNB reply SgNBModificationRequestAcknowledge
X2AP-PDU
    X2AP-PDU.SgNBModificationRequestAcknowledge.protocolIEs.None_2.E-RABs-Admitted-ToBeModified-SgNBModAckList.None.E-RABs-Admitted-ToBeModified-SgNBModAck-Item.e-RAB-ID = 5
	
  #target cell ENB 1.2
DL-DCCH-Message
    DL-DCCH-Message.rrcConnectionReconfiguration.rrcConnectionReconfiguration-r8.mobilityControlInfo.targetPhysCellId = 10
	
  #A1 for scell addition is configured during procedure
RRCReconfiguration	
	RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA1.a1-Threshold_rsrp = 70
	
UL-DCCH-Message	
	UL-DCCH-Message.rrcConnectionReconfigurationComplete.rrc-TransactionIdentifier = 0
	
X2AP-PDU	
   X2AP-PDU.SgNBReconfigurationComplete.protocolIEs.None_2.criticality = ignore
	