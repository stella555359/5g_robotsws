[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#UE-1: UL scell addition procedure
#check pmax for UL scell and p-NR-FR1 for Pcell
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.physicalCellGroupConfig.p-NR-FR1 = 26
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.p-Max = 23
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = ${Cell1_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = ${Cell3_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_2.sCellConfigCommon.physCellId = ${Cell11_FDD_PCI}

