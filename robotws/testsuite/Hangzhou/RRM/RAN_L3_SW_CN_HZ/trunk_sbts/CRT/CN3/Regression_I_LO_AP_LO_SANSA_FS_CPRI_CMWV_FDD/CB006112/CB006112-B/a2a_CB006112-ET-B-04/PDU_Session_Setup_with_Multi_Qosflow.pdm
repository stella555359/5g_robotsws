
[Global]
RELATION: CP1|CP2
BLOCKSIZE: -1

[CP1]
#PDU_Session_Setup_with_Multi_Qosflow
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None_1.pdcp-Config.drb.discardTimer = ms150
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None_1.um-Bi-Directional.dl-UM-RLC.sn-FieldLength = size6
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None_1.um-Bi-Directional.ul-UM-RLC.sn-FieldLength = size6
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.um-Bi-Directional.dl-UM-RLC.sn-FieldLength = size12
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.um-Bi-Directional.ul-UM-RLC.sn-FieldLength = size12
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.setup.n310 = $n20$
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.setup.t310 = ms4000

#Vonr DRX	
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-RetransmissionTimerDL = sl0
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-RetransmissionTimerUL = sl0
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-onDurationTimer_milliSeconds = ms6
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-InactivityTimer = ms4
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-HARQ-RTT-TimerDL = 0
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-HARQ-RTT-TimerUL = 0	

[CP2]
#PDU_Session_Setup_with_Multi_Qosflow
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None_1.pdcp-Config.drb.discardTimer = ms150
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None_1.um-Bi-Directional.dl-UM-RLC.sn-FieldLength = size6
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None_1.um-Bi-Directional.ul-UM-RLC.sn-FieldLength = size6
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.um-Bi-Directional.dl-UM-RLC.sn-FieldLength = size12
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.um-Bi-Directional.ul-UM-RLC.sn-FieldLength = size12
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.setup.n310 = $n20$
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.setup.t310 = ms4000

#Vonr DRX	
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-RetransmissionTimerDL = sl0
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-RetransmissionTimerUL = sl0
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-onDurationTimer_milliSeconds = ms10
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-InactivityTimer = ms4
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-HARQ-RTT-TimerDL = 0
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.drx-HARQ-RTT-TimerUL = 0	