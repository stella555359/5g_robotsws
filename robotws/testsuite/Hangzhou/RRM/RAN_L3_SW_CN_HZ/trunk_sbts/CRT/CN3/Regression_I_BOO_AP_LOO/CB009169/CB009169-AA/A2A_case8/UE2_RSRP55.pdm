
[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#UE-2: (3CC with UL)
#BC#1: N41a*-N66a*-N71a*,
#BC#2: N41a*-N66a-N66a*;
#BC#3: N41a*-N71a*-N78a,
#BC#4: N41a*-N66a*-N78a;
#BC#5: N41a*-N71a*-N71a;
#send A1 with rsrp55, then only FDD scell can be added
#aggrDlAvailChBW_FLSi: BC2 is selected  cell13 is added with DL and UL CA, cell11 is added as DL CA

DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell13_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.66 = 66
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.frequencyBandList.66 = 66
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell11_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.66 = 66

