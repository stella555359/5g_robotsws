[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#dlToUlContributionRatio is 50, ulDlDataSlotRatio is 1/4 sCellOperationalMode= dlAndUl
#cell11: FDD N66,20M,
#cell13: FDD N66,30M,
#cell1: TDD N41,60M,
#cell2: TDD N78,80M
#UE-1,2,3: N71*a-N66a-N66a, N71a*-N41a*;    *means UL capability
#attach UE2 and add scell， N71a*-N41a* is selected, TDD Cell-1 as DL/UL Scell
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = ${Cell1_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell1_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.scs-SpecificCarrierList.None.carrierBandwidth = ${Cell1_carrierBandwidth}
