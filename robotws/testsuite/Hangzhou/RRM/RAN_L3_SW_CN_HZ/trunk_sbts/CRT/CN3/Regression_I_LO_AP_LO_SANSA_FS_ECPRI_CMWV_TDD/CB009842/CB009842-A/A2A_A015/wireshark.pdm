[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#E-CID MEASUREMENT INITIATION REQUEST:UE_Measurement_ID , nrppatransactionID ,Measurement Quantity requested is  ‘TimingAdvanceNR’ and "sS-RSRP" and "sS-RSRQ"
# filter: ((((nrppa.nrppatransactionID == 1 and nrppa.UE_Measurement_ID == 1) && (nrppa.measurementQuantitiesValue == 11)) && (nrppa.ReportCharacteristics == 0)) && (nrppa.measurementQuantitiesValue == 6)) && (nrppa.measurementQuantitiesValue == 7)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.nrppatransactionID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 0.ProtocolIE-Field.value.UE-Measurement-ID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 1.ProtocolIE-Field.value.ReportCharacteristics = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 0.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 6
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 1.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 7
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 2.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 11

#l2ps send measurement result of TAdv
# filter: (itf_l2_ps_user_userranmeasurementresp) && (itf_l2_ps_user_TimingAdvanceMeasurementResult.tAdv_item == 0)
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userranmeasurementresp.itf_l2_ps_user_UserRanMeasurementResp_t.tAdvMeasResult (StaticOptional).tAdvMeasResult_item_0 (itf_l2_ps_user_TimingAdvanceMeasurementResult).tAdv (StaticOptional).tAdv_item_0 (Uint32) = *

# E-CID MEASUREMENT INITIATION RESPONSE:UE_Measurement_ID , nrppatransactionID ,servingCell-ID nG-RANcell, MeasuredResultsValue, NR_TADV value for UE-1
# filter: ((nrppa.nrppatransactionID == 1 and nrppa.UE_Measurement_ID == 1 and nrppa.nG_RANcell == 1) && (nrppa.MeasuredResultsValue == 5)) && (nrppa.NR_TADV == 0)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.nrppatransactionID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 0.ProtocolIE-Field.value.UE-Measurement-ID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 1.ProtocolIE-Field.value.UE-Measurement-ID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.servingCell-ID.nG-RANcell = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue = choice-Extension (5): id-NR-TADV
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue.choice-Extension.value.NR-TADV = *
	

