[Global]

RELATION: CP1&CP2&CP3&CP4&CP5


[CP1]
#X2 reset
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.procedure_code = 7
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause = 3
[CP2]
#first F1 partial reset is triggered with reason om-intervention : NSA2
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 3
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${nsa2_gnb_x2apid}
[CP3]
#E1 reset:NSA2
ethernet.ipv6.sctp.e1ap.E1AP-PDU
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalE1-ConnectionItem.gNB-CU-CP-UE-E1AP-ID = ${nsa2_gnb_x2apid}
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause = 3
[CP4]
#E1 reset : NSA1
ethernet.ipv6.sctp.e1ap.E1AP-PDU
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalE1-ConnectionItem.gNB-CU-CP-UE-E1AP-ID = ${nsa1_gnb_x2apid}
[CP5]
#F1 reset:  : NSA1
ethernet.ipv6.sctp.f1ap.F1AP-PDU 
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${nsa1_gnb_x2apid}

