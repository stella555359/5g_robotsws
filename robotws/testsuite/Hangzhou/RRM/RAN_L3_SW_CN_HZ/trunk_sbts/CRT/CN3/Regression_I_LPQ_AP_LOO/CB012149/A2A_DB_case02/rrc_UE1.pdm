[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
# 1:check ultxswitch capability query
DL-DCCH-Message
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.CONTAINING.capabilityRequestFilterCommon.uplinkTxSwitchRequest-r16 = true
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.ue-CapabilityEnquiryExt = ue-CapabilityEnquiryExt
    DL-DCCH-Message.ueCapabilityEnquiry.ueCapabilityEnquiry.ue-CapabilityRAT-RequestList.None.rat-Type = nr
	
# 2:Scell_Addition by A1 > a1ThresholdSCellAddSsbRsrpFDD
# index 5 / ultxswitch BC#2: N66a*-N41a*-N71a=23500000 / 16386+16397*+16396
# scell1 CELL1(PCI 50) with ul
# scell2 CELL12(PCI 61)
# 3:after A1, check scell added,fullpowerMode1 is configured
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup.maxRank = 2
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup_1.srs-ResourceToAddModList.None.nrofSRS-Ports = ports2
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingCarrier-r16 = carrier2
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.setup_1.uplinkTxSwitchingPeriodLocation-r16 = FALSE
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.setup.uplinkTxSwitchingPeriodLocation-r16 = TRUE
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.setup.uplinkTxSwitchingCarrier-r16 = carrier1
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellIndex = 1
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 50
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellIndex = 2
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = 61
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.uplinkTxSwitchingOption-r16 = switchedUL
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup.ul-FullPowerTransmission-r16 = fullpowerMode1

# 4: scell1 released, UL TX switch released
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkTxSwitching-r16_release = NULL
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToReleaseList.1 = 1

# 5: scell1 released and A1 activated
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToReleaseList.2 = 2
