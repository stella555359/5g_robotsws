[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#dlToUlContributionRatio is 100, ulDlDataSlotRatio is 1/4, weightForSCellSelection=70 for TDD Cell-2, weightForSCellSelection=50 for other cells
#cell11: FDD N66,20M,
#cell13: FDD N66,30M,
#cell1: TDD N41,60M,
#cell2: TDD N78,80M
#UE-1,2,3: N71a*-N66a-N66a, N71a*-N66a-N41a*, N71a*-N66a-N78a*, N71a*-N41a-N78a*,N71a*-N41a*-N78a;   *means UL capability
#UE-4: N71a*-N66a-N66a, N71a*-N78a, N71a*-N41a
#first attach UE4 and add scell，N71a*-N78a is selected, TDD Cell-2 as DL Scell configured
#attach UE1 and add scell， N71a*-N41a-N78a* is selected, TDD Cell-1 as DL Scell and TDD Cell-2 as DL/UL Scell
#attach UE2 and add scell， N71a*-N41a-N78a* is selected, TDD Cell-2 as DL/UL Scell and FDD Cell-13 as DL Scell configured
#attach UE3 and add scell， N71a*-N41a*-N78a is selected, TDD Cell-1 as DL/UL Scell and TDD Cell-2 as DL Scell configured
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = ${Cell2_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = ${Cell13_FDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell2_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell13_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.scs-SpecificCarrierList.None.carrierBandwidth = ${Cell2_carrierBandwidth}
