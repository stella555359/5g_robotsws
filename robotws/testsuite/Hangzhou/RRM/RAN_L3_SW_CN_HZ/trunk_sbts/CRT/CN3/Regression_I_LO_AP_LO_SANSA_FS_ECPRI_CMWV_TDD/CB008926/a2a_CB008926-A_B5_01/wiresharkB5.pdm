[Global]
RELATION: CP1 & CP2 & CP3 & CP4 & CP5 & CP6
BLOCKSIZE: -1

	
[CP1]
#UE1 E1ap Reset
ethernet.ipv6.sctp.e1ap	
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 1
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalE1-ConnectionItem.gNB-CU-CP-UE-E1AP-ID = ${sgNB_NGapIDList}

[CP2]
#UE1 E1ap Reset
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.UE-associatedLogicalE1-ConnectionListResAck.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalE1-ConnectionItem.gNB-CU-CP-UE-E1AP-ID = ${sgNB_NGapIDList}

[CP3]
#UE1 f1ap reset    
ethernet.ipv6.sctp.f1ap   	
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${sgNB_NGapIDList}

[CP4]
#UE1 f1ap reset 
ethernet.ipv6.sctp.f1ap	
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.UE-associatedLogicalF1-ConnectionListResAck.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${sgNB_NGapIDList}

[CP5]
#UE1 NGap reset
ethernet.ip.sctp.ngap    
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause.radioNetwork = 3
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${sgNB_NGapIDList}

[CP6]
#UE1 NGap reset
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.UE-associatedLogicalNG-connectionList.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${sgNB_NGapIDList}