[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#UE3: FDD cell-13 add as DL and UL sCell with large BWP
#DL: 30M, UL: 10M
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = ${Cell_13_FDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.scs-SpecificCarrierList.None.carrierBandwidth = ${FDD_PRB_for_30M}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.scs-SpecificCarrierList.None.carrierBandwidth = ${FDD_PRB_for_10M}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.66 = 66
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.frequencyBandList.66 = 66
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.downlinkBWP-ToAddModList.None.bwp-Common.genericParameters.locationAndBandwidth = 32174
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Common.genericParameters.locationAndBandwidth = 14025

