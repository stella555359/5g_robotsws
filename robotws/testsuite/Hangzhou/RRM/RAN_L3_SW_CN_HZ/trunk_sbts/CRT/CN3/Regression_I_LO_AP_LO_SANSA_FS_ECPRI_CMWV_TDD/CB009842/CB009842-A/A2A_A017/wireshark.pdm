    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFStatusIndication.protocolIEs.Item 0.ProtocolIE-Field.value.UnavailableGUAMIList.Item 0.UnavailableGUAMIItem.gUAMI.aMFPointer = bit length 6, 2 LSB pad bits, 0000 10.. decimal value 2
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFStatusIndication.protocolIEs.Item 0.ProtocolIE-Field.value.UnavailableGUAMIList.Item 0.UnavailableGUAMIItem.timerApproachForGUAMIRemoval = 0

