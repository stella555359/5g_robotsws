[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
# UE3 first ultx , release  and reconfg with normal BC
#first CA with ultxsw
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.uplinkTxSwitchingOption-r16 = switchedUL

#release scell1
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.uplinkTxSwitchingOption-r16 = switchedUL

#no swultx when second CA
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.uplinkTxSwitchingOption-r16 = switchedUL