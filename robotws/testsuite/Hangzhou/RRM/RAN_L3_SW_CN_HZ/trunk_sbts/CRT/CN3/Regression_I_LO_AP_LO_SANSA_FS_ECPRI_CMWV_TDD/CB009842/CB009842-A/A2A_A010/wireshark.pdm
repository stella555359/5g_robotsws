[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]#LMF sends E-CID MEASUREMENT INITIATION REQUEST
# filter: nrppa.procedureCode == 2 and nrppa.UE_Measurement_ID == 1 and nrppa.ReportCharacteristics == 0 and nrppa.measurementQuantitiesValue == 6 and nrppa.measurementQuantitiesValue == 11
# nrppa.procedureCode == 2 (id-e-CIDMeasurementInitiation)
# nrppa.ReportCharacteristics == 0 (onDemand)
# nrppa.measurementQuantitiesValue == 6 (sS-RSRP)
# nrppa.measurementQuantitiesValue == 11 (timingAdvanceNR)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.procedureCode = 2
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 0.ProtocolIE-Field.value.UE-Measurement-ID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 1.ProtocolIE-Field.value.ReportCharacteristics = 0
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 1.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 11
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 0.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 6


#l2ps send measurement result of TAdv
# filter: (itf_l2_ps_user_userranmeasurementresp) && (itf_l2_ps_user_TimingAdvanceMeasurementResult.tAdv_item == 0)
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_userranmeasurementresp.itf_l2_ps_user_UserRanMeasurementResp_t.tAdvMeasResult (StaticVariableSizedArray).tAdvMeasResult_item_0 (itf_l2_ps_user_TimingAdvanceMeasurementResult).tAdv (StaticVariableSizedArray).tAdv_item_0 (Uint32) = 0

# UE context inactivity
# filter: e1ap.procedureCode == 13
# procedureCode: id-bearerContextInactivityNotification (13)
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 13

#E-CIDMeasurementInitiation response
# filter: nrppa.procedureCode == 2 and nrppa.radioNetwork == 2
# procedureCode: id-e-CIDMeasurementInitiation (2)
# radioNetwork: requested-item-temporarily-not-available (2)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.unsuccessfulOutcome.procedureCode = 2
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.unsuccessfulOutcome.value.E-CIDMeasurementInitiationFailure.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 2

