[Global]
RELATION: CP1&CP2&CP3&CP4&CP5&CP6&CP7
BLOCKSIZE: -1

[CP1]#rrcconfig wth A2 A3
RRCReconfiguration
   RRCReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.ssbFrequency = 636576
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigId = 1
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA3.a3-Offset_rsrp = 5
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigId = 2
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA5.a5-Threshold2_rsrp = 85
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA5.a5-Threshold1_rsrp = 75
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_2.reportConfigId = 3
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_2.reportConfigNR.eventTriggered.eventA2.a2-Threshold_rsrp = 40
   
[CP2]#SgNBModificationRequired after MR A2
X2AP-PDU
   X2AP-PDU.SgNBModificationRequired.protocolIEs.None_2.value_Cause = : radioNetwork : rRM-purpose
   X2AP-PDU.procedureCode = 30
   
[CP3]#rrcConnectionReconfiguration from MeNB after MR A2
DL-DCCH-Message
   DL-DCCH-Message.rrcConnectionReconfiguration.rrcConnectionReconfiguration-r8.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.setup.endc-ReleaseAndAdd-r15 = FALSE
   DL-DCCH-Message.rrcConnectionReconfiguration.rrcConnectionReconfiguration-r8.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.setup.nr-SecondaryCellGroupConfig-r15 = *

[CP4]#rrcreconfig after A2 MR with NRIFHO-1
RRCReconfiguration  
   RRCReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectId = 2
   RRCReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.ssbFrequency = 2071387
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigId = 4
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA1.a1-Threshold_rsrp = 60
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigId = 5
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA3.a3-Offset_rsrp = 10
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.measId = 1
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.measObjectId = 1
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.reportConfigId = 1
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_1.measId = 2
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_1.measObjectId = 1
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_1.reportConfigId = 2
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_2.measId = 4
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_2.measObjectId = 1
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_2.reportConfigId = 4
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_3.measId = 5
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_3.measObjectId = 2
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None_3.reportConfigId = 5
   RRCReconfiguration.rrcReconfiguration.measConfig.reportConfigToRemoveList.3 = 3
   RRCReconfiguration.rrcReconfiguration.measConfig.measIdToRemoveList.3 = 3
   
[CP5]#SgNBModificationRequired after MR A1
X2AP-PDU
   X2AP-PDU.SgNBModificationRequired.protocolIEs.None_2.value_Cause = : radioNetwork : rRM-purpose
   X2AP-PDU.procedureCode = 30

[CP6] #rrcConnectionReconfiguration from MeNB after MR A1
DL-DCCH-Message
   DL-DCCH-Message.rrcConnectionReconfiguration.rrcConnectionReconfiguration-r8.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.setup.endc-ReleaseAndAdd-r15 = FALSE
   DL-DCCH-Message.rrcConnectionReconfiguration.rrcConnectionReconfiguration-r8.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.nonCriticalExtension.setup.nr-SecondaryCellGroupConfig-r15 = *
   
