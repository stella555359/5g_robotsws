[Global]
RELATION: CP1 & CP2 & CP3 & CP4 & CP5
BLOCKSIZE: -1


[CP1]
#NG reset
ethernet.ip.sctp.ngap.NGAP-PDU
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_UE1}
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.aMF-UE-NGAP-ID = ${AMF_UE_NGAP_ID_UE1}
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 1.UE-associatedLogicalNG-connectionItem.aMF-UE-NGAP-ID = ${AMF_UE_NGAP_ID_UE2}
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 1.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_UE2}
[CP2]
#UE1 F1 reset
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${RAN_UE_NGAP_ID_UE1}
[CP3]
#UE2 F1 reset    
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${RAN_UE_NGAP_ID_UE2}
[CP4]
#UE1 E1ap Reset
ethernet.ipv6.sctp.e1ap.E1AP-PDU
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalE1-ConnectionItem.gNB-CU-CP-UE-E1AP-ID = ${RAN_UE_NGAP_ID_UE1}
[CP5]
#UE2 E1ap Reset
ethernet.ipv6.sctp.e1ap.E1AP-PDU
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalE1-ConnectionItem.gNB-CU-CP-UE-E1AP-ID = ${RAN_UE_NGAP_ID_UE2}
