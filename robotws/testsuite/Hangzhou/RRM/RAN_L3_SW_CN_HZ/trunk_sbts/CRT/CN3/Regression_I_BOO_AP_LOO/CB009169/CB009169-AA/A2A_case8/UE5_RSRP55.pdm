    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_2.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.frequencyBandList.66 = 66
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell11_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.66 = 66
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell12_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.71 = 71
