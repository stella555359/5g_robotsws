[Global]
RELATION: CP1 & CP2 & CP3 &  CP5 & CP6 & CP7 & CP8 & CP9
BLOCKSIZE: -1

	
[CP1]
#UE31 ENDCPartialResetRequired & CP4 
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = ENDCPartialResetRequired
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.misc = 4
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause = 3
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.meNB-ID = ${invalid_ue31_MeNB_X2APID}    
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${ue31_sgNB_X2APID}
[CP2]
#UE32 ENDCPartialResetRequired	
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = ENDCPartialResetRequired
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.misc = 4
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.meNB-ID = ${ue32_MeNB_X2APID}
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${invalid_ue32_sgNB_X2APID}
[CP3]
#UE33 ENDCPartialResetRequired
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = ENDCPartialResetRequired
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.misc = 4
    ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.meNB-ID = ${inv_ue33_MeNB_X2APID}

[CP5]	
#[CP2]
#UE31 ENDCPartialResetConfirm    
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = ENDCPartialResetConfirm
    ethernet.ip.sctp.x2ap.id-UEs-Admitted-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.meNB-ID = ${invalid_ue31_MeNB_X2APID}
    ethernet.ip.sctp.x2ap.id-UEs-Admitted-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${ue31_sgNB_X2APID}	
[CP6]	
#UE32 ENDCPartialResetConfirm
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = ENDCPartialResetConfirm
    ethernet.ip.sctp.x2ap.id-UEs-Admitted-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.meNB-ID = ${ue32_MeNB_X2APID}
    ethernet.ip.sctp.x2ap.id-UEs-Admitted-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${invalid_ue32_sgNB_X2APID}
[CP7]
#UE33 ENDCPartialResetConfirm
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = ENDCPartialResetConfirm
    ethernet.ip.sctp.x2ap.id-UEs-Admitted-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.meNB-ID = ${inv_ue33_MeNB_X2APID}

[CP8]
#UE31 E1Reset    
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 0.ProtocolIE-SingleContainer.criticality = 0
#    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 4
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalE1-ConnectionItem.gNB-CU-CP-UE-E1AP-ID = ${ue31_sgNB_X2APID}

[CP9]	
#UE31 E1ResetAcknowledge
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1 = id-UE-associatedLogicalF1-ConnectionListResAck
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.UE-associatedLogicalF1-ConnectionListResAck.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${ue31_sgNB_X2APID}	
