[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#cell1: TDD N41,60M,
#cell2: TDD N78,80M
#UE1 capability: N71*a-N66a-N66a, N71a*-N78a*-N41a; for N78 ChannelBWs-DL rightmost bit set to 0; 80M not supported
#attach UE1 and create PDU session, send A1, TDD Cell-2 as DL/UL scell with small BWP, TDD Cell-1 as DL Scell configured

DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell2_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell1_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.scs-SpecificCarrierList.None.carrierBandwidth = ${Cell2_50M_carrierBandwidth}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = ${Cell1_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = ${Cell2_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigDedicated.downlinkBWP-ToAddModList.None.bwp-Common.genericParameters.locationAndBandwidth = ${cell2_small_BWP}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Common.genericParameters.locationAndBandwidth = ${cell2_small_BWP}