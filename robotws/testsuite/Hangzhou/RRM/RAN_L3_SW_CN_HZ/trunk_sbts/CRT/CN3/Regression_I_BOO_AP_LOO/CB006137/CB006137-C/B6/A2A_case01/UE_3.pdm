[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#UE-3: scell change procedure
#check p0 and PHR config
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.multiplePHR = TRUE
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup_1.pusch-PowerControl.p0-AlphaSets.None.p0 = -3
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.phr-ProhibitTimer = sf50
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.phr-Tx-PowerFactorChange = dB3
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.phr-PeriodicTimer = sf20
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup_1.pusch-PowerControl.p0-AlphaSets.None.p0 = -3


#UE-3: scell release procedure
#check p0 and multiplePHR
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.multiplePHR = FALSE
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup_1.pusch-PowerControl.p0-AlphaSets.None.p0 = 0
