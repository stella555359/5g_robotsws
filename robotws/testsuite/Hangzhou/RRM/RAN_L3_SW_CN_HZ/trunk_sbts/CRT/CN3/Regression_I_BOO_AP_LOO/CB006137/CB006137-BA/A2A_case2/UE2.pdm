[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#dlToUlContributionRatio is 101, ulDlDataSlotRatio is 1/4
#cell11: FDD N66,20M,
#cell13: FDD N66,30M,
#cell1: TDD N41,60M,
#cell2: TDD N78,80M
#UE-2: N71a*-N78a*; N71*a-N66a- N41a*; FDD Cell-13 as DL Scell and TDD Cell-1 as DL/UL Scell configured.
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = ${Cell1_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = ${Cell13_FDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell1_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell13_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.scs-SpecificCarrierList.None.carrierBandwidth = ${Cell1_carrierBandwidth}