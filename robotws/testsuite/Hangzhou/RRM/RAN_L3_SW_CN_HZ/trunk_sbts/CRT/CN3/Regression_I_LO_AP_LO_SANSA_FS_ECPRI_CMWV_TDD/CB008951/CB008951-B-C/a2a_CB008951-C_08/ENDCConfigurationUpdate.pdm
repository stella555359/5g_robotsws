
[Global]
RELATION: CP1&CP2

[CP1]
ethernet.ip.sctp.x2ap
	ethernet.ip.sctp.x2ap.value = ENDCConfigurationUpdate
	ethernet.ip.sctp.x2ap.id-InitiatingNodeType-EndcConfigUpdate.ProtocolIE-Field.value.InitiatingNodeType-EndcConfigUpdate.init-en-gNB.Item 0 = id-ServedNRcellsToDeleteListENDCConfUpd
	
[CP2]
ethernet.ipv6.sctp.f1ap.F1AP-PDU
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Served-Cells-To-Delete-List.Item 0 = id-Served-Cells-To-Delete-Item


