[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#dlToUlContributionRatio is 100, ulDlDataSlotRatio is 1/4
#cell11: FDD N66,20M,
#cell13: FDD N66,30M,
#cell1: TDD N41,60M,
#cell2: TDD N78,80M
#UE-3: N71*a-N66a-N66a; N71*a-N41a*; ;   *means UL capability
#according to algorithm N71*a-N66a-N66a is selected  FDD Cell-11 and FDD Cell-13 as DL Scell
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell11_FDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell13_FDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell13_ssbFrequency}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.absoluteFrequencySSB = ${Cell11_ssbFrequency}