[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
#Periodic codebook and TAS SRS resources allocate for UL Scell when UE Scell supportedSRS-TxPortSwitch t1r2.
#The same UE's pCSI and periodic SRS cannot be on the same slot,regardless whether UE support parallelTxSRS-PUCCH-PUSCH(5G_CP_IF_RRC_8355) or not.
#in case TDD Scell having frame structure 5GC001208, SRS symbol on special slot 8 & slot 18 of each frame cannot be allocated to all the Scell UE,regardless whether UE support parallelTxSRS-PUCCH-PUSCH(5G_CP_IF_RRC_8355) or not.
ethernet.ipv6.sctp.syscom
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.remoteSCellToAddList (DynamicVariableSizedArray).remoteSCellToAddList_item_0 (itf_l2_ps_RemoteCellConfigParam_t).numOfPerSrsRes (StaticVariableSizedArray).numOfPerSrsRes_item_0 (Uint8) = 3
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.remoteSCellToAddList (DynamicVariableSizedArray).remoteSCellToAddList_item_0 (itf_l2_ps_RemoteCellConfigParam_t).8).srsPeriodicityAndOffset_item_0 (itf_l2_ps_PeriodicityAndOffsetP).srsPeriod_slot (itf_l2_ps_srs_Periodicity) = 0x0028
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.remoteSCellToAddList (DynamicVariableSizedArray).remoteSCellToAddList_item_0 (itf_l2_ps_RemoteCellConfigParam_t).8).srsPeriodicityAndOffset_item_0 (itf_l2_ps_PeriodicityAndOffsetP).srsOffset_slot (Uint16) = 3
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.remoteSCellToAddList (DynamicVariableSizedArray).remoteSCellToAddList_item_0 (itf_l2_ps_RemoteCellConfigParam_t).8).srsPeriodicityAndOffset_item_1 (itf_l2_ps_PeriodicityAndOffsetP).srsPeriod_slot (itf_l2_ps_srs_Periodicity) = 0x0028
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.remoteSCellToAddList (DynamicVariableSizedArray).remoteSCellToAddList_item_0 (itf_l2_ps_RemoteCellConfigParam_t).8).srsPeriodicityAndOffset_item_1 (itf_l2_ps_PeriodicityAndOffsetP).srsOffset_slot (Uint16) = 23
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.remoteSCellToAddList (DynamicVariableSizedArray).remoteSCellToAddList_item_0 (itf_l2_ps_RemoteCellConfigParam_t).8).srsPeriodicityAndOffset_item_2 (itf_l2_ps_PeriodicityAndOffsetP).srsPeriod_slot (itf_l2_ps_srs_Periodicity) = 0x0028
	ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.remoteSCellToAddList (DynamicVariableSizedArray).remoteSCellToAddList_item_0 (itf_l2_ps_RemoteCellConfigParam_t).8).srsPeriodicityAndOffset_item_2 (itf_l2_ps_PeriodicityAndOffsetP).srsOffset_slot (Uint16) = 33