    Send A1 report to trigger Scell Addition with RSRP61    ue_id=${ue_id}

Ue with specified capabilitiy Add Scell by A1 and data Should be correct
    [Arguments]    ${ue_id}    ${ue_capa}
    Ue with specified capabilitiy Register And Pdu Session Setup At FDD Cell-13    ue_id=${ue_id}    ue_capa=${ue_capa}
    Trigger Scell Addition By A1 And Data    ue_id=${ue_id}    rrclog=attach

Scell Release After Timer Expired
    [Arguments]    ${ue_id}
    Stop Data    ue_id=${ue_id}
    sleep    ${sCellInactivityReleaseTimer}

Stop Data
    [Arguments]    ${ue_id}
    Run Keywords    Execute Egate Command    trf_data_stop ue=${ue_id} pdu=1 qfi=1 trf_id=1
    ...    pass_regexp=Traffic was stopped
    ...    AND    Execute Egate Command    trf_data_stop ue=${ue_id} pdu=1 qfi=1 trf_id=2
    ...    pass_regexp=Traffic was stopped
    ...    AND    Execute Egate Command    trf_data_stop ue=${ue_id} pdu=1 qfi=1 trf_id=3
    ...    pass_regexp=Traffic was stopped
    ...    AND    Execute Egate Command    trf_data_stop ue=${ue_id} pdu=1 qfi=1 trf_id=4
    ...    pass_regexp=Traffic was stopped
    ...    AND    Execute Egate Command    trf_data_stop ue=${ue_id} pdu=1 qfi=1 trf_id=5
    ...    pass_regexp=Traffic was stopped

Trigger Scell Addition By A1 And Data
    [Arguments]    ${ue_id}    ${rrclog}
    Start Data    ue_id=${ue_id}
    Send A1 report to trigger Scell Addition with RSRP61 and collect rrclog    ue_id=${ue_id}    rrc_log=${rrclog}

Start Data
    [Arguments]    ${ue_id}
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=175 trf_id=1    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=175 trf_id=2    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=175 trf_id=3    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=175 trf_id=4    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=175 trf_id=5    UE ${ue_id}: UDP DL
    sleep    30s    #sleep for stable traffic

Scell Release By RLQ
    [Arguments]    ${ue_id}    ${scell_id}
    Execute Egate Command    bler_testmode_nr profile_id=2 target_mcs=0 num_dl_pkts=10000
    ...    pass_regexp=CTRL_AP_TEST_BLER_NR
    ${cmd}    Catenate    ue_testmode_set_nr id=${ue_id} scell=${scell_id} testmode=bler action=activate profile_id=2
    Execute Egate Command    ${cmd}    pass_regexp=SCellIndex ${scell_id} deactivated successfully at airphone.

UE Reestablish To Cell And Check a1 Threshold Config
    [Arguments]    ${ue_id}=1    ${cell_id}=1
    ${expect_output}    Create List
    ...    a1-Threshold rsrp : ${a1ThresholdSCellAddSsbRsrpFDD}
    ...    rrcReconfigurationComplete
    Execute Egate Command    ue_rrc_reestablish id=${ue_id} gnb=2 cell=${cell_id}    pass_regexp=${expect_output}

Recover And Test Teardown
    Execute Egate Command    amf_ue_ics_param id=1 ue=all include_ue_capabilities=off
    delta commission parameters    ${CB008311_disable}
    Common Test Teardown And Stop Capture Logs

Recover scell bad RLQ
    [Arguments]    ${profile_id}=2    ${ue_id}=1
    Execute Egate Command    ue_testmode_set_nr id=${ue_id} scell=1 testmode=bler action=deactivate profile_id=${profile_id}
    ...    pass_regexp=CTRL_AP_UE_TESTMODE_SET_NR
    Execute Egate Command    ue_testmode_set_nr id=${ue_id} scell=2 testmode=bler action=deactivate profile_id=${profile_id}
    ...    pass_regexp=CTRL_AP_UE_TESTMODE_SET_NR
    Execute Egate Command    bler_testmode_nr delete=true profile_id=${profile_id}
    ...    pass_regexp=CTRL_AP_TEST_BLER_NR
    sleep    10s    #wait RLQ recovered

Send A2 A3 report to trigger intra-gnb handover to FDD cell-13 from cell-1
    [Arguments]    ${ue_id}=1
    UE Report InterFrequency A2 event    ue_id=${ue_id}    carrierfreq=${Cell1_ssbFrequency}
    UE Report InterFrequency A3 event    ue_id=${ue_id}    carrierfreq=${Cell13_ssbFrequency}    phycell_id=62

Send A2 A3 report to trigger intra-gnb handover to TDD cell-1 from cell-13
