[Global]

RELATION: CP1&CP2&CP3&CP4


[CP1]
#first F1 partial reset is triggered with reason om-intervention
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 3
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${nsa_gnb_x2apid}
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 1.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${sa_ueID}

[CP2]
#E1 reset
ethernet.ipv6.sctp.e1ap.E1AP-PDU
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0
#	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 4
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 1.ProtocolIE-SingleContainer.value.UE-associatedLogicalE1-ConnectionItem.gNB-CU-CP-UE-E1AP-ID = ${sa_ueID}
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalE1-ConnectionItem.gNB-CU-CP-UE-E1AP-ID = ${nsa_gnb_x2apid}

[CP3]
#ng reset
ethernet.ip.sctp.ngap.NGAP-PDU
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1 = id-ResetType
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause = 0
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${sa_ueID}

[CP4]
#X2 reset
ethernet.ip.sctp.x2ap
	ethernet.ip.sctp.x2ap.value = ENDCPartialResetRequired
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 11
	ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.meNB-ID = ${nsa_enb_x2apId}
	ethernet.ip.sctp.x2ap.id-UEs-ToBeReset.ProtocolIE-Field.value.UEsToBeResetList.Item 0.UEsToBeResetList-Item.sgNB-ID = ${nsa_gnb_x2apid}
