[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#UE-1 and UE-3: scell addition procedure
#check TDD cell-1 add as DL large only scell-1
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = ${Cell1_TDD_PCI}
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.78 = 78
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.scs-SpecificCarrierList.None.carrierBandwidth = ${TDD_PRB_for_80M}


