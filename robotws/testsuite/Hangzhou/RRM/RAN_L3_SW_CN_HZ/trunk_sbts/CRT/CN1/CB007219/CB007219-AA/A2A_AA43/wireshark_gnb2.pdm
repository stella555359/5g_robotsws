[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#check gnb2 bandCombinationIndex=3 and support MFBI_CA_Support and Extended_Band is not Support
# filter: nr-rrc.bandCombinationIndex == 3 and nokiaf1ap.MFBI_CA_Support == 0 and nokiaf1ap.Extended_Band_Support == 00
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAUeContextSetupRequest.protocolIEs.Item 13.ProtocolIE-Field.value.MFBI-CA-Support = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAUeContextSetupRequest.protocolIEs.Item 14.ProtocolIE-Field.value.Extended-Band-Support_pre = 00 
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAUeContextSetupRequest.protocolIEs.Item 5.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.configRestrictInfo.allowedBC-ListMRDC.Item 0.BandCombinationInfo.bandCombinationIndex = 3

#check RRC, pcell freqBandIndicatorNR=77
# filter: nr-rrc.ssbFrequency == 647424 and nr-rrc.freqBandIndicatorNR == 77 and nr-rrc.criticalExtensions == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 77
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.ssbFrequency = 647424

#check gnb2 have one CA_Establishment_ToBeSetup_List and support MFBI_CA_Support and Extended_Band is not Support
# filter: nokiaxnap.MFBI_CA_Support == 0 and nokiaxnap.Extended_Band_Support == 00 and nokiaxnap.SCell_For_IgNB_CA_Establishment_ToBeSetup_List == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 11.ProtocolIE-Field.value.SCell-For-IgNB-CA-Establishment-ToBeSetup-List = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 13.ProtocolIE-Field.value.MFBI-CA-Support = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 14.ProtocolIE-Field.value.Extended-Band-Support_pre = 00 

