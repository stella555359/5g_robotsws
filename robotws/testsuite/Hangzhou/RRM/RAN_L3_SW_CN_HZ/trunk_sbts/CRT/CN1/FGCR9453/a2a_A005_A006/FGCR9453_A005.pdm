[Global]
RELATION: CP1 & CP2 & CP3 & CP4 & CP5 & CP6
BLOCKSIZE: -1

[CP1]
#emergencyRRC information    nr-rrc.establishmentCause == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcSetupRequest.rrcSetupRequest.establishmentCause = 0

[CP2]
#service request     nas_5gs.mm.serv_type == 4
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialUEMessage.protocolIEs.ProtocolIE-Field.value.NAS-PDU.Non-Access-Stratum 5GS (NAS)PDU.Plain NAS 5GS Message.Message type = 0x4c

[CP3]
#emergency fallback requested     ngap.procedureCode == 14 && ngap.emergencyServiceTargetCN==1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.value.EmergencyFallbackIndicator.emergencyServiceTargetCN = 1

[CP4]
#ICSresponse    ngap.procedureCode == 14 && ngap.protocolIEs == 2
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.InitialContextSetupResponse.protocolIEs = 2 items

[CP5]
#RRC release     nr-rrc.redirectedCarrierInfo == 1 && nr-rrc.cnType == 0 && nr-rrc.eutraFrequency == 400
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.4   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.redirectedCarrierInfo.eutra.eutraFrequency = 400

[CP6]
#redirection     ngap.procedureCode == 42 && ngap.radioNetwork == 41
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 41