
[Global]
RELATION: CP1&CP2&CP3&CP4&CP5
BLOCKSIZE: -1

[CP1]
#check ue setup ENDC ues alternative band77                    
	
ethernet.ip.sctp.x2ap	
	
    ethernet.ip.sctp.x2ap.x2ap_pdu = 1
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 77
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 2
	
[CP2]	
##check MR is received via SRB3

ethernet.ipv6.sctp.f1ap
    
	 ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 13
     ethernet.ipv6.sctp.f1ap.F1AP-PDU = 0
	 
[CP3]
#check PCI in SgNBChangeRequired is 381 and band in RRC Reconfiguration is 77

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.x2ap_pdu = 0
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 77
	
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.candidateCellInfoListSN.MeasResultList2NR.Item 0.MeasResult2NR.measResultNeighCellListNR.Item 0.MeasResultNR.physCellId = 381

	
[CP4]
#check Msg: SgNBChangeConfirm
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.x2ap_pdu = 1


[CP5]
#check Msg: SNStatusTransfer
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.x2ap_pdu = 0
