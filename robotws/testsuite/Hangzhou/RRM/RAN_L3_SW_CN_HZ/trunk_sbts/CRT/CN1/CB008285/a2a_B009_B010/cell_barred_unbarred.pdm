[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#update AMF slice from SLICE1/SLICE2/SLICE3/SLICE4 to SLICE2(TAC not support)
# filter: ngap.sD == d1:43:a6 and ngap.sliceSupportList == 1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.PLMNSupportList.Item 0.PLMNSupportItem.sliceSupportList = 1 item
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.PLMNSupportList.Item 0.PLMNSupportItem.sliceSupportList.Item 0.SliceSupportItem.s-NSSAI.sD = d143a6

# GNBCUConfigurationUpdate - cellBarred=0:barred
# filter: nokiaf1ap.nRCellIdentity == 00:00:04:00:20 and nokiaf1ap.cellBarred == 0 and nokiaf1ap.nRCellIdentity == 00:00:04:00:10 and nokiaf1ap.cellBarred == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Cells-to-be-Barred-List.Item 0.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.cellBarred = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Cells-to-be-Barred-List.Item 0.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.nRCGI.nRCellIdentity_pre = 0000040010 


# AMFConfigurationUpdate - update AMF slice from SLICE2 to SLICE1/SLICE2/SLICE5(TAC support SLICE1)
# filter: ngap.sD == d1:43:a5 and ngap.sD == d1:43:a6 and ngap.sD == d1:43:a9
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.PLMNSupportList.Item 0.PLMNSupportItem.sliceSupportList.Item 0.SliceSupportItem.s-NSSAI.sD = d143a5
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.PLMNSupportList.Item 0.PLMNSupportItem.sliceSupportList.Item 1.SliceSupportItem.s-NSSAI.sD = d143a6
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.PLMNSupportList.Item 0.PLMNSupportItem.sliceSupportList.Item 2.SliceSupportItem.s-NSSAI.sD = d143a9


# GNBCUConfigurationUpdate - cellBarred=1: not barred
# filter: nokiaf1ap.nRCellIdentity == 00:00:04:00:10 and nokiaf1ap.cellBarred == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Cells-to-be-Activated-List.Item 0.ProtocolIE-SingleContainer.value.Cells-to-be-Activated-List-Item.nRCGI.nRCellIdentity_pre = 0000040010 
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.Item 2.ProtocolIE-Field.value.Cells-to-be-Barred-List.Item 0.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.cellBarred = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.Item 2.ProtocolIE-Field.value.Cells-to-be-Barred-List.Item 0.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.nRCGI.nRCellIdentity_pre = 0000040010 
