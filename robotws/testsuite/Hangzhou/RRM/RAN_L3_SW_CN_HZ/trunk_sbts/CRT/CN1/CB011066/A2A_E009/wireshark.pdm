[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nr-rrc.c1 == 0 and nr-rrc.resumeCause == 2
# UE1 initiates Resume procedure by sending RRCResumeRequest1,resumeCause: mt-Access (2)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH1-Message.message.c1 = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH1-Message.message.c1.rrcResumeRequest1.rrcResumeRequest1.resumeCause = 2

# filter: nokiaf1ap.procedureCode == 5 and nokiaf1ap.DRBs_ToBeSetup_List == 2 and nokiaf1ap.PDUSessionID == 1 and nokiaf1ap.PDUSessionID == 2 and nokiaf1ap.uLUPTNLInformation_ToBeSetup_List == 1 and nokiaf1ap.sST == 01 and nokiaf1ap.sD == d1:43:a5
# UEContextSetupRequest is sent to gNB-DU including the UL TEIDs to create the UE context in the gNB-DU,2 PDUSession with sD sNSSAI and sST sNSSAI.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 5
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.DRBs-ToBeSetup-List = 2 items
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.DRBs-ToBeSetup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-ToBeSetup-Item.qoSInformation.choice-extension.value.DRB-Information.dRB-QoS.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.PDUSessionID = 1
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.DRBs-ToBeSetup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-ToBeSetup-Item.qoSInformation.choice-extension.value.DRB-Information.sNSSAI.sST = 01
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.DRBs-ToBeSetup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-ToBeSetup-Item.uLUPTNLInformation-ToBeSetup-List = 1 item
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.DRBs-ToBeSetup-List.Item 1.ProtocolIE-SingleContainer.value.DRBs-ToBeSetup-Item.qoSInformation.choice-extension.value.DRB-Information.dRB-QoS.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.PDUSessionID = 2
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.DRBs-ToBeSetup-List.Item 1.ProtocolIE-SingleContainer.value.DRBs-ToBeSetup-Item.qoSInformation.choice-extension.value.DRB-Information.sNSSAI.sD = d143a5
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.DRBs-ToBeSetup-List.Item 1.ProtocolIE-SingleContainer.value.DRBs-ToBeSetup-Item.qoSInformation.choice-extension.value.DRB-Information.sNSSAI.sST = 01
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.DRBs-ToBeSetup-List.Item 1.ProtocolIE-SingleContainer.value.DRBs-ToBeSetup-Item.uLUPTNLInformation-ToBeSetup-List = 1 item

# filter: nokiaf1ap.procedureCode == 5 and nokiaf1ap.DRBs_Setup_List == 2 and nokiaf1ap.dLUPTNLInformation_ToBeSetup_List == 1
# DL TEIDs allocated for the 2 DRBs in gNB-DU are received in CU-CP in the F1AP: UEContextSetupResponse.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 5
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 5.ProtocolIE-Field.value.DRBs-Setup-List = 2 items
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 5.ProtocolIE-Field.value.DRBs-Setup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-Setup-Item.dLUPTNLInformation-ToBeSetup-List = 1 item
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 5.ProtocolIE-Field.value.DRBs-Setup-List.Item 1.ProtocolIE-SingleContainer.value.DRBs-Setup-Item.dLUPTNLInformation-ToBeSetup-List = 1 item

# filter: nr-rrc.c1 == 1  and nr-rrc.srb_ToAddModList == 2 and nr-rrc.drb_ToAddModList == 2 and nr-rrc.measIdToAddModList == 1
# CU-CP builds RRCResume message with necessary SRB/DRB bearers and measurements configuration as for RRCSetup establishment and sends it to gNB-DU,gNB-DU sends RRCResume message to UE.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1 = 1
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcResume.criticalExtensions.rrcResume.measConfig.measIdToAddModList = 1 item
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcResume.criticalExtensions.rrcResume.radioBearerConfig.drb-ToAddModList = 2 items
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcResume.criticalExtensions.rrcResume.radioBearerConfig.srb-ToAddModList = 2 items

# filter: nr-rrc.c1 == 4 and nokiaf1ap.procedureCode == 13
# UE1 receives RRCResume and configures itself according to received radio bearer config and measurement config and sends back to gNB-DU RRCResumeComplete 
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 13
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 4

# filter: nr-rrc.eventId == 1 and nr-rrc.sCellToAddModList == 2 and nr-rrc.physCellId == 51 and nr-rrc.physCellId == 63
# after UE1 send A1 MR, 3CC interGNB CA (scell:cell2_2+cell2_14) is setup, GNB send UE1 MSG:rrcReconfiguration with A2 measConfig.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.2   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 1
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.2   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToAddModList = 2 items
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.2   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 51
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.2   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToAddModList.Item 1.SCellConfig.sCellConfigCommon.physCellId = 63

# filter: nr-rrc.c1 == 0 and nr-rrc.resumeCause == 8
# UE2 is triggered by RNA update by update due to RANAC change in gNB, sending 'RRCResumeRequest1' and resumeCause = 'rna-Update'.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH1-Message.message.c1 = 0
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH1-Message.message.c1.rrcResumeRequest1.rrcResumeRequest1.resumeCause = 8

# filter: nokiaf1ap.procedureCode == 6 and nr-rrc.c1 == 2
# gNB-CU-CP builds suspendConfig IE and RRCRelease message(c1: rrcRelease (2)) and sends it to gNB-DU in UEContextReleaseCommand.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 6
    #ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1 = 2

