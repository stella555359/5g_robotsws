[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nokiaf1ap.procedureCode == 191 and nokiaf1ap.XpConnectionStatus == 1
#XP link setup successfully between gNB-2 and sim gNB-4
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 191
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.XpConnectionStatusNotification.protocolIEs.Item 2.ProtocolIE-Field.value.XpConnectionStatus = 1

# filter: nokiaxnap.procedureCode == 138 and nokiaxnap.CellLoadReportingPeriodicity == 0 and nokiaxnap.IgNBCAXpProtocolVersion == 1000 and nokiaxnap.IgNBCAXgUProtocolVersion == 1
#send Incompatible IgNBCAXpProtocolVersion 
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 138
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 4.ProtocolIE-Field.value.CellLoadReportingPeriodicity = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 5.ProtocolIE-Field.value.IgNBCAXpProtocolVersion = 1000
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 6.ProtocolIE-Field.value.IgNBCAXgUProtocolVersion = 1

# filter: nokiaf1ap.procedureCode == 3
#GNBDUConfigurationUpdate
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 3

# filter: nokiaf1ap.procedureCode == 3
#GNBDUConfigurationUpdateAcknowledge
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 3

# filter: nokiaxnap.protocolIEs == 0
#gNB-2-CU-CP sends XnAP: IGNB CA REMOVAL REQUEST to gNB4-CU-CP
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCARemovalRequest.protocolIEs = 0 items

# filter: nokiaxnap.protocolIEs == 0
##gNB4-CU-CP replies XnAP: IGNB CA REMOVAL RESPONSE to gNB2-CU-CP
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCARemovalResponse.protocolIEs = 0 items

# filter: nokiaf1ap.procedureCode == 202 and nokiaf1ap.gnb_ID == 00:00:8c
#gNB2-CU-CP sends F1AP: IGNB CA XP REMOVAL REQUEST to gNB2-DU and sets internal status of Xp link as unavailable
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 202
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAXpRemovalRequest.protocolIEs.Item 1.ProtocolIE-Field.value.NEID.globalgNB-ID.gnb-id.gnb-ID_pre = 00008c 

# filter: nokiaf1ap.procedureCode == 202 and nokiaf1ap.gnb_ID == 00:00:8c
#gNB2-DU unsubscribes in XPIF component for Xp link status notifications and replies with F1AP: IGNB CA XP REMOVAL RESPONSE to gNB2-CU-CP
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.procedureCode = 202
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAXpRemovalResponse.protocolIEs.Item 1.ProtocolIE-Field.value.NEID.globalgNB-ID.gnb-id.gnb-ID_pre = 00008c 

