[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
#Step a: NSA UE92 CA blind: F(NRCELL-2 PCI=51)+T(NRCELL-12 PCI=61)
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 51
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 61
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellIndex = 9


# Step b: NSA UE92 CA blind: RRC release  10 is Normal-release.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 10

#Step c: NSA UE92 CA coverbased scell add: T(NRCELL-1 PCI=50), A1 is configured:
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA1.a1-Threshold.rsrp = 75

# Step d: NSA UE92 A1 MR is triggerd, rsrp 120 and scell NRCELL-2 PCI=61 selected,A2 for scell release is configured
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.physCellId = 50
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 61
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellIndex = 9
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA2.a2-Threshold.rsrp = 34

# Step e: NSA UE92 A2 MR is triggerd. scell NRCELL-2 PCI=51 is removed and A1 for scell add is configured.
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 1.MeasResultServMO.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrp = 7
    ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 1.MeasResultServMO.measResultServingCell.physCellId = 61
    ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.physCellId = 50
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.sCellToReleaseList.Item 0.SCellIndex = 9
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA1.a1-Threshold.rsrp = 75

# Step f: NSA UE92 A1 MR is triggerd, rsrp 90 and scell NRCELL-12 PCI=61 selected,A2 for scell release is configured
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.physCellId = 50

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 61
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellIndex = 9
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA2.a2-Threshold.rsrp = 34


# Step g: NSA UE92 A2 MR is triggerd. scell NRCELL-13 PCI=62 is removed and A1 for scell add is configured.
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 1.MeasResultServMO.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrp = 7
    ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 1.MeasResultServMO.measResultServingCell.physCellId = 61
    ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.physCellId = 50
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.sCellToReleaseList.Item 0.SCellIndex = 9
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA1.a1-Threshold.rsrp = 75
