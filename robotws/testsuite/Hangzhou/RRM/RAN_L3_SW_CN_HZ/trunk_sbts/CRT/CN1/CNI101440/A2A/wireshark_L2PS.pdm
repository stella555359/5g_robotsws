[Global]
RELATION: CP1
BLOCKSIZE: -1

#For actSmallestRRCSetup false and RRE has PCMD cookie, ueDedicatedConfigState in SYSCOM msg is disable->disable->inprogress
[CP1]
# filter: itf_l2_ps_user_UserSetupReq_t.ueDedicatedConfigState_item == 0
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usersetupreq.itf_l2_ps_user_UserSetupReq_t.ueDedicatedConfigState (StaticOptional).ueDedicatedConfigState_item_0 (itf_l2_ps_user_UeDedicatedConfigState) = 0

ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.reestablishmentCause = *

# filter: itf_l2_ps_user_UserModifyReq_t.ueDedicatedConfigState_item == 0
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.ueDedicatedConfigState (StaticOptional).ueDedicatedConfigState_item_0 (itf_l2_ps_user_UeDedicatedConfigState) = 0
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.cookie (StaticOptional).cookie_item_0 (Uint32) = *

# filter: itf_l2_ps_user_UserModifyReq_t.ueDedicatedConfigState_item == 1
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_usermodifyreq.itf_l2_ps_user_UserModifyReq_t.ueDedicatedConfigState (StaticOptional).ueDedicatedConfigState_item_0 (itf_l2_ps_user_UeDedicatedConfigState) = 1

