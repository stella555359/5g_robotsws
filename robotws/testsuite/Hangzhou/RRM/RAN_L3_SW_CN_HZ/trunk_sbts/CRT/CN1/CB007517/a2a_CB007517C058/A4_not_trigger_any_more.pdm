[Global]

RELATION: CP1

BlOCKSIZE: -1



[CP1]
#UE registers successfully and PDU session is setup successfully on cell 11 and A2 should be configured
#f1ap:eventA4 trigger
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.Item 0.DRB-ToAddMod.cnAssociation.sdap-Config.pdu-Session = 1
	arrival_time = _x
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 1
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 1
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.measIdToAddModList.Item 1.MeasIdToAddMod.measId = 2
ethernet.ipv6.sctp.f1ap	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 3
	arrival_time = x+9~x+11
#Trigger A2 MR in cell11 during a4SupervisionTimer is running.
ethernet.ipv6.sctp.f1ap	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 1.ReportConfigToAddMod.reportConfig.reportConfigInterRAT.reportType.eventTriggered.eventId = 1
	
#Trigger A1 MR. A1/B2 will deconfiged, A2 trigger.
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 1
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.Item 1.MeasId = 5
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.Item 0.MeasId = 4
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 6
	
#Trigger A2 MR, A1/B2 config triggered, A2 deconfiged.
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.11  ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 1.MeasIdToAddMod.measId = 8
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.11  ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 7
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.11  ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.Item 0.MeasId = 6
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.11  ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 1.ReportConfigToAddMod.reportConfig.reportConfigInterRAT.reportType.eventTriggered.eventId = 1
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.11  ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 0

ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.HandoverRequired.protocolIEs.Item 5.ProtocolIE-Field.value.PDUSessionResourceListHORqd.Item 0.PDUSessionResourceItemHORqd.pDUSessionID = 1
ethernet.ip.sctp.ngap	
	ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.HandoverCommand.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceHandoverList.Item 0.PDUSessionResourceHandoverItem.pDUSessionID = 1

ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 10
	
#F1AP:HO from LTE back to NR
ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 32
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 7.ProtocolIE-Field.value.PDUSessionResourceSetupListHOReq.Item 0.PDUSessionResourceSetupItemHOReq.pDUSessionID = 1

ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceAdmittedList.Item 0.PDUSessionResourceAdmittedItem.pDUSessionID = 1
	arrival_time = _y
	
	
#F1AP:A4 config trigger 5 times as configured	
ethernet.ipv6.sctp.f1ap	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 3
	arrival_time = y+9~y+11
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 1
