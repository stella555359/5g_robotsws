[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# BufferMonitoringNotification, check CB008311 enable and start Buffer Monitoring
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# itf_l2_ps_user_DlBufferMonitoringInd_t,check value of dlSCellConfigLevel and dlSCellConfigLevelNum
# filter: itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevel == 10 and itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevelNum == 20
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_dlbuffermonitoringind.itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevel (Uint8) = 10
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_dlbuffermonitoringind.itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevelNum (Uint8) = 20

# BufferCriterionNotification, check DU sends private unacknowledged F1AP message to inform CU DL buffer 
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

#gNB configures FDD Cell 11 as scell at the UE.
# filter: nr-rrc.physCellId == 60 and nr-rrc.sCellIndex == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 60
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellIndex = 1

# After A1 MR for scell change.scell change from FDD CELL 11 to TDD CELL3.
# filter: nr-rrc.physCellId == 52 and nr-rrc.sCellIndex == 2
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 52
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellIndex = 2

