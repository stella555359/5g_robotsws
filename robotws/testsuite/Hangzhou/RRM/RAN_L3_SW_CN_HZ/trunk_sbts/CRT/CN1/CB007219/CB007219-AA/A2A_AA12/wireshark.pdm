[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# UE Context Modification Request:SCell-ToBeSetupMod-List IE should include all scells,CUtoDURRCInformation CG-ConfigInfo-allowedBC-ListMRDC BandCombinationInfo IE should include the correct BC and FSEI
# filter: nr-rrc.bandCombinationIndex == 15 and nr-rrc.FeatureSetEntryIndex == 1 and nokiaf1ap.sCellIndex == 1 and nokiaf1ap.sCellIndex == 2 and nokiaf1ap.sCellIndex == 3
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.configRestrictInfo.allowedBC-ListMRDC.Item 0.BandCombinationInfo.allowedFeatureSetsList.Item 0.FeatureSetEntryIndex = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.configRestrictInfo.allowedBC-ListMRDC.Item 0.BandCombinationInfo.bandCombinationIndex = 15
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.SCell-ToBeSetupMod-List.Item 0.ProtocolIE-SingleContainer.value.SCell-ToBeSetupMod-Item.sCellIndex = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.SCell-ToBeSetupMod-List.Item 1.ProtocolIE-SingleContainer.value.SCell-ToBeSetupMod-Item.sCellIndex = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.SCell-ToBeSetupMod-List.Item 2.ProtocolIE-SingleContainer.value.SCell-ToBeSetupMod-Item.sCellIndex = 3

# UE Context Modification Response:The new configuration for PCell and SCell with respective SCell frequency band in DUtoCURRCInformation-cellGroupConfig IE, DUtoCURRCInformation-selectedFeatureSetEntryIndex IE.
# filter: nr-rrc.sCellIndex == 1 and nr-rrc.physCellId == 50 and nr-rrc.FreqBandIndicatorNR == 77 and nr-rrc.sCellIndex == 2 and nr-rrc.physCellId == 52 and nr-rrc.FreqBandIndicatorNR == 77 and nr-rrc.sCellIndex == 3 and nr-rrc.physCellId == 60 and nr-rrc.FreqBandIndicatorNR == 66 and nokiaf1ap.SelectedFeatureSetEntryIndex == 00 and nokiaf1ap.SelectedBandCombinationIndex == 00:0e
