    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellIndex = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 1.SCellConfig.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 77
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 1.SCellConfig.sCellConfigCommon.physCellId = 52
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 1.SCellConfig.sCellIndex = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 2.SCellConfig.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 66
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 2.SCellConfig.sCellConfigCommon.physCellId = 60
