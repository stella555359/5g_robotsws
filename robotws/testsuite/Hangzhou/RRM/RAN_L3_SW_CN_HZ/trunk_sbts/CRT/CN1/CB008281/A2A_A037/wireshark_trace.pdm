[Global]
RELATION: CP1 & CP2 & CP3 & CP4
BlOCKSIZE: -1

[CP1]
#trace for E-CID MEASUREMENT INITIATION REQUEST:Measurement Quantity requested is ‘SS-RSRP’,Report Characteristics IE set to On-Demand 
# filter: nsetapx and nrppa.measurementQuantitiesValue == 6 and nrppa.ReportCharacteristics == 0
ethernet.ip.tcp.nsetap
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NG Application Protocol (DownlinkUEAssociatedNRPPaTransport).NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 1.ProtocolIE-Field.value.ReportCharacteristics = 0
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NG Application Protocol (DownlinkUEAssociatedNRPPaTransport).NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 0.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 6

[CP2]
#trace for RRCReconfiguration message
# filter: nr-rrc.rsType == 0 and nr-rrc.reportAmount == 0 and nr-rrc.includeBeamMeasurements == 1 and nr-rrc.measObjectId == 1 and nsetapx
ethernet.ip.tcp.nsetap
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measObjectId = 1
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.periodical.includeBeamMeasurements = True
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.periodical.reportAmount = 0
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.periodical.rsType = 0

[CP3]
#trace for E-CID MEASUREMENT INITIATION RESPONSE:servingCellTAC ,MeasuredResultsValue , sSB_Index , valueSS_RSRP.
# filter: nrppa.servingCellTAC == 0  and nrppa.MeasuredResultsValue == 5 and  nrppa.sSB_Index == 0  and  nrppa.valueSS_RSRP == 50 and nsetapx.carrierFreq == 633216 and nsetapx.triggerType == 6 and nsetapx.purpose == 8 and nsetapx
ethernet.ip.tcp.nsetap
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NG Application Protocol (UplinkUEAssociatedNRPPaTransport).NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue = choice-Extension (5): id-ResultSS-RSRP
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NG Application Protocol (UplinkUEAssociatedNRPPaTransport).NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue.choice-Extension.value.ResultSS-RSRP.Item 0.ResultSS-RSRP-Item.sS-RSRP-PerSSB.Item 0.sSB-Index = 0
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NG Application Protocol (UplinkUEAssociatedNRPPaTransport).NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue.choice-Extension.value.ResultSS-RSRP.Item 0.ResultSS-RSRP-Item.sS-RSRP-PerSSB.Item 0.valueSS-RSRP = 50
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NG Application Protocol (UplinkUEAssociatedNRPPaTransport).NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.servingCellTAC = 0x000000

[CP4]
#trace for ue measrecord.
# filter: nsetapx.carrierFreq == 633216 and nsetapx.triggerType == 6 and nsetapx.purpose == 8 and nsetapx
ethernet.ip.tcp.nsetap
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.vendorExtensionData.ver-Payload.CuVendorExtensionRecordDataType.ueMeasRecord.data-r1.carrierFreq = 633216
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.vendorExtensionData.ver-Payload.CuVendorExtensionRecordDataType.ueMeasRecord.data-r1.purpose = 8
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.vendorExtensionData.ver-Payload.CuVendorExtensionRecordDataType.ueMeasRecord.data-r1.triggerType = 6
