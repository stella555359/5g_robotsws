[Global]
RELATION: CP1|CP2
BlOCKSIZE: -1

[CP1]
#Step c: A1/A3 has been configured, A2/A4 has been deconfigured.Meas gap allocation or release is not needed.
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9  ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapFR1 = 0
	arrival_time = x+11~x+12
##Meas gap allocation or release is not needed.

[CP2]
#Step e: A1/A3 has been configured, A2/A4 has been deconfigured.Meas gap allocation or release is not needed.
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.13  ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapFR1 = 0
	arrival_time = x+81~x+83
##Meas gap allocation or release is not needed.



