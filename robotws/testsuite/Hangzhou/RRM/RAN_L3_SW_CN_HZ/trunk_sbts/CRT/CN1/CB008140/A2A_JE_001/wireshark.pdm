    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.procedureCode = 17
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.XnSetupResponse.protocolIEs.Item 0.ProtocolIE-Field.value.GlobalNG-RANNode-ID.gNB.gnb-id.gnb-ID_pre = 000008 

