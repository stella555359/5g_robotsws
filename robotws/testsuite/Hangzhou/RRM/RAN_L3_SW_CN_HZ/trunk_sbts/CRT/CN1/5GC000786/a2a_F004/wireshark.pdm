###after Trigger UE Video call release successfully, check drx setup
## F1AP: UEContextModificationResponse
# f1ap.procedureCode == 7 and nr-rrc.drx_Config == 1
# procedureCode: id-UEContextModification (7)
# drx-Config: setup (1)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 7
