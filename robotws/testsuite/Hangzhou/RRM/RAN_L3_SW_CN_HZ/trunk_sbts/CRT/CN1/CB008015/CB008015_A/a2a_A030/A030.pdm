#Triggered Scell cell-2 Release  by A2 Event
UL-DCCH-Message
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None_1.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrp = 20
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None_1.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrq = 20
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None_1.measResultServingCell.physCellId = 51
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.physCellId = 60

