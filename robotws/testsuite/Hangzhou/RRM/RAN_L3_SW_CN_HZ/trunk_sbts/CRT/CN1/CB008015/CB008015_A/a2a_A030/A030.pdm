    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrq = 110
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrp = 120

#Cell-2 is added as SCells
