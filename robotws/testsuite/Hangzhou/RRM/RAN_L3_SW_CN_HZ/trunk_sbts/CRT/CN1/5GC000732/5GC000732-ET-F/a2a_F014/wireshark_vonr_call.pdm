# from GNB to AMF: PDUSessionResourceModifyResponse
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PDUSessionResourceModifyResponse.protocolIEs.ProtocolIE-Field.value.PDUSessionResourceModifyListModRes.PDUSessionResourceModifyItemModRes.pDUSessionID = 1
