[Global]

RELATION: CP1 

BlOCKSIZE: -1

[CP1]

#A3 config during ICS:
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.ssbFrequency = 636576
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA3.a3-Offset.rsrp = 10
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 1.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA3.a3-Offset.rsrq = 10
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList = 2 items
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.s-MeasureConfig.ssb-RSRP = 1


#DRX setup after ICS：

ethernet.ipv6.sctp.f1ap

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup.drx-InactivityTimer = 4

	#A4 configure, MG setup, DRX release for first retryTimer expiry:

ethernet.ipv6.sctp.f1ap

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.ssbFrequency = 636768

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA4.reportOnLeave = True

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.s-MeasureConfig.ssb-RSRP = 127

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapUE.setup.mgl = 1

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapUE.setup.mgrp = 3

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 0

#RRE happen within A4 supervision

ethernet.ipv6.sctp.f1ap

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.s-MeasureConfig.ssb-RSRP = 1

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.Item 0.MeasId = 3
    arrival_time = _x


#DRX setup after RRE

ethernet.ipv6.sctp.f1ap

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1



#A4 configure after RRE

ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 3

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.s-MeasureConfig.ssb-RSRP = 127

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapUE.setup.mgl = 1

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapUE.setup.mgrp = 3

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 0
    arrival_time = x+25~x+26

#A4 deconfigure after RRE

ethernet.ipv6.sctp.f1ap

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.s-MeasureConfig.ssb-RSRP = 1

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapUE = 0

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.Item 0.MeasId = 3
    arrival_time = x+30~x+31

#DRX setup after A4 deconfigure

ethernet.ipv6.sctp.f1ap

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1


#RRE happen within retryTimer

ethernet.ipv6.sctp.f1ap

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToRemoveList.Item 0.MeasObjectId = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToRemoveList = 3 items
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList = 2 items
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.ssbFrequency = 636768
#    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.s-MeasureConfig.ssb-RSRP = 1
    arrival_time = _y

#A4 configure after RRE

ethernet.ipv6.sctp.f1ap

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.ssbFrequency = 636576
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA4.reportOnLeave = True
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.s-MeasureConfig.ssb-RSRP = 127
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapUE.setup.mgl = 5
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapUE.setup.mgrp = 2
    arrival_time = y+30~y+31

#NGAP--UEcontextReleasecommand

ethernet.ip.sctp

	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand = *
