[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# from GNB to AMF: UEContextReleaseRequest with cause user-inactivity
ethernet.ip.sctp.ngap
    ethernet.ip.source=10.0.1.2
    ethernet.ip.destination=10.0.1.1
    #radioNetwork: user-inactivity (20)
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.Item 3.ProtocolIE-Field.value.Cause.radioNetwork = 20

# from AMF to GNB: UEContextReleaseCommand with cause user-inactivity
ethernet.ip.sctp.ngap
    ethernet.ip.source=10.0.1.1
    ethernet.ip.destination=10.0.1.2
    #radioNetwork: user-inactivity (20)
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 20

# from GNB to AMF: UEContextReleaseComplete
ethernet.ip.sctp.ngap
    ethernet.ip.source=10.0.1.2
    ethernet.ip.destination=10.0.1.1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete = None
