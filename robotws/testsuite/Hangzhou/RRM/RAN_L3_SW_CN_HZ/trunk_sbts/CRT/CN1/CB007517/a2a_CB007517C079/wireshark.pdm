[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]

#RRC Reconfiguration with gapUE setup, and A4 MEAS config
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 3
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 1
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapUE = 1
	arrival_time = _x

#NGAP--UEcontextReleasecommand
ethernet.ip.sctp
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand = *
	arrival_time = x~x+5

#NGAP--UEcontextReleaseCompleate
ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete = *
	arrival_time = x~x+5

	
