[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#F1AP: IGNB-CA UE CONTEXT MODIFICATION FAILURE send to prime-gNB CU with cause cell-not-available
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.PrivateIE-Field.value.Nokia-F1AP-PDU.unsuccessfulPrivateOutcome.value.IgNBCAUeContextModificationFailure.protocolIEs.ProtocolIE-Field.value.IgNB-CA-Cause.standardCause.radioNetwork = 11

#Pcell configured as large BWP.
ethernet.ipv6.sctp.f1ap.F1AP-PDU
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.downlinkBWP-ToAddModList.BWP-Downlink.bwp-Common.genericParameters.locationAndBandwidth = 28875

