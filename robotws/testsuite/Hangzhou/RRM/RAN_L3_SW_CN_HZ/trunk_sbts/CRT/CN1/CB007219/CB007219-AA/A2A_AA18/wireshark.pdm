[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# UE attach cell11 with band 2
# filter: nr-rrc.freqBandIndicatorNR == 2
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 2

# UE attach cell11 and selected bandcombination index is 0 
# filter: nokiaf1ap.SelectedBandCombinationIndex == 00:00 and nokiaf1ap.SelectedFeatureSetEntryIndex == 00
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.SelectedBandCombinationIndex = 0000
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.iE-Extensions.Item 1.ProtocolExtensionField.extensionValue.SelectedFeatureSetEntryIndex = 00

#trigger A1 MR for UE1
# filter: nr-rrc.measId == 1 and nr-rrc.criticalExtensions == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 1

#scell add with selected bandcombination index is 1
# filter: nokiaf1ap.SelectedBandCombinationIndex == 00:01
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.SelectedBandCombinationIndex = 0001

