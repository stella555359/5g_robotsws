    OnlineParamChange_gNB2    ${online_recover_AA41_gnb2}
    Common Test Teardown And Stop Capture Logs

UE Attach and Scell Add
    [Arguments]    ${ue_id}=1    ${SA_Capa_perUE_Full}=${N77_N78_N78_and_N66_N78_and_N66_N77_DL_extend_USA}
    ...    ${UEattach}=${UEattach_for_AA41_UE1}
    Update UE capa    ue_id=${ue_id}    SA_Capa_perUE_Full=${SA_Capa_perUE_Full}
    Ue register and pdu session setup    ue_id=${ue_id}    UEattach=${UEattach}    fail_check=freqBandIndicatorNR 66
    Send Throughput    ue_id=${ue_id}
    Wait Until Keyword Succeeds    30s    5s    Check Traffic    ue_id=${ue_id}    cell_num=2    min_dl_tput=180
    Release UEs    ue_type=all

