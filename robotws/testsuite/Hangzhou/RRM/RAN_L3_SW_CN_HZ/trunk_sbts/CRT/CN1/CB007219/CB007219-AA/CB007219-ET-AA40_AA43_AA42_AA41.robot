Check Traffic
    [Arguments]     ${ue_id}=1    ${cell_num}=1    ${min_dl_tput}=120    ${min_ul_tput}=8
    ${ul_throuput}    Ap Get Throuput On Specific Scell    ue_id=${ue_id}    scell_id=0    type=pusch    rate_type=ave
    ${total_dl_tput}    Set Variable    0
    FOR    ${index}    IN RANGE    0    ${cell_num}
         ${str_index}    Convert To String    ${index}
         ${scell_tput}    Ap Get Throuput On Specific Scell    ${ue_id}    ${str_index}    pdsch
         Should Be True    ${scell_tput}/1000 > 10
         ${total_dl_tput}    Evaluate    ${scell_tput}+${total_dl_tput}
    END
    Should Be True    ${total_dl_tput}/1000 > ${min_dl_tput}
    Should Be True    ${ul_throuput}/1000 > ${min_ul_tput}

Send Throughput
    [Arguments]    ${ue_id}=1    ${times}=3
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=ul mbps=10 trf_id=1    UE ${ue_id}: UDP UL
    FOR    ${I}    IN RANGE    1    ${times}
        Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=150 trf_id=${I}    UE ${ue_id}: UDP DL
    END

Enable testmode for TT
    [Arguments]    ${ue_id}=1     ${scell_id1}=1
    Execute Egate Command    csi_override_testmode_nr profile_id=1 cqi_mode=fixed cqi=15 ri_mode=fixed ri=1
    sleep    1s    #sleep for stable traffic
    Execute Egate Command    csi_override_testmode_nr profile_id=2 cqi_mode=fixed cqi=15 ri_mode=fixed ri=3
    sleep    1s    #sleep for stable traffic
    Execute Egate Command    ue_testmode_set_nr id=${ue_id} testmode=csi_override action=activate profile_id=1 scell=0
    sleep    1s    #sleep for stable traffic
    Execute Egate Command    ue_testmode_set_nr id=${ue_id} testmode=csi_override action=activate profile_id=2 scell=${scell_id1}
    sleep    1s    #sleep for stable traffic

UE register and pdu session setup and check traffic for AA43
    [Arguments]    ${UEattach}    ${ue_id}=1    ${enb}=2    ${cell_id}=1
    Update UE capa    ue_id=${ue_id}    SA_Capa_perUE_Full=${N77_N78_and_N78_N78_and_N78_N77}
    Ue register and pdu session setup    UEattach=${UEattach}    ue_id=${ue_id}    enb=${enb}    cell_id=${cell_id}
    Send Throughput    ue_id=${ue_id}
    Wait Until Keyword Succeeds    30s    5s    Check Traffic    ue_id=${ue_id}    cell_num=2    min_dl_tput=160
    Release UEs    ue_type=all
	
UE1 Attach and Scell Add For AA42
    OnlineParamChange_gNB2    ${online_modify_AA42_gnb2}
    OnlineParamChange_gNB2    ${online_modify_disable_7219}    #trigger timer set
    OnlineParamChange_gNB2    ${online_modify_enable_7219}
    Update UE capa    SA_Capa_perUE_Full=${N77_N78_N78_and_N66_N78_and_N66_N77_DL}
    Ue register and pdu session setup    cell_id=2    UEattach=${UEattach_for_AA42_UE1}    fail_check=${UEattach_Fail_for_AA40_AA42}
    Send Throughput    ue_id=1
    Wait Until Keyword Succeeds    30s    5s    Check Traffic    ue_id=1    cell_num=2    min_dl_tput=160
	
UE2 Attach and Scell Add For AA42
    Sleep    30s    #wait for iGnbCaXnCfUpBackOffTmr timeout
    OnlineParamChange_gNB2    ${online_modify_disable_7219}
    Update UE capa    ue_id=2    SA_Capa_perUE_Full=${N77_100M_none_20M_N78_N78_and_N66_N78_and_N66_N77_DL}
    Ue register and pdu session setup    ue_id=2    cell_id=2    UEattach=${UEattach_for_AA42_UE2}    fail_check=${UEattach_Fail_for_AA42_UE2}
    Send Throughput    ue_id=2
    Wait Until Keyword Succeeds    30s    5s    Check Traffic    ue_id=2    cell_num=1    min_dl_tput=80
	
AA42_Teardown
    OnlineParamChange_gNB2    ${online_recover_AA42_gnb2}
    Common Test Teardown And Stop Capture Logs

OnlineParamChange_gNB2
