[Global]
RELATION: CP1 & CP2 & CP3
BLOCKSIZE: -1

#Check Relative AMF Capacity and GUAMIs are supported in NGAP
[CP1]
# AMF1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.pLMNIdentity = 134198
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.aMFRegionID = bit length 8, 0000 0001 decimal value 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.aMFSetID = bit length 10, 6 LSB pad bits, 0000 0000  01.. .... decimal value 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.aMFPointer = bit length 6, 2 LSB pad bits, 0000 01.. decimal value 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.RelativeAMFCapacity = 50

[CP2]
# AMF2
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.pLMNIdentity = 134198
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.aMFRegionID = bit length 8, 0000 0010 decimal value 2
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.aMFSetID = bit length 10, 6 LSB pad bits, 0000 0000  01.. .... decimal value 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.aMFPointer = bit length 6, 2 LSB pad bits, 0000 01.. decimal value 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.RelativeAMFCapacity = 100

[CP3]
# AMF3
ethernet.ipv6.sctp.ngap
    ethernet.ipv6.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.pLMNIdentity = 134198
    ethernet.ipv6.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.aMFRegionID = bit length 8, 0000 0011 decimal value 3
    ethernet.ipv6.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.aMFSetID = bit length 10, 6 LSB pad bits, 0000 0000  01.. .... decimal value 1
    ethernet.ipv6.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.ServedGUAMIList.Item 0.ServedGUAMIItem.gUAMI.aMFPointer = bit length 6, 2 LSB pad bits, 0000 01.. decimal value 1
    ethernet.ipv6.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.RelativeAMFCapacity = 10


