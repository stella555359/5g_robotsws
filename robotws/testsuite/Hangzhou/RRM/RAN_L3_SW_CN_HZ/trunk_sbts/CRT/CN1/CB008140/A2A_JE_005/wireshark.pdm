[Global]
RELATION: CP1&CP2&CP3&CP4
BlOCKSIZE: -1

[CP1]
# filter: nokiaf1ap.procedureCode == 191 and nokiaf1ap.XpConnectionStatus == 0
#gNB-2-DU sends F1AP: XP CONNECTION STATUS NOTIFICATION message to gNB-2-CU-CP to indicate that Xp-C link towards gNB-3 is unavailable
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 191
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.XpConnectionStatusNotification.protocolIEs.Item 2.ProtocolIE-Field.value.XpConnectionStatus = 0

# filter: nokiaxnap.procedureCode == 138 and nokiaxnap.cell_Availability == 0 and nokiaxnap.cell_Availability == 0 and nokiaxnap.numberOfActiveUEs == 3
#gNB-2-CU-CP sends towards gNB-3-CU-CP XNAP: IGNB CA CONFIGURATION UPDATE INDICATION with Cell2_1 and Cell2_2 present on ReportedCellList with cell-Availability IE set to ‘unavailable’.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 138
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.cell-Availability = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.numberOfActiveUEs = 3
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 1.CellReportItem.cell-Availability = 0

# filter: nokiaf1ap.procedureCode == 0 and nokiaf1ap.ResetType == 1 and nokiaf1ap.id == 80
#gNB-2-CU-CP sends F1AP: RESET towards gNB-2-DU with ‘partOfF1-Interface->UE-associatedLogicalF1-ConnectionListRes’
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.id = 80

# filter: nokiaf1ap.procedureCode == 0 and nokiaf1ap.id == 81
#gNB-2-DU releases all resources allocated for UE contexts and IgNB CA UE contexts requested to be released and replies with F1AP: RESET ACKNOWLEDGE
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.id = 81

# filter: nokiaf1ap.procedureCode == 191 and nokiaf1ap.XpConnectionStatus == 1
#gNB-2-DU sends F1AP: XP CONNECTION STATUS NOTIFICATION message to gNB-2-CU-CP to indicate that Xp-C link towards gNB-3 is available
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 191
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.XpConnectionStatusNotification.protocolIEs.Item 2.ProtocolIE-Field.value.XpConnectionStatus = 1

# filter: nokiaxnap.procedureCode == 138 and nokiaxnap.cell_Availability == 1 and nokiaxnap.cell_Availability == 1 and nokiaxnap.NR-Cell-Identity == 0x0000004001 and nokiaxnap.NR-Cell-Identity == 0x0000004002
#gNB-2-CU-CP sends towards gNB-3-CU-CP XNAP: IGNB CA CONFIGURATION UPDATE INDICATION with Cell2_1 and Cell2_2 present on ReportedCellList with cell-Availability IE set to ‘available’
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 138
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.cell-Availability = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.nr-cell.nr-CI = 0x0000004001
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 1.CellReportItem.cell-Availability = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 1.CellReportItem.nr-cell.nr-CI = 0x0000004002

[CP2]
# filter: e1ap.procedureCode == 0 and e1ap.ResetType == 1 and e1ap.id == 5
# gNB-2-CU-CP sends E1AP: RESET towards gNB-2-CU-UP with ‘partOfE1-Interface->UE-associatedLogicalE1-ConnectionListRes’
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 0.ProtocolIE-Field.id = 57
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface.Item 0.ProtocolIE-SingleContainer.id = 5

# filter: e1ap.procedureCode == 0 and e1ap.id == 6
#gNB-2-CU-UP releases all resources allocated for UE contexts requested to be released and replies with E1AP: RESET ACKNOWLEDGE
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.procedureCode = 0
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.id = 6

[CP3]
# filter: nokiaxnap.procedureCode == 20 and nokiaxnap.ResetRequestTypeInfo == 1 and nokiaxnap.ue_contexts_ToBeReleasedList == 1
#gNB-2-CU-CP sends XnAP: RESET REQUEST towards gNB-3-CU-CP with ‘partialReset-> ResetRequestTypeInfo-Partial->ue-contexts-ToBeReleasedList’
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.procedureCode = 20
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo.partialReset.ue-contexts-ToBeReleasedList = 1 item

# filter: nokiaxnap.procedureCode == 20 and nokiaxnap.ResetResponseTypeInfo == 1
#gNB-3-CU-CP replies with XnAP: RESET RESPONSE
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.procedureCode = 20
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo = 1

[CP4]
# filter: ngap.procedureCode == 20 and ngap.ResetType == 1
#gNB-2-CU-CP sends NGAP: NG RESET towards AMF with ‘partOfNG-Interface->UE-associatedLogicalNG-ConnectionListRes’
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 20
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType = 1

# filter: ngap.procedureCode == 20 and ngap.id == 111
#AMF replies with NGAP: NG RESET ACKNOWLEDGE
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 20
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 111

