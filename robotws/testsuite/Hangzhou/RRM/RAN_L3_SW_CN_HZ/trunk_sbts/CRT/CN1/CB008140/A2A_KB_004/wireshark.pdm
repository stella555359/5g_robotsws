[Global]
RELATION: CP1&CP2&CP3&CP4&CP5
BlOCKSIZE: -1

[CP1]
#Ext-gNB2-CU-CP sends the Xn: Reset Request to gNB1 over Xn, Reset Type shall be set to ‘Partial Reset’
# filter: nokiaxnap.ResetRequestTypeInfo == 1 and nokiaxnap.misc == 2
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 2

#gNB1 responses Xn: Reset Response to gNB2.
# filter: nokiaxnap.ResetResponseTypeInfo == 1 and nokiaxnap.ue_contexts_AdmittedToBeReleasedList == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo.partialReset.ue-contexts-AdmittedToBeReleasedList = 1 item

#IgNBCAConfigurationUpdateIndication received to cell-Availability is unavailable
# filter: nokiaxnap.procedureCode == 138 and nokiaxnap.NR-Cell-Identity == 0x0000008001 and nokiaxnap.cell_Availability == 0
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 138
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.cell-Availability = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.nr-cell.nr-CI = 0x0000008001

#cell2_1 deleted during scell locked
# filter: nokiaxnap.served_Cells_ToDelete_NR == 1 and nokiaxnap.NR-Cell-Identity == 0x0000008001
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.ConfigurationUpdateInitiatingNodeChoice.gNB.Item 0.ProtocolIE-Field.value.ServedCellsToUpdate-NR.served-Cells-ToDelete-NR = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.ConfigurationUpdateInitiatingNodeChoice.gNB.Item 0.ProtocolIE-Field.value.ServedCellsToUpdate-NR.served-Cells-ToDelete-NR.Item 0.NR-CGI.nr-CI = 0x0000008001

# filter: nokiaxnap.id == 58
#gNB1-CU-CP responses XnAP: NG-RAN NODE CONFIGURATION ACKNOWLEDGE to gNB2-CU-CP
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.NGRANNodeConfigurationUpdateAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 58

[CP2]
#Prime-gNB1-CU-CP sends the E1AP: RESET to prime-gNB1-CU-UP over E1, Reset Type shall be set to ‘Part of E1 interface’ 
# filter: e1ap.ResetType == 1 and e1ap.partOfE1_Interface == 1
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface = 1 item

#Prime-gNB1-CU-UP responds with E1AP: RESET ACKNOWLEDGE to prime-gNB1-CU-CP.
# filter: e1ap.id == 6
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.id = 6

[CP3]
#Ext-gNB2-CU-CP sends the NG RESET to AMF over NG, Reset Type shall be set to ‘Part of NG interface’
# filter: ngap.radioNetwork == 3 and ngap.ResetType == 1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause.radioNetwork = 3
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType = 1

#AMF responds with NG RESET ACKNOWLEDGE to Ext-gNB2-CU-CP
# filter: ngap.protocolIEs == 1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs = 1 item

[CP4]
#Prime-gNB1-CU-CP sends the F1AP: RESET to prime-gNB1-DU over F1, Reset Type is set to ‘Part of F1 interface’ 
# filter: nokiaf1ap.ResetType == 1 and nokiaf1ap.partOfF1_Interface == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface = 1 item

#Prime-gNB1-DU responds with F1AP: RESET ACKNOWLEDGE to prime-gNB1-CU-CP.
# filter: nokiaf1ap.UE_associatedLogicalF1_ConnectionListResAck == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.UE-associatedLogicalF1-ConnectionListResAck = 1 item

[CP5]
#gNB2 sends XnAP: NG-RAN NODE CONFIGURATION UPDATE indicating Cell2_1 addition to gNB1
# filter: nokiaxnap.served_Cells_ToAdd_NR == 1 and nokiaxnap.NR-Cell-Identity == 0x0000008001
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.ConfigurationUpdateInitiatingNodeChoice.gNB.Item 0.ProtocolIE-Field.value.ServedCellsToUpdate-NR.served-Cells-ToAdd-NR = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.ConfigurationUpdateInitiatingNodeChoice.gNB.Item 0.ProtocolIE-Field.value.ServedCellsToUpdate-NR.served-Cells-ToAdd-NR.Item 0.ServedCells-NR-Item.served-cell-info-NR.cellID.nr-CI = 0x0000008001

#gNB1 responses XnAP: NG-RAN NODE CONFIGURATION ACKNOWLEDGE to gNB2
# filter: nokiaxnap.id == 58
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.NGRANNodeConfigurationUpdateAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 58

#gNB2 sends XnAP: IGNB CA CONFIGURATION UPDATE INDICATION with IE cell-Availability indicating Cell2_1 available to gNB1
# filter: nokiaxnap.NR-Cell-Identity == 0x0000008001 and nokiaxnap.cell_Availability == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.cell-Availability = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.nr-cell.nr-CI = 0x0000008001
