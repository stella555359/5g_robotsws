    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 4 = id-SRBID

#F1AP:UEContextReleaseComplete    
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 0 = id-gNB-CU-UE-F1AP-ID
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 1 = id-gNB-DU-UE-F1AP-ID

