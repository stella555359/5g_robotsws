[Global]
RELATION: CP1 & CP2
BlOCKSIZE: -1

[CP1]
#Xnap:IgNBCAAdditionRequest
ethernet.ip.sctp.xnap.XnAP-PDU
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 10.ProtocolIE-Field.value.SCell-For-IgNB-CA-Establishment-ToBeSetup-List.Item 0.SCell-For-IgNB-CA-Establishment-ToBeSetup-Item.sCell-ID = None
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 10.ProtocolIE-Field.value.SCell-For-IgNB-CA-Establishment-ToBeSetup-List.Item 0.SCell-For-IgNB-CA-Establishment-ToBeSetup-Item.sCellIndex = 1
    
    
#Xnap:ErrorIndication; triggeringMessage = 0 means triggeringMessage: initiating-message (0);procedureCode = 13 means procedureCode: id-privateMessage (13)   
ethernet.ip.sctp.xnap.XnAP-PDU
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ErrorIndication.protocolIEs.Item 3.ProtocolIE-Field.value.CriticalityDiagnostics.triggeringMessage = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ErrorIndication.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 13

#F1AP:UEContextReleaseCommand    
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 0 = id-gNB-CU-UE-F1AP-ID
