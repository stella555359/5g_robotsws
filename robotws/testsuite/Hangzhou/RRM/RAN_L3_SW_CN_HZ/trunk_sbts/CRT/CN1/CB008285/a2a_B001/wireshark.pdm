[Global]
RELATION: CP1 
BlOCKSIZE: -1


[CP1]
#RRCReestablishmentRequest/Initial UL RRC Message Transfer   
# filter: nr-rrc.reestablishmentCause == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.reestablishmentCause = 0

#e1ap.BearerContextModificationRequest_element &&e1ap.pDU_Session_ID == 1 && e1ap.dRB_ID == 4	
# filter: e1ap.pDU_Session_ID == 1 and e1ap.dRB_ID == 4
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.System-BearerContextModificationRequest.nG-RAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.PDU-Session-Resource-To-Modify-List.Item 0.PDU-Session-Resource-To-Modify-Item.dRB-To-Modify-List-NG-RAN.Item 0.DRB-To-Modify-Item-NG-RAN.dRB-ID = 4
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.System-BearerContextModificationRequest.nG-RAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.PDU-Session-Resource-To-Modify-List.Item 0.PDU-Session-Resource-To-Modify-Item.pDU-Session-ID = 1

#F1AP DL RRC Message Transfer/RRC RRCReestablishment message
# filter: nr-rrc.nextHopChainingCount == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 4.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReestablishment.criticalExtensions.rrcReestablishment.nextHopChainingCount = 0
 
#E1AP Bearer Context Modification Response
# filter: e1ap.dRB_ID == 4
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationResponse.nG-RAN-BearerContextModificationResponse.Item 0.ProtocolIE-Field.value.PDU-Session-Resource-Modified-List.Item 0.PDU-Session-Resource-Modified-Item.dRB-Modified-List-NG-RAN.Item 0.DRB-Modified-Item-NG-RAN.dRB-ID = 4
	
#F1AP: RRCReestablishmentComplete
# filter: nr-rrc.criticalExtensions == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcReestablishmentComplete.criticalExtensions = 0


#nr-rrc.rrcReconfiguration_element && nr-rrc.srb_ToAddModList == 1
# filter: nr-rrc.drb_Identity == 4 and nr-rrc.reestablishPDCP == 0 and nr-rrc.srb_Identity == 2 and nr-rrc.reestablishRLC == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.rlc-BearerToAddModList.Item 1.RLC-BearerConfig.reestablishRLC = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.rlc-BearerToAddModList.Item 1.RLC-BearerConfig.servedRadioBearer.drb-Identity = 4
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.rlc-BearerToAddModList.Item 2.RLC-BearerConfig.reestablishRLC = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.rlc-BearerToAddModList.Item 2.RLC-BearerConfig.servedRadioBearer.srb-Identity = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.Item 0.DRB-ToAddMod.drb-Identity = 4
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.Item 0.DRB-ToAddMod.reestablishPDCP = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.srb-ToAddModList.Item 0.SRB-ToAddMod.reestablishPDCP = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.srb-ToAddModList.Item 0.SRB-ToAddMod.srb-Identity = 2

#F1AP UL RRC Message Transfer/RRC RRCReconfigurationComplete
# filter: nr-rrc.criticalExtensions == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcReconfigurationComplete.criticalExtensions = 0

