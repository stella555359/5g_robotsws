[Global]
RELATION: CP2
BlOCKSIZE: -1

[CP2]
#step a:SA UE81 attach to NRCELL-2 successfully ,Pcell is configured with 4 CSI-RS to UE ,aCSI is not configured to the UE.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.csi-MeasConfig.setup.aperiodicTriggerStateList.setup = 1 item

#step c:cell4 added as scell, ACSI is not configured to UE, TDD SCell1 is configured with 1 CSI-RS.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.csi-MeasConfig.setup.aperiodicTriggerStateList.setup = 1 item

#step d:scell swap to cell1, ACSI is not configured to UE, TDD SCell2 is configured with 2 CSI-RS.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.csi-MeasConfig.setup.aperiodicTriggerStateList.setup = 1 item

#step e:scell swap to cell4, ACSI is not configured to UE, TDD SCell1 is configured with 1 CSI-RS.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.csi-MeasConfig.setup.aperiodicTriggerStateList.setup = 1 item
