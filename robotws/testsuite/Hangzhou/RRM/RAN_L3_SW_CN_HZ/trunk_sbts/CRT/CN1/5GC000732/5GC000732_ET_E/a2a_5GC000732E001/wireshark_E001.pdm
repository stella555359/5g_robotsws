[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
#will trigger fallback：
#Step 1:RRCReestablishmentRequest
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.reestablishmentCause = 1

#Step 2:UEContextReleaseRequest with cause radioNetwork = 0(unspecified)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 0

	
#Step 3:UEContextReleaseCommand with cause radioNetwork = 0(unspecified)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 0

#F1AP: RRCReestablishmentRequest
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.reestablishmentCause = 1

#F1AP: RRCSetup	
ethernet.ipv6.sctp.f1ap	
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup = *

#F1AP: RRCSetupComplete	
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcSetupComplete = *

#F1AP: RRCReconfiguration	
ethernet.ipv6.sctp.f1ap	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.3   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration = *

#F1AP: RRCReconfigurationComplete	
ethernet.ipv6.sctp.f1ap	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.4   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcReconfigurationComplete = *
	