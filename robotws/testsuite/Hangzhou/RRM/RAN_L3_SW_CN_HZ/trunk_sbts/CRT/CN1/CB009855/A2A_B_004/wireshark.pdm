[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#UE1 apercsi setup
# filter: nokiaf1ap.GNB_CU_UE_F1AP_ID == ${RAN_UE1_NGAP_ID} and nr-rrc.aperiodicTriggerStateList == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 0.ProtocolIE-Field.value.GNB-CU-UE-F1AP-ID = ${RAN_UE1_NGAP_ID}
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.spCellConfigDedicated.csi-MeasConfig.setup.aperiodicTriggerStateList = 1

#UE1 apercsi release when UE CA
# filter: nokiaf1ap.GNB_CU_UE_F1AP_ID == ${RAN_UE1_NGAP_ID} and nr-rrc.aperiodicTriggerStateList == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 0.ProtocolIE-Field.value.GNB-CU-UE-F1AP-ID = ${RAN_UE1_NGAP_ID}
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.spCellConfigDedicated.csi-MeasConfig.setup.aperiodicTriggerStateList = 0

#UE1 is configured with CSIRS_ResourceID 0 181 182 183 with nrofPorts: p8 at ICS, pCSI for channel acquisition and pCSI for beam management are report in a bundle for PCell.
