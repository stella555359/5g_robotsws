[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nokiaf1ap.procedureCode == 7 and nokiaf1ap.misc == 1
# when the number of incoming CA relations for scell cell1 is beyond the supported limit, gNB-DU rejects to add cell1 as SCell for a UE with MSG:'UEContextModificationFailure' only if this would require the creation of another incoming CA relation. 
# misc: not-enough-user-plane-processing-resources (1)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.unsuccessfulOutcome.procedureCode = 7
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.unsuccessfulOutcome.value.UEContextModificationFailure.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.misc = 1

