# filter: nr-rrc.drx_Config == 1 and nr-rrc.drx_HARQ_RTT_TimerUL == 14 and nr-rrc.drx_RetransmissionTimerUL == 2 and nr-rrc.c1 == 0 and nr-rrc.rrc_TransactionIdentifier == 3
