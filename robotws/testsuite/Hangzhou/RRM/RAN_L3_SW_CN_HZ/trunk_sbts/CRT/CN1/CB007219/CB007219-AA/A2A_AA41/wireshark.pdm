[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#check XnAP: IGNB CA CONFIGURATION UPDATE INDICATION message from gnb-1 to gnb-2, indicates support of FR1 CA with MFBI. 
# filter: nokiaxnap.MFBI_CA_Support == 0
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 6.ProtocolIE-Field.value.MFBI-CA-Support = 0

#UE1
#RRC with Pcell band 78
# filter: nr-rrc.freqBandIndicatorNR == 78
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 78

#IgNBCAAdditionRequest FR1 CA with MFBI is supported, Extended-Band is supported.
# filter: nokiaxnap.sCellIndex == 1 and nokiaxnap.MFBI_CA_Support == 0 and nokiaxnap.Extended_Band_Support == 40
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 11.ProtocolIE-Field.value.SCell-For-IgNB-CA-Establishment-ToBeSetup-List.Item 0.SCell-For-IgNB-CA-Establishment-ToBeSetup-Item.sCellIndex = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 13.ProtocolIE-Field.value.MFBI-CA-Support = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 14.ProtocolIE-Field.value.Extended-Band-Support_pre = 40 

#RRC Scell band 77, cell2-3 as scell
# filter: nr-rrc.freqBandIndicatorNR == 77 and nr-rrc.physCellId == 52
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextModificationResponse.protocolIEs.Item 3.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 77
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextModificationResponse.protocolIEs.Item 3.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 52

#check XnAP: IGNB CA CONFIGURATION UPDATE INDICATION message from gnb-1 to gnb-2, indicates support of FR1 CA with MFBI. 
# filter: nokiaxnap.MFBI_CA_Support == 0
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 6.ProtocolIE-Field.value.MFBI-CA-Support = 0

#UE2
#RRC with Pcell band 78
# filter: nr-rrc.freqBandIndicatorNR == 78
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 78

#IgNBCAAdditionRequest FR1 CA with MFBI is supported, Extended-Band is supported.
# filter: nokiaxnap.sCellIndex == 1 and nokiaxnap.MFBI_CA_Support == 0 and nokiaxnap.Extended_Band_Support == 80
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 11.ProtocolIE-Field.value.SCell-For-IgNB-CA-Establishment-ToBeSetup-List.Item 0.SCell-For-IgNB-CA-Establishment-ToBeSetup-Item.sCellIndex = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 13.ProtocolIE-Field.value.MFBI-CA-Support = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 14.ProtocolIE-Field.value.Extended-Band-Support_pre = 80 

#RRC Scell band 77, cell2-4 as scell
# filter: nr-rrc.freqBandIndicatorNR == 77 and nr-rrc.physCellId == 53
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextModificationResponse.protocolIEs.Item 3.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 77
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextModificationResponse.protocolIEs.Item 3.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 53

