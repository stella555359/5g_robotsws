[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]

#Verify SgNBModificationRequst
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.procedure_code = 29
	ethernet.ip.sctp.x2ap.id-MeNB-UE-X2AP-ID.ProtocolIE-Field.id = 111
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 46

#Verify 1st BearerContextModificationRequest(ULTEID,DLTEID)
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 9
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.ProtocolIE-Field.id = 18
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.ProtocolIE-Field.value.New-UL-TNL-Information-Required = 0
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.DRB-To-Modify-Item-EUTRAN.dL-UP-Parameters.UP-Parameters-Item.uP-TNL-Information = 0
	
 
#Verify 2nd BearerContextModificationRequest(NR UL data stop for both drb 3 and 5)
ethernet.ipv6.sctp.e1ap
#1st DRB
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 0.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 0.Cell-Group-Information-Item.dL-TX-Stop = 0
	
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 0.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 0.Cell-Group-Information-Item.rAT-Type = 1
#2nd DRB	
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 1.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 0.Cell-Group-Information-Item.dL-TX-Stop = 0
	
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 1.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 0.Cell-Group-Information-Item.rAT-Type = 1

#Verify SgNBModificationRequestAckknowledge
ethernet.ip.sctp.x2ap
	ethernet.ip.sctp.x2ap.value = SgNBModificationRequestAcknowledge
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 78

	
#Verify 3 BearerContextModificationRequest(NR UL data resume for both drb 3 and 5)
ethernet.ipv6.sctp.e1ap	
#1st DRB
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 0.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 0.Cell-Group-Information-Item.dL-TX-Stop = 1
		
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 0.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 0.Cell-Group-Information-Item.rAT-Type = 1
    
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 0.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 0.Cell-Group-Information-Item.uL-Configuration = 1
	
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 0.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 1.Cell-Group-Information-Item.uL-Configuration = 1

#2nd DRB
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 1.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 0.Cell-Group-Information-Item.dL-TX-Stop = 1
		
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 1.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 0.Cell-Group-Information-Item.rAT-Type = 1
	
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 1.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 1.Cell-Group-Information-Item.uL-Configuration = 1
	
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.e-UTRAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.DRB-To-Modify-List-EUTRAN.Item 1.DRB-To-Modify-Item-EUTRAN.cell-Group-To-Modify.Item 0.Cell-Group-Information-Item.uL-Configuration = 1
	
#RLO: Verify BearerContextModificationRequired
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequired.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequired.e-UTRAN-BearerContextModificationRequired.ProtocolIE-Field.value.DRB-Required-To-Modify-List-EUTRAN.DRB-Required-To-Modify-Item-EUTRAN.gNB-CU-UP-CellGroupRelatedConfiguration.GNB-CU-UP-CellGroupRelatedConfiguration-Item.cell-Group-ID = 1

    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequired.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequired.e-UTRAN-BearerContextModificationRequired.ProtocolIE-Field.value.DRB-Required-To-Modify-List-EUTRAN.DRB-Required-To-Modify-Item-EUTRAN.gNB-CU-UP-CellGroupRelatedConfiguration.GNB-CU-UP-CellGroupRelatedConfiguration-Item.uL-Configuration = 0
	

#Verify SgNBModificationRequired, RRC Reconfiguration
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequired
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions = 0
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-RB-Config.RadioBearerConfig.drb-ToAddModList.DRB-ToAddMod.pdcp-Config.moreThanOneRLC.primaryPath.cellGroup = 0
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-RB-Config.RadioBearerConfig.drb-ToAddModList.DRB-ToAddMod.pdcp-Config.moreThanOneRLC.ul-DataSplitThreshold = 23

#Verify SgNBModificationConfirm and RRCReconfigurationComplete
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationConfirm
    ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer.RRCReconfigurationComplete.criticalExtensions.rrcReconfigurationComplete = None
	
	
#Verify BearerContextModificationConfirm
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationConfirm.protocolIEs.ProtocolIE-Field.id = 20

#Verify UEContextModificationRequest
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.ProtocolIE-Field.value.DRBs-ToBeModified-List.ProtocolIE-SingleContainer.value.DRBs-ToBeModified-Item.uLConfiguration.uLUEConfiguration = 0

#RLO: Verify UEContextModificationResponse
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.cellGroupId = 1
