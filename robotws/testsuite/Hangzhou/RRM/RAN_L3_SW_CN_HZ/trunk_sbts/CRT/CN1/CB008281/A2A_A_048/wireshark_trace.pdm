    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.periodical.reportQuantityRS-Indexes.rsrp = True
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.periodical.reportQuantityRS-Indexes.rsrq = True

[CP3]
