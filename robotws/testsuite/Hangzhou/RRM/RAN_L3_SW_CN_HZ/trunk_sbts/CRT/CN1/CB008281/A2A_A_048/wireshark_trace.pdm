[Global]
RELATION: CP1 & CP2 & CP3 & CP4
BlOCKSIZE: -1

[CP1]
#LMF sends E-CID MEASUREMENT INITIATION REQUEST report
# filter: nrppa.procedureCode == 2 and nrppa.UE_Measurement_ID == 1 and nrppa.ReportCharacteristics == 0 and nrppa.measurementQuantitiesValue == 6 and nrppa.measurementQuantitiesValue == 7 and nsetapx.recordingSessionReportList == 0
ethernet.ip.tcp.nsetap
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList = 0
