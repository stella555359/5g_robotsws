[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# BearerContextInactivityNotification:ue active state
# filter: e1ap.uE_Activity == 1
ethernet.ipv6.sctp.syscom
	ethernet.ipv6.sctp.syscom.cpuecpnrtitf.itf_cp_cpue_cpnrt_cpnrt_sendtocpue.itf_cp_cpue_cpnrt_SCpUeCpNrtSyscomCommunicationEnvelope.payload (itf_cp_cpue_cpnrt_embedded_e1ap).E1 Application Protocol.E1AP-PDU.initiatingMessage.value.BearerContextInactivityNotification.protocolIEs.Item 2.ProtocolIE-Field.value.ActivityInformation.uE-Activity = 1

#UEContextReleaseCommand : suspendConfig status
# filter: nr-rrc.ran_PagingCycle == 0
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.cpuecprtitf.itf_cp_cpue_cprt_cprt_receivefromcpue.itf_cp_cpue_cprt_SCpUeCpRtSyscomCommunicationEnvelope.payload (itf_cp_cpue_cprt_embedded_f1ap).F1 Application Protocol (UEContextReleaseCommand).F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.suspendConfig.ran-PagingCycle = 0

#E-CID MEASUREMENT INITIATION REQUEST:Measurement Quantity requested is ‘SS-RSRP & SS-RSRQ’,Report Characteristics IE set to On-Demand
# filter: nrppa.measurementQuantitiesValue == 6 and nrppa.measurementQuantitiesValue == 7 and nrppa.ReportCharacteristics == 0
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 1.ProtocolIE-Field.value.ReportCharacteristics = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 0.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 6
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 1.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 7

#paging
# filter: nokiaf1ap.procedureCode == 18
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 18

# RRCResumeRequest1 : resumeCause='mt-Access'(2)
# filter: nr-rrc.resumeCause == 2
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH1-Message.message.c1.rrcResumeRequest1.rrcResumeRequest1.resumeCause = 2

