[Global]
RELATION: CP1&CP2&CP3&CP4&CP5
BlOCKSIZE: -1

[CP1]
#F1 reset check for Pcell graceful Shutting Down
# filter: nokiaf1ap.nRCellIdentity == 00:00:04:00:10
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Served-Cells-To-Delete-List.Item 0.ProtocolIE-SingleContainer.value.Served-Cells-To-Delete-Item.oldNRCGI.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 0100  0000 0000  0001 .... decimal value 16385

# filter: nokiaf1ap.ResetType == 1 and nokiaf1ap.misc == 3
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause = 3

# filter: nokiaf1ap.id == 81
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.id = 81

# filter: nokiaf1ap.nRCellIdentity == 00:00:04:00:10 and nokiaf1ap.nRCellIdentity == 00:00:08:00:30 and nokiaf1ap.nRCellIdentity == 00:00:08:00:b0 and nokiaf1ap.nRCellIdentity == 00:00:08:00:c0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAGnbDuConfigurationIndication.protocolIEs.Item 1.ProtocolIE-Field.value.NRCGI.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 0100  0000 0000  0001 .... decimal value 16385
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAGnbDuConfigurationIndication.protocolIEs.Item 2.ProtocolIE-Field.value.SCells-Required-To-Be-UnBlocked-List.Item 2.SCells-Required-To-Be-UnBlocked-Item.sCell-ID.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 1000  0000 0000  1100 .... decimal value 32780
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAGnbDuConfigurationIndication.protocolIEs.Item 2.ProtocolIE-Field.value.SCells-Required-To-Be-UnBlocked-List.Item 0.SCells-Required-To-Be-UnBlocked-Item.sCell-ID.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 1000  0000 0000  0011 .... decimal value 32771
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAGnbDuConfigurationIndication.protocolIEs.Item 2.ProtocolIE-Field.value.SCells-Required-To-Be-UnBlocked-List.Item 2.SCells-Required-To-Be-UnBlocked-Item.sCell-ID.pLMN-Identity = 134198
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAGnbDuConfigurationIndication.protocolIEs.Item 2.ProtocolIE-Field.value.SCells-Required-To-Be-UnBlocked-List.Item 1.SCells-Required-To-Be-UnBlocked-Item.sCell-ID.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 1000  0000 0000  1011 .... decimal value 32779

[CP2]
#E1 reset check for Pcell graceful Shutting Down
# filter: e1ap.misc == 3 and e1ap.ResetType == 1
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 3
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1

# filter: e1ap.id == 6
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.id = 6

[CP3]
#NG reset check for Pcell graceful Shutting Down
# filter: ngap.radioNetwork == 3 and ngap.ResetType == 1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause.radioNetwork = 3

# filter: ngap.id == 111
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 111

[CP4]
#XN reset check for Pcell graceful Shutting Down
# filter: nokiaxnap.ResetRequestTypeInfo == 1 and nokiaxnap.misc == 2
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 2

# filter: nokiaxnap.ng_ran_node1UEXnAPID == 131072 and nokiaxnap.ng_ran_node2UEXnAPID == 131072 and nokiaxnap.ResetResponseTypeInfo == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo = 1

# filter: nokiaxnap.NR-Cell-Identity == 0x0000004001
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.ConfigurationUpdateInitiatingNodeChoice.gNB.Item 0.ProtocolIE-Field.value.ServedCellsToUpdate-NR.served-Cells-ToDelete-NR.Item 0.NR-CGI.nr-CI = 0x0000004001

# filter: nokiaxnap.RespondingNodeTypeConfigUpdateAck == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.NGRANNodeConfigurationUpdateAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.RespondingNodeTypeConfigUpdateAck = 1

#UE have release
# filter: nokiaxnap.numberOfActiveUEs == 0 and nokiaxnap.numberOfActiveUEs == 0 and nokiaxnap.numberOfActiveUEs == 0 and nokiaxnap.numberOfActiveUEs == 0
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 2.CellLoadResultItem.numberOfActiveUEs = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 1.CellLoadResultItem.numberOfActiveUEs = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 3.CellLoadResultItem.numberOfActiveUEs = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 0.CellLoadResultItem.numberOfActiveUEs = 0

[CP5]
#cell unlocked is on air
# filter: nokiaxnap.nrPCI == 50 and nr-rrc.physCellId == 50
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.ConfigurationUpdateInitiatingNodeChoice.gNB.Item 0.ProtocolIE-Field.value.ServedCellsToUpdate-NR.served-Cells-ToAdd-NR.Item 0.ServedCells-NR-Item.served-cell-info-NR.nrPCI = 50
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.ConfigurationUpdateInitiatingNodeChoice.gNB.Item 0.ProtocolIE-Field.value.ServedCellsToUpdate-NR.served-Cells-ToAdd-NR.Item 0.ServedCells-NR-Item.served-cell-info-NR.measurementTimingConfiguration.MeasurementTimingConfiguration.criticalExtensions.c1.measTimingConf.measTiming.Item 0.MeasTiming.physCellId = 50

# filter: nokiaxnap.RespondingNodeTypeConfigUpdateAck == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.NGRANNodeConfigurationUpdateAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.RespondingNodeTypeConfigUpdateAck = 1