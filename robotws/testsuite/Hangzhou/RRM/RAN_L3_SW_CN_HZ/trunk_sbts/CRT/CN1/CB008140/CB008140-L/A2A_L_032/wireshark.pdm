[Global]
RELATION: CP0&CP3
BlOCKSIZE: -1

[CP0]
# filter: nokiaxnap.Prime_gNB_CU_UE_XnAP_ID == ${RAN_UE_NGAP_ID_1} and nokiaxnap.TransportLayerAddressIPv4 == 10.0.1.3
# UE1 make call on slice-1 IPV4
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.ProtocolIE-Field.value.Prime-gNB-CU-UE-XnAP-ID = ${RAN_UE_NGAP_ID_1}
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.ProtocolIE-Field.value.EXT-gNB-DRB-Group-Information.Item 0.EXT-gNB-DRB-Group-Information-Item.dRBG-DL-TransportAddressV4.TransportLayerAddress (IPv4) = 10.0.1.3

# filter: nr-rrc.physCellId == 52 and nr-rrc.physCellId == 61 and nr-rrc.physCellId == 50
# UE1 3CC is success
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 1.SCellConfig.sCellConfigCommon.physCellId = 61
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 52


# filter: nokiaxnap.Prime_gNB_CU_UE_XnAP_ID == ${RAN_UE_NGAP_ID_4} and nokiaxnap.TransportLayerAddressIPv4 == 10.0.1.32
# UE4 make call on slice-2 IPV4
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.EXT-gNB-DRB-Group-Information.Item 0.EXT-gNB-DRB-Group-Information-Item.dRBG-DL-TransportAddressV4.TransportLayerAddress (IPv4) = 10.0.1.32
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.Prime-gNB-CU-UE-XnAP-ID = ${RAN_UE_NGAP_ID_4}

# filter: nr-rrc.physCellId == 50 and nr-rrc.physCellId == 53 and nr-rrc.physCellId == 60
# UE4 3CC is success
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 1.SCellConfig.sCellConfigCommon.physCellId = 60
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 53

# filter: nokiaxnap.Prime_gNB_CU_UE_XnAP_ID == ${RAN_UE_NGAP_ID_3} and nokiaxnap.TransportLayerAddressIPv6 == fc00::172:18:6:31
# UE3 make call on slice-1 IPV6
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.EXT-gNB-DRB-Group-Information.Item 0.EXT-gNB-DRB-Group-Information-Item.dRBG-DL-TransportAddressV6.TransportLayerAddress (IPv6) = fc00::172:18:6:31
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.Prime-gNB-CU-UE-XnAP-ID = ${RAN_UE_NGAP_ID_3}

# filter: nr-rrc.physCellId == 52 and nr-rrc.physCellId == 61 and nr-rrc.physCellId == 50
# UE3 3CC is success
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 1.SCellConfig.sCellConfigCommon.physCellId = 61
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 52

# filter: nokiaxnap.Prime_gNB_CU_UE_XnAP_ID == ${RAN_UE_NGAP_ID_5} and nokiaxnap.TransportLayerAddressIPv6 == fc00::172:18:6:32
# UE5 make call on slice-2 IPV6
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.EXT-gNB-DRB-Group-Information.Item 0.EXT-gNB-DRB-Group-Information-Item.dRBG-DL-TransportAddressV6.TransportLayerAddress (IPv6) = fc00::172:18:6:32
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.Prime-gNB-CU-UE-XnAP-ID = ${RAN_UE_NGAP_ID_5}

# filter: nr-rrc.physCellId == 50 and nr-rrc.physCellId == 53 and nr-rrc.physCellId == 60
# UE5 3CC is success
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 1.SCellConfig.sCellConfigCommon.physCellId = 60
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 53

# filter: nokiaf1ap.transport == 0 and nokiaf1ap.ResetType == 1 and nokiaf1ap.gNB_CU_UE_F1AP_ID == ${RAN_UE_NGAP_ID_3}
# Modify NRDU-1 IPV4 link of gNB2,UE1 bulk release. transport: unspecified (0), ResetType: partOfF1-Interface (1)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${RAN_UE_NGAP_ID_3}
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1

# filter: nokiaf1ap.transport == 0 and nokiaf1ap.ResetType == 1 and nokiaf1ap.gNB_CU_UE_F1AP_ID == ${RAN_UE_NGAP_ID_1}
# Modify NRDU-1 IPV6 link of gNB2, UE3 bulk release. transport: unspecified (0), ResetType: partOfF1-Interface (1)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${RAN_UE_NGAP_ID_1}
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1

[CP3]
# filter: ngap.RAN_UE_NGAP_ID == ${RAN_UE_NGAP_ID_3} and ngap.id == 111
# Modify NRDU-1 IPV4 link of gNB2,UE1 bulk release. ng reset process
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 111
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.UE-associatedLogicalNG-connectionList.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_3}

# filter: ngap.RAN_UE_NGAP_ID == ${RAN_UE_NGAP_ID_1} and ngap.id == 111
# Modify NRDU-1 IPV6 link of gNB2, UE3 bulk release. ng reset process
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 111
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.UE-associatedLogicalNG-connectionList.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_1}

# filter: ngap.RAN_UE_NGAP_ID == ${RAN_UE_NGAP_ID_4} and ngap.id == 111
# Modify Modify NRDU-1 PLMN2 to PLMN4 of gNB2, UE4/UE5 bulk release. ng reset process
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 111
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.UE-associatedLogicalNG-connectionList.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_4}
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.UE-associatedLogicalNG-connectionList.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_5}
