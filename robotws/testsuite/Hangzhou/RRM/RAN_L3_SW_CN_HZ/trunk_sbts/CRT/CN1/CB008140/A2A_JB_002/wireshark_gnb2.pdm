[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nokiaxnap.standardCause == 0 and nokiaxnap.procedureCode == 142
# when ext F1 DU sctp failure, ignb CA release
#ethernet.ip.sctp.xnap
#    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 142
#    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAReleaseRequest.protocolIEs.Item 2.ProtocolIE-Field.value.IgNBCACause.standardCause = 0

# filter: xnap.ResetRequestTypeInfo == 1 and xnap.transport == 0
# when ext F1 DU sctp failure, Xn Reset, reset type is partialreset, cause is transport-resource-unavailable.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0

# filter: f1ap.ResetType == 1
# when ext F1 DU sctp failure, F1 Reset, reset type is partialreset
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1