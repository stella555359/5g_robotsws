[Global]
RELATION: CP1&CP2&CP4&CP5&CP6&CP7&CP8&CP9&CP10&CP11
BLOCKSIZE: -1

[CP1]
#UE intra Cell RRE to Cell2, No new startRecordingSession
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.NRCGI.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 1000  0000 0000  0010 .... decimal value 32770
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.reestablishmentCause = *

[CP2]
#PCMD DU record for initialUeRrcMessageTransferSndTime
ethernet.ip.tcp.nsetap
    ethernet.ip.tcp.nsetap.TraceMessage.report.cellId.nrcgi.cellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 1000  0000 0000  0010 .... decimal value 32770
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.duRecordingSessionReportList.DuRecordingSessionReport.recordList.DuRecord.data.vendorExtensionData.ver-Payload.DuVendorExtensionRecordDataType.ueCtxSetupRecord.data-r1.gnb-cu-ue-f1ap-Id = *
    ethernet.ip.tcp.nsetap.TraceMessage.report.recordingSessionReportList.duRecordingSessionReportList.DuRecordingSessionReport.recordList.DuRecord.data.vendorExtensionData.ver-Payload.DuVendorExtensionRecordDataType.ueCtxSetupRecord.data-r1.initialUeRrcMessageTransferSndTime = None

