[Global]
RELATION: CP1
BlOCKSIZE: -1

# Inter GNB HO:
#    --XnAP  HandoverRequest
#    --XnAP  HandoverRequestAcknowledge
#    NGAP  PathSwitchRequest
#    NGAP  PathSwitchRequestAcknowledge
#    --XnAP  UEContextRelease
#    --F1AP  UEContextReleaseCommand

[CP1]
# HandoverRequest  handover-desirable-for-radio-reasons(1)
ethernet.ip.sctp.xnap
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 1

# HandoverRequestAcknowledge 
ethernet.ip.sctp.xnap
	ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.ProtocolIE-Field.value.PDUSessionResourcesAdmitted-List.PDUSessionResourcesAdmitted-Item.pduSessionResourceAdmittedInfo.dataForwardingInfoFromTarget.qosFlowsAcceptedForDataForwarding-List.QoSFLowsAcceptedToBeForwarded-Item.qosFlowIdentifier = 1

# UEContextRelease
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.UEContextRelease.protocolIEs = *
	
# UEContextReleaseCommand  normal-release(10) 
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 10