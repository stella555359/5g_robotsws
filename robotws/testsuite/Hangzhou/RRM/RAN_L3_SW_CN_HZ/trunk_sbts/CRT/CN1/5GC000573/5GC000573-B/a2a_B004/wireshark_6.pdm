[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
# no UEContextRelease shall be captured, also the case is for CBRA, so no CFRA will be captured.
ethernet.ip.sctp
    ethernet.ip.sctp.x2ap.value = UEContextRelease

ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.rach-ConfigDedicated.uplink.cfra.resources = 0
