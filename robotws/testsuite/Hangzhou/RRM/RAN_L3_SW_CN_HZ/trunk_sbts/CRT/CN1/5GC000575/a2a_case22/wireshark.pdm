[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#step1:setup ENDC，sgnbadditionrequest
ethernet.ip.sctp.x2ap
   ethernet.ip.sctp.x2ap.procedure_code = 27
   ethernet.ip.sctp.x2ap.value = SgNBAdditionRequest
   ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.candidateCellInfoListMN.Item 0.MeasResult2NR.measResultNeighCellListNR.Item 0.MeasResultNR.physCellId = 50

#step2. sgnbadditionrequestack
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.procedure_code = 27
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequestAcknowledge
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50

#sgnbreconfigurationcomplete
ethernet.ip.sctp.x2ap
	ethernet.ip.sctp.x2ap.procedure_code = 28
    ethernet.ip.sctp.x2ap.value = SgNBReconfigurationComplete
    ethernet.ip.sctp.x2ap.id-ResponseInformationSgNBReconfComp.ProtocolIE-Field.id = 214
    ethernet.ip.sctp.x2ap.id-ResponseInformationSgNBReconfComp.ProtocolIE-Field.value.ResponseInformationSgNBReconfComp.success-SgNBReconfComp.meNBtoSgNBContainer.RRCReconfigurationComplete.criticalExtensions = 0

#SN status transfer
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.procedure_code = 4
    ethernet.ip.sctp.x2ap.value = SNStatusTransfer
    ethernet.ip.sctp.x2ap.id-E-RABs-SubjectToStatusTransfer-List.ProtocolIE-Field.value.E-RABs-SubjectToStatusTransfer-List.Item 0.ProtocolIE-Single-Container.value.E-RABs-SubjectToStatusTransfer-Item.e-RAB-ID = 5


#e1ap bearercontextmodification
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.procedureCode = 9
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationResponse.protocolIEs.Item 2 = id-System-BearerContextModificationResponse
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationResponse.e-UTRAN-BearerContextModificationResponse.Item 0.ProtocolIE-Field.value.DRB-Modified-List-EUTRAN.Item 0.DRB-Modified-Item-EUTRAN.dRB-ID = 5

#sgnbmodificationrequest dur yo MCG mobility
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.procedure_code = 29
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequest
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 46

#sgnbmodificationack
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.procedure_code = 29
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequestAcknowledge
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.nonCriticalExtension.pSCellFrequency = 636576

#sgnbreconfigurationcompelet
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.procedure_code = 28
    ethernet.ip.sctp.x2ap.id-ResponseInformationSgNBReconfComp.ProtocolIE-Field.id = 214
    ethernet.ip.sctp.x2ap.id-ResponseInformationSgNBReconfComp.ProtocolIE-Field.value.ResponseInformationSgNBReconfComp.reject-by-MeNB-SgNBReconfComp.cause.protocol = 5

#sgnbreleaserequired due to reject
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.procedure_code = 32
    ethernet.ip.sctp.x2ap.value = SgNBReleaseRequired
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 44