[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# step:1) UE attaches to the TDD Cell3 with high DL non-GBR data rate and configures the SCell_cell12 to the UE(check BufferMonitoring)
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

# step:3) UE send A1 MR and 2CC success(check BufferMonitoring)
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

# step:4) UE is in overheating state again,after sCellInactivityReleaseTimer expired.caBackoffTimerUeOh unexpired(check scell release reason)
# filter: itf_l2_ps_user_sCellListElement.inactiveReason == 1
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_scellreleaseconditionmetind.itf_l2_ps_user_SCellReleaseConditionMetInd_t.sCellList (DynamicVariableSizedArray).sCellList_item_0 (itf_l2_ps_user_sCellListElement).inactiveReason (itf_l2_ps_user_InactiveReason) = 1
# filter: nokiaf1ap.sCellInactiveReason == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.SCellStatusNotification.protocolIEs.Item 2.ProtocolIE-Field.value.SCell-Status-List.Item 0.SCell-Status-Item.sCellInactiveReason = 1

# step:5) after caBackoffTimerUeOh expire,The gNB re-activates DL buffer monitoring for SCell Addition(check BufferMonitoring)
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

