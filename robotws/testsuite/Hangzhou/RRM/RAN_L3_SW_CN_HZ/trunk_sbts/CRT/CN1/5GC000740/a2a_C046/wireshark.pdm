[Global]
RELATION: CP1 & CP2
BLOCKSIZE: -1

[CP1]
#NG Full Reset
# radioNetwork = 3 -> release-due-to-ngran-generated-reason
# nG-Interface = 0 -> reset-all
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 3
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.ProtocolIE-Field.value.ResetType.nG-Interface = 0

ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 3
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.ProtocolIE-Field.value.ResetType.nG-Interface = 0

[CP2]
#E1 Reset
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset = *

ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset = *