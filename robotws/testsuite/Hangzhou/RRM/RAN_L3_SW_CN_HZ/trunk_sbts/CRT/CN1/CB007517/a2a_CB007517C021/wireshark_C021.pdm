[CP1]
#NGAP:InitialContextSetupRequest

ethernet.ip.sctp.ngap

    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.ProtocolIE-Field.value.UESecurityCapabilities.eUTRAencryptionAlgorithms.128-EEA1 = Not supported


#F1AP:UEContextSetupRequest,for A2A3 event

ethernet.ipv6.sctp.f1ap

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 1

