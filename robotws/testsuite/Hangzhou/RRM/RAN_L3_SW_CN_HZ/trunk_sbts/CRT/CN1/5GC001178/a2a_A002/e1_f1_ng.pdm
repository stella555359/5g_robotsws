[Global]
RELATION: CP1&CP2&CP3
BLOCKSIZE: -1

[CP1]
# E1AP_RESET
ethernet.ipv6.sctp.e1ap
   ethernet.ipv6.sctp.e1ap.E1AP-PDU = 0
   ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0

ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 1
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.procedureCode = 0

[CP2]
# F1AP_RESET
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0

ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 0

[CP3]
# NGAP_RESET
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 20

ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 20
