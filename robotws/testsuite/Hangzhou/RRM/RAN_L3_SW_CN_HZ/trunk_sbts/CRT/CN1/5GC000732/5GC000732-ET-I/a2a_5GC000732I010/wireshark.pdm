[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#Step 1:RRC ReestablishmentReques

ethernet.ipv6.sctp.f1ap

	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.reestablishmentCause = 0


#Step 2:RRC Reestablishment

ethernet.ipv6.sctp.f1ap	

	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReestablishment = *


#Step 3:RRC Reestablishment Complete

ethernet.ipv6.sctp.f1ap

	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcReestablishmentComplete = *


#Step 4:RRC Reconfiguration

ethernet.ipv6.sctp.f1ap

	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration = *
	

#Step 5:LocationReportingControl

ethernet.ip.sctp
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.LocationReportingControl.protocolIEs.ProtocolIE-Field.value.LocationReportingRequestType.eventType = 0
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.LocationReportingControl.protocolIEs.ProtocolIE-Field.value.LocationReportingRequestType.reportArea = 0
	

#Step 6:RRC Reconfiguration Complete	

ethernet.ipv6.sctp.f1ap

	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcReconfigurationComplete = *
	
#Step 7:LocationReport

ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.LocationReport.protocolIEs.ProtocolIE-Field.value.UserLocationInformation.userLocationInformationNR.nR-CGI.nRCellIdentity = 0x0000004001
	
