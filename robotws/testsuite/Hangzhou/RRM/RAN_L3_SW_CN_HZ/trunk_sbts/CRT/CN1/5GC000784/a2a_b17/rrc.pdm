[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#rrcSetupRequest
UL-CCCH-Message
    UL-CCCH-Message.rrcSetupRequest.rrcSetupRequest.establishmentCause = mo-Signalling
#rrcSetupComplete
UL-DCCH-Message
    UL-DCCH-Message.rrcSetupComplete.rrc-TransactionIdentifier = 0
    UL-DCCH-Message.rrcSetupComplete.rrcSetupComplete.selectedPLMN-Identity = 1
#The first PUD session setup with bearer 5QI-5
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None.sdap-Config.pdu-Session = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA3.timeToTrigger = ms40
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA3.a3-Offset_rsrq = 10
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA3.hysteresis = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.freqBandIndicatorNR = 78
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.measId = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.servedRadioBearer_drb-Identity = 4
#The second PUD session setup with bearer 5QI-5
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None.sdap-Config.pdu-Session = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.servedRadioBearer_drb-Identity = 5
#The first voice call with 5QI-1 setup base pdu session-2
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None.sdap-Config.pdu-Session = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.servedRadioBearer_drb-Identity = 6
#Trigger event A3 measurement report and HO to phycel-51
UL-DCCH-Message
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measId = 1
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultListNR.None.physCellId = 51
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.measResult.rsIndexResults.resultsSSB-Indexes.None.ssb-Index = 0
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.physCellId = 50
#rrcReconfiguration
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None.sdap-Config.pdu-Session = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA3.hysteresis = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None_2.sdap-Config.pdu-Session = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.freqBandIndicatorNR = 78
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None_1.sdap-Config.pdu-Session = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA3.a3-Offset_rsrq = 10
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.measId = 1
#The third PUD session setup with bearer 5QI-5
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None.sdap-Config.pdu-Session = 3
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.servedRadioBearer_drb-Identity = 7
#The second voice call with 5QI-1 setup base pdu session-2
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None.sdap-Config.pdu-Session = 3
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.servedRadioBearer_drb-Identity = 8
#Release PUD session-3
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToReleaseList.7 = 7
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToReleaseList.8 = 8
#Trigger event A3 measurement report and HO to phycel-50
UL-DCCH-Message
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measId = 1
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultListNR.None.physCellId = 50
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.physCellId = 51
#rrcReconfiguration
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA3.timeToTrigger = ms40
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None.sdap-Config.pdu-Session = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA3.hysteresis = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None_2.sdap-Config.pdu-Session = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.freqBandIndicatorNR = 78
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None_1.sdap-Config.pdu-Session = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measIdToAddModList.None.measId = 1
#Setup the third PUD session again with bearer 5QI-5
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None.sdap-Config.pdu-Session = 3
