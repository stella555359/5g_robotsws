[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#GFBR increased for PDUSessionResourceModify
# filter: ngap.fiveQI == 2 and ngap.pre_emptionCapability == 1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.allocationAndRetentionPriority.pre-emptionCapability = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 2

#UE suspend
# filter: itf_l2_ps_UlCgType2ActivationControl_t.nonGbrCgType2Activation_item == 1 and itf_l2_ps_UlCgType2ActivationControl_t.gbrCgType2Activation_item == 1
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolreq.itf_l2_ps_cell_UlCGType2ActivationControlReq_t.ulCgType2ActivationControl (itf_l2_ps_UlCgType2ActivationControl_t).gbrCgType2Activation (StaticVariableSizedArray).Length (Uint32) = 1
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolreq.itf_l2_ps_cell_UlCGType2ActivationControlReq_t.ulCgType2ActivationControl (itf_l2_ps_UlCgType2ActivationControl_t).gbrCgType2Activation (StaticVariableSizedArray).gbrCgType2Activation_item_0 (itf_l2_ps_RequestProcess) = 1
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolreq.itf_l2_ps_cell_UlCGType2ActivationControlReq_t.ulCgType2ActivationControl (itf_l2_ps_UlCgType2ActivationControl_t).nonGbrCgType2Activation (StaticVariableSizedArray).Length (Uint32) = 1
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolreq.itf_l2_ps_cell_UlCGType2ActivationControlReq_t.ulCgType2ActivationControl (itf_l2_ps_UlCgType2ActivationControl_t).nonGbrCgType2Activation (StaticVariableSizedArray).nonGbrCgType2Activation_item_0 (itf_l2_ps_RequestProcess) = 1

#user beare setup request
# filter: itf_l2_ps_DrbModifyReqPs.percentToReduce_item == 1
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_drbmodifyreq.itf_l2_ps_user_DrbModifyReq_t.drbModifyReqPs (DynamicVariableSizedArray).drbModifyReqPs_item_0 (itf_l2_ps_DrbModifyReqPs).percentToReduce (StaticVariableSizedArray).Length (Uint32) = 1
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_drbmodifyreq.itf_l2_ps_user_DrbModifyReq_t.drbModifyReqPs (DynamicVariableSizedArray).drbModifyReqPs_item_0 (itf_l2_ps_DrbModifyReqPs).percentToReduce (StaticVariableSizedArray).percentToReduce_item_0 (Uint8) = 1

#UE release due to pre emption
# filter: nokiaf1ap.procedureCode == 6 and nokiaf1ap.radioNetwork == 16
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 6
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 16

#UE release complate
# filter: nokiaf1ap.procedureCode == 6
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 6

#check ‘avgUlCgType2NgbrBitrate’ and ‘ngbrCgType2PrbLoadPerBwp’ turn to 0 after UE4 attach
# filter: itf_l2_ps_cell_UlNonGbrLoadInd_t.nrCellIdentity == 16385 and itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp_item == 0 and itf_l2_ps_cell_UlNonGbrLoadInd_t.avgUlCgType2NgbrBitrate == 0
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.avgUlCgType2NgbrBitrate (Uint64) = 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp (DynamicVariableSizedArray).ngbrCgType2PrbLoadPerBwp_item_0 (Uint8) = 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp (DynamicVariableSizedArray).ngbrCgType2PrbLoadPerBwp_item_1 (Uint8) = 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.nrCellIdentity (Uint64) = 16385

#GFBR decreased for PDUSessionResourceModify
# filter: ngap.fiveQI == 2 and ngap.pre_emptionCapability == 1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.allocationAndRetentionPriority.pre-emptionCapability = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 2

#user drb is 0
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_drbmodifyreq.itf_l2_ps_user_DrbModifyReq_t.drbModifyReqPs (DynamicVariableSizedArray).drbModifyReqPs_item_0 (itf_l2_ps_DrbModifyReqPs).percentToReduce (StaticVariableSizedArray).Length (Uint32) = 0

# UE resume
# filter: itf_l2_ps_cell_UlNonGbrLoadInd_t.nrCellIdentity == 16385 and itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp_item == 0 and itf_l2_ps_cell_UlNonGbrLoadInd_t.avgUlCgType2NgbrBitrate == 0
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.avgUlCgType2NgbrBitrate (Uint64) = 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp (DynamicVariableSizedArray).ngbrCgType2PrbLoadPerBwp_item_0 (Uint8) = 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp (DynamicVariableSizedArray).ngbrCgType2PrbLoadPerBwp_item_1 (Uint8) = 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.nrCellIdentity (Uint64) = 16385

#user drb is 1 after resume	
# filter: itf_l2_ps_UlCgType2ActivationControl_t.nonGbrCgType2Activation_item == 0 and itf_l2_ps_UlCgType2ActivationControl_t.gbrCgType2Activation_item == 0
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolreq.itf_l2_ps_cell_UlCGType2ActivationControlReq_t.ulCgType2ActivationControl (itf_l2_ps_UlCgType2ActivationControl_t).gbrCgType2Activation (StaticVariableSizedArray).gbrCgType2Activation_item_0 (itf_l2_ps_RequestProcess) = 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolreq.itf_l2_ps_cell_UlCGType2ActivationControlReq_t.ulCgType2ActivationControl (itf_l2_ps_UlCgType2ActivationControl_t).nonGbrCgType2Activation (StaticVariableSizedArray).nonGbrCgType2Activation_item_0 (itf_l2_ps_RequestProcess) = 0


