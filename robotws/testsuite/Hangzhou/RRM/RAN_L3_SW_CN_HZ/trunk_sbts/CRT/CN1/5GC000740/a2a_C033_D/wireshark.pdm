[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
# HO from sim-gnb to real-gnb
ethernet.ip.sctp.xnap
    # HandoverRequest: GUAMI and TNL NG-C address
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.ProtocolIE-Field.value.GUAMI.plmn-ID = 134198
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.ProtocolIE-Field.value.GUAMI.plmn-ID.Mobile Network Code (MNC) = 489
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.ProtocolIE-Field.value.GUAMI.plmn-ID.Mobile Country Code (MCC) = 311
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.ProtocolIE-Field.value.GUAMI.amf-region-id = bit length 8, 0000 0001 decimal value 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.ProtocolIE-Field.value.GUAMI.amf-set-id = bit length 10, 6 LSB pad bits, 0000 0000  01.. .... decimal value 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.ProtocolIE-Field.value.GUAMI.amf-pointer = bit length 6, 2 LSB pad bits, 0000 01.. decimal value 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.ProtocolIE-Field.value.UEContextInfoHORequest.cp-TNL-info-source.endpointIPAddress.TransportLayerAddress (IPv4) = 10.0.1.1

ethernet.ip.sctp.xnap
    # XNAP SN STATUS TRANSFER
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.SNStatusTransfer = None

ethernet.ip.sctp.ngap
    # gNB based on TNL NG-C received, selects an AMF and sends it the NGAP PATH SWITCH REQUEST
    ethernet.ip.destination = 10.0.1.1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PathSwitchRequest = None

ethernet.ip.sctp.ngap
    # AMF sends a NGAP PATH SWITCH REQUEST ACKNOWLEDGE
    ethernet.ip.source = 10.0.1.1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PathSwitchRequestAcknowledge = None

# AMF Region Information modification transferred over XN upon NG AMF Configuration update
ethernet.ip.sctp.ngap
    # AMFConfigurationUpdate: Modify AMF3 from region-3 to region-4
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.ServedGUAMIList.ServedGUAMIItem.gUAMI.pLMNIdentity = 134198
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.ServedGUAMIList.ServedGUAMIItem.gUAMI.aMFRegionID = bit length 8, 0000 0100 decimal value 4
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.ServedGUAMIList.ServedGUAMIItem.gUAMI.aMFSetID = bit length 10, 6 LSB pad bits, 0000 0000  01.. .... decimal value 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.ServedGUAMIList.ServedGUAMIItem.gUAMI.aMFPointer = bit length 6, 2 LSB pad bits, 0000 11.. decimal value 3

ethernet.ip.sctp.xnap
    # NGRANNodeConfigurationUpdate: add region-4 and delete region-3
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 1 = id-AMF-Region-Information-To-Add
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.AMF-Region-Information.Item 0.GlobalAMF-Region-Information.plmn-ID = 134198
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.AMF-Region-Information.Item 0.GlobalAMF-Region-Information.amf-region-id = bit length 8, 0000 0100 decimal value 4
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 2 = id-AMF-Region-Information-To-Delete
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 2.ProtocolIE-Field.value.AMF-Region-Information.Item 0.GlobalAMF-Region-Information.plmn-ID = 134198
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 2.ProtocolIE-Field.value.AMF-Region-Information.Item 0.GlobalAMF-Region-Information.amf-region-id = bit length 8, 0000 0011 decimal value 3