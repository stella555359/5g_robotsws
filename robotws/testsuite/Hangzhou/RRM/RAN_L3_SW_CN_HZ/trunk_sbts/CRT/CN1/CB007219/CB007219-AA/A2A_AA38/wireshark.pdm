#UEContextSetupRes with BC 0001
# filter: nokiaf1ap.SelectedBandCombinationIndex == 00:01 and nokiaf1ap.procedureCode == 5
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 5
