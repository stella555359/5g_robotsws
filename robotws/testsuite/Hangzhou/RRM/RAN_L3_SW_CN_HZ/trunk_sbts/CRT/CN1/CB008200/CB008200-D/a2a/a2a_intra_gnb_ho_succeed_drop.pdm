[Global]
RELATION: CP1
BlOCKSIZE: -1

# Intra GNB HO:
#   F1AP         UEContextModificationRequest
#   --F1AP         UEContextModificationResponse
#   --E1AP         BearerContextSetupRequest
#   --E1AP         BearerContextSetupResponse
#   F1AP/NR RRC  SACK (DL RRC Msg Transfer)
#   F1AP/NR RRC  SCG Failure Information EUTRA (UL RRC Msg Transfer)
#   E1AP         BearerContextSetupRequest
#   E1AP         BearerContextSetupResponse

[CP1]
# UEContextModificationResponse
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.iE-Extensions = *

# BearerContextSetupRequest	
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequest.nG-RAN-BearerContextModificationRequest.ProtocolIE-Field.value.PDU-Session-Resource-To-Modify-List.PDU-Session-Resource-To-Modify-Item.pDU-Session-ID = 1
	
# BearerContextSetupResponse
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationResponse.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationResponse.nG-RAN-BearerContextModificationResponse.ProtocolIE-Field.value.PDU-Session-Resource-Modified-List.PDU-Session-Resource-Modified-Item.pDU-Session-ID = 1