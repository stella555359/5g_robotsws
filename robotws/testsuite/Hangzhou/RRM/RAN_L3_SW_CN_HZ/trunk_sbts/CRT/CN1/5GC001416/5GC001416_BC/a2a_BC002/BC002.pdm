[Global]

RELATION: CP1&CP2&CP3

BLOCKSIZE: -1



[CP1]

#sgnb_addition_request

ethernet.ip.sctp.x2ap

    ethernet.ip.sctp.x2ap.x2ap_pdu = 0
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequest
	ethernet.ip.sctp.x2ap.procedure_code = 27

	
[CP2]
#ue_attach_with_alternativeband	

ethernet.ip.sctp.x2ap	
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 77

	ethernet.ip.sctp.x2ap.procedure_code = 27

	
[CP3]
#Analysis capture wireshark should contain the P-max
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 77
	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.p-Max = 1 dBm
	
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.additionalSpectrumEmission = 2
	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 5


