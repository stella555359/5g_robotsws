[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#UEContextSetupReq with Pcell band78
# filter: nokiaf1ap.procedureCode == 5 and nr-rrc.freqBandIndicatorNR == 78
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 5
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 78

#UEContextSetupRes with BC 0000
# filter: nokiaf1ap.SelectedBandCombinationIndex == 00:00 and nokiaf1ap.procedureCode == 5
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 5
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.iE-Extensions.Item 0.ProtocolExtensionField.extensionValue.SelectedBandCombinationIndex = 0000

#RRC with Pcell band 77
# filter: nr-rrc.c1 == 0 and nr-rrc.freqBandIndicatorNR == 77
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1 = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 77

