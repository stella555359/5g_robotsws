[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#IgNBCAXpRemovalRequest due to Xn drop
# filter: nokiaf1ap.Nokia_F1AP_PDU == 0 and nokiaf1ap.procedureCode == 202
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 202
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU = 0

#IgNBCAXpRemovalResponse
# filter: nokiaf1ap.Nokia_F1AP_PDU == 1 and nokiaf1ap.procedureCode == 202
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.procedureCode = 202
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU = 1

#ignb_ca xn' setup with error_ind
# filter: nokiaxnap.procedureCode == 137 and nokiaxnap.triggeringMessage == 2
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ErrorIndication.protocolIEs.Item 1.ProtocolIE-Field.value.CriticalityDiagnostics.procedureCode = 137
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ErrorIndication.protocolIEs.Item 1.ProtocolIE-Field.value.CriticalityDiagnostics.triggeringMessage = 2

#ignb_ca xn' setup ok
# filter: nokiaxnap.Nokia_XnAP_PDU == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCASetupResponse.protocolIEs.Item 0 = id-XnProtocolVersion

#IgNBCAXpSetupResponse with XpConnectionStatus: available (1)
