    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 1.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 1


