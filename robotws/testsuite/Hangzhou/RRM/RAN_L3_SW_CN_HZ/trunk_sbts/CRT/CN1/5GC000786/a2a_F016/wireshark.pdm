[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
###First UE establish Voice call with only 5QI1 failed
## from AMF to GNB: PDUSessionResourceSetupRequest
# ngap.procedureCode == 29 and ngap.fiveQI == 1
# procedureCode: id-PDUSessionResourceSetup (29)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 29

## from GNB to AMF: PDUSessionResourceSetupResponse
# ngap.procedureCode == 29 and ngap.radioNetwork == 23
# procedureCode: id-PDUSessionResourceSetup (29)
# radioNetwork: invalid-qos-combination (23)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PDUSessionResourceSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceFailedToSetupListSURes.Item 0.PDUSessionResourceFailedToSetupItemSURes.pDUSessionResourceSetupUnsuccessfulTransfer.PDUSessionResourceSetupUnsuccessfulTransfer.cause.radioNetwork = 23
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 29


