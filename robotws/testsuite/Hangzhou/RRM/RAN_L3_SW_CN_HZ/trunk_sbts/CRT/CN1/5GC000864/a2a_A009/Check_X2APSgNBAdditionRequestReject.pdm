[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
# Check Msg SgNBAdditionRequestReject in Wireshark Log
# 108811 230.364097     10.0.1.2 → 10.42.99.57  X2AP 124 SgNBAdditionRequestRejectStopRecordingSession ' | 'SgNBAdditionRequestReject'


# ===================Msg: 1276 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.2
    ethernet.ip.source = 10.0.1.12
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequest

# ===================Msg: 1/2 start : SgNBAdditionRequestReject ================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequestReject
ethernet.ip.tcp
    ethernet.ip.destination = ${L3DC_ute_ip_address}
    ethernet.ip.source = 10.0.1.2
    ethernet.ip.tcp.nsetap[0].TraceMessage.startRecordingSession.traceReference.traceId = 000001
    ethernet.ip.tcp.nsetap[0].TraceMessage.report.recordingSessionReportList.cuRecordingSessionReportList.Item 0.CuRecordingSessionReport.recordList.Item 0.CuRecord.data.asn1-Data.EUTRAN X2 Application Protocol (X2AP).X2AP-PDU.unsuccessfulOutcome.value.SgNBAdditionRequestReject = None
