[Global]
RELATION: CP1 & CP2 & CP3 & CP4 & CP5 & CP6 & CP7
BLOCKSIZE: -1

[CP1]
#service request    nas_5gs.mm.serv_type == 4
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.ulInformationTransfer.criticalExtensions.ulInformationTransfer.dedicatedNAS-Message.Non-Access-Stratum 5GS (NAS)PDU.Plain NAS 5GS Message.Service type.Service type = 4

[CP2]
#service request    nas_5gs.mm.serv_type == 4
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkNASTransport.protocolIEs.ProtocolIE-Field.value.NAS-PDU.Non-Access-Stratum 5GS (NAS)PDU.Plain NAS 5GS Message.Service type.Service type = 4

[CP3]
#UEContextModificationRequest    ngap.emergencyServiceTargetCN == 1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.ProtocolIE-Field.value.EmergencyFallbackIndicator.emergencyServiceTargetCN = 1

[CP4]
#UEContextModificationResponse    ngap.procedureCode == 40 && ngap.protocolIEs == 2
ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 0 = id-AMF-UE-NGAP-ID
	ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 1 = id-RAN-UE-NGAP-ID
	ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextModificationResponse = None

[CP5]
#UEContextReleaseRequest  ngap.procedureCode == 42 && ngap.radioNetwork == 41    cause:redirection
ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 41

[CP6]
#UE1 RRC release:     nr-rrc.redirectedCarrierInfo == 1 && nr-rrc.cnType == 0 && nr-rrc.eutraFrequency == 400
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.redirectedCarrierInfo.eutra.eutraFrequency = 400

[CP7]
#UE3 UEContextModificationfailure
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.unsuccessfulOutcome.value.UEContextModificationFailure.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 0
