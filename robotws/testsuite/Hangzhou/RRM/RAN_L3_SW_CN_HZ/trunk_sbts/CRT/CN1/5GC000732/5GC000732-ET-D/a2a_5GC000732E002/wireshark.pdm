[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
#will trigger fallback：
#Step 1:RRCReestablishmentRequest
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.reestablishmentCause = 1

#Step 2:UEContextReleaseRequest with cause radioNetwork = 0(unspecified)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.Item 3.ProtocolIE-Field.value.Cause.radioNetwork = 0

	
#Step 3:UEContextReleaseCommand with cause radioNetwork = 0(unspecified)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 0


#Step 4:RRCReestablishmentRequest
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.reestablishmentCause = 1
 
 
#step 5:InitialUEMessage
ethernet.ip.sctp.ngap
   ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialUEMessage.protocolIEs.Item 3.ProtocolIE-Field.value.RRCEstablishmentCause = 10

#step 6: InitialContextSetupFailure
ethernet.ip.sctp.ngap
   ethernet.ip.sctp.ngap.NGAP-PDU.unsuccessfulOutcome.value.InitialContextSetupFailure.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceFailedToSetupListCxtFail.Item 0.PDUSessionResourceFailedToSetupItemCxtFail.pDUSessionResourceSetupUnsuccessfulTransfer.PDUSessionResourceSetupUnsuccessfulTransfer.cause.radioNetwork = 22