[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#F1AP: UEContextModificationRequest -- add DRB 5 before RRCReestablishmentRequest
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.ProtocolIE-Field.value.DRBs-ToBeSetupMod-List.ProtocolIE-SingleContainer.value.DRBs-ToBeSetupMod-Item.dRBID = 5

#F1AP: RRCReestablishmentRequest
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.reestablishmentCause = 0

#F1AP: rrcSetup -- fallback is triggerred
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup = *

#F1AP: UEContextSetupRequest -- not contian DRB 5
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.ProtocolIE-Field.value.DRBs-ToBeSetup-List.ProtocolIE-SingleContainer.value.DRBs-ToBeSetup-Item.dRBID = 5