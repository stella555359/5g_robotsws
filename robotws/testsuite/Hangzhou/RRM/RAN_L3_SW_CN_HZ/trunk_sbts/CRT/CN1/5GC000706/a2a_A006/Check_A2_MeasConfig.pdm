[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
# Check reportConfigNR eventA2 is not existed in measConfig
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.hysteresis = *
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.a2-Threshold_rsrq = *
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.reportOnLeave = *
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.timeToTrigger = *
