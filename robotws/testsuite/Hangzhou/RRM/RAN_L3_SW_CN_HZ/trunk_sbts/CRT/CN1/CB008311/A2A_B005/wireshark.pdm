[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#    ...        1) UE91 attaches to the LTE cell and initiates EN-DC toward the TDD NR cell3，UE1 send A2 and A3 trigger
#    ...           handover to FDD Cell12. with A1 threshold criteria is met then the gNB-CU performs DL buffer monitoring
#    ...           activation checks pass.The gNB-CU sends message to the gNB-DU to activate DL data buffer monitoring
#    ...        2) High DL data rate starts for UE91 and CA success
# filter: nr-rrc.reportOnLeave == 1 and nr-rrc.eventId == 0 and nr-rrc.physCellId == 61 and nr-rrc.physCellId == 52
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.candidateCellInfoListSN.MeasResultList2NR.Item 0.MeasResult2NR.measResultNeighCellListNR.Item 0.MeasResultNR.physCellId = 61
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.candidateCellInfoListSN.MeasResultList2NR.Item 0.MeasResult2NR.measResultServingCell.physCellId = 52
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.sourceConfigSCG.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 52
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 1.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 1.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA1.reportOnLeave = True

# DL buffer monitoring activation
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# DL buffer monitoring activation checks pass
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0


#    ...        3) For UE92 execute step1，UE92 sends A1 MR with A1 threshold criteria is not met
#    ...           the gNB-DU to deactivate DL data buffer monitoring for UE92
#    ...        4) High DL data rate starts for UE92 and CA unsuccess
#    ...        5) UE92 sends A1 MR again but A1 threshold criteria is met and CA success
# filter: nr-rrc.reportOnLeave == 1 and nr-rrc.eventId == 0 and nr-rrc.physCellId == 61 and nr-rrc.physCellId == 52
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.candidateCellInfoListSN.MeasResultList2NR.Item 0.MeasResult2NR.measResultNeighCellListNR.Item 0.MeasResultNR.physCellId = 61
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.candidateCellInfoListSN.MeasResultList2NR.Item 0.MeasResult2NR.measResultServingCell.physCellId = 52
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.sourceConfigSCG.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 52
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 1.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 1.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA1.reportOnLeave = True

# DL buffer monitoring activation
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# deactivate DL data buffer monitoring for UE92
# filter: nokiaf1ap.BufferMonitoring == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 1

# DL buffer monitoring activation for UE92 sends A1 MR again
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# DL buffer monitoring activation checks pass
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0


#    ...        6) For UE31 execute step1，but A1 threshold criteria is not met then check no DL buffer monitoring active
#    ...        7) UE31 sends A1 MR with A1 threshold criteria is met and High DL data rate starts for UE31 so CA success
# filter: nr-rrc.reportOnLeave == 1 and nr-rrc.eventId == 0 and nr-rrc.physCellId == 61 and nr-rrc.physCellId == 52
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.candidateCellInfoListSN.MeasResultList2NR.Item 0.MeasResult2NR.measResultNeighCellListNR.Item 0.MeasResultNR.physCellId = 61
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.candidateCellInfoListSN.MeasResultList2NR.Item 0.MeasResult2NR.measResultServingCell.physCellId = 52
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.sourceConfigSCG.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 52
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 1.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 1.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA1.reportOnLeave = True

# DL buffer monitoring activation
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# DL buffer monitoring activation checks pass
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

