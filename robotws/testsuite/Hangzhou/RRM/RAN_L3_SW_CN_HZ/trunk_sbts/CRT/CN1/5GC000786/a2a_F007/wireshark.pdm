[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
###Trigger UE register in cell1
## from GNB to AMF: InitialUEMessage, Registration request
# ngap.UEContextRequest == 0
# UEContextRequest: requested (0)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialUEMessage.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextRequest = 0

## from AMF to GNB: InitialContextSetupRequest
# ngap.procedureCode == 14 and ngap.id == 146 and ngap.RedirectionVoiceFallback == 0
# procedureCode: id-InitialContextSetup (14)
# id: id-RedirectionVoiceFallback (146)
# RedirectionVoiceFallback: possible (0)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.id = 146
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.RedirectionVoiceFallback = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 14

## F1AP: DLRRCMessageTransfer with securityModeCommand
# nr-rrc.cipheringAlgorithm == 0 and nr-rrc.integrityProtAlgorithm == 2
# cipheringAlgorithm: nea0 (0)
# integrityProtAlgorithm: nia2 (2)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.2   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.securityModeCommand.criticalExtensions.securityModeCommand.securityConfigSMC.securityAlgorithmConfig.cipheringAlgorithm = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.2   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.securityModeCommand.criticalExtensions.securityModeCommand.securityConfigSMC.securityAlgorithmConfig.integrityProtAlgorithm = 2

## F1AP: DLRRCMessageTransfer with ueCapabilityEnquiry
# f1ap.procedureCode == 12 and f1ap.SRBID == 1 and nr-rrc.rat_Type == 0
# procedureCode: id-DLRRCMessageTransfer (12)
# rat-Type: nr (0)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 2.ProtocolIE-Field.value.SRBID = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 12
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.3   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.ueCapabilityEnquiry.criticalExtensions.ueCapabilityEnquiry.ue-CapabilityRAT-RequestList.Item 0.UE-CapabilityRAT-Request.rat-Type = 0

## F1AP: ULRRCMessageTransfer with securityModeComplete
# f1ap.procedureCode == 13 and nr-rrc.c1 == 5
# procedureCode: id-ULRRCMessageTransfer (13)
# c1: securityModeComplete (5)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 13
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.3   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 5

## F1AP: ULRRCMessageTransfer with ueCapabilityInformation
# f1ap.procedureCode == 13 and nr-rrc.c1 == 9
# procedureCode: id-ULRRCMessageTransfer (13)
# c1: ueCapabilityInformation (9)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 13
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.4   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 9

## from GNB to AMF: UERadioCapabilityInfoIndication
# ngap.procedureCode == 44 and ngap.id == 117 and nr-rrc.voiceOverEUTRA_5GC == 0
# procedureCode: id-UERadioCapabilityInfoIndication (44)
# id: id-UERadioCapability (117)
# voiceOverEUTRA-5GC: supported (0)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 44
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UERadioCapabilityInfoIndication.protocolIEs.Item 2.ProtocolIE-Field.id = 117
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UERadioCapabilityInfoIndication.protocolIEs.Item 2.ProtocolIE-Field.value.UERadioCapability.UERadioAccessCapabilityInformation.criticalExtensions.c1.ueRadioAccessCapabilityInformation.ue-RadioAccessCapabilityInfo.UE-CapabilityRAT-ContainerList.Item 0.UE-CapabilityRAT-Container.ue-CapabilityRAT-Container.UE-NR-Capability.nonCriticalExtension.nonCriticalExtension.ims-Parameters.ims-ParametersCommon.voiceOverEUTRA-5GC = 0

## from GNB to AMF: InitialContextSetupResponse
# ngap.procedureCode == 14 and ngap.id == 10 and ngap.id == 85
# procedureCode: id-InitialContextSetup (14)
# id: id-AMF-UE-NGAP-ID (10)
# id: id-RAN-UE-NGAP-ID (85)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 14
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.InitialContextSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.id = 85
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.InitialContextSetupResponse.protocolIEs.Item 0.ProtocolIE-Field.id = 10

###Trigger UE Video call is Unsuccessful with 5QI5 and 5QI1 and 5QI2
## from AMF to GNB: PDUSessionResourceSetupRequest
# ngap.procedureCode == 29 and ngap.fiveQI == 5 and ngap.fiveQI == 1 and ngap.fiveQI == 2
# procedureCode: id-PDUSessionResourceSetup (29)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 5
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 1.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 29
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 2.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 2

## from GNB to AMF: PDUSessionResourceSetupResponse
# ngap.procedureCode == 29 and ngap.radioNetwork == 36
# procedureCode: id-PDUSessionResourceSetup (29)
# radioNetwork: ims-voice-eps-fallback-or-rat-fallback-triggered (36)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PDUSessionResourceSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceFailedToSetupListSURes.Item 0.PDUSessionResourceFailedToSetupItemSURes.pDUSessionResourceSetupUnsuccessfulTransfer.PDUSessionResourceSetupUnsuccessfulTransfer.cause.radioNetwork = 36
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 29

## from GNB to AMF: UEContextReleaseRequest
# ngap.procedureCode == 42 and ngap.radioNetwork == 41
# procedureCode: id-UEContextReleaseRequest (42)
# radioNetwork: redirection (41)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 41
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 42

## from AMF to GNB: UEContextReleaseCommand
# ngap.procedureCode == 41 and ngap.radioNetwork == 41
# procedureCode: id-UEContextRelease (41)
# radioNetwork: redirection (41)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 41
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 41

## from GNB to AMF: UEContextReleaseComplete
# ngap.procedureCode == 41 and ngap.id == 10
# procedureCode: id-UEContextRelease (41)
# id: id-AMF-UE-NGAP-ID (10)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 41
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 0.ProtocolIE-Field.id = 10

## F1AP: UEContextReleaseCommand
# f1ap.procedureCode == 6 and f1ap.id == 40 and f1ap.id == 41 and f1ap.radioNetwork == 10
# procedureCode: id-UEContextRelease (6)
# id: id-gNB-CU-UE-F1AP-ID (40)
# id: id-gNB-DU-UE-F1AP-ID (41)
# radioNetwork: normal-release (10)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 0.ProtocolIE-Field.id = 40
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 10
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 6
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 1.ProtocolIE-Field.id = 41

## F1AP: UEContextReleaseComplete
# f1ap.procedureCode == 6 and f1ap.id == 40 and f1ap.id == 41 and f1ap.F1AP_PDU ==1
# procedureCode: id-UEContextRelease (6)
# id: id-gNB-CU-UE-F1AP-ID (40)
# id: id-gNB-DU-UE-F1AP-ID (41)
# F1AP-PDU: successfulOutcome (1)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 0.ProtocolIE-Field.id = 40
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 1.ProtocolIE-Field.id = 41
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 6

###Release Ues
## F1AP: InitialULRRCMessageTransfer with rrcSetupRequest because UE is idle before deregister
# (f1ap.procedureCode == 11) && (nr-rrc.c1 == 0)
# procedureCode: id-InitialULRRCMessageTransfer (11)
# c1: rrcSetupRequest (0)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 11
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1 = 0

