[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# PDUSessionResourceSetupRequest, check ICS without PDU setup
# filter: ngap.procedureCode == 29 and ngap.fiveQI == 6
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 29
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 6

# PDUSessionResourceSetupResponse, check PDU setup successfully
# filter: ngap.procedureCode == 29 and ngap.id == 75
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 29
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PDUSessionResourceSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.id = 75

# BufferMonitoringNotification, check CB008311 enable and start Buffer Monitoring 
# filter: nokiaf1ap.procedureCode == 198 and nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 198
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# BufferCriterionNotification, check DU sends private unacknowledged F1AP message to inform CU DL buffer overflow condition
# filter: nokiaf1ap.procedureCode == 199 and nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 199
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

# check cell2 be added as scell
# filter: nokiaf1ap.procedureCode == 7 and nr-rrc.sCellToAddModList == 1 and nr-rrc.physCellId == 51 and nr-rrc.physCellId == 50
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 7
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList = 1 item
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 51
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50

# check ICS with PDU setup
