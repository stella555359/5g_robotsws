[Global]
RELATION: CP1
BlOCKSIZE: -1


[CP1]
#UERetentionInformation In NGSetup
#ngap.procedureCode == 21 --> NGSetupRequest/NGSetupResponse
#ngap.UERetentionInformation == 0 --> ues-retained

ethernet.ip.sctp.ngap
    ethernet.ip.source = 10.0.1.2
    ethernet.ip.destination = 10.0.1.1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 21
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGSetupRequest.protocolIEs.ProtocolIE-Field.value.UERetentionInformation = 0

ethernet.ip
    ethernet.ip.source = 10.0.1.1
    ethernet.ip.destination = 10.0.1.2
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 21
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse.protocolIEs.ProtocolIE-Field.value.UERetentionInformation = 0
