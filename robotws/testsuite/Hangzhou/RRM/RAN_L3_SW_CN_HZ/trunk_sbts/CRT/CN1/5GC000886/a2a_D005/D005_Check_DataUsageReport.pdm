[Global]
RELATION: CP1 & CP2
BLOCKSIZE: -1

# Check the message numbers in the pcap    {gNB_pcap_file}    {usage_report_condition}    {expected_messages_nums}
# Check the time interval between the messages in the pcap    {expected_periodicalDataUsageReportTimer}

[CP1]
# Analysis SecondaryRATDataUsageReport messages in the wireshark log    4    60    {X2AP_usage_report_condition}
# {X2AP_usage_report_condition}    {X2AP_FILTER}.X2AP_PDU == 0 and {X2AP_FILTER}.procedureCode == 38

# ===================Msg: 1105 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
	ethernet.ip.sctp.x2ap.x2ap_pdu = 0
	ethernet.ip.sctp.x2ap.procedure_code = 38

# ===================Msg: 2124 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
	ethernet.ip.sctp.x2ap.x2ap_pdu = 0
	ethernet.ip.sctp.x2ap.procedure_code = 38

# ===================Msg: 3131 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
	ethernet.ip.sctp.x2ap.x2ap_pdu = 0
	ethernet.ip.sctp.x2ap.procedure_code = 38

# ===================Msg: 4158 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
	ethernet.ip.sctp.x2ap.x2ap_pdu = 0
	ethernet.ip.sctp.x2ap.procedure_code = 38


[CP2]
# Analysis SecondaryRATDataUsageReport messages in the wireshark log    4    60    {E1AP_usage_report_condition}
# {E1AP_usage_report_condition}    {E1AP_FILTER}.E1AP_PDU == 0 and {E1AP_FILTER}.procedureCode == 15

# ===================Msg: 1061 start================
ethernet.ipv6.sctp.e1ap
    arrival_time = _x
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 15
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 0

# ===================Msg: 2073 start================
ethernet.ipv6.sctp.e1ap
    arrival_time = x+60 ~ x+61
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 15
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 0

# ===================Msg: 3059 start================
ethernet.ipv6.sctp.e1ap
    arrival_time = x+120 ~ x+121
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 15
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 0

# ===================Msg: 4072 start================
ethernet.ipv6.sctp.e1ap
    arrival_time = x+180 ~ x+181
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 15
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 0
