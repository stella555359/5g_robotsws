[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]

# filter: nr-rrc.TCI_StateId == 8
# Beamswitch to beamgroup#2
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequired.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigDedicated.downlinkBWP-ToAddModList.Item 0.BWP-Downlink.bwp-Dedicated.pdcch-Config.setup.controlResourceSetToAddModList.Item 0.ControlResourceSet.tci-StatesPDCCH-ToAddList.Item 0.TCI-StateId = 8

# filter: nr-rrc.TCI_StateId == 4
# Beamswitch to beamgroup#1
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequired.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigDedicated.downlinkBWP-ToAddModList.Item 0.BWP-Downlink.bwp-Dedicated.pdcch-Config.setup.controlResourceSetToAddModList.Item 0.ControlResourceSet.tci-StatesPDCCH-ToAddList.Item 0.TCI-StateId = 4
	
# filter: nr-rrc.TCI_StateId == 0
# Beam change to beamgroup#0 after deactivate testmode of UE1 
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequired.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigDedicated.downlinkBWP-ToAddModList.Item 0.BWP-Downlink.bwp-Dedicated.pdcch-Config.setup.controlResourceSetToAddModList.Item 0.ControlResourceSet.tci-StatesPDCCH-ToAddList.Item 0.TCI-StateId = 0
	
#UE2:

# filter: nr-rrc.TCI_StateId == 8
# Add beamgroup#2
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequired.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigDedicated.downlinkBWP-ToAddModList.Item 0.BWP-Downlink.bwp-Dedicated.pdcch-Config.setup.controlResourceSetToAddModList.Item 0.ControlResourceSet.tci-StatesPDCCH-ToAddList.Item 0.TCI-StateId = 8