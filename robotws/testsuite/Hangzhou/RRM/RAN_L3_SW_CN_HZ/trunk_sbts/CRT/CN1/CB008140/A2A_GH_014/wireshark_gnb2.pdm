[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# setp: c.A1 scell addition MR send from UE,FTTF 4CC add successful,check Prime_DU_to_Ext_DU DRX-Config
# filter: nr-rrc.drx_LongCycleStartOffset == 9 and nr-rrc.drx_LongCycleStartOffset == 3
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAUeContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.Prime-DU-to-Ext-DU-RRC-Information-Container.Prime-DU-to-Ext-DU-RRC-Information.drx-Configuration-Information.Item 0.DRX-Configuration-Information-Item.appliedDRX-Config.DRX-Config.drx-LongCycleStartOffset = 3
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAUeContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.Prime-DU-to-Ext-DU-RRC-Information-Container.Prime-DU-to-Ext-DU-RRC-Information.drx-Configuration-Information.Item 0.DRX-Configuration-Information-Item.defaultDRX-Config.DRX-Config.drx-LongCycleStartOffset = 9

# setp: d.add non-VONR GBR 5QI-2 call,VONR DRX released,check DRXConfigurationIndicator
# filter: nokiaf1ap.DRXConfigurationIndicator == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAUeContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.DRXConfigurationIndicator = 0
	
# setp: e.release non-VONR GBR 5QI-2 call,VONR DRX setup,check DRX-Config
# filter: nr-rrc.drx_LongCycleStartOffset == 3 and nokiaf1ap.procedureCode == 193
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 193
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAUeContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.Prime-DU-to-Ext-DU-RRC-Information-Container.Prime-DU-to-Ext-DU-RRC-Information.drx-Configuration-Information.Item 0.DRX-Configuration-Information-Item.appliedDRX-Config.DRX-Config.drx-LongCycleStartOffset = 3

