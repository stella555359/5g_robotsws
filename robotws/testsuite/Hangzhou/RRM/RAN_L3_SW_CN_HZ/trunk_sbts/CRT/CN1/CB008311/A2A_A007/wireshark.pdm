[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# BufferMonitoringNotification, check CB008311 enable and start Buffer Monitoring 
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# itf_l2_ps_user_DlBufferMonitoringInd_t,check value of dlSCellConfigLevel and dlSCellConfigLevelNum
# filter: itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevel == 10 and itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevelNum == 20
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_dlbuffermonitoringind.itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevel (Uint8) = 10
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_dlbuffermonitoringind.itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevelNum (Uint8) = 20

# BufferCriterionNotification, check DU sends private unacknowledged F1AP message to inform CU DL buffer overflow condition
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

# BufferMonitoringNotification, check CB008311 enable and start Buffer Monitoring 
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# itf_l2_ps_user_DlBufferMonitoringInd_t,check value of dlSCellConfigLevel and dlSCellConfigLevelNum
# filter: itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevel ==20 and itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevelNum == 25
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_dlbuffermonitoringind.itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevel (Uint8) = 15
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_dlbuffermonitoringind.itf_l2_ps_user_DlBufferMonitoringInd_t.dlSCellConfigLevelNum (Uint8) = 25

# BufferCriterionNotification, check DU sends private unacknowledged F1AP message to inform CU DL buffer overflow condition
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

