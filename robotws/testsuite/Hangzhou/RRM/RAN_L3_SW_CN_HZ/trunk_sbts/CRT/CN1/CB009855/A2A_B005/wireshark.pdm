[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#UE1 is attch to pcell nrcell-1: maxcodrate=zeroDot15, drx setup
# filter: nr-rrc.drx_Config == 1 and nr-rrc.maxCodeRate == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.Item 0.BWP-Uplink.bwp-Dedicated.pucch-Config.setup.format3.setup.maxCodeRate = 1

#trigger A1, 2T3F CA check maxCodeRate, report for csirs existing, drx is on
# filter: nr-rrc.maxCodeRate == 1 and nr-rrc.csi_ReportConfigToAddModList == 5 and nr-rrc.sCellToAddModList == 4 and nr-rrc.drx_Config == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList = 4 items
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.spCellConfigDedicated.csi-MeasConfig.setup.csi-ReportConfigToAddModList = 5 items
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.Item 0.BWP-Uplink.bwp-Dedicated.pucch-Config.setup.format3.setup.maxCodeRate = 1

#trigger A2 on PCell for PCell change to scell nrcell_11: maxcoderate 0.15 same as the configure on NIDD. drx release.
# filter: nr-rrc.sCellToReleaseList == 4 and nr-rrc.drx_Config == 0 and nr-rrc.maxCodeRate == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToReleaseList = 4 items
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.Item 0.BWP-Uplink.bwp-Dedicated.pucch-Config.setup.format3.setup.maxCodeRate = 1

#blind FFFTT CA made. check maxcoderate downgrade to 0.08
# filter: nr-rrc.maxCodeRate == 0 and nr-rrc.sCellToAddModList == 4 and nr-rrc.csi_ReportConfigToAddModList == 4 and nr-rrc.maxPayloadSize == 8
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList = 4 items
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.spCellConfigDedicated.csi-MeasConfig.setup.csi-ReportConfigToAddModList = 4 items
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.Item 0.BWP-Uplink.bwp-Dedicated.pucch-Config.setup.format3.setup.maxCodeRate = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.Item 0.BWP-Uplink.bwp-Dedicated.pucch-Config.setup.resourceSetToAddModList.Item 0.PUCCH-ResourceSet.maxPayloadSize = 8

#drx setup
# filter: nr-rrc.drx_Config == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1

