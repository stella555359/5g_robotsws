# id: id-PDUSessionResourceSetupListCxtRes (72)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.InitialContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.id = 72
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 14
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.InitialContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtRes.Item 0.PDUSessionResourceSetupItemCxtRes.pDUSessionResourceSetupResponseTransfer.PDUSessionResourceSetupResponseTransfer.dLQosFlowPerTNLInformation.associatedQosFlowList.Item 0.AssociatedQosFlowItem.qosFlowIdentifier = 1

## from AMF to GNB: PDUSessionResourceSetupRequest with 5QI2
# ngap.procedureCode == 29 and ngap.fiveQI == 2
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 2
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 29

## from GNB to AMF: PDUSessionResourceSetupResponse with invalid-qos-combination
# ngap.procedureCode == 29 and ngap.radioNetwork == 23
# radioNetwork: invalid-qos-combination (23)
