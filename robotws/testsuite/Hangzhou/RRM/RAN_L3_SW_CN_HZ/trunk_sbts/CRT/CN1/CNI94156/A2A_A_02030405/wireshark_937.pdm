[Global]
RELATION: CP1
BlOCKSIZE: -1

#RrcSetup:masterCellGroup:spCellConfig:spCellConfigDedicated contains:
# initialDownlinkBWP:pdcch-Config IE with type 3 and User Specific Search Space and ControlResourceSet IE configured (based on tables in 5G_CP_OTH_8548, 5G_CP_OTH_8551) according to PDCCH_CONFIG_DEDICATED in initial BWP_PROFILE
# initialDownlinkBWP:pdsch-Config IE configured for BWP-ID=0
# firstActiveDownlinkBWP-Id=0
# uplinkConfig:initialUplinkBWP:pucch-Config IE
# uplinkConfig:initialUplinkBWP:pusch-Config IE
# uplinkConfig:initialUplinkBWP:srs-Config IE
# uplinkConfig:firstActiveUplinkBWP-Id=0
# csi-MeasConfig with CSI measurements configuration for BWP-ID=0.

#with 937 enable should have Bwp-id 2
#The rrcReconfiguration:CellGroupConfig:spCellConfig:spCellConfigDedicated contains IE‘s:
# initialDownlinkBWP:pdcch-Config: release
# initialDownlinkBWP:pdsch-Config: release
# downlinkBWP-ToAddModList containing configuration of two dedicated BWPs (based on info in dedicated BWP_PROFILE and in power saving BWP_PROFILE), for each BWP the following IE are added:
# bwp-Id: 1 for dedicated BWP, 2 for power saving BWP
# bwp-Common IE
# bwp-Dedicated IE
# firstActiveDownlinkBWP-Id: 1
# uplinkConfig:initialUplinkBWP:pucch-Config: release
# initialUplinkBWP:pusch-Config: release
# uplinkConfig:initialUplinkBWP:srs-Config: release
# uplinkConfig:uplinkBWP-ToAddModList containing configuration of two dedicated BWPs (based on info in dedicated BWP_PROFILE and in power saving BWP_PROFILE)
# bwp-Id: 1 for dedicated BWP, 2 for power saving BWP
# bwp-Common IE
# bwp-Dedicated IE
# uplinkConfig:firstActiveUplinkBWP-Id: 1
# csi-MeasConfig switch from BWP-0 to BWP-1

[CP1]
#CP1 is for UE attach procedure
#For msg RRC setup request
# filter: f1ap.procedureCode == 11 and nr-rrc.c1 == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 11
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1 = 0

#For msg RRC setup
# filter: f1ap.procedureCode == 12 and nr-rrc.c1 == 1 and nr-rrc.pdcch_Config == 1 and nr-rrc.pdsch_Config == 1 and nr-rrc.firstActiveDownlinkBWP_Id == 0 and nr-rrc.pucch_Config == 1 and nr-rrc.pusch_Config == 1 and nr-rrc.srs_Config == 1 and nr-rrc.firstActiveUplinkBWP_Id == 0 and nr-rrc.bwp_Id == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 12
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup.criticalExtensions.rrcSetup.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.csi-MeasConfig.setup.csi-ResourceConfigToAddModList.CSI-ResourceConfig.bwp-Id = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup.criticalExtensions.rrcSetup.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.uplinkConfig.initialUplinkBWP.pusch-Config = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup.criticalExtensions.rrcSetup.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.initialDownlinkBWP.pdcch-Config = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup.criticalExtensions.rrcSetup.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.uplinkConfig.initialUplinkBWP.srs-Config = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1 = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup.criticalExtensions.rrcSetup.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.firstActiveDownlinkBWP-Id = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup.criticalExtensions.rrcSetup.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.uplinkConfig.initialUplinkBWP.pucch-Config = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup.criticalExtensions.rrcSetup.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.initialDownlinkBWP.pdsch-Config = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup.criticalExtensions.rrcSetup.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.uplinkConfig.firstActiveUplinkBWP-Id = 0

# filter: f1ap.procedureCode == 13 and nr-rrc.c1 == 2
#For msg rrcSetupComplete
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 13
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 2

# filter: ngap.procedureCode == 15
#For msg InitialUEMessage
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 15

# filter: ngap.procedureCode == 14 and ngap.NGAP_PDU == 0
#For msg InitialContextSetupRequest
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 14

# filter: f1ap.procedureCode == 12 and nr-rrc.c1 == 0 and nr-rrc.pdcch_Config == 0 and nr-rrc.pdsch_Config == 0 and nr-rrc.downlinkBWP_ToAddModList == 2 and nr-rrc.bwp_Id == 1 and nr-rrc.bwp_Id == 2 and nr-rrc.firstActiveDownlinkBWP_Id == 1 and nr-rrc.pucch_Config == 0 and nr-rrc.pusch_Config == 0 and nr-rrc.srs_Config == 0 and nr-rrc.uplinkBWP_ToAddModList == 2 and nr-rrc.firstActiveUplinkBWP_Id == 1 and nr-rrc.bwp_Id == 1
