[Global]
RELATION: CP1&(CP2|CP3)
BlOCKSIZE: -1

[CP1]
#UE1 HO from gNB1 and setup pduSession
# filter: nokiaxnap.pduSessionId == 2 and nokiaxnap.id == 83
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.id = 83
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.pduSessionResourcesToBeSetup-List.Item 1.PDUSessionResourcesToBeSetup-Item.pduSessionId = 2

# filter: nokiaxnap.pduSessionId == 2 and nokiaxnap.id == 73 and nokiaxnap.id == 79
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 73
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.id = 79
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourcesAdmitted-List.Item 1.PDUSessionResourcesAdmitted-Item.pduSessionId = 2

#UE1 trigger UEContextReleaseRquest because of ulbler
# filter: nokiaf1ap.procedureCode == 10 and nokiaf1ap.radioNetwork == 15
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 10
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 15

#UE1 trigger RRC Release with redirect
# filter: nr-rrc.carrierFreq == 663360 and nr-rrc.deprioritisationTimer == 0 and nr-rrc.deprioritisationType == 0 and nr-rrc.redirectedCarrierInfo == 0 and nr-rrc.criticalExtensions == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.deprioritisationReq.deprioritisationTimer = 3
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.deprioritisationReq.deprioritisationType = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.redirectedCarrierInfo = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.redirectedCarrierInfo.nr.carrierFreq = 663360
#UE1 ContextReleaseRquest on ngap
# filter: ngap.radioNetwork == 41 and ngap.procedureCode == 42
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 42
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.Item 3.ProtocolIE-Field.value.Cause.radioNetwork = 41

[CP2]
#UE2 ContextReleaseComplete
# filter: ngap.pDUSessionID == 1 and ngap.pDUSessionID == 2 and ngap.PDUSessionResourceListCxtRelCpl == 2
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceListCxtRelCpl = 2 items
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceListCxtRelCpl.Item 0.PDUSessionResourceItemCxtRelCpl.pDUSessionID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceListCxtRelCpl.Item 1.PDUSessionResourceItemCxtRelCpl.pDUSessionID = 2

#UE2 ContextReleaseCommand on f1ap
# filter: nokiaf1ap.radioNetwork == 15 and nokiaf1ap.procedureCode == 6
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 6
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 15
	
[CP3]
#UE2 ContextReleaseCommand on f1ap
# filter: nokiaf1ap.radioNetwork == 15 and nokiaf1ap.procedureCode == 6
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 6
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 15

#UE2 ContextReleaseComplete
# filter: ngap.pDUSessionID == 1 and ngap.pDUSessionID == 2 and ngap.PDUSessionResourceListCxtRelCpl == 2
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceListCxtRelCpl = 2 items
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceListCxtRelCpl.Item 0.PDUSessionResourceItemCxtRelCpl.pDUSessionID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceListCxtRelCpl.Item 1.PDUSessionResourceItemCxtRelCpl.pDUSessionID = 2

