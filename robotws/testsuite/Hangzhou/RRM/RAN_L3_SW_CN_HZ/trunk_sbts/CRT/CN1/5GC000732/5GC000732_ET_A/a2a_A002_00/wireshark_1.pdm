[Global]
RELATION: CP1 
BlOCKSIZE: -1


[CP1]
#RRCReestablishmentRequest/Initial UL RRC Message Transfer   
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.reestablishmentCause = 1

#e1ap.BearerContextModificationRequest_element &&e1ap.pDU_Session_ID == 1 && e1ap.dRB_ID == 4
#	&&e1ap.pDU_Session_ID == 2 && e1ap.dRB_ID == 5
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequest.nG-RAN-BearerContextModificationRequest.ProtocolIE-Field.value.PDU-Session-Resource-To-Modify-List.PDU-Session-Resource-To-Modify-Item.dRB-To-Modify-List-NG-RAN.DRB-To-Modify-Item-NG-RAN.dRB-ID = 4
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequest.nG-RAN-BearerContextModificationRequest.ProtocolIE-Field.value.PDU-Session-Resource-To-Modify-List.PDU-Session-Resource-To-Modify-Item.pDU-Session-ID = 1
	ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequest.nG-RAN-BearerContextModificationRequest.ProtocolIE-Field.value.PDU-Session-Resource-To-Modify-List.PDU-Session-Resource-To-Modify-Item.dRB-To-Modify-List-NG-RAN.DRB-To-Modify-Item-NG-RAN.dRB-ID = 5
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationRequest.nG-RAN-BearerContextModificationRequest.ProtocolIE-Field.value.PDU-Session-Resource-To-Modify-List.PDU-Session-Resource-To-Modify-Item.pDU-Session-ID = 2
	
#F1AP DL RRC Message Transfer/RRC RRCReestablishment message
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReestablishment.criticalExtensions.rrcReestablishment.nextHopChainingCount = 0
    
#F1AP: RRCReestablishmentComplete
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcReestablishmentComplete = *

#E1AP Bearer Context Modification Response
ethernet.ipv6.sctp.e1ap 	
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationResponse.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationResponse.nG-RAN-BearerContextModificationResponse.ProtocolIE-Field.value.PDU-Session-Resource-Modified-List.PDU-Session-Resource-Modified-Item.dRB-Modified-List-NG-RAN.DRB-Modified-Item-NG-RAN.dRB-ID = 4
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationResponse.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationResponse.nG-RAN-BearerContextModificationResponse.ProtocolIE-Field.value.PDU-Session-Resource-Modified-List.PDU-Session-Resource-Modified-Item.dRB-Modified-List-NG-RAN.DRB-Modified-Item-NG-RAN.dRB-ID = 5

#nr-rrc.rrcReconfiguration_element && nr-rrc.srb_ToAddModList == 1
#&& nr-rrc.srb_Identity == 2 && nr-rrc.reestablishPDCP == 0 && nr-rrc.drb_ToAddModList == 2
#&& nr-rrc.drb_Identity == 4 && nr-rrc.reestablishRLC == 0 
#&& nr-rrc.drb_Identity == 5     
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.DRB-ToAddMod.drb-Identity = 4
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.DRB-ToAddMod.drb-Identity = 5
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.DRB-ToAddMod.reestablishPDCP = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.rlc-BearerToAddModList.RLC-BearerConfig.reestablishRLC = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.rlc-BearerToAddModList.RLC-BearerConfig.servedRadioBearer.srb-Identity = 2

#F1AP UL RRC Message Transfer/RRC RRCReconfigurationComplete
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcReconfigurationComplete = *

#F1AP UE Context Modification Response
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field = *

#F1AP UEContextModificationResponse
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.ProtocolIE-Field = *
