[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nokiaf1ap.procedureCode == 191 and nokiaf1ap.XpConnectionStatus == 1
#gNB-3-DU sends F1AP: XP CONNECTION STATUS NOTIFICATION message to gNB-3-CU-CP to indicate that Xp-C link towards gNB-2 is available
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 191
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.XpConnectionStatusNotification.protocolIEs.Item 2.ProtocolIE-Field.value.XpConnectionStatus = 1

# filter: nokiaxnap.procedureCode == 138 and nokiaxnap.NR-Cell-Identity == 0x000000800b and nokiaxnap.cell_Availability == 1 and nokiaxnap.NR-Cell-Identity == 0x000000800c and nokiaxnap.cell_Availability == 1
#gNB-3-CU-CP sends towards gNB-2-CU-CP XNAP: IGNB CA CONFIGURATION UPDATE INDICATION with Cell3_1 and Cell3_2 present on ReportedCellList with cell-Availability IE set to ‘available’
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 138
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.cell-Availability = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.nr-cell.nr-CI = 0x000000800b
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 1.CellReportItem.cell-Availability = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 1.CellReportItem.nr-cell.nr-CI = 0x000000800c
