[Global]

RELATION: CP1&CP2&CP3&CP4
BLOCKSIZE: -1

[CP1]
#A2 MR is received via X2::RRC Transfer
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.x2ap_pdu = 0
	
	ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message = 0
	
	ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.id = 243
	
    ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measId = 1
	
[CP2]	
#A5 inter-frequency Measurement Report is received via X2::RRC Transfer.
ethernet.ip.sctp.x2ap

    ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measId = 4
	ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultNeighCells.measResultListNR.Item 0.MeasResultNR.physCellId = 51
	ethernet.ip.sctp.x2ap.id-NRUeReport.ProtocolIE-Field.value.NRUeReport.uENRMeasurements.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.physCellId = 50
	
[CP3]
#in F1::UE CONTEXT MODIFICATION RESPONSE message
#downlinkConfigCommonfrequencyInfoDL.MultiFrequencyBandListNR.FreqBandIndicatorNR = n48
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 48

[CP4]
#RRC Reconfiguration shall be sent to MeNB via X2::SGNB MODIFICATION REQUIRED
#measConfig.measObjectToAddModList.measObjectNR.freqBandIndicatorNR =n48
#in SgNB Modification Required message, SgNBtoMeNBContainer -> selectedbandCombinationNR set with current combination(LTE+NRn48)
ethernet.ip.sctp.x2ap
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 48
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.selectedBandCombination.bandCombinationIndex = 2
	