[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#checkpoint :IgNBCAReleaseRequest,IgNBCAUeContextReleaseCommand,IgNBCAUeContextReleaseComplete,IgNBCAReleaseRequestAcknowledge.
#SA Inter-RAT Handover to LTE in IgNB-CA mode then IRAT HO back to origianl cell for 5rounds, and UE deregister.Every four is a cycle, so total 6 cycles.
#nokiaxnap.IgNBCAReleaseRequest_element
# filter: nokiaxnap.procedureCode == 142 and nokiaxnap.radioNetwork == 65
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 142
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAReleaseRequest.protocolIEs.Item 2.ProtocolIE-Field.value.IgNBCACause.standardCause.radioNetwork = 65

#nokiaf1ap.IgNBCAUeContextReleaseCommand_element
# filter: nokiaf1ap.procedureCode == 194 and nokiaf1ap.radioNetwork == 10
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 194
