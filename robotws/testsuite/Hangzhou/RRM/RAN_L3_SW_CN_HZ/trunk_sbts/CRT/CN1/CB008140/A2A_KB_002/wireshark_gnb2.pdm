[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nokiaxnap.procedureCode == 141 and nokiaxnap.IgNB_CA_SCell_ToBeRemoved_List == 1 and nokiaxnap.NR-Cell-Identity == 0x0000008003
#Druing cell2_3 is shutting down procedure,trigger A2 to release UE3 scell_1(cell2_3)
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 141
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.IgNB-CA-SCell-ToBeRemoved-List = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.IgNB-CA-SCell-ToBeRemoved-List.Item 0.IgNB-CA-SCell-ToBeRemoved-Item.sCell-ID.nr-CI = 0x0000008003

# filter: nokiaxnap.procedureCode == 141
#UE3 scell_1(cell2_3) is released
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.procedureCode = 141

# filter: nokiaxnap.procedureCode == 140 and nokiaxnap.radioNetwork == 0
#gNB2 sends XnAP: NG-RAN NODE CONFIGURATION UPDATE indicating Cell2_3 addition to gNB1
#Druing cell2_3 is shutting down procedure,UE5 is rejected to add cell2_3 as scell
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.unsuccessfulPrivateOutcome.procedureCode = 140
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.unsuccessfulPrivateOutcome.value.IgNBCAAdditionRequestReject.protocolIEs.Item 2.ProtocolIE-Field.value.IgNBCACause.standardCause.radioNetwork = 0

# filter: nokiaxnap.procedureCode == 18 and nokiaxnap.served_Cells_ToAdd_NR == 1 and nokiaxnap.NR-Cell-Identity == 0x0000008003
#cell2_3 is unlocked
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.procedureCode = 18
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.ConfigurationUpdateInitiatingNodeChoice.gNB.Item 0.ProtocolIE-Field.value.ServedCellsToUpdate-NR.served-Cells-ToAdd-NR = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.ConfigurationUpdateInitiatingNodeChoice.gNB.Item 0.ProtocolIE-Field.value.ServedCellsToUpdate-NR.served-Cells-ToAdd-NR.Item 0.ServedCells-NR-Item.served-cell-info-NR.cellID.nr-CI = 0x0000008003

