[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
# RRC setup complete
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcSetupComplete.criticalExtensions.rrcSetupComplete = *
	
#RRC reconfiguration and drx setup,start retry timer
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1
	arrival_time = _x
	
#RRC Reconfiguration with gapFR1 setup, drx release, and A4 MEAS config
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapFR1 = 1
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 1.MeasIdToAddMod.measId = 2
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 2.MeasIdToAddMod.measId = 3
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 3.MeasIdToAddMod.measId = 4
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 1
	arrival_time = x+5~x+6

# measurement report for meas id 3
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.10  ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measId = 3
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.10  ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultNeighCells.measResultListNR.Item 0.MeasResultNR.physCellId = 60

# measurement report for meas id 3
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.11  ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measId = 3
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.11  ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultNeighCells.measResultListNR.Item 0.MeasResultNR.physCellId = 51

# measurement report for meas id 4
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.12  ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measId = 4
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.12  ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultNeighCells.measResultListNR.Item 0.MeasResultNR.physCellId = 381

# HandoverRequest
ethernet.ip.sctp.xnap
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.rrc-Context.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.rrm-Config.candidateCellInfoList.Item 0.MeasResult2NR.measResultNeighCellListNR.Item 0.MeasResultNR.physCellId = 381
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.rrc-Context.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.s-MeasureConfig.ssb-RSRP = 127
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.rrc-Context.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.sourceConfig.rrcReconfiguration.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList = 4 items

# HandoverRequestAckNowledge
ethernet.ip.sctp
	ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs = 4 items
    arrival_time = x+15~x+16
	
# RRC Reconfiguration with gapFR1 setup 
#ethernet.ipv6.sctp.f1ap
	#ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapFR1 = 1
	

# HandoverRequest
ethernet.ip.sctp
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.rrc-Context.HandoverPreparationInformation.criticalExtensions.c1.handoverPreparationInformation.rrm-Config.candidateCellInfoList.Item 0.MeasResult2NR.measResultNeighCellListNR.Item 0.MeasResultNR.physCellId = 50

# HandoverRequestAckNowledge
ethernet.ip.sctp.xnap
	ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs = 4 items

#RRCReconfiguration complete
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcReconfigurationComplete.criticalExtensions.rrcReconfigurationComplete = *
	
# RRC Reconfiguration with drx-Config setup
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1
	arrival_time = _y

# RRC Reconfiguration with gapFR1 setup, drx-Config release, and A4 MEAS config
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapFR1 = 1
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList = 4 items
	arrival_time = y+5~y+6

#NGAP--UEcontextReleasecommand
ethernet.ip.sctp
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand = *

#NGAP--UEcontextReleaseCompleate
ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete = *	
	
	
