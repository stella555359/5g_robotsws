[Global]

RELATION: CP1

BlOCKSIZE: -1

[CP1]
#UE1 attach to cell2_11, and A1MR for scell addition active
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList = 1 item

#check drb-DL-Information-List
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.Item 5.ProtocolIE-Field.value.SCell-For-IgNB-CA-Establishment-Setup-List.Item 0.SCell-For-IgNB-CA-Establishment-Setup-Item = None

#scell1_2 and scell1_2 addition, A2MR active,A1MR release
ethernet.ipv6.sctp.f1ap
