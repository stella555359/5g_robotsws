ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.Item 5.ProtocolIE-Field.value.SCell-For-IgNB-CA-Establishment-Setup-List.Item 0.SCell-For-IgNB-CA-Establishment-Setup-Item = None
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.Item 6.ProtocolIE-Field.value.IgNB-CA-SCell-Failed-to-Setup-List.Item 0.IgNB-CA-SCell-Failed-to-Setup-Item.igNBCACause.standardCause.radioNetwork = 29
