	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType = 1
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList = 2 items

#IGNB CA RESOURCE STATUS UDPATE is periodic sent
ethernet.ip.sctp.xnap.XnAP-PDU
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult = 2 items

#ReestablishmentRequest back to cell2_11
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcReestablishmentRequest.rrcReestablishmentRequest.reestablishmentCause = 1
	
#rrcReestablishmentComplete	
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcReestablishmentComplete.criticalExtensions.rrcReestablishmentComplete = None

