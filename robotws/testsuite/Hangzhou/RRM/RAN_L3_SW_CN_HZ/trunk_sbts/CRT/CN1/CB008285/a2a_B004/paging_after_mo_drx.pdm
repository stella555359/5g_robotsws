[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#Verify NGAP paging message
# filter: ngap.PagingDRX == 3
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.Paging.protocolIEs.Item 1.ProtocolIE-Field.value.PagingDRX = 3
	

#Verify RRCSetupRequest
# filter: nr-rrc.establishmentCause == 2
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.InitialULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-CCCH-Message.message.c1.rrcSetupRequest.rrcSetupRequest.establishmentCause = 2

#Verify InitialUEMessage after paging
# filter: ngap.RRCEstablishmentCause == 2
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialUEMessage.protocolIEs.Item 3.ProtocolIE-Field.value.RRCEstablishmentCause = 2
	

#Verify InitialContextSetupResponse
# filter: ngap.NGAP_PDU == 1 and ngap.criticality == 0 and ngap.procedureCode == 14
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.criticality = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 14