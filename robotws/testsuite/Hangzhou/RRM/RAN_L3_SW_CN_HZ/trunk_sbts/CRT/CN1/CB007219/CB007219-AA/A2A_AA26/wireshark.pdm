    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 64
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.frequencyBandList.Item 0.FreqBandIndicatorNR = 7

#trigger A1 MR
