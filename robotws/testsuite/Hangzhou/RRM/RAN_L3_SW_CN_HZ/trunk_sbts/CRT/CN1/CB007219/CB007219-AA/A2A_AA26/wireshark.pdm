[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# check freqBandIndicatorNR is 7 and event A1,carrierBandwidth == 79 is configured in RRC Reconfiguration
# filter: nr-rrc.ssbFrequency == 530910 and nr-rrc.eventId == 0 and nr-rrc.freqBandIndicatorNR == 7 and nr-rrc.carrierBandwidth == 79
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 7
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.ssbFrequency = 530910
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.downlinkChannelBW-PerSCS-List.Item 0.SCS-SpecificCarrier.carrierBandwidth = 79
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.uplinkConfig.uplinkChannelBW-PerSCS-List.Item 0.SCS-SpecificCarrier.carrierBandwidth = 79

# DUtoCURRCInformation pcellid is 62,band is 25 in UEContextModificationResponse
# filter: nokiaf1ap.id == 39 and nr-rrc.physCellId == 64 and nr-rrc.FreqBandIndicatorNR == 7 and nokiaf1ap.procedureCode == 7
