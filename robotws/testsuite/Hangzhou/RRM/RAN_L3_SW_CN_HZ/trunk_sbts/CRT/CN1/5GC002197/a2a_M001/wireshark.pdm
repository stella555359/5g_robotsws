[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#Step 1:Check searchSpaceId change after delta commission
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Served-Cells-To-Add-List.Item 0.ProtocolIE-SingleContainer.value.Served-Cells-To-Add-Item.gNB-DU-System-Information.sIB1-message.SIB1.servingCellConfigCommon.downlinkConfigCommon.initialDownlinkBWP.pdcch-ConfigCommon.setup.commonSearchSpaceList.Item 0.SearchSpace.searchSpaceId = 33

ethernet.ipv6.sctp.f1ap	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.GNBDUConfigurationUpdateAcknowledge = None

#Step 2:Check searchSpaceId change after delta commission
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Served-Cells-To-Modify-List.Item 0.ProtocolIE-SingleContainer.value.Served-Cells-To-Modify-Item.gNB-DU-System-Information.sIB1-message.SIB1.servingCellConfigCommon.downlinkConfigCommon.initialDownlinkBWP.pdcch-ConfigCommon.setup.commonSearchSpaceList.Item 0.SearchSpace.searchSpaceId = 33
	
ethernet.ipv6.sctp.f1ap	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.GNBDUConfigurationUpdateAcknowledge = None


	