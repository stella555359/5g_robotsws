[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# check SgNBAdditionRequest message
ethernet.ip.sctp
	ethernet.ip.sctp.x2ap.id-SGNB-Addition-Trigger-Ind.ProtocolIE-Field.value.SGNB-Addition-Trigger-Ind = 1
	
# check SgNBAdditionRequestAcknowledge message
ethernet.ip.sctp.x2ap	
	ethernet.ip.sctp.x2ap.id-RRCConfigIndication.ProtocolIE-Field.value.RRC-Config-Ind = 1

# check SgNBReleaseRequest
ethernet.ip.sctp
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 21

# check SgNBReleaseRequestAcknowledge
ethernet.ip.sctp.x2ap
	ethernet.ip.sctp.x2ap.x2ap_pdu = 1
	ethernet.ip.sctp.x2ap.procedure_code = 31

# check ErrorIndication
ethernet.ip.sctp
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 5