[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
# rrcReconfiguration: add cell-1 A1 report config (a1ThresholdSCellAddSsbRsrpFDD=75)
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.ssbFrequency = 518910
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA1.a1-Threshold_rsrp = 75


# A1 measurement report on cell-1
UL-DCCH-Message
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.physCellId = 50
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrp = 100
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrq = 30

# Cell-2 and cell-13 are added as SCells for cell-1
# add a2 report (a2ThresholdSCellRelSsbRsrp=35) on cell-2 and cell-13, and add cell-1 a2 report (a2ThresholdPCellSwitchSsbRsrp=60)
# remove cell-1 A1 report config (a1ThresholdSCellAddSsbRsrpFDD=75)
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.a2-Threshold_rsrp = 35
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None_1.reportConfigNR.eventTriggered.eventA2.a2-Threshold_rsrp = 60
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectNR.ssbFrequency = 633216
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None_1.measObjectNR.ssbFrequency = 427970
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellIndex = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 51
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellIndex = 2
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None_1.sCellConfigCommon.physCellId = 62

# A2 measurementReport on cell-13 with rsrp 20 to trigger scell release
UL-DCCH-Message
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None_1.measResultServingCell.physCellId = 62
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None_1.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrp = 20
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None_1.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrq = 20

# rrcReconfiguration: release cell-13, and remove cell-1 a2 report (a2ThresholdPCellSwitchSsbRsrp=60), remove cell-13 a2 report (a2ThresholdSCellRelSsbRsrp=35)
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToReleaseList.2 = 2

# A2 measurementReport on cell-2 with rsrp 20 to trigger scell release
UL-DCCH-Message
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None.measResultServingCell.physCellId = 50
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None_1.measResultServingCell.physCellId = 51
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None_1.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrp = 20
    UL-DCCH-Message.measurementReport.measurementReport.measResults.measResultServingMOList.None_1.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrq = 20

# rrcReconfiguration: release cell-2, and remove cell-2 a2 report (a2ThresholdSCellRelSsbRsrp=35), add cell-1 A1 report (a1ThresholdSCellAddSsbRsrpFDD=75)
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToReleaseList.1 = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA1.a1-Threshold_rsrp = 75
