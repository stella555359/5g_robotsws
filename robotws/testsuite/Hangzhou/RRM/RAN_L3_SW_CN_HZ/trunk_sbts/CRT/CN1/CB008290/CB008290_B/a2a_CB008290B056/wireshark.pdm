[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
#drx setup
ethernet.ipv6.sctp.f1ap	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1

#scell add: A2scell release,  A6 on Cell-3 are setup, scell add and scell index =1, meas id 3,4 add, meas id 1,2 remove
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToAddModList.SCellConfig.sCellIndex = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA2 = None
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA6 = None
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.MeasIdToAddMod.measId = 3
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.MeasIdToAddMod.measId = 4
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.MeasId = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.MeasId = 2

#send A6MR to trigger Scell swap from cell-3 to cell-4 failed 
ethernet.ipv6.sctp.f1ap
   ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultNeighCells.measResultListNR.MeasResultNR.physCellId = 53
   ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport = None
 
#UEcontextModificationFailure: cause 
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.unsuccessfulOutcome.value.UEContextModificationFailure.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 8
 
#MR for A2scell release
ethernet.ipv6.sctp.f1ap
   ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.MeasResultServMO.measResultServingCell.physCellId = 52
   ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport = None

#One UE A2 scell release RRC check, scell release index 1
ethernet.ipv6.sctp.f1ap
   ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToReleaseList.Item 0.SCellIndex = 1
   ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.Item 1.MeasId = 4
   ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.Item 0.MeasId = 3
   
#send A6MR to trigger Scell swap on UE 15 from scell cell-3 to cell-4 again should successfully
ethernet.ipv6.sctp.f1ap
   ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultNeighCells.measResultListNR.MeasResultNR.physCellId = 53
   ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport = None
  
#A6 swap RRC:
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToAddModList.SCellConfig.sCellIndex = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA6 = None
