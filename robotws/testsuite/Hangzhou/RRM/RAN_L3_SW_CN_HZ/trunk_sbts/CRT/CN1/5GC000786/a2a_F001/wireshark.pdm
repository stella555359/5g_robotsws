[Global]
RELATION: CP1&CP2
BlOCKSIZE: -1

[CP1]
####Trigger UE register in cell1
## from GNB to AMF: InitialUEMessage with Registration request
# ngap.UEContextRequest == 0
# UEContextRequest: requested (0)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialUEMessage.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextRequest = 0

## from AMF to GNB: InitialContextSetupRequest
# ngap.procedureCode == 14 and ngap.id == 146 and ngap.RedirectionVoiceFallback == 0
# procedureCode: id-InitialContextSetup (14)
# id: id-RedirectionVoiceFallback (146)
# RedirectionVoiceFallback: possible (0)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 14
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.id = 146
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.RedirectionVoiceFallback = 0

## F1AP: DLRRCMessageTransfer with securityModeCommand
# nr-rrc.cipheringAlgorithm == 0 and nr-rrc.integrityProtAlgorithm == 2
# cipheringAlgorithm: nea0 (0)
# integrityProtAlgorithm: nia2 (2)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.2   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.securityModeCommand.criticalExtensions.securityModeCommand.securityConfigSMC.securityAlgorithmConfig.cipheringAlgorithm = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.2   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.securityModeCommand.criticalExtensions.securityModeCommand.securityConfigSMC.securityAlgorithmConfig.integrityProtAlgorithm = 2

## F1AP: DLRRCMessageTransfer with ueCapabilityEnquiry
# f1ap.procedureCode == 12 and f1ap.SRBID == 1 and nr-rrc.rat_Type == 0
# procedureCode: id-DLRRCMessageTransfer (12)
# rat-Type: nr (0)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 12
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 2.ProtocolIE-Field.value.SRBID = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.3   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.ueCapabilityEnquiry.criticalExtensions.ueCapabilityEnquiry.ue-CapabilityRAT-RequestList.Item 0.UE-CapabilityRAT-Request.rat-Type = 0

## F1AP: ULRRCMessageTransfer with securityModeComplete
# f1ap.procedureCode == 13 and nr-rrc.c1 == 5
# procedureCode: id-ULRRCMessageTransfer (13)
# c1: securityModeComplete (5)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 13
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.3   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 5

## F1AP: ULRRCMessageTransfer with ueCapabilityInformation
# f1ap.procedureCode == 13 and nr-rrc.c1 == 9
# procedureCode: id-ULRRCMessageTransfer (13)
# c1: ueCapabilityInformation (9)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 13
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.4   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 9

## from GNB to AMF: UERadioCapabilityInfoIndication
# ngap.procedureCode == 44 and ngap.id == 117 and nr-rrc.voiceOverEUTRA_5GC == 0
# procedureCode: id-UERadioCapabilityInfoIndication (44)
# id: id-UERadioCapability (117)
# voiceOverEUTRA-5GC: supported (0)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 44
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UERadioCapabilityInfoIndication.protocolIEs.Item 2.ProtocolIE-Field.id = 117
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UERadioCapabilityInfoIndication.protocolIEs.Item 2.ProtocolIE-Field.value.UERadioCapability.UERadioAccessCapabilityInformation.criticalExtensions.c1.ueRadioAccessCapabilityInformation.ue-RadioAccessCapabilityInfo.UE-CapabilityRAT-ContainerList.Item 0.UE-CapabilityRAT-Container.ue-CapabilityRAT-Container.UE-NR-Capability.nonCriticalExtension.nonCriticalExtension.ims-Parameters.ims-ParametersCommon.voiceOverEUTRA-5GC = 0

## from GNB to AMF: InitialContextSetupResponse
# ngap.NGAP_PDU==1 and ngap.procedureCode == 14 and ngap.id == 10 and ngap.id == 85
# NGAP-PDU: successfulOutcome (1)
# procedureCode: id-InitialContextSetup (14)
# id: id-AMF-UE-NGAP-ID (10)
# id: id-RAN-UE-NGAP-ID (85)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 14
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.InitialContextSetupResponse.protocolIEs.Item 0.ProtocolIE-Field.id = 10
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.InitialContextSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.id = 85

###Trigger UE Voice call successfully with 5QI5 And 5QI1
## from AMF to GNB: PDUSessionResourceSetupRequest
# ngap.procedureCode == 29 and ngap.fiveQI == 5 and ngap.fiveQI == 1
# procedureCode: id-PDUSessionResourceSetup (29)
