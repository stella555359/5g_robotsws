    # id: id-gNB-CU-UE-F1AP-ID (40)
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 0.ProtocolIE-Field.id = 40
