    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.System-BearerContextModificationRequest.nG-RAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.value.PDU-Session-Resource-To-Modify-List.Item 0.PDU-Session-Resource-To-Modify-Item.dRB-To-Setup-List-NG-RAN.Item 0.DRB-To-Setup-Item-NG-RAN.qos-flow-Information-To-Be-Setup.Item 0.QoS-Flow-QoS-Parameter-Item.qoSFlowLevelQoSParameters.qoS-Characteristics.non-Dynamic-5QI.fiveQI = 1

