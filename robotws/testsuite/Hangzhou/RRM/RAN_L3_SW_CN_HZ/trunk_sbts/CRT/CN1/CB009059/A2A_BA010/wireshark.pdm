#    ...         Step B: De-activating all UE81 configured SCells and SCell released after sCellInactivityReleaseTimer timeout
# filter: nokiaf1ap.sCellInactiveReason == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.SCellStatusNotification.protocolIEs.Item 2.ProtocolIE-Field.value.SCell-Status-List.Item 0.SCell-Status-Item.sCellInactiveReason = 1

