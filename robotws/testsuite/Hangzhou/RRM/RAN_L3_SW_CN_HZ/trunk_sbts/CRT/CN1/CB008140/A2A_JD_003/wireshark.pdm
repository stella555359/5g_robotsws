[Global]
RELATION: CP1&CP2&CP3&CP4
BlOCKSIZE: -1

[CP1]
# filter: nokiaxnap.procedureCode == 20 and nokiaxnap.ResetRequestTypeInfo == 0
#gNB-2-CU-CP sends XnAP: RESET REQUEST (full reset) towards gNB-3-CU-CP
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.procedureCode = 20
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo = 0

# filter: nokiaxnap.procedureCode == 20 and nokiaxnap.ResetResponseTypeInfo == 0
#gNB-3-CU-CP replies with XnAP: RESET RESPONSE
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.procedureCode = 20
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo = 0

# filter: nokiaf1ap.procedureCode == 202
#gNB-2-CU-CP sends F1AP: IGNB CA XP REMOVAL REQUEST towards gNB-2-DU
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 202

# filter: nokiaf1ap.procedureCode == 202
#gNB-2-DU replies with F1AP: IGNB CA XP REMOVAL RESPONSE
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.procedureCode = 202

# filter: nokiaf1ap.procedureCode == 190 and nokiaf1ap.gnb_ID == 00:00:08
#gNB-2 executes Xp link setup according to CB008140-AB#B2: Successful XP setup procedure for the inter-gNB CA – BTS startup scenario
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 190
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAXpSetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.NEID.globalgNB-ID.gnb-id.gnb-ID_pre = 000008 

# filter: nokiaf1ap.procedureCode == 190 and nokiaf1ap.gnb_ID == 00:00:08
#gNB-2 executes Xp link setup according to CB008140-AB#B2: Successful XP setup procedure for the inter-gNB CA – BTS startup scenario
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.procedureCode = 190
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAXpSetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.NEID.globalgNB-ID.gnb-id.gnb-ID_pre = 000008 

# filter: nokiaxnap.procedureCode == 138 and nokiaxnap.NR-Cell-Identity == 0x0000004001 and nokiaxnap.cell_Availability == 1 and nokiaxnap.NR-Cell-Identity == 0x0000004002 and nokiaxnap.cell_Availability == 1
#gNB-2 sends XnAP: IGNB CA CONFIGURATION UPDATE INDICATION towards gNB-3
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 138
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.cell-Availability = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.nr-cell.nr-CI = 0x0000004001
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 1.CellReportItem.cell-Availability = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 1.CellReportItem.nr-cell.nr-CI = 0x0000004002

# filter: nokiaxnap.procedureCode == 139 and nokiaxnap.NR-Cell-Identity == 0x0000004001 and nokiaxnap.numberOfActiveUEs == 2 and nokiaxnap.NR-Cell-Identity == 0x0000004002 and nokiaxnap.numberOfActiveUEs == 1
#gNB-2 and gNB-3 start periodical exchange of XnAP: IGNB CA RESOURCE STATUS UPDATE messages
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 139
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 0.CellLoadResultItem.nr-cell.nr-CI = 0x0000004001
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 0.CellLoadResultItem.numberOfActiveUEs = 2
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 1.CellLoadResultItem.nr-cell.nr-CI = 0x0000004002
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 1.CellLoadResultItem.numberOfActiveUEs = 1

[CP2]
# filter: e1ap.procedureCode == 0 and e1ap.ResetType == 1
#gNB-2-CU-CP sends E1AP: RESET towards gNB-2-CU-UP with ‘partOfE1-Interface->UE-associatedLogicalE1-ConnectionListRes’
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1

# filter: e1ap.procedureCode == 0 and e1ap.id == 6
#gNB-2-CU-UP releases all resources allocated for UE contexts requested to be released and replies with E1AP: RESET ACKNOWLEDGE
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.procedureCode = 0
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.id = 6

[CP3]
# filter: nokiaf1ap.procedureCode == 0 and nokiaf1ap.ResetType == 1
#gNB-2-CU-CP sends F1AP: RESET towards gNB-2-DU with ‘partOfF1-Interface->UE-associatedLogicalF1-ConnectionListRes’
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1

# filter: nokiaf1ap.procedureCode == 0 and nokiaf1ap.id == 81
#gNB-2-DU releases all resources allocated for UE contexts and IgNB CA UE contexts requested to be released and replies with F1AP: RESET ACKNOWLEDGE
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.id = 81

[CP4]
# filter: ngap.procedureCode == 20 and ngap.ResetType == 1
#gNB-2-CU-CP sends NGAP: NG RESET towards AMF with ‘partOfNG-Interface->UE-associatedLogicalNG-ConnectionListRes’
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 20
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType = 1

# filter: ngap.procedureCode == 20 and ngap.id == 111
# AMF replies with NGAP: NG RESET ACKNOWLEDGE
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 20
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 111

