# check cell2 be added as scell
# filter: nokiaf1ap.procedureCode == 7 and nr-rrc.sCellToAddModList == 1 and nr-rrc.physCellId == 51 and nr-rrc.physCellId == 50
ethernet.ipv6.sctp.f1ap
