[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#UE1 trigger UEContextReleaseRquest because of ulbler
# filter: nokiaf1ap.procedureCode == 10 and nokiaf1ap.radioNetwork == 15
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 10
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 15

#UE1 trigger UEContextReleaseRquest with redirect
# filter: nr-rrc.criticalExtensions == 0 and nr-rrc.deprioritisationTimer == 3 and nr-rrc.redirectedCarrierInfo == 0 and nr-rrc.deprioritisationType == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.deprioritisationReq.deprioritisationTimer = 3
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.deprioritisationReq.deprioritisationType = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.redirectedCarrierInfo = 0

#UE1 ContextReleaseRquest on ngap
# filter: ngap.radioNetwork == 41 and ngap.procedureCode == 42
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 42
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.Item 3.ProtocolIE-Field.value.Cause.radioNetwork = 41

#UE1 ContextReleaseCommand on f1ap
# filter: nokiaf1ap.radioNetwork == 15 and nokiaf1ap.procedureCode == 6
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 6
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 15

