[Global]
RELATION: CP1|CP2
BlOCKSIZE: -1

[CP1]
# filter: nokiaf1ap.transport == 0 and nokiaf1ap.ResetType == 1
# when NG SCTP failure, bulk release_F1 Reset, reset type is partialreset, cause is unspecified
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1

# filter: e1ap.transport == 0 and e1ap.ResetType == 1
# when NG SCTP failure, bulk release_E1 Reset, reset type is partialreset, cause is unspecified
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1

# filter: nokiaxnap.ResetRequestTypeInfo == 1 and nokiaxnap.transport == 0
# when NG SCTP failure, bulk release_Xn Reset, reset type is partialreset, cause is transport-resource-unavailable.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0

# filter: nokiaxnap.numberOfActiveUEs == 2 and nokiaxnap.NR-Cell-Identity == 0x0000004001
# when NG SCTP failure, NRCELL-1 still have 2 active UE: UE31/UE3(as ext-gNB SCELL)
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 0.CellLoadResultItem.nr-cell.nr-CI = 0x0000004001
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 0.CellLoadResultItem.numberOfActiveUEs = 2

# filter: nokiaxnap.numberOfActiveUEs == 1 and nokiaxnap.NR-Cell-Identity == 0x000000800c and nokiaxnap.numberOfActiveUEs == 0 and nokiaxnap.NR-Cell-Identity == 0x000000800b
# when NG SCTP failure, for UE3 has no affect. UE3 is active in gNB2_PCI 61
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 0.CellLoadResultItem.numberOfActiveUEs = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 1.CellLoadResultItem.nr-cell.nr-CI = 0x000000800b
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 1.CellLoadResultItem.numberOfActiveUEs = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 2.CellLoadResultItem.nr-cell.nr-CI = 0x000000800c
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 2.CellLoadResultItem.numberOfActiveUEs = 1


