#requesting to setup a QoS flow with 5QI=1 for a normal voice call
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 1

#EPS fallback triggered
#radioNetwork: ims-voice-eps-fallback-or-rat-fallback-triggered (36)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PDUSessionResourceModifyResponse.protocolIEs.ProtocolIE-Field.value.PDUSessionResourceFailedToModifyListModRes.PDUSessionResourceFailedToModifyItemModRes.pDUSessionResourceModifyUnsuccessfulTransfer.PDUSessionResourceModifyUnsuccessfulTransfer.cause.radioNetwork = 36

#gNB1-CU-CP sends RRCRelease message to the UE including voiceFallbackIndication-r16 IE and redirectedCarrierInfo IE to indicate the release is for voice fallback and the LTE carrier.
#voiceFallbackIndication-r16: true (0)
#redirectedCarrierInfo: eutra (1)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.nonCriticalExtension.nonCriticalExtension.voiceFallbackIndication-r16 = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.redirectedCarrierInfo = 1

#NGAP UEContextRelease
#radioNetwork: redirection (41)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 41

ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 41

ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.ProtocolIE-Field.value.PDUSessionResourceListCxtRelCpl.PDUSessionResourceItemCxtRelCpl.pDUSessionID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.ProtocolIE-Field.value.PDUSessionResourceListCxtRelCpl.PDUSessionResourceItemCxtRelCpl.pDUSessionID = 2

#release resource in gNB2
ethernet.ip.sctp.xnap
