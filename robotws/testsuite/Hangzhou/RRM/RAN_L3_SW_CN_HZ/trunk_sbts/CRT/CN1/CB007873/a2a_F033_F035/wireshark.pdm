ethernet.ip.sctp
    ethernet.ip.sctp.x2ap.value = UEContextRelease

#382 handover back to 61+52
ethernet.ip.sctp
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequest
    ethernet.ip.sctp.x2ap.id-MeNBtoSgNBContainer.ProtocolIE-Field.value.MeNBtoSgNBContainer.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.candidateCellInfoListSN.MeasResultList2NR.Item 0.MeasResult2NR.measResultServingCell.physCellId = 382
