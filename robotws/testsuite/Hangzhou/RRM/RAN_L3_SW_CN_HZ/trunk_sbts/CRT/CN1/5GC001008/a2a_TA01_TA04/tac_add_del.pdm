ethernet.ipv6.sctp.f1ap
    # GNBDUConfigurationUpdate - TAC support slice1/slice4
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Served-Cells-To-Modify-List.ProtocolIE-SingleContainer.value.Served-Cells-To-Modify-Item.served-Cell-Information.servedPLMNs.ServedPLMNs-Item.iE-Extensions.ProtocolExtensionField.extensionValue.SliceSupportList = 2 items
