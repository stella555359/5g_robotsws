ethernet.ip.sctp.ngap
    # RANConfigurationUpdate - TAC support slice1 and slice4
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.RANConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.SupportedTAList.SupportedTAItem.broadcastPLMNList.BroadcastPLMNItem.tAISliceSupportList = 2 items
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.RANConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.SupportedTAList.SupportedTAItem.broadcastPLMNList.BroadcastPLMNItem.tAISliceSupportList.Item 0.SliceSupportItem.s-NSSAI.sD = d143a5
