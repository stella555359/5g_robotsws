[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nr-rrc.c1 == 1 and nr-rrc.csi_MeasConfig == 1 and nr-rrc.nzp_CSI_RS_ResourceId == 0 and nr-rrc.periodicityAndOffset == 11
# In MSG "UE RRC Setup" check UE1 Pcell use slot320(periodicityAndOffset == 11): spCellConfigDedicated --- csi-MeasConfig--- NZP-CSI-RS-Resource Id0 --- periodicityAndOffset = 11
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1 = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup.criticalExtensions.rrcSetup.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.csi-MeasConfig = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.NR Radio Resource Control (RRC) protocol.DL-CCCH-Message.message.c1.rrcSetup.criticalExtensions.rrcSetup.masterCellGroup.CellGroupConfig.spCellConfig.spCellConfigDedicated.csi-MeasConfig.setup.nzp-CSI-RS-ResourceToAddModList.Item 0.NZP-CSI-RS-Resource.nzp-CSI-RS-ResourceId = 0
