[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
ethernet.ip.sctp
    # AMFConfigurationUpdate - update AMF delete SNSSAI-1; only support SNSSAI-2
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList = 1 item
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList.SliceSupportItem.s-NSSAI.sD = d143a6

ethernet.ip.sctp.ngap
    # Since AMF no longer supports SNSSAI-1, UE1's PDU is released
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PDUSessionResourceReleaseResponse = *

ethernet.ip.sctp
    # AMFConfigurationUpdate - update AMF delete SNSSAI-2; only support SNSSAI-3
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList = 1 item
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList.SliceSupportItem.s-NSSAI.sD = d143a7

ethernet.ipv6.sctp.f1ap
    # GNBCUConfigurationUpdate - CELL1/CELL2 cellBarred=0: barred
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.cellBarred = 0

ethernet.ip.sctp
    # AMFConfigurationUpdate - update AMF support SNSSAI-1/SNSSAI-2/SNSSAI-3/SNSSAI-4
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList = 4 items
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList.Item 0.SliceSupportItem.s-NSSAI.sD = d143a5
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList.Item 1.SliceSupportItem.s-NSSAI.sD = d143a6
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList.Item 2.SliceSupportItem.s-NSSAI.sD = d143a7
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList.Item 3.SliceSupportItem.s-NSSAI.sD = d143a8

ethernet.ipv6.sctp.f1ap
    # GNBCUConfigurationUpdate - CELL1/CELL2 cellBarred=1: not barred
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.cellBarred = 1

ethernet.ipv6.sctp.f1ap
    # GNBDUConfigurationUpdate - CELL1/CELL2 cellBarred=1: not barred
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Served-Cells-To-Modify-List.ProtocolIE-SingleContainer.value.Served-Cells-To-Modify-Item.served-Cell-Information.servedPLMNs.ServedPLMNs-Item.iE-Extensions.ProtocolExtensionField.extensionValue.SliceSupportList.Item 0.SliceSupportItem.sNSSAI.sD = d143a5
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Served-Cells-To-Modify-List.ProtocolIE-SingleContainer.value.Served-Cells-To-Modify-Item.served-Cell-Information.servedPLMNs.ServedPLMNs-Item.iE-Extensions.ProtocolExtensionField.extensionValue.SliceSupportList.Item 1.SliceSupportItem.sNSSAI.sD = d143a6
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Served-Cells-To-Modify-List.ProtocolIE-SingleContainer.value.Served-Cells-To-Modify-Item.gNB-DU-System-Information.mIB-message.MIB.cellBarred = 1
