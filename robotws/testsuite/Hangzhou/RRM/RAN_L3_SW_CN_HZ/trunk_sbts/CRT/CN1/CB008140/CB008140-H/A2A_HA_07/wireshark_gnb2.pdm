[Global]

RELATION: CP1

BlOCKSIZE: -1



[CP1]
#UE3:gNB-2-DU replies to gNB-2-CU with an F1AP: IGNB CA UE CONTEXT SETUP RESPONSE message with Cell2_4 in the SCell-FailedtoSetupMod-List with corresponding failure cause-“Incompatible configuration".
#filter: nokiaf1ap.procedureCode == 192 and nokiaf1ap.Nokia_F1AP_PDU == 1 and nokiaf1ap.privateCause == 9
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.procedureCode = 192
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextSetupResponse.protocolIEs.Item 6.ProtocolIE-Field.value.IgNB-CA-SCell-Failed-to-Setup-List.Item 0.IgNB-CA-SCell-Failed-to-Setup-Item.igNB-CA-Cause.privateCause = 9

#UE3:gNB-2-CU replies to gNB-1-CU by sending the XnAP: IGNB-CA UE ADDITION REQUEST ACKNOWLEDGE message, carrying Cell2_4 in ‘IgNB-CA SCell Failed to Setup List’ with cause “Incompatible configuration"”.
#filter: nokiaxnap.Nokia_XnAP_PDU == 1 and nokiaxnap.procedureCode == 140 and nokiaxnap.privateCause == 7
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.procedureCode = 140
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.Item 6.ProtocolIE-Field.value.IgNB-CA-SCell-Failed-to-Setup-List.Item 0.IgNB-CA-SCell-Failed-to-Setup-Item.igNBCACause.privateCause = 7

