
[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#check nitiatingNodeType-EndcX2Setup
ethernet.ip.sctp.x2ap	
    ethernet.ip.sctp.x2ap.id-InitiatingNodeType-EndcX2Setup.ProtocolIE-Field.value.InitiatingNodeType-EndcX2Setup.init-en-gNB = 1 item
	
#check ENDCX2SetupFailure	
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = ENDCX2SetupFailure
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.misc = 4
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause = 3
	
