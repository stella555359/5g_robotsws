[Global]
RELATION: CP1&CP2&CP3&CP4
BlOCKSIZE: -1

[CP1]
#2PDU sessions setup 1st PDU session with 5QI-5 with priorityLevelARP equal to 1 and 2nd PDU session with 5QI-5 and add 5QI-1 with priorityLevelARP equal to 15
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionID = 4
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 5
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.allocationAndRetentionPriority.priorityLevelARP = 1

[CP2]
ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionID = 5
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 5
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.allocationAndRetentionPriority.priorityLevelARP = 15
[CP3]
#2PDU sessions in handover req
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.pduSessionResourcesToBeSetup-List.Item 1.PDUSessionResourcesToBeSetup-Item.qosFlowsToBeSetup-List.Item 1.QoSFlowsToBeSetup-Item.qosFlowLevelQoSParameters.qos-characteristics.non-dynamic.fiveQI = 1
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.pduSessionResourcesToBeSetup-List.Item 1.PDUSessionResourcesToBeSetup-Item.qosFlowsToBeSetup-List.Item 0.QoSFlowsToBeSetup-Item.qosFlowLevelQoSParameters.qos-characteristics.non-dynamic.fiveQI = 5
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.pduSessionResourcesToBeSetup-List.Item 0.PDUSessionResourcesToBeSetup-Item.qosFlowsToBeSetup-List.Item 0.QoSFlowsToBeSetup-Item.qosFlowLevelQoSParameters.qos-characteristics.non-dynamic.fiveQI = 5
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.pduSessionResourcesToBeSetup-List.Item 1.PDUSessionResourcesToBeSetup-Item.pduSessionId = 5
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.pduSessionResourcesToBeSetup-List.Item 0.PDUSessionResourcesToBeSetup-Item.pduSessionId = 4
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.pduSessionResourcesToBeSetup-List.Item 0.PDUSessionResourcesToBeSetup-Item.qosFlowsToBeSetup-List.Item 0.QoSFlowsToBeSetup-Item.qfi = 1
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.pduSessionResourcesToBeSetup-List.Item 1.PDUSessionResourcesToBeSetup-Item.qosFlowsToBeSetup-List.Item 0.QoSFlowsToBeSetup-Item.qfi = 1
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 4.ProtocolIE-Field.value.UEContextInfoHORequest.pduSessionResourcesToBeSetup-List.Item 1.PDUSessionResourcesToBeSetup-Item.qosFlowsToBeSetup-List.Item 1.QoSFlowsToBeSetup-Item.qfi = 2

[CP4]
#only PDU sessions 1 admit in taget cell
ethernet.ip.sctp.xnap
	ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourcesNotAdmitted-List.Item 0.PDUSessionResourcesNotAdmitted-Item.pduSessionId = 5
	ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourcesAdmitted-List.Item 0.PDUSessionResourcesAdmitted-Item.pduSessionId = 4
	ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourcesAdmitted-List.Item 0.PDUSessionResourcesAdmitted-Item.pduSessionResourceAdmittedInfo.qosFlowsAdmitted-List.Item 0.QoSFlowsAdmitted-Item.qfi = 1
	