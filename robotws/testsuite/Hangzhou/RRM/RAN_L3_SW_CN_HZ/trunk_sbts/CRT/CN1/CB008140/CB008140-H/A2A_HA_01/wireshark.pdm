[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# gNB-1-DU fails the SCell addition and replies to gNB-1-CU with the F1AP:GNB CA U CONTEXT SETUP FAILURE
# filter: f1ap.procedureCode == 192 and f1ap.privateCause == 9
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.unsuccessfulPrivateOutcome.value.IgNBCAUeContextSetupFailure.protocolIEs.Item 1.ProtocolIE-Field.value.IgNB-CA-Cause.privateCause = 9
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.unsuccessfulPrivateOutcome.procedureCode = 192

#gNB-1-CU replies to gNB-2-CU by sending the XnAP: IGNB-CA UE ADDITION REQUEST REJECT
# filter: xnap.Nokia_XnAP_PDU == 2 and xnap.privateCause == 7
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU = 2
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.unsuccessfulPrivateOutcome.value.IgNBCAAdditionRequestReject.protocolIEs.Item 2.ProtocolIE-Field.value.IgNBCACause.privateCause = 7

#RRC setup complete
# filter: nr-rrc.criticalExtensions == 0 and nr-rrc.c1 == 2 and nr-rrc.selectedPLMN_Identity == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcSetupComplete.criticalExtensions = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcSetupComplete.criticalExtensions.rrcSetupComplete.selectedPLMN-Identity = 1

#RRC ReconfiguraionRequest
# filter: nr-rrc.eventId == 0 and nr-rrc.measId == 1 and nr-rrc.c1 == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1 = 0

#trigger A1MR
# filter: nr-rrc.measId == 1 and nr-rrc.physCellId == 50
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.physCellId = 50
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measId = 1

#IgNBCAAdditionRequestAcknowledge, one scell addition successful, and one scell addition failed by incompatible-configuration
# filter: xnap.privateCause == 7 and xnap.SCell_For_IgNB_CA_Establishment_Setup_List == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAAdditionRequestAcknowledge.protocolIEs.Item 6.ProtocolIE-Field.value.IgNB-CA-SCell-Failed-to-Setup-List.Item 0.IgNB-CA-SCell-Failed-to-Setup-Item.igNBCACause.privateCause = 7
