ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.Item 0.MeasId = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellIndex = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 60

#RRC setup complete
# filter: nr-rrc.criticalExtensions == 0 and nr-rrc.c1 == 2 and nr-rrc.selectedPLMN_Identity == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcSetupComplete.criticalExtensions = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcSetupComplete.criticalExtensions.rrcSetupComplete.selectedPLMN-Identity = 1

#RRC ReconfiguraionRequest
# filter: nr-rrc.eventId == 0 and nr-rrc.measId == 1 and nr-rrc.c1 == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.5   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1 = 0

#trigger A1MR
# filter: nr-rrc.measId == 1 and nr-rrc.physCellId == 51
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.8   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.physCellId = 51
