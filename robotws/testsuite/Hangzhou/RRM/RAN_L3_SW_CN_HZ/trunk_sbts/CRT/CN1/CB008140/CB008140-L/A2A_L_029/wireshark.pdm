[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nokiaxnap.CellToReportList == 2 and nokiaxnap.NR-Cell-Identity == 0x000000800b and nokiaxnap.NR-Cell-Identity == 0x0000008003
# after online modify to set sCellAdditionMethod for scell cell2-3 and cell2-11, GNB1 send to GNB2 with 'IgNBCASetupRequest' :CellToReportList contain two scells
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList = 2 items
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList.Item 0.NrCells-Item.nr-cell.nr-CI = 0x0000008003
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList.Item 1.NrCells-Item.nr-cell.nr-CI = 0x000000800b

# filter: nokiaxnap.ReportedCellList == 1 and nokiaxnap.NR-Cell-Identity == 0x0000008003
# after online modify to lock cell2-11, GNB2 send to GNB1 with 'IgNBCAConfigurationUpdateIndication':ReportedCellList just contain one scell cell2-3.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.nr-cell.nr-CI = 0x0000008003

# filter: nokiaxnap.cellsToAdd == 1 and nokiaxnap.NR-Cell-Identity == 0x000000800c
