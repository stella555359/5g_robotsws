# filter: nokiaxnap.ReportedCellList == 1 and nokiaxnap.NR-Cell-Identity == 0x000000800b
# after online modify to unlock cell2-11, GNB2 send to GNB1 with 'IgNBCAConfigurationUpdateIndication':ReportedCellList cell2-11.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.nr-cell.nr-CI = 0x000000800b

