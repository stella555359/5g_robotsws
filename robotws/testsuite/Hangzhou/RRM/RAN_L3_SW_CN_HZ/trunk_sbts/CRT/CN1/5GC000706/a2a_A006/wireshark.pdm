[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
# Check PDU session from context setup request
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionID = 1

# Check independentGapConfig from UEContextSetupRequest
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.CUtoDURRCInformation.uE-CapabilityRAT-ContainerList.UE-CapabilityRAT-ContainerList.Item 0.UE-CapabilityRAT-Container.ue-CapabilityRAT-Container.UE-NR-Capability.measAndMobParameters.measAndMobParametersCommon.independentGapConfig = 0



