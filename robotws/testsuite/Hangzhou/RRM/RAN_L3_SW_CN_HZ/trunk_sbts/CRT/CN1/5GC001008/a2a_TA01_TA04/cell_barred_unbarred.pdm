[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#update AMF slice from SLICE1/SLICE2/SLICE3/SLICE4 to SLICE2(TAC not support)
ethernet.ip.sctp.ngap
    # AMFConfigurationUpdate - AMFConfigurationUpdate
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList = 1 item
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList.SliceSupportItem.s-NSSAI.sD = d143a6

ethernet.ipv6.sctp.f1ap
    # GNBCUConfigurationUpdate - CELL1/CELL2 cellBarred=0: barred
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.Item 0.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.nRCGI.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 0100  0000 0000  0001 .... decimal value 16385
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.Item 0.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.cellBarred = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.Item 1.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.nRCGI.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 0100  0000 0000  0010 .... decimal value 16386
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.Item 1.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.cellBarred = 0

ethernet.ip.sctp.ngap
    # AMFConfigurationUpdate - update AMF slice from SLICE2 to SLICE1/SLICE2(TAC support SLICE1)
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList = 2 items
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList.Item 0.SliceSupportItem.s-NSSAI.sD = d143a5
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.AMFConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.PLMNSupportList.PLMNSupportItem.sliceSupportList.Item 1.SliceSupportItem.s-NSSAI.sD = d143a6

ethernet.ipv6.sctp.f1ap
    # GNBCUConfigurationUpdate - CELL1 cellBarred=1: not barred
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.nRCGI.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 0100  0000 0000  0001 .... decimal value 16385
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.cellBarred = 1

ethernet.ipv6.sctp.f1ap
    # GNBCUConfigurationUpdate - CELL2 cellBarred=1: not barred
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.nRCGI.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 0100  0000 0000  0010 .... decimal value 16386
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.cellBarred = 1