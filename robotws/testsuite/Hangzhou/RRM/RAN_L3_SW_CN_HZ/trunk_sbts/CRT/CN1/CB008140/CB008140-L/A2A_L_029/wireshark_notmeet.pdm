[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# after online modify for cell1-1 to add another nrrel cell4-6, GNB1 will not send 'IgNBCASetupRequest' when GNB1 'actInterGnbCa=disabled'
# filter:(nokiaxnap.CellToReportList == 1) && (nokiaxnap.NR-Cell-Identity == 0x000008c006)
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList.NrCells-Item.nr-cell.nr-CI = 0x000008c006
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList = 1 item

