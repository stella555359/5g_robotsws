[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nokiaxnap.procedureCode == 138 and nokiaxnap.Inter_gNB_CA_Allowed == 0
# Online modify for ext GNB2 to set actInterGnbCa=disabled, GNB2 send to GNB1 'IgNBCAConfigurationUpdateIndication' with Inter-gNB-CA-Allowed: not-allowed (0)
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 138
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.Inter-gNB-CA-Allowed = 0

# filter: nokiaxnap.drb_ID == 5 and nokiaxnap.fiveQI == 7 and nokiaxnap.flows_Mapped_To_IgNB_CA_DRB_List == 1
# Modify PDU1 add QosFlow 3 with 5qi7
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.IgNB-CA-DRB-ToBeAdded-List.Item 0.IgNB-CA-DRB-ToBeAdded-Item.dRBQoSInformation.dRB-QoS.qos-characteristics.non-dynamic.fiveQI = 7
	ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.IgNB-CA-DRB-ToBeAdded-List.Item 0.IgNB-CA-DRB-ToBeAdded-Item.drb-ID = 5
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.IgNB-CA-DRB-ToBeAdded-List.Item 0.IgNB-CA-DRB-ToBeAdded-Item.dRBQoSInformation.flows-Mapped-To-IgNB-CA-DRB-List = 1 item

# filter: nokiaxnap.IgNB_CA_DRB_ToBeAdded_List == 1 and nokiaxnap.fiveQI == 6
