ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.IgNB-CA-DRB-ToBeAdded-List = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.IgNB-CA-DRB-ToBeAdded-List.Item 0.IgNB-CA-DRB-ToBeAdded-Item.dRBQoSInformation.dRB-QoS.qos-characteristics.non-dynamic.fiveQI = 7
