[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#${add_sCellAdditionMethod_under_NRREL_11} procedureCode: id-igNBCAConfigurationUpdate (138)
# filter: nokiaxnap.NR-Cell-Identity == 0x000000800b
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToAdd.Item 0.NR-CGI.nr-CI = 0x000000800b

#extgnb reply procedureCode: id-igNBCAConfigurationUpdate (138)
# filter: nokiaxnap.NR-Cell-Identity == 0x000000800b
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.nr-cell.nr-CI = 0x000000800b

#${add_NRREL_45_46_under_NRCELL_1}  procedureCode: id-igNBCASetup (137)
# filter: nokiaxnap.NR-Cell-Identity == 0x000008c005 and nokiaxnap.NR-Cell-Identity == 0x000008c006
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList.Item 0.NrCells-Item.nr-cell.nr-CI = 0x000008c005
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList.Item 1.NrCells-Item.nr-cell.nr-CI = 0x000008c006

# ${update_NRREL_45_to_gnb2_nrcell12} procedureCode: id-igNBCAConfigurationUpdate (138) send to simgnb
# filter: nokiaxnap.NR-Cell-Identity == 0x000008c005 and nokiaxnap.cellsToRemove == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToRemove = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToRemove.Item 0.NR-CGI.nr-CI = 0x000008c005

#send to gnb2
# filter: nokiaxnap.NR-Cell-Identity == 0x000000800c and nokiaxnap.cellsToAdd == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToAdd = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToAdd.Item 0.NR-CGI.nr-CI = 0x000000800c

#igNBCAConfigurationUpdate from gnb2
# filter: nokiaxnap.NR-Cell-Identity == 0x000000800c
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.nr-cell.nr-CI = 0x000000800c

#${add_NRREL_4_under_NRCELL_1}
# filter: nokiaxnap.NR-Cell-Identity == 0x0000008004
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToAdd.Item 0.NR-CGI.nr-CI = 0x0000008004

#${add_NRREL_47_under_NRCELL_1}
# filter: nokiaxnap.NR-Cell-Identity == 0x000008c007
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToAdd.Item 0.NR-CGI.nr-CI = 0x000008c007

#${add_NRREL_48_under_NRCELL_1_for_simgnb_cell5}
#${delete_NRREL_45_to_gnb2_nrcell12_and_NRREL_48_under_NRCELL_1_for_simgnb_cell5}
