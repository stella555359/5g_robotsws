[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#Trigger F1 setup
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.F1SetupRequest = *

ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGSetupRequest = *

ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse = *

#CELL2 is barred
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.nRCGI.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 0100  0000 0000  0010 .... decimal value 16386
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Barred-List.ProtocolIE-SingleContainer.value.Cells-to-be-Barred-Item.cellBarred = 0

#Trigger NG SCTP link broken then recovery
# SCTP ABORT
ethernet.ip.sctp.abort
    ethernet.ip.sctp.abort.chunk_type = 6

# SCTP Recovery
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGSetupRequest = *

ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGSetupResponse = *