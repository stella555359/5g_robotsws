[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# 1) UE attaches to the FDD Cell12 with high DL non-GBR data rate and configures the SCell_cell3 to the UE
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# DL buffer monitoring activation checks pass
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

# 2) Data transfer is on the PCell only,due to sCellDeactivationTimerGNB is infinit,so after data transfer
#    is on the PCell only for sCellInactivityReleaseTimer expires,the gNB-DU sends a private unacknowledged
#    F1AP message to the gNB-CU for SCell release
# filter: itf_l2_ps_user_sCellListElement.inactiveReason == 0
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.psuser.itf_l2_ps_user_scellreleaseconditionmetind.itf_l2_ps_user_SCellReleaseConditionMetInd_t.sCellList (DynamicVariableSizedArray).sCellList_item_0 (itf_l2_ps_user_sCellListElement).inactiveReason (itf_l2_ps_user_InactiveReason) = 0
	
# filter: nokiaf1ap.sCellInactiveReason == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.SCellStatusNotification.protocolIEs.Item 2.ProtocolIE-Field.value.SCell-Status-List.Item 0.SCell-Status-Item.sCellInactiveReason = 0

# then activates DL buffer monitoring for SCell Addition
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# DL buffer monitoring activation checks pass
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

