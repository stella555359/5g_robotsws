[Global]
RELATION: CP1|CP2
BLOCKSIZE: -1


[CP1]
#lock cell with f1ap.id == 60
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Served-Cells-To-Delete-List.Item 0 = id-Served-Cells-To-Delete-Item
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.id = 60

#UE context reset with f1ap.procedureCode == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0

#UE context reset with e1ap.misc == 3
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 3

#NGReset with ngap.radioNetwork == 3
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause.radioNetwork = 3

#unlock cell with f1ap.id == 57
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Served-Cells-To-Add-List.Item 0.ProtocolIE-SingleContainer.id = 57

#NG setup with ngap.id == 102
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGSetupRequest.protocolIEs.Item 1.ProtocolIE-Field.id = 102

#Cells-to-be-Activated with f1ap.id == 4
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Cells-to-be-Activated-List.Item 0.ProtocolIE-SingleContainer.id = 4

#cell-to-modify with f1ap.id == 62
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.id = 62

