[Global]
RELATION: CP1
BlOCKSIZE: -1

# Inter RAT HO:
#   F1AP/NR RRC  Measurement Report  
#   --NGAP         HandoverRequired    
#   --NGAP         HandoverCommand
#   F1AP/NR RRC  SACK Mobility From NR Command/RRCConnectionReconfiguration 
#   --NGAP         UEContextReleaseCommand
#   --F1AP         UEContextReleaseCommand
#   --F1AP         SACK UEContextReleaseComplete
#   --NGAP         UEContextReleaseComplete

[CP1]
# HandoverRequired  ng-inter-system-handover-triggered(32)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.HandoverRequired.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 17
	
# HandoverCommand  fivegs-to-eps(1)
ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.HandoverCommand.protocolIEs.ProtocolIE-Field.value.HandoverType = 1

# UEContextReleaseCommand  successful-handover(2)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 2

# UEContextReleaseCommand  normal-release(10) 
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 10

# UEContextReleaseComplete
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs = *

# UEContextReleaseComplete
ethernet.ip.sctp.ngap
	ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs = *
