# filter: nokiaxnap.procedureCode == 22 and nokiaxnap.TransportLayerAddressIPv6 == fc00::172:18:6:22 and nokiaxnap.NR-Cell-Identity == 0x0000008003 and nokiaxnap.NR-Cell-Identity == 0x0000008004 and nokiaxnap.NR-Cell-Identity == 0x000000800c
