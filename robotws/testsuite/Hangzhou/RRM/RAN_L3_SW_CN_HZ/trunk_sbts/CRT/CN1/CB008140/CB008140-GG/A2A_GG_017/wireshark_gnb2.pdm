# filter: nokiaxnap.procedureCode == 22 and nokiaxnap.NR-Cell-Identity == 0x0000008003 and nokiaxnap.NR-Cell-Identity == 0x0000008004 and nokiaxnap.NR-Cell-Identity == 0x000000800c and nokiaxnap.TransportLayerAddressIPv4 == 10.0.1.22
