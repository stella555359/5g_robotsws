    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.IgNB-CA-DRB-ToBeAdded-List.Item 0.IgNB-CA-DRB-ToBeAdded-Item.ext-SCell-Associated-Information.Item 2.Ext-SCell-Associated-Information-UL-Item.sCellID.nr-CI = 0x000000800c

