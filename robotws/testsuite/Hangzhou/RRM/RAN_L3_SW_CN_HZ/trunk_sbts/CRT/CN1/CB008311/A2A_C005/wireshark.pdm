[Global]
RELATION: CP1 | CP2 | CP3 | CP4
BlOCKSIZE: -1

[CP1]
#scell 1 release first.
#reportOnLeave is configured in the A1 measurement for SCell addition
# filter: nr-rrc.measTriggerQuantity.rsrp == 75 and nr-rrc.reportOnLeave == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA1.a1-Threshold.rsrp = 75
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA1.reportOnLeave = True

# BufferMonitoringNotification, check CB008311 enable and start Buffer Monitoring
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# BufferCriterionNotification, check DU sends private unacknowledged F1AP message to inform CU DL buffer
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

