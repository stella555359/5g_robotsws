[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: itf_l2_ps_UlCgType2ActivationControl_t.nonGbrCgType2Activation_item == 0 and itf_l2_ps_UlCgType2ActivationControl_t.gbrCgType2Activation_item == 1
# initGBRresource,gbrCgType2Action suspend.
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolresp.itf_l2_ps_cell_UlCGType2ActivationControlResp_t.ulCgType2ActivationControl (StaticVariableSizedArray).ulCgType2ActivationControl_item_0 (itf_l2_ps_UlCgType2ActivationControl_t).gbrCgType2Activation (StaticVariableSizedArray).Length (Uint32) = 1
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolresp.itf_l2_ps_cell_UlCGType2ActivationControlResp_t.ulCgType2ActivationControl (StaticVariableSizedArray).ulCgType2ActivationControl_item_0 (itf_l2_ps_UlCgType2ActivationControl_t).gbrCgType2Activation (StaticVariableSizedArray).gbrCgType2Activation_item_0 (itf_l2_ps_RequestProcess) = 1
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolresp.itf_l2_ps_cell_UlCGType2ActivationControlResp_t.ulCgType2ActivationControl (StaticVariableSizedArray).ulCgType2ActivationControl_item_0 (itf_l2_ps_UlCgType2ActivationControl_t).nonGbrCgType2Activation (StaticVariableSizedArray).nonGbrCgType2Activation_item_0 (itf_l2_ps_RequestProcess) = 0

# filter: itf_l2_ps_UlCgType2ActivationControl_t.nonGbrCgType2Activation_item == 0 and itf_l2_ps_UlCgType2ActivationControl_t.gbrCgType2Activation_item == 1
# UE3 attach to cell-1 with 5QI-80 as default DRB1, then add GBR DRB2 with 5QI-72,gbrCgType2Action suspend.
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolresp.itf_l2_ps_cell_UlCGType2ActivationControlResp_t.ulCgType2ActivationControl (StaticVariableSizedArray).ulCgType2ActivationControl_item_0 (itf_l2_ps_UlCgType2ActivationControl_t).gbrCgType2Activation (StaticVariableSizedArray).Length (Uint32) = 1
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolresp.itf_l2_ps_cell_UlCGType2ActivationControlResp_t.ulCgType2ActivationControl (StaticVariableSizedArray).ulCgType2ActivationControl_item_0 (itf_l2_ps_UlCgType2ActivationControl_t).gbrCgType2Activation (StaticVariableSizedArray).gbrCgType2Activation_item_0 (itf_l2_ps_RequestProcess) = 1
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulcgtype2activationcontrolresp.itf_l2_ps_cell_UlCGType2ActivationControlResp_t.ulCgType2ActivationControl (StaticVariableSizedArray).ulCgType2ActivationControl_item_0 (itf_l2_ps_UlCgType2ActivationControl_t).nonGbrCgType2Activation (StaticVariableSizedArray).nonGbrCgType2Activation_item_0 (itf_l2_ps_RequestProcess) = 0

# filter: nokiaf1ap.procedureCode == 6 and nokiaf1ap.radioNetwork == 16
# UE release due to pre emption
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 6
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 16

# filter: itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp_item == 0 and itf_l2_ps_cell_UlNonGbrLoadInd_t.avgUlCgType2NgbrBitrate == 0 and itf_l2_ps_cell_UlNonGbrLoadInd_t.nrCellIdentity == 16385
# Check the ‘avgUlCgType2NgbrBitrate’ and ‘ngbrCgType2PrbLoadPerBwp’ turn to 0 before UE4
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.avgUlCgType2NgbrBitrate (Uint64) = 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp (DynamicVariableSizedArray).ngbrCgType2PrbLoadPerBwp_item_0 (Uint8) = 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp (DynamicVariableSizedArray).ngbrCgType2PrbLoadPerBwp_item_1 (Uint8) = 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.nrCellIdentity (Uint64) = 16385

# filter: itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp_item > 0 and itf_l2_ps_cell_UlNonGbrLoadInd_t.avgUlCgType2NgbrBitrate > 0 and itf_l2_ps_cell_UlNonGbrLoadInd_t.nrCellIdentity == 16385
# Check the ‘avgUlCgType2NgbrBitrate’ and ‘ngbrCgType2PrbLoadPerBwp’ turn to non 0 after UE4
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.avgUlCgType2NgbrBitrate (Uint64) =<> 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp (DynamicVariableSizedArray).ngbrCgType2PrbLoadPerBwp_item_0 (Uint8) =<> 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.ngbrCgType2PrbLoadPerBwp (DynamicVariableSizedArray).ngbrCgType2PrbLoadPerBwp_item_1 (Uint8) = 0
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_ulnongbrloadind.itf_l2_ps_cell_UlNonGbrLoadInd_t.nrCellIdentity (Uint64) = 16385