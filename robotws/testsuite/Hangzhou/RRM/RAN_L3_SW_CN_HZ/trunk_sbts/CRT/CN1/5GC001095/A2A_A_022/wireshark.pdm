[Global]
RELATION: CP1&CP2
BlOCKSIZE: -1

[CP1]#ENDC with SRB3
ethernet.ip
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
    ethernet.ip.sctp.x2ap.x2ap_pdu = 1
    ethernet.ip.sctp.x2ap.value = SgNBAdditionRequestAcknowledge
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-RB-Config.RadioBearerConfig.srb-ToAddModList.Item 0.SRB-ToAddMod.srb-Identity = 3
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.rlc-BearerToAddModList.Item 1.RLC-BearerConfig.servedRadioBearer.srb-Identity = 3
	
[CP2]#F1AP setup srb3
ethernet.ipv6.sctp.f1ap   
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.messageClassExtension.c2.sidelinkUEInformationNR-r16.criticalExtensions.sidelinkUEInformationNR-r16 = None
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).Configuration.Direction = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 2.ProtocolIE-Field.value.SRBID = 3
	
[CP3]#SgNBChangeRequired with SRB3
	ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
    ethernet.ip.sctp.x2ap.x2ap_pdu = 0
    ethernet.ip.sctp.x2ap.value = SgNBChangeRequired
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-RB-Config.RadioBearerConfig.srb-ToAddModList.Item 0.SRB-ToAddMod.srb-Identity = 3
	ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.rlc-BearerToAddModList.Item 1.RLC-BearerConfig.servedRadioBearer.srb-Identity = 3