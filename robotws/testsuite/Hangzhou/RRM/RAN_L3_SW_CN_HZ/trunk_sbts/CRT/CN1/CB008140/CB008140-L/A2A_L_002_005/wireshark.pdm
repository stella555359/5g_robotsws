[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#first IgNBCAConfigurationUpdateIndication from prignb1
# filter: nokiaxnap.id == 24687 and nokiaxnap.id == 24717
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 2.ProtocolIE-Field.id = 24687
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 3.ProtocolIE-Field.id = 24717

#prignb1 still send IgNBCAConfigurationUpdateIndication when xp is nok: add nrrel lcrid=6
# filter: nokiaxnap.NR-Cell-Identity == 0x000008c006
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToAdd.Item 0.NR-CGI.nr-CI = 0x000008c006

#prignb1 flag disable, send IgNBCAConfigurationUpdateIndication
# filter: nokiaxnap.Inter_gNB_CA_Allowed == 0
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.Inter-gNB-CA-Allowed = 0

#prignb1 add nrrel lcrid=7, send IgNBCAConfigurationUpdateIndication
# filter: nokiaxnap.NR-Cell-Identity == 0x000008c007
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToAdd.Item 0.NR-CGI.nr-CI = 0x000008c007

#prignb1 flag enable, send IgNBCAConfigurationUpdateIndication
# filter: nokiaxnap.Inter_gNB_CA_Allowed == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.Inter-gNB-CA-Allowed = 1

