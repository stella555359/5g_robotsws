UE Attach And Send Throughput
    Ue Register And PDU Session Setup    ${SA_Capa_GB005}    ${expectpcell_GB005_Cell2}     2    2    2    2
    Send Throuput    2
    Wait Until Keyword Succeeds    30s    5s    Verify Throuput on Pscell    2

Trigger A1MR For Scell Addition And Check Throughput	
    Trigger A1MR    ${expectca_GB005_Scell_Cell4_Cell12}    657984    100    100    2
    Wait Until Keyword Succeeds    30s    5s    Verify Throuput 3CC on Pscell and Scell    2

Trigger A1MR
    [Arguments]    ${expectca}    ${carrierfreq}=663360    ${srsrp_nr}=100    ${srsrq_nr}=50    ${ue_id}=1
    ${meas_id}    get nr meas id for specific type and frequency    ${ue_id}    event_type=A1    carrierfreq=${carrierfreq}
    ${cmd}    Catenate    ue_measurement_send_nr id=${ue_id} meas_id=${meas_id} event=A1 srsrp_nr=${srsrp_nr} srsrq_nr=${srsrq_nr}
    Execute Egate Command    ${cmd}    pass_regexp=${expectca}

Update UE capa
    [Arguments]    ${ue_id}    ${SA_Capa}    
    ${cmd}    catenate    ue_param id=${ue_id} ue_nr_capabilities=${SA_Capa}
    Execute Egate Command    ${cmd}
	
Ue Register And PDU Session Setup
    [Arguments]    ${SA_Capa}    ${expectpcell}    ${ue_id}=1    ${gateway}=1    ${enb_id}=2    ${cell_id}=1
    Update UE capa    ${ue_id}    ${SA_Capa}
    Execute Egate Command    ue_change_location id=${ue_id} enb=${enb_id} cell=${cell_id}
    Execute Egate Command    ue_register id=${ue_id}    pass_regexp=NG RM Registered
    Execute Egate Command    set_pdu_param ue=${ue_id} pdu=1 trf_type=internal
    Execute Egate Command    ue_pdu_session_setup ue=${ue_id} pdu=1 nwslice=1 gw=${gateway}    pass_regexp=${expectpcell} 

Send Throuput
    [Arguments]    ${ue_id}=1    
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=150 trf_id=2    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=150 trf_id=3    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=150 trf_id=4    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=150 trf_id=5    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=150 trf_id=6    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl mbps=150 trf_id=7    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=ul mbps=10 trf_id=1    UE ${ue_id}: UDP UL
	
Verify Throuput 3CC on Pscell and Scell
    [Arguments]    ${ue_id}=1    ${total_dl_tput}=750    ${ul_tput}=9
    Verify 3CC DL throughput    ${ue_id}    ${total_dl_tput}
    ${ul_throughput}    Ap Get Throuput On Specific Scell    ue_id=${ue_id}    scell_id=0    type=pusch    rate_type=ave
    Should Be True    ${ul_throughput}/1000>${ul_tput}

Verify 3CC DL throughput
    [Arguments]    ${ue_id}=1    ${total_tput}=750
    ${pcell_dl}    Ap Get Throuput On Specific Scell    ue_id=${ue_id}    scell_id=0    type=pdsch    rate_type=ave
    Should Be True    ${pcell_dl}/1000 > 0
    ${total_dl}    Set Variable    ${pcell_dl}
    ${scell1_tput}    Ap Get Throuput On Specific Scell    ue_id=${ue_id}    scell_id=1    type=pdsch    rate_type=ave
    Should Be True    ${scell1_tput}/1000 > 0
    ${total_dl}    Evaluate    ${scell1_tput}+${total_dl}
    ${scell2_tput}    Ap Get Throuput On Specific Scell    ue_id=${ue_id}    scell_id=2    type=pdsch    rate_type=ave
    Should Be True    ${scell2_tput}/1000 > 0
    ${total_dl}    Evaluate    ${scell2_tput}+${total_dl}
    Should Be True    ${total_dl}/1000>${total_tput}
	
Verify Throuput on Pscell
    [Arguments]    ${ue_id}=1    ${pcell_dl}=720    ${ul}=9  
    ${pcell_tput}    Ap Get Throuput On Specific Scell    ue_id=${ue_id}    scell_id=0    type=pdsch    rate_type=ave
    Should Be True    ${pcell_tput}/1000 > ${pcell_dl}
    ${ul_throughput}    Ap Get Throuput On Specific Scell    ue_id=${ue_id}    scell_id=0    type=pusch    rate_type=ave
    Should Be True    ${ul_throughput}/1000>${ul}

Decrease Traffic to Trigger BWP Switch to Powersaving
    [Arguments]    ${ue_id}=2 
    Execute Egate Command    trf_data_stop ue=${ue_id} pdu=1    pass_regexp=${BWP_Switch_To_Powersaving}
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=dl kbps=5 trf_id=2    UE ${ue_id}: UDP DL
    Execute Egate Command    trf_data_start ue=${ue_id} pdu=1 qfi=1 dir=ul kbps=5 trf_id=1    UE ${ue_id}: UDP UL
    Wait Until Keyword Succeeds    30s    5s    Verify No Traffic On Scell

Verify No Traffic On Scell
    [Arguments]    ${ue_id}=2   
    ${pcell_dl}    Ap Get Throuput On Specific Scell    ue_id=${ue_id}    scell_id=0    type=pdsch    rate_type=ave
    Should Be True    ${pcell_dl} > 0
    ${scell1_tput}    Ap Get Throuput On Specific Scell    ue_id=${ue_id}    scell_id=1    type=pdsch    rate_type=ave
    Should Be True    ${scell1_tput} == 0
    ${scell2_tput}    Ap Get Throuput On Specific Scell    ue_id=${ue_id}    scell_id=2    type=pdsch    rate_type=ave
    Should Be True    ${scell2_tput} == 0
    ${ul_throughput}    Ap Get Throuput On Specific Scell    ue_id=${ue_id}    scell_id=0    type=pusch    rate_type=ave
    Should Be True    ${ul_throughput} > 0
	
Trigger A2MR And No A1 Configured
    [Arguments]    ${carrierfreq}=153370    ${srsrp_nr}=80    ${srsrq_nr}=80    ${ue_id}=2
    ${meas_id}    get nr meas id for specific type and frequency    ${ue_id}    event_type=A2    carrierfreq=${carrierfreq}
