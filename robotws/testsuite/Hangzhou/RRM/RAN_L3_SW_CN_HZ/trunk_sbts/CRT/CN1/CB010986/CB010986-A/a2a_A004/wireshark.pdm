[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#LMF sends E-CID MEASUREMENT INITIATION REQUEST with Measurement Quantity requested is “angleOfArrivalNR”‘NR Timing Advance”
# filter: ngap.procedureCode == 8 and nrppa.measurementQuantitiesValue == 10 and nrppa.measurementQuantitiesValue == 11
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 8
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 0.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 10
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 1.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 11

#E-CID MEASUREMENT INITIATION RESPONSE with Measurement Quantity requested is only ‘angleOfArrivalNR” cause Tadv is disable
# filter: ngap.procedureCode == 50 and nrppa.measuredResults == 1 and nrppa.id == 36 and nrppa.azimuthAoA == 1983
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 50
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults = 1 item
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue.choice-Extension.id = 36
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue.choice-Extension.value.UL-AoA.azimuthAoA = _x

#LMF sends E-CID MEASUREMENT INITIATION REQUEST with Measurement Quantity requested is “angleOfArrivalNR”‘NR Timing Advance”
# filter: ngap.procedureCode == 8 and nrppa.measurementQuantitiesValue == 10 and nrppa.measurementQuantitiesValue == 11
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 8
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 0.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 10
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 1.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 11

#E-CID MEASUREMENT INITIATION RESPONSE with Measurement Quantity requested is only ‘NR Timing Advance” cause AOA is disable
# filter: ngap.procedureCode == 50 and nrppa.measuredResults == 1 and nrppa.id == 94
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 50
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults = 1 item
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue.choice-Extension.id = 94

