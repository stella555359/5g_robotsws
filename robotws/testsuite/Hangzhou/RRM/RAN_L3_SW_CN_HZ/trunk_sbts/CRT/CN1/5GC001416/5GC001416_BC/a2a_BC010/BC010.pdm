[Global]
RELATION: CP1&CP2&CP3&CP4&CP5
BLOCKSIZE: -1

#in Step1:
#Check in gNB wireshark:
#A2 MR is received via NR SRB3
#in Step2:
#Check in gNB wireshark:
#1. A5 inter-frequency Measurement Report is received via NR SRB3.
#2. in F1::UE CONTEXT MODIFICATION RESPONSE message:
#CellGroupConfig.SpCellConfig.ReconfigurationWithSync.spCellConfigCommon
#-> downlinkConfigCommonfrequencyInfoDL.MultiFrequencyBandListNR.FreqBandIndicatorNR = n48
#3. RRC Reconfiguration shall be sent to UE via NR SRB3
#cg-Config.scg-CellGroupConfig(containing RRCReconfiguration)
#-> measConfig.measObjectToAddModList.measObjectNR.freqBandIndicatorNR =n48
#4.  in SgNB Modification Required message, SgNBtoMeNBContainer -> selectedbandCombinationNR set with current combination(LTE+NRn48)


[CP1]
#A2 MR is received via NR SRB3
ethernet.ipv6.sctp.f1ap

	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measId = 1
	
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 2.ProtocolIE-Field.value.SRBID = 3
	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.physCellId = 50
	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.id = 50
	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 2.ProtocolIE-Field.id = 64

	
[CP2]	
#A5 inter-frequency Measurement Report is received via NR SRB3.

ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 2.ProtocolIE-Field.value.SRBID = 3
	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.physCellId = 50
	
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.1   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measId = 4

[CP3]	
#3. RRC Reconfiguration shall be sent to UE via NR SRB3(NO NEED because A2&A5 MR checked)
#cg-Config.scg-CellGroupConfig(containing RRCReconfiguration)
#-> measConfig.measObjectToAddModList.measObjectNR.freqBandIndicatorNR =n48
ethernet.ipv6.sctp.f1ap

    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.cG-ConfigInfo.CG-ConfigInfo.criticalExtensions.c1.cg-ConfigInfo.sourceConfigSCG.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 3.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 48


	
[CP4]	
#2. in F1::UE CONTEXT MODIFICATION RESPONSE message:
#CellGroupConfig.SpCellConfig.ReconfigurationWithSync.spCellConfigCommon
#-> downlinkConfigCommonfrequencyInfoDL.MultiFrequencyBandListNR.FreqBandIndicatorNR = n48

ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 48
	
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 51
	
[CP5]
#4.  in SgNB Modification Required message, SgNBtoMeNBContainer -> selectedbandCombinationNR set with current combination(LTE+NRn48)
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.secondaryCellGroup.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 48
	
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.selectedBandCombination.bandCombinationIndex = 2


