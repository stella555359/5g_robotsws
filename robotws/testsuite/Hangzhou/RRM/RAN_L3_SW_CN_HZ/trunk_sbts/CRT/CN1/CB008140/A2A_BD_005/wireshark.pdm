[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nokiaxnap.procedureCode == 143 and nokiaxnap.privateCause == 6
#simgNB trigger igNBCAReleaseRequired message to primary gNB with cause value xgu_gtpu_error
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 143
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAReleaseRequired.protocolIEs.Item 2.ProtocolIE-Field.value.IgNBCACause.privateCause = 6

# filter: nokiaf1ap.procedureCode == 195 and nokiaf1ap.SCells_Required_To_Be_UnBlocked_List == 1
#after last UE last scell release, igNBDUconfiguration message sent with scell unblock list.
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 195
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAGnbDuConfigurationIndication.protocolIEs.Item 2.ProtocolIE-Field.value.SCells-Required-To-Be-UnBlocked-List = 1 item

# filter: nokiaxnap.procedureCode == 143 and nokiaxnap.protocolIEs == 2
#primary gNB reply igNBCAReleaseConfirm message and 2 items under it: prime-gNB-CU-UE-XnapID, ext-gNB--CU-UE-XnapID
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.procedureCode = 143
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCAReleaseConfirm.protocolIEs = 2 items

