    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Activated-List.ProtocolIE-SingleContainer.value.Cells-to-be-Activated-List-Item.iE-Extensions.ProtocolExtensionField.extensionValue.AvailablePLMNList.Item 2.AvailablePLMNList-Item.pLMNIdentity = 134130

ethernet.ipv6.sctp.f1ap
