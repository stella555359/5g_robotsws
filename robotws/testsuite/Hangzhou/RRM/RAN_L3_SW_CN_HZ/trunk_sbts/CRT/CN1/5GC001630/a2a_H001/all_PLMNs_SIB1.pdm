[Global]
RELATION: CP1 & CP2 & CP3
BLOCKSIZE: -1

[CP1]
#AMF2 first NGSetupFailure due to unknown-PLMN-or-SNPN(4)
ethernet.ip.sctp.ngap
    ethernet.ip.source = 10.0.1.102
    ethernet.ip.sctp.ngap.NGAP-PDU.unsuccessfulOutcome.value.NGSetupFailure.protocolIEs.ProtocolIE-Field.value.Cause.misc = 4

[CP2]
#Check PLMNs Are Broadcasted In MIB SIB
#Cell1 support PLMN1/PLMN2/PLMN3
ethernet.ipv6.sctp.f1ap
    #Cell1:GNBCUConfigurationUpdate SIB2 SIB3 SIB4 SIB5
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Activated-List.ProtocolIE-SingleContainer.value.Cells-to-be-Activated-List-Item.nRCGI.nRCellIdentity = bit length 36, 4 LSB pad bits, 0000 0000  0000 0000  0000 0100  0000 0000  0001 .... decimal value 16385
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Activated-List.ProtocolIE-SingleContainer.value.Cells-to-be-Activated-List-Item.iE-Extensions.ProtocolExtensionField.extensionValue.AvailablePLMNList = 3 items
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.Cells-to-be-Activated-List.ProtocolIE-SingleContainer.value.Cells-to-be-Activated-List-Item.iE-Extensions.ProtocolExtensionField.extensionValue.AvailablePLMNList.Item 0.AvailablePLMNList-Item.pLMNIdentity = 134198
