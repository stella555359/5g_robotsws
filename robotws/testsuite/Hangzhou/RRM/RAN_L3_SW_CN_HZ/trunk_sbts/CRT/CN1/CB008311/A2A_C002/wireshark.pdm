[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# BufferMonitoringNotification, check CB008311 enable and start Buffer Monitoring
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# BufferCriterionNotification, check DU sends private unacknowledged F1AP message to inform CU DL buffer
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

#gNB configures TDD cell3 as scell.
# filter: nr-rrc.sCellIndex == 9 and nr-rrc.physCellId == 52
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 52
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellIndex = 9

#SCellStatusNotification.Include this SCell’s ID, and the reason for the release request
# filter: nokiaf1ap.sCellIndex == 9 and nokiaf1ap.sCellInactiveReason == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.SCellStatusNotification.protocolIEs.Item 2.ProtocolIE-Field.value.SCell-Status-List.Item 0.SCell-Status-Item.sCellInactiveReason = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.SCellStatusNotification.protocolIEs.Item 2.ProtocolIE-Field.value.SCell-Status-List.Item 0.SCell-Status-Item.sCellIndex = 9

# BufferMonitoringNotification, check CB008311 enable and start Buffer Monitoring
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# BufferCriterionNotification, check DU sends private unacknowledged F1AP message to inform CU DL buffer
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

#gNB configures TDD cell3 as scell.
# filter: nr-rrc.sCellIndex == 9 and nr-rrc.physCellId == 52
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 52
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellIndex = 9

#online modify sCellInactivityReleaseTimer
# filter: itf_l2_ps_cell_CaConfigSCell.sCellInactivityReleaseTimer == 40 and itf_l2_ps_cell_CellReconfigurationReq_t.nrCellIdentity == 16387
ethernet.ipv6.sctp.syscom
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_cellreconfigurationreq.itf_l2_ps_cell_CellReconfigurationReq_t.caConfig (itf_l2_ps_cell_CaConfig).caConfigSCell (itf_l2_ps_cell_CaConfigSCell).sCellInactivityReleaseTimer (Uint16) = 40
    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_cellreconfigurationreq.itf_l2_ps_cell_CellReconfigurationReq_t.nrCellIdentity (Uint64) = 16387
