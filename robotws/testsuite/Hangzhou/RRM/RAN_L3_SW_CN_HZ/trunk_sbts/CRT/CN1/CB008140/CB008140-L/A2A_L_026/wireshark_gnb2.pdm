[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nokiaxnap.CellToReportList == 1 and nokiaxnap.NR-Cell-Identity == 0x0000004001
# after online modify for GNB1 to add the first new NRREL cell1-1 for Pcell cell2-11, GNB2 send 'IgNBCASetupRequest' to GNB1.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList.Item 0.NrCells-Item.nr-cell.nr-CI = 0x0000004001

# filter: nokiaxnap.CellToReportList == 1 and nokiaxnap.Nokia_XnAP_PDU == 1 
# GNB1 respond GNB2 'IgNBCASetupResponse'.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCASetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList = 1 item

# filter: nokiaxnap.ResetRequestTypeInfo == 1 and nokiaxnap.ue_contexts_ToBeReleasedList == 1
# after online modify for GNB2 to change NRREL from cell1-1 to cell1-2 for cell2-11. UE2 will be bulk released due to cell2-11 reset.GNB2 send 'ResetRequest' to GNB1. ResetRequestTypeInfo:partialReset.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo.partialReset.ue-contexts-ToBeReleasedList = 1 item

# filter: nokiaxnap.ResetResponseTypeInfo == 1 and nokiaxnap.ue_contexts_AdmittedToBeReleasedList == 1
# GNB1 respond 'ResetResponse'.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo.partialReset.ue-contexts-AdmittedToBeReleasedList = 1 item

# filter: nokiaxnap.cellsToRemove == 1 and nokiaxnap.NR-Cell-Identity == 0x0000004001
# GNB2 send 'IgNBCAConfigurationUpdateIndication' with scell cell1-1 to remove.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToRemove.Item 0.NR-CGI.nr-CI = 0x0000004001
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToRemove = 1 item

# filter: nokiaxnap.CellToReportList == 1 and nokiaxnap.NR-Cell-Identity == 0x0000004002
# then GNB2 send 'IgNBCASetupRequest' with scell cell1-2.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList.Item 0.NrCells-Item.nr-cell.nr-CI = 0x0000004002

# filter: nokiaxnap.CellToReportList == 1 and nokiaxnap.Nokia_XnAP_PDU == 1
# GNB1 respond 'IgNBCASetupResponse'.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCASetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList = 1 item

# filter: nokiaxnap.ResetRequestTypeInfo == 1 and nokiaxnap.ue_contexts_ToBeReleasedList == 1
# online modify for GNB2 to change NRREL from cell1-2 to simGNB4 cell4-5 for cell2-11.UE3 will be bulk released due to cell2-11 reset.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo.partialReset.ue-contexts-ToBeReleasedList = 1 item

# filter: nokiaxnap.ResetResponseTypeInfo == 1 and nokiaxnap.ue_contexts_AdmittedToBeReleasedList == 1
# GNB1 send 'ResetResponse'.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo.partialReset.ue-contexts-AdmittedToBeReleasedList = 1 item

# filter: nokiaxnap.cellsToRemove == 1 and nokiaxnap.NR-Cell-Identity == 0x0000004002
# GNB2 send 'IgNBCAConfigurationUpdateIndication' to remove scell cell1-2.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToRemove = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.CellToReportListUpdate.cellsToRemove.Item 0.NR-CGI.nr-CI = 0x0000004002

# filter: nokiaxnap.CellToReportList == 1 and nokiaxnap.NR-Cell-Identity == 0x000008c005
# then GNB2 send 'IgNBCASetupRequest' to sim GNB4, with CellToReport cell4-5.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList.Item 0.NrCells-Item.nr-cell.nr-CI = 0x000008c005

# filter: nokiaxnap.Inter_gNB_CA_Allowed == 1
# GNB2 send 'IgNBCAConfigurationUpdateIndication' with Inter-gNB-CA-Allowed:allowed.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.Inter-gNB-CA-Allowed = 1

# filter: nokiaxnap.NR-Cell-Identity == 0x0000008003 and nokiaxnap.numberOfActiveUEs == 1
# before release all UEs, check ue1 is still alived.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 0.CellLoadResultItem.nr-cell.nr-CI = 0x0000008003
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 0.CellLoadResultItem.numberOfActiveUEs = 1

# filter: nokiaxnap.procedureCode == 144
# after online modify for GNB2 to change NRREL from cell4-5 to cell1-2 for cell2-11, GNB2 send 'IgNBCARemovalRequest' to simGNB4. procedureCode 144:id-igNBCAXnRemoval
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 144

# filter: nokiaxnap.CellToReportList == 1 and nokiaxnap.NR-Cell-Identity == 0x0000004002
# then GNB2 send 'IgNBCASetupRequest' to GNB1 with CellToReport scell cell1-2.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList.Item 0.NrCells-Item.nr-cell.nr-CI = 0x0000004002


# filter: nokiaxnap.ReportedCellList == 1 and nokiaxnap.NR-Cell-Identity == 0x0000008003 and nokiaxnap.Inter_gNB_CA_Allowed == 1
# GNB2 send 'IgNBCAConfigurationUpdateIndication' with ReportedCell scell cell2-3 and Inter-gNB-CA-Allowed:allowed. GNB2 iGnbCaXnCfUpBackOffTmr started.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.nr-cell.nr-CI = 0x0000008003
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 1.ProtocolIE-Field.value.Inter-gNB-CA-Allowed = 1

# filter: nokiaxnap.CellToReportList == 1 and nokiaxnap.NR-Cell-Identity == 0x0000004002
# after online modify for GNB2 to delete NRREL cell1-2 and add again for cell2-11, GNB2 send 'IgNBCASetupRequest' with CellToReport scell cell1-2. timer iGnbCaXnCfUpBackOffTmr canceled at the same time.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCASetupRequest.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList.Item 0.NrCells-Item.nr-cell.nr-CI = 0x0000004002

# filter: nokiaxnap.CellToReportList == 1 and nokiaxnap.Nokia_XnAP_PDU == 1
# GNB1 respond 'IgNBCASetupResponse'.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.successfulPrivateOutcome.value.IgNBCASetupResponse.protocolIEs.Item 1.ProtocolIE-Field.value.CellToReportList = 1 item

# filter: nokiaxnap.ReportedCellList == 1 and nokiaxnap.NR-Cell-Identity == 0x0000008003 and nokiaxnap.Inter_gNB_CA_Allowed == 1
# GNB2 send 'IgNBCAConfigurationUpdateIndication' with ReportedCell scell cell2-3, and Inter-gNB-CA-Allowed:allowed.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.nr-cell.nr-CI = 0x0000008003
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.ReportedCellList.Item 0.CellReportItem.numberOfActiveUEs = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 1.ProtocolIE-Field.value.Inter-gNB-CA-Allowed = 1

