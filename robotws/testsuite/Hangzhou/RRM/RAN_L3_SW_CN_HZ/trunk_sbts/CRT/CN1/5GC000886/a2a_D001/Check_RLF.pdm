[Global]
RELATION: CP1 & CP2 & CP3
BLOCKSIZE: -1

[CP1]
# Check Messages of RLF Procedure in Wireshark Log
# {condition_list}    {X2AP_FILTER}.SgNBReleaseRequired_element
#...    {X2AP_FILTER}.SgNBReleaseConfirm_element
#...    {E1AP_FILTER}.BearerContextModificationRequest_element
#...    {E1AP_FILTER}.BearerContextModificationResponse_element
#...    {X2AP_FILTER}.SNStatusTransfer_element
#...    {X2AP_FILTER}.UEContextRelease_element
#...    f1ap.UEContextReleaseCommand_element
#...    f1ap.UEContextReleaseComplete_element

# ===================Msg: 36 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
    ethernet.ip.sctp.x2ap.value = SgNBReleaseRequired

# ===================Msg: 37 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.2
    ethernet.ip.source = 10.0.1.12
    ethernet.ip.sctp.x2ap.value = SgNBReleaseConfirm

# ===================Msg: 40 start================
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2 = id-System-BearerContextModificationRequest

# ===================Msg: 59 start================
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationResponse.protocolIEs.Item 2 = id-System-BearerContextModificationResponse

# ===================Msg: 63 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
    ethernet.ip.sctp.x2ap.value = SNStatusTransfer

# ===================Msg: 67 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.2
    ethernet.ip.source = 10.0.1.12
    ethernet.ip.sctp.x2ap.value = UEContextRelease

# ===================Msg: 69 start================
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextReleaseCommand = None

# ===================Msg: 100 start================
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextReleaseComplete = None
	

[CP2]
# Check e1ap Data Usage Report by tcpdump
# {Case0102_E1AP_usage_report_condition}    {E1AP_FILTER}.dRB_Usage_Report_List == 1

# ===================Msg: 8 start================
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.DataUsageReport = None

# ===================Msg: 49 start================
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.DataUsageReport = None


[CP3]
# Check x2ap for Secondary RAT Data Usage Report by tcpdump
# {Case0102_X2AP_usage_report_condition}    {X2AP_FILTER}.e_RABUsageReportList == 1

# ===================Msg: 10 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
    ethernet.ip.sctp.x2ap.value = SecondaryRATDataUsageReport

# ===================Msg: 53 start================
ethernet.ip.sctp.x2ap
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
    ethernet.ip.sctp.x2ap.value = SecondaryRATDataUsageReport
