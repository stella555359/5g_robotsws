[Global]
RELATION: CP1&CP2&CP3&CP4&CP5
BlOCKSIZE: -1

[CP1]
# filter: nokiaf1ap.procedureCode == 193 and nokiaf1ap.IgNB_CA_SCell_ToBeRemoved_List == 1
#Druing cell2_3 is shutting down procedure,trigger A2 to release UE3 scell_1(cell2_3)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.procedureCode = 193
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.IgNBCAUeContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.IgNB-CA-SCell-ToBeRemoved-List = 1 item

# filter: nokiaf1ap.procedureCode == 193 and nr-rrc.SCellIndex == 1
#UE3 scellindx=1(cell2_3) is released
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.procedureCode = 193
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToReleaseList.Item 0.SCellIndex = 1

# filter: nokiaxnap.procedureCode == 140 and nokiaxnap.radioNetwork == 0
#Druing cell2_3 is shutting down procedure,UE5 is rejected to add cell2_3 as scell
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.unsuccessfulPrivateOutcome.procedureCode = 140
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.unsuccessfulPrivateOutcome.value.IgNBCAAdditionRequestReject.protocolIEs.Item 2.ProtocolIE-Field.value.IgNBCACause.standardCause.radioNetwork = 0

# filter: nokiaxnap.procedureCode == 18 and nokiaxnap.served_Cells_ToDelete_NR == 1 and nokiaxnap.NR-Cell-Identity == 0x0000008003
#cell2_3 is locked
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.procedureCode = 18
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.ConfigurationUpdateInitiatingNodeChoice.gNB.Item 0.ProtocolIE-Field.value.ServedCellsToUpdate-NR.served-Cells-ToDelete-NR = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.ConfigurationUpdateInitiatingNodeChoice.gNB.Item 0.ProtocolIE-Field.value.ServedCellsToUpdate-NR.served-Cells-ToDelete-NR.Item 0.NR-CGI.nr-CI = 0x0000008003

# filter: nokiaxnap.procedureCode == 142 and nokiaxnap.radioNetwork == 65
#Manually release UEs,UE3 CA release with cell2_4,it meas only UE4 is detached
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.procedureCode = 142
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAReleaseRequest.protocolIEs.Item 2.ProtocolIE-Field.value.IgNBCACause.standardCause.radioNetwork = 65

[CP2]
# filter: nokiaxnap.procedureCode == 20 and nokiaxnap.misc == 2
#XN ResetRequest
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.procedureCode = 20
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.misc = 2

# filter: nokiaxnap.procedureCode == 20 and nokiaxnap.ue_contexts_AdmittedToBeReleasedList == 1
#Only one UE(UE4) is deregistered due to CA releation with cell2_3
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.procedureCode = 20
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo.partialReset.ue-contexts-AdmittedToBeReleasedList = 1 item

[CP3]
# filter: nokiaf1ap.procedureCode == 0 and nokiaf1ap.partOfF1_Interface == 1
#F1 Reset
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface = 1 item

# filter: nokiaf1ap.procedureCode == 0 and nokiaf1ap.UE_associatedLogicalF1_ConnectionListResAck == 1
#Only one UE(UE4) is deregistered due to CA releation with cell2_3
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.procedureCode = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.UE-associatedLogicalF1-ConnectionListResAck = 1 item

[CP4]
# filter: e1ap.procedureCode == 0 and e1ap.ResetType == 1
#E1 Reset
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1

# filter: e1ap.procedureCode == 0 and e1ap.UE_associatedLogicalE1_ConnectionListResAck == 1
#Only one UE(UE4) is deregistered due to CA releation with cell2_3
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.procedureCode = 0
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.UE-associatedLogicalE1-ConnectionListResAck = 1 item

[CP5]
# filter: ngap.procedureCode == 20 and ngap.radioNetwork == 3
#NGRest
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 20
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause.radioNetwork = 3

# filter: ngap.procedureCode == 20 and ngap.UE_associatedLogicalNG_connectionList == 1
#Only one UE(UE4) is deregistered due to CA releation with cell2_3
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.procedureCode = 20
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.UE-associatedLogicalNG-connectionList = 1 item

