[Global]
RELATION: CP1
BLOCKSIZE: -1

[CP1]
#add slice2 in TAC
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.TAISupport-List.TAISupport-Item.broadcastPLMNs.BroadcastPLMNinTAISupport-Item.tAISliceSupport-List = 2 items
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.TAISupport-List.TAISupport-Item.broadcastPLMNs.BroadcastPLMNinTAISupport-Item.tAISliceSupport-List.Item 0.S-NSSAI.sd = d143a5
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.TAISupport-List.TAISupport-Item.broadcastPLMNs.BroadcastPLMNinTAISupport-Item.tAISliceSupport-List.Item 1.S-NSSAI.sd = d143a6

ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.NGRANNodeConfigurationUpdateAcknowledge = *

#Trigger HO from real-gNB to sim-gNB success
ethernet.ip.sctp.xnap
    ethernet.ip.source = 10.0.1.2
    ethernet.ip.destination = 10.0.1.124
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest = *

ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge = *

#Lock slice2
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.TAISupport-List.TAISupport-Item.broadcastPLMNs.BroadcastPLMNinTAISupport-Item.tAISliceSupport-List = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.TAISupport-List.TAISupport-Item.broadcastPLMNs.BroadcastPLMNinTAISupport-Item.tAISliceSupport-List.S-NSSAI.sd = d143a5

ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.NGRANNodeConfigurationUpdateAcknowledge = *

#Trigger HO from sim-gNB to real-gNB failed
ethernet.ip.sctp.xnap
    ethernet.ip.source = 10.0.1.124
    ethernet.ip.destination = 10.0.1.2
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest = *

ethernet.ip.sctp.xnap
    # 45 = slice-not-supported-by-NG-RAN
    ethernet.ip.sctp.xnap.XnAP-PDU.unsuccessfulOutcome.value.HandoverPreparationFailure.protocolIEs.ProtocolIE-Field.value.Cause.radioNetwork = 45

#Unlock slice2
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.TAISupport-List.TAISupport-Item.broadcastPLMNs.BroadcastPLMNinTAISupport-Item.tAISliceSupport-List = 2 items
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.TAISupport-List.TAISupport-Item.broadcastPLMNs.BroadcastPLMNinTAISupport-Item.tAISliceSupport-List.Item 0.S-NSSAI.sd = d143a5
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.NGRANNodeConfigurationUpdate.protocolIEs.ProtocolIE-Field.value.TAISupport-List.TAISupport-Item.broadcastPLMNs.BroadcastPLMNinTAISupport-Item.tAISliceSupport-List.Item 1.S-NSSAI.sd = d143a6

ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.NGRANNodeConfigurationUpdateAcknowledge = *

#Trigger HO from sim-gNB to real-gNB success
ethernet.ip.sctp.xnap
    ethernet.ip.source = 10.0.1.124
    ethernet.ip.destination = 10.0.1.2
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest = *

ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge = *