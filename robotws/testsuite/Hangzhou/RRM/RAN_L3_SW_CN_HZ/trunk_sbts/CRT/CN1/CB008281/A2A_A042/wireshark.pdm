[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#E-CID MEASUREMENT INITIATION REQUEST:Measurement Quantity requested is ‘SS-RSRP & SS-RSRQ’.Report Characteristics IE set to On-Demand 
# filter: nrppa.measurementQuantitiesValue == 6 and nrppa.measurementQuantitiesValue == 7 and nrppa.ReportCharacteristics == 0
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 1.ProtocolIE-Field.value.ReportCharacteristics = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 0.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 6
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 1.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 7

#RRCReconfiguration message
# filter: nr-rrc.rsType == 0 and nr-rrc.reportAmount == 0 and nr-rrc.includeBeamMeasurements == 1 and nr-rrc.measObjectId == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measObjectId = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.periodical.includeBeamMeasurements = True
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.periodical.reportAmount = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.periodical.rsType = 0

#UEContextModificationRequired: radioNetwork: rl-failure-others (12).
# filter: nokiaf1ap.radioNetwork == 12
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequired.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 12

# E-CID MEASUREMENT INITIATION FAILURE:RNL Cause = "Requested Item Temporarily Not Available"(2).
# filter: nrppa.radioNetwork == 2
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.unsuccessfulOutcome.value.E-CIDMeasurementInitiationFailure.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 2
