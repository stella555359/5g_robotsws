[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#check XnAP: IGNB CA CONFIGURATION UPDATE INDICATION message from gnb-1 to gnb-2, indicates no support of FR1 CA with MFBI. 
# filter: nokiaxnap.MFBI_CA_Support == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.MFBI-CA-Support = 1

#UE1
#RRC with Pcell band 78
# filter: nr-rrc.freqBandIndicatorNR == 78
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 78

#IgNBCAAdditionRequest FR1 CA with MFBI is supported, Extended-Band is supported.
# filter: nokiaxnap.MFBI_CA_Support == 0 and nokiaxnap.Extended_Band_Support == 00
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 13.ProtocolIE-Field.value.MFBI-CA-Support = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 14.ProtocolIE-Field.value.Extended-Band-Support_pre = 00 

#RRC Scell band 78 4 Layer
# filter: nr-rrc.freqBandIndicatorNR == 78 and nr-rrc.maxMIMO_Layers == 2 and nr-rrc.maxMIMO_Layers == 4 and nr-rrc.sCellIndex == 1 and nr-rrc.physCellId == 52 and nr-rrc.FreqBandIndicatorNR == 78
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.Prime-DU-to-Ext-DU-RRC-Information-Container.Prime-DU-to-Ext-DU-RRC-Information.ext-SCellInformation-List.Item 0.Ext-SCellInformation-Item.sCellIndex = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextModificationResponse.protocolIEs.Item 3.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 78
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextModificationResponse.protocolIEs.Item 3.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 52
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextModificationResponse.protocolIEs.Item 3.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigDedicated.pdsch-ServingCellConfig.setup.maxMIMO-Layers = 4
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextModificationResponse.protocolIEs.Item 3.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellIndex = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.successfulPrivateOutcome.value.IgNBCAUeContextModificationResponse.protocolIEs.Item 3.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.spCellConfigDedicated.pdsch-ServingCellConfig.setup.maxMIMO-Layers = 2

#check XnAP: IGNB CA CONFIGURATION UPDATE INDICATION message from gnb-2 to gnb-1, indicates support of FR1 CA with MFBI.
# filter: nokiaxnap.MFBI_CA_Support == 0
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.MFBI-CA-Support = 0

#UE2
#RRC with Pcell band 78
# filter: nr-rrc.freqBandIndicatorNR == 78
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.CUtoDURRCInformation.measConfig.MeasConfig.measObjectToAddModList.Item 0.MeasObjectToAddMod.measObject.measObjectNR.freqBandIndicatorNR = 78

#IgNBCAAdditionRequest FR1 CA with MFBI is supported, Extended-Band is supported.
# filter: nokiaxnap.MFBI_CA_Support == 0 and nokiaxnap.Extended_Band_Support == 00
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 13.ProtocolIE-Field.value.MFBI-CA-Support = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAAdditionRequest.protocolIEs.Item 14.ProtocolIE-Field.value.Extended-Band-Support_pre = 00 

# XnAP: IGNB CA ADDITION REQUEST REJECT message with reject reason insufficient-ue-capabilities (64)
# filter: nokiaxnap.radioNetwork == 64
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.unsuccessfulPrivateOutcome.value.IgNBCAAdditionRequestReject.protocolIEs.Item 2.ProtocolIE-Field.value.IgNBCACause.standardCause.radioNetwork = 64

#check XnAP: IGNB CA CONFIGURATION UPDATE INDICATION message from gnb-1 to gnb-2, indicates no support of FR1 CA with MFBI. 
# filter: nokiaxnap.MFBI_CA_Support == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAConfigurationUpdateIndication.protocolIEs.Item 0.ProtocolIE-Field.value.MFBI-CA-Support = 1

