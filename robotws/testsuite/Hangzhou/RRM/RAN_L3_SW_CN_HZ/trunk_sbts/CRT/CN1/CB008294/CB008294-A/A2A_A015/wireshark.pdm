[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# InitialContext
# filter: ngap.procedureCode == 14
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 14

# UEContextModification
# filter: nokiaf1ap.procedureCode == 7
ethernet.ipv6.sctp.f1ap
