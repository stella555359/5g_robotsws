[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# from AMF to GNB: InitialContextSetupRequest with RedirectionVoiceFallback possible
ethernet.ip.sctp.ngap
    ethernet.ip.source=10.0.1.1
    ethernet.ip.destination=10.0.1.2
    # RedirectionVoiceFallback: possible (0)
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 8.ProtocolIE-Field.value.RedirectionVoiceFallback = 0

# from AMF to GNB: PDUSessionResourceModifyRequest to request 5QI1 setup
ethernet.ip.sctp.ngap
    ethernet.ip.source=10.0.1.1
    ethernet.ip.destination=10.0.1.2
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 2.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 1

# from GNB to AMF: PDUSessionResourceModifyResponse (5QI1 setup failed with cause voice fallback)
ethernet.ip.sctp.ngap
    ethernet.ip.source=10.0.1.2
    ethernet.ip.destination=10.0.1.1
    # radioNetwork: ims-voice-eps-fallback-or-rat-fallback-triggered (36)
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.PDUSessionResourceModifyResponse.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceFailedToModifyListModRes.Item 0.PDUSessionResourceFailedToModifyItemModRes.pDUSessionResourceModifyUnsuccessfulTransfer.PDUSessionResourceModifyUnsuccessfulTransfer.cause.radioNetwork = 36

# F1AP: rrcRelease with redirectedCarrierInfo eutraFrequency = 38000
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcRelease.criticalExtensions.rrcRelease.redirectedCarrierInfo.eutra.eutraFrequency = 38000

# from GNB to AMF: UEContextReleaseRequest with redirection
ethernet.ip.sctp.ngap
    ethernet.ip.source=10.0.1.2
    ethernet.ip.destination=10.0.1.1
    # radioNetwork: redirection (41)
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.Item 3.ProtocolIE-Field.value.Cause.radioNetwork = 41

# from AMF to GNB:UEContextReleaseCommand with redirection
ethernet.ip.sctp.ngap
    ethernet.ip.source=10.0.1.1
    ethernet.ip.destination=10.0.1.2
    # radioNetwork: redirection (41)
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 41

# from GNB to AMF: UEContextReleaseComplete with pDUSessionID = 1
ethernet.ip.sctp.ngap
    ethernet.ip.source=10.0.1.2
    ethernet.ip.destination=10.0.1.1
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.UEContextReleaseComplete.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceListCxtRelCpl.Item 0.PDUSessionResourceItemCxtRelCpl.pDUSessionID = 1

# E1AP: BearerContextReleaseCommand
ethernet.ipv6.sctp.e1ap
    # radioNetwork: normal-release (20)
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextReleaseCommand.protocolIEs.Item 2.ProtocolIE-Field.value.Cause.radioNetwork = 20

# E1AP: BearerContextReleaseComplete
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextReleaseComplete.protocolIEs = *
