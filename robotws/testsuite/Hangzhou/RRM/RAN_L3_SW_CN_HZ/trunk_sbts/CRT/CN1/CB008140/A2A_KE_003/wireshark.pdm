[Global]
RELATION: CP1&CP2&CP3&CP4
BlOCKSIZE: -1

[CP1]
#xnap partialReset during L3UE pool failure on external gnb
# filter: nokiaxnap.ResetRequestTypeInfo == 1 and nokiaxnap.transport == 0
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0

# filter: nokiaxnap.ResetResponseTypeInfo == 1 and nokiaxnap.ue_contexts_AdmittedToBeReleasedList == 1
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo.partialReset.ue-contexts-AdmittedToBeReleasedList = 1 item

# filter: nokiaxnap.NR-Cell-Identity == 0x0000008001 and nokiaxnap.numberOfActiveUEs == 0
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 0.CellLoadResultItem.nr-cell.nr-CI = 0x0000008001
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 0.CellLoadResultItem.numberOfActiveUEs = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 1.CellLoadResultItem.numberOfActiveUEs = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 2.CellLoadResultItem.numberOfActiveUEs = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-XnAP-PDU.initiatingPrivateMessage.value.IgNBCAResourceStatusUpdate.protocolIEs.Item 0.ProtocolIE-Field.value.CellLoadResult.Item 3.CellLoadResultItem.numberOfActiveUEs = 0

[CP2]
#f1ap partialReset during L3UE pool failure on external gnb
# filter: nokiaf1ap.transport == 0 and nokiaf1ap.ResetType == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1

# filter: nokiaf1ap.id == 81 and nokiaf1ap.UE_associatedLogicalF1_ConnectionListResAck == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.id = 81
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.UE-associatedLogicalF1-ConnectionListResAck = 1 item

[CP3]
#e1ap partialReset during L3UE pool failure on external gnb
# filter: e1ap.transport == 0 and e1ap.partOfE1_Interface == 1
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfE1-Interface = 1 item

# filter: e1ap.id == 6 and e1ap.UE_associatedLogicalE1_ConnectionListResAck == 1
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.id = 6
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.ResetAcknowledge.protocolIEs.Item 1.ProtocolIE-Field.value.UE-associatedLogicalE1-ConnectionListResAck = 1 item

[CP4]
#ngap partialReset during L3UE pool failure on external gnb
# filter: ngap.radioNetwork == 3 and ngap.partOfNG_Interface == 1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 0.ProtocolIE-Field.value.Cause.radioNetwork = 3
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.NGReset.protocolIEs.Item 1.ProtocolIE-Field.value.ResetType.partOfNG-Interface = 1 item

# filter: ngap.protocolIEs == 1
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs = 1 item
