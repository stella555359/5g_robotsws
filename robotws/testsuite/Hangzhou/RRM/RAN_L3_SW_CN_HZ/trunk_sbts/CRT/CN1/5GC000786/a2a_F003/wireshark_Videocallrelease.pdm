[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
## from AMF to GNB: PDUSessionResourceReleaseCommand
# ngap.procedureCode == 28 and ngap.nas == 0
# procedureCode: id-PDUSessionResourceRelease (28)
# nas: normal-release (0)
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceReleaseCommand.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceToReleaseListRelCmd.Item 0.PDUSessionResourceToReleaseItemRelCmd.pDUSessionResourceReleaseCommandTransfer.PDUSessionResourceReleaseCommandTransfer.cause.nas = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.procedureCode = 28

## F1AP: UEContextModificationRequest
# f1ap.procedureCode == 7 and f1ap.id == 33
# procedureCode: id-UEContextModification (7)
# id: id-DRBs-ToBeReleased-List (33)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 7
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.id = 33

## E1AP: BearerContextModificationRequest
# e1ap.procedureCode == 9 and e1ap.id == 18 and e1ap.id == 44
# procedureCode: id-bearerContextModification (9)
# id: id-System-BearerContextModificationRequest (18)
# id: id-PDU-Session-Resource-To-Remove-List (44)
