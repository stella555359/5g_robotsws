    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 9
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.id = 18
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextModificationRequest.nG-RAN-BearerContextModificationRequest.Item 0.ProtocolIE-Field.id = 44

## E1AP: BearerContextModificationResponse
# e1ap.procedureCode == 9 and e1ap.id == 2 and e1ap.id == 3
# procedureCode: id-bearerContextModification (9)
# id: id-gNB-CU-CP-UE-E1AP-ID (2)
# id: id-gNB-CU-UP-UE-E1AP-ID (3)
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationResponse.protocolIEs.Item 0.ProtocolIE-Field.id = 2
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.procedureCode = 9
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationResponse.protocolIEs.Item 1.ProtocolIE-Field.id = 3

## F1AP: UEContextModificationResponse
