    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 1

