[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#after ICS, For Pdu1 add qosflow QFI 1
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.Item 0.DRB-ToAddMod.cnAssociation.sdap-Config.mappedQoS-FlowsToAdd.Item 0.QFI = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.Item 0.DRB-ToAddMod.cnAssociation.sdap-Config.pdu-Session = 1

#after trigger A1 ,2 scells was added, A2 event configured
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToAddModList.Item 1.SCellConfig.sCellConfigCommon.physCellId = 51
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 50

#modify qos1 priority to 4

#add qos2 and qos6
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.Item 1.DRB-ToAddMod.cnAssociation.sdap-Config.mappedQoS-FlowsToAdd.Item 0.QFI = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.Item 0.DRB-ToAddMod.cnAssociation.sdap-Config.mappedQoS-FlowsToAdd.Item 0.QFI = 3

#delete CA-split DRB qos1 qos2

#tigger A2 to release scell index-1 ( physCellID 50 ), remove A2 measid 2
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.Item 0.MeasId = 2
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToReleaseList.Item 0.SCellIndex = 1

#tigger A2 to release scell index-2 ( physCellID 51 ), remove A2 measid 3 , A1 reconfigured measeid 4
ethernet.ipv6.sctp.f1ap.F1AP-PDU
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measId = 4
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList.Item 0.MeasId = 3
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.sCellToReleaseList.Item 0.SCellIndex = 2

