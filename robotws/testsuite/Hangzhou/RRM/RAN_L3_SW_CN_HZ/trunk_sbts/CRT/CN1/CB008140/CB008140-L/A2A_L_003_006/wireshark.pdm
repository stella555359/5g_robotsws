    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.XnSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.ServedCells-NR.Item 0.ServedCells-NR-Item.served-cell-info-NR.cellID.nr-CI = 0x000008c005
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.XnSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.ServedCells-NR.Item 1.ServedCells-NR-Item.served-cell-info-NR.cellID.nr-CI = 0x000008c006
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.XnSetupRequest.protocolIEs.Item 3.ProtocolIE-Field.value.ServedCells-NR.Item 2.ServedCells-NR-Item.served-cell-info-NR.cellID.nr-CI = 0x000008c007

