#igNBCasetup when flag enable again
# filter: ((nokiaxnap.NR-Cell-Identity == 0x000008c005) && (nokiaxnap.NR-Cell-Identity == 0x000008c006)) && (nokiaxnap.NR-Cell-Identity == 0x000008c007)
