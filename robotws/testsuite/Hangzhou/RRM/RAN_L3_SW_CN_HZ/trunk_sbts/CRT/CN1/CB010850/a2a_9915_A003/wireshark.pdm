    ethernet.ipv6.sctp.syscom.pscell.itf_l2_ps_cell_cellsetupreq.itf_l2_ps_cell_CellSetupReq_t.cellBwp (itf_l2_ps_cell_CellBwp).10).cellBwpList_item_1 (itf_l2_ps_cell_Bwp).uplinkBwp (itf_l2_ps_cell_BwpDefinitionUl).longPucchNumPuschPrb (StaticVariableSizedArray).longPucchNumPuschPrb_item_0 (Uint16) = 29
