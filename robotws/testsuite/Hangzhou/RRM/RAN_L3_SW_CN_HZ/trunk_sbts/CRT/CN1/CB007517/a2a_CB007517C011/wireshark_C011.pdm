#NGAP:Handoverequired
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.HandoverRequired.protocolIEs.Item 2.ProtocolIE-Field.value.HandoverType = 0

#NGAP:HandoverCommand
ethernet.ip.sctp.ngap
