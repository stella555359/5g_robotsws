[Global]

RELATION: CP1

BlOCKSIZE: -1



[CP1]
#F1AP:RRCReconfiguration:Drx setup
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 1
	arrival_time =_x
	
#F1AP:RRCReconfiguration:for Drx release,gapUE setup and A4 event config and rety timer expired(5s)
ethernet.ipv6.sctp.f1ap   
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapUE = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId = 3
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.nonCriticalExtension.masterCellGroup.CellGroupConfig.mac-CellGroupConfig.drx-Config = 0
	arrival_time =x+5~x+6
	
#F1AP:RRCReconfiguration:for gapUE release and A4 config remove , timer for wait supervison timer expired(8s)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measGapConfig.gapUE = 0
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.ProtocolIE-Field.value.NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToRemoveList = 4 items
	arrival_time =x+13~x+14
	
	
