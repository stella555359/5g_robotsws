	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.DRBs-ToBeSetupMod-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-ToBeSetupMod-Item.qoSInformation.choice-extension.value.DRB-Information.dRB-QoS.qoS-Characteristics.non-Dynamic-5QI.fiveQI = 1
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextModificationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.DRBs-ToBeSetupMod-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-ToBeSetupMod-Item.dRBID = 6

