[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]

#will trigger fallback：

#Step 1:DRB6 setup
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.UEContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.DRBs-ToBeSetup-List.Item 0.ProtocolIE-SingleContainer.value.DRBs-ToBeSetup-Item.qoSInformation.choice-extension.value.DRB-Information.flows-Mapped-To-DRB-List.Item 0.Flows-Mapped-To-DRB-Item.qoSFlowLevelQoSParameters.qoS-Characteristics.non-Dynamic-5QI.fiveQI = 6
	
# RRC reconfiguration complete, start retry timer
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.7   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.rrcReconfigurationComplete.criticalExtensions.rrcReconfigurationComplete =*
	
#UEContextModificationResponse and drx setup
ethernet.ipv6.sctp.f1ap
	ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.mac-CellGroupConfig.drx-Config.setup = *
	arrival_time = _x
	
# UEContextModificationRequest and 5QI5 setup
