[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#E-CID MEASUREMENT INITIATION REQUEST:Measurement Quantity requested is ‘SS-RSRP’,Report Characteristics IE set to On-Demand 
# filter: nrppa.measurementQuantitiesValue == 6 and nrppa.ReportCharacteristics == 0
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 1.ProtocolIE-Field.value.ReportCharacteristics = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.DownlinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.initiatingMessage.value.E-CIDMeasurementInitiationRequest.protocolIEs.Item 2.ProtocolIE-Field.value.MeasurementQuantities.Item 0.ProtocolIE-Single-Container.value.MeasurementQuantities-Item.measurementQuantitiesValue = 6

#RRCReconfiguration message
# filter: nr-rrc.rsType == 0 and nr-rrc.reportAmount == 0 and nr-rrc.includeBeamMeasurements == 1 and nr-rrc.measObjectId == 1
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.measIdToAddModList.Item 0.MeasIdToAddMod.measObjectId = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.periodical.includeBeamMeasurements = True
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.periodical.reportAmount = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.DLRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.6   ).NR Radio Resource Control (RRC) protocol.DL-DCCH-Message.message.c1.rrcReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.periodical.rsType = 0

#Measurement Report
# filter: nr-rrc.measQuantityResults.rsrp == 30 and  nr-rrc.measQuantityResults.rsrq == 30  and  nr-rrc.measQuantityResults.rsrp == 50 and nr-rrc.measQuantityResults.rsrq == 50
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrp = 30
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.measResult.cellResults.resultsSSB-Cell.rsrq = 30
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.measResult.rsIndexResults.resultsSSB-Indexes.Item 0.ResultsPerSSB-Index.ssb-Results.rsrp = 50
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.9   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.measurementReport.criticalExtensions.measurementReport.measResults.measResultServingMOList.Item 0.MeasResultServMO.measResultServingCell.measResult.rsIndexResults.resultsSSB-Indexes.Item 0.ResultsPerSSB-Index.ssb-Results.rsrq = 50

#E-CID MEASUREMENT INITIATION RESPONSE:servingCellTAC ,MeasuredResultsValue , sSB_Index , valueSS_RSRP.
# filter: nrppa.servingCellTAC == 0 and nrppa.MeasuredResultsValue == 5  and  nrppa.sSB_Index == 0 and nrppa.valueSS_RSRP == 50
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue = choice-Extension (5): id-ResultSS-RSRP
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue.choice-Extension.value.ResultSS-RSRP.Item 0.ResultSS-RSRP-Item.sS-RSRP-PerSSB.Item 0.ResultSS-RSRP-PerSSB-Item.sSB-Index = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.measuredResults.Item 0.MeasuredResultsValue.choice-Extension.value.ResultSS-RSRP.Item 0.ResultSS-RSRP-Item.sS-RSRP-PerSSB.Item 0.ResultSS-RSRP-PerSSB-Item.valueSS-RSRP = 50
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UplinkUEAssociatedNRPPaTransport.protocolIEs.Item 3.ProtocolIE-Field.value.NRPPA-PDU.successfulOutcome.value.E-CIDMeasurementInitiationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.E-CID-MeasurementResult.servingCellTAC = 0x000000
