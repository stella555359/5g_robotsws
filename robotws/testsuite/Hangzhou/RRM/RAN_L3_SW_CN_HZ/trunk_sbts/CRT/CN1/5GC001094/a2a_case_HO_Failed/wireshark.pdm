[Global]
RELATION: CP1 
BlOCKSIZE: -1

[CP1]
# check whole related x2 msg, also configuration: A3 / rsrp /radioNetwork: tDCoverall-expiry
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA3.a3-Offset.rsrp = 10

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequired
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 0

ethernet.ip.sctp.x2ap	
	ethernet.ip.sctp.x2ap.value = SgNBReleaseRequired
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 29

ethernet.ip.sctp.x2ap		
	ethernet.ip.sctp.x2ap.value = SgNBReleaseConfirm

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SNStatusTransfer
	
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = UEContextRelease
	
	
# check whole related x2/f1ap/e1ap msg, also configuration: A3 / rsrp / MeNB refusal
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA3.a3-Offset.rsrp = 10

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequired
	
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRefuse
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.misc = 4

ethernet.ip.sctp.x2ap	
	ethernet.ip.sctp.x2ap.value = SgNBReleaseRequired
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 21

ethernet.ip.sctp		
	ethernet.ip.sctp.x2ap.value = SgNBReleaseConfirm

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SNStatusTransfer
	
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = UEContextRelease

# check whole related x2 msg, also configuration: A3 / rsrp / T304 expiry
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.id-SgNBtoMeNBContainer.ProtocolIE-Field.value.SgNBtoMeNBContainer.CG-Config.criticalExtensions.c1.cg-Config.scg-CellGroupConfig.RRCReconfiguration.criticalExtensions.rrcReconfiguration.measConfig.reportConfigToAddModList.Item 0.ReportConfigToAddMod.reportConfig.reportConfigNR.reportType.eventTriggered.eventId.eventA3.a3-Offset.rsrp = 10

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequest
	ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 31
	
ethernet.ip.sctp.x2ap	
	ethernet.ip.sctp.x2ap.value = SgNBModificationRequestAcknowledge

ethernet.ip.sctp.x2ap	
	ethernet.ip.sctp.x2ap.value = SgNBReleaseRequired
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 44

ethernet.ip.sctp		
	ethernet.ip.sctp.x2ap.value = SgNBReleaseConfirm

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SNStatusTransfer

#check new add UE32 UE33
ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequired

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationConfirm

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBModificationRequired
    arrival_time = _x

ethernet.ip.sctp.x2ap
    ethernet.ip.sctp.x2ap.value = SgNBReleaseRequired
    ethernet.ip.sctp.x2ap.id-Cause.ProtocolIE-Field.value.Cause.radioNetwork = 29
    arrival_time = x+9~x+11
