[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#XnSetupFailure xnap.XnAP_PDU == 2 with fail cause = sctp shutdown
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.unsuccessfulOutcome.value.XnSetupFailure.protocolIEs.Item 0.ProtocolIE-Field.value.Cause.protocol = 6

ethernet.ip.sctp
    ethernet.ip.sctp.shutdown.chunk_type = 7
	
ethernet.ip.sctp
    ethernet.ip.sctp.shutdown_complete.chunk_type = 14