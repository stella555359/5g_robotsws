[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# filter: nokiaxnap.ResetRequestTypeInfo == 1 and nokiaxnap.ue_contexts_ToBeReleasedList == 1 and nokiaxnap.transport == 0
# when NG SCTP failure, bulk release_Xn Reset for ext-gNB, reset type is partialreset, cause is transport-resource-unavailable.
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo = 1
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 0.ProtocolIE-Field.value.ResetRequestTypeInfo.partialReset.ue-contexts-ToBeReleasedList = 1 item
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.ResetRequest.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0

# filter: nokiaf1ap.transport == 0 and nokiaf1ap.ResetType == 1
# when NG SCTP failure, bulk release_F1 Reset for ext-gNB, reset type is partialreset, cause is unspecified
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 0
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1

