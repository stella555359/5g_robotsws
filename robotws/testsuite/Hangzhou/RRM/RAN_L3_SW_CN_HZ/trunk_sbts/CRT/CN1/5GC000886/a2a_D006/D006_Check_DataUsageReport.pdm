[Global]
RELATION: CP1 & CP2
BLOCKSIZE: -1

# Check SecondaryRATDataUsageReport Messages In wireshark D006
#     {expected}    Create List    60    180    180
#     Check SecondaryRATDataUsageReport Message In wireshark    4    {X2AP_usage_report_condition}    {expected}
#     Check SecondaryRATDataUsageReport Message In wireshark    4    {E1AP_usage_report_condition}    {expected}

[CP1]
# X2AP_usage_report_condition
# ===================Msg: 1105 start================
ethernet.ip.sctp.x2ap
    arrival_time = _x
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
	ethernet.ip.sctp.x2ap.x2ap_pdu = 0
	ethernet.ip.sctp.x2ap.procedure_code = 38

# ===================Msg: 2124 start================
ethernet.ip.sctp.x2ap
    arrival_time = x+60 ~ x+61
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
	ethernet.ip.sctp.x2ap.x2ap_pdu = 0
	ethernet.ip.sctp.x2ap.procedure_code = 38

# ===================Msg: 3131 start================
ethernet.ip.sctp.x2ap
    arrival_time = x+240 ~ x+241
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
	ethernet.ip.sctp.x2ap.x2ap_pdu = 0
	ethernet.ip.sctp.x2ap.procedure_code = 38

# ===================Msg: 4158 start================
ethernet.ip.sctp.x2ap
    arrival_time = x+420 ~ x+421
    ethernet.ip.destination = 10.0.1.12
    ethernet.ip.source = 10.0.1.2
	ethernet.ip.sctp.x2ap.x2ap_pdu = 0
	ethernet.ip.sctp.x2ap.procedure_code = 38

[CP2]
# E1AP_usage_report_condition
# ===================Msg: 1061 start================
ethernet.ipv6.sctp.e1ap
    arrival_time = _x
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 15
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 0

# ===================Msg: 2073 start================
ethernet.ipv6.sctp.e1ap
    arrival_time = x+60 ~ x+61
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 15
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 0

# ===================Msg: 3059 start================
ethernet.ipv6.sctp.e1ap
    arrival_time = x+240 ~ x+241
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 15
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 0

# ===================Msg: 4072 start================
ethernet.ipv6.sctp.e1ap
    arrival_time = x+420 ~ x+421
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 15
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 0
