ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBCUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.id = 129


