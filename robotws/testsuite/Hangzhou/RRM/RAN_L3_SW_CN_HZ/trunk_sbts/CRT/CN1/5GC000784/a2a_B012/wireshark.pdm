    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.allocationAndRetentionPriority.priorityLevelARP = 15

#ngap.fiveQI == 1 and ngap.priorityLevelARP == 15 and ngap.pDUSessionID == 1
#PDUSessionResourceModifyRequest, Add 5QI-1 to Exist PDU Session
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.allocationAndRetentionPriority.priorityLevelARP = 15

#ngap.fiveQI == 5 and ngap.priorityLevelARP == 1 and ngap.pDUSessionID == 2
#PDUSessionResourceSetupRequest, Setup PDU Session with Emergency Request, Setup QosFlow with 5QI:5
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 5
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.allocationAndRetentionPriority.priorityLevelARP = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceSetupRequest.protocolIEs.Item 2.ProtocolIE-Field.value.PDUSessionResourceSetupListSUReq.Item 0.PDUSessionResourceSetupItemSUReq.pDUSessionID = 2

#ngap.fiveQI == 1 and ngap.priorityLevelARP == 1 and ngap.pDUSessionID == 2
#PDUSessionResourceModifyRequest， Add 5QI-1 to Exist PDU Session
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionID = 2
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.allocationAndRetentionPriority.priorityLevelARP = 1

#xnap.procedureCode == 0 and xnap.radioNetwork == 1
#HandoverRequest, from gNB2 to sim gNB3
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 1

#xnap.procedureCode == 0
#HandoverRequestAcknowledge, from gNB2 to sim gNB3
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.procedureCode = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.HandoverRequestAcknowledge = None

#filter: ngap.RRCEstablishmentCause == 3
# UE2: InitialUEMessage, Registration request
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialUEMessage.protocolIEs.Item 3.ProtocolIE-Field.value.RRCEstablishmentCause = 3

#nr-rrc and nas_5gs.mm.req_type == 1
#UE2: initiatingMessage, Setup PDU Session with Initial Request
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.4   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.ulInformationTransfer.criticalExtensions.ulInformationTransfer.dedicatedNAS-Message.Non-Access-Stratum 5GS (NAS)PDU.Plain NAS 5GS Message.Request type.Request type = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.4   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.ulInformationTransfer.criticalExtensions.ulInformationTransfer.dedicatedNAS-Message.Non-Access-Stratum 5GS (NAS)PDU.Plain NAS 5GS Message.Payload container.Plain NAS 5GS Message.PDU session identity = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.4   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1.ulInformationTransfer.criticalExtensions.ulInformationTransfer.dedicatedNAS-Message.Non-Access-Stratum 5GS (NAS)PDU.Plain NAS 5GS Message.S-NSSAI.Slice differentiator (SD) = 13714342

#filter: ngap.fiveQI == 5 and ngap.priorityLevelARP == 1 and ngap.pDUSessionID == 1
#UE2: InitialContextSetupRequest, Setup QosFlow with 5QI:5
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 5
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.allocationAndRetentionPriority.priorityLevelARP = 1

