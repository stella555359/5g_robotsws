ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionID = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 1
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.allocationAndRetentionPriority.priorityLevelARP = 1

#xnap.procedureCode == 0 and xnap.radioNetwork == 1
#HandoverRequest, from gNB3 to sim gNB2
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.procedureCode = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.initiatingMessage.value.HandoverRequest.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 1

#filter: xnap.procedureCode == 0 and xnap.radioNetwork == 4
#HandoverPreparationFailure with cause: no-radio-resources-available-in-target-cell (4)
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.unsuccessfulOutcome.procedureCode = 0
    ethernet.ip.sctp.xnap.XnAP-PDU.unsuccessfulOutcome.value.HandoverPreparationFailure.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 4
