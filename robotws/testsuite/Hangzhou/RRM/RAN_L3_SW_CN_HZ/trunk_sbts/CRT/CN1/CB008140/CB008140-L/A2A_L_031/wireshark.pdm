# filter: nr-rrc.physCellId == 50 and nr-rrc.physCellId == 53 and nr-rrc.physCellId == 60
# UE5 3CC is success
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 0.SCellConfig.sCellConfigCommon.physCellId = 53
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.sCellToAddModList.Item 1.SCellConfig.sCellConfigCommon.physCellId = 60
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 50

# filter: nokiaf1ap.transport == 1 and nokiaf1ap.ResetType == 1 and nokiaf1ap.gNB_CU_UE_F1AP_ID == 0
# Modify SNSSAI-1 IPV4 link,UE1 bulk release. transport: transport-resource-unavailable (1), ResetType: partOfF1-Interface (1)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${RAN_UE_NGAP_ID_1}

# filter: nokiaf1ap.transport == 1 and nokiaf1ap.ResetType == 1 and nokiaf1ap.gNB_CU_UE_F1AP_ID == ${RAN_UE_NGAP_ID_3}
# Remove SNSSAI-1 IPV6 confige and UE3 bulk release. transport: transport-resource-unavailable (1), ResetType: partOfF1-Interface (1)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${RAN_UE_NGAP_ID_3}

# filter: nokiaf1ap.transport == 1 and nokiaf1ap.ResetType == 1 and nokiaf1ap.gNB_CU_UE_F1AP_ID == ${RAN_UE_NGAP_ID_4}
# Modify SNSSAI-2 IPV4 link and UE4 bulk release. transport: transport-resource-unavailable (1), ResetType: partOfF1-Interface (1)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${RAN_UE_NGAP_ID_4}

# filter: nokiaf1ap.transport == 1 and nokiaf1ap.ResetType == 1 and nokiaf1ap.gNB_CU_UE_F1AP_ID == ${RAN_UE_NGAP_ID_5}
# Delete SNSSAI-2 IPV6 relate MO and UE5 bulk release. transport: transport-resource-unavailable (1), ResetType: partOfF1-Interface (1)
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.transport = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType = 1
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.Reset.protocolIEs.Item 2.ProtocolIE-Field.value.ResetType.partOfF1-Interface.Item 0.ProtocolIE-SingleContainer.value.UE-associatedLogicalF1-ConnectionItem.gNB-CU-UE-F1AP-ID = ${RAN_UE_NGAP_ID_5}

[CP2]
# filter: ngap.RAN_UE_NGAP_ID == 0 and ngap.id == 111
# Modify SNSSAI-1 IPV4 link,UE1 bulk release. ng reset process
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 111
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.UE-associatedLogicalNG-connectionList.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_1}

# filter: ngap.RAN_UE_NGAP_ID == ${RAN_UE_NGAP_ID_3} and ngap.id == 111
# Remove SNSSAI-1 IPV6 confige and UE3 bulk release. ng reset process
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 111
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.UE-associatedLogicalNG-connectionList.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_3}

# filter: ngap.RAN_UE_NGAP_ID == ${RAN_UE_NGAP_ID_4} and ngap.id == 111
# Modify SNSSAI-2 IPV4 link and UE4 bulk release. ng reset process
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 111
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.UE-associatedLogicalNG-connectionList.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_4}

# filter: ngap.RAN_UE_NGAP_ID == ${RAN_UE_NGAP_ID_5} and ngap.id == 111
# Delete SNSSAI-2 IPV6 relate MO and UE5 bulk release. ng reset process
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.id = 111
    ethernet.ip.sctp.ngap.NGAP-PDU.successfulOutcome.value.NGResetAcknowledge.protocolIEs.Item 0.ProtocolIE-Field.value.UE-associatedLogicalNG-connectionList.Item 0.UE-associatedLogicalNG-connectionItem.rAN-UE-NGAP-ID = ${RAN_UE_NGAP_ID_5}

[CP3]
# filter: nokiaxnap.ng_ran_node1UEXnAPID == 0 and nokiaxnap.id == 57
# Modify SNSSAI-1 IPV4 link,UE1 bulk release. Xn reset process
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.id = 57
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.value.ResetResponseTypeInfo.partialReset.ue-contexts-AdmittedToBeReleasedList.Item 0.ResetResponsePartialReleaseItem.ng-ran-node1UEXnAPID = ${RAN_UE_NGAP_ID_1}

