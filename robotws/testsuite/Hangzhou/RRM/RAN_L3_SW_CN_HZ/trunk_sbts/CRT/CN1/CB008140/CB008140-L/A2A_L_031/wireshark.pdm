# filter: nokiaxnap.ng_ran_node1UEXnAPID == ${RAN_UE_NGAP_ID_5} and nokiaxnap.id == 57
# Delete SNSSAI-2 IPV6 relate MO and UE5 bulk release.  Xn reset process
ethernet.ip.sctp.xnap
    ethernet.ip.sctp.xnap.XnAP-PDU.successfulOutcome.value.ResetResponse.protocolIEs.Item 0.ProtocolIE-Field.id = 57
