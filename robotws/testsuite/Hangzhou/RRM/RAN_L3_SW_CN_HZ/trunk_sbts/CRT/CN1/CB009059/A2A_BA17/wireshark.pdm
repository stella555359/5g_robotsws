[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# add NRDRB-1 and NRDRB-3 during InitialContextSetupRequest
# filter: ngap.fiveQI == 6 and ngap.fiveQI == 8
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 6
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 1.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 8

# first UE register to NRCell-12
# filter: nr-rrc.physCellId == 61 and nr-rrc.FreqBandIndicatorNR == 71
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 71
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.physCellId = 61
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.frequencyBandList.Item 0.FreqBandIndicatorNR = 71

# BufferMonitoringNotification, check CB008311 enable and start Buffer Monitoring
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# add NRDRB2 during InitialContextSetupRequest
# filter: ngap.fiveQI == 7
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.InitialContextSetupRequest.protocolIEs.Item 4.ProtocolIE-Field.value.PDUSessionResourceSetupListCxtReq.Item 0.PDUSessionResourceSetupItemCxtReq.pDUSessionResourceSetupRequestTransfer.PDUSessionResourceSetupRequestTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.QosFlowSetupRequestList.Item 0.QosFlowSetupRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 7

# second UE register to NRCell-12
# filter: nr-rrc.physCellId == 61 and nr-rrc.FreqBandIndicatorNR == 71
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.downlinkConfigCommon.frequencyInfoDL.frequencyBandList.Item 0.FreqBandIndicatorNR = 71
