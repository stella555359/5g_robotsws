ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 0.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 9
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowListWithCause.Item 0.QosFlowWithCauseItem.cause.radioNetwork = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 1.ProtocolIE-Field.value.QosFlowListWithCause.Item 0.QosFlowWithCauseItem.qosFlowIdentifier = 1

