ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 0.ProtocolIE-Field.value.QosFlowAddOrModifyRequestList.Item 0.QosFlowAddOrModifyRequestItem.qosFlowLevelQosParameters.qosCharacteristics.nonDynamic5QI.fiveQI = 8

# BufferCriterionNotification, check DU sends private unacknowledged F1AP message to inform CU DL buffer
# filter: nokiaf1ap.BufferCriterion == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferCriterionNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferCriterion = 0

# release DRB-2 then add NRDRB-4 by pdu session modify
