    ethernet.ipv6.sctp.f1ap.F1AP-PDU.successfulOutcome.value.UEContextModificationResponse.protocolIEs.Item 2.ProtocolIE-Field.value.DUtoCURRCInformation.cellGroupConfig.CellGroupConfig.spCellConfig.reconfigurationWithSync.spCellConfigCommon.uplinkConfigCommon.frequencyInfoUL.frequencyBandList.Item 0.FreqBandIndicatorNR = 71

# BufferMonitoringNotification, check CB008311 enable and start Buffer Monitoring
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# release DRB-3
# filter: ngap.qosFlowIdentifier == 2 and ngap.radioNetwork == 0
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 0.ProtocolIE-Field.value.QosFlowListWithCause.Item 0.QosFlowWithCauseItem.cause.radioNetwork = 0
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.PDUSessionResourceModifyRequest.protocolIEs.Item 3.ProtocolIE-Field.value.PDUSessionResourceModifyListModReq.Item 0.PDUSessionResourceModifyItemModReq.pDUSessionResourceModifyRequestTransfer.PDUSessionResourceModifyRequestTransfer.protocolIEs.Item 0.ProtocolIE-Field.value.QosFlowListWithCause.Item 0.QosFlowWithCauseItem.qosFlowIdentifier = 2

# BufferMonitoringNotification, check CB008311 enable and start Buffer Monitoring
# filter: nokiaf1ap.BufferMonitoring == 0
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.PrivateMessage.privateIEs.Item 0.PrivateIE-Field.value.Nokia-F1AP-PDU.initiatingPrivateMessage.value.BufferMonitoringNotification.protocolIEs.Item 2.ProtocolIE-Field.value.BufferMonitoring = 0

# add NRDRB-3 by pdu session modify
