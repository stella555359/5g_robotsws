    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.GNBDUConfigurationUpdate.protocolIEs.Item 1.ProtocolIE-Field.value.Cells-Status-List.Item 0.ProtocolIE-SingleContainer.value.Cells-Status-Item.service-status.service-state = 0

