[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
# UE1 enter RRC idle
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 2

# UE2 release due to pre-emption
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.Item 0.ProtocolIE-Field.value.AMF-UE-NGAP-ID = 2
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseRequest.protocolIEs.Item 3.ProtocolIE-Field.value.Cause.radioNetwork = 46

# UE2 release due to pre-emption
ethernet.ip.sctp.ngap
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 0.ProtocolIE-Field.value.UE-NGAP-IDs.uE-NGAP-ID-pair.aMF-UE-NGAP-ID = 2
    ethernet.ip.sctp.ngap.NGAP-PDU.initiatingMessage.value.UEContextReleaseCommand.protocolIEs.Item 1.ProtocolIE-Field.value.Cause.radioNetwork = 46

