[Global]
RELATION: CP2
BlOCKSIZE: -1

[CP2]
# filter rrcSetupComplete: f1ap.procedureCode == 13 and nr-rrc.c1 == 2
ethernet.ipv6.sctp.f1ap
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.procedureCode = 13
    ethernet.ipv6.sctp.f1ap.F1AP-PDU.initiatingMessage.value.ULRRCMessageTransfer.protocolIEs.Item 3.ProtocolIE-Field.value.RRCContainer.0   ).NR Radio Resource Control (RRC) protocol.UL-DCCH-Message.message.c1 = 2

###sa ue attach succ####
# filter: f1ap.F1AP_PDU == 0 and f1ap.procedureCode == 8
#For msg rrcReestablishmentRequest
ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.procedureCode = 8
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 0
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.initiatingMessage.value.BearerContextSetupRequest.protocolIEs.Item 6.ProtocolIE-Field.value.System-BearerContextSetupRequest.nG-RAN-BearerContextSetupRequest.Item 0.ProtocolIE-Field.value.PDU-Session-Resource-To-Setup-List.Item 0.PDU-Session-Resource-To-Setup-Item.dRB-To-Setup-List-NG-RAN.Item 0.DRB-To-Setup-Item-NG-RAN.dRB-ID = 4

ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.procedureCode = 8
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 1
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextSetupResponse.protocolIEs.Item 2.ProtocolIE-Field.value.System-BearerContextSetupResponse.nG-RAN-BearerContextSetupResponse.Item 0.ProtocolIE-Field.value.PDU-Session-Resource-Setup-List.Item 0.PDU-Session-Resource-Setup-Item.dRB-Setup-List-NG-RAN.Item 0.DRB-Setup-Item-NG-RAN.dRB-ID = 4

ethernet.ipv6.sctp.e1ap
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.procedureCode = 9
    ethernet.ipv6.sctp.e1ap.E1AP-PDU = 1
    ethernet.ipv6.sctp.e1ap.E1AP-PDU.successfulOutcome.value.BearerContextModificationResponse.protocolIEs.ProtocolIE-Field.value.System-BearerContextModificationResponse.nG-RAN-BearerContextModificationResponse.ProtocolIE-Field.value.PDU-Session-Resource-Modified-List.PDU-Session-Resource-Modified-Item.dRB-Modified-List-NG-RAN.DRB-Modified-Item-NG-RAN.dRB-ID = 4
