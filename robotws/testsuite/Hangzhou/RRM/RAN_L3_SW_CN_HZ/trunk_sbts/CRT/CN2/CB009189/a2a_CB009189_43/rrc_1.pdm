[Global]
RELATION: CP1
BlOCKSIZE: -1

[CP1]
#QCI 9 check
RadioBearerConfig
    RadioBearerConfig.drb-ToAddModList.None.pdcp-Config.drb.outOfOrderDelivery = true
    RadioBearerConfig.drb-ToAddModList.None.drb-Identity = 4

#QCI 7 outoforderDL check
RadioBearerConfig
    RadioBearerConfig.drb-ToAddModList.None.pdcp-Config.drb.outOfOrderDelivery = true
    RadioBearerConfig.drb-ToAddModList.None.drb-Identity = 5

#PScell change QCI 9 and 7 outoforderDL check
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None.pdcp-Config.drb.outOfOrderDelivery = true
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None_1.drb-Identity = 5
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None.drb-Identity = 4
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None_1.pdcp-Config.drb.outOfOrderDelivery = true
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None_1.recoverPDCP = true
