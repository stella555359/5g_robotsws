[Global]
RELATION: CP1 & CP2
BLOCKSIZE: -1

[CP1]
# NEWDRB add
DL-DCCH-Message
  DL-DCCH-Message.rrcReconfiguration.rrc-TransactionIdentifier = 0
  DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToAddModList.None.drb-Identity = 5
  DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.rlc-BearerToAddModList.None.logicalChannelIdentity = 5
  
[CP2]
# NEWDRB release
DL-DCCH-Message
  DL-DCCH-Message.rrcReconfiguration.rrc-TransactionIdentifier = 1
  DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.radioBearerConfig.drb-ToReleaseList.5 = 5
