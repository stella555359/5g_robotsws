[Global]
RELATION: CP1 & CP2 & CP3
BLOCKSIZE: -1

[CP1]
# UL scell add config PDCCH
DL-DCCH-Message
    DL-DCCH-Message.rrcReconfiguration.rrc-TransactionIdentifier = 3
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.cellGroupId = 0
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.mac-CellGroupConfig.setup.multiplePHR = TRUE
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellIndex = 1
    DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.physCellId = 61
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigCommon.uplinkConfigCommon.initialUplinkBWP.genericParameters.subcarrierSpacing = kHz30
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Id = 1
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToAddModList.None.sCellConfigDedicated.uplinkConfig.uplinkBWP-ToAddModList.None.bwp-Dedicated.setup.txConfig = codebook

[CP2]
# A1 config
DL-DCCH-Message
	DL-DCCH-Message.rrcReconfiguration.rrc-TransactionIdentifier = 2
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectId = 1
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigId = 1
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA1.reportOnLeave = FALSE
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA1.a1-Threshold_rsrp = 70

[CP3]
#Scell_release, remove A2 and reconfig A1
DL-DCCH-Message
	DL-DCCH-Message.rrcReconfiguration.rrc-TransactionIdentifier = 3
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.measObjectToAddModList.None.measObjectId = 2
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigId = 2
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.measConfig.reportConfigToAddModList.None.reportConfigNR.eventTriggered.eventA2.a2-Threshold_rsrp = 60
	DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.cellGroupId = 0
	#DL-DCCH-Message.rrcReconfiguration.rrcReconfiguration.nonCriticalExtension.CONTAINING.sCellToReleaseList.1 = 1

