<?xml version="1.0" encoding="UTF-8"?>
<soc:NE3SWSSOC xmlns:soc="http://www.nokia.com/schemas/ne3s/soc/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.nokia.com/schemas/ne3s/soc/1.0 NE3SSoC.1.0.xsd" patchLevel="01.001">
	<Adaptation href="Configurator#Common"/>
	<soc:common version="1.0">
		<soc:security type="tls"/>
		<soc:ruim supported="true" version="1.0"/>
		<soc:sdnFormat format="propietary"/>
		<soc:fallback supported="true"/>
		<soc:compression format="tar_gzip"/>
		<soc:uploadTypes>
			<soc:uploadType type="configuration"/>
			<soc:uploadType type="topology"/>
			<soc:uploadType type="fault"/>
			<soc:uploadType type="audit"/>
			<soc:uploadType type="trace"/>
			<soc:uploadType type="measurement"/>
		</soc:uploadTypes>
		<soc:dataFormats>
			<soc:dataFormat type="raml_2.1"/>
			<soc:dataFormat type="ocos_1.0"/>
			<soc:dataFormat type="omes_2.1"/>
			<soc:dataFormat type="ofas_3.1"/>
			<soc:dataFormat type="oats_1.0"/>
			<soc:dataFormat type="oobs_1.2"/>
		</soc:dataFormats>
		<soc:providedOperations>
			<soc:providedOperation name="startRegistration"/>
			<soc:providedOperation name="completeRegistration"/>
			<soc:providedOperation name="unregister"/>
			<soc:providedOperation name="startSession"/>
			<soc:providedOperation name="stopSession"/>
			<soc:providedOperation name="keepAliveSession"/>
			<soc:providedOperation name="get"/>
			<soc:providedOperation name="set"/>
			<soc:providedOperation name="download"/>
			<soc:providedOperation name="validate"/>
			<soc:providedOperation name="activate"/>
			<soc:providedOperation name="upload"/>
			<soc:providedOperation name="provision"/>
			<soc:providedOperation name="interruptOperation"/>
			<soc:providedOperation name="requestOperationStatus"/>
			<soc:providedOperation name="ping"/>
			<soc:providedOperation name="reregister"/>
		</soc:providedOperations>
		<soc:usedOperations>
			<soc:usedOperation name="abortSession"/>
			<soc:usedOperation name="reportOperationInterrupt"/>
			<soc:usedOperation name="reportStatus"/>
			<soc:usedOperation name="reregister"/>
			<soc:usedOperation name="transferNotification"/>
		</soc:usedOperations>
		<soc:notification notificationType="ne3s_common_changeNotification" queueId="cm_queue" buffered="true"/>
	</soc:common>
	<soc:fragment name="ConfigurationManagement" version="1.0">
	</soc:fragment>
	<soc:fragment name="AgentDiscovery" version="1.0">
		<soc:extension name="ne3s_common_supportedModel" supported="true">
			<soc:attribute name="adaptationIDs" value="com.nokia.discovery,com.nokia.ne3sws.agentconnectivity"/>
		</soc:extension>
	</soc:fragment>
	<soc:fragment name="FaultManagement" version="1.0">
		<soc:notification notificationType="ne3s_fm_alarmEventNotification" queueId="ne3s_fm_alarmEventNotificationQueue" buffered="true" supported="true"/>
		<soc:notification notificationType="ne3s_fm_rebuildNotification" queueId="ne3s_fm_rebuildNotificationQueue" buffered="true" supported="true"/>
	</soc:fragment>
	<soc:fragment name="PerformanceManagement" version="1.0">
		<soc:notification notificationType="ne3s_pm_uploadNotification" queueId="ne3s_pm_uploadNotificationQueue" buffered="true" supported="true"/>
	</soc:fragment>
	<soc:fragment name="SubscriberAndEquipmentTrace" version="1.0">
		<soc:notification notificationType="ne3s_slt_uploadNotification" queueId="ne3s_slt_traceReportNotificationQueue" buffered="true" supported="true"/>
	</soc:fragment>
	<soc:fragment name="AuditTrail" version="1">
		<soc:notification notificationType="ne3s_atl_logUploadNotification" queueId="ne3s_atl_logUploadNotificationQueue" buffered="true" supported="true"/>
	</soc:fragment>
	<soc:fragment name="HardwareManagement" version="1">
	</soc:fragment>
	<soc:fragment name="SoftwareManagement" version="1">
	</soc:fragment>
</soc:NE3SWSSOC>
