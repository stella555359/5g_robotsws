*** Variables ***
${SNAPSHOT_TIMEOUT}                     1200                     # Timeout for snapshot collection via WebEM (in sec)
${SYSLOG_ALIAS}                         SMOD1                    # Alias of SMOD used to collect syslog
${SYSLOG_NAME}                          ${SYSLOG_ALIAS}_UDP.log  # filename of saved syslog, used by Freeze_Files9.py script
${FILE_DIR}                             /tmp                     # directory used to save syslog file
${CSV_FILE_NAME}                        time_table.csv           # filename of timetable generated by Freeze_Files9.py script
${LMP_eNB_IP}                           192.168.255.126          # LMP IP used for connection to collect syslog
${CSV_SEPARATOR}                        ;                        # Separator used in time_table.csv file, used to split lines
${NUMBER_OF_LINE_IN_CSV_FILE_TO_SKIP}   ${2}
${COLUMN_NUMBER_WITH_FILE_NAME}         ${1}
${COLUMN_NUMBER_WITH_FREEZE_TIME}       ${5}
${FILE_NAME_FOR_EXECPTION}              HWRBase
${FILE_NAME_FOR_EXECPTION_2}            SysAdap
${FREEZE_LIMIT_FROM_SNAP_START}         ${2000}
${FREEZE_LIMIT_FROM_FREEZE_START}       ${1000}
${FREEZE_LIMIT_FOR_EXCEPTIONS}

*** Keywords ***
TC__LOGS__Snapshot_files_freezing_time_check
    [Documentation]
    ...  [CASE LINK]: https://jiradc.ext.net.nokia.com/browse/TAT-22569
    ...
    ...  *****************
    ...  Basic information
    ...  *****************
    ...  Test case created to check freeze time of snapshot logs during it's collection from BTS. It should be:
    ...  Less than 1s from the moment the internal components started freezing the log files until freeze end,
    ...  Less than 2s from snapshot trigger until all logs are frozen,
    ...  Max 10s for HWRBase files,
    ...  Max 30s for SysAdap files.
    ...
