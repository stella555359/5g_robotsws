Get_syscom_trace_and_convert_to_json
    [Arguments]    ${trace_path}          ${bin_path}
    ssh.Connect to    hostname=${VM_IP}    username=${VM_USERNAME}    password=${VM_PASSWORD}    alias=ute
    ssh.Execute   command=ls ${trace_path} |grep '.atr'|grep -v '_pm_' > ${trace_path}/trace_name.txt
    ...    connection=ute
    ${range}      ssh.Execute   command=wc -l ${trace_path}/trace_name.txt | awk '{print $1}'
    ...    connection=ute
    ssh.Connect to   hostname=${EMIL_IP}    username=${EMIL_U}    password=${EMIL_P}
    ...    alias=Emil_decode
     Run Keyword And Ignore Error       log to console     there is ${range} trace file
    ${range}    Convert To Integer    ${range}
    ${range}=    Evaluate    ${range}+1
    FOR    ${i}    IN RANGE    1    ${range}
        ${trace_log_name}    ssh.Execute    command=sed -n ${i}p ${trace_path}/trace_name.txt    connection=ute
        ${trace_log_name}    strip string    ${trace_log_name}
        convert to json     trace_path=${trace_path}
        ...    trace_log_name=${trace_log_name}
        sleep    10s
    END
    Run Keyword And Continue On Failure       ssh.Execute   command=mv ${bin_path} ${trace_path}
        ...    connection=ute
    [Teardown]      Run Keyword and Ignore Error
    ...       run keywords     ssh.Disconnect    connection=Emil_decode     AND      ssh.Disconnect     connection=ute

