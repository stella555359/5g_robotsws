    Step0: Set Parameters
    Step1: Trigger DSP Crash Resulting In L1Soc NR DL DSP Group
    Step2: Check Services After L1 Soc Auto-healing


Step0: Set Parameters
    Log  \nStep0: Setting necessary parameters...  console=true
    Check Presence Of PMMNL Object
    IF  '${UNIT_TYPE}' in ['ABIP','ASOG','ASOH']
        ${hw_variant}  Set Variable  Thor
    ELSE
        ${hw_variant}  Set Variable  Loki
    END
    ${soc_dn}  Get Random SOC Dist_name  ${hw_variant}  ${RAT_TYPE}  ${UNIT_TYPE}
    IF  '${UNIT_TYPE}' in ['ABIP','ASOE','ASOF']
        ${unit_l_dn}  Fetch From Left  ${soc_dn}  /BOARD_L
        ${unit_l_parameters}  Get Parameters For  SMOD  ${unit_l_dn}
    ELSE
        ${unit_l_dn}  Fetch From Left  ${soc_dn}  /BBU_L
        ${unit_l_parameters}  Get Parameters For  BBMOD  ${unit_l_dn}
    END
    ${unit_product_name}  Set Variable  ${unit_l_parameters}[productName]
    ${unit_r_dn}  Get Runtime Object Dist_name From Logical Object Dist_name  ${unit_l_dn}
    ${soc_vertical_position}  Get Module Vertical Position  ${unit_r_dn}
    IF  '${UNIT_TYPE}'=='ABIP'
        ${soc_position}  Set Variable  1
    ELSE
        ${soc_position}  Get SOC Position  ${soc_dn}  ${unit_product_name}
    END
    ${stored_role}  Get StoredRole From MODULE_L  ${unit_l_dn}
    Set Test Variable  ${SOC_DN}  ${soc_dn}
    Set Test Variable  ${SOC_VERTICAL_POSITION}  ${soc_vertical_position}
    Set Test Variable  ${SOC_HORIZONTAL_POSITION}  ${soc_position}
    Set Test Variable  ${STORED_ROLE}  ${stored_role}
    Add Flag To Swconfig File And Perform Site Reset  0x87002A=0
    Sleep Until New 15 Minutes Cycle


Step1: Trigger DSP Crash Resulting In L1Soc NR DL DSP Group
    Log  Step1: Trigger DSP Crash Resulting In L1Soc NR DL DSP Group auto-healing  console=true
    ${date_time}  Get Current Date
    ${current_date_time}  Convert Date  ${date_time}  result_format=%Y-%b-%d %H:%M:%S
    Open SSH Connection And Trigger DSP Crash
    IF  '${ENB_BRANCH}'>='SBTS25R3'
        Check Alarm In RawAlarmHistory File  2087  ${current_date_time}
    ELSE
        Check Alarm In RawAlarmHistory File  9100  ${current_date_time}
    END
    Check Alarm In RawAlarmHistory File  9101  ${current_date_time}


Step2: Check Services After L1 Soc Auto-healing
    Log  Step2: Check Services After L1 Soc Auto-healing  console=true
    Wait Until Keyword Succeeds  ${STARTUP_TIMEOUT}  10
    ...  Check All Cells
    IF  '${ENB_BRANCH}' >= 'SBTS25R3'  RETURN
    Sleep Until New 15 Minutes Cycle
    ${status_counter}  Run Keyword And Return Status
    ...  Verify NUM_L1_AUTO_HEALING_BTS Counter To Be Incremented  1
    IF  ${status_counter}==${FALSE}
        Log  Counter NUM_L1_AUTO_HEALING_BTS is not incremented correctly/did not appear - [OK].  console=true
    ELSE
        Fail  Counter NUM_L1_AUTO_HEALING_BTS is incremented correctly - [NOK].
    END


Open SSH Connection And Trigger DSP Crash
    Open Connection To Primary Core
    IF  '${STORED_ROLE}'=='Idle'  Open Connection To Secondary Core
    Open Connection To SOC  ${SOC_VERTICAL_POSITION}  ${SOC_HORIZONTAL_POSITION}
    Send Command To Trigger DSP Crash


Send Command To Trigger DSP Crash
    SSHLibrary.Write  ${CRASH_COMMAND}
    SSHLibrary.Read Until Prompt
    SSHLibrary.Close Connection
    Log  DSP crashed successfuly.  console=true


Check Alarm In RawAlarmHistory File
    [Arguments]  ${fault_number}  ${current_date_time}

    ${status_alarm}  Run Keyword And Return Status
    ...  Verify Alarm In RawAlarmHistory File  ${fault_number}  ${current_date_time}
    IF  ${status_alarm}==${FALSE}
        Log  Alarm with fault ${fault_number} is not present in RawAlarmHistory file - [OK].  console=true
    ELSE
        Fail  Alarm appear in RawAlarmHistory file - [NOK].
    END


TC Setup
    Common Test Setup  tc_name=FM__B_L1Soc_NR_UL_DSP_feature_deactivated


TC Teardown
    Remove Swconfig Flag And Perform Site Reset  0x87002A=0
    Common Test Teardown
